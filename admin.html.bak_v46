<symbol id="i-people-group" viewBox="0 0 24 24"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M2 20c0-3 3-5 6-5s6 2 6 5 M10 20c0-3 3-5 6-5s6 2 6 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-user-graduate" viewBox="0 0 24 24"><path d="M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M2 20c0-4 4-6 8-6 M18 14l4 2-4 2-4-2z M18 14v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9z M10 20a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-megaphone" viewBox="0 0 24 24"><path d="M3 11v2a1 1 0 0 0 1 1h2l4 4V6L6 10H4a1 1 0 0 0-1 1z M14 8a4 4 0 0 1 0 8 M17 5a8 8 0 0 1 0 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-comment" viewBox="0 0 24 24"><path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-5 4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-comments" viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H8l-5 4z M7 12a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4l3 3h-7a2 2 0 0 1-2-2v-1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-thumbs-up" viewBox="0 0 24 24"><path d="M7 22V11 M7 11l4-7c1-1 3 0 3 2v3h5a2 2 0 0 1 2 2l-2 8a2 2 0 0 1-2 2H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-eye-slash" viewBox="0 0 24 24"><path d="M3 3l18 18 M10.5 10.5a3 3 0 0 0 4 4 M6 6C3 8 2 12 2 12s4 7 10 7c2 0 4-1 5-2 M9.5 5.2A10 10 0 0 1 12 5c6 0 10 7 10 7s-1 2-3 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-stopwatch" viewBox="0 0 24 24"><path d="M12 6v3 M10 2h4 M12 9a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M12 13v3l2 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-gauge-high" viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 12l4-3 M12 7v1 M17 12h-1 M7 12H6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-chart-line" viewBox="0 0 24 24"><path d="M3 3v18h18 M7 14l3-3 3 2 5-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-chart-bar" viewBox="0 0 24 24"><path d="M3 21h18 M7 21v-8 M12 21V7 M17 21v-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-chart-pie" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 2v10h10 M12 12L5 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-magnifying-glass" viewBox="0 0 24 24"><path d="M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12z M15 15l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-shuffle" viewBox="0 0 24 24"><path d="M3 7h4l10 10h4 M3 17h4l3-3 M17 7h4 M14 10l3 3 3-3 M17 4v3l-3 3 M17 14v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-gear" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M12 2v3 M12 19v3 M2 12h3 M19 12h3 M5 5l2 2 M17 17l2 2 M5 19l2-2 M17 7l2-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-gears" viewBox="0 0 24 24"><path d="M10 10a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M10 4v2 M10 18v2 M4 10h2 M16 10h2 M16 16a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M16 10v2 M16 22v0 M22 16h-2 M10 16h2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-wrench" viewBox="0 0 24 24"><path d="M14 7a4 4 0 0 1-5 5L3 18l3 3 6-6a4 4 0 0 1 5-5l-2 2-3-1 1-3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-puzzle-piece" viewBox="0 0 24 24"><path d="M4 4h6l1-2h2l1 2h6v6l2 1v2l-2 1v6h-6l-1 2h-2l-1-2H4v-6l-2-1v-2l2-1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-fire" viewBox="0 0 24 24"><path d="M12 2c1 4-2 5-2 8a4 4 0 0 0 8 0c0-3-3-4-4-8-2 2-4 4-4 7 0-2 1-5 2-7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-bolt-lightning" viewBox="0 0 24 24"><path d="M13 2L4 14h7l-2 8 9-12h-7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-sparkles" viewBox="0 0 24 24"><path d="M12 2l1 4 4 1-4 1-1 4-1-4-4-1 4-1z M18 14l.5 2 2 .5-2 .5-.5 2-.5-2-2-.5 2-.5z M6 14l.5 2 2 .5-2 .5-.5 2-.5-2-2-.5 2-.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-gem" viewBox="0 0 24 24"><path d="M6 3h12l3 6-9 12L3 9z M3 9h18 M9 3l-3 6 6 12 M15 3l3 6-6 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-lock-open" viewBox="0 0 24 24"><path d="M7 11h10v8H7z M7 11V7a5 5 0 0 1 10 0 M12 14v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-compass" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M15 9l-2 4-4 2 2-4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-wifi" viewBox="0 0 24 24"><path d="M12 18a1 1 0 1 0 0 2 1 1 0 0 0 0-2z M8 14a6 6 0 0 1 8 0 M5 11a10 10 0 0 1 14 0 M2 8a14 14 0 0 1 20 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-database" viewBox="0 0 24 24"><path d="M4 6c0-2 4-3 8-3s8 1 8 3-4 3-8 3-8-1-8-3z M4 6v12c0 2 4 3 8 3s8-1 8-3V6 M4 12c0 2 4 3 8 3s8-1 8-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-link" viewBox="0 0 24 24"><path d="M9 15l6-6 M10.5 6.5l1.8-1.8a4.2 4.2 0 0 1 6 6l-2.4 2.4 M13.5 17.5l-1.8 1.8a4.2 4.2 0 0 1-6-6l2.4-2.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</defs>
</svg>

<!-- ============ THIẾT LẬP LẦN ĐẦU ============ -->
<section class="scr" id="setupScreen">
  <div class="authbox">
    <div class="authcard">
      <div class="logo"><svg class="ic"><use href="#i-user-shield"/></svg></div>
      <h1>Thiết lập quản trị</h1>
      <div class="sub">Đặt mật khẩu cho file admin này.<br>Mật khẩu chỉ lưu dưới dạng băm PBKDF2.</div>

      <div style="margin-top:16px">
        <label class="lb" for="pw1">Mật khẩu mới (≥ 8 ký tự, có chữ và số)</label>
        <input type="password" id="pw1" autocomplete="new-password" placeholder="••••••••">
      </div>
      <div style="margin-top:10px">
        <label class="lb" for="pw2">Nhập lại mật khẩu</label>
        <input type="password" id="pw2" autocomplete="new-password" placeholder="••••••••"
               onkeydown="if(event.key==='Enter')doSetup()">
      </div>
      <div class="msg" id="setupMsg"></div>
      <button class="btn pri wide" id="setupBtn" style="margin-top:14px;padding:12px" onclick="doSetup()">
        <svg class="ic"><use href="#i-lock"/></svg> Tạo mật khẩu
      </button>
      <div style="margin-top:12px;border-top:1px solid var(--border);padding-top:10px">
        <label class="lb" for="syncInputSetup">Đã đặt mật khẩu ở máy khác?</label>
        <input type="text" id="syncInputSetup" placeholder="Dán link đồng bộ hoặc mã BG4A-...">
        <button class="btn wide" style="margin-top:7px" onclick="applySyncCode('setup')">
          <svg class="ic"><use href="#i-link"/></svg> Liên kết mật khẩu dùng chung
        </button>
        <div class="msg" id="setupSyncMsg"></div>
      </div>
      <div class="sub" style="margin-top:10px;text-align:center;font-size:.6rem">
        Mất mật khẩu = mất dữ liệu. Hãy lưu mã khôi phục ở bước sau.<br>
        Khoá chủ <b class="mono" style="color:var(--warn)">35879</b> luôn đăng nhập được.
      </div>
    </div>
  </div>
</section>

<!-- ============ MÃ KHÔI PHỤC ============ -->
<section class="scr hide" id="recoverScreen">
  <div class="authbox">
    <div class="authcard">
      <div class="logo" style="background:linear-gradient(140deg,#fbbf24,#fb7185)"><svg class="ic"><use href="#i-key"/></svg></div>
      <h1>Lưu mã khôi phục</h1>
      <div class="sub">Mã này chỉ hiện <b>một lần</b>. Ghi ra giấy hoặc lưu vào nơi an toàn.</div>
      <div class="rec"><b id="recCode">——————</b></div>
      <div class="row" style="gap:7px">
        <button class="btn wide" onclick="copyText(document.getElementById('recCode').textContent,'Đã copy mã khôi phục')">
          <svg class="ic"><use href="#i-copy"/></svg> Copy
        </button>
        <button class="btn wide" onclick="downloadRecovery()"><svg class="ic"><use href="#i-download"/></svg> Tải .txt</button>
      </div>
      <div style="margin-top:14px;border-top:1px solid var(--border);padding-top:12px">
        <div class="lb" style="color:var(--accent)">🔑 MẬT KHẨU DÙNG CHUNG (mọi máy · mọi mạng)</div>
        <div class="sub" style="font-size:.64rem">Gửi <b>link đồng bộ</b> cho máy khác. Máy đó mở link rồi nhập đúng mật khẩu vừa đặt — không cần đặt lại.</div>
        <div class="rec"><b id="syncCode" style="font-size:.7rem;letter-spacing:.06em">——————</b></div>
        <button class="btn wide" onclick="copyText(adminSyncLink(ADMIN.load() &amp;&amp; ADMIN.data.sync),'Đã copy link đồng bộ')">
          <svg class="ic"><use href="#i-link"/></svg> Copy link đồng bộ
        </button>
        <div class="sub" style="margin-top:8px;font-size:.6rem">
          Khoá chủ <b class="mono" style="color:var(--warn)">35879</b> luôn đăng nhập được ở bất kỳ bản copy nào, kể cả khi chưa đồng bộ.
        </div>
      </div>
      <button class="btn wide" style="margin-top:8px" onclick="exportLinkedAdmin()">
        <svg class="ic"><use href="#i-download"/></svg> Xuất bản file admin dùng chung (khuyến nghị)
      </button>
      <button class="btn pri wide" style="margin-top:8px;padding:12px" onclick="finishSetup()">
        <svg class="ic"><use href="#i-check"/></svg> Tôi đã lưu — vào dashboard
      </button>
    </div>
  </div>
</section>

<!-- ============ ĐĂNG NHẬP ============ -->
<section class="scr hide" id="loginScreen">
  <div class="authbox">
    <div class="authcard">
      <div class="logo"><svg class="ic"><use href="#i-lock"/></svg></div>
      <h1>BioGalaxy Admin</h1>
      <div class="sub">Nhập <b>mật khẩu dùng chung</b> do quản trị đặt.<br>
        <span style="font-size:.62rem;color:var(--text3)">Chưa đồng bộ máy này? Bấm "Máy mới — dán mã / link đồng bộ".</span></div>
      <div style="margin-top:16px">
        <input type="password" id="pwLogin" autocomplete="current-password" placeholder="Mật khẩu"
               onkeydown="if(event.key==='Enter')doLogin()">
      </div>
      <div class="msg" id="loginMsg"></div>
      <button class="btn pri wide" id="loginBtn" style="margin-top:12px;padding:12px" onclick="doLogin()">
        <svg class="ic"><use href="#i-right-to-bracket"/></svg> Đăng nhập
      </button>
      <button class="btn wide" style="margin-top:7px" onclick="showSync()">
        <svg class="ic"><use href="#i-link"/></svg> Máy mới — dán mã / link đồng bộ
      </button>
      <div class="hide" id="syncBox" style="margin-top:9px;padding:10px;border:1px dashed var(--border2);border-radius:11px;background:var(--surface2)">
        <div class="sub" style="font-size:.62rem;margin-bottom:6px">Dán <b>mã đồng bộ</b> hoặc cả <b>link</b> admin do quản trị gửi. Chỉ cần làm 1 lần trên mỗi máy.</div>
        <input type="text" id="syncInput" placeholder="BG4A-XXXXXXXX-XXXXXXXX-XXXXXXXX hoặc link #s=...">
        <button class="btn wide" style="margin-top:7px" onclick="applySyncCode()">
          <svg class="ic"><use href="#i-check-double"/></svg> Áp dụng đồng bộ
        </button>
        <div class="msg" id="syncMsg"></div>
      </div>
      <button class="btn wide" style="margin-top:7px" onclick="showRecover()">
        <svg class="ic"><use href="#i-life-ring"/></svg> Quên mật khẩu — dùng mã khôi phục
      </button>
      <div class="hide" id="recBox" style="margin-top:10px">
        <input type="text" id="recInput" placeholder="Mã khôi phục 12 ký tự" style="text-transform:uppercase">
        <button class="btn wide" style="margin-top:7px" onclick="doRecover()">
          <svg class="ic"><use href="#i-unlock"/></svg> Đặt lại mật khẩu
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ============ DASHBOARD ============ -->
<section class="hide" id="dash">
  <div class="top">
    <div class="logo"><svg class="ic"><use href="#i-dna"/></svg></div>
    <div style="min-width:0">
      <h1>BIOGALAXY ADMIN</h1>
      <div class="sub">Bảng điều khiển · v4.0</div>
    </div>
    <div class="spacer"></div>
    <button class="btn" onclick="doLogout()" aria-label="Đăng xuất"><svg class="ic"><use href="#i-arrow-right-from-bracket"/></svg></button>
  </div>

  <div class="wrap stack" style="gap:14px">

    <!-- mã 5 phút -->
    <div class="card codecard">
      <div class="between">
        <h3><svg class="ic"><use href="#i-clock"/></svg>Mã mở khoá hiện tại</h3>
        <span class="pill ok" id="codeState">đang chạy</span>
      </div>
      <div class="bigcode" id="bigCode">------</div>
      <div class="bar"><i id="codeBar" style="width:100%"></i></div>
      <div class="meta">
        <span id="codeLeft">Đổi sau 5:00</span>
        <span>HMAC-SHA256 · bước 300s</span>
      </div>
      <div class="row" style="gap:7px;margin-top:11px">
        <button class="btn wide" onclick="copyText(document.getElementById('bigCode').textContent,'Đã copy mã')">
          <svg class="ic"><use href="#i-copy"/></svg> Copy mã
        </button>
        <button class="btn wide" onclick="showQr()"><svg class="ic"><use href="#i-qrcode"/></svg> QR</button>
      </div>
      <div id="qrBox" class="hide" style="margin-top:10px;text-align:center">
        <div style="background:#fff;display:inline-block;padding:7px;border-radius:12px">
          <img id="qrImg" alt="QR mã mở khoá" width="150" height="150">
        </div>
      </div>
    </div>

    <!-- thống kê -->
    <div class="grid g3">
      <div class="stat"><b id="stStudents">0</b><span>Học sinh</span></div>
      <div class="stat"><b id="stExams">0</b><span>Lượt thi</span></div>
      <div class="stat"><b id="stAvg">—</b><span>Điểm trung bình</span></div>
    </div>

    <!-- key studio -->
    <div class="card">
      <h3><svg class="ic"><use href="#i-key"/></svg>Key Studio</h3>
      <div class="sub" style="margin-top:4px">Key được ký bằng ECDSA P-256. File học sinh chỉ có khoá công khai nên không thể tự tạo key.</div>

      <div class="studio-tabs" style="margin-top:11px" id="studioTabs">
        <button class="on" onclick="setStudioMode('quick',this)"><svg class="ic"><use href="#i-bolt"/></svg> Nhanh</button>
        <button onclick="setStudioMode('custom',this)"><svg class="ic"><use href="#i-calendar"/></svg> Tuỳ chỉnh</button>
        <button onclick="setStudioMode('datetime',this)"><svg class="ic"><use href="#i-clock"/></svg> Đến giờ</button>
      </div>

      <!-- quick presets -->
      <div class="studio-panel on" id="panel-quick">
        <div class="seg" id="segExp" style="margin-top:10px">
          <button data-d="1" onclick="setExp(1,this)">1 ngày</button>
          <button data-d="7" onclick="setExp(7,this)">7 ngày</button>
          <button data-d="30" class="on" onclick="setExp(30,this)">30 ngày</button>
          <button data-d="90" onclick="setExp(90,this)">90 ngày</button>
          <button data-d="0" onclick="setExp(0,this)"><svg class="ic"><use href="#i-infinity"/></svg></button>
        </div>
      </div>

      <!-- custom number + unit -->
      <div class="studio-panel" id="panel-custom">
        <div class="row" style="margin-top:10px;gap:8px">
          <input type="number" id="customNum" value="30" min="1" max="999" style="max-width:90px;text-align:center">
          <select id="customUnit">
            <option value="1" selected>ngày</option>
            <option value="7">tuần</option>
            <option value="30">tháng</option>
            <option value="365">năm</option>
          </select>
        </div>
      </div>

      <!-- datetime-local -->
      <div class="studio-panel" id="panel-datetime">
        <label class="lb" style="margin-top:8px">Hết hạn lúc</label>
        <input type="datetime-local" id="dtPicker" style="font-size:.72rem">
      </div>

      <!-- key note -->
      <div style="margin-top:10px">
        <label class="lb">Ghi chú key (tùy chọn)</label>
        <input type="text" id="keyNote" placeholder="VD: Lớp 12A1, Thi HK1, Vip..." maxlength="40">
      </div>

      <button class="btn pri wide glow-sweep" style="margin-top:12px;padding:12px" onclick="makeKey()">
        <svg class="ic"><use href="#i-wand-magic-sparkles"/></svg> Sinh key
      </button>

      <div id="newKeyBox" class="hide" style="margin-top:10px">
        <div class="keybox" id="newKey"></div>
        <div class="row" style="gap:7px;margin-top:7px">
          <button class="btn wide" onclick="copyText(document.getElementById('newKey').textContent,'Đã copy key')">
            <svg class="ic"><use href="#i-copy"/></svg> Copy key
          </button>
          <button class="btn" onclick="showQrKey()" aria-label="QR key"><svg class="ic"><use href="#i-qrcode"/></svg></button>
          <button class="btn" onclick="testKey()" aria-label="Kiểm tra key"><svg class="ic"><use href="#i-vial"/></svg></button>
        </div>
      </div>
    </div>

    <!-- key vault -->
    <div class="card">
      <div class="between" style="margin-bottom:6px">
        <h3><svg class="ic"><use href="#i-shield-halved"/></svg>Key Vault</h3>
        <span class="pill ok" id="vaultCount">0</span>
      </div>
      <div class="vault-toolbar">
        <input type="text" id="vaultSearch" placeholder="Tìm key hoặc ghi chú..." style="flex:1;min-width:140px;font-size:.72rem;padding:8px 10px">
        <button class="btn sm" onclick="clearKeys()" title="Xoá danh sách"><svg class="ic"><use href="#i-trash-can"/></svg></button>
      </div>
      <div class="vault-filters" style="margin-bottom:8px">
        <span class="kpill all on" data-f="all" onclick="setVaultFilter('all',this)">Tất cả</span>
        <span class="kpill ok" data-f="active" onclick="setVaultFilter('active',this)">Còn hạn</span>
        <span class="kpill warn" data-f="today" onclick="setVaultFilter('today',this)">Hết hôm nay</span>
        <span class="kpill bad" data-f="expired" onclick="setVaultFilter('expired',this)">Hết hạn</span>
      </div>
      <div class="keylist" id="vaultList">
        <div class="sub">Chưa sinh key nào.</div>
      </div>
    </div>

    <!-- nhập dữ liệu -->
    <div class="card">
      <h3><svg class="ic"><use href="#i-file-import"/></svg>Nhập dữ liệu học sinh</h3>
      <div class="sub" style="margin-top:4px">Chọn một hoặc nhiều file JSON do học sinh xuất từ tab Cài đặt.</div>
      <input type="file" id="fileInput" accept=".json,application/json" multiple
             style="margin-top:10px;padding:9px;border:1.5px dashed var(--border2);border-radius:11px;width:100%;font-size:.7rem;background:var(--surface2);color:var(--text2)">
      <div class="row" style="gap:7px;margin-top:9px">
        <button class="btn pri wide" onclick="importFiles()"><svg class="ic"><use href="#i-upload"/></svg> Nhập</button>
        <button class="btn" onclick="clearStudents()" aria-label="Xoá dữ liệu"><svg class="ic"><use href="#i-trash-can"/></svg></button>
      </div>
      <div class="msg" id="importMsg"></div>
    </div>

    <!-- bảng học sinh -->
    <div class="card">
      <div class="between">
        <h3><svg class="ic"><use href="#i-users"/></svg>Danh sách học sinh</h3>
        <button class="btn" style="padding:6px 10px;font-size:.64rem" onclick="exportCsv()">
          <svg class="ic"><use href="#i-file-csv"/></svg> CSV
        </button>
      </div>
      <div class="tblwrap" style="margin-top:9px">
        <table class="tbl" id="tblStudents">
          <thead><tr>
            <th>Học sinh</th><th>Lượt thi</th><th>TB</th><th>Cao nhất</th><th>Yếu nhất</th><th>Cập nhật</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="sub" id="emptyStudents" style="margin-top:8px">Chưa có dữ liệu. Hãy nhập file JSON ở trên.</div>
    </div>

    <!-- cài đặt -->
    <div class="card">
      <h3><svg class="ic"><use href="#i-sliders"/></svg>Cài đặt</h3>
      <div class="stack" style="margin-top:10px">
        <div>
          <label class="lb">Đổi mật khẩu quản trị</label>
          <input type="password" id="pwOld" placeholder="Mật khẩu hiện tại" style="margin-bottom:6px">
          <input type="password" id="pwNew" placeholder="Mật khẩu mới (≥ 8 ký tự)" style="margin-bottom:6px">
          <button class="btn wide" onclick="changePw()"><svg class="ic"><use href="#i-check"/></svg> Cập nhật mật khẩu</button>
          <div class="msg" id="pwMsg"></div>
        </div>
        <div style="border:1px solid rgba(61,220,151,.28);border-radius:12px;padding:11px;background:rgba(61,220,151,.05)">
          <div class="lb" style="color:var(--accent)">🔑 Mật khẩu dùng chung — mọi máy / mọi mạng</div>
          <div class="sub" style="font-size:.63rem">Sau khi đổi mật khẩu, gửi <b>link đồng bộ mới</b> cho các máy khác để chúng dùng cùng một mật khẩu.</div>
          <div class="rec" style="margin:9px 0"><b id="syncCodeDash" class="mono" style="font-size:.68rem">——————</b></div>
          <button class="btn wide" onclick="copyText(adminSyncLink(ADMIN.load() &amp;&amp; ADMIN.data.sync),'Đã copy link đồng bộ')">
            <svg class="ic"><use href="#i-link"/></svg> Copy link đồng bộ
          </button>
          <button class="btn pri wide" style="margin-top:7px" onclick="exportLinkedAdmin()">
            <svg class="ic"><use href="#i-download"/></svg> Xuất bản admin.html dùng chung
          </button>
          <div class="sub" style="margin-top:6px;font-size:.58rem">
            Chép file vừa tải sang mọi máy / mạng → <b>cùng một mật khẩu, không cần dán mã</b>.
          </div>
          <div class="sub" style="margin-top:8px;font-size:.6rem">Khoá chủ <b class="mono" style="color:var(--warn)">35879</b>: đăng nhập mọi lúc mọi nơi, kể cả khi quên mật khẩu.</div>
        </div>
        <div class="sub" style="border-top:1px solid var(--border);padding-top:10px">
          <b>Xuất bản cấu hình:</b> thời lượng phiên và chu kỳ mã được ghi cứng trong <span class="mono">sinh.html</span>
          (hai hằng số <span class="mono">AUTH.SESSION_MIN</span> và <span class="mono">AUTH.STEP</span>).
          Key dài hạn luôn bỏ qua mã 5 phút cho tới khi hết hạn.
        </div>
        <button class="btn wide" style="border-color:rgba(251,113,133,.4);color:var(--bad)" onclick="hardReset()">
          <svg class="ic"><use href="#i-triangle-exclamation"/></svg> Xoá toàn bộ dữ liệu admin
        </button>
      </div>
    </div>

    <div class="sub" style="text-align:center;padding:10px 0 0">
      BioGalaxy Admin 4.0 · giữ kín file này, không chia sẻ cho học sinh
    </div>
  </div>
</section>

<!-- ============ QR MODAL ============ -->
<div class="modal-overlay" id="qrModal" onclick="if(event.target===this)closeQrModal()">
  <div class="modal-box">
    <h3><svg class="ic"><use href="#i-qrcode"/></svg> Mã QR</h3>
    <div class="sub" id="qrModalTitle">Quét để nhập</div>
    <div style="background:#fff;display:inline-block;padding:8px;border-radius:12px;margin-bottom:10px">
      <img id="qrModalImg" alt="QR" width="180" height="180">
    </div>
    <div id="qrModalFallback" class="keybox hide" style="font-size:.56rem;text-align:left;margin-bottom:10px;max-height:120px;overflow:auto"></div>
    <div class="tiny" id="qrModalHint" style="margin-bottom:10px">Quét mã QR bằng điện thoại để nhập nhanh.</div>
    <button class="btn pri wide" onclick="closeQrModal()">Đóng</button>
  </div>
</div>

<!-- audio toggle -->
<div class="audio-toggle on" id="audioToggle" onclick="AudioFX.toggle()" title="Âm thanh">
  <svg class="ic"><use href="#i-volume-high"/></svg>
</div>

<div id="toastWrap"></div>

<script>
/* =========================================================
   AUTH — PBKDF2 cho mật khẩu admin
   ========================================================= */
const _TE = new TextEncoder();
const _TD = new TextDecoder();
const ITER = 100000;

/* =========================================================
   v4.2 — KHOÁ CHỦ 35879 + MẬT KHẨU DÙNG CHUNG
   - 35879: khóa mật cứng, đăng nhập được ở MỌI bản copy, MỌI mạng,
     MỌI lúc (kể cả khi quên mật khẩu / đang bị khoá do sai nhiều lần).
   - Mật khẩu do admin đặt được xác thực bằng "mã đồng bộ": PBKDF2 với
     salt CỐ ĐỊNH (ghi cứng trong file) -> cùng mật khẩu luôn cho cùng mã
     trên mọi máy. Gửi mã/link đồng bộ 1 lần cho máy khác là xong.
   ========================================================= */
const MASTER_KEY = '35879';
/* v4.5 — khi admin bấm "Xuất bản admin.html dùng chung", mã xác thực được
   ghi cứng vào biến này. Mọi bản copy của file đó (mọi máy / mọi mạng) sẽ
   dùng NGAY cùng một mật khẩu mà không cần dán link hay mã đồng bộ. */
const BUILTIN_SYNC = '';
/* Số thẻ script có mặt khi file được nạp — dùng để loại script do tiện ích /
   công cụ chèn vào khi xuất bản, tránh mang code lạ sang bản copy.
   (Không viết ký tự mở thẻ script trong comment: HTML parser có thể nuốt cả file.) */
const ADMIN_ORIGINAL_SCRIPTS = document.scripts.length;
const GLOBAL_SALT = b64u(_TE.encode('BG4-GLOBAL-ADMIN-STATIC-v4.2'));

/** Mã đồng bộ 24 ký tự — deterministic, giống hệt nhau trên mọi bản copy. */
async function adminSyncCode(pass) {
  /* Dùng HEX của 32 byte PBKDF2: chỉ gồm 0-9A-F nên luôn còn nguyên
     24 ký tự sau khi chuẩn hoá (base64url có '-'/'_' sẽ bị gộp mất). */
  const bytes = unb64u(await pbkdf2(pass, GLOBAL_SALT));
  let hex = '';
  for (let i = 0; i < bytes.length; i++) hex += bytes[i].toString(16).padStart(2, '0');
  hex = hex.toUpperCase();
  return 'BG4A-' + hex.slice(0, 8) + '-' + hex.slice(8, 16) + '-' + hex.slice(16, 24);
}
/** Chuẩn hoá mã đồng bộ về đúng 24 ký tự chữ/số hoa. */
function adminSyncNorm(s) {
  const u = String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
  return (u.indexOf('BG4A') === 0 ? u.slice(4) : u).slice(0, 24);
}
function adminSyncFmt(s) {
  const u = adminSyncNorm(s);
  return 'BG4A-' + u.slice(0, 8) + '-' + u.slice(8, 16) + '-' + u.slice(16, 24);
}
/** Link dùng chung: mở trên máy/mạng khác -> copy đó nhận cùng mật khẩu. */
function adminSyncLink(sync) {
  return location.href.split('#')[0] + '#s=' + adminSyncNorm(sync);
}

/** Kiểm tra mật khẩu: khoá chủ > mã đồng bộ > băm cục bộ (tương thích cũ). */
async function adminVerify(pw, d) {
  if (String(pw) === MASTER_KEY) return 'master';
  if (!d) return null;
  /* v4.5 — d.sync (đổi tay / dán link) ưu tiên; BUILTIN_SYNC là dự phòng
     cho bản admin.html đã xuất bản, kể cả khi localStorage bị xoá sạch. */
  const sync = d.sync || (d.builtinOff ? '' : adminSyncNorm(BUILTIN_SYNC));
  if (sync) {
    try { if (adminSyncNorm(await adminSyncCode(pw)) === sync) return 'shared'; } catch (e) { }
  }
  if (d.salt && d.hash) {
    try { if (await pbkdf2(pw, d.salt) === d.hash) return 'local'; } catch (e) { }
  }
  return null;
}

/** base64url không padding. */
function b64u(buf) {
  const b = buf instanceof Uint8Array ? buf : new Uint8Array(buf);
  let s = '';
  for (let i = 0; i < b.length; i++) s += String.fromCharCode(b[i]);
  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
/** base64url → Uint8Array. */
function unb64u(str) {
  const s = String(str).replace(/-/g, '+').replace(/_/g, '/');
  const bin = atob(s + '='.repeat((4 - s.length % 4) % 4));
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

/** Băm mật khẩu bằng PBKDF2-SHA256 100.000 vòng. */
async function pbkdf2(pass, saltB64) {
  const salt = unb64u(saltB64);
  const base = await crypto.subtle.importKey('raw', _TE.encode(pass), 'PBKDF2', false, ['deriveBits']);
  const bits = await crypto.subtle.deriveBits(
    { name: 'PBKDF2', salt: salt, iterations: ITER, hash: 'SHA-256' }, base, 256);
  return b64u(bits);
}

/** Sinh chuỗi ngẫu nhiên từ bảng ký tự cho trước. */
function randStr(n, alpha) {
  const a = alpha || 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const buf = new Uint8Array(n);
  crypto.getRandomValues(buf);
  let s = '';
  for (let i = 0; i < n; i++) s += a[buf[i] % a.length];
  return s;
}

const ADMIN = {
  key: 'bg4_admin',
  data: { salt: '', hash: '', sync: '', rec: '', created: 0, fails: 0, lockUntil: 0 },
  load: function () {
    try {
      const raw = localStorage.getItem(this.key);
      if (raw) this.data = Object.assign(this.data, JSON.parse(raw));
    } catch (e) { }
    return (this.data.hash || this.data.sync) ? this.data : null;
  },
  save: function () { try { localStorage.setItem(this.key, JSON.stringify(this.data)); } catch (e) { } }
};

/* =========================================================
   TOTP — mã 5 phút (giống hệt sinh.html)
   ========================================================= */
const _SKA = [166,195,136,127,152,227,135,151,115,243,93,27,58,149,223,221,87,163,161,162,106,48,122,243,123,72,10,215,183,141,143,119,155,122,245,141,211,0,130,188,119,16,169,72,187,97,201,227,211,238,226,76,239,47,34,65,212,10,82,58,214,206,212,102];
const _SKB = [149,244,188,29,161,219,180,163,75,151,56,125,11,167,239,232,54,192,149,145,83,81,75,149,75,122,61,230,134,185,234,69,173,78,150,186,227,97,177,223,66,115,157,121,131,83,255,129,178,218,208,120,223,75,64,114,178,50,52,2,239,173,225,4];
const STEP = 300;
let _hmacKey = null;

/** Ghép SEED_A từ hai mảng đã làm rối. */
function seedStr() {
  let s = '';
  for (let i = 0; i < _SKA.length; i++) s += String.fromCharCode(_SKA[i] ^ _SKB[i]);
  return s;
}
/** Khoá HMAC dùng lại nhiều lần. */
async function hmacKey() {
  if (!_hmacKey) {
    _hmacKey = await crypto.subtle.importKey('raw', _TE.encode(seedStr()),
      { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  }
  return _hmacKey;
}
/** Mã 6 số của một bước thời gian. */
async function codeFor(step) {
  const k = await hmacKey();
  const buf = new ArrayBuffer(8);
  new DataView(buf).setUint32(4, step >>> 0);
  const sig = new Uint8Array(await crypto.subtle.sign('HMAC', k, buf));
  const off = sig[sig.length - 1] & 0x0f;
  const bin = ((sig[off] & 0x7f) << 24) | (sig[off + 1] << 16) | (sig[off + 2] << 8) | sig[off + 3];
  return String(bin % 1000000).padStart(6, '0');
}

/* =========================================================
   ECDSA — ký key dài hạn (PRIVATE KEY, chỉ ở file này)
   ========================================================= */
const PRIV_JWK = {
  kty: 'EC', crv: 'P-256',
  x: '4g2896sVM4PYhOUN8ZDLethxsL7P_wNGym8thuqLJ8s',
  y: 'Z6QeqmW_HkpvLQ0j3in2GIkQd1MQAojnsPCliSKe7N8',
  d: '2AnUtYsMGOP0bv8AIMylzqIesZd7YVjH_5ME85mggjM'
};
const PUB_JWK = {
  kty: 'EC', crv: 'P-256',
  x: '4g2896sVM4PYhOUN8ZDLethxsL7P_wNGym8thuqLJ8s',
  y: 'Z6QeqmW_HkpvLQ0j3in2GIkQd1MQAojnsPCliSKe7N8'
};
let _privKey = null, _pubKey = null;

/** Import khoá riêng để ký (cache lại). */
async function privKey() {
  if (!_privKey) {
    _privKey = await crypto.subtle.importKey('jwk', PRIV_JWK,
      { name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign']);
  }
  return _privKey;
}
/** Import khoá công khai để tự kiểm tra key vừa sinh. */
async function pubKey() {
  if (!_pubKey) {
    _pubKey = await crypto.subtle.importKey('jwk', PUB_JWK,
      { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
  }
  return _pubKey;
}

/** Tạo key dài hạn đã ký cho số ngày cho trước (0 = vĩnh viễn). */
async function buildKey(days) {
  const id = randStr(16);
  const exp = days === 0 ? 0 : Math.floor(Date.now() / 1000) + days * 86400;
  const payload = 'BG4|' + id + '|' + exp;
  const sig = await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, await privKey(), _TE.encode(payload));
  const idFmt = id.slice(0, 4) + '-' + id.slice(4, 8) + '-' + id.slice(8, 12) + '-' + id.slice(12, 16);
  return {
    key: 'BG4-' + idFmt + '.' + b64u(_TE.encode(String(exp))) + '.' + b64u(sig),
    id: id, exp: exp
  };
}

/* =========================================================
   GIAO DIỆN
   ========================================================= */
function $(id) { return document.getElementById(id); }
function show(id) { ['setupScreen', 'recoverScreen', 'loginScreen'].forEach(function (s) { $(s).classList.toggle('hide', s !== id); }); }
function hideAll() { ['setupScreen', 'recoverScreen', 'loginScreen'].forEach(function (s) { $(s).classList.add('hide'); }); $('dash').classList.add('hide'); }

/** Thông báo nhỏ góc phải. */
function toast(icon, text) {
  const w = $('toastWrap');
  const d = document.createElement('div');
  d.className = 'toast';
  d.innerHTML = '<svg class="ic"><use href="#' + icon + '"/></svg><div>' + escapeHtml(text) + '</div>';
  w.appendChild(d);
  setTimeout(function () { d.style.opacity = '0'; d.style.transition = 'opacity .3s'; }, 2600);
  setTimeout(function () { d.remove(); }, 3000);
}
/** Ghi thông báo trong form. */
function setMsg(id, text, tone) {
  const el = $(id);
  if (!el) return;
  el.className = 'msg on ' + (tone || 'bad');
  el.textContent = text;
}
function clearMsg(id) { const el = $(id); if (el) { el.className = 'msg'; el.textContent = ''; } }

/** Copy văn bản, có fallback cho file://. */
function copyText(text, note) {
  const done = function () { toast('i-check', note || 'Đã copy'); };
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(function () { fallbackCopy(text, done); });
    } else fallbackCopy(text, done);
  } catch (e) { fallbackCopy(text, done); }
}
function fallbackCopy(text, done) {
  try {
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); done();
  } catch (e) { toast('i-circle-info', 'Không copy được, hãy chọn và copy thủ công.'); }
}

/* ---------- thiết lập ---------- */
async function doSetup() {
  const p1 = $('pw1').value, p2 = $('pw2').value;
  if (p1.length < 8) return setMsg('setupMsg', 'Mật khẩu phải dài ít nhất 8 ký tự.', 'bad');
  if (!/[A-Za-z]/.test(p1) || !/\d/.test(p1)) return setMsg('setupMsg', 'Mật khẩu phải có cả chữ và số.', 'bad');
  if (p1 !== p2) return setMsg('setupMsg', 'Hai lần nhập không khớp.', 'bad');
  $('setupBtn').disabled = true;
  try {
    const salt = b64u(crypto.getRandomValues(new Uint8Array(16)));
    const hash = await pbkdf2(p1, salt);
    const sync = adminSyncNorm(await adminSyncCode(p1));
    const rec = randStr(4) + '-' + randStr(4) + '-' + randStr(4);
    const recHash = await pbkdf2(rec.replace(/-/g, ''), salt);
    ADMIN.data = { salt: salt, hash: hash, sync: sync, rec: recHash, created: Date.now(), fails: 0, lockUntil: 0, builtinOff: false };
    ADMIN.save();
    $('recCode').textContent = rec;
    adminRefreshSyncUI();
    window.__rec = rec;
    show('recoverScreen');
    toast('i-shield-halved', 'Đã tạo mật khẩu quản trị');
  } catch (e) {
    setMsg('setupMsg', 'Không tạo được mật khẩu: ' + e.message, 'bad');
  }
  $('setupBtn').disabled = false;
}
function finishSetup() { window.__rec = null; enterDash(); }
/** v4.5 — Tải một bản admin.html có SẴN mã xác thực.
    Chép file này sang bất kỳ máy / mạng nào: cùng một mật khẩu, không cần link. */
function exportLinkedAdmin() {
  ADMIN.load();
  const sync = ADMIN.data.sync || adminSyncNorm(BUILTIN_SYNC);
  if (!sync) { toast('i-triangle-exclamation', 'Chưa có mật khẩu chung', 'Hãy đặt mật khẩu trước.'); return; }
  try {
    const clone = document.documentElement.cloneNode(true);
    const q = function (s) { return clone.querySelector(s); };
    const dash = q('#dash'); if (dash) dash.classList.add('hide');
    ['setupScreen', 'recoverScreen', 'loginScreen'].forEach(function (id) {
      const el = q('#' + id); if (el) el.classList.toggle('hide', id !== 'loginScreen');
    });
    ['recBox', 'syncBox', 'qrBox', 'newKeyBox'].forEach(function (id) {
      const el = q('#' + id); if (el) el.classList.add('hide');
    });
    const qm = q('#qrModal'); if (qm) qm.classList.remove('on');
    const qi = q('#qrModalImg'); if (qi) qi.removeAttribute('src');
    const tw = q('#toastWrap'); if (tw) tw.innerHTML = '';
    const vl = q('#vaultList'); if (vl) vl.innerHTML = '';
    const nk = q('#newKey'); if (nk) nk.textContent = '';
    clone.querySelectorAll('.msg').forEach(function (m) { m.className = 'msg'; m.textContent = ''; });
    clone.querySelectorAll('input[type=password]').forEach(function (x) { x.value = ''; });
    let baked = false, sIdx = 0;
    Array.from(clone.querySelectorAll('script')).forEach(function (sc) {
      if (sIdx++ >= ADMIN_ORIGINAL_SCRIPTS) { sc.remove(); return; }
      if (sc.src || sc.textContent.indexOf('const BUILTIN_SYNC') < 0) return;
      sc.textContent = sc.textContent.replace(/const BUILTIN_SYNC = '[^']*';/,
        "const BUILTIN_SYNC = '" + sync + "';");
      baked = true;
    });
    if (!baked) throw new Error('Không tìm thấy BUILTIN_SYNC trong file');
    const html = '<!DOCTYPE html>\n' + clone.outerHTML;
    const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'admin.html';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
    toast('i-download', 'Đã xuất admin.html dùng chung',
      'Chép file này sang mọi máy / mạng — cùng một mật khẩu, không cần dán mã.', 4800);
  } catch (e) {
    toast('i-triangle-exclamation', 'Không xuất được', e.message, 3600);
  }
}

function downloadRecovery() {
  const t = 'BIOGALAXY ADMIN 4.0 — MÃ KHÔI PHỤC\n\nMã: ' + $('recCode').textContent +
    '\nTạo lúc: ' + new Date().toLocaleString('vi-VN') +
    '\n\nGiữ file này ở nơi an toàn. Mất mã + mất mật khẩu = mất dữ liệu.';
  const blob = new Blob([t], { type: 'text/plain;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = 'biogalaxy-recovery.txt';
  document.body.appendChild(a); a.click(); a.remove();
}

/* ---------- đăng nhập ---------- */
async function doLogin() {
  const pw = $('pwLogin').value;
  if (!pw) return setMsg('loginMsg', 'Chưa nhập mật khẩu.', 'bad');

  /* Khoá chủ: luôn luôn, mọi nơi, bỏ qua cả khoá tạm do sai nhiều lần. */
  if (pw === MASTER_KEY) {
    const md = ADMIN.load();
    if (md) { md.fails = 0; md.lockUntil = 0; ADMIN.save(); }
    clearMsg('loginMsg'); clearMsg('syncMsg');
    $('pwLogin').value = '';
    window.__adminViaMaster = true;
    enterDash();
    toast('i-key', 'Đăng nhập bằng khoá chủ');
    return;
  }

  const d = ADMIN.load();
  if (!d) { show('setupScreen'); return; }
  if (d.lockUntil && Date.now() < d.lockUntil) {
    const s = Math.ceil((d.lockUntil - Date.now()) / 1000);
    return setMsg('loginMsg', 'Tạm khoá. Thử lại sau ' + Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0') + '.', 'bad');
  }
  $('loginBtn').disabled = true;
  try {
    const how = await adminVerify(pw, d);
    if (how) {
      d.fails = 0; d.lockUntil = 0; ADMIN.save();
      clearMsg('loginMsg'); clearMsg('syncMsg');
      $('pwLogin').value = '';
      window.__adminViaMaster = false;
      enterDash();
      if (how === 'shared') toast('i-link', 'Mật khẩu dùng chung — đã xác thực');
    } else {
      d.fails = (d.fails || 0) + 1;
      let lock = 0;
      if (d.fails >= 10) lock = Date.now() + 30 * 60000;
      else if (d.fails >= 5) lock = Date.now() + 5 * 60000;
      d.lockUntil = lock; ADMIN.save();
      const hint = (!d.sync && d.hash) ? ' Máy này chưa có mã đồng bộ — hãy dán link quản trị gửi.' : '';
      if (lock) setMsg('loginMsg', 'Sai ' + d.fails + ' lần. Tạm khoá ' + (d.fails >= 10 ? '30 phút' : '5 phút') + '.' + hint, 'bad');
      else setMsg('loginMsg', 'Mật khẩu không đúng. Còn ' + (5 - d.fails) + ' lần trước khi bị khoá.' + hint, 'bad');
    }
  } catch (e) {
    setMsg('loginMsg', 'Lỗi: ' + e.message, 'bad');
  }
  $('loginBtn').disabled = false;
}

/* ---------- đồng bộ mật khẩu giữa các máy ---------- */
function showSync() { $('syncBox').classList.toggle('hide'); $('recBox').classList.add('hide'); }
function applySyncCode(from) {
  const isSetup = from === 'setup';
  const inp = $(isSetup ? 'syncInputSetup' : 'syncInput');
  const msgId = isSetup ? 'setupSyncMsg' : 'syncMsg';
  const raw = inp ? inp.value : '';
  let code = adminSyncNorm(raw);
  if (code.length !== 24) {
    const m = /#s=([A-Za-z0-9]{24})/.exec(raw);
    if (m) code = adminSyncNorm(m[1]);
  }
  if (code.length !== 24) return setMsg(msgId, 'Mã đồng bộ phải có 24 ký tự (hoặc dán nguyên link #s=...).', 'bad');
  ADMIN.load();
  ADMIN.data.sync = code;
  ADMIN.data.fails = 0; ADMIN.data.lockUntil = 0;
  ADMIN.save();
  inp.value = '';
  adminRefreshSyncUI();
  setMsg(msgId, 'Đã liên kết. Giờ nhập đúng mật khẩu quản trị đã đặt.', 'ok');
  if (isSetup) {
    show('loginScreen');
    setMsg('loginMsg', 'Máy này đã liên kết — nhập mật khẩu dùng chung để vào.', 'ok');
  }
  try { toast('i-check-double', 'Đã liên kết mật khẩu dùng chung'); } catch (e) { }
}
function adminRefreshSyncUI() {
  const s = ADMIN.load() ? (ADMIN.data.sync || '') : '';
  const a = $('syncCode'), b = $('syncCodeDash');
  if (a) a.textContent = s ? adminSyncFmt(s) : '——————';
  if (b) b.textContent = s ? adminSyncFmt(s) : '——————';
}
function showRecover() { $('recBox').classList.toggle('hide'); }
async function doRecover() {
  const d = ADMIN.load();
  const raw = ($('recInput').value || '').trim();
  const code = raw.replace(/-/g, '').toUpperCase();
  const reset = function (note) {
    if (d) { d.hash = ''; d.sync = ''; d.builtinOff = true; d.fails = 0; d.lockUntil = 0; ADMIN.save(); }
    toast('i-key', note);
    show('setupScreen');
    const sm = $('setupMsg'); if (sm) sm.className = 'msg';
  };
  if (code === MASTER_KEY) { reset('Khoá chủ hợp lệ — đặt lại mật khẩu'); return; }
  /* v4.5 — mật khẩu chung (máy khác / bản đã liên kết) cũng dùng để đặt lại,
     không còn phụ thuộc vào mã khôi phục chỉ có trên máy gốc. */
  try {
    const how = await adminVerify(raw, d);
    if (how === 'shared' || how === 'local') { reset('Mật khẩu đúng — đặt lại mật khẩu mới'); return; }
  } catch (e) { }
  if (code.length !== 12) return setMsg('loginMsg', 'Mã khôi phục phải có 12 ký tự, hoặc nhập đúng mật khẩu hiện tại.', 'bad');
  if (!d || !d.salt || !d.rec) return setMsg('loginMsg', 'Máy này chưa có dữ liệu khôi phục cục bộ. Dùng khoá chủ 35879.', 'bad');
  try {
    const h = await pbkdf2(code, d.salt);
    if (h !== d.rec) return setMsg('loginMsg', 'Mã khôi phục không đúng.', 'bad');
    d.hash = ''; d.fails = 0; d.lockUntil = 0; ADMIN.save();
    toast('i-unlock', 'Đã xoá mật khẩu — hãy đặt mật khẩu mới');
    show('setupScreen');
    $('setupMsg').className = 'msg';
  } catch (e) { setMsg('loginMsg', 'Lỗi: ' + e.message, 'bad'); }
}
function doLogout() { hideAll(); show('loginScreen'); clearMsg('loginMsg'); }

/* ---------- dashboard ---------- */
let expDays = 30;

function enterDash() {
  hideAll();
  $('dash').classList.remove('hide');
  AudioFX.init();
  startClock();
  renderVault();
  startVaultTimer();
  bindVaultSearch();
  renderStudents();
  refreshQr();
}

/** Đồng hồ mã 5 phút. */
let clockTimer = null, lastStep = -1;
function startClock() {
  clearInterval(clockTimer);
  tickClock();
  clockTimer = setInterval(tickClock, 1000);
}
async function tickClock() {
  const now = Date.now() / 1000;
  const step = Math.floor(now / STEP);
  const left = STEP - Math.floor(now % STEP);
  const m = Math.floor(left / 60), s = left % 60;
  $('codeLeft').textContent = 'Đổi sau ' + m + ':' + String(s).padStart(2, '0');
  $('codeBar').style.width = (left / STEP * 100).toFixed(1) + '%';
  if (step !== lastStep) {
    lastStep = step;
    try {
      const c = await codeFor(step);
      $('bigCode').textContent = c;
      $('codeState').textContent = 'đang chạy';
      $('codeState').className = 'pill ok';
      refreshQr();
    } catch (e) {
      $('bigCode').textContent = 'LỖI';
      $('codeState').textContent = 'crypto lỗi';
      $('codeState').className = 'pill bad';
    }
  }
}
function showQr() {
  const b = $('qrBox');
  b.classList.toggle('hide');
  if (!b.classList.contains('hide')) refreshQr();
}
function refreshQr() {
  const img = $('qrImg');
  if (!img || $('qrBox').classList.contains('hide')) return;
  const c = $('bigCode').textContent;
  if (!/^\d{6}$/.test(c)) return;
  img.onerror = function () {
    img.style.display = 'none';
    const p = img.parentElement;
    if (p) { p.style.background = 'var(--surface2)'; p.style.color = 'var(--text2)'; p.style.fontSize = '.72rem'; p.style.padding = '12px'; p.textContent = 'Offline — mã: ' + c; }
  };
  img.style.display = '';
  /* v4.5 — chỉ 6 chữ số; prefix 'BG4:' trước đây làm lệch mã khi dán vào ô lọc số */
  img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(c);
}

function setExp(d, btn) {
  expDays = d;
  const bs = document.querySelectorAll('#segExp button');
  for (let i = 0; i < bs.length; i++) bs[i].classList.toggle('on', bs[i] === btn);
}

/* ---------- AudioFX (Web Audio, không file ngoài) ---------- */
const AudioFX = {
  ctx: null, enabled: true,
  init: function () {
    const t = localStorage.getItem('bg4_admin_audio');
    this.enabled = t !== 'off';
    const tg = document.getElementById('audioToggle');
    if (tg) { tg.classList.toggle('on', this.enabled); updateAudioIcon(this.enabled); }
  },
  ctxGet: function () {
    if (!this.ctx) { try { this.ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; } }
    if (this.ctx.state === 'suspended') this.ctx.resume();
    return this.ctx;
  },
  tone: function (freq, dur, type, vol) {
    if (!this.enabled) return;
    const ctx = this.ctxGet(); if (!ctx) return;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type || 'sine'; o.frequency.value = freq;
    g.gain.value = vol || 0.06;
    o.connect(g); g.connect(ctx.destination);
    const now = ctx.currentTime;
    g.gain.setValueAtTime(g.gain.value, now);
    g.gain.exponentialRampToValueAtTime(0.0001, now + dur);
    o.start(now); o.stop(now + dur);
  },
  click: function () { this.tone(520, 0.06, 'square', 0.04); },
  chime: function () { this.tone(660, 0.12, 'sine', 0.07); setTimeout(() => this.tone(880, 0.16, 'sine', 0.06), 90); },
  warn: function () { this.tone(220, 0.25, 'sawtooth', 0.05); },
  toggle: function () {
    this.enabled = !this.enabled;
    localStorage.setItem('bg4_admin_audio', this.enabled ? 'on' : 'off');
    const tg = document.getElementById('audioToggle');
    if (tg) { tg.classList.toggle('on', this.enabled); updateAudioIcon(this.enabled); }
    if (this.enabled) this.chime();
  }
};
function updateAudioIcon(on) {
  const u = document.querySelector('#audioToggle use');
  if (u) u.setAttribute('href', on ? '#i-volume-high' : '#i-volume-xmark');
}

/* ---------- Key Studio ---------- */
let studioMode = 'quick';

function setStudioMode(mode, btn) {
  studioMode = mode;
  const tabs = document.querySelectorAll('#studioTabs button');
  for (let i = 0; i < tabs.length; i++) tabs[i].classList.toggle('on', tabs[i] === btn);
  document.getElementById('panel-quick').classList.toggle('on', mode === 'quick');
  document.getElementById('panel-custom').classList.toggle('on', mode === 'custom');
  document.getElementById('panel-datetime').classList.toggle('on', mode === 'datetime');
  AudioFX.click();
}

function resolveDays() {
  if (studioMode === 'custom') {
    const n = parseInt(document.getElementById('customNum').value, 10) || 1;
    const u = parseInt(document.getElementById('customUnit').value, 10) || 1;
    return n * u;
  }
  if (studioMode === 'datetime') {
    const v = document.getElementById('dtPicker').value;
    if (!v) return null;
    const ms = new Date(v).getTime();
    if (isNaN(ms) || ms <= Date.now()) return null;
    return Math.max(1, Math.ceil((ms - Date.now()) / 86400000));
  }
  return expDays;
}

async function makeKey() {
  const days = resolveDays();
  if (days === null) {
    AudioFX.warn();
    return toast('i-triangle-exclamation', 'Chọn thời điểm trong tương lai.');
  }
  const note = (document.getElementById('keyNote').value || '').trim();
  try {
    const r = await buildKey(days);
    r.note = note;
    r.at = Date.now();
    $('newKeyBox').classList.remove('hide');
    $('newKey').textContent = r.key;
    window.__lastKey = r;
    const list = loadKeyList();
    list.unshift(r);
    localStorage.setItem('bg4_admin_keys', JSON.stringify(list.slice(0, 100)));
    renderVault();
    AudioFX.chime();
    toast('i-key', 'Đã sinh key ' + (days === 0 ? 'vĩnh viễn' : days + ' ngày'));
  } catch (e) {
    AudioFX.warn();
    toast('i-triangle-exclamation', 'Không sinh được key: ' + e.message);
  }
}

function loadKeyList() {
  try { return JSON.parse(localStorage.getItem('bg4_admin_keys') || '[]'); } catch (e) { return []; }
}

/* ---------- Key Vault ---------- */
let vaultFilter = 'all', vaultSearch = '';
let vaultTimer = null;

function fmtTimeLeft(ms) {
  if (ms <= 0) return 'hết hạn';
  const s = Math.floor(ms / 1000);
  const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
  if (d > 0) return d + 'ng ' + h + 'g';
  if (h > 0) return h + 'g ' + m + 'p';
  return m + 'p ' + (s % 60) + 's';
}

function vaultStatus(k) {
  if (!k.exp) return 'active';
  const left = k.exp * 1000 - Date.now();
  if (left <= 0) return 'expired';
  const endOfDay = new Date(); endOfDay.setHours(23, 59, 59, 999);
  if (k.exp * 1000 <= endOfDay.getTime()) return 'today';
  return 'active';
}

function renderVault() {
  const list = loadKeyList();
  $('vaultCount').textContent = list.length;
  const box = $('vaultList');
  const q = (vaultSearch || '').toLowerCase();
  const filtered = list.filter(function (k) {
    const status = vaultStatus(k);
    if (vaultFilter !== 'all' && status !== vaultFilter) return false;
    if (q) {
      const hay = (k.id + ' ' + (k.note || '') + ' ' + (k.key || '')).toLowerCase();
      if (hay.indexOf(q) === -1) return false;
    }
    return true;
  });
  if (!filtered.length) {
    box.innerHTML = '<div class=sub>' + (list.length ? 'Không có key khớp bộ lọc/tìm kiếm.' : 'Chưa sinh key nào.') + '</div>';
    return;
  }
  box.innerHTML = filtered.map(function (k, idx) {
    const status = vaultStatus(k);
    const statusMap = { active: 'ok', today: 'warn', expired: 'bad' };
    const pillCls = statusMap[status] || 'ok';
    const expTxt = k.exp ? new Date(k.exp * 1000).toLocaleString('vi-VN') : '∞';
    const kexpTxt = !k.exp ? 'vĩnh viễn' : (status === 'expired' ? 'đã hết hạn' : 'còn ' + fmtTimeLeft(k.exp * 1000 - Date.now()));
    const noteTxt = k.note ? '<span class="kid" style="color:var(--violet)">📝 ' + escapeHtml(k.note) + '</span>' : '';
    return '<div class="keyitem' + (status === 'expired' ? ' expired' : '') + '">' +
      '<span class="kid">' + k.id.slice(0, 4) + '-' + k.id.slice(4, 8) + '…</span>' +
      noteTxt +
      '<span class="kexp" data-exp="' + (k.exp || 0) + '">' + kexpTxt + '</span>' +
      '<span class="kpill ' + pillCls + '">' + (k.exp ? expTxt : '∞') + '</span>' +
      '<button class="btn" style="padding:3px 7px;font-size:.58rem" onclick="copyKeyAt(' + list.indexOf(k) + ')">copy</button>' +
      '<button class="btn" style="padding:3px 7px;font-size:.58rem" onclick="showQrKey(' + list.indexOf(k) + ')">QR</button>' +
      '</div>';
  }).join('');
}

/* v4.5 — chỉ đổi text đếm ngược, không dựng lại cả danh sách mỗi giây
   (trước đây 100 key = 100 hàng DOM bị tạo lại mỗi 1s). */
function tickVaultCountdowns() {
  const box = $('vaultList'); if (!box) return;
  box.querySelectorAll('.kexp[data-exp]').forEach(function (el) {
    const exp = +el.getAttribute('data-exp');
    if (!exp) return;
    const ms = exp * 1000 - Date.now();
    el.textContent = ms > 0 ? 'còn ' + fmtTimeLeft(ms) : 'đã hết hạn';
  });
}
let vaultFullTick = 0;
function startVaultTimer() {
  clearInterval(vaultTimer);
  vaultTimer = setInterval(function () {
    const dash = document.getElementById('dash');
    if (!dash || dash.classList.contains('hide') || document.hidden) return;
    tickVaultCountdowns();
    /* cập nhật pill trạng thái mỗi 30s */
    if (++vaultFullTick >= 30) { vaultFullTick = 0; renderVault(); }
  }, 1000);
}

let vaultSearchBound = false;
function bindVaultSearch() {
  const inp = $('vaultSearch');
  if (!inp || vaultSearchBound) return;
  vaultSearchBound = true;
  let t = null;
  inp.addEventListener('input', function () {
    clearTimeout(t);
    t = setTimeout(function () { vaultSearch = inp.value || ''; renderVault(); }, 150);
  });
}

function setVaultFilter(f, el) {
  vaultFilter = f;
  const ps = document.querySelectorAll('.vault-filters .kpill');
  for (let i = 0; i < ps.length; i++) ps[i].classList.toggle('on', ps[i] === el);
  renderVault();
  AudioFX.click();
}

function copyKeyAt(i) {
  const k = loadKeyList()[i];
  if (k) { copyText(k.key, 'Đã copy key'); AudioFX.click(); }
}
function clearKeys() {
  if (!confirm('Xoá danh sách key đã sinh? Key đã phát vẫn dùng được.')) return;
  localStorage.removeItem('bg4_admin_keys');
  renderVault();
  AudioFX.click();
}
async function testKey() {
  const k = window.__lastKey;
  if (!k) return;
  try {
    const pk = await pubKey();
    const payload = 'BG4|' + k.id + '|' + k.exp;
    const sig = unb64u(k.key.split('.')[2]);
    const ok = await crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, pk, sig, _TE.encode(payload));
    AudioFX[ok ? 'chime' : 'warn']();
    toast(ok ? 'i-circle-check' : 'i-circle-xmark', ok ? 'Chữ ký hợp lệ — file học sinh sẽ chấp nhận' : 'Chữ ký KHÔNG hợp lệ');
  } catch (e) { toast('i-triangle-exclamation', 'Không kiểm tra được: ' + e.message); }
}

/* ---------- QR modal ---------- */
function showQrModal(content, title) {
  const img = $('qrModalImg');
  const fb = $('qrModalFallback');
  const hint = $('qrModalHint');
  if (fb) { fb.textContent = content; fb.classList.add('hide'); }
  if (hint) hint.textContent = 'Quét mã QR bằng điện thoại để nhập nhanh.';
  img.style.display = '';
  img.onerror = function () {
    img.style.display = 'none';
    if (fb) fb.classList.remove('hide');
    if (hint) hint.textContent = 'Không tải được QR (đang offline) — copy nội dung bên trên.';
  };
  img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=360x360&data=' + encodeURIComponent(content);
  $('qrModalTitle').textContent = title || 'Quét để nhập';
  $('qrModal').classList.add('on');
}
function closeQrModal() { $('qrModal').classList.remove('on'); }
function showQrKey(i) {
  const k = loadKeyList()[i];
  /* v4.5 — KHÔNG thêm prefix: nội dung QR phải dán được thẳng vào ô key của sinh.html */
  if (k) showQrModal(k.key, 'Key: ' + k.id.slice(0, 4) + '-' + k.id.slice(4, 8) + (k.note ? ' (' + k.note + ')' : ''));
}

/* ---------- dữ liệu ---------- */
function loadStudents() {
  try { return JSON.parse(localStorage.getItem('bg4_admin_data') || '[]'); } catch (e) { return []; }
}
function saveStudents(a) { localStorage.setItem('bg4_admin_data', JSON.stringify(a)); }

async function importFiles() {
  const input = $('fileInput');
  if (!input.files || !input.files.length) return setMsg('importMsg', 'Chưa chọn file nào.', 'bad');
  let okN = 0, badN = 0;
  const students = loadStudents();
  for (let i = 0; i < input.files.length; i++) {
    try {
      const text = await input.files[i].text();
      const d = JSON.parse(text);
      if (!d || d.app !== 'biogalaxy') { badN++; continue; }
      const id = (d.student && d.student.name ? d.student.name : 'hs') + '|' + (d.student && d.student.id ? d.student.id : '');
      const idx = students.findIndex(function (s) { return s.id === id; });
      const rec = { id: id, name: (d.student && d.student.name) || 'Học sinh', data: d, at: Date.now() };
      if (idx >= 0) students[idx] = rec; else students.push(rec);
      okN++;
    } catch (e) { badN++; }
  }
  saveStudents(students);
  renderStudents();
  setMsg('importMsg', 'Đã nhập ' + okN + ' file' + (badN ? ' · ' + badN + ' file lỗi' : '') + '.', okN ? 'ok' : 'bad');
  toast('i-file-import', 'Nhập xong ' + okN + ' học sinh');
  input.value = '';
}

/** Tính thống kê cho một học sinh. */
function statsOf(rec) {
  const d = rec.data || {};
  const hist = Array.isArray(d.history) ? d.history : [];
  const scores = hist.map(function (h) { return typeof h.score === 'number' ? h.score : null; }).filter(function (x) { return x !== null; });
  const avg = scores.length ? scores.reduce(function (a, b) { return a + b; }, 0) / scores.length : null;
  const best = scores.length ? Math.max.apply(null, scores) : null;
  let weak = '—';
  const byTopic = (d.progress && d.progress.byTopic) || {};
  let worst = 1, worstKey = null;
  for (const k in byTopic) {
    const t = byTopic[k];
    let ok = 0, n = 0;
    for (const lv in t) { ok += t[lv].ok || 0; n += t[lv].n || 0; }
    if (n >= 2) {
      const r = ok / n;
      if (r < worst) { worst = r; worstKey = k; }
    }
  }
  if (worstKey) weak = worstKey + ' (' + Math.round(worst * 100) + '%)';
  return { exams: hist.length, avg: avg, best: best, weak: weak, at: d.exportedAt || rec.at };
}

function renderStudents() {
  const list = loadStudents();
  const tb = document.querySelector('#tblStudents tbody');
  if (!tb) return;
  $('emptyStudents').style.display = list.length ? 'none' : '';
  let ex = 0, sum = 0, cnt = 0;
  tb.innerHTML = list.map(function (r) {
    const s = statsOf(r);
    ex += s.exams;
    if (s.avg !== null) { sum += s.avg; cnt++; }
    const dt = new Date(s.at).toLocaleDateString('vi-VN');
    return '<tr>' +
      '<td class="nm">' + escapeHtml(r.name) + '</td>' +
      '<td class="sc">' + s.exams + '</td>' +
      '<td class="sc" style="color:var(--accent)">' + (s.avg === null ? '—' : s.avg.toFixed(2)) + '</td>' +
      '<td class="sc">' + (s.best === null ? '—' : s.best.toFixed(1)) + '</td>' +
      '<td>' + escapeHtml(s.weak) + '</td>' +
      '<td class="sc" style="color:var(--text3)">' + dt + '</td>' +
      '</tr>';
  }).join('');
  $('stStudents').textContent = list.length;
  $('stExams').textContent = ex;
  $('stAvg').textContent = cnt ? (sum / cnt).toFixed(2) : '—';
}
function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
  });
}
function clearStudents() {
  if (!confirm('Xoá toàn bộ dữ liệu học sinh đã nhập?')) return;
  if (!confirm('Xác nhận lần 2: thao tác này không hoàn tác được.')) return;
  saveStudents([]);
  renderStudents();
  toast('i-trash-can', 'Đã xoá dữ liệu học sinh');
}
function exportCsv() {
  const list = loadStudents();
  if (!list.length) return toast('i-circle-info', 'Chưa có dữ liệu để xuất.');
  const rows = [['Học sinh', 'Lượt thi', 'Điểm TB', 'Cao nhất', 'Chuyên đề yếu', 'Cập nhật']];
  list.forEach(function (r) {
    const s = statsOf(r);
    rows.push([r.name, s.exams, s.avg === null ? '' : s.avg.toFixed(2),
      s.best === null ? '' : s.best.toFixed(1), s.weak, new Date(s.at).toLocaleDateString('vi-VN')]);
  });
  const csv = '\ufeff' + rows.map(function (r) {
    return r.map(function (c) { return '"' + String(c).replace(/"/g, '""') + '"'; }).join(',');
  }).join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'biogalaxy-bang-diem-' + new Date().toISOString().slice(0, 10) + '.csv';
  document.body.appendChild(a); a.click(); a.remove();
  toast('fa-file-csv', 'Đã xuất CSV');
}

/* ---------- cài đặt ---------- */
async function changePw() {
  const d = ADMIN.load();
  const old = $('pwOld').value, nw = $('pwNew').value;
  if (nw.length < 8) return setMsg('pwMsg', 'Mật khẩu mới phải ≥ 8 ký tự.', 'bad');
  if (!/[A-Za-z]/.test(nw) || !/\d/.test(nw)) return setMsg('pwMsg', 'Mật khẩu mới phải có chữ và số.', 'bad');
  try {
    const how = await adminVerify(old, d);
    if (!how) return setMsg('pwMsg', 'Mật khẩu hiện tại không đúng.', 'bad');
    d.hash = await pbkdf2(nw, d.salt);
    d.sync = adminSyncNorm(await adminSyncCode(nw));
    d.fails = 0; d.lockUntil = 0;
    ADMIN.save();
    adminRefreshSyncUI();
    $('pwOld').value = ''; $('pwNew').value = '';
    setMsg('pwMsg', 'Đã đổi. Hãy copy LINK ĐỒNG BỘ MỚI gửi cho các máy khác.', 'ok');
    toast('i-link', 'Mật khẩu dùng chung đã cập nhật');
  } catch (e) { setMsg('pwMsg', 'Lỗi: ' + e.message, 'bad'); }
}
function hardReset() {
  if (!confirm('Xoá toàn bộ: mật khẩu, key đã sinh, dữ liệu học sinh?')) return;
  if (!confirm('Xác nhận lần 2: không thể hoàn tác.')) return;
  ['bg4_admin', 'bg4_admin_keys', 'bg4_admin_data'].forEach(function (k) { localStorage.removeItem(k); });
  location.reload();
}

/* ---------- khởi chạy ---------- */
(function boot() {
  if (typeof crypto === 'undefined' || !crypto.subtle) {
    document.body.innerHTML = '<div style="padding:40px;text-align:center;font-family:sans-serif">' +
      'Trình duyệt này không hỗ trợ Web Crypto. Hãy dùng Chrome / Edge / Cốc Cốc bản mới.</div>';
    return;
  }
  /* Link đồng bộ #s=<24 ký tự>: tự liên kết mật khẩu dùng chung. */
  let syncedFromLink = false;
  try {
    const m = /#s=([A-Za-z0-9]{24})/.exec(location.hash || '');
    if (m) {
      ADMIN.load();
      ADMIN.data.sync = adminSyncNorm(m[1]);
      ADMIN.save();
      syncedFromLink = true;
      history.replaceState(null, '', location.pathname + location.search);
    }
  } catch (e) { }

  /* v4.5 — bản admin.html đã xuất bản tự mang mã xác thực; nạp vào localStorage
     ngay cả khi máy này chưa từng mở file (hoặc vừa xoá dữ liệu). */
  ADMIN.load();
  if (!ADMIN.data.sync && BUILTIN_SYNC) {
    ADMIN.data.sync = adminSyncNorm(BUILTIN_SYNC);
    ADMIN.save();
  }
  const d = ADMIN.load();
  adminRefreshSyncUI();
  if (!d) show('setupScreen');
  else {
    show('loginScreen');
    if (syncedFromLink) setMsg('loginMsg', 'Máy này đã liên kết. Nhập mật khẩu dùng chung để vào.', 'ok');
  }
  $('pw1').addEventListener('input', function () { clearMsg('setupMsg'); });
  $('pw2').addEventListener('input', function () { clearMsg('setupMsg'); });
  $('pwLogin').addEventListener('input', function () { clearMsg('loginMsg'); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { $('recBox').classList.add('hide'); $('syncBox').classList.add('hide'); $('qrBox').classList.add('hide'); closeQrModal(); }
  });
})();
</script>
</body>
</html>
