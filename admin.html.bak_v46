<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>BioGalaxy Admin 4.0</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<style>/* SVG sprite icon sizing */.ic{display:inline-block;width:1em;height:1em;fill:currentColor;vertical-align:-.125em}
/* ============ v4.1 — giao diện hiện đại ============ */
:root{--ease:cubic-bezier(.22,.8,.28,1)}
.top{background:rgba(7,10,19,.82);box-shadow:0 10px 30px -24px #000,inset 0 -1px 0 rgba(61,220,151,.1)}
.top .logo{position:relative;overflow:hidden}
.top .logo::after,.authcard .logo::after{content:'';position:absolute;inset:0;border-radius:inherit;
  background:linear-gradient(120deg,transparent 40%,rgba(255,255,255,.5) 50%,transparent 60%);
  transform:translateX(-120%);animation:adSheen 5s ease-in-out infinite}
@keyframes adSheen{0%,55%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
.card{transition:border-color .28s var(--ease),box-shadow .28s var(--ease),transform .28s var(--ease)}
.card:hover{border-color:rgba(61,220,151,.24);box-shadow:0 16px 40px -28px rgba(61,220,151,.35)}
.card h3 svg.ico{color:var(--accent)}
.stat{position:relative;overflow:hidden;transition:transform .25s var(--ease),border-color .25s var(--ease)}
.stat:hover{transform:translateY(-2px);border-color:rgba(61,220,151,.35)}
.stat::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(var(--accent),var(--accent2))}
.stat b{background:linear-gradient(100deg,var(--accent),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
.bigcode{background-size:200% auto;animation:adFlow 8s linear infinite}
@keyframes adFlow{to{background-position:200% center}}
.btn,.studio-tabs button,.seg button,.kpill,.audio-toggle{transition:background .2s var(--ease),color .2s var(--ease),border-color .2s var(--ease),transform .16s var(--ease),box-shadow .2s var(--ease)}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px -12px rgba(61,220,151,.8)}
.btn:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent2);outline-offset:2px}
.keybox{position:relative;transition:border-color .2s var(--ease),box-shadow .2s var(--ease)}
.keybox:hover{border-color:var(--accent);box-shadow:0 0 0 3px rgba(61,220,151,.08)}
.keyitem{transition:background .2s var(--ease),transform .18s var(--ease)}
.keyitem:hover{background:rgba(61,220,151,.07);transform:translateX(2px)}
.codecard{position:relative;overflow:hidden}
.codecard::after{content:'';position:absolute;right:-50px;top:-60px;width:180px;height:180px;border-radius:50%;
  background:radial-gradient(circle,rgba(61,220,151,.14),transparent 70%);pointer-events:none}
.modal-box{animation:adPop .3s var(--ease)}
@keyframes adPop{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}
.toast{backdrop-filter:blur(10px)}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:rgba(128,150,180,.28);border-radius:99px}
::-webkit-scrollbar-thumb:hover{background:rgba(61,220,151,.45)}
html{scroll-behavior:smooth}

</style>
<style>
:root{
  --bg:#070a13; --bg2:#0b1020; --surface:#101827; --surface2:#162033;
  --border:#1e2b42; --border2:#2a3b58;
  --text:#e8eefc; --text2:#a9b8d4; --text3:#6b7c9b;
  --accent:#3ddc97; --accent2:#38bdf8; --violet:#a99cf9;
  --ok:#34d399; --warn:#fbbf24; --bad:#fb7185;
  --r:16px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  font-family:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',sans-serif;
  background:var(--bg);color:var(--text);min-height:100vh;line-height:1.55;
  background-image:
    radial-gradient(70% 50% at 12% 0%, rgba(61,220,151,.13), transparent 60%),
    radial-gradient(60% 46% at 92% 8%, rgba(56,189,248,.11), transparent 62%),
    radial-gradient(50% 40% at 60% 100%, rgba(169,156,249,.08), transparent 70%);
  background-attachment:fixed;
}
h1,h2,h3{margin:0;font-weight:800;letter-spacing:-.01em}
.mono{font-family:'JetBrains Mono',monospace}
button{font-family:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:20px 16px 60px}
.hide{display:none!important}

/* ---------- thẻ chung ---------- */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px}
.card h3{font-size:.92rem;display:flex;align-items:center;gap:8px}
.card h3 i{color:var(--accent);font-size:.86rem}
.sub{font-size:.68rem;color:var(--text3);line-height:1.5}
.row{display:flex;align-items:center;gap:9px}
.between{display:flex;align-items:center;justify-content:space-between;gap:10px}
.stack{display:flex;flex-direction:column;gap:10px}
.grid{display:grid;gap:12px}
@media(min-width:760px){.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}}

/* ---------- nút ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:7px;
  padding:10px 14px;border-radius:11px;border:1px solid var(--border2);
  background:var(--surface2);color:var(--text2);font-size:.74rem;font-weight:700;
  cursor:pointer;transition:border-color .18s,color .18s,background .18s,transform .12s;
}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn:active{transform:translateY(1px)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn.pri{
  background:linear-gradient(100deg,var(--accent),var(--accent2));color:#04140f;border:0;
  box-shadow:0 12px 30px -14px var(--accent);font-weight:800;
}
.btn.wide{width:100%}
.btn:disabled{opacity:.5;cursor:not-allowed}

/* ---------- input ---------- */
input[type=text],input[type=password],select,textarea{
  width:100%;padding:11px 13px;border-radius:11px;border:1.5px solid var(--border2);
  background:var(--surface2);color:var(--text);font-size:.8rem;font-family:inherit;
}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(61,220,151,.16)}
label.lb{font-size:.68rem;font-weight:700;color:var(--text2);display:block;margin-bottom:5px}

/* ---------- màn hình khoá ---------- */
.scr{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.authbox{width:100%;max-width:420px}
.authcard{
  background:rgba(16,24,39,.92);border:1px solid var(--border2);border-radius:24px;
  padding:26px 22px;box-shadow:0 40px 90px -40px #000;backdrop-filter:blur(14px);
}
.logo{
  width:56px;height:56px;border-radius:18px;display:grid;place-items:center;margin:0 auto 14px;
  background:linear-gradient(140deg,var(--accent),var(--accent2) 55%,var(--violet));
  color:#04120d;font-size:1.5rem;box-shadow:0 18px 44px -18px var(--accent);
}
.authcard h1{text-align:center;font-size:1.16rem}
.authcard .sub{text-align:center;margin-top:5px}
.msg{font-size:.7rem;line-height:1.5;padding:9px 11px;border-radius:10px;margin-top:10px;display:none}
.msg.on{display:block}
.msg.bad{background:rgba(251,113,133,.13);border:1px solid rgba(251,113,133,.36);color:var(--bad)}
.msg.ok{background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.36);color:var(--ok)}
.msg.warn{background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.36);color:var(--warn)}

/* ---------- header ---------- */
.top{
  position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:10px;
  padding:11px 16px;background:rgba(7,10,19,.9);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
}
.top .logo{width:34px;height:34px;border-radius:11px;margin:0;font-size:.95rem;box-shadow:none}
.top h1{font-size:.9rem}
.top .sub{font-size:.58rem}
.top .spacer{flex:1}

/* ---------- mã 5 phút ---------- */
.codecard{
  background:linear-gradient(150deg,rgba(61,220,151,.14),rgba(56,189,248,.09) 60%,transparent);
  border:1px solid rgba(61,220,151,.3);
}
.bigcode{
  font-family:'JetBrains Mono',monospace;font-size:2.6rem;font-weight:800;letter-spacing:.16em;
  text-align:center;color:var(--accent);line-height:1.1;margin:8px 0 2px;
  text-shadow:0 0 34px rgba(61,220,151,.4);
}
.bar{height:4px;border-radius:2px;background:var(--border);overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .9s linear}
.meta{display:flex;justify-content:space-between;font-size:.62rem;color:var(--text3);margin-top:7px}

/* ---------- thống kê ---------- */
.stat{background:var(--surface2);border:1px solid var(--border);border-radius:13px;padding:11px 13px}
.stat b{display:block;font-family:'JetBrains Mono',monospace;font-size:1.28rem;font-weight:800;color:var(--accent)}
.stat span{font-size:.62rem;color:var(--text3)}

/* ---------- bảng ---------- */
.tbl{width:100%;border-collapse:collapse;font-size:.7rem}
.tbl th{
  text-align:left;font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;
  color:var(--text3);padding:7px 8px;border-bottom:1px solid var(--border2);font-weight:800;
}
.tbl td{padding:9px 8px;border-bottom:1px solid var(--border)}
.tbl tr:last-child td{border-bottom:0}
.tbl .nm{font-weight:700;color:var(--text)}
.tbl .sc{font-family:'JetBrains Mono',monospace;font-weight:800}
.tblwrap{overflow-x:auto;-webkit-overflow-scrolling:touch}

/* ---------- key ---------- */
.keybox{
  font-family:'JetBrains Mono',monospace;font-size:.62rem;line-height:1.55;word-break:break-all;
  background:var(--surface2);border:1px dashed var(--border2);border-radius:11px;padding:10px 12px;
  color:var(--accent2);user-select:all;
}
.keylist{display:flex;flex-direction:column;gap:6px;max-height:230px;overflow:auto}
.keyitem{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:9px;background:var(--surface2);font-size:.64rem}
.keyitem .kid{font-family:'JetBrains Mono',monospace;color:var(--text2);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.keyitem .kexp{color:var(--text3);font-size:.58rem;flex:0 0 auto}
.keyitem.expired .kexp{color:var(--bad)}

/* ---------- toast ---------- */
#toastWrap{position:fixed;right:12px;bottom:16px;z-index:90;display:flex;flex-direction:column;gap:8px;pointer-events:none;max-width:min(320px,84vw)}
.toast{
  display:flex;gap:9px;align-items:flex-start;padding:10px 12px;border-radius:12px;
  background:rgba(22,32,51,.97);border:1px solid var(--border2);box-shadow:0 16px 40px -20px #000;
  animation:tin .3s cubic-bezier(.2,.8,.3,1);font-size:.7rem;
}
.toast i{color:var(--accent);margin-top:2px}
@keyframes tin{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

.seg{display:flex;gap:5px;background:var(--surface2);padding:4px;border-radius:11px;border:1px solid var(--border)}
.seg button{
  flex:1;padding:8px 6px;border-radius:8px;border:0;background:transparent;color:var(--text3);
  font-size:.68rem;font-weight:800;cursor:pointer;transition:.16s;
}
.seg button.on{background:rgba(61,220,151,.16);color:var(--accent)}
.seg button:hover{color:var(--text2)}

.rec{display:flex;gap:8px;align-items:center;justify-content:center;margin:12px 0}
.rec b{
  font-family:'JetBrains Mono',monospace;font-size:1.28rem;font-weight:800;letter-spacing:.12em;
  color:var(--warn);padding:9px 12px;border-radius:11px;background:rgba(251,191,36,.1);
  border:1px dashed rgba(251,191,36,.4);
}
.pill{font-size:.55rem;font-weight:800;padding:2px 7px;border-radius:6px;letter-spacing:.04em}
.pill.ok{background:rgba(52,211,153,.15);color:var(--ok)}
.pill.bad{background:rgba(251,113,133,.15);color:var(--bad)}
.pill.warn{background:rgba(251,191,36,.15);color:var(--warn)}

/* ---------- key studio ---------- */
.studio-tabs{display:flex;gap:5px;background:var(--surface2);padding:4px;border-radius:12px;border:1px solid var(--border)}
.studio-tabs button{flex:1;padding:8px 6px;border-radius:9px;border:0;background:transparent;color:var(--text3);font-size:.68rem;font-weight:800;cursor:pointer;transition:.16s;white-space:nowrap}
.studio-tabs button.on{background:rgba(61,220,151,.16);color:var(--accent)}
.studio-tabs button:hover{color:var(--text2)}
.studio-panel{display:none}
.studio-panel.on{display:block;animation:fadeIn .25s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

.glow-sweep{position:relative;overflow:hidden}
.glow-sweep::before{content:'';position:absolute;inset:0;border-radius:inherit;opacity:0;transition:opacity .3s;background:linear-gradient(105deg,transparent 40%,rgba(61,220,151,.15) 50%,transparent 60%)}
.glow-sweep:hover::before{opacity:1;animation:sweep 1.2s linear infinite}
@keyframes cardSheen{0%{background-position:180% 0}100%{background-position:-80% 0}}
@keyframes viewIn{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:none}}
.panel-in{animation:viewIn .32s cubic-bezier(.2,.8,.3,1)}
.card-hover{transition:transform .2s var(--ease),box-shadow .2s}
.card-hover:hover{transform:translateY(-2px);box-shadow:0 18px 44px -20px rgba(0,0,0,.6)}
@keyframes sweep{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

/* ---------- modern polish ---------- */
:root{--ease:cubic-bezier(.2,.8,.3,1);--glass:rgba(22,32,51,.72)}
.glass{background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);transition:transform .22s var(--ease),box-shadow .22s,border-color .22s}
.card:hover{border-color:var(--border2);box-shadow:0 16px 48px -24px rgba(0,0,0,.55)}
.btn{transition:transform .16s var(--ease),box-shadow .16s,filter .16s}
.btn:active{transform:scale(.95)}
.btn.pri{background:linear-gradient(135deg,var(--accent),var(--accent2));background-size:200% 100%;transition:background-position .4s var(--ease),transform .16s}
.btn.pri:hover{background-position:100% 0;filter:brightness(1.08)}
.keyitem{transition:transform .16s var(--ease),background .16s}
.studio-tabs button,.seg button{transition:all .18s var(--ease)}
.studio-tabs button.on,.seg button.on{box-shadow:0 4px 14px -6px var(--accent)}
input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(61,220,151,.18)}
.rec b{text-shadow:0 0 18px rgba(251,191,36,.35)}
.pill{transition:transform .15s}
.pill:hover{transform:scale(1.06)}

/* ---------- vault ---------- */
.vault-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.vault-filters{display:flex;gap:6px;flex-wrap:wrap}
.kpill{font-size:.58rem;font-weight:800;padding:3px 8px;border-radius:6px;letter-spacing:.03em;cursor:pointer;border:1px solid transparent;transition:.15s}
.kpill.ok{background:rgba(52,211,153,.12);color:var(--ok);border-color:rgba(52,211,153,.3)}
.kpill.bad{background:rgba(251,113,133,.12);color:var(--bad);border-color:rgba(251,113,133,.3)}
.kpill.warn{background:rgba(251,191,36,.12);color:var(--warn);border-color:rgba(251,191,36,.3)}
.kpill.all{background:rgba(169,184,212,.1);color:var(--text2);border-color:var(--border2)}
.kpill.on{box-shadow:0 0 0 2px rgba(61,220,151,.25)}

/* ---------- modal ---------- */
.modal-overlay{position:fixed;inset:0;z-index:80;background:rgba(7,10,19,.85);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:16px}
.modal-overlay.on{display:flex;animation:fadeIn .2s ease}
.modal-box{background:var(--surface);border:1px solid var(--border2);border-radius:20px;padding:22px 20px;max-width:380px;width:100%;box-shadow:0 30px 70px -30px #000;text-align:center}
.modal-box h3{margin-bottom:6px;font-size:1rem}
.modal-box .sub{margin-bottom:14px}

/* ---------- audio toggle ---------- */
.audio-toggle{position:fixed;right:12px;top:12px;z-index:90;width:34px;height:34px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);color:var(--text3);display:grid;place-items:center;cursor:pointer;transition:.2s}
.audio-toggle:hover{color:var(--accent);border-color:var(--accent)}
.audio-toggle.on{color:var(--accent)}

/* ============ v4.5 — polish ============ */
.authcard{background:linear-gradient(165deg,rgba(61,220,151,.05),transparent 42%),rgba(16,24,39,.94)}
.btn,.seg button,.studio-tabs button{transition:transform .16s var(--ease),background .2s var(--ease),
  border-color .2s var(--ease),box-shadow .2s var(--ease)}
.btn:hover{transform:translateY(-1px)}
.btn:active{transform:scale(.97)}
.card{transition:border-color .2s,box-shadow .2s,transform .2s}
.card:hover{border-color:var(--border2)}
#newKey{word-break:break-all;line-height:1.6}
.keyitem{transition:background .16s,transform .16s}
.keyitem:hover{background:rgba(61,220,151,.08)}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
<defs>
<symbol id="i-user-shield" viewBox="0 0 640 512"><path d="M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3 0 498.7 13.3 512 29.7 512H418.3c1.8 0 3.5-.2 5.3-.5c-76.3-55.1-99.8-141-103.1-200.2c-16.1-4.8-33.1-7.3-50.7-7.3H178.3zM528 240c-17.7 0-32 14.3-32 32v48h-64c-17.7 0-32 14.3-32 32V480c0 17.7 14.3 32 32 32H608c17.7 0 32-14.3 32-32V352c0-17.7-14.3-32-32-32H544V272c0-17.7-14.3-32-32-32H528zM512 480V352h96V480H512z"/></symbol>
<symbol id="i-key" viewBox="0 0 512 512"><path d="M336 352c97.2 0 176-78.8 176-176S433.2 0 336 0S160 78.8 160 176c0 18.7 2.9 36.8 8.3 53.7L7 391c-4.5 4.5-7 10.6-7 17v80c0 13.3 10.7 24 24 24h80c13.3 0 24-10.7 24-24V448h40c13.3 0 24-10.7 24-24V384h40c6.4 0 12.5-2.5 17-7l33.3-33.3c16.9 5.4 35 8.3 53.7 8.3zm40-176c-22.1 0-40-17.9-40-40s17.9-40 40-40s40 17.9 40 40s-17.9 40-40 40z"/></symbol>
<symbol id="i-lock" viewBox="0 0 448 512"><path d="M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z"/></symbol>
