<!DOCTYPE html>
<html lang="vi" data-theme="dark" data-layout="auto" data-size="md">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#070a13">
<title>BioGalaxy • Sinh Học 12</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<!-- v4.2 — PeerJS: 3 CDN dự phòng, tránh "mạng này chặn CDN kia" -->
<script>
(function () {
  var CDNS = [
    'https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js',
    'https://cdn.jsdelivr.net/npm/peerjs@1.5.2/dist/peerjs.min.js',
    'https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.2/peerjs.min.js'
  ];
  var _res = null, _rej = null, settled = false;
  var ready = new Promise(function (res, rej) { _res = res; _rej = rej; });
  ready.catch(function () { });   /* tránh unhandled rejection khi mọi CDN bị chặn */
  function done() { if (!settled && typeof Peer !== 'undefined') { settled = true; _res(true); } }
  var i = 0;
  window.__peerNext = function () {
    if (done() || settled) return;
    if (typeof Peer !== 'undefined') return done();
    if (i >= CDNS.length) { if (!settled) { settled = true; _rej(new Error('ALL_CDN_BLOCKED')); } return; }
    var s = document.createElement('script');
    s.src = CDNS[i++]; s.async = true;
    s.onload = function () { typeof Peer !== 'undefined' ? done() : window.__peerNext(); };
    s.onerror = function () { window.__peerNext(); };
    document.head.appendChild(s);
  };
  window.peerjsReady = function () {
    if (typeof Peer !== 'undefined') { if (!settled) { settled = true; _res(true); } return ready; }
    return ready;
  };
  window.__peerNext();
})();
</script>
<style>
/* ============ TOKENS ============ */
:root{
  --accent:#3ddc97; --accent2:#38bdf8; --nebula:#8b7cf6;
  --ok:#34d399; --warn:#fbbf24; --bad:#fb7185;
  --r-lg:18px; --r:13px; --r-sm:9px;
  --dock-h:66px;
}
html[data-theme="dark"]{
  --bg:#070a13; --bg2:#0a0f1c; --frame:#04060b;
  --surface:rgba(15,21,36,.82); --surface2:rgba(24,32,50,.66); --surface3:#0e1524;
  --border:rgba(255,255,255,.075); --border2:rgba(255,255,255,.14);
  --text:#e7eefa; --text2:#a5b2c6; --text3:#7e8ca2;
  --violet:#a99cf9;
  --au1:rgba(16,185,129,.17); --au2:rgba(109,94,252,.15); --au3:rgba(56,189,248,.10);
  --shadow:0 18px 44px -22px rgba(0,0,0,.95);
  --glow:0 0 0 1px rgba(61,220,151,.18), 0 8px 26px -14px rgba(61,220,151,.55);
  --star:.55;
}
html[data-theme="light"]{
  --bg:#eff7f3; --bg2:#e8f1fb; --frame:#dae7e2;
  --surface:rgba(255,255,255,.9); --surface2:rgba(243,250,247,.92); --surface3:#f7fcfa;
  --border:rgba(12,58,44,.10); --border2:rgba(12,58,44,.18);
  --text:#0c211a; --text2:#3d5a4f; --text3:#5d7a6e;
  --accent:#0a8f66; --accent2:#0b7ec4; --nebula:#6d5efc; --violet:#6d5efc;
  --au1:rgba(16,185,129,.15); --au2:rgba(109,94,252,.09); --au3:rgba(56,189,248,.10);
  --shadow:0 16px 40px -26px rgba(12,58,44,.32);
  --glow:0 0 0 1px rgba(16,140,98,.18), 0 8px 24px -16px rgba(16,140,98,.4);
  --star:0;
}
html[data-theme="light"] .btn.pri,
html[data-theme="light"] .seg button.on,
html[data-theme="light"] .logo { color:#fff }
html[data-theme="light"] .chip.on { color:#0a8f66 }
html[data-theme="light"] .opt.sel { background:rgba(11,126,196,.10) }
html[data-size="sm"]{font-size:13px}
html[data-size="md"]{font-size:14px}
html[data-size="lg"]{font-size:16px}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  background-color:var(--bg);color:var(--text);
  font-family:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  font-size:1rem;line-height:1.55;min-height:100dvh;
  overflow-x:hidden;-webkit-font-smoothing:antialiased;
}
/* ============ BACKGROUND ============ */
#aurora{
  position:fixed;inset:-25%;z-index:0;pointer-events:none;
  background:
    radial-gradient(38% 34% at 12% 8%, var(--au1), transparent 68%),
    radial-gradient(34% 38% at 88% 16%, var(--au2), transparent 70%),
    radial-gradient(48% 40% at 48% 98%, var(--au3), transparent 72%),
    radial-gradient(26% 26% at 70% 62%, rgba(139,124,246,.07), transparent 70%);
  filter:blur(6px);
  animation:drift 30s ease-in-out infinite alternate;
}
@keyframes drift{
  0%{transform:translate3d(0,0,0) scale(1)}
  50%{transform:translate3d(2%,-1.5%,0) scale(1.06)}
  100%{transform:translate3d(-2%,2%,0) scale(1.02)}
}
#stars{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:var(--star);transition:opacity .5s}
html[data-fx="off"] #aurora{animation:none;filter:none}
html[data-fx="off"] #stars{display:none}

/* ============ APP FRAME ============ */
.app{position:relative;z-index:1;max-width:1120px;margin:0 auto;padding:0 12px calc(var(--dock-h) + 34px)}
html[data-layout="phone"] body{background:var(--frame);padding:12px 0}
html[data-layout="phone"] .app{
  max-width:432px;width:432px;height:calc(100dvh - 24px);overflow-y:auto;overflow-x:hidden;
  border:1px solid var(--border2);border-radius:30px;
  box-shadow:0 30px 90px -30px rgba(0,0,0,.55),0 0 0 10px rgba(0,0,0,.06);
  padding-bottom:calc(var(--dock-h) + 18px);scrollbar-width:thin;
}
html[data-layout="phone"] .app::-webkit-scrollbar{width:5px}
html[data-layout="phone"] .app::-webkit-scrollbar-thumb{background:var(--border2);border-radius:9px}
html[data-layout="phone"] .dock{width:410px;bottom:18px;border-radius:20px}
html[data-layout="phone"] .topbar{top:0;border-radius:30px 30px 0 0}
@media (max-width:640px){
  html[data-layout="phone"] body{padding:0;background:var(--bg)}
  html[data-layout="phone"] .app{width:100%;max-width:none;height:auto;border:0;border-radius:0;box-shadow:none;padding-bottom:calc(var(--dock-h) + 30px);overflow:visible}
  html[data-layout="phone"] .dock{width:calc(100% - 16px);bottom:8px;border-radius:20px}
}

/* ============ TOPBAR ============ */
.topbar{
  position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:8px;
  padding:9px 2px;margin:0 -12px 10px;padding-left:12px;padding-right:12px;
  background:linear-gradient(180deg,var(--bg) 20%,transparent);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
}
.brand{display:flex;align-items:center;gap:9px;min-width:0}
.logo{
  width:34px;height:34px;border-radius:11px;flex:0 0 auto;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--accent),var(--accent2) 60%,var(--nebula));
  color:#04140d;font-size:15px;box-shadow:var(--glow);
}
.brand h1{margin:0;font-size:.86rem;font-weight:800;letter-spacing:.04em;line-height:1.1;
  background:linear-gradient(100deg,var(--accent),var(--accent2) 55%,var(--nebula));
  -webkit-background-clip:text;background-clip:text;color:transparent;white-space:nowrap}
.brand p{margin:1px 0 0;font-size:.56rem;letter-spacing:.13em;text-transform:uppercase;color:var(--text3);font-weight:600}
.iconbtn{
  width:33px;height:33px;border-radius:11px;display:grid;place-items:center;
  background:var(--surface2);border:1px solid var(--border);color:var(--text2);
  font-size:.78rem;cursor:pointer;transition:.2s;flex:0 0 auto;
}
.iconbtn:hover{color:var(--accent);border-color:var(--border2);transform:translateY(-1px)}
.iconbtn:active{transform:scale(.94)}

/* ============ CARDS & TYPE ============ */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);
  box-shadow:var(--shadow);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.pad{padding:14px}
.pad-sm{padding:11px}
.stack{display:flex;flex-direction:column;gap:10px}
.row{display:flex;align-items:center;gap:8px}
.between{display:flex;align-items:center;justify-content:space-between;gap:8px}
.wrap{display:flex;flex-wrap:wrap;gap:6px}
.grid{display:grid;gap:8px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (min-width:760px){.md-g2{grid-template-columns:repeat(2,minmax(0,1fr))}.md-g3{grid-template-columns:repeat(3,minmax(0,1fr))}}
h2.sec{margin:16px 0 8px;font-size:.74rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);display:flex;align-items:center;gap:7px}
h3.tt{margin:0;font-size:.92rem;font-weight:800;line-height:1.3}
p{margin:0}
.muted{color:var(--text2)}
.tiny{font-size:.72rem;color:var(--text3);line-height:1.5}
.xs{font-size:.78rem}
.mono{font-family:ui-monospace,'JetBrains Mono','Cascadia Mono',Consolas,monospace}
.b{font-weight:800}
sub,sup{font-size:.68em;line-height:0}
b,strong{font-weight:700;color:var(--text)}

/* ============ CONTROLS ============ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:9px 13px;border-radius:var(--r);border:1px solid var(--border);
  background:var(--surface2);color:var(--text);font-size:.76rem;font-weight:700;
  font-family:inherit;cursor:pointer;transition:.18s;line-height:1.2;
}
.btn:hover{border-color:var(--border2)}
.btn:active{transform:scale(.975)}
.btn.pri{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#04140d;border-color:transparent;box-shadow:0 8px 22px -12px rgba(61,220,151,.8)}
.btn.pri:hover{filter:brightness(1.06)}
.btn.sm{padding:6px 10px;font-size:.7rem;border-radius:10px}
.btn.wide{width:100%}
.btn.on{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#04140d;border-color:transparent;font-weight:800}
.chip{
  display:inline-flex;align-items:center;gap:5px;padding:6px 11px;border-radius:99px;
  background:var(--surface2);border:1px solid var(--border);color:var(--text2);
  font-size:.71rem;font-weight:700;cursor:pointer;transition:.18s;white-space:nowrap;font-family:inherit
}
.chip:hover{color:var(--text);border-color:var(--border2)}
.chip.on{background:linear-gradient(135deg,rgba(61,220,151,.2),rgba(56,189,248,.14));color:var(--accent);border-color:rgba(61,220,151,.4)}
.seg{display:flex;gap:3px;padding:3px;border-radius:12px;background:var(--surface2);border:1px solid var(--border)}
.seg button{flex:1;padding:7px 6px;border:0;border-radius:9px;background:transparent;color:var(--text3);
  font-size:.71rem;font-weight:700;font-family:inherit;cursor:pointer;transition:.18s;white-space:nowrap}
.seg button.on{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#04140d}
select,input[type=text],input[type=number]{
  font-family:inherit;font-size:.78rem;padding:8px 10px;border-radius:10px;
  background:var(--surface3);color:var(--text);border:1px solid var(--border);outline:none;transition:.18s;width:100%
}
select:focus,input[type=text]:focus{border-color:var(--accent)}
input[type=range]{
  -webkit-appearance:none;appearance:none;width:100%;height:5px;border-radius:99px;outline:none;
  background:linear-gradient(90deg,var(--accent),var(--accent2));opacity:.9;cursor:pointer;margin:6px 0
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:17px;height:17px;border-radius:50%;cursor:pointer;
  background:#fff;border:3px solid var(--accent);box-shadow:0 2px 8px rgba(0,0,0,.35);transition:transform .15s
}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.15)}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:50%;background:#fff;border:3px solid var(--accent)}
.bar{height:6px;border-radius:99px;background:rgba(128,140,160,.22);overflow:hidden}
.bar>i{display:block;height:100%;border-radius:99px;transition:width .45s cubic-bezier(.4,0,.2,1)}
.switch{position:relative;width:44px;height:26px;border-radius:99px;background:rgba(128,140,160,.3);border:0;cursor:pointer;transition:.22s;flex:0 0 auto}
.switch::after{content:'';position:absolute;top:4px;left:4px;width:18px;height:18px;border-radius:50%;background:#fff;transition:.22s}
.switch.on{background:linear-gradient(135deg,var(--accent),var(--accent2))}
.switch.on::after{left:22px}

/* ============ DOCK ============ */
.dock{
  position:fixed;left:50%;transform:translateX(-50%);
  bottom:calc(8px + env(safe-area-inset-bottom));z-index:60;
  display:flex;gap:1px;padding:5px;width:min(552px,calc(100% - 14px));
  background:var(--surface);border:1px solid var(--border2);border-radius:20px;
  backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);
  box-shadow:0 12px 34px -12px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.06);
}
.dock button{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
  padding:6px 1px;border:0;border-radius:15px;background:transparent;color:var(--text3);
  font-size:.55rem;font-weight:700;font-family:inherit;cursor:pointer;transition:.2s;letter-spacing:.01em
}
.dock button i{font-size:.95rem;transition:transform .2s}
.dock button.on{color:var(--accent);background:linear-gradient(180deg,rgba(61,220,151,.16),rgba(56,189,248,.05))}
.dock button.on i{transform:translateY(-1px) scale(1.06)}
.dock button:active{transform:scale(.94)}

/* ============ VIEWS ============ */
.view{display:none}
.view.on{display:block;animation:slideIn .3s cubic-bezier(.2,.8,.3,1)}
@keyframes slideIn{from{transform:translateY(10px)}to{transform:none}}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001s!important;animation-iteration-count:1!important;transition-duration:.001s!important}
  #aurora{animation:none}
}

/* ============ ACCORDION ============ */
.acc{border:1px solid var(--border);border-radius:var(--r);background:var(--surface2);overflow:hidden}
.acc>summary{
  list-style:none;cursor:pointer;padding:10px 12px;display:flex;align-items:center;gap:9px;
  font-size:.8rem;font-weight:700;transition:.18s
}
.acc>summary::-webkit-details-marker{display:none}
/* v5.7b — FIX: app không nạp font Font Awesome nên ký tự \f078 hiện thành ô trống.
   Thay bằng mũi tên vẽ bằng CSS (thuần, không phụ thuộc font). */
.acc>summary::after{content:'';flex:0 0 auto;width:6px;height:6px;margin-left:auto;
  border-right:2px solid var(--text3);border-bottom:2px solid var(--text3);
  transform:rotate(45deg);transition:transform .25s}
.acc[open]>summary::after{transform:rotate(-135deg)}
.acc[open]>summary{border-bottom:1px solid var(--border);color:var(--accent)}
.acc .body{padding:11px 12px;font-size:.78rem;line-height:1.65;color:var(--text2)}
.acc .body b{color:var(--text)}
.acc .body ul{margin:5px 0;padding-left:16px}
.acc .body li{margin:3px 0}

/* ============ OPTIONS / Q ============ */
.opt{
  display:flex;gap:8px;align-items:flex-start;width:100%;text-align:left;
  padding:9px 11px;border-radius:11px;border:1px solid var(--border);
  background:var(--surface3);color:var(--text2);font-size:.79rem;font-family:inherit;
  cursor:pointer;transition:.16s;line-height:1.45
}
.opt:hover{border-color:var(--border2);color:var(--text)}
.opt .k{font-weight:800;font-size:.72rem;color:var(--text3);flex:0 0 auto;min-width:14px}
.opt.sel{border-color:var(--accent2);background:rgba(56,189,248,.12);color:var(--text);font-weight:600}
.opt.sel .k{color:var(--accent2)}
.opt.ok{border-color:var(--ok);background:rgba(52,211,153,.13);color:var(--text);font-weight:600}
.opt.ok .k{color:var(--ok)}
.opt.bad{border-color:var(--bad);background:rgba(251,113,133,.11);color:var(--text)}
.opt.bad .k{color:var(--bad)}
.qcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:13px;box-shadow:var(--shadow)}
.qnum{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:7px;
  font-size:.63rem;font-weight:800;font-family:'JetBrains Mono',monospace;letter-spacing:.04em;
  background:rgba(56,189,248,.13);color:var(--accent2);border:1px solid rgba(56,189,248,.22)}
.qnum.p{background:rgba(139,124,246,.14);color:var(--violet);border-color:rgba(139,124,246,.24)}
.qnum.a{background:rgba(251,191,36,.13);color:var(--warn);border-color:rgba(251,191,36,.22)}
.qtext{font-size:.85rem;font-weight:600;line-height:1.55;color:var(--text);margin:8px 0 9px}
.exp{
  margin-top:9px;padding:9px 11px;border-radius:11px;font-size:.74rem;line-height:1.6;
  background:rgba(61,220,151,.07);border:1px solid rgba(61,220,151,.16);color:var(--text2)
}
.exp .tip{color:var(--accent);font-weight:800;display:block;margin-bottom:3px}
.exp .trap{color:var(--warn);display:block;margin-top:4px;font-size:.72rem}
.tfrow{padding:9px 10px;border-radius:11px;background:var(--surface3);border:1px solid var(--border);margin-bottom:6px}
.tfbtns{display:flex;gap:5px;margin-top:7px}
.tfbtns button{flex:1;padding:6px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);
  color:var(--text3);font-size:.68rem;font-weight:800;font-family:inherit;cursor:pointer;transition:.16s}
.tfbtns button.t{background:rgba(52,211,153,.18);border-color:var(--ok);color:var(--ok)}
.tfbtns button.f{background:rgba(251,113,133,.16);border-color:var(--bad);color:var(--bad)}
.cells{display:flex;gap:5px}
.cell{width:30px;height:36px;border-radius:8px;background:var(--surface3);border:1px solid var(--border2);
  display:grid;place-items:center;font-family:'JetBrains Mono',monospace;font-weight:800;font-size:.9rem;color:var(--warn)}

/* ============ LAB ============ */
.labstage{border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--border);background:#04070e;position:relative}
html[data-theme="light"] .labstage{background:#f2f8f5}
.labstage canvas{display:block;width:100%;height:100%}
.cwrap{position:relative;width:100%;aspect-ratio:16/10}
@media (min-width:760px){.cwrap{aspect-ratio:16/8}}
.ctag{position:absolute;bottom:8px;left:8px;display:flex;gap:5px;flex-wrap:wrap;pointer-events:none;max-width:calc(100% - 16px)}
.pill{padding:3px 8px;border-radius:99px;font-size:.6rem;font-weight:800;letter-spacing:.03em;
  background:rgba(4,7,14,.55);border:1px solid rgba(255,255,255,.14);color:#cfe3dc;backdrop-filter:blur(6px)}
html[data-theme="light"] .pill{background:rgba(255,255,255,.8);border-color:rgba(12,58,44,.14);color:#2c5346}
.readout{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 10px;border-radius:10px;
  background:var(--surface3);border:1px solid var(--border);font-size:.72rem;min-width:0}
.readout .muted{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.readout .v{font-family:'JetBrains Mono',monospace;font-weight:700;text-align:right;flex:1 1 auto;min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (max-width:560px){
  #labReadouts{grid-template-columns:1fr!important}
  .readout .muted{flex:1 1 auto}
  .readout .v{flex:0 0 auto;max-width:52%}
  .dock button span{font-size:.52rem}
  .brand h1{font-size:.8rem}
}

/* ============ MISC ============ */
.hero{padding:16px;border-radius:var(--r-lg);position:relative;overflow:hidden;
  background:linear-gradient(135deg,rgba(61,220,151,.14),rgba(56,189,248,.09) 45%,rgba(139,124,246,.13));
  border:1px solid var(--border2)}
.hero h2{margin:0 0 4px;font-size:1.05rem;font-weight:800;letter-spacing:-.01em}
.hero p{font-size:.75rem;color:var(--text2);line-height:1.55}
.stat{padding:8px;border-radius:11px;background:rgba(255,255,255,.06);border:1px solid var(--border);text-align:center}
html[data-theme="light"] .stat{background:rgba(255,255,255,.65)}
.stat b{display:block;font-size:.95rem;font-family:'JetBrains Mono',monospace;color:var(--accent)}
.stat span{font-size:.58rem;color:var(--text3);letter-spacing:.05em;text-transform:uppercase}
.modal{position:fixed;inset:0;z-index:80;display:grid;place-items:center;padding:16px;background:rgba(2,5,10,.7);backdrop-filter:blur(6px)}
.modal.hide{display:none}
.modal .box{width:100%;max-width:380px;background:var(--surface);border:1px solid var(--border2);border-radius:22px;padding:18px;box-shadow:0 30px 80px -30px #000}
.divider{height:1px;background:var(--border);margin:10px 0}
.hl{color:var(--accent);font-weight:700}
.badge{font-size:.6rem;font-weight:800;padding:3px 7px;border-radius:6px;letter-spacing:.03em}
.badge.g{background:rgba(52,211,153,.15);color:var(--ok)}
.badge.r{background:rgba(251,113,133,.14);color:var(--bad)}
.badge.y{background:rgba(251,191,36,.14);color:var(--warn)}
.badge.b{background:rgba(56,189,248,.14);color:var(--accent2)}
.scrollx{display:flex;gap:6px;overflow-x:auto;padding-bottom:3px;scrollbar-width:none}
.scrollx::-webkit-scrollbar{display:none}
@media (min-width:820px){.scrollx{flex-wrap:wrap;overflow:visible}}
.fadein{animation:fade .3s ease both}
.empty{text-align:center;padding:26px 12px;color:var(--text3);font-size:.78rem}
#examConfig,#examRoom,#examReport{max-width:840px;margin-left:auto;margin-right:auto}
html.no-anim,html.no-anim *,html.no-anim *::before,html.no-anim *::after{
  transition:none!important;animation:none!important
}

/* ============================================================
   PRO LAYER — tinh chỉnh giao diện chuẩn app học tập
   ============================================================ */
:root{
  --r-xl:24px;
  --ease:cubic-bezier(.22,.9,.28,1);
  --ink-ok:rgba(52,211,153,.14);
  --ink-bad:rgba(251,113,133,.13);
  --ink-warn:rgba(251,191,36,.13);
  --ink-info:rgba(56,189,248,.13);
  --ink-violet:rgba(139,124,246,.14);
}
html[data-theme="light"]{
  --ink-ok:rgba(16,150,110,.12);
  --ink-bad:rgba(220,60,90,.10);
  --ink-warn:rgba(200,140,10,.13);
  --ink-info:rgba(11,126,196,.11);
  --ink-violet:rgba(109,94,252,.10);
}
/* --- focus ring, a11y --- */
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:8px}
button:focus:not(:focus-visible){outline:none}
/* --- nicer scrollbars --- */
*{scrollbar-width:thin;scrollbar-color:var(--border2) transparent}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:99px;border:2px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:var(--text3);background-clip:padding-box}

/* --- section heading with index --- */
h2.sec{position:relative;padding-left:0}
h2.sec i{color:var(--accent);opacity:.9;font-size:.72rem}
h2.sec::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,var(--border2),transparent)}

/* --- hero v2: mesh + sheen --- */
.hero{position:relative;isolation:isolate;overflow:hidden}
.hero::before{
  content:'';position:absolute;inset:-40% -10% auto -10%;height:180%;
  background:
    radial-gradient(42% 52% at 18% 0%, rgba(61,220,151,.30), transparent 62%),
    radial-gradient(38% 48% at 82% 12%, rgba(56,189,248,.26), transparent 66%),
    radial-gradient(46% 46% at 58% 100%, rgba(139,124,246,.26), transparent 70%);
  filter:blur(22px);z-index:-1;pointer-events:none;
  animation:mesh 22s var(--ease) infinite alternate;
}
@keyframes mesh{
  0%{transform:translate3d(0,0,0) scale(1)}
  100%{transform:translate3d(-3%,2%,0) scale(1.08)}
}
html[data-fx="off"] .hero::before{animation:none}
html[data-theme="light"] .hero{background:linear-gradient(135deg,rgba(255,255,255,.9),rgba(240,252,247,.85) 55%,rgba(238,246,255,.9))}
.hero::after{
  content:'';position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:linear-gradient(180deg,rgba(255,255,255,.10),transparent 42%);
}
html[data-theme="light"] .hero::after{background:linear-gradient(180deg,rgba(255,255,255,.65),transparent 50%)}

/* --- panel: card with header --- */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);
  box-shadow:var(--shadow);overflow:hidden;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.panel-h{display:flex;align-items:center;gap:9px;padding:11px 13px;border-bottom:1px solid var(--border);
  background:linear-gradient(180deg,rgba(255,255,255,.05),transparent)}
html[data-theme="light"] .panel-h{background:linear-gradient(180deg,rgba(255,255,255,.7),transparent)}
.panel-h .ico{width:27px;height:27px;border-radius:9px;display:grid;place-items:center;font-size:.72rem;flex:0 0 auto;
  background:var(--ink-info);color:var(--accent2);border:1px solid rgba(56,189,248,.22)}
.panel-h h3{margin:0;font-size:.82rem;font-weight:800;line-height:1.2}
.panel-h .sub{font-size:.63rem;color:var(--text3);letter-spacing:.05em;text-transform:uppercase;font-weight:700}
.panel-b{padding:12px 13px}

/* --- goal / objective box --- */
.goal{display:flex;gap:9px;align-items:flex-start;padding:10px 12px;border-radius:12px;
  background:var(--ink-info);border:1px solid rgba(56,189,248,.2)}
.goal i{color:var(--accent2);font-size:.8rem;margin-top:2px;flex:0 0 auto}
.goal .t{font-size:.62rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--accent2);display:block;margin-bottom:2px}
.goal p{font-size:.78rem;line-height:1.55;color:var(--text)}

/* --- numbered steps --- */
.steps{list-style:none;margin:0;padding:0;counter-reset:st;display:flex;flex-direction:column;gap:7px}
.steps li{position:relative;padding-left:27px;font-size:.76rem;line-height:1.5;color:var(--text2);counter-increment:st}
.steps li::before{
  content:counter(st);position:absolute;left:0;top:0;
  width:19px;height:19px;border-radius:6px;display:grid;place-items:center;
  font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:800;
  background:linear-gradient(135deg,var(--accent),var(--accent2));color:#04140d;
  box-shadow:0 3px 9px -4px rgba(61,220,151,.9)
}
.steps li b{color:var(--text)}

/* --- WHY box: giải thích nguyên nhân, trái thanh sáng --- */
.whybox{position:relative;padding:11px 13px 11px 15px;border-radius:12px;
  background:linear-gradient(90deg,var(--ink-ok),transparent 72%);
  border:1px solid rgba(61,220,151,.2);overflow:hidden}
.whybox::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:linear-gradient(180deg,var(--accent),var(--accent2));
  box-shadow:0 0 14px rgba(61,220,151,.65)}
.whybox .h{display:flex;align-items:center;gap:6px;font-size:.62rem;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;color:var(--accent);margin-bottom:5px}
.whybox .h i{font-size:.66rem}
.whybox .b{font-size:.77rem;line-height:1.62;color:var(--text2)}
.whybox .b b,.whybox .b strong{color:var(--text)}
.whybox .b em{color:var(--accent);font-style:normal;font-weight:700}
.whybox.tone-warn{background:linear-gradient(90deg,var(--ink-warn),transparent 72%);border-color:rgba(251,191,36,.22)}
.whybox.tone-warn::before{background:linear-gradient(180deg,var(--warn),#f97316);box-shadow:0 0 14px rgba(251,191,36,.6)}
.whybox.tone-warn .h{color:var(--warn)}
.whybox.tone-warn .b em{color:var(--warn)}
.whybox.tone-bad{background:linear-gradient(90deg,var(--ink-bad),transparent 72%);border-color:rgba(251,113,133,.22)}
.whybox.tone-bad::before{background:linear-gradient(180deg,var(--bad),#e11d48);box-shadow:0 0 14px rgba(251,113,133,.6)}
.whybox.tone-bad .h{color:var(--bad)}
.whybox.tone-bad .b em{color:var(--bad)}

/* --- metric strip --- */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:7px}
.metric{padding:9px 10px;border-radius:12px;background:var(--surface3);border:1px solid var(--border);
  display:flex;flex-direction:column;gap:1px;min-width:0;transition:.2s var(--ease)}
.metric:hover{border-color:var(--border2);transform:translateY(-1px)}
.metric .lbl{font-size:.59rem;letter-spacing:.05em;text-transform:uppercase;color:var(--text3);font-weight:700;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.metric .val{font-family:'JetBrains Mono',monospace;font-weight:800;font-size:.86rem;line-height:1.2;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.metric .unit{font-size:.6rem;color:var(--text3);font-weight:700}

/* --- thinking cards --- */
.tcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);
  box-shadow:var(--shadow);overflow:hidden;transition:.24s var(--ease)}
.tcard:hover{border-color:var(--border2);transform:translateY(-2px);box-shadow:0 22px 48px -26px rgba(0,0,0,.7)}
.tcard-h{display:flex;align-items:flex-start;gap:10px;padding:12px 13px}
.tcard-h .n{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto;
  font-family:'JetBrains Mono',monospace;font-weight:800;font-size:.7rem;
  background:linear-gradient(135deg,var(--accent),var(--accent2));color:#04140d}
.tcard-h h4{margin:0;font-size:.84rem;font-weight:800;line-height:1.3}
.tcard-h .k{font-size:.64rem;color:var(--text3);font-weight:700;letter-spacing:.05em;text-transform:uppercase}
.tcard-b{padding:0 13px 13px}

/* --- formula sheet --- */
.fgroup{margin-bottom:12px}
.fgroup>.gh{display:flex;align-items:center;gap:7px;font-size:.66rem;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;color:var(--accent);margin-bottom:7px}
.fgroup>.gh::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,rgba(61,220,151,.35),transparent)}
.frow{display:flex;align-items:baseline;gap:9px;padding:7px 9px;border-radius:9px;font-size:.76rem;
  border-bottom:1px dashed var(--border);transition:.16s}
.frow:last-child{border-bottom:0}
.frow:hover{background:var(--surface2)}
.frow .fk{flex:0 0 auto;font-weight:800;color:var(--text);min-width:74px}
.frow .fv{flex:1 1 auto;font-family:'JetBrains Mono',monospace;font-size:.74rem;color:var(--accent2);line-height:1.45;word-break:break-word}
.frow .fn{flex:0 0 auto;font-size:.66rem;color:var(--text3);text-align:right;max-width:42%}

/* --- trap list --- */
.trapitem{display:flex;gap:9px;padding:9px 11px;border-radius:11px;background:var(--surface3);
  border:1px solid var(--border);border-left:3px solid var(--warn);margin-bottom:6px}
.trapitem .ic{color:var(--warn);font-size:.76rem;flex:0 0 auto;margin-top:2px}
.trapitem .tx{font-size:.76rem;line-height:1.55;color:var(--text2)}
.trapitem .tx b{color:var(--text)}

/* --- kbd --- */
.kbd{display:inline-grid;place-items:center;min-width:19px;height:19px;padding:0 5px;border-radius:5px;
  font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:700;
  background:var(--surface3);border:1px solid var(--border2);box-shadow:0 1px 0 var(--border2);color:var(--text2)}

/* --- search field with icon --- */
.srch{position:relative;flex:1 1 auto;min-width:0}
.srch i{position:absolute;left:11px;top:50%;transform:translateY(-50%);font-size:.72rem;color:var(--text3);pointer-events:none}
.srch input{padding-left:30px}


/* --- question card polish --- */
.qcard{transition:.2s var(--ease)}
.qcard:hover{border-color:var(--border2)}

.qtext{letter-spacing:-.002em}
.opt{position:relative}
.opt.sel::after{content:'\f00c';font-family:'Font Awesome 6 Free';font-weight:900;font-size:.62rem;
  position:absolute;right:9px;top:50%;transform:translateY(-50%);color:var(--accent2)}

/* --- accordion polish --- */
.acc{transition:.2s var(--ease)}
.acc:hover{border-color:var(--border2)}
.acc>summary{user-select:none}
.acc[open]{background:var(--surface)}

/* --- chip filter scroll fade --- */
.scrollx{position:relative;mask-image:linear-gradient(90deg,#000 0,#000 calc(100% - 22px),transparent 100%)}
@media (min-width:820px){.scrollx{mask-image:none}}

/* --- dock 7 tabs --- */
.dock{width:min(600px,calc(100% - 14px))}
.dock button{padding:5px 0;gap:2px;min-width:0;overflow:hidden}
.dock button i{font-size:.88rem}
.dock button span{font-size:.5rem;letter-spacing:0;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
@media (max-width:400px){
  .dock button span{display:none}
  .dock button i{font-size:1rem}
  .dock{padding:6px}
}
/* v4.3 — thanh chỉ báo DUY NHẤT trượt giữa các tab (luôn đúng tâm) */
.dock button{position:relative}
#dockInd{
  position:absolute;top:2px;left:0;width:16px;height:2px;border-radius:99px;
  background:var(--accent);box-shadow:0 0 9px var(--accent);pointer-events:none;
  z-index:2;opacity:0;transition:left .3s var(--ease),opacity .2s;
  will-change:left
}
#dockInd.on{opacity:1}
/* animation cũ ghi đè translateX(-50%) làm thanh bị lệch — bỏ hẳn */
@keyframes dockPulse{0%,100%{opacity:.55}50%{opacity:1}}

/* --- lab stage upgrade --- */
.labstage{box-shadow:0 22px 50px -30px rgba(0,0,0,.8),inset 0 0 0 1px rgba(255,255,255,.03)}
.cwrap{aspect-ratio:16/9}
@media (min-width:760px){.cwrap{aspect-ratio:16/7.4}}
@media (min-width:1100px){.cwrap{aspect-ratio:16/6.8}}
.ctag .pill{font-size:.58rem}

/* --- dock: đủ đục để nội dung phía sau không lộ qua --- */
.dock{background:rgba(11,16,28,.965)!important}
html[data-theme="light"] .dock{background:rgba(255,255,255,.975)!important}
@supports (backdrop-filter:blur(1px)){
  .dock{background:rgba(11,16,28,.90)!important}
  html[data-theme="light"] .dock{background:rgba(255,255,255,.93)!important}
}

/* --- option rows gọn hơn --- */
.opt{padding:8px 10px;gap:7px}
.opt+.opt{margin-top:0}
#bankList .qcard{padding:12px}
#bankList .opt{padding:7px 10px;font-size:.77rem}

/* --- search icon spacing --- */
.srch input{height:34px}

/* --- readout chips (metrics) replace old .readout look --- */
#labReadouts{grid-template-columns:repeat(auto-fit,minmax(104px,1fr))}
@media (max-width:560px){#labReadouts{grid-template-columns:repeat(2,minmax(0,1fr))!important}}

/* --- lab control card --- */
.lctrl{padding:9px 11px}
.lctrl .between{font-size:.72rem}
.lctrl .seg button{font-size:.66rem;padding:6px 4px}


/* --- empty state --- */
.empty i{display:block;font-size:1.6rem;margin-bottom:7px;opacity:.45}

/* --- small screens tightening --- */
@media (max-width:560px){
  .hero{padding:14px}
  .hero h2{font-size:.98rem}
  .panel-b{padding:11px}
  .frow{flex-wrap:wrap;gap:3px}
  .frow .fn{max-width:100%;text-align:left}
}

/* =========================================================
   v2.0 — LỚP GIAO DIỆN MỞ RỘNG
   (mật độ, TV, accent, font, VS, HP, thành tích, thử thách)
   ========================================================= */

/* ---------- v2.0 mật độ ---------- */
html[data-density="compact"] .stack{gap:6px}
html[data-density="airy"] .stack{gap:14px}
html[data-density="compact"] .card.pad{padding:11px}
html[data-density="airy"] .card.pad{padding:18px}
html[data-density="compact"] .sec{margin:14px 0 7px}
html[data-density="airy"] .sec{margin:24px 0 12px}

/* ---------- v2.0 chế độ TV / máy chiếu ---------- */
html[data-tv="on"]{font-size:17.5px}
html[data-tv="on"] .app{max-width:1240px}
html[data-tv="on"] .tiny{font-size:.74rem;line-height:1.6}
html[data-tv="on"] .opt{padding:11px 12px}
html[data-tv="on"] .card{border-color:var(--border2)}
html[data-tv="on"] .acc summary{padding:13px 14px}

/* ---------- v2.0 accent preset (theo cả 2 theme) ---------- */
html[data-theme="dark"][data-accent="ocean"]{--accent:#38bdf8;--accent2:#818cf8}
html[data-theme="light"][data-accent="ocean"]{--accent:#0369a1;--accent2:#4f46e5}
html[data-theme="dark"][data-accent="violet"]{--accent:#a78bfa;--accent2:#38bdf8}
html[data-theme="light"][data-accent="violet"]{--accent:#6d28d9;--accent2:#0369a1}
html[data-theme="dark"][data-accent="rose"]{--accent:#fb7185;--accent2:#f472b6}
html[data-theme="light"][data-accent="rose"]{--accent:#be123c;--accent2:#a21caf}
html[data-theme="dark"][data-accent="amber"]{--accent:#fbbf24;--accent2:#fb923c}
html[data-theme="light"][data-accent="amber"]{--accent:#a16207;--accent2:#c2410c}
html[data-theme="dark"][data-accent="cyan"]{--accent:#22d3ee;--accent2:#3ddc97}
html[data-theme="light"][data-accent="cyan"]{--accent:#0e7490;--accent2:#0a8f66}

/* ---------- v2.0 font ---------- */
html[data-font="inter"] body{font-family:'Inter','Be Vietnam Pro',system-ui,sans-serif}
html[data-font="mono"] body{font-family:'JetBrains Mono','Be Vietnam Pro',monospace}
html[data-font="mono"] .b{font-weight:700}

/* ---------- v2.0 chọn chế độ thi ---------- */
.modegrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.modecard{
  position:relative;text-align:left;cursor:pointer;padding:14px;border-radius:16px;
  background:var(--surface2);border:1.5px solid var(--border);color:var(--text);
  transition:.22s;overflow:hidden;
}
.modecard:hover{transform:translateY(-2px);border-color:var(--border2)}
.modecard.on{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),0 14px 34px -22px var(--accent)}
.modecard.on::after{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(120% 100% at 100% 0,color-mix(in srgb,var(--accent) 22%,transparent),transparent 62%);
}
.modecard i.mi{font-size:1.35rem;color:var(--accent);display:block;margin-bottom:7px}
.modecard b{display:block;font-size:.86rem;letter-spacing:.02em}
.modecard span{display:block;font-size:.66rem;color:var(--text3);margin-top:3px;line-height:1.45}

/* ---------- v2.0 thanh HP ---------- */
.hpwrap{
  border-radius:16px;padding:10px 12px;background:var(--surface);border:1px solid var(--border);
  display:grid;gap:7px;
}
.hprow{display:flex;align-items:center;gap:9px;transition:.25s;border-radius:10px;padding:3px 5px}
.hprow.active{background:color-mix(in srgb,var(--accent) 11%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 30%,transparent)}
.hpname{font-size:.74rem;font-weight:800;min-width:52px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hearts{display:flex;gap:3px;font-size:.8rem;line-height:1}
.heart{color:var(--bad);transition:.3s;display:inline-block;transform-origin:center}
.heart.dead{color:var(--text3);opacity:.28;filter:grayscale(1)}
.heart.pop{animation:heartPop .55s cubic-bezier(.3,1.6,.5,1)}
@keyframes heartPop{
  0%{transform:scale(1)}
  30%{transform:scale(1.45) rotate(-9deg)}
  60%{transform:scale(.85)}
  100%{transform:scale(1)}
}
.hpscore{margin-left:auto;font-size:.66rem;color:var(--text3);font-family:'JetBrains Mono',monospace}

/* ---------- v2.0 bảng so sánh ---------- */
.vsgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.vscol{
  border-radius:16px;padding:13px;background:var(--surface2);border:1.5px solid var(--border);
  text-align:center;position:relative;transition:.3s;
}
.vscol.win{
  border-color:var(--warn);
  box-shadow:0 0 0 1px var(--warn),0 0 34px -8px var(--warn);
  animation:winPulse 1.8s ease-in-out infinite;
}
@keyframes winPulse{0%,100%{box-shadow:0 0 0 1px var(--warn),0 0 26px -10px var(--warn)}50%{box-shadow:0 0 0 2px var(--warn),0 0 42px -6px var(--warn)}}
.vscol .vn{font-size:.74rem;font-weight:800;color:var(--text2)}
.vscol .vp{font-size:1.9rem;font-weight:800;font-family:'JetBrains Mono',monospace;line-height:1.2}
.vscol .vmeta{font-size:.64rem;color:var(--text3);margin-top:2px}
.vsline{display:flex;justify-content:space-between;font-size:.7rem;padding:4px 0;border-bottom:1px dashed var(--border)}
.vsline:last-child{border-bottom:0}

/* ---------- v2.0 thử thách ---------- */
.chalbox{border-radius:14px;padding:11px 13px;background:var(--surface2);border:1px solid var(--border)}
.chal{display:flex;gap:8px;align-items:flex-start;font-size:.72rem;padding:3px 0;color:var(--text2)}
.chal i{color:var(--text3);font-size:.7rem;margin-top:2px;transition:.3s}
.chal.done{color:var(--ok)}
.chal.done i{color:var(--ok);transform:scale(1.15)}

/* ---------- v2.0 toast thành tích ---------- */
.toastwrap{position:fixed;right:12px;bottom:calc(var(--dock-h) + 22px);z-index:96;display:flex;flex-direction:column;gap:8px;pointer-events:none;max-width:min(320px,82vw)}
.toast{
  display:flex;gap:10px;align-items:center;padding:10px 13px;border-radius:14px;
  background:var(--surface);border:1px solid var(--warn);
  box-shadow:0 18px 44px -22px #000,0 0 0 1px rgba(251,191,36,.25);
  animation:toastIn .45s cubic-bezier(.2,1.3,.5,1) both;
}
.toast.out{animation:toastOut .35s ease forwards}
.toast .ti{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto;
  background:linear-gradient(135deg,var(--warn),#f97316);color:#221500;font-size:.85rem}
.toast b{display:block;font-size:.74rem}
.toast span{display:block;font-size:.63rem;color:var(--text3);line-height:1.4}
@keyframes toastIn{from{opacity:0;transform:translateX(28px) scale(.94)}to{opacity:1;transform:none}}
@keyframes toastOut{to{opacity:0;transform:translateX(28px) scale(.96)}}

/* ---------- v2.0 swatch màu ---------- */
.swatches{display:flex;gap:9px;flex-wrap:wrap}
.swatch{width:36px;height:36px;border-radius:12px;border:2px solid transparent;cursor:pointer;transition:.2s;position:relative}
.swatch:hover{transform:translateY(-2px)}
.swatch.on{border-color:var(--text);box-shadow:0 0 0 2px var(--bg) inset}
.swatch::after{content:'';position:absolute;inset:0;border-radius:10px;box-shadow:inset 0 0 12px rgba(0,0,0,.25)}

/* ---------- v2.0 lịch sử ---------- */
.histrow{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;
  padding:8px 2px;border-bottom:1px dashed var(--border);font-size:.7rem}
.histrow:last-child{border-bottom:0}
.histrow .hd{font-size:.6rem;color:var(--text3);font-family:'JetBrains Mono',monospace}

/* ---------- v2.0 thành tựu ---------- */
.achv{display:flex;gap:9px;align-items:center;padding:9px;border-radius:12px;background:var(--surface2);border:1px solid var(--border);opacity:.45}
.achv.on{opacity:1;border-color:color-mix(in srgb,var(--warn) 45%,transparent);background:color-mix(in srgb,var(--warn) 8%,var(--surface2))}
.achv .ai{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:var(--surface3);font-size:.9rem;flex:0 0 auto}
.achv.on .ai{background:linear-gradient(135deg,var(--warn),#f97316);color:#221500}
.achv b{display:block;font-size:.7rem}
.achv span{display:block;font-size:.6rem;color:var(--text3);line-height:1.35}

/* ---------- v2.0 confetti ---------- */
#confetti{position:fixed;inset:0;z-index:97;pointer-events:none}

/* ---------- v2.0 tour highlight ---------- */
.tourhl{position:relative;z-index:60;box-shadow:0 0 0 3px var(--accent),0 0 34px -6px var(--accent)!important;border-radius:14px}

/* ---------- v2.0 banner game over ---------- */
.gobanner{text-align:center;padding:16px;border-radius:18px;border:1.5px solid var(--bad);
  background:color-mix(in srgb,var(--bad) 10%,var(--surface));animation:toastIn .5s both}

/* ---------- v2.0 tối ưu cảm ứng ---------- */
@media (max-width:640px){
  .modegrid{grid-template-columns:1fr}
  .vsgrid{grid-template-columns:1fr}
  .toastwrap{right:8px;left:8px;max-width:none}
}
@media (prefers-reduced-motion:reduce){
  .vscol.win{animation:none}
  .toast{animation:none}
  .heart.pop{animation:none}
}

/* v3.0 — NET CSS */
.modegrid{grid-template-columns:1fr 1fr}
.modegrid .modecard.wide{grid-column:1 / -1}
.modegrid .modecard.wide .mrow{display:flex;align-items:center;gap:11px}
.modegrid .modecard.wide i.mi{margin-bottom:0;flex:0 0 auto}

.codebox{
  display:flex;align-items:center;justify-content:center;
  font-family:'JetBrains Mono',monospace;font-size:1.9rem;font-weight:800;letter-spacing:.14em;
  padding:13px;border-radius:16px;background:var(--surface2);border:1.5px dashed var(--border2);
  color:var(--accent);user-select:all;
}
.qrbox{display:grid;place-items:center;padding:6px;background:#fff;border-radius:12px;width:150px;height:150px;margin:0 auto}
.qrbox img{width:138px;height:138px;display:block;border-radius:8px}
.netwait{display:flex;align-items:center;gap:9px;justify-content:center;padding:9px;font-size:.72rem;color:var(--text3)}
.spin{width:15px;height:15px;border-radius:50%;border:2px solid var(--border2);border-top-color:var(--accent);animation:v3spin .8s linear infinite;flex:0 0 auto}
@keyframes v3spin{to{transform:rotate(360deg)}}
.netbanner{padding:8px 11px;border-radius:11px;font-size:.7rem;font-weight:700;
  background:rgba(251,191,36,.14);border:1px solid rgba(251,191,36,.4);color:var(--warn);margin-top:8px}
.netbanner.bad{background:rgba(251,113,133,.14);border-color:rgba(251,113,133,.45);color:var(--bad)}
.netbanner.ok{background:rgba(52,211,153,.13);border-color:rgba(52,211,153,.4);color:var(--ok)}
.netopp{display:flex;align-items:center;gap:7px;font-size:.7rem;color:var(--text2);padding:2px 0}
.dotlive{width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 8px var(--ok);flex:0 0 auto}
.dotlive.off{background:var(--bad);box-shadow:0 0 8px var(--bad)}
.nosel,.nosel *{user-select:none;-webkit-user-select:none}
.netrow{display:flex;gap:7px;align-items:center}
.netrow .btn{flex:1}
.qrwrap{display:grid;gap:6px;justify-items:center;margin:8px 0}
.qrwrap .tiny{text-align:center}

/* =========================================================
   v3.6 — VS 2 TAB + FALLBACK + THẺ CHẾ ĐỘ
   ========================================================= */
.modegrid{grid-template-columns:1fr 1fr;gap:9px}
.modecard{padding:11px 10px;position:relative;overflow:hidden}
.modecard .mi{font-size:1.05rem;margin-bottom:4px}
.modecard b{font-size:.76rem;line-height:1.22;display:block}
.modecard span{font-size:.615rem;line-height:1.4;margin-top:3px;display:block}
.modecard .mtag{
  display:inline-flex;align-items:center;gap:4px;margin-top:6px;
  font-size:.54rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  padding:2px 6px;border-radius:5px;line-height:1.5;
}
.modecard .mtag.off{background:rgba(61,220,151,.13);color:var(--ok);border:1px solid rgba(61,220,151,.3)}
.modecard .mtag.net{background:rgba(99,179,237,.14);color:var(--accent2);border:1px solid rgba(99,179,237,.32)}
html[data-theme="light"] .modecard .mtag.off{background:rgba(5,150,105,.1);color:#047857;border-color:rgba(5,150,105,.28)}
html[data-theme="light"] .modecard .mtag.net{background:rgba(37,99,235,.1);color:#1d4ed8;border-color:rgba(37,99,235,.28)}

/* --- modal fallback --- */
.fbstep{display:flex;gap:9px;padding:9px 0;border-bottom:1px solid var(--border)}
.fbstep:last-child{border-bottom:0}
.fbnum{
  flex:0 0 21px;height:21px;border-radius:7px;display:grid;place-items:center;
  font-size:.64rem;font-weight:800;
  background:color-mix(in srgb,var(--accent) 15%,transparent);
  color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);
}
.fbcode{
  font-family:'JetBrains Mono',monospace;font-size:.7rem;line-height:1.5;
  background:var(--surface2);border:1px solid var(--border2);border-radius:8px;
  padding:7px 9px;margin-top:5px;user-select:all;word-break:break-all;color:var(--accent2);
}
.fbsect{font-size:.66rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);margin:12px 0 4px}
.fbsect:first-child{margin-top:0}

/* --- cảnh báo trình duyệt --- */
.warnbar{
  display:flex;gap:8px;align-items:flex-start;padding:9px 11px;border-radius:11px;
  font-size:.665rem;line-height:1.5;
  background:rgba(251,191,36,.11);border:1px solid rgba(251,191,36,.33);color:var(--warn);
}
.warnbar.bad{background:rgba(251,113,133,.11);border-color:rgba(251,113,133,.34);color:var(--bad)}

/* --- chấm nhịp chờ tab --- */
.tabdots{display:inline-flex;gap:4px;margin-left:5px;vertical-align:middle}
.tabdots i{width:5px;height:5px;border-radius:50%;background:var(--accent);animation:tabpulse 1.15s ease-in-out infinite}
.tabdots i:nth-child(2){animation-delay:.16s}
.tabdots i:nth-child(3){animation-delay:.32s}
@keyframes tabpulse{0%,100%{opacity:.22;transform:scale(.75)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion: reduce){.tabdots i{animation:none;opacity:.8}}

.tabrole{display:flex;gap:6px;margin-bottom:10px}
.tabrole button{
  flex:1;padding:9px 6px;border-radius:11px;border:1px solid var(--border2);
  background:var(--surface2);color:var(--text2);font-size:.68rem;font-weight:800;
  cursor:pointer;transition:background .18s,border-color .18s,color .18s;
}
.tabrole button.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--accent)}
.tabrole button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

@media (max-width:380px){
  .modecard{padding:9px 8px}
  .modecard b{font-size:.71rem}
  .modecard span{font-size:.575rem}
}

/* modal cao hơn màn hình vẫn cuộn được (fallback, hướng dẫn) */
.modal{display:flex;align-items:center;justify-content:center;overflow-y:auto;overscroll-behavior:contain}
.modal .box{margin:auto;flex:0 0 auto}

/* =========================================================
   v4.0 — GATE (màn hình mở khoá) + FX TOGGLES + LỘ TRÌNH
   ========================================================= */

/* ---------- màn hình khoá ---------- */
#gate{
  position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;
  padding:18px;background:var(--bg);
  background-image:
    radial-gradient(70% 55% at 18% 12%, color-mix(in srgb,var(--accent) 22%,transparent), transparent 62%),
    radial-gradient(60% 50% at 88% 82%, color-mix(in srgb,var(--accent2) 20%,transparent), transparent 64%),
    radial-gradient(50% 44% at 60% 40%, color-mix(in srgb,var(--nebula) 16%,transparent), transparent 70%);
}
#gate.hide{display:none}
#gate .gwrap{width:100%;max-width:410px}
#gate .gcard{
  background:color-mix(in srgb,var(--surface) 88%,transparent);
  border:1px solid var(--border2);border-radius:24px;padding:22px 20px;
  box-shadow:0 40px 90px -40px #000, inset 0 1px 0 rgba(255,255,255,.05);
  backdrop-filter:blur(14px);
}
#gate .glogo{
  width:54px;height:54px;border-radius:17px;display:grid;place-items:center;margin:0 auto 12px;
  background:linear-gradient(140deg,var(--accent),var(--accent2) 55%,var(--nebula));
  color:#04120d;font-size:1.45rem;box-shadow:0 16px 40px -16px var(--accent);
}
#gate h2{text-align:center;font-size:1.12rem;font-weight:800;letter-spacing:-.01em;margin:0}
#gate .gsub{text-align:center;font-size:.7rem;color:var(--text3);margin-top:5px;line-height:1.5}

.gcode{
  width:100%;text-align:center;font-family:'JetBrains Mono',monospace;
  font-size:1.72rem;font-weight:800;letter-spacing:.34em;padding:14px 8px 14px 18px;
  border-radius:15px;border:1.5px solid var(--border2);background:var(--surface2);
  color:var(--text);margin-top:14px;
}
.gcode:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
.gcode.err{border-color:var(--bad);animation:gshake .4s}
@keyframes gshake{0%,100%{transform:translateX(0)}22%{transform:translateX(-7px)}44%{transform:translateX(6px)}70%{transform:translateX(-3px)}}

.gbar{height:3px;border-radius:2px;background:var(--border);overflow:hidden;margin-top:10px}
.gbar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .9s linear}
.gmeta{display:flex;justify-content:space-between;align-items:center;margin-top:7px;font-size:.62rem;color:var(--text3)}

.gmsg{font-size:.68rem;line-height:1.5;margin-top:10px;padding:8px 10px;border-radius:10px;display:none}
.gmsg.on{display:block}
.gmsg.bad{background:rgba(251,113,133,.13);border:1px solid rgba(251,113,133,.36);color:var(--bad)}
.gmsg.ok{background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.36);color:var(--ok)}

#gateKeyBox{display:none;margin-top:10px}
#gateKeyBox.on{display:block}
.gkey{
  width:100%;font-family:'JetBrains Mono',monospace;font-size:.62rem;line-height:1.55;
  padding:9px 11px;border-radius:11px;border:1.5px solid var(--border2);
  background:var(--surface2);color:var(--text);resize:vertical;min-height:62px;word-break:break-all;
}
.gkey:focus{outline:none;border-color:var(--accent)}

/* ---------- VIP Card ---------- */
.vip-header{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.vip-badge{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#fbbf24,#fb7185);color:#1a0a00;font-size:1.3rem;box-shadow:0 8px 22px -10px rgba(251,191,36,.6);flex:0 0 auto}
.vip-title{font-size:1rem;font-weight:800;background:linear-gradient(100deg,#fbbf24,#fb7185);-webkit-background-clip:text;background-clip:text;color:transparent}
.vip-status{font-size:.68rem;color:var(--text3)}
.vip-status.on{color:#34d399;font-weight:700}
.vip-body{border-top:1px solid var(--border);padding-top:10px}
.vip-perks{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}
.vip-perk{font-size:.62rem;color:var(--text2);display:flex;align-items:center;gap:5px;padding:5px 7px;background:var(--surface2);border-radius:8px;border:1px solid var(--border)}
.vip-perk i{color:var(--warn);font-size:.7rem}
#vipCard{position:relative;overflow:hidden}
#vipCard::before{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:linear-gradient(115deg,transparent 42%,rgba(251,191,36,.10) 50%,transparent 58%);
  background-size:250% 100%;opacity:0;transition:opacity .3s}
#vipCard:hover::before{opacity:1;animation:vipSweep 1.6s linear infinite}
@keyframes vipSweep{0%{background-position:180% 0}100%{background-position:-80% 0}}
.vip-badge{position:relative;overflow:hidden}
.vip-badge::after{content:'';position:absolute;top:-60%;left:-60%;width:40%;height:220%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);
  transform:rotate(22deg);animation:vipShine 3.4s ease-in-out infinite}
@keyframes vipShine{0%,60%{left:-60%}100%{left:140%}}
#vipCard.vip-on{box-shadow:0 0 0 1px rgba(251,191,36,.28),0 14px 40px -22px rgba(251,191,36,.5)}
.vip-status.on{text-shadow:0 0 12px rgba(52,211,153,.5)}

/* ============ v4.1 — UI hiện đại + đấu online nhiều người ============ */
:root{ --glass: rgba(255,255,255,.045); --stroke: rgba(255,255,255,.10); --ease: cubic-bezier(.22,.8,.28,1) }
.card{transition:border-color .28s var(--ease), box-shadow .28s var(--ease), transform .28s var(--ease)}
.card:hover{border-color:rgba(61,220,151,.22)}
.btn,.chip,.modecard,.iconbtn,.seg button,.switch{transition:background .2s var(--ease),color .2s var(--ease),border-color .2s var(--ease),transform .16s var(--ease),box-shadow .2s var(--ease)}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px -12px rgba(61,220,151,.7)}
.btn:active,.chip:active,.modecard:active{transform:translateY(1px) scale(.985)}
.modecard{position:relative;overflow:hidden}
.modecard::after{content:'';position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:linear-gradient(115deg,transparent 40%,rgba(61,220,151,.13) 50%,transparent 60%);
  opacity:0;transform:translateX(-100%);transition:opacity .25s}
.modecard:hover::after{opacity:1;animation:cardSheen 1.3s var(--ease) infinite}
@keyframes cardSheen{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
.chip.on,.seg button.on{box-shadow:0 6px 18px -10px rgba(61,220,151,.8)}
.iconbtn:hover{box-shadow:0 6px 18px -10px rgba(56,189,248,.8)}
.glow-sweep{position:relative;overflow:hidden}
.glow-sweep::before{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;
  background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.22) 50%,transparent 60%);transition:opacity .3s}
.glow-sweep:hover::before{opacity:1;animation:cardSheen 1.3s var(--ease) infinite}
.view.on{animation:viewIn .34s var(--ease)}
@keyframes viewIn{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
.panel-in{animation:viewIn .32s var(--ease)}
.card-hover{transition:transform .22s var(--ease),box-shadow .22s var(--ease),border-color .22s var(--ease)}
.card-hover:hover{transform:translateY(-2px);box-shadow:0 18px 44px -22px rgba(0,0,0,.5);border-color:var(--border2)}
.stat b,.bigcode{text-shadow:0 0 20px rgba(61,220,151,.28)}
@media (prefers-reduced-motion: reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}

/* --- player identity --- */
.idbar{display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:13px;
  background:linear-gradient(100deg,rgba(61,220,151,.10),rgba(56,189,248,.06));border:1px solid rgba(61,220,151,.22);margin-bottom:10px}
.idav{font-size:1.35rem;width:40px;height:40px;flex:0 0 auto;border-radius:12px;display:grid;place-items:center;
  background:var(--surface2);border:1px solid var(--border);cursor:pointer;transition:transform .16s}
.idav:hover{transform:scale(1.08)}
.idavs{display:flex;gap:4px;flex-wrap:wrap;margin-top:7px}
.idavs button{width:30px;height:30px;border-radius:9px;border:1px solid var(--border);background:var(--surface2);
  font-size:.92rem;cursor:pointer;transition:.16s}
.idavs button:hover{transform:translateY(-2px);border-color:var(--accent)}
.idavs button.on{border-color:var(--accent);background:rgba(61,220,151,.16)}

/* --- multiplayer lobby --- */
.mplobby{display:flex;flex-direction:column;gap:10px}
.mpcount{font-family:ui-monospace,'JetBrains Mono',monospace;font-size:1.6rem;font-weight:800;color:var(--accent)}
.mpgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:7px}
.mpplayer{display:flex;align-items:center;gap:7px;padding:7px 9px;border-radius:11px;background:var(--surface2);
  border:1px solid var(--border);font-size:.7rem;min-width:0;animation:viewIn .3s var(--ease)}
.mpplayer.me{border-color:rgba(61,220,151,.45);background:rgba(61,220,151,.09)}
.mpplayer .mpav{font-size:1rem;flex:0 0 auto}
.mpplayer .mpnm{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
.mpplayer .mptag{font-size:.55rem;font-weight:800;color:var(--accent);letter-spacing:.04em;flex:0 0 auto}
.mpslot{border:1px dashed var(--border2);border-radius:11px;padding:7px 9px;font-size:.62rem;color:var(--text3);
  display:grid;place-items:center;min-height:36px}
.mpbar{height:4px;border-radius:99px;background:var(--border);overflow:hidden;margin-top:4px}
.mpbar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .4s var(--ease)}
.mpboard{display:flex;flex-direction:column;gap:5px}
.mpboard .mpplayer{padding:6px 9px}
.mpcode{font-family:ui-monospace,'JetBrains Mono',monospace;font-size:1.8rem;font-weight:800;letter-spacing:.14em;
  text-align:center;color:var(--accent);text-shadow:0 0 26px rgba(61,220,151,.4);padding:10px;border-radius:12px;
  background:rgba(61,220,151,.07);border:1px dashed rgba(61,220,151,.35);user-select:all}

/* --- quiz --- */
.mpq{font-size:.9rem;font-weight:700;line-height:1.5;margin-bottom:10px}
.mpopt{display:flex;align-items:center;gap:9px;width:100%;text-align:left;padding:10px 12px;margin-bottom:7px;
  border-radius:12px;border:1px solid var(--border);background:var(--surface2);color:var(--text);
  font-size:.78rem;font-family:inherit;cursor:pointer;transition:.18s var(--ease)}
.mpopt:hover{border-color:var(--accent2);transform:translateX(3px)}
.mpopt.on{border-color:var(--accent);background:rgba(61,220,151,.13);box-shadow:0 0 0 1px rgba(61,220,151,.25)}
.mpopt .kbd2{font-family:monospace;font-weight:800;color:var(--text3);width:20px;flex:0 0 auto}
.mppal{display:grid;grid-template-columns:repeat(auto-fill,minmax(30px,1fr));gap:4px;margin-top:4px}
.mppal button{height:29px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);
  color:var(--text3);font-size:.64rem;font-weight:800;font-family:inherit;cursor:pointer;transition:.16s}
.mppal button.done{background:rgba(61,220,151,.16);color:var(--accent);border-color:rgba(61,220,151,.4)}
.mppal button.cur{border-color:var(--accent2);box-shadow:0 0 0 2px rgba(56,189,248,.2)}

/* --- leaderboard --- */
.mprank{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:12px;background:var(--surface2);
  border:1px solid var(--border);margin-bottom:6px;animation:viewIn .35s var(--ease)}
.mprank.top{background:linear-gradient(100deg,rgba(251,191,36,.14),rgba(61,220,151,.07));border-color:rgba(251,191,36,.4)}
.mprank.me{border-color:rgba(61,220,151,.45)}
.mprank .rk{font-family:monospace;font-weight:800;width:28px;text-align:center;color:var(--warn);flex:0 0 auto}
.mprank .rv{font-size:1.15rem;flex:0 0 auto}
.mprank .rn{font-weight:700;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.76rem}
.mprank .rs{font-family:monospace;font-weight:800;color:var(--accent);font-size:.92rem;flex:0 0 auto}

/* ============ v4.1 — hoàn thiện giao diện ============ */
.topbar{box-shadow:0 8px 26px -22px rgba(0,0,0,.9),inset 0 -1px 0 rgba(61,220,151,.08)}
.brand h1{background-size:200% auto;animation:brandFlow 8s linear infinite}
@keyframes brandFlow{to{background-position:200% center}}
.logo{position:relative;overflow:hidden}
.logo::after{content:'';position:absolute;inset:0;border-radius:inherit;
  background:linear-gradient(120deg,transparent 40%,rgba(255,255,255,.5) 50%,transparent 60%);
  transform:translateX(-120%);animation:logoSheen 5s ease-in-out infinite}
@keyframes logoSheen{0%,55%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
h2.sec{position:relative;padding-left:11px}
h2.sec::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);
  width:3px;height:12px;border-radius:99px;background:linear-gradient(var(--accent),var(--accent2));box-shadow:0 0 10px rgba(61,220,151,.6)}
h2.sec svg.ico{color:var(--accent)}
.card::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.045)}
.card{position:relative}
.hero{position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;right:-40px;top:-60px;width:170px;height:170px;border-radius:50%;
  background:radial-gradient(circle,rgba(61,220,151,.13),transparent 70%);pointer-events:none}
.dock{box-shadow:0 18px 50px -24px rgba(0,0,0,.9),inset 0 1px 0 rgba(255,255,255,.05)}
.dock button{border-radius:14px}
#dockInd.on{animation:dockPulse 2.4s ease-in-out infinite}
.btn:focus-visible,.iconbtn:focus-visible,.chip:focus-visible,.modecard:focus-visible,
.mpcount:focus-visible,.mpopt:focus-visible,input:focus-visible,select:focus-visible{
  outline:2px solid var(--accent2);outline-offset:2px}
.idchip{display:inline-flex;align-items:center;gap:5px;max-width:118px;height:33px;padding:0 9px;
  border-radius:11px;border:1px solid rgba(61,220,151,.28);background:rgba(61,220,151,.09);
  color:var(--text);font-family:inherit;font-size:.66rem;font-weight:700;cursor:pointer;
  transition:.2s var(--ease);overflow:hidden;white-space:nowrap}
.idchip:hover{border-color:var(--accent);transform:translateY(-1px);box-shadow:0 6px 18px -12px rgba(61,220,151,.9)}
.idchip #idChipAv{font-size:.9rem;flex:0 0 auto}
.idchip #idChipName{overflow:hidden;text-overflow:ellipsis}
html[data-gfx="lite"] .logo::after,
html[data-gfx="lite"] .brand h1,
html[data-fx="off"] .logo::after{animation:none}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:rgba(128,150,180,.28);border-radius:99px}
::-webkit-scrollbar-thumb:hover{background:rgba(61,220,151,.45)}
html{scroll-behavior:smooth}
.stat{position:relative;overflow:hidden}
.stat::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;
  background:linear-gradient(var(--accent),var(--accent2));opacity:.7}
.mprank,.mpplayer,.keyitem{backdrop-filter:blur(6px)}

/* ---------- bật/tắt hiệu ứng ---------- */
html[data-fx-aurora="off"] #aurora{display:none!important}
html[data-fx-stars="off"] #stars{display:none!important}
html[data-fx-confetti="off"] #confetti{display:none!important}
html[data-fx-glow="off"] .btn.pri{box-shadow:none!important}
html[data-fx-glow="off"] .modecard.on{box-shadow:0 0 0 1px var(--accent)!important}
html[data-fx-mesh="off"] .hero::before{display:none!important}
html[data-fx-toast="off"] .toast{animation:none!important}
html[data-fx-heart="off"] .heart.pop{animation:none!important}
html[data-fx-pulse="off"] .pulse{animation:none!important}
html[data-fx-vignette="off"] .labstage::after{display:none!important}
html[data-fx-shadow="off"] h1,html[data-fx-shadow="off"] h2,html[data-fx-shadow="off"] .hero h2{text-shadow:none!important}
html[data-fx-page="off"] .view.on{animation:none!important}
html[data-fx-gradtext="off"] .gradtext,
html[data-fx-gradtext="off"] .hero h2 span,
html[data-fx-gradtext="off"] [style*="background-clip:text"]{
  background:none!important;-webkit-text-fill-color:currentColor!important;color:var(--accent)!important;
}
html[data-fx-gradtext="off"] .vscol .vp{color:inherit}

.fxrow{
  display:flex;align-items:center;gap:10px;padding:9px 2px;
  border-bottom:1px solid var(--border);
}
.fxrow:last-child{border-bottom:0}
.fxrow .ficon{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;flex:0 0 auto;
  background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent);font-size:.66rem}
.fxrow .fmeta{min-width:0;flex:1}
.fxrow .fname{font-size:.72rem;font-weight:700;line-height:1.25}
.fxrow .fdesc{font-size:.58rem;color:var(--text3);line-height:1.35;margin-top:1px}
.sw{
  width:40px;height:23px;border-radius:20px;background:var(--border2);position:relative;
  cursor:pointer;transition:background .22s;flex:0 0 auto;border:0;padding:0;
}
.sw::after{
  content:'';position:absolute;top:2.5px;left:2.5px;width:18px;height:18px;border-radius:50%;
  background:#fff;transition:transform .22s cubic-bezier(.3,1.4,.5,1);box-shadow:0 2px 5px rgba(0,0,0,.28);
}
.sw.on{background:var(--accent)}
.sw.on::after{transform:translateX(17px)}
.sw:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

.fxpreset{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:9px}
.fxpreset button{
  padding:9px 8px;border-radius:11px;border:1px solid var(--border2);background:var(--surface2);
  color:var(--text2);font-size:.65rem;font-weight:800;cursor:pointer;text-align:left;line-height:1.35;
  transition:border-color .18s,color .18s;
}
.fxpreset button:hover{border-color:var(--accent);color:var(--accent)}
.fxpreset button i{margin-right:5px}

/* ---------- lộ trình ---------- */
.pathtabs{display:flex;gap:5px;margin-bottom:10px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:5px}
.pathtabs button{
  flex:1;padding:9px 8px;border-radius:10px;border:1px solid transparent;background:transparent;
  color:var(--text3);font-size:.7rem;font-weight:800;cursor:pointer;transition:.18s;
}
.pathtabs button.on{
  background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--accent);
  border-color:color-mix(in srgb,var(--accent) 36%,transparent);
}
.pathtabs button:hover{color:var(--text2)}

.prow{display:flex;align-items:center;gap:9px;padding:8px 0;border-bottom:1px solid var(--border)}
.prow:last-child{border-bottom:0}
.prow .pname{font-size:.72rem;font-weight:700;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.prow .pval{font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:800}
.prow .pbar{width:64px;height:5px;border-radius:3px;background:var(--border);overflow:hidden;flex:0 0 auto}
.prow .pbar i{display:block;height:100%;border-radius:3px}

.stepitem{
  display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);
}
.stepitem:last-child{border-bottom:0}
.stepitem .snum{
  width:22px;height:22px;border-radius:7px;display:grid;place-items:center;flex:0 0 auto;
  font-size:.64rem;font-weight:800;background:color-mix(in srgb,var(--accent) 15%,transparent);
  color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 32%,transparent);
}
.stepitem .stxt{font-size:.7rem;line-height:1.5;min-width:0}
.stepitem .stxt b{font-size:.72rem}

.dbadge{font-size:.54rem;font-weight:800;padding:2px 6px;border-radius:5px;letter-spacing:.04em}
.dbadge.d1{background:rgba(52,211,153,.15);color:var(--ok)}
.dbadge.d2{background:rgba(251,191,36,.15);color:var(--warn)}
.dbadge.d3{background:rgba(251,113,133,.15);color:var(--bad)}

.dslider{margin-top:9px}
.dslider .dhead{display:flex;justify-content:space-between;font-size:.66rem;font-weight:700;margin-bottom:3px}
.dslider .dhead .dv{font-family:'JetBrains Mono',monospace}
.dsum{margin-top:8px;font-size:.66rem;font-weight:800;text-align:center;padding:6px;border-radius:9px}
.dsum.ok{background:rgba(52,211,153,.12);color:var(--ok)}
.dsum.bad{background:rgba(251,113,133,.12);color:var(--bad)}

@media (max-width:420px){
  #gate .gcard{padding:18px 15px;border-radius:20px}
  .gcode{font-size:1.42rem;letter-spacing:.24em;padding:12px 6px 12px 14px}
  .fxpreset{grid-template-columns:1fr}
}

/* =========================================================
   v2.0 — ICON SPRITE + 3 MỨC ĐỒ HỌA + HUD
   ========================================================= */
.ico{width:1em;height:1em;display:inline-block;vertical-align:-.125em;fill:currentColor;flex:0 0 auto;pointer-events:none}

/* ---------- Lite: bỏ mọi hiệu ứng tốn GPU ---------- */
html[data-gfx="lite"] [class]{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
html[data-gfx="lite"] #aurora,
html[data-gfx="lite"] #stars,
html[data-gfx="lite"] .hero::before{display:none!important}
html[data-gfx="lite"] .view.on{animation:none!important}
html[data-gfx="lite"] .toast{animation:none!important}
html[data-gfx="lite"] .btn.pri,
html[data-gfx="lite"] .modecard.on{box-shadow:none!important}
html[data-gfx="lite"] .card,
html[data-gfx="lite"] .qcard,
html[data-gfx="lite"] .panel,
html[data-gfx="lite"] .labstage{box-shadow:none!important}
html[data-gfx="lite"] .heart.pop{animation:none!important}

/* ---------- Balanced ---------- */
html[data-gfx="balanced"] #aurora{opacity:.6}
html[data-gfx="balanced"] .hero::before{animation-duration:30s}

/* ---------- danh sách dài: không dựng phần ngoài màn hình ---------- */
#bankList > .qcard,
#theoryList > .acc,
#theoryExtra > .acc,
#pathPlan > .card,
#pathReview > .card{
  content-visibility:auto;
  contain-intrinsic-size:auto 150px;
}

/* ---------- HUD hiệu năng ---------- */
#perfHud{
  position:fixed;left:10px;bottom:calc(var(--dock-h, 64px) + 12px);z-index:95;
  display:none;gap:7px;align-items:center;white-space:nowrap;
  padding:7px 10px;border-radius:11px;
  font-size:.6rem;font-family:ui-monospace,'JetBrains Mono',monospace;
  background:rgba(8,12,20,.92);border:1px solid var(--border2);color:var(--text2);
  box-shadow:0 12px 30px -18px #000;pointer-events:none;
}
#perfHud.on{display:flex}
#perfHud b{color:var(--accent);font-weight:800}
#perfHud .sep{opacity:.3}
html[data-theme="light"] #perfHud{background:rgba(255,255,255,.95);color:var(--text2)}

</style>
<style>
/* ============ v4.2 — NO KEY & net notice ============ */
#accBar{position:fixed;left:0;right:0;bottom:calc(var(--dock-h) + 14px);z-index:70;padding:7px 10px;
  background:linear-gradient(90deg,rgba(251,191,36,.17),rgba(56,189,248,.13));
  border-top:1px solid rgba(251,191,36,.35);border-bottom:1px solid rgba(251,191,36,.18);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.accbar-in{max-width:820px;margin:0 auto;display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.accbar-txt{font-size:.66rem;color:var(--text2);line-height:1.4}
.accbar-btn{flex:0 0 auto;padding:6px 11px;border-radius:9px;border:1px solid rgba(251,191,36,.55);
  background:rgba(251,191,36,.14);color:var(--warn);font-family:inherit;font-size:.7rem;
  line-height:1.2;font-weight:800;cursor:pointer;transition:.16s}
.accbar-btn:hover{background:rgba(251,191,36,.26);transform:translateY(-1px)}
#dock button.acc-locked{opacity:.4;position:relative;filter:grayscale(.6)}
.lockbadge{position:absolute;top:0;right:4px;font-size:.5rem;font-style:normal;line-height:1;pointer-events:none}
.nkbtn{background:transparent!important;border:1px dashed rgba(169,156,249,.5)!important;color:var(--violet)!important}
.nkbtn:hover{background:rgba(169,156,249,.10)!important}
.nkhint{margin-top:9px;font-size:.6rem;color:var(--text3);line-height:1.5}
.netnote{font-size:.6rem;color:var(--text3);line-height:1.5;margin:-2px 0 9px;padding:7px 9px;
  border-radius:9px;background:rgba(56,189,248,.06);border:1px solid rgba(56,189,248,.16)}
/* v4.3 — cấu hình tự do cho chủ phòng */
.mpcfg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.mpcfg .full{grid-column:1/-1}
.mpcfg-lb{display:block;font-size:.66rem;font-weight:800;color:var(--text2);margin:2px 0 4px}
.mpcfg-lb .tiny{font-weight:500;color:var(--text3);font-size:.58rem}
.mpcfg input[type=number]{width:100%;font-family:'JetBrains Mono',monospace;font-size:.8rem;font-weight:700;
  padding:7px 9px;border-radius:9px;border:1px solid var(--border2);background:var(--surface2);color:var(--accent)}
.mpcfg input[type=number]:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(61,220,151,.16)}
.mpcfg input:disabled{opacity:.55}
.nettoggle{display:flex;gap:6px;align-items:center;justify-content:space-between;padding:9px 10px;
  border-radius:12px;border:1px solid var(--border);background:var(--surface2);margin-bottom:10px}
.modegrid .modecard[style*="display: none"]{display:none!important}
/* v4.4 — thẻ thiết lập thống nhất + bảng điều khiển chỉ đọc cho khách */
#uniCard{border-color:rgba(61,220,151,.34);background:linear-gradient(160deg,rgba(61,220,151,.06),transparent 65%)}
.unihead{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.unihead b{font-size:.78rem;color:var(--accent)}
.unihint{margin-top:8px;font-size:.63rem;color:var(--text2);line-height:1.6;
  padding:7px 9px;border-radius:9px;background:rgba(61,220,151,.06);border:1px solid rgba(61,220,151,.16)}
.mpcfgtbl{display:grid;grid-template-columns:1fr;gap:0;font-size:.66rem}
.mpcfgtbl > div{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px dashed var(--border)}
.mpcfgtbl > div:last-child{border-bottom:0}
.mpcfgtbl .k{color:var(--text3)}
.mpcfgtbl .v{font-weight:700;color:var(--text);text-align:right}
.oldbadge{font-size:.55rem;font-weight:800;letter-spacing:.05em;padding:2px 7px;border-radius:6px;
  background:rgba(251,191,36,.16);color:var(--warn);border:1px solid rgba(251,191,36,.35)}
.forever{display:inline-flex;align-items:center;gap:5px;font-size:.6rem;font-weight:800;
  letter-spacing:.04em;padding:4px 9px;border-radius:8px;color:var(--warn);
  background:linear-gradient(100deg,rgba(251,191,36,.18),rgba(56,189,248,.10));
  border:1px solid rgba(251,191,36,.42)}
#vipCard.vip-forever{box-shadow:0 0 0 1px rgba(251,191,36,.35),0 16px 44px -22px rgba(251,191,36,.6)}
/* ============ v4.5 — BÀI SAI & HƯỚNG DẪN CHI TIẾT ============ */
.wsum{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.wsum .big{font-size:1.15rem;font-weight:800;color:var(--bad)}
.wchip{font-size:.58rem;font-weight:800;padding:3px 8px;border-radius:7px;letter-spacing:.03em}
.wchip.bad{background:rgba(251,113,133,.16);color:var(--bad);border:1px solid rgba(251,113,133,.34)}
.wchip.warn{background:rgba(251,191,36,.15);color:var(--warn);border:1px solid rgba(251,191,36,.34)}
.wchip.ok{background:rgba(52,211,153,.14);color:var(--ok);border:1px solid rgba(52,211,153,.34)}
.wcard{position:relative;overflow:hidden;border-radius:var(--r-lg);border:1px solid var(--border);
  background:linear-gradient(165deg,rgba(251,113,133,.055),transparent 55%),var(--surface)}
.wcard.ok-card{background:linear-gradient(165deg,rgba(52,211,153,.05),transparent 55%),var(--surface)}
.wcard::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:linear-gradient(180deg,var(--bad),var(--warn))}
.wcard.ok-card::before{background:linear-gradient(180deg,var(--ok),var(--accent2))}
.whead{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.wq{font-size:.82rem;font-weight:700;line-height:1.5;margin-bottom:9px}
.wans{display:flex;flex-direction:column;gap:5px;margin-bottom:9px}
.wline{display:flex;gap:7px;align-items:flex-start;font-size:.7rem;line-height:1.5;
  padding:6px 9px;border-radius:9px;background:var(--surface2)}
.wline .k{flex:0 0 62px;color:var(--text3);font-weight:700}
.wline.good{background:rgba(52,211,153,.10);border:1px solid rgba(52,211,153,.26)}
.wline.good b{color:var(--ok)}
.wline.badl{background:rgba(251,113,133,.09);border:1px solid rgba(251,113,133,.24)}
.wline.badl b{color:var(--bad)}
.wopts{display:grid;gap:4px;margin-bottom:9px}
.wopt{display:flex;gap:7px;align-items:flex-start;font-size:.68rem;line-height:1.45;
  padding:6px 9px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--text2)}
.wopt .l{flex:0 0 17px;font-weight:800;color:var(--text3)}
.wopt.correct{background:rgba(52,211,153,.11);border-color:rgba(52,211,153,.42);color:var(--text)}
.wopt.correct .l{color:var(--ok)}
.wopt.picked{background:rgba(251,113,133,.10);border-color:rgba(251,113,133,.40);color:var(--text)}
.wopt.picked .l{color:var(--bad)}
.wopt .tag{margin-left:auto;flex:0 0 auto;font-size:.55rem;font-weight:800;opacity:.9}
.wsec{margin-top:9px;padding:9px 10px;border-radius:10px;background:rgba(56,189,248,.055);
  border:1px solid rgba(56,189,248,.15)}
.wsec .wt{font-size:.66rem;font-weight:800;color:var(--accent2);letter-spacing:.04em;margin-bottom:6px}
.wsteps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.wsteps li{display:flex;gap:8px;align-items:flex-start;font-size:.68rem;line-height:1.55}
.wsteps .n{flex:0 0 18px;height:18px;border-radius:50%;display:grid;place-items:center;
  font-size:.6rem;font-weight:800;background:rgba(61,220,151,.16);color:var(--accent)}
.wbody{font-size:.68rem;line-height:1.6;color:var(--text2)}
.wbody b{color:var(--text)}
.wfoot{margin-top:8px;font-size:.62rem;color:var(--text3);line-height:1.5}
.mpcount{color:var(--accent)}
.netnote b{color:var(--accent2)}
/* ============ v4.5 — polish: chuyển động mượt, chiều sâu, độ tương phản ============ */
@keyframes wIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.wcard{animation:wIn .3s var(--ease) both;transition:border-color .2s,box-shadow .2s,transform .2s}
.wcard:hover{border-color:rgba(56,189,248,.35);box-shadow:0 14px 36px -22px rgba(56,189,248,.55)}
.wopt{transition:background .18s,border-color .18s,transform .18s}
.wopt:hover{transform:translateX(2px)}
.wsteps li{transition:transform .18s}
.wsteps li:hover{transform:translateX(2px)}
#repScore{animation:scorePop .5s var(--ease) both}
@keyframes scorePop{from{opacity:0;transform:scale(.86)}to{opacity:1;transform:none}}
#examReport > .card:first-child{background:
  radial-gradient(120% 100% at 10% 0%,rgba(61,220,151,.09),transparent 60%),
  radial-gradient(100% 90% at 95% 100%,rgba(56,189,248,.08),transparent 60%),var(--surface);
  border-color:rgba(61,220,151,.24)}
#wrongSummary{background:linear-gradient(100deg,rgba(251,113,133,.07),rgba(251,191,36,.05));
  border-color:rgba(251,113,133,.22)}
.seg button,.btn,.modecard{transition:background .2s var(--ease),color .2s var(--ease),
  border-color .2s var(--ease),transform .16s var(--ease),box-shadow .2s var(--ease)}
.seg button:hover:not(.on){color:var(--text)}
.forever{animation:foreverGlow 3.2s ease-in-out infinite}
@keyframes foreverGlow{0%,100%{box-shadow:0 0 0 0 rgba(251,191,36,0)}50%{box-shadow:0 0 0 3px rgba(251,191,36,.12)}}
@media (prefers-reduced-motion:reduce){.wcard,#repScore,.forever{animation:none!important}}

/* ============================================================
   v4.6 · NEXUS VISUAL SYSTEM — cyber-grid / ambient glow / glass
   (tham khảo nexus-motion: Syne-style contrast + cyan→violet accents)
   ============================================================ */
:root{
  --nx-cyan:#00f3ff; --nx-violet:#8a2be2; --nx-pink:#ff0055;
  --nx-ease:cubic-bezier(.16,1,.3,1);
  --nx-grid:rgba(190,225,255,.032);
  --nx-glow1:rgba(0,243,255,.085);
  --nx-glow2:rgba(138,43,226,.10);
  --nx-bg-op:1;
  --nx-tx:0px; --nx-ty:0px;
  --nx-text-grad:linear-gradient(108deg,#ffffff 0%,#38bdf8 42%,#8b7cf6 82%,#ff7ab8 115%);
}
html[data-theme="light"]{
  --nx-grid:rgba(10,80,70,.055);
  --nx-glow1:rgba(10,140,120,.075);
  --nx-glow2:rgba(109,94,252,.07);
  --nx-bg-op:.5;
  --nx-text-grad:linear-gradient(108deg,#0a8f66 0%,#0b7ec4 52%,#6d5efc 100%);
}
html[data-fx="off"]{--nx-bg-op:0}

/* Cyber grid + 2 ambient orbs, đuôi chuột parallax (JS đặt --nx-tx/ty) */
body::before{
  content:'';position:fixed;inset:-6%;z-index:0;pointer-events:none;
  background-image:
    linear-gradient(to right,var(--nx-grid) 1px,transparent 1px),
    linear-gradient(to bottom,var(--nx-grid) 1px,transparent 1px),
    radial-gradient(44% 40% at 88% 2%,var(--nx-glow1),transparent 72%),
    radial-gradient(44% 42% at 2% 98%,var(--nx-glow2),transparent 72%);
  background-size:56px 56px,56px 56px,100% 100%,100% 100%;
  transform:translate3d(var(--nx-tx),var(--nx-ty),0);
  opacity:var(--nx-bg-op);transition:opacity .5s var(--nx-ease);will-change:transform;
}
/* Film grain cực nhẹ — data-URI, không cần file ngoài */
body::after{
  content:'';position:fixed;inset:0;z-index:2;pointer-events:none;
  opacity:calc(var(--nx-bg-op) * .035);
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
html[data-fx="off"] body::before,html[data-fx="off"] body::after{display:none}

/* Scrollbar mảnh, gradient cyan→violet */
::-webkit-scrollbar{width:7px;height:7px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{border-radius:99px;
  background:linear-gradient(180deg,rgba(0,243,255,.5),rgba(138,43,226,.5))}
::-webkit-scrollbar-thumb:hover{background:var(--nx-cyan)}

/* Gradient text + mono system badge */
.nx-grad{background:var(--nx-text-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.nx-badge,.nx-hero-badge{
  display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;
  font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Consolas,monospace;
  font-size:.55rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase;
  color:var(--nx-cyan);background:rgba(0,243,255,.055);
  border:1px solid rgba(0,243,255,.22);white-space:nowrap;line-height:1.35;
}
.nx-hero-badge{margin:0 auto 12px;display:flex;width:fit-content}
html[data-theme="light"] .nx-badge,html[data-theme="light"] .nx-hero-badge{
  color:#0b6ea8;background:rgba(11,126,196,.07);border-color:rgba(11,126,196,.26)}
.nx-dot{width:6px;height:6px;border-radius:50%;flex:0 0 auto;
  background:var(--nx-cyan);box-shadow:0 0 9px var(--nx-cyan);
  animation:nxPulse 2.1s ease-in-out infinite}
html[data-theme="light"] .nx-dot{background:#0b7ec4;box-shadow:0 0 8px rgba(11,126,196,.6)}
@keyframes nxPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.38;transform:scale(.7)}}
@media(max-width:780px){.nx-badge{display:none}}

/* Glass: panel mờ, viền sáng */
.gcard,.modal .box,.authcard{
  backdrop-filter:blur(20px) saturate(145%);
  -webkit-backdrop-filter:blur(20px) saturate(145%);
}
.card,.qcard{background-image:linear-gradient(145deg,rgba(255,255,255,.034),transparent 46%)}
.card:hover{border-color:rgba(0,243,255,.26);
  box-shadow:0 20px 46px -30px rgba(0,243,255,.42),var(--shadow)}

/* Nút: sheen quét ngang + nhấn có độ sâu */
.btn{position:relative;overflow:hidden}
.btn::after{
  content:'';position:absolute;inset:0;pointer-events:none;opacity:0;
  background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,.3) 50%,transparent 62%);
  transform:translateX(-120%);
}
.btn:hover::after{opacity:1;animation:nxSheen .85s var(--nx-ease)}
@keyframes nxSheen{from{transform:translateX(-120%)}to{transform:translateX(120%)}}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0) scale(.97)}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{
  outline:2px solid rgba(0,243,255,.75);outline-offset:2px}

/* Chuyển view mượt hơn */
@keyframes nxViewIn{from{opacity:0;transform:translateY(11px)}to{opacity:1;transform:none}}
@keyframes nxGlow{0%,100%{box-shadow:0 0 0 0 rgba(0,243,255,0),var(--glow)}
                  50%{box-shadow:0 0 0 6px rgba(0,243,255,.09),var(--glow)}}
@media (prefers-reduced-motion:reduce){
  body::before,.nx-dot,.btn::after{animation:none!important;transition:none!important}
}

/* ---- v4.6 · sinh.html ---- */
.topbar{backdrop-filter:blur(20px) saturate(150%);-webkit-backdrop-filter:blur(20px) saturate(150%)}
.topbar::after{content:'';position:absolute;left:12px;right:12px;bottom:0;height:1px;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(0,243,255,.5),rgba(138,43,226,.45),transparent)}
.dock{box-shadow:0 18px 50px -24px rgba(0,0,0,.9),0 0 0 1px rgba(0,243,255,.13),
  inset 0 1px 0 rgba(255,255,255,.07)}
.gcard h2,.gcard h2.nx-grad,#repScore,.stat b,.vip-title{
  background:var(--nx-text-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.glogo{animation:nxGlow 3.4s ease-in-out infinite}
.view.on{animation:nxViewIn .38s var(--nx-ease) both}
h2.sec i,h2.sec svg.ico,h2.sec svg{color:var(--nx-cyan);filter:drop-shadow(0 0 6px rgba(0,243,255,.45))}
.modale .box,.modal .box{border-color:rgba(0,243,255,.2)}
.gcard{border-color:rgba(0,243,255,.22);
  box-shadow:0 0 0 1px rgba(0,243,255,.07),0 40px 90px -40px rgba(0,243,255,.35),var(--shadow)}
.nkbtn{border-color:rgba(0,243,255,.28)}

/* ---- v4.6b · entrance motion (kết thúc ở trạng thái hiển thị đầy đủ) ---- */
@keyframes nxCardIn{from{opacity:0;transform:translateY(16px) scale(.975)}to{opacity:1;transform:none}}
@keyframes nxRise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  .gcard,.authcard,.nx-hero-badge,.gcard h2{animation:none!important}
}
.gcard{animation:nxCardIn .55s var(--nx-ease) both}
.nx-hero-badge{animation:nxRise .6s .08s var(--nx-ease) both}
.gcard h2{animation:nxRise .65s .16s var(--nx-ease) both}

/* ============ v5.0 · CASIO fx-580VN X BIO-HACKS ============ */
.casio-hero{position:relative;overflow:hidden;border-color:rgba(0,243,255,.28);
  background:linear-gradient(120deg,rgba(0,243,255,.09),rgba(138,43,226,.08) 55%,rgba(61,220,151,.06))}
.casio-hero::after{content:'';position:absolute;right:-40px;top:-70px;width:200px;height:200px;border-radius:50%;
  background:radial-gradient(circle,rgba(0,243,255,.14),transparent 70%);pointer-events:none}
.casio-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;
  font-family:'JetBrains Mono',monospace;font-size:.56rem;font-weight:700;letter-spacing:.1em;
  color:var(--nx-cyan);background:rgba(0,243,255,.07);border:1px solid rgba(0,243,255,.25)}
.ckey{display:inline-flex;align-items:center;justify-content:center;min-width:26px;padding:4px 8px;
  border-radius:7px;border:1px solid rgba(0,243,255,.32);background:rgba(0,243,255,.07);
  color:var(--text);font-family:'JetBrains Mono',monospace;font-size:.66rem;font-weight:700;
  box-shadow:0 2px 0 rgba(0,243,255,.16);white-space:nowrap}
.ckey.fn{border-color:rgba(138,43,226,.4);background:rgba(138,43,226,.1);color:#d8c9ff}
.ckey.eq{border-color:rgba(61,220,151,.42);background:rgba(61,220,151,.1);color:#8ff5c6}
.casio-seq{display:flex;flex-wrap:wrap;align-items:center;gap:5px;line-height:2.1}
.casio-seq .arw{color:var(--text3);font-size:.7rem}
.casio-mod{display:none}
.casio-mod.on{display:block;animation:nxViewIn .3s var(--nx-ease) both}
.casio-res{border-left:3px solid var(--nx-cyan);background:rgba(0,243,255,.055);
  border-radius:0 12px 12px 0;padding:10px 12px;margin-top:10px;font-size:.74rem;line-height:1.7}
.casio-res b{color:var(--nx-cyan);font-family:'JetBrains Mono',monospace}
.casio-tbl{width:100%;border-collapse:collapse;font-size:.68rem;font-family:'JetBrains Mono',monospace}
.casio-tbl th,.casio-tbl td{border-bottom:1px solid var(--border);padding:4px 7px;text-align:right}
.casio-tbl th{color:var(--text3);font-weight:600;text-align:right;position:sticky;top:0;background:var(--surface)}
.casio-tbl tr.hit td{background:rgba(61,220,151,.14);color:var(--ok);font-weight:700}
.casio-tbl-wrap{max-height:230px;overflow:auto;border:1px solid var(--border);border-radius:11px;margin-top:9px}
.casio-note{font-size:.64rem;color:var(--text3);line-height:1.65;margin-top:9px;
  border-top:1px dashed var(--border2);padding-top:8px}
.casio-note b{color:var(--warn)}
.casio-inp{width:100%;padding:7px 9px;border-radius:9px;border:1px solid var(--border2);
  background:var(--surface3);color:var(--text);font-family:'JetBrains Mono',monospace;font-size:.76rem}
.casio-lb{font-size:.64rem;color:var(--text2);font-weight:700;display:block;margin-bottom:4px}
#casioTabs button{font-size:.62rem}
@media(max-width:640px){#view-casio .grid.md-g2{grid-template-columns:1fr}}

/* ============================================================
   v5.1 · DEVICE TOKENS + LAB RESPONSIVE + CASIO MOBILE + PERF
   ============================================================ */
:root{
  --lab-h:clamp(280px,38vw,520px);
  --lab-gap:8px;
  --lab-dpr:2;
}
html[data-device="phone"]{ --lab-h:clamp(196px,54vw,300px); --lab-gap:6px; }
html[data-device="tablet"]{ --lab-h:clamp(280px,38vw,420px); }
html[data-device="laptop"]{ --lab-h:clamp(340px,32vw,480px); }
html[data-device="desktop"]{ --lab-h:clamp(400px,30vw,560px); }

/* Khung canvas: cao theo thiết bị, không còn aspect-ratio cứng */
.cwrap{height:var(--lab-h);aspect-ratio:auto}
@media (max-width:759px){.cwrap{height:var(--lab-h);aspect-ratio:auto}}

/* ---------- LAB HUD / ghost / tooltip / sparkline ---------- */
.labhud{position:absolute;top:8px;left:8px;z-index:3;display:inline-flex;align-items:center;gap:6px;
  padding:4px 9px;border-radius:99px;pointer-events:none;
  font-family:'JetBrains Mono',monospace;font-size:.55rem;font-weight:700;letter-spacing:.08em;
  color:#d9fbff;background:rgba(4,10,18,.62);border:1px solid rgba(0,243,255,.28);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.labhud .labdot{width:6px;height:6px;border-radius:50%;background:#00f3ff;
  box-shadow:0 0 8px #00f3ff;animation:nxPulse 1.8s ease-in-out infinite}
.labhud b{color:#fff;font-size:.6rem;letter-spacing:0}
.labghost{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none;
  opacity:0;transition:opacity .25s var(--nx-ease);mix-blend-mode:screen}
.labghost.on{opacity:.42}
html[data-theme="light"] .labghost{opacity:0;mix-blend-mode:multiply}
html[data-theme="light"] .labghost.on{opacity:.32}
.labtip{position:absolute;z-index:4;min-width:132px;max-width:190px;padding:7px 9px;border-radius:10px;
  background:rgba(4,10,18,.9);border:1px solid rgba(0,243,255,.3);color:#dff8ff;
  font-size:.62rem;line-height:1.55;pointer-events:none;opacity:0;transform:translateY(4px);
  transition:opacity .18s,transform .18s;backdrop-filter:blur(8px)}
.labtip.on{opacity:1;transform:none}
.labtip .rowx{display:flex;justify-content:space-between;gap:10px}
.labtip .rowx b{font-family:'JetBrains Mono',monospace;color:#00f3ff}
.labspark{margin-top:var(--lab-gap)}
.labspark canvas{display:block;width:100%;height:44px;margin-top:5px;border-radius:8px;
  background:linear-gradient(180deg,rgba(0,243,255,.05),transparent)}
.labtools{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.labtools .btn{flex:1 1 auto;min-width:88px;font-size:.64rem}
#btnLabCtl{display:none}
html[data-device="phone"] #btnLabCtl{display:inline-flex}
#btnLabSnap.on{border-color:rgba(0,243,255,.6);color:#00f3ff;background:rgba(0,243,255,.1)}

/* ---------- LAB: phone gọn, desktop bung ---------- */
html[data-device="phone"] #labControls{display:grid;grid-template-columns:1fr 1fr;gap:6px}
html[data-device="phone"] #labControls.lab-collapsed{display:none}
html[data-device="phone"] .lctrl{padding:7px 8px;border-radius:10px}
html[data-device="phone"] .lctrl .between{font-size:.62rem}
html[data-device="phone"] .lctrl .seg button{font-size:.54rem;padding:5px 2px;border-radius:7px}
html[data-device="phone"] .lctrl input[type="range"]{margin-top:4px}
html[data-device="phone"] .metrics{grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}
html[data-device="phone"] .metric{padding:6px 7px;border-radius:10px}
html[data-device="phone"] .metric .lbl{font-size:.52rem;line-height:1.25}
html[data-device="phone"] .metric .val{font-size:.78rem}
html[data-device="phone"] .ctag{display:none}
html[data-device="phone"] .labstage{border-radius:14px}
html[data-device="phone"] .labspark canvas{height:38px}

html[data-device="tablet"] #labControls{display:grid;grid-template-columns:1fr 1fr;gap:7px}
html[data-device="laptop"] #labControls,
html[data-device="desktop"] #labControls{display:grid;grid-template-columns:1fr 1fr;gap:8px}
html[data-device="desktop"] .cwrap{border-radius:20px}
html[data-device="desktop"] .labstage{box-shadow:0 30px 70px -34px rgba(0,0,0,.9),inset 0 0 0 1px rgba(255,255,255,.04)}
html[data-device="desktop"] .labhud{font-size:.6rem;padding:5px 11px}

/* ---------- CASIO trên điện thoại ---------- */
html[data-device="phone"] #view-casio .casio-hero{padding:12px}
html[data-device="phone"] #view-casio .casio-hero h2{font-size:.94rem}
html[data-device="phone"] .casio-badge{font-size:.5rem;padding:3px 8px}
html[data-device="phone"] #casioTabs{overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch}
html[data-device="phone"] #casioTabs::-webkit-scrollbar{display:none}
html[data-device="phone"] #casioTabs button{flex:0 0 auto;min-width:88px;font-size:.58rem;padding:7px 6px}
html[data-device="phone"] .casio-seq{overflow-x:auto;flex-wrap:nowrap;padding-bottom:5px;gap:4px;
  scrollbar-width:thin;-webkit-overflow-scrolling:touch}
html[data-device="phone"] .casio-seq > *{flex:0 0 auto}
html[data-device="phone"] .casio-seq .arw{flex:0 0 auto}
html[data-device="phone"] .ckey{flex:0 0 auto;font-size:.56rem;padding:3px 6px;min-width:22px;border-radius:6px}
html[data-device="phone"] .casio-res{font-size:.68rem;padding:9px 10px}
html[data-device="phone"] .casio-note{font-size:.6rem}
html[data-device="phone"] .casio-tbl{font-size:.58rem}
html[data-device="phone"] .casio-tbl th,html[data-device="phone"] .casio-tbl td{padding:3px 5px}
html[data-device="phone"] .casio-tbl-wrap{max-height:190px}
html[data-device="phone"] #view-casio .grid.md-g2{grid-template-columns:1fr}
html[data-device="phone"] .casio-inp{font-size:.72rem;padding:8px 9px}
html[data-device="phone"] #view-casio .btn{font-size:.68rem;padding:9px 10px}
html[data-device="tablet"] .casio-seq{flex-wrap:wrap}

/* ---------- PERF: giảm hiệu ứng nặng trên điện thoại ---------- */
html[data-device="phone"] body::after{display:none}
html[data-device="phone"] #aurora{filter:blur(3px);opacity:.72}
html[data-device="phone"] .topbar,
html[data-device="phone"] .card,
html[data-device="phone"] .qcard,
html[data-device="phone"] .labstage{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
/* v5.4 — tắt blur thì phải nền đặc, nếu không nội dung sẽ "xuyên" qua header */
html[data-device="phone"] .topbar{background:var(--bg);box-shadow:0 1px 0 var(--border)}
html[data-device="phone"] #brandSub{font-size:.5rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:148px}
html[data-device="phone"] .dock{backdrop-filter:blur(12px)!important;-webkit-backdrop-filter:blur(12px)!important}
html[data-device="phone"] .card:hover{box-shadow:var(--shadow)}
html[data-device="phone"] .labhud{backdrop-filter:none;-webkit-backdrop-filter:none;background:rgba(4,10,18,.82)}
html[data-device="phone"] .casio-hero::after{display:none}
@media (prefers-reduced-motion:reduce){
  .labhud .labdot{animation:none!important}
}

/* ---- v5.1b · lab stage grid + mobile GPU savings ---- */
.labstage::after{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;
  background-image:
    linear-gradient(rgba(0,243,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,243,255,.03) 1px,transparent 1px);
  background-size:34px 34px;
  -webkit-mask-image:radial-gradient(120% 90% at 50% 45%,#000 40%,transparent 100%);
  mask-image:radial-gradient(120% 90% at 50% 45%,#000 40%,transparent 100%)}
html[data-theme="light"] .labstage::after{opacity:.45}
html[data-device="phone"] #aurora{animation:none}
html[data-device="phone"] .glow-sweep::before{display:none}
html[data-device="phone"] .nx-dot{animation:none}
html[data-device="phone"] .card{transition:border-color .2s,background .2s}
html[data-device="phone"] .btn:hover{transform:none;box-shadow:none}
@media (hover:none){.card:hover{box-shadow:var(--shadow);border-color:var(--border)}}

/* ---- v5.2 · Casio 7 kỹ thuật: keycap + tab cuộn ---- */
#casioTabs{overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch}
#casioTabs::-webkit-scrollbar{display:none}
#casioTabs button{flex:0 0 auto;min-width:92px}
.ckey{background:linear-gradient(180deg,rgba(0,243,255,.16),rgba(0,243,255,.05));
  box-shadow:0 2px 0 rgba(0,243,255,.30),inset 0 1px 0 rgba(255,255,255,.14)}
.ckey.fn{background:linear-gradient(180deg,rgba(138,43,226,.20),rgba(138,43,226,.06));
  box-shadow:0 2px 0 rgba(138,43,226,.35),inset 0 1px 0 rgba(255,255,255,.12)}
.ckey.eq{background:linear-gradient(180deg,rgba(61,220,151,.20),rgba(61,220,151,.06));
  box-shadow:0 2px 0 rgba(61,220,151,.35),inset 0 1px 0 rgba(255,255,255,.12)}
.casio-formula{font-family:'JetBrains Mono',monospace;font-size:.72rem;line-height:1.8;
  padding:8px 10px;border-radius:9px;background:rgba(0,243,255,.05);border:1px dashed rgba(0,243,255,.22)}
.casio-steps{counter-reset:cs;display:grid;gap:6px;margin-top:8px}
.casio-steps > div{position:relative;padding-left:24px;font-size:.68rem;line-height:1.6;color:var(--text2)}
.casio-steps > div::before{counter-increment:cs;content:counter(cs);position:absolute;left:0;top:0;
  width:17px;height:17px;border-radius:50%;display:grid;place-items:center;
  font-size:.56rem;font-weight:800;color:#04140d;background:linear-gradient(135deg,#00f3ff,#3ddc97)}
.casio-tbl td.num{font-variant-numeric:tabular-nums}
.casio-warn{border-left:3px solid var(--warn);background:rgba(251,191,36,.07);padding:7px 9px;border-radius:0 9px 9px 0;
  font-size:.62rem;line-height:1.6;margin-top:8px;color:var(--text2)}

/* ---- v5.3 · Flashcard SRS ---- */
.fcstats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.fcstats .stat{padding:8px 6px}
.fcstats .stat b{font-size:1.05rem}
.fcstats .stat span{font-size:.56rem}
.fcbar{display:flex;align-items:center;gap:8px;margin:10px 0 8px}
.fcbar select{flex:1;min-width:0;padding:8px 10px;border-radius:10px;border:1px solid var(--border);
  background:var(--surface2);color:var(--text);font:inherit;font-size:.8rem}
.fcstage{perspective:1400px}
.fcard{position:relative;height:min(48vh,300px);min-height:220px;transform-style:preserve-3d;
  transition:transform .5s cubic-bezier(.2,.8,.2,1);cursor:pointer;will-change:transform}
.fcard.flip{transform:rotateY(180deg)}
.fcard .face{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:safe center;gap:8px;padding:15px;
  border:1px solid var(--border);border-radius:18px;background:linear-gradient(150deg,var(--surface2),var(--surface));
  backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:auto;overscroll-behavior:contain}
.fcard .back{transform:rotateY(180deg);border-color:rgba(0,243,255,.4)}
html[data-theme="light"] .fcard .back{border-color:rgba(11,126,196,.45)}
.fcard .ftag{align-self:flex-start;font-size:.58rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  padding:3px 8px;border-radius:99px;background:rgba(0,243,255,.12);color:var(--accent2)}
.fcard .fq{font-size:.98rem;line-height:1.5;font-weight:650}
.fcard .fa{font-size:.9rem;line-height:1.55;color:var(--text)}
.fcard .fw{font-size:.78rem;line-height:1.55;color:var(--text2);border-left:2px solid var(--accent);padding-left:9px}
.fcard .fh{margin-top:auto;font-size:.62rem;color:var(--text3);display:flex;align-items:center;gap:5px}
.fcbtns{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:10px}
.fcbtns .btn{padding:9px 4px;font-size:.72rem;line-height:1.25;flex-direction:column;gap:2px}
.fcbtns .btn small{display:block;font-size:.56rem;opacity:.72;font-weight:600}
.fcbtns .btn:disabled{opacity:.38;pointer-events:none}
.fcdone{text-align:center;padding:26px 14px}
.fcdone i{font-size:2rem;color:var(--ok);margin-bottom:8px;display:block}
@media(max-width:560px){
  .fcstats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .fcbtns{grid-template-columns:repeat(2,minmax(0,1fr))}
  .fcard{height:min(42vh,250px)}
  .fcard .fq{font-size:.9rem}
}
/* ---- v5.3 · Coach ---- */
.coachbar{display:flex;align-items:center;gap:8px;padding:9px 11px;border-radius:12px;font-size:.76rem;
  border:1px solid var(--border);background:var(--surface2);color:var(--text2)}
.coachbar.warn{border-color:rgba(250,204,21,.4);background:rgba(250,204,21,.08);color:var(--text)}
.coachbar i{color:var(--accent)}
.coachplan{display:flex;flex-direction:column;gap:8px}
.coachplan .cp{display:flex;gap:9px;align-items:flex-start}
.coachplan .cpt{flex:0 0 auto;font-size:.6rem;font-weight:800;padding:2px 6px;border-radius:6px;
  background:rgba(0,243,255,.12);color:var(--accent2);margin-top:2px}
.coachplan .cpx{flex:1;font-size:.8rem;line-height:1.5}
.spark{display:flex;align-items:flex-end;gap:3px;height:44px;margin-top:6px}
.spark i{flex:1;background:linear-gradient(180deg,var(--accent2),var(--accent));border-radius:3px 3px 0 0;min-height:2px;opacity:.85}

/* ---- v5.3 · sơ đồ tương tác ---- */
.dtabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:8px;scrollbar-width:thin}
.dtabs button{flex:0 0 auto;padding:7px 11px;border-radius:10px;border:1px solid var(--border);
  background:var(--surface2);color:var(--text2);font:inherit;font-size:.74rem;font-weight:650;cursor:pointer}
.dtabs button.on{background:linear-gradient(100deg,var(--accent2),var(--accent));color:#04121a;border-color:transparent}
.dstage{position:relative;border-radius:16px;overflow:hidden;border:1px solid var(--border);
  background:radial-gradient(120% 100% at 50% 0%,rgba(0,243,255,.07),transparent 60%),var(--surface2)}
.dsvg{display:block;width:100%;height:auto}
.dzone{position:absolute;transform:translate(-50%,-50%);min-width:56px;max-width:38%;padding:4px 7px;
  font:inherit;font-size:.6rem;font-weight:700;line-height:1.2;text-align:center;cursor:pointer;
  border:1px dashed rgba(0,243,255,.55);border-radius:9px;background:rgba(7,17,31,.6);color:var(--text2);
  -webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px);transition:background .15s,border-color .15s}
html[data-theme="light"] .dzone{background:rgba(255,255,255,.78);color:var(--text2)}
.dzone.filled{border-style:solid;border-color:var(--accent2);color:var(--text);background:rgba(0,243,255,.14)}
html[data-theme="light"] .dzone.filled{background:rgba(11,126,196,.12)}
.dzone.ok{border-color:var(--ok);background:rgba(69,223,160,.2);color:var(--ok)}
.dzone.bad{border-color:var(--bad);background:rgba(248,113,113,.2);color:var(--bad);animation:dshake .32s}
.dzone.hover{outline:2px solid var(--accent);outline-offset:2px}
@keyframes dshake{0%,100%{transform:translate(-50%,-50%)}25%{transform:translate(-56%,-50%)}75%{transform:translate(-44%,-50%)}}
.dpool{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px;min-height:34px}
.dchip{padding:6px 10px;border-radius:9px;border:1px solid var(--border);background:var(--surface3);
  color:var(--text);font:inherit;font-size:.7rem;font-weight:650;cursor:grab;touch-action:none;user-select:none}
.dchip.sel{border-color:var(--accent);box-shadow:0 0 0 2px rgba(0,243,255,.22)}
.dchip.used{display:none}
.dghost{position:fixed;z-index:9999;pointer-events:none;padding:6px 10px;border-radius:9px;
  background:var(--accent);color:#04121a;font-size:.7rem;font-weight:800;transform:translate(-50%,-50%);
  box-shadow:0 8px 24px rgba(0,0,0,.35)}
.dfoot{display:flex;align-items:center;gap:7px;margin-top:9px;flex-wrap:wrap}
.dfoot .tiny{flex:1;min-width:120px}
.dwhy{display:flex;flex-direction:column;gap:5px;margin-top:8px}
.dwhy div{font-size:.74rem;line-height:1.45;color:var(--text2)}
.dwhy b{color:var(--text)}
@media(max-width:560px){
  .dzone{font-size:.52rem;padding:3px 5px;min-width:44px}
  .dchip{font-size:.64rem;padding:5px 8px}
}

/* ---- v5.4 · Casio scenario panels + generated key line ---- */
.casio-mrow{display:flex;flex-direction:column;gap:4px}
.casio-dyn{margin-top:8px;padding:8px 9px;border-radius:10px;border:1px dashed rgba(0,243,255,.35);
  background:rgba(0,243,255,.05);display:flex;flex-wrap:wrap;align-items:center;gap:5px;line-height:2}
.casio-dyn .lbl{font-size:.56rem;color:var(--text3);font-weight:800;letter-spacing:.05em;
  text-transform:uppercase;margin-right:3px;flex:0 0 100%}
.casio-why{font-size:.72rem;line-height:1.55;color:var(--text2);margin-top:7px}
html[data-device="phone"] .casio-dyn{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:thin}
html[data-device="phone"] .casio-dyn > *{flex:0 0 auto}
html[data-device="phone"] .casio-dyn .lbl{position:sticky;left:0;background:var(--surface);z-index:1;flex:0 0 auto}

/* ---- v5.6 · multiplayer: grace banner + review chi tiết ---- */
.gracebar{position:sticky;top:50px;z-index:35;margin-bottom:10px;padding:9px 12px;border-radius:12px;
  font-size:.72rem;line-height:1.5;color:var(--text);border:1px solid rgba(250,204,21,.45);
  background:linear-gradient(100deg,rgba(250,204,21,.14),rgba(0,243,255,.08));
  box-shadow:0 8px 24px -14px rgba(250,204,21,.7)}
.gracebar b{color:var(--warn)}
.mp-review{margin-bottom:6px}
.mp-review.ok summary{border-left:3px solid var(--ok)}
.mp-review.bad summary{border-left:3px solid var(--bad)}
.mp-review summary{display:flex;align-items:center;gap:7px;cursor:pointer;line-height:1.45}
.mp-review .qnum{flex:0 0 auto;min-width:22px;text-align:center;font-size:.62rem;padding:2px 5px;border-radius:6px}
.mp-review .qnum.ok{background:rgba(69,223,160,.16);color:var(--ok)}
.mp-review .qnum.bad{background:rgba(248,113,113,.16);color:var(--bad)}
.mp-review .body{font-size:.76rem;line-height:1.6;color:var(--text2)}
.whybox{margin-top:6px;padding:7px 9px;border-radius:9px;border-left:2px solid var(--accent);
  background:rgba(0,243,255,.05);color:var(--text2)}
html[data-device="phone"] .gracebar{top:44px;font-size:.66rem}

/* ---- v5.6 · cấu hình mạng nâng cao ---- */
#netAdvCfg{margin-top:9px}
#netAdvCfg input,#netAdvCfg select,#mpCfgHp,#mpCfgGrace,#netFreeN,#netFreeT,#netFreeH,#netFreeMode{
  width:100%;padding:7px 9px;border-radius:9px;border:1px solid var(--border2);
  background:var(--surface2);color:var(--text);font:inherit;font-size:.76rem}
#netAdvCfg select,#netFreeMode{cursor:pointer}

/* ---- v5.6 · phòng chờ + mini game khủng long ---- */
.dino-card{margin:10px 0;padding:10px;border-radius:16px;border:1px solid rgba(139,124,246,.32);
  background:linear-gradient(150deg,rgba(139,124,246,.10),rgba(0,243,255,.05));
  box-shadow:0 14px 34px -22px rgba(139,124,246,.8),inset 0 1px 0 rgba(255,255,255,.05)}
.dino-card canvas{display:block;width:100%;height:auto;margin-top:8px;border-radius:11px;
  border:1px solid rgba(0,243,255,.18);touch-action:manipulation;cursor:pointer}
.dino-hud{display:flex;flex-direction:column;align-items:flex-end;gap:2px;font-size:.62rem;color:var(--text3);flex:0 0 auto}
.dino-hud b{color:var(--accent2);font-size:.82rem}
.netbanner.ok{animation:netPulse 2.4s var(--nx-ease) infinite}
@keyframes netPulse{0%,100%{box-shadow:none}50%{box-shadow:0 0 0 2px rgba(69,223,160,.12)}}
.mpplayer{animation:mpIn .35s var(--nx-ease) both}
@keyframes mpIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
html[data-device="phone"] .dino-card{padding:8px}
html[data-device="phone"] .dino-card canvas{max-height:150px;object-fit:cover}

/* ---- v5.6 · Ôn lớp 11: tài liệu giải thích siêu dễ ---- */
.g11-hero{border-color:rgba(69,223,160,.28);background:
  radial-gradient(120% 100% at 0% 0%,rgba(69,223,160,.10),transparent 60%),var(--surface2)}
.g11unit{margin-bottom:9px}
.g11unit > summary{display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:750;font-size:.86rem}
.g11unit > .body{padding-top:9px}
.g11easy,.g11analogy,.g11remember{padding:10px 12px;border-radius:12px;margin-bottom:8px;
  font-size:.8rem;line-height:1.7;color:var(--text2)}
.g11easy{background:rgba(0,243,255,.055);border-left:3px solid var(--accent2)}
.g11analogy{background:rgba(139,124,246,.08);border-left:3px solid #8b7cf6}
.g11remember{background:rgba(69,223,160,.09);border-left:3px solid var(--ok);color:var(--text)}
.g11tag{font-size:.56rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--text3);margin-bottom:4px}
.g11qtitle{font-size:.72rem;font-weight:800;color:var(--accent2);margin:11px 0 7px;letter-spacing:.04em}
.g11q{padding:9px;border:1px solid var(--border);border-radius:12px;margin-bottom:7px;background:var(--surface2)}
.g11q.ok{border-color:rgba(69,223,160,.45)}
.g11q.bad{border-color:rgba(248,113,113,.45)}
.g11qh{display:flex;gap:7px;align-items:flex-start;font-size:.8rem;font-weight:650;line-height:1.5;margin-bottom:7px}
.g11num{flex:0 0 auto;width:20px;height:20px;border-radius:6px;display:grid;place-items:center;
  font-size:.6rem;background:rgba(0,243,255,.12);color:var(--accent2)}
.g11opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}
.g11opt{text-align:left;padding:7px 8px;border:1px solid var(--border);border-radius:9px;
  background:var(--surface3);color:var(--text2);font:inherit;font-size:.72rem;line-height:1.45;cursor:pointer;transition:.15s}
.g11opt:hover:not(:disabled){border-color:var(--accent);color:var(--text)}
.g11opt b{color:var(--accent2);margin-right:3px}
.g11opt.right{background:rgba(69,223,160,.16);border-color:var(--ok);color:var(--ok)}
.g11opt.wrong{background:rgba(248,113,113,.16);border-color:var(--bad);color:var(--bad)}
.g11opt:disabled{cursor:default;opacity:.85}
.g11why{margin-top:7px;padding:8px 10px;border-radius:10px;font-size:.76rem;line-height:1.65;
  color:var(--text2);background:rgba(0,243,255,.05);border-left:2px solid var(--accent2)}
@media(max-width:560px){.g11opts{grid-template-columns:1fr}.g11easy,.g11analogy,.g11remember{font-size:.76rem;padding:9px}}

/* ---- v5.6 · dock 10 tab trên điện thoại: cuộn ngang, vẫn đọc được nhãn ---- */
html[data-device="phone"] #dock{overflow-x:auto;justify-content:flex-start;
  scrollbar-width:none;-webkit-overflow-scrolling:touch}
html[data-device="phone"] #dock::-webkit-scrollbar{display:none}
html[data-device="phone"] #dock button{flex:0 0 56px;min-width:56px;padding:6px 2px}
html[data-device="phone"] #dock button span{display:inline;font-size:.5rem;white-space:nowrap;max-width:54px;overflow:hidden;text-overflow:ellipsis}
html[data-device="phone"] #dock button i{font-size:.92rem}

/* ---- v5.6 · lab chân thật hơn: phản xạ kính + ánh sáng đỉnh ---- */
.labstage::before{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(158deg,rgba(255,255,255,.11),transparent 34%),
    radial-gradient(120% 55% at 50% -8%,rgba(220,250,255,.10),transparent 72%);
  mix-blend-mode:screen}
.labstage{box-shadow:inset 0 1px 0 rgba(255,255,255,.12),inset 0 -22px 40px -30px rgba(0,0,0,.8)}
html[data-theme="light"] .labstage::before{opacity:.5}
html[data-device="phone"] .labstage::before{display:none}

/* ============================================================
   v5.7 · CASIO BIO-HACKS 2.0 — keycap kim loại, cheat-sheet, giả lập
   ============================================================ */
:root{
  --kx1:#3b4552;--kx2:#232b36;--kxT:#e9eff8;--kxB:#4d5868;--kxS:#131922;
  --kxF1:#433b22;--kxF2:#2a2517;--kxFT:#ffd76a;--kxFB:#7a6320;
  --kxA1:#42292a;--kxA2:#2a1919;--kxAT:#ff9d9d;--kxAB:#7a3232;
  --kxE1:#1f3b32;--kxE2:#152720;--kxET:#8ff5c6;--kxEB:#2f6b52;
}
html[data-theme="light"]{
  --kx1:#f7f9fc;--kx2:#dbe2ec;--kxT:#16202e;--kxB:#b7c2d2;--kxS:#a6b2c4;
  --kxF1:#fff5d6;--kxF2:#f4e3b0;--kxFT:#7a5600;--kxFB:#d3b263;
  --kxA1:#ffe3e3;--kxA2:#f7c9c9;--kxAT:#8d1f1f;--kxAB:#dfa0a0;
  --kxE1:#dcf7e9;--kxE2:#bfe9d4;--kxET:#0c6a44;--kxEB:#8ecfb1;
}
.ckey{
  background:linear-gradient(180deg,var(--kx1),var(--kx2));
  border:1px solid var(--kxB);color:var(--kxT);
  box-shadow:0 2px 0 var(--kxS),inset 0 1px 0 rgba(255,255,255,.16);
  text-shadow:0 1px 0 rgba(0,0,0,.28)
}
html[data-theme="light"] .ckey{text-shadow:none}
.ckey.fn{background:linear-gradient(180deg,var(--kxF1),var(--kxF2));color:var(--kxFT);border-color:var(--kxFB)}
.ckey.al{background:linear-gradient(180deg,var(--kxA1),var(--kxA2));color:var(--kxAT);border-color:var(--kxAB)}
.ckey.eq{background:linear-gradient(180deg,var(--kxE1),var(--kxE2));color:var(--kxET);border-color:var(--kxEB)}

/* --- phân hệ --- */
.cx-pane{display:none}
.cx-pane.on{display:block;animation:nxViewIn .28s var(--nx-ease) both}
.cx-seg{margin-bottom:11px}
.cx-seg button{font-size:.66rem}
@media(max-width:640px){.cx-seg button{flex:1 1 100%;min-width:0}}

/* --- cheat-sheet accordion --- */
.cx-item{border:1px solid var(--border);border-radius:13px;background:var(--surface2);
  margin-bottom:8px;overflow:hidden;transition:border-color .2s,background .2s}
.cx-item:hover{border-color:var(--border2)}
.cx-item[open]{background:var(--surface)}
.cx-item>summary{display:flex;align-items:center;gap:9px;padding:10px 12px;cursor:pointer;
  list-style:none;user-select:none}
.cx-item>summary::-webkit-details-marker{display:none}
.cx-item>summary::after{content:'';flex:0 0 auto;width:6px;height:6px;margin-left:auto;
  border-right:2px solid var(--text3);border-bottom:2px solid var(--text3);
  transform:rotate(45deg);transition:transform .25s}
.cx-item[open]>summary::after{transform:rotate(-135deg)}
.cx-item[open]>summary{border-bottom:1px solid var(--border)}
.cx-no{flex:0 0 25px;height:25px;border-radius:8px;display:grid;place-items:center;
  font-family:'JetBrains Mono',monospace;font-size:.6rem;font-weight:800;color:#04121a;
  background:linear-gradient(135deg,var(--nx-cyan),#7cf0b4)}
.cx-ttl{flex:1;min-width:0;font-size:.74rem;font-weight:700;color:var(--text);line-height:1.35}
.cx-tag{flex:0 0 auto;font-family:'JetBrains Mono',monospace;font-size:.52rem;font-weight:700;
  letter-spacing:.06em;color:var(--nx-cyan);background:rgba(0,243,255,.08);
  border:1px solid rgba(0,243,255,.24);border-radius:99px;padding:2px 7px;white-space:nowrap}
html[data-theme="light"] .cx-tag{color:#0a6d86;background:rgba(10,143,102,.07);border-color:rgba(10,143,102,.28)}
.cx-body{padding:2px 12px 12px;font-size:.74rem;line-height:1.68;color:var(--text2)}
.cx-ess{margin:6px 0 8px}
.cx-ess b{color:var(--text)}
.cx-formula{font-family:'JetBrains Mono',monospace;font-size:.7rem;line-height:1.8;
  background:rgba(0,243,255,.05);border-left:3px solid var(--nx-cyan);border-radius:0 9px 9px 0;
  padding:7px 10px;color:var(--text);overflow-x:auto;white-space:nowrap}
.cx-item .casio-note{margin-top:7px;font-size:.62rem}
.cx-flash{animation:cxFlash 1.1s var(--nx-ease)}
@keyframes cxFlash{0%,100%{box-shadow:0 0 0 0 rgba(0,243,255,0)}30%{box-shadow:0 0 0 3px rgba(0,243,255,.5)}}

/* --- giả lập máy tính --- */
.cx-simwrap{display:grid;grid-template-columns:minmax(0,338px) minmax(0,1fr);gap:14px;align-items:start}
@media(max-width:820px){.cx-simwrap{grid-template-columns:1fr}}
.cx-device{position:relative;border-radius:20px;padding:13px 12px 15px;
  background:linear-gradient(158deg,#313a48,#1a212b 55%,#0c1118);
  border:1px solid #414c5c;
  box-shadow:0 28px 60px -26px rgba(0,0,0,.9),inset 0 1px 0 rgba(255,255,255,.14)}
html[data-theme="light"] .cx-device{background:linear-gradient(158deg,#3a4452,#242c38 60%,#171d26);border-color:#4a5565}
.cx-device::after{content:'';position:absolute;inset:0;border-radius:20px;pointer-events:none;
  background:linear-gradient(200deg,rgba(255,255,255,.1),transparent 38%)}
.cx-brand{display:flex;align-items:baseline;justify-content:space-between;gap:6px;
  margin-bottom:7px;font-family:'JetBrains Mono',monospace;color:#a9b8cd}
.cx-brand b{font-size:.62rem;letter-spacing:.2em;color:#dfe8f5}
.cx-brand span{font-size:.5rem;letter-spacing:.08em}
.cx-brand em{font-style:normal;font-size:.44rem;letter-spacing:.14em;color:#7f8ea3}
.cx-screen{position:relative;border-radius:9px;padding:7px 9px 9px;min-height:104px;
  background:linear-gradient(180deg,#ccd9bb,#b6c6a3 70%,#a8b995);
  box-shadow:inset 0 3px 9px rgba(0,0,0,.42),0 1px 0 rgba(255,255,255,.2);
  font-family:'JetBrains Mono',monospace;color:#1b2a16;overflow:hidden}
.cx-screen::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(180deg,rgba(0,0,0,.045) 0 1px,transparent 1px 3px);opacity:.5}
.cx-status{display:flex;gap:9px;align-items:center;font-size:.44rem;letter-spacing:.08em;
  color:#3f5433;border-bottom:1px solid rgba(40,60,30,.32);padding-bottom:3px;margin-bottom:4px}
.cx-status i{font-style:normal;opacity:.35}
.cx-status i.on{opacity:1;font-weight:800;color:#1b3a12}
.cx-lcd{font-size:.62rem;line-height:1.52;min-height:66px;white-space:pre-wrap;word-break:break-word}
.cx-lcd div{animation:cxLcdIn .22s ease both}
.cx-lcd .res{font-weight:800;color:#0f2e0a}
@keyframes cxLcdIn{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}
.cx-pad{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;margin-top:11px}
.cx-key{position:relative;height:32px;border-radius:7px;border:1px solid #596577;
  background:linear-gradient(180deg,#3d4755,#242c37);color:#e7eef9;
  font-family:'JetBrains Mono',monospace;font-size:.58rem;font-weight:700;
  box-shadow:0 2px 0 #10151c,inset 0 1px 0 rgba(255,255,255,.16);
  display:grid;place-items:center;cursor:default;user-select:none;transition:transform .09s,box-shadow .09s,background .09s}
.cx-key.k-fn{color:#ffd76a;border-color:#6d5c2a}
.cx-key.k-al{color:#ff9d9d;border-color:#6f3333}
.cx-key.k-eq{color:#8ff5c6;border-color:#2f6b52}
.cx-key.hit{transform:translateY(2px);box-shadow:0 0 0 #000,inset 0 2px 6px rgba(0,0,0,.55);
  background:linear-gradient(180deg,#5a6a80,#3a4657);color:#fff}
.cx-key.k-eq.hit{background:linear-gradient(180deg,#2f8f68,#1d6a4b);color:#eafff5}
.cx-simside{min-width:0}
.cx-simside .casio-lb{margin-top:2px}
.cx-stepbox{margin-top:10px;border:1px solid var(--border);border-radius:11px;
  background:var(--surface2);padding:9px 10px;max-height:230px;overflow:auto}
.cx-step{display:flex;gap:8px;align-items:flex-start;padding:3px 0;font-size:.66rem;color:var(--text2)}
.cx-step .n{flex:0 0 18px;height:18px;border-radius:6px;display:grid;place-items:center;
  font-family:'JetBrains Mono',monospace;font-size:.52rem;background:var(--surface3);color:var(--text3)}
.cx-step.on{color:var(--text)}
.cx-step.on .n{background:var(--nx-cyan);color:#04121a;font-weight:800}
.cx-step .k{font-family:'JetBrains Mono',monospace;color:var(--accent2);font-weight:700}

/* --- lab: viền góc + màu riêng từng thí nghiệm --- */
.labcorners{position:absolute;inset:7px;z-index:4;pointer-events:none;opacity:.5;
  background:
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) left top/13px 2px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) left top/2px 13px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) right top/13px 2px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) right top/2px 13px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) left bottom/13px 2px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) left bottom/2px 13px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) right bottom/13px 2px no-repeat,
    linear-gradient(var(--lab-a,#00f3ff),var(--lab-a,#00f3ff)) right bottom/2px 13px no-repeat}
html[data-theme="light"] .labcorners{opacity:.35}
.labstage{contain:layout paint}
.labstage .labhud{border-color:var(--lab-a,rgba(0,243,255,.3))}
.labstage .labdot{background:var(--lab-a,#00f3ff);box-shadow:0 0 8px var(--lab-a,#00f3ff)}
html[data-device="phone"] .labcorners{inset:5px;opacity:.4}
html[data-gfx="lite"] .labcorners{display:none}

/* ---- v5.7b · điểm nhấn chuyển động (tắt ở Lite/phone) ---- */
.casio-hero::before{content:'';position:absolute;inset:-40% -60%;z-index:0;pointer-events:none;
  background:conic-gradient(from 0deg,transparent 0 62%,rgba(0,243,255,.10) 70%,transparent 78% 100%);
  animation:cxSweep 14s linear infinite}
@keyframes cxSweep{to{transform:rotate(360deg)}}
.casio-hero>*{position:relative;z-index:1}
html[data-device="phone"] .casio-hero::before,
html[data-gfx="lite"] .casio-hero::before{display:none}
@media (prefers-reduced-motion:reduce){.casio-hero::before{display:none}}
#labReadouts .metric b,#labReadouts .metric .v{color:var(--lab-a,var(--accent))}
.labstage{transition:border-color .35s ease,box-shadow .35s ease}

/* ============================================================
   v5.8 · LAB ATMOSPHERE + 3D TILT
   ============================================================ */
@media (hover:hover) and (pointer:fine){
  #view-lab .labstage{
    transform:perspective(1200px) rotateX(var(--tilt-x,0deg)) rotateY(var(--tilt-y,0deg));
    transition:transform .18s ease-out,border-color .35s ease,box-shadow .35s ease}
  .cx-device{
    transform:perspective(1100px) rotateX(var(--tilt-x,0deg)) rotateY(var(--tilt-y,0deg));
    transition:transform .18s ease-out,box-shadow .25s ease}
}
.labglare,.cx-glare{position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;
  transition:opacity .3s ease;
  background:radial-gradient(320px circle at var(--gx,50%) var(--gy,50%),rgba(255,255,255,.13),transparent 72%)}
.labstage:hover .labglare,.cx-device:hover .cx-glare{opacity:1}
html[data-theme="light"] .labglare,html[data-theme="light"] .cx-glare{opacity:0!important}
html[data-device="phone"] .labglare,html[data-device="phone"] .cx-glare{display:none}
html[data-gfx="lite"] .labglare,html[data-gfx="lite"] .cx-glare{display:none}
.cx-device{overflow:hidden}

/* HUD + số đo của lab: đậm hơn, phát sáng nhẹ theo màu thí nghiệm */
.labhud{padding:4px 9px;border-radius:9px;backdrop-filter:blur(7px)}
.labhud b{font-size:.78rem;letter-spacing:.02em;text-shadow:0 0 10px var(--lab-a,rgba(0,243,255,.7))}
#labReadouts .metric{border-color:color-mix(in srgb,var(--lab-a,#00f3ff) 22%,var(--border))}
#labReadouts .metric .val{color:var(--lab-a,var(--accent));text-shadow:0 0 14px color-mix(in srgb,var(--lab-a,#00f3ff) 30%,transparent)}
html[data-theme="light"] #labReadouts .metric .val{text-shadow:none}
@media (max-width:560px){.labhud b{font-size:.7rem}}

/* ---- v5.8b · gợn sóng khi bấm + thanh tiến trình cuộn ---- */
.bg4ripple{position:absolute;border-radius:50%;pointer-events:none;transform:scale(0);opacity:.5;
  background:radial-gradient(circle,rgba(255,255,255,.7),rgba(255,255,255,0) 70%);
  animation:bg4Rip .52s cubic-bezier(.2,.7,.3,1) forwards;z-index:0}
@keyframes bg4Rip{to{transform:scale(1);opacity:0}}
.btn,.modecard,.seg button,.cx-key{position:relative;overflow:hidden}
.btn>*,.modecard>*,.seg button>*{position:relative;z-index:1}
html[data-theme="light"] .bg4ripple{background:radial-gradient(circle,rgba(10,120,90,.28),rgba(10,120,90,0) 70%)}

#scrollBar{position:fixed;left:0;top:0;height:2px;width:100%;z-index:200;pointer-events:none;
  transform:scaleX(0);transform-origin:0 50%;
  background:linear-gradient(90deg,var(--nx-cyan),#7cf0b4 45%,var(--nebula,#8b7cf6) 100%);
  box-shadow:0 0 12px rgba(0,243,255,.55);opacity:.9}
html[data-gfx="lite"] #scrollBar{display:none}

@media (hover:hover) and (pointer:fine){
  .card{transition:border-color .2s ease,box-shadow .25s ease}
  .card:hover{border-color:var(--border2);box-shadow:0 20px 46px -34px rgba(0,0,0,.85)}
  html[data-theme="light"] .card:hover{box-shadow:0 18px 40px -32px rgba(12,60,45,.5)}
}

/* ============================================================
   v5.9 · HUB — đồng bộ / lớp học / giải đấu KHÔNG CẦN SERVER
   ============================================================ */
.hubtabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:11px}
.hubtabs button{flex:1 1 100px;padding:8px 9px;border-radius:11px;border:1px solid var(--border);
  background:var(--surface2);color:var(--text2);font-size:.69rem;font-weight:700;cursor:pointer}
.hubtabs button.on{border-color:var(--accent);color:var(--accent);background:rgba(61,220,151,.08)}
.hubcode{width:100%;min-height:74px;resize:vertical;font-family:'JetBrains Mono',monospace;
  font-size:.6rem;line-height:1.5;color:var(--text);background:var(--surface3);
  border:1px solid var(--border2);border-radius:10px;padding:9px;word-break:break-all}
.hubgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-top:8px}
.hubstat{border:1px solid var(--border);border-radius:12px;padding:9px 10px;background:var(--surface2)}
.hubstat b{display:block;font-family:'JetBrains Mono',monospace;font-size:1.05rem;color:var(--accent)}
.hubstat span{font-size:.6rem;color:var(--text3)}
.hublog{max-height:130px;overflow:auto;border:1px solid var(--border);border-radius:10px;
  background:var(--surface3);padding:8px 9px;font-size:.63rem;line-height:1.6;color:var(--text2)}
.hublog div+div{border-top:1px dashed var(--border);margin-top:3px;padding-top:3px}
.hubrow{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.hubrow input,.hubrow select{padding:7px 9px;border-radius:9px;border:1px solid var(--border2);
  background:var(--surface3);color:var(--text);font-size:.7rem;min-width:0;flex:1 1 110px}
.hubtbl{width:100%;border-collapse:collapse;font-size:.66rem;margin-top:8px}
.hubtbl th,.hubtbl td{border-bottom:1px solid var(--border);padding:6px 7px;text-align:left}
.hubtbl th{color:var(--text3);font-size:.58rem;text-transform:uppercase;letter-spacing:.05em}
.hubtbl tr.win td{color:var(--ok);font-weight:700}
.hubpeer{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:99px;
  border:1px solid var(--border2);background:var(--surface2);font-size:.63rem;margin:2px}
.hubpeer i{width:6px;height:6px;border-radius:50%;background:var(--ok);box-shadow:0 0 7px var(--ok)}
.hubpeer.off i{background:var(--bad);box-shadow:none}
.bracket{display:grid;gap:8px;margin-top:9px}
.brcol{border:1px solid var(--border);border-radius:13px;padding:9px 10px;background:var(--surface2)}
.brcol h4{margin:0 0 7px;font-size:.7rem;color:var(--accent2);letter-spacing:.04em}
.brslot{display:flex;justify-content:space-between;gap:8px;padding:5px 7px;border-radius:8px;
  background:var(--surface3);font-size:.66rem;margin-bottom:4px}
.brslot.win{border:1px solid rgba(61,220,151,.4);color:var(--ok)}
.brslot b{font-family:'JetBrains Mono',monospace}
.hubnote{font-size:.62rem;color:var(--text3);line-height:1.65;border-top:1px dashed var(--border2);
  margin-top:10px;padding-top:8px}
.hubnote b{color:var(--warn)}
@media(max-width:520px){.hubtabs button{flex:1 1 45%;font-size:.62rem}.hubtbl{font-size:.6rem}}

/* ============================================================
   v5.9 · LAB 3D (WebGL) cho mức Cân bằng / Đầy đủ
   Lite vẫn dùng canvas 2D như cũ, nhưng được làm đẹp lại.
   ============================================================ */
#labGL{display:none;position:absolute;inset:0;z-index:1;width:100%;height:100%}
.labstage.gl-on #labCanvas,.labstage.gl-on #labGhost{visibility:hidden}
.labstage.gl-on #labGL{display:block}
.glcap{position:absolute;left:10px;bottom:9px;z-index:6;display:none;pointer-events:none;
  padding:5px 10px;border-radius:9px;font-family:'JetBrains Mono',monospace;font-size:.56rem;
  letter-spacing:.05em;color:#dff6ff;background:rgba(3,12,22,.6);border:1px solid rgba(0,243,255,.3)}
.labstage.gl-on .glcap{display:block}
/* ---- v5.12 · tài khoản, chuỗi ngày, nhắn tin ---- */
.streakchip{max-width:94px;border-color:rgba(251,191,36,.30);background:rgba(251,191,36,.08)}
.streakchip .fl{font-size:.85rem;line-height:1}
.streakchip b{font-size:.78rem;font-family:'JetBrains Mono',monospace}
.streakchip .tiny{font-size:.55rem;opacity:.72}
.streakchip.hot{box-shadow:0 0 0 1px rgba(251,191,36,.25),0 6px 18px -12px rgba(251,191,36,.85)}
.accchip{max-width:134px}
.accnow{display:flex;align-items:center;gap:10px;padding:10px;border-radius:14px;background:var(--surface2);border:1px solid var(--border);margin-bottom:10px}
.accnow .av,.accrow .av{font-size:1.35rem;width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:var(--surface3);border:1px solid var(--border);flex:0 0 auto}
.acclist{display:flex;flex-direction:column;gap:6px}
.acctitle{font-size:.62rem;font-weight:800;color:var(--text3);letter-spacing:.04em;text-transform:uppercase;margin:2px 0 6px}
.accrow{display:flex;align-items:center;gap:9px;padding:8px;border-radius:13px;border:1px solid var(--border);background:var(--surface2)}
.accrow.on{border-color:rgba(61,220,151,.4);background:rgba(61,220,151,.07)}
.accmeta{display:flex;flex-direction:column;min-width:0;flex:1;gap:1px}
.accmeta b{font-size:.74rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.accnew{margin-top:14px;padding-top:12px;border-top:1px dashed var(--border2)}
.accavs{display:flex;gap:5px;flex-wrap:wrap}
.avbtn{width:34px;height:34px;border-radius:10px;border:1px solid var(--border);background:var(--surface2);font-size:1.05rem;cursor:pointer;transition:.16s}
.avbtn.on{border-color:var(--accent);background:rgba(61,220,151,.12);transform:translateY(-1px)}
.streakhero{display:flex;align-items:center;gap:12px;padding:12px;border-radius:16px;background:linear-gradient(135deg,rgba(251,191,36,.12),rgba(251,113,133,.08));border:1px solid rgba(251,191,36,.28)}
.streakhero .flame{font-size:2rem;line-height:1}
.streakhero b{font-size:1.8rem;line-height:1;font-family:'JetBrains Mono',monospace}
.streakhero span{display:block;font-size:.66rem;color:var(--text2)}
.heat{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;max-width:286px}
.heat i{aspect-ratio:1;border-radius:4px;background:var(--surface3);border:1px solid var(--border);display:block}
.heat i.lv1{background:rgba(61,220,151,.18);border-color:rgba(61,220,151,.25)}
.heat i.lv2{background:rgba(61,220,151,.38);border-color:rgba(61,220,151,.4)}
.heat i.lv3{background:rgba(61,220,151,.62);border-color:rgba(61,220,151,.6)}
.heat i.lv4{background:rgba(61,220,151,.9);border-color:rgba(61,220,151,.9)}
.srow{display:flex;gap:8px;align-items:center;margin-top:10px;padding:9px;border-radius:12px;background:var(--surface2);border:1px solid var(--border);font-size:.68rem}
.srow span{flex:1;color:var(--text2)}
.srow b{font-family:'JetBrains Mono',monospace}
.chatstreak{padding:7px 10px;border-radius:11px;background:rgba(251,191,36,.09);border:1px solid rgba(251,191,36,.25);font-size:.68rem;margin-bottom:8px}
.chatbox{height:min(28vh,215px);overflow-y:auto;display:flex;flex-direction:column;gap:6px;padding:8px;border-radius:13px;background:var(--surface3);border:1px solid var(--border)}
.cmsg{max-width:82%;padding:6px 9px;border-radius:12px;font-size:.7rem;line-height:1.45;display:flex;flex-direction:column;gap:2px}
.cmsg i{font-style:normal;font-size:.52rem;opacity:.55;align-self:flex-end}
.cmsg.me{align-self:flex-end;background:rgba(61,220,151,.16);border:1px solid rgba(61,220,151,.3)}
.cmsg.you{align-self:flex-start;background:var(--surface2);border:1px solid var(--border)}
@media(max-width:700px){.accchip #accChipName,.streakchip .tiny{display:none}.accchip{max-width:46px}.streakchip{max-width:62px}}
/* ---- v5.12 · nhãn bộ phận dán theo mô hình 3D ---- */
.gllabels{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}
.gllabels span{position:absolute;transform:translate(-50%,-118%);padding:2px 8px 2px 6px;border-radius:999px;
  font-size:.60rem;font-weight:800;letter-spacing:.01em;white-space:nowrap;line-height:1.5;
  background:rgba(4,12,22,.74);border:1px solid rgba(255,255,255,.16);color:#eaf3ff;
  box-shadow:0 6px 16px -8px rgba(0,0,0,.9);will-change:left,top}
.gllabels span::before{content:'';display:inline-block;width:5px;height:5px;border-radius:50%;margin-right:5px;
  vertical-align:1px;background:var(--lc,#3ddc97);box-shadow:0 0 7px var(--lc,#3ddc97)}
.gllabels span.a{--lc:#3ddc97}.gllabels span.b{--lc:#38bdf8}
.gllabels span.c{--lc:#fbbf24}.gllabels span.d{--lc:#fb7185}
.labstage:not(.gl-on) .gllabels{display:none}
html[data-theme="light"] .gllabels span{background:rgba(255,255,255,.92);color:#0c211a;border-color:rgba(12,58,44,.18);
  box-shadow:0 6px 14px -8px rgba(12,58,44,.4)}
html[data-device="phone"] .gllabels span{font-size:.52rem;padding:1px 6px 1px 5px;max-width:46vw;overflow:hidden;text-overflow:ellipsis}
html[data-device="phone"] .gllabels span:nth-child(n+4){display:none}
#labGL{cursor:grab}
#labGL:active{cursor:grabbing}
.glbar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:8px}
.glbar .tiny{flex:1 1 170px;min-width:0}

/* ---- Lite: không blur / không shadow nhưng vẫn sắc nét, đẹp ---- */
html[data-gfx="lite"] .seg{border:1px solid var(--border2);background:var(--surface3)}
html[data-gfx="lite"] .seg button{border:1px solid transparent;border-radius:9px;
  background:linear-gradient(180deg,var(--surface2),var(--surface3));color:var(--text2)}
html[data-gfx="lite"] .seg button.on{border-color:var(--accent);color:var(--accent);
  background:linear-gradient(180deg,rgba(61,220,151,.16),rgba(61,220,151,.06))}
html[data-gfx="lite"] .btn{border:1px solid var(--border2);
  background:linear-gradient(180deg,var(--surface2),var(--surface3))}
html[data-gfx="lite"] .btn.pri{border-color:var(--accent);
  background:linear-gradient(180deg,#2fae7c,#1c7f5b);color:#fff}
html[data-gfx="lite"] .lctrl{border:1px solid var(--border2);
  background:linear-gradient(180deg,var(--surface2),var(--surface3))}
html[data-gfx="lite"] .card{border:1px solid var(--border2)}
html[data-gfx="lite"] .metric{border:1px solid var(--border2);
  background:linear-gradient(180deg,var(--surface2),var(--surface3))}
html[data-gfx="lite"] input[type=range]{accent-color:var(--accent);height:6px}
html[data-gfx="lite"] .labhud{border:1px solid var(--lab-a,var(--accent))}
html[data-gfx="lite"] .scrollx>*{border:1px solid var(--border2)}

/* ============================================================
   v5.9 · GIẢI THÍCH SIÊU DỄ + HỌC TỪ SỐ 0
   ============================================================ */
.easyl{margin-top:9px;border-radius:12px;border:1px solid rgba(56,189,248,.32);
  background:linear-gradient(160deg,rgba(56,189,248,.10),rgba(139,124,246,.06));padding:10px 11px}
.easyl .eh{font-size:.7rem;font-weight:800;color:var(--accent2);letter-spacing:.03em;margin-bottom:7px}
.easyl .eb{font-size:.7rem;line-height:1.68;color:var(--text2);padding:5px 0;border-top:1px dashed var(--border)}
.easyl .eb:first-of-type{border-top:0;padding-top:0}
.easyl .eb b{color:var(--text)}
.easyl .eg{margin-top:6px;font-size:.62rem;line-height:1.7;color:var(--text3)}
.gt{border-bottom:1px dotted var(--accent2);cursor:help;color:var(--accent2)}
.easyl .ew{margin:3px 0 3px 8px;font-size:.67rem;color:var(--text2)}
.learncard{border:1px solid var(--border);border-radius:14px;background:var(--surface2);
  padding:11px 12px;margin-bottom:9px}
.learncard h4{margin:0 0 6px;font-size:.78rem;color:var(--accent)}
.learncard .lb{font-size:.72rem;line-height:1.72;color:var(--text2);margin:5px 0}
.learncard .lb b{color:var(--text)}
.learncard .quiz{margin-top:8px;border-top:1px dashed var(--border2);padding-top:8px}
.learncard .quiz button{display:block;width:100%;text-align:left;margin:4px 0;padding:7px 9px;
  border-radius:9px;border:1px solid var(--border2);background:var(--surface3);color:var(--text);
  font-size:.69rem;cursor:pointer;line-height:1.55}
.learncard .quiz button:hover{border-color:var(--accent)}
html[data-gfx="lite"] .easyl{background:linear-gradient(180deg,var(--surface2),var(--surface3));
  border-color:var(--border2)}
html[data-gfx="lite"] .learncard{background:linear-gradient(180deg,var(--surface2),var(--surface3))}

/* ============================================================
   v5.10 · GIA SƯ AI — giảng lại, chẩn đoán, kế hoạch tự học
   ============================================================ */
.ttabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:11px}
.ttabs button{flex:1 1 100px;padding:8px 9px;border-radius:11px;border:1px solid var(--border);
  background:var(--surface2);color:var(--text2);font-size:.68rem;font-weight:700;cursor:pointer}
.ttabs button.on{border-color:var(--accent2);color:var(--accent2);background:rgba(56,189,248,.09)}
.ttopic{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.ttopic button{padding:5px 10px;border-radius:99px;border:1px solid var(--border2);
  background:var(--surface3);color:var(--text2);font-size:.64rem;cursor:pointer}
.ttopic button.on{border-color:var(--accent);color:var(--accent);background:rgba(61,220,151,.10)}
.tprompt{border-left:3px solid var(--accent2);background:rgba(56,189,248,.07);
  border-radius:0 11px 11px 0;padding:9px 11px;font-size:.72rem;line-height:1.65;color:var(--text2);margin-bottom:9px}
.tarea{width:100%;min-height:130px;resize:vertical;border-radius:11px;border:1px solid var(--border2);
  background:var(--surface3);color:var(--text);padding:10px 11px;font-size:.74rem;line-height:1.65}
.tscore{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:9px}
.tring{width:74px;height:74px;border-radius:50%;flex:0 0 auto;display:grid;place-items:center;
  background:conic-gradient(var(--ok) calc(var(--p)*1%),var(--surface3) 0);position:relative}
.tring::after{content:'';position:absolute;inset:7px;border-radius:50%;background:var(--surface)}
.tring b{position:relative;z-index:1;font-family:'JetBrains Mono',monospace;font-size:1.05rem;color:var(--text)}
.tverdict{flex:1;min-width:150px}
.tverdict .b{font-size:.86rem}
.tlist{margin-top:8px}
.titem{display:flex;gap:8px;align-items:flex-start;padding:6px 8px;border-radius:9px;
  background:var(--surface3);font-size:.69rem;line-height:1.6;color:var(--text2);margin-bottom:5px}
.titem i{flex:0 0 auto;font-style:normal}
.titem.miss{border-left:3px solid var(--warn)}
.titem.bad{border-left:3px solid var(--bad)}
.titem.ok{border-left:3px solid var(--ok)}
.tplan{border:1px solid var(--border);border-radius:13px;padding:10px 11px;margin-bottom:8px;background:var(--surface2)}
.tplan h4{margin:0 0 5px;font-size:.74rem;color:var(--accent)}
.tstep{display:flex;gap:8px;align-items:flex-start;font-size:.69rem;line-height:1.6;
  color:var(--text2);padding:4px 0;border-top:1px dashed var(--border)}
.tstep:first-of-type{border-top:0}
.tstep .n{flex:0 0 18px;height:18px;border-radius:6px;background:var(--surface3);
  display:grid;place-items:center;font-family:'JetBrains Mono',monospace;font-size:.56rem;color:var(--accent2)}
.tbadge{display:inline-block;padding:2px 8px;border-radius:99px;font-size:.56rem;font-weight:700;
  border:1px solid var(--border2);color:var(--text3);margin-left:6px}
.tbadge.ai{color:#a78bfa;border-color:rgba(167,139,250,.5)}
.tbadge.local{color:var(--ok);border-color:rgba(61,220,151,.4)}
.tcfg{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.tcfg label{font-size:.62rem;color:var(--text3);display:block;margin-bottom:3px}
.tcfg input{width:100%;padding:7px 9px;border-radius:9px;border:1px solid var(--border2);
  background:var(--surface3);color:var(--text);font-size:.68rem}
.tcfg .full{grid-column:1/-1}
.tnote{font-size:.62rem;line-height:1.7;color:var(--text3);border-top:1px dashed var(--border2);
  margin-top:10px;padding-top:8px}
.tnote b{color:var(--warn)}
.thist{font-size:.66rem;color:var(--text2);line-height:1.7}
.thist div+div{border-top:1px dashed var(--border);margin-top:4px;padding-top:4px}
.treteach{border:1px solid var(--border2);border-radius:13px;padding:11px 12px;margin-bottom:9px;
  background:linear-gradient(160deg,rgba(56,189,248,.08),rgba(139,124,246,.05))}
.treteach .rb{font-size:.72rem;line-height:1.72;color:var(--text2);margin:5px 0}
.treteach .rb b{color:var(--text)}
@media(max-width:520px){.tcfg{grid-template-columns:1fr}.ttabs button{flex:1 1 45%}}

/* ---- v5.11 · bằng chứng chấm điểm + lớp giải thích phổ quát ---- */
.tev{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--text3);
  display:block;margin-top:3px;padding:3px 6px;background:rgba(0,0,0,.18);border-radius:6px}
.tfix{display:inline-block;margin-left:6px;font-size:.58rem;color:var(--ok);cursor:pointer;
  border:1px solid var(--border2);border-radius:7px;padding:1px 6px;background:var(--surface2)}
.tfix:hover{border-color:var(--ok)}
.tcorr{border-left:3px solid var(--ok)}
.easyhost{margin-top:8px}
.efold>summary{cursor:pointer;font-size:.66rem;font-weight:800;color:var(--accent2);
  padding:6px 9px;border-radius:9px;background:rgba(56,189,248,.08);border:1px solid rgba(56,189,248,.24);
  list-style:none}
.efold>summary::-webkit-details-marker{display:none}
.efold[open]>summary{border-radius:9px 9px 0 0}
.efold .easyl{margin-top:0;border-top:0;border-radius:0 0 12px 12px}
.mastery{display:grid;gap:5px;margin:8px 0}
.mrow{display:grid;grid-template-columns:96px 1fr 34px;gap:7px;align-items:center;font-size:.63rem;color:var(--text2)}
.mbar{height:8px;border-radius:99px;background:var(--surface3);overflow:hidden}
.mbar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent2),var(--ok))}
.mrow b{font-family:'JetBrains Mono',monospace;text-align:right;color:var(--text)}
.day7{display:grid;grid-template-columns:repeat(auto-fit,minmax(84px,1fr));gap:6px;margin-top:8px}
.day7 label{display:flex;gap:5px;align-items:flex-start;font-size:.62rem;line-height:1.45;color:var(--text2);
  border:1px solid var(--border);border-radius:9px;padding:6px;background:var(--surface2);cursor:pointer}
.day7 input{accent-color:var(--accent);margin-top:1px}
.day7 label.done{opacity:.55;text-decoration:line-through}
/* ---- làm đẹp nhẹ ---- */
.qcard,.wcard,.learncard,.tplan{border-left:2px solid transparent;transition:border-color .2s,transform .2s}
.qcard:hover,.wcard:hover,.learncard:hover,.tplan:hover{border-left-color:var(--accent2)}
@media (hover:hover) and (pointer:fine){.qcard:hover,.wcard:hover{transform:translateY(-1px)}}
.topbar{box-shadow:inset 0 -1px 0 rgba(0,243,255,.10),0 6px 24px -20px rgba(0,0,0,.9)}
.modal .box{background:linear-gradient(165deg,var(--surface),var(--surface2))}
.modal .box::before{content:'';position:absolute;inset:0 0 auto;height:2px;pointer-events:none;
  background:linear-gradient(90deg,var(--nx-cyan),#7cf0b4,var(--nebula,#8b7cf6));opacity:.75}
.modal .box{position:relative}
input:focus,textarea:focus,select:focus{outline:2px solid rgba(0,243,255,.18);outline-offset:1px}
.sec i{filter:drop-shadow(0 0 7px rgba(0,243,255,.35))}
html[data-gfx="lite"] .qcard,html[data-gfx="lite"] .wcard{border-left:2px solid var(--border2)}
.fcard .back .efold{max-height:104px;overflow:auto}
.fcard .back .easyl{font-size:.64rem}
</style>
