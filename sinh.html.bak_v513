const TRAPS = [
  { t: 'Chiều 5′→3′ bị đảo', d: 'Mọi mạch mới (DNA, RNA) đều tổng hợp <b>5′→3′</b>. Khi đề hỏi "chiều mạch khuôn" thì trả lời 3′→5′. Đọc bộ ba trên mạch gốc mà không đổi sang mRNA là bẫy phổ biến nhất.' },
  { t: 'Quên trừ bộ gen mẹ', d: 'Nhân đôi k lần cho 2^k DNA nhưng môi trường chỉ cung cấp <b>N(2^k − 1)</b>. Chọn 2^k·N là sai ngay.' },
  { t: 'Nhầm thoái hóa với đặc hiệu', d: '<b>Thoái hóa</b> = nhiều codon → 1 acid amin. <b>Đặc hiệu</b> = 1 codon → 1 acid amin. Hai chiều khác nhau, đề rất hay tráo.' },
  { t: 'Đếm cả acid amin mở đầu', d: '"Chuỗi polypeptide hoàn chỉnh" đã cắt Met ⇒ số aa = số codon − 2. Nếu đề nói "chuỗi do gene quy định tổng hợp" thì thường tính cả Met.' },
  { t: 'Tần số allele ≠ tần số kiểu gene', d: 'Tự thụ phấn <b>không</b> đổi tần số allele, chỉ đổi tần số kiểu gene. Mọi đáp án nói "tần số allele tăng/giảm" trong quần thể tự thụ đều sai.' },
  { t: 'Mức phản ứng ≠ giá trị lớn nhất', d: 'Mức phản ứng là <b>biên độ</b> max − min, không phải giá trị max. Giống có max cao chưa chắc có mức phản ứng rộng.' },
  { t: 'Thường biến không di truyền', d: 'Nếu kiểu hình khác nhau nhưng kiểu gene không đổi ⇒ thường biến. Nếu con khác mẹ ngay trong cùng môi trường (lá khảm, hoa khác màu) ⇒ đột biến.' },
  { t: 'Ưu trương làm tế bào mất nước', d: 'Ưu trương = nồng độ chất tan <b>cao hơn</b> trong tế bào ⇒ nước đi RA ⇒ co nguyên sinh / hồng cầu co rúm. Nhược trương mới làm căng và vỡ.' },
  { t: 'Nhân sơ khác nhân thực ở đâu', d: 'Khác ở: có màng nhân, gene phân mảnh, nhiều đơn vị nhân đôi, ba loại RNA polymerase. <b>Không</b> khác ở chiều tổng hợp hay nguyên tắc bổ sung.' },
  { t: 'Enzyme nào làm gì', d: 'Helicase mở xoắn (phá liên kết H). Ligase nối phosphodiester. Primase làm mồi. Polymerase kéo dài. Đề hay gán "helicase phá liên kết phosphodiester" — sai.' },
  { t: 'Hô hấp sáng chỉ ở C3', d: 'Rubisco của C3 gắn O₂ khi CO₂ thấp ⇒ hô hấp sáng, mất năng lượng. C4 và CAM có cơ chế tập trung CO₂ nên gần như không có.' },
  { t: 'Di truyền ti thể không tuyệt đối', d: 'Bệnh ti thể đi theo dòng mẹ nhưng do <b>dị tương đồng</b>, con có thể không bệnh. Đừng chọn “tất cả con đều bệnh”.' }
];

const DRILLS = [
  { q: 'Đề cho: "gene có 3000 nucleotide, nhân đôi 3 lần, môi trường chỉ có N¹⁵". Hướng xử lý ĐÚNG là:',
    o: [
      { t: 'Tính 3000 × 8 = 24000 nucleotide môi trường', s: 0, w: 'Sai: quên trừ bộ gen mẹ. Môi trường chỉ cấp 3000 × (8 − 1) = 21000.' },
      { t: 'Xác định 2 DNA còn mạch gốc N¹⁴, 6 DNA mới hoàn toàn N¹⁵', s: 1, w: 'Đúng: bán bảo toàn giữ lại 2 mạch gốc, nên chỉ 6 phân tử là “hoàn toàn mới”.' },
      { t: 'Coi cả 8 DNA đều mang N¹⁵ hoàn toàn', s: 0, w: 'Sai: 2 phân tử vẫn giữ một mạch N¹⁴ của mẹ.' }
    ] },
  { q: 'Đề cho mạch gốc 5′AGC CGA CCC GGG 3′ và bảng codon, hỏi trình tự polypeptide. Bước đầu tiên nên làm:',
    o: [
      { t: 'Tra bảng codon trực tiếp trên mạch gốc', s: 0, w: 'Sai: bảng codon dùng cho mRNA, không dùng cho mạch gốc.' },
      { t: 'Viết mRNA đối song (bổ sung + đảo chiều) rồi mới tra', s: 1, w: 'Đúng: mRNA = 3′UCG GCU GGG CCC 5′ ⇒ viết lại 5′CCC GGG UCG GCU 3′ rồi tra.' },
      { t: 'Đảo ngược mạch gốc rồi tra luôn', s: 0, w: 'Sai: đảo chiều mà không bổ sung base sẽ ra trình tự sai.' }
    ] },
  { q: 'Đề cho bảng số liệu: khối lượng hạt max/min của 4 giống, hỏi "giống nào có mức phản ứng rộng nhất". Bạn làm gì?',
    o: [
      { t: 'Chọn giống có giá trị max lớn nhất', s: 0, w: 'Sai: mức phản ứng là biên độ, không phải giá trị tuyệt đối.' },
      { t: 'Tính max − min cho từng giống rồi so sánh', s: 1, w: 'Đúng: mức phản ứng = độ rộng dao động kiểu hình của cùng kiểu gene.' },
      { t: 'Tính trung bình cộng của max và min', s: 0, w: 'Sai: trung bình phản ánh giá trị điển hình, không phải độ dẻo.' }
    ] },
  { q: 'Đề cho tỉ lệ đời con 59% : 41% ở một phép lai hai tính. Kết luận hợp lý nhất:',
    o: [
      { t: 'Phân ly độc lập vì xấp xỉ 1 : 1', s: 0, w: 'Sai: phân ly độc lập cho 1:1:1:1 hoặc 9:3:3:1, không cho 59:41 một kiểu hình.' },
      { t: 'Hai gene liên kết và có hoán vị, tỉ lệ lệch khỏi 1:1', s: 1, w: 'Đúng: lệch 1:1 có hệ thống là dấu hiệu liên kết gene với tần số hoán vị xác định.' },
      { t: 'Có đột biến làm chết 18% hợp tử', s: 0, w: 'Chỉ nghĩ tới khi tổng tỉ lệ không khớp 100% hoặc có dữ kiện về sức sống.' }
    ] },
  { q: 'Đề hỏi "có bao nhiêu nhận định ĐÚNG" với 5 nhận định. Chiến lược tối ưu:',
    o: [
      { t: 'Đọc lần lượt, đánh dấu Đ/S từng cái rồi đếm', s: 1, w: 'Đúng: đây là dạng đếm, phải xét độc lập từng nhận định, không suy ra từ nhận định trước.' },
      { t: 'Tìm nhận định chắc chắn sai để loại đáp án', s: 0, w: 'Có ích nhưng không đủ: nhiều nhận định "gần đúng" chỉ sai một chữ, dễ loại nhầm.' },
      { t: 'Chọn đáp án giữa (2 hoặc 3) vì xác suất cao', s: 0, w: 'Đây là đoán mò, không phải tư duy.' }
    ] },
  { q: 'Một câu hỏi về operon lac cho bảng biểu hiện enzyme ở 2 môi trường. Cách đọc bảng đúng:',
    o: [
      { t: 'So sánh từng chủng với nhau trước', s: 0, w: 'Sai hướng: phải so với kiểu dãy để biết chủng nào “mất kiểm soát”.' },
      { t: 'Với mỗi chủng, so sánh có/không lactose để biết còn cảm ứng; rồi so với dãy để biết gene nào hỏng', s: 1, w: 'Đúng: hai trục so sánh — trục dọc (cảm ứng) và trục ngang (so với kiểu dãy).' },
      { t: 'Chỉ cần nhìn cột "có lactose" là đủ', s: 0, w: 'Sai: mất khả năng cảm ứng chỉ lộ ra khi so với môi trường không có lactose.' }
    ] },
  { q: 'Đề cho 2n = 24 và hỏi thể tam bội. Bạn tính thế nào?',
    o: [
      { t: '24 × 3 = 72', s: 0, w: 'Sai: phải đổi ra n trước. n = 12 nên 3n = 36.' },
      { t: 'n = 24/2 = 12 ⇒ 3n = 36', s: 1, w: 'Đúng: luôn quy về n rồi mới nhân bội số.' },
      { t: '24 + 12 = 36 nhưng vì lý do khác', s: 0, w: 'Kết quả đúng nhưng lập luận sai — sẽ sai ngay với thể tứ bội.' }
    ] },
  { q: 'Câu hỏi về thí nghiệm: "4 bình kín, hạt nhú mầm / hạt khô / hạt luộc". Cần xác định biến nào?',
    o: [
      { t: 'Xác định biến độc lập (trạng thái hạt) và biến phụ thuộc (O₂, nhiệt độ)', s: 1, w: 'Đúng: hạt nhú mầm hô hấp mạnh, hạt khô yếu, hạt luộc chết — đó là biến độc lập cần so sánh.' },
      { t: 'Chỉ cần biết bình nào nhiều hạt nhất', s: 0, w: 'Sai: khối lượng khác nhau nhưng đó không phải biến được thiết kế để so sánh.' },
      { t: 'Đoán theo cảm giác bình nào “chắc sẽ nóng hơn”', s: 0, w: 'Sai: phải dựa trên cơ chế hô hấp tỏa nhiệt.' }
    ] }
];


/* ---------- LAB STATE MACHINE ---------- */
let labIdx = 0, labT = 0, labCv = null, labCtx = null, labRaf = null, labFrame = 0;
let labDefaults = null;

function updateLabWhy() {
  const l = LABS[labIdx], x = LABX[labIdx];
  const box = $('#labWhy');
  if (!box || !x) return;
  let html = '';
  try { html = x.why(l.v); } catch (e) { html = ''; }
  box.innerHTML = '<div class="h"><i class="fa-solid fa-circle-nodes"></i>Vì sao lại như vậy?</div><div class="b">' + html + '</div>';
  box.classList.remove('tone-warn', 'tone-bad');
}
/* v5.1 — gộp cập nhật giải thích vào 1 khung hình, tránh innerHTML mỗi lần kéo slider */
const __updateLabWhy51 = updateLabWhy;
let __whyPending51 = false;
updateLabWhy = function () {
  if (__whyPending51) return;
  __whyPending51 = true;
  requestAnimationFrame(function () {
    __whyPending51 = false;
    try { __updateLabWhy51(); } catch (e) { }
  });
};

function resetLab() {
  const l = LABS[labIdx];
  if (!labDefaults) return;
  Object.keys(labDefaults[labIdx] || {}).forEach(k => { l.v[k] = labDefaults[labIdx][k]; });
  renderLabMeta();
  updateLabWhy();
  beep(430, .04);
}

function renderLabMeta() {
  const l = LABS[labIdx], x = LABX[labIdx] || {};
  $('#labTitle').textContent = `LAB ${String(labIdx + 1).padStart(2, '0')} • ${l.name}`;
  $('#labSub').textContent = l.sub;
  $('#labTags').innerHTML = l.tags.map(t => `<span class="pill">${t}</span>`).join('');

  /* v5.7 — mỗi thí nghiệm một màu nhận diện (viền góc + HUD) */
  try {
    const view = document.getElementById('view-lab');
    if (view) view.style.setProperty('--lab-a', LAB_ACCENTS[labIdx % LAB_ACCENTS.length]);
    const stage = document.querySelector('#view-lab .labstage');
    if (stage) stage.style.setProperty('--lab-a', LAB_ACCENTS[labIdx % LAB_ACCENTS.length]);
  } catch (e) { }

  // goal
  const goal = $('#labGoal');
  if (goal) goal.innerHTML = `<i class="fa-solid fa-bullseye"></i><div><span class="t">Mục tiêu</span><p>${x.goal || l.sub}</p></div>`;

  // steps
  const stp = $('#labSteps');
  if (stp) stp.innerHTML = (x.steps || []).map(s => `<li>${s}</li>`).join('');

  // note
  $('#labNote').innerHTML = `<span class="tip"><i class="fa-solid fa-lightbulb"></i> Bản chất</span>${l.note}`;

  // controls
  $('#labControls').innerHTML = l.controls.map(ct => {
    if (ct.type === 'seg') {
      return `<div class="card lctrl">
        <div class="xs b" style="margin-bottom:6px">${ct.label}</div>
        <div class="seg">${ct.opts.map(([val, lab]) => `<button class="${l.v[ct.k] == val ? 'on' : ''}"
          onclick="labSet('${ct.k}', ${typeof val === 'string' ? `'${val}'` : val}, this)">${lab}</button>`).join('')}</div>
      </div>`;
    }
    return `<div class="card lctrl">
      <div class="between xs b"><span>${ct.label}</span>
        <span class="mono" style="color:var(--accent)" id="lv_${ct.k}">${l.v[ct.k]}${ct.unit || ''}</span></div>
      <input type="range" min="${ct.min}" max="${ct.max}" step="${ct.step}" value="${l.v[ct.k]}"
        oninput="labSet('${ct.k}', this.value)">
    </div>`;
  }).join('');

  // readouts as metric cards
  $('#labReadouts').innerHTML = l.readouts.map(([k, label]) => `
    <div class="metric"><span class="lbl">${label}</span><span class="val" id="ro_${k}">—</span></div>`).join('');

  updateLabWhy();
}

/* ---------- TƯ DUY ---------- */
let drillPicked = {};

function renderThink() {
  const f = $('#thinkFrames');
  if (f) f.innerHTML = FRAMES.map((x, i) => `
    <div class="tcard">
      <div class="tcard-h">
        <div class="n">${i + 1}</div>
        <div style="min-width:0"><div class="k">${x.k}</div><h4>${x.t}</h4></div>
      </div>
      <div class="tcard-b"><div class="tiny" style="font-size:.76rem;line-height:1.62">${x.d}</div></div>
    </div>`).join('');

  const fb = $('#formulaBox');
  if (fb) fb.innerHTML = FORMULAS.map(g => `
    <div class="fgroup">
      <div class="gh">${g.g}</div>
      ${g.rows.map(([k, v, n]) => `<div class="frow"><span class="fk">${k}</span><span class="fv">${v}</span><span class="fn">${n}</span></div>`).join('')}
    </div>`).join('');

  const tb = $('#trapBox');
  if (tb) tb.innerHTML = TRAPS.map(t => `
    <div class="trapitem"><i class="fa-solid fa-triangle-exclamation ic"></i><div class="tx"><b>${t.t}.</b> ${t.d}</div></div>`).join('');

  const db = $('#thinkDrills');
  if (db) db.innerHTML = DRILLS.map((d, i) => `
    <div class="tcard">
      <div class="tcard-h">
        <div class="n" style="background:var(--ink-violet);color:var(--violet);border:1px solid rgba(139,124,246,.3)">${i + 1}</div>
        <div style="min-width:0"><div class="k">Drill</div><h4 style="font-weight:700;font-size:.82rem">${d.q}</h4></div>
      </div>
      <div class="tcard-b">
        <div class="stack" style="gap:5px">
          ${d.o.map((o, j) => `<button class="opt" id="dr${i}_${j}" onclick="pickDrill(${i},${j})">
            <span class="k">${'ABC'[j]}</span><span>${o.t}</span></button>`).join('')}
        </div>
        <div class="whybox" id="drw${i}" style="display:none;margin-top:7px"></div>
      </div>
    </div>`).join('');

  const set = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  set('tkFrame', FRAMES.length);
  set('tkTrap', TRAPS.length);
  set('tkFormula', FORMULAS.reduce((s, g) => s + g.rows.length, 0));
}

function pickDrill(i, j) {
  const d = DRILLS[i], chosen = d.o[j];
  drillPicked[i] = j;
  d.o.forEach((o, k) => {
    const el = document.getElementById(`dr${i}_${k}`);
    if (!el) return;
    el.classList.remove('sel', 'ok', 'bad');
    if (k === j) el.classList.add(chosen.s ? 'ok' : 'bad');
    else if (o.s) el.classList.add('ok');
  });
  const w = document.getElementById('drw' + i);
  if (w) {
    w.style.display = '';
    w.classList.toggle('tone-bad', !chosen.s);
    w.classList.toggle('tone-warn', false);
    w.innerHTML = `<div class="h"><i class="fa-solid fa-${chosen.s ? 'check' : 'xmark'}"></i>${chosen.s ? 'Chính xác' : 'Chưa đúng hướng'}</div><div class="b">${chosen.w}</div>`;
  }
  beep(chosen.s ? 780 : 300, .05);
}

function ro(k, v, col) {
  const el = document.getElementById('ro_' + k);
  if (!el) return;
  if (el.textContent !== v) el.textContent = v;
  if (col) el.style.color = col;
}

function renderLabPicker() {
  $('#labPicker').innerHTML = LABS.map((l, i) => `
    <button class="chip ${i === labIdx ? 'on' : ''}" onclick="selectLab(${i})" id="labchip${i}">
      <i class="fa-solid ${l.icon}"></i> ${l.short}
    </button>`).join('');
}
function selectLab(i) {
  labIdx = i;
  $$('#labPicker .chip').forEach((c, j) => c.classList.toggle('on', j === i));
  renderLabMeta();
  beep(580, .035);
}
function labSet(k, val, btn) {
  const l = LABS[labIdx];
  l.v[k] = isNaN(+val) ? val : +val;
  const lab = document.getElementById('lv_' + k);
  const ct = l.controls.find(c => c.k === k);
  if (lab && ct) lab.textContent = l.v[k] + (ct.unit || '');
  if (btn) { [...btn.parentElement.children].forEach(b => b.classList.remove('on')); btn.classList.add('on'); }
  updateLabWhy();
  beep(500, .02);
}
function resizeLab() {
  if (!labCv) return;
  const wrap = labCv.parentElement;
  const r = wrap.getBoundingClientRect();
  if (!r.width) return;
  const __dev = (typeof BG4_DEVICE !== 'undefined' && BG4_DEVICE.current && BG4_DEVICE.current()) || null;
  const __cap = __dev && __dev.type === 'phone' ? 1.5 : 2;
  const dpr = Math.min(window.devicePixelRatio || 1, __cap);
  labCv.width = Math.round(r.width * dpr);
  labCv.height = Math.round(r.height * dpr);
  labCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  labCv._w = r.width; labCv._h = r.height;
  if (typeof BG4_GL !== 'undefined') BG4_GL.resize(r.width, r.height);
}
function labLoop(ts) {
  if (currentView !== 'lab' || !labCtx) return;
  if (typeof FPS !== 'undefined' && FPS.limit === 30) { FPS.t = (FPS.t || 0) + 1; if (FPS.t % 2) return; }
  const w = labCv._w, h = labCv._h;
  if (!w || !h) return;
  labT = ts / 1000;
  labFrame++;
  const glOn = typeof BG4_GL !== 'undefined' && BG4_GL.active() && BG4_GL.ready;
  if (!glOn) {
    labCtx.clearRect(0, 0, w, h);
    try { LABS[labIdx].draw(labCtx, w, h, labT); } catch (e) { console.warn(e); }
    labAtmosphere(labCtx, w, h, labT);
  }
  if (typeof BG4_GL !== 'undefined') BG4_GL.frame(labT);
}
/* =========================================================
   12. KHỞI CHẠY
   ========================================================= */
/* =========================================================
   v2.0 — 3 THÍ NGHIỆM MỚI (21 · 22 · 23)
   Đẩy vào LABS + LABX sau khi mảng gốc đã dựng xong.
   ========================================================= */

/* ---------- 21. CHỌN LỌC TỰ NHIÊN — BISTON BETULARIA ---------- */
LABS.push({
  icon: 'fa-bug', name: 'Chọn lọc tự nhiên — bướm Biston', short: 'Biston betularia',
  sub: 'Vì sao bướm đen tăng vọt ở vùng công nghiệp nước Anh thế kỷ 19?',
  tags: ['Tiến hóa', 'CLTN'],
  note: 'Bướm <b>Biston betularia</b> có hai dạng: trắng đốm (điển hình) và đen (carbonaria). Trên nền cây phủ địa y sáng, bướm đen <b>dễ bị chim ăn</b> vì tương phản; trên nền bồ hóng công nghiệp thì ngược lại. Chọn lọc không tạo ra allele mới — nó chỉ <b>đổi tần số allele đã có</b>. Đây là bằng chứng thực nghiệm kinh điển của CLTN.',
  v: { dark: 10, bg: 0, sel: 60 },
  controls: [
    { type: 'range', k: 'dark', label: 'Tỉ lệ bướm đen ban đầu', min: 0, max: 100, step: 5, unit: '%' },
    { type: 'seg', k: 'bg', label: 'Màu nền môi trường', opts: [[0, 'Nền sáng (địa y)'], [1, 'Nền tối (bồ hóng)']] },
    { type: 'range', k: 'sel', label: 'Áp lực chọn lọc', min: 0, max: 100, step: 5, unit: '%' }
  ],
  readouts: [['gen', 'Thế hệ'], ['darkp', '% bướm đen'], ['chg', 'Biến đổi'], ['kl', 'Kết luận']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    const f0 = v.dark / 100;
    const sCoef = (v.sel / 100) * 0.5;
    const wD = v.bg === 1 ? 1 : 1 - sCoef;
    const wL = v.bg === 1 ? 1 - sCoef : 1;
    const GEN = 20;
    const curve = [f0];
    for (let i = 0; i < GEN; i++) {
      const f = curve[i];
      const den = f * wD + (1 - f) * wL;
      curve.push(den > 0 ? (f * wD) / den : f);
    }
    const gen = Math.min(GEN, Math.floor((t * 0.9) % (GEN + 1)));
    const f = curve[gen];

    /* ---- thân cây ---- */
    const bx = w * .045, by = h * .13, bw = w * .50, bh = h * .74;
    const light = v.bg === 0;
    const g = c.createLinearGradient(bx, by, bx + bw, by + bh);
    g.addColorStop(0, light ? '#cfc9b6' : '#2c3138');
    g.addColorStop(.5, light ? '#bcb6a1' : '#23272e');
    g.addColorStop(1, light ? '#a49e8b' : '#191d23');
    rr(c, bx, by, bw, bh, 10); c.fillStyle = g; c.fill();
    c.strokeStyle = p.line; c.lineWidth = 1.5; c.stroke();

    // vân / địa y
    for (let i = 0; i < 26; i++) {
      const rnd1 = Math.sin(i * 51.3) * 43758.5453;
      const r1 = rnd1 - Math.floor(rnd1);
      const rnd2 = Math.sin(i * 97.1 + 7) * 43758.5453;
      const r2 = rnd2 - Math.floor(rnd2);
      const x = bx + 8 + r1 * (bw - 16), y = by + 8 + r2 * (bh - 16);
      c.globalAlpha = light ? .5 : .35;
      c.fillStyle = light ? '#f2efe4' : '#3d434c';
      c.beginPath(); c.ellipse(x, y, 7 + r1 * 10, 4 + r2 * 6, r1 * 3, 0, 6.283); c.fill();
      c.globalAlpha = 1;
    }

    /* ---- bướm ---- */
    function moth(x, y, s, dark, flap) {
      const wc = dark ? '#15161c' : '#f7f4e9';
      const wc2 = dark ? '#31333d' : '#ddd7c6';
      const edge = dark ? 'rgba(220,230,245,.30)' : 'rgba(58,52,40,.55)';
      c.save(); c.translate(x, y); c.rotate(Math.sin(x * 3.1) * .22);
      c.strokeStyle = edge; c.lineWidth = 1;
      c.fillStyle = wc;
      c.beginPath(); c.ellipse(-s * .58, -s * .22 - flap * s * .26, s * .64, s * .44, -.5, 0, 6.283); c.fill(); c.stroke();
      c.beginPath(); c.ellipse(s * .58, -s * .22 - flap * s * .26, s * .64, s * .44, .5, 0, 6.283); c.fill(); c.stroke();
      c.fillStyle = wc2;
      c.beginPath(); c.ellipse(-s * .50, s * .32, s * .48, s * .33, .62, 0, 6.283); c.fill(); c.stroke();
      c.beginPath(); c.ellipse(s * .50, s * .32, s * .48, s * .33, -.62, 0, 6.283); c.fill(); c.stroke();
      c.fillStyle = dark ? 'rgba(200,215,240,.42)' : 'rgba(45,45,58,.5)';
      c.beginPath(); c.arc(-s * .58, -s * .28, s * .14, 0, 6.283); c.fill();
      c.beginPath(); c.arc(s * .58, -s * .28, s * .14, 0, 6.283); c.fill();
      c.strokeStyle = dark ? '#0d0e12' : '#6d6757'; c.lineWidth = s * .2; c.lineCap = 'round';
      c.beginPath(); c.moveTo(0, -s * .5); c.lineTo(0, s * .58); c.stroke();
      c.restore();
    }

    const N = 18;
    for (let i = 0; i < N; i++) {
      const isDark = i / N < f;
      const rr1 = Math.sin(i * 91.7 + 13.3) * 43758.5453;
      const rr2 = Math.sin(i * 33.1 + 71.9) * 43758.5453;
      const x = bx + 16 + (rr1 - Math.floor(rr1)) * (bw - 32);
      const y = by + 16 + (rr2 - Math.floor(rr2)) * (bh - 32);
      moth(x, y, 12, isDark, Math.sin(t * 5 + i * .7));
    }

    chipText(c, light ? 'NỀN SÁNG — địa y' : 'NỀN TỐI — bồ hóng', bx + bw / 2, by - 9,
      { color: light ? 'var(--warn)' : 'var(--accent2)', size: 9, align: 'center' });

    /* ---- đồ thị ---- */
    const qx0 = w * .61, qx1 = w * .96, qy0 = h * .17, qy1 = h * .70;
    c.strokeStyle = p.line; c.lineWidth = 1.2;
    c.beginPath(); c.moveTo(qx0, qy0 - 4); c.lineTo(qx0, qy1); c.lineTo(qx1, qy1); c.stroke();
    const yMax = Math.max(0.15, Math.min(1, f0 * 1.25));
    [0, .5, 1].forEach(function (u) {
      const y = qy1 - u * (qy1 - qy0);
      c.setLineDash([2, 5]); c.strokeStyle = p.line;
      c.beginPath(); c.moveTo(qx0, y); c.lineTo(qx1, y); c.stroke(); c.setLineDash([]);
      tx(c, Math.round(u * yMax * 100) + '%', qx0 - 4, y + 3, { size: 7, color: p.sub, align: 'right' });
    });
    c.beginPath();
    for (let i = 0; i <= gen; i++) {
      const x = qx0 + (i / GEN) * (qx1 - qx0);
      const y = qy1 - Math.min(1, curve[i] / yMax) * (qy1 - qy0);
      i ? c.lineTo(x, y) : c.moveTo(x, y);
    }
    c.strokeStyle = '#fb7185'; c.lineWidth = 2.2; c.lineJoin = 'round'; c.stroke();
    if (gen < GEN) {
      c.beginPath();
      for (let i = gen; i <= GEN; i++) {
        const x = qx0 + (i / GEN) * (qx1 - qx0);
        const y = qy1 - Math.min(1, curve[i] / yMax) * (qy1 - qy0);
        i === gen ? c.moveTo(x, y) : c.lineTo(x, y);
      }
      c.setLineDash([3, 4]); c.strokeStyle = 'rgba(251,113,133,.28)'; c.lineWidth = 1.6; c.stroke();
      c.setLineDash([]);
    }
    const mx = qx0 + (gen / GEN) * (qx1 - qx0), my = qy1 - Math.min(1, f / yMax) * (qy1 - qy0);
    glow(c, mx, my, 16, 'rgba(251,113,133,.45)');
    c.fillStyle = '#fb7185'; c.beginPath(); c.arc(mx, my, 4, 0, 6.283); c.fill();
    tx(c, 'thế hệ →', qx1, qy1 + 14, { size: 8, color: p.sub, align: 'right' });
    tx(c, '% bướm đen', qx0, qy0 - 10, { size: 8.5, color: p.sub });

    const d = (f - f0) * 100;
    ro('gen', String(gen), p.text);
    ro('darkp', Math.round(f * 100) + '%', f > .6 ? 'var(--bad)' : 'var(--accent2)');
    ro('chg', (d >= 0 ? '+' : '') + d.toFixed(0) + '%', d > 1 ? 'var(--bad)' : d < -1 ? 'var(--ok)' : p.sub);
    ro('kl', v.sel === 0 ? 'Không chọn lọc' : v.bg === 1 ? 'Bồ hóng → đen ưu thế' : 'Địa y → trắng ưu thế',
      v.sel === 0 ? p.sub : 'var(--warn)');
  }
});

/* ---------- 22. HARDY–WEINBERG ---------- */
LABS.push({
  icon: 'fa-scale-balanced', name: 'Cân bằng Hardy – Weinberg', short: 'Hardy – Weinberg',
  sub: 'Khi nào tần số allele của quần thể đứng yên qua các thế hệ?',
  tags: ['Tiến hóa', 'Di truyền quần thể'],
  note: 'Quần thể <b>ngẫu phối, không đột biến, không chọn lọc, không di nhập, kích thước lớn</b> sẽ đạt cân bằng chỉ sau <b>một thế hệ</b>: AA = p², Aa = 2pq, aa = q². Tự phối thì tần số allele vẫn giữ nguyên nhưng <b>dị hợp tử giảm một nửa mỗi thế hệ</b>. Chọn lọc chống aa làm q giảm dần nhưng không bao giờ về 0 khi allele lặn còn “ẩn” trong dị hợp.',
  v: { p: 50, mode: 0, s: 0 },
  controls: [
    { type: 'range', k: 'p', label: 'Tần số allele A ban đầu', min: 0, max: 100, step: 5, unit: '%' },
    { type: 'seg', k: 'mode', label: 'Kiểu sinh sản', opts: [[0, 'Ngẫu phối'], [1, 'Tự phối']] },
    { type: 'range', k: 's', label: 'Chọn lọc chống aa (hệ số s)', min: 0, max: 100, step: 5, unit: '%' }
  ],
  readouts: [['gen', 'Thế hệ'], ['aa', 'Tỉ lệ aa'], ['het', 'Dị hợp tử'], ['kl', 'Trạng thái']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    const p0 = v.p / 100, q0 = 1 - p0;
    let st = { AA: p0 * p0, Aa: 2 * p0 * q0, aa: q0 * q0 };
    const S = v.s / 100, MODE = v.mode;
    const hist = [{ AA: st.AA, Aa: st.Aa, aa: st.aa }];
    for (let i = 0; i < 30; i++) {
      let AA = st.AA, Aa = st.Aa, aa = st.aa;
      const waa = 1 - S;
      let tot = AA + Aa + aa * waa;
      if (tot > 0) { AA /= tot; Aa /= tot; aa = (aa * waa) / tot; }
      if (MODE === 1) {
        st = { AA: AA + Aa / 4, Aa: Aa / 2, aa: aa + Aa / 4 };
      } else {
        const qq = aa + Aa / 2, pp = 1 - qq;
        st = { AA: pp * pp, Aa: 2 * pp * qq, aa: qq * qq };
      }
      hist.push({ AA: st.AA, Aa: st.Aa, aa: st.aa });
    }
    const gen = Math.min(30, Math.floor((t * 1.6) % 31));
    const cur = hist[gen];

    /* ---- 3 thanh kiểu gen ---- */
    const bx = w * .07, bw = w * .46, baseY = h * .78, maxH = h * .52;
    const items = [
      { k: 'AA', val: cur.AA, c: 'var(--accent)' },
      { k: 'Aa', val: cur.Aa, c: 'var(--warn)' },
      { k: 'aa', val: cur.aa, c: 'var(--bad)' }
    ];
    const bwid = bw / 3;
    items.forEach(function (it, i) {
      const x = bx + i * bwid + bwid * .12, wd = bwid * .76;
      const hh = Math.max(2, it.val * maxH);
      const gr = c.createLinearGradient(0, baseY - hh, 0, baseY);
      gr.addColorStop(0, col(it.c));
      gr.addColorStop(1, root.dataset.theme === 'light' ? 'rgba(255,255,255,.55)' : 'rgba(10,20,30,.35)');
      rr(c, x, baseY - hh, wd, hh, 6); c.fillStyle = gr; c.fill();
      c.strokeStyle = col(it.c); c.lineWidth = 1.2; c.globalAlpha = .55; c.stroke(); c.globalAlpha = 1;
      tx(c, it.k, x + wd / 2, baseY + 14, { size: 10, color: it.c, align: 'center', weight: 700, mono: true });
      tx(c, Math.round(it.val * 100) + '%', x + wd / 2, baseY - hh - 7, { size: 9, color: p.text, align: 'center', weight: 700 });
    });
    c.strokeStyle = p.line; c.lineWidth = 1.2;
    c.beginPath(); c.moveTo(bx, baseY + 1); c.lineTo(bx + bw, baseY + 1); c.stroke();
    chipText(c, 'Thế hệ ' + gen, bx + bw / 2, baseY + 34, { color: 'var(--accent2)', size: 9, align: 'center' });

    /* ---- đồ thị tần số allele a ---- */
    const qx0 = w * .60, qx1 = w * .96, qy0 = h * .17, qy1 = h * .72;
    c.strokeStyle = p.line; c.lineWidth = 1.2;
    c.beginPath(); c.moveTo(qx0, qy0 - 4); c.lineTo(qx0, qy1); c.lineTo(qx1, qy1); c.stroke();
    [0, .5, 1].forEach(function (u) {
      const y = qy1 - u * (qy1 - qy0);
      c.setLineDash([2, 5]); c.strokeStyle = p.line;
      c.beginPath(); c.moveTo(qx0, y); c.lineTo(qx1, y); c.stroke(); c.setLineDash([]);
      tx(c, Math.round(u * 100) + '%', qx0 - 4, y + 3, { size: 7, color: p.sub, align: 'right' });
    });
    c.beginPath();
    hist.forEach(function (s, i) {
      const qv = s.aa + s.Aa / 2;
      const x = qx0 + (i / 30) * (qx1 - qx0);
      const y = qy1 - qv * (qy1 - qy0);
      i ? c.lineTo(x, y) : c.moveTo(x, y);
    });
    c.strokeStyle = col('var(--accent2)'); c.lineWidth = 2.2; c.lineJoin = 'round'; c.stroke();
    const qNow = cur.aa + cur.Aa / 2;
    const mx = qx0 + (gen / 30) * (qx1 - qx0), my = qy1 - qNow * (qy1 - qy0);
    glow(c, mx, my, 16, 'rgba(56,189,248,.4)');
    c.fillStyle = '#38bdf8'; c.beginPath(); c.arc(mx, my, 4, 0, 6.283); c.fill();
    tx(c, 'tần số a', qx0, qy0 - 10, { size: 8.5, color: p.sub });
    tx(c, 'thế hệ →', qx1, qy1 + 14, { size: 8, color: p.sub, align: 'right' });

    const balanced = Math.abs(qNow - q0) < .01 && MODE === 0 && S === 0;
    ro('gen', String(gen), p.text);
    ro('aa', (cur.aa * 100).toFixed(1) + '%', cur.aa > .3 ? 'var(--bad)' : p.text);
    ro('het', (cur.Aa * 100).toFixed(1) + '%', cur.Aa > .4 ? 'var(--warn)' : p.text);
    ro('kl', balanced ? 'Đang cân bằng' : MODE === 1 ? 'Tự phối: dị hợp giảm' : S > 0 ? 'Chọn lọc: q giảm dần' : 'Chưa cân bằng',
      balanced ? 'var(--ok)' : 'var(--warn)');
  }
});

/* ---------- 23. CÂY PHÁT SINH CHỦNG LOẠI ---------- */
const TREE_DATA = {
  name: 'Tổ tiên chung', info: 'Sinh vật nhân thực đơn bào, xuất hiện cách đây khoảng 2 tỉ năm. Mọi nhánh bên dưới đều tiến hoá từ tổ tiên này — đó là lý do sinh giới dùng chung mã di truyền, ATP và màng phospholipid.',
  children: [
    {
      name: 'Giới Thực vật', info: 'Tế bào có thành cellulose, lục lạp, quang tự dưỡng. Từ tảo lục đa bào → rêu → dương xỉ → thực vật có hạt.',
      children: [
        { name: 'Rêu', info: 'Thực vật lên cạn đầu tiên nhưng chưa có mạch dẫn thật sự, sinh sản nhờ nước, thể giao tử chiếm ưu thế.' },
        { name: 'Dương xỉ', info: 'Đã có mạch dẫn (xylem/phloem) nhưng vẫn sinh sản bằng bào tử, cần nước cho tinh trùng bơi.' },
        { name: 'Hạt trần', info: 'Xuất hiện hạt và ống phấn — giải phóng khỏi sự phụ thuộc vào nước khi sinh sản.' },
        { name: 'Hạt kín', info: 'Thêm hoa và quả: bảo vệ phôi, phát tán nhờ động vật, thụ phấn chuyên hoá — nhóm chiếm ưu thế hiện nay.' }
      ]
    },
    { name: 'Giới Nấm', info: 'Dị dưỡng hấp thụ, thành tế bào chitin, gần gũi động vật hơn thực vật về mặt phân tử.' },
    {
      name: 'Giới Động vật', info: 'Dị dưỡng tiêu hoá, có hệ thần kinh và cơ. Từ đối xứng toả tròn đến đối xứng hai bên, rồi xuất hiện dây sống.',
      children: [
        { name: 'Giun đốt', info: 'Cơ thể phân đốt, có thể xoang thật — bước tiến quan trọng để các cơ quan xếp lớp và chuyên hoá.' },
        { name: 'Chân khớp', info: 'Bộ xương ngoài chitin, cơ thể phân đốt và phần phụ khớp động — nhóm đa dạng nhất hành tinh.' },
        { name: 'Cá', info: 'Động vật có xương sống đầu tiên: hô hấp bằng mang, tim hai ngăn, tuần hoàn đơn.' },
        { name: 'Lưỡng cư', info: 'Da ẩm hô hấp được, tim ba ngăn, vòng tuần hoàn kép — vẫn phụ thuộc nước khi sinh sản.' },
        { name: 'Bò sát', info: 'Da có vảy sừng chống mất nước, trứng có vỏ canxi — hoàn toàn giải phóng khỏi môi trường nước.' },
        { name: 'Chim', info: 'Nội nhiệt, lông vũ, xương rỗng, túi khí — thích nghi bay; tim bốn ngăn hoàn chỉnh.' },
        { name: 'Thú', info: 'Có vú nuôi con bằng sữa, lông mao, não phát triển; tim bốn ngăn, hồng cầu không nhân.' }
      ]
    }
  ]
};

let lab23Sel = 'Tổ tiên chung';

LABS.push({
  icon: 'fa-sitemap', name: 'Cây phát sinh chủng loại', short: 'Cây tiến hoá',
  sub: 'Nhìn cây tiến hoá để đọc được quan hệ họ hàng giữa các nhóm sinh vật.',
  tags: ['Tiến hóa', 'Phân loại'],
  note: 'Cây phát sinh là <b>giả thuyết</b> về quan hệ họ hàng, dựng từ dữ liệu phân tử và hình thái. Hai loài càng <b>gần điểm phân nhánh chung</b> thì càng gần nhau về tiến hoá — không phải “loài ở trên cao là tiến hoá hơn”. Mọi nhánh đều tiến hoá cùng thời gian như nhau tính từ tổ tiên chung.',
  v: { t: 100, lbl: 1 },
  controls: [
    { type: 'range', k: 't', label: 'Mốc thời gian tiến hoá', min: 0, max: 100, step: 2, unit: '%' },
    { type: 'seg', k: 'lbl', label: 'Hiện tên nhánh', opts: [[1, 'Có'], [0, 'Không']] }
  ],
  readouts: [['sel', 'Đang chọn'], ['grp', 'Nhóm'], ['near', 'Gần nhất'], ['kl', 'Ghi chú']],
  onClick(x, y) {
    const nodes = this._nodes || [];
    let best = null, bd = 1e9;
    nodes.forEach(function (n) {
      const d = Math.hypot(n.x - x, n.y - y);
      if (d < bd) { bd = d; best = n; }
    });
    if (best && bd < 30) {
      lab23Sel = best.name;
      this._seen = (this._seen || 0) + 1;
      beep(700, 0.04);
    }
  },
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    /* --- bố cục --- */
    let leaf = 0;
    const totalLeaves = 12;
    const yTop = h * .10, yBot = h * .70;
    const stepY = (yBot - yTop) / (totalLeaves - 1);
    const x0 = w * .07, xStep = w * .21;
    (function walk(n, d) {
      n._d = d;
      if (!n.children || !n.children.length) { n._y = yTop + leaf * stepY; leaf++; }
      else {
        n.children.forEach(function (ch) { walk(ch, d + 1); });
        n._y = (n.children[0]._y + n.children[n.children.length - 1]._y) / 2;
      }
      n._x = x0 + d * xStep;
    })(TREE_DATA, 0);

    const nodes = [];
    (function collect(n) {
      nodes.push({ x: n._x, y: n._y, name: n.name, info: n.info, d: n._d, kids: n.children ? n.children.length : 0 });
      if (n.children) n.children.forEach(collect);
    })(TREE_DATA);
    this._nodes = nodes;

    /* --- cắt theo thời gian --- */
    const cut = w * (.06 + (v.t / 100) * .96);
    c.save();
    c.beginPath(); c.rect(0, 0, cut, h); c.clip();

    (function drawNode(n) {
      if (n.children && n.children.length) {
        const ys = n.children.map(function (ch) { return ch._y; });
        c.strokeStyle = n._d === 0 ? col('var(--warn)') : col('var(--accent2)');
        c.lineWidth = n._d === 0 ? 3 : 2.2;
        c.lineCap = 'round';
        c.beginPath(); c.moveTo(n._x, Math.min.apply(null, ys)); c.lineTo(n._x, Math.max.apply(null, ys)); c.stroke();
        n.children.forEach(function (ch) {
          c.beginPath(); c.moveTo(n._x, ch._y); c.lineTo(ch._x, ch._y); c.stroke();
          drawNode(ch);
        });
        c.fillStyle = col('var(--warn)');
        c.beginPath(); c.arc(n._x, n._y, n._d === 0 ? 4 : 2.8, 0, 6.283); c.fill();
      } else {
        c.fillStyle = col('var(--accent)');
        c.beginPath(); c.arc(n._x, n._y, 3.4, 0, 6.283); c.fill();
      }
    })(TREE_DATA);
    c.restore();

    /* --- nhãn --- */
    if (v.lbl) {
      c.save();
      c.beginPath(); c.rect(0, 0, cut, h); c.clip();
      (function label(n) {
        if (n.children && n.children.length) {
          if (n._d <= 1 && n._x < cut - 6) {
            chipText(c, n.name, n._x + 6, n._y - 6, { color: n._d === 0 ? 'var(--warn)' : 'var(--accent2)', size: 8, weight: 700 });
          }
          n.children.forEach(label);
        } else {
          tx(c, n.name, n._x + 9, n._y + 3.5, { size: 8, color: p.text, weight: 600 });
        }
      })(TREE_DATA);
      c.restore();
    }

    /* --- thẻ thông tin (co giãn theo nội dung) --- */
    const selNode = nodes.filter(function (n) { return n.name === lab23Sel; })[0] || nodes[0];
    if (selNode) {
      const cardW = w * .94, maxW = cardW - 20;
      c.font = '600 7.8px "Be Vietnam Pro",sans-serif';
      const words = (selNode.info || '').split(' ');
      const lines = []; let line = '';
      words.forEach(function (wd) {
        const test = line ? line + ' ' + wd : wd;
        if (c.measureText(test).width > maxW) { lines.push(line); line = wd; }
        else line = test;
      });
      if (line) lines.push(line);
      const cardH = 30 + lines.length * 11.5;
      const cx0 = w * .03, cy0 = h - 36 - cardH;
      rr(c, cx0, cy0, cardW, cardH, 10);
      c.fillStyle = root.dataset.theme === 'light' ? 'rgba(255,255,255,.94)' : 'rgba(10,18,28,.9)';
      c.fill();
      c.strokeStyle = 'rgba(140,180,200,.3)'; c.lineWidth = 1; c.stroke();
      tx(c, selNode.name, cx0 + 11, cy0 + 17, { size: 10, color: 'var(--accent)', weight: 800 });
      lines.forEach(function (ln, i) {
        tx(c, ln, cx0 + 11, cy0 + 32 + i * 11.5, { size: 7.8, color: p.sub, weight: 600 });
      });
    }
    chipText(c, 'chạm vào một nhánh để xem thông tin', w * .97, h * .07, { color: p.sub, size: 8, align: 'right' });

    const parent = (function find(n, target) {
      if (n.children) {
        for (let i = 0; i < n.children.length; i++) {
          if (n.children[i].name === target) return n;
          const r = find(n.children[i], target);
          if (r) return r;
        }
      }
      return null;
    })(TREE_DATA, selNode ? selNode.name : '');

    ro('sel', selNode ? selNode.name : '—', 'var(--accent)');
    ro('grp', selNode ? (selNode.d === 0 ? 'Gốc' : selNode.d === 1 ? 'Giới' : 'Nhóm') : '—', p.text);
    ro('near', parent ? parent.name : '—', 'var(--accent2)');
    ro('kl', 'Càng gần điểm phân nhánh càng gần họ hàng', p.sub);
  }
});

/* ---------- LABX cho 3 lab mới ---------- */
LABX.push(
  {
    goal: 'Chứng minh chọn lọc tự nhiên chỉ đổi tần số allele đã có, và tốc độ đổi phụ thuộc vào áp lực chọn lọc.',
    steps: [
      'Để nền sáng, áp lực 60% — quan sát % bướm đen giảm dần qua các thế hệ.',
      'Đổi sang nền tối (bồ hóng) — chiều chọn lọc đảo ngược hoàn toàn.',
      'Kéo áp lực chọn lọc về 0% — quần thể đứng yên, vì sao?',
      'Đặt lại tỉ lệ đen ban đầu về 50% và so sánh tốc độ thay đổi.'
    ],
    why(v) {
      const light = v.bg === 0;
      let s = 'Chim săn bướm dựa trên <b>độ tương phản</b> với nền. Trên nền sáng, bướm đen nổi bật nên bị ăn nhiều hơn — đó là <em>chọn lọc định hướng</em> chống lại allele quy định màu đen.';
      if (v.sel === 0) s += ' Hiện áp lực chọn lọc = 0: mọi cá thể đều sống sót như nhau nên <em>tần số allele không đổi</em> qua các thế hệ — đúng như điều kiện cân bằng Hardy–Weinberg.';
      else if (light) s += ' Với áp lực ' + v.sel + '% trên nền sáng, bướm đen bị loại bỏ nhanh nên tỉ lệ đen <em>giảm dần</em> và tiến tới gần 0.';
      else s += ' Trên nền bồ hóng, chính bướm trắng lại nổi bật — chọn lọc đảo chiều khiến tỉ lệ đen <em>tăng vọt</em>. Đây chính là hiện tượng quan sát được ở Manchester thế kỷ 19.';
      s += ' Điều quan trọng: chọn lọc <b>không tạo ra allele mới</b>, nó chỉ làm allele có lợi phổ biến hơn. Khi nước Anh giảm ô nhiễm, tỉ lệ bướm đen lại giảm — bằng chứng hai chiều cực kỳ thuyết phục.';
      return s;
    }
  },
  {
    goal: 'Phân biệt rõ hai điều dễ nhầm: tần số allele và tần số kiểu gene — cái nào đứng yên, cái nào thay đổi.',
    steps: [
      'Để ngẫu phối, chọn lọc = 0 — đồ thị tần số a phải là đường nằm ngang.',
      'Chuyển sang tự phối — tần số a vẫn ngang, nhưng cột dị hợp tử tụt một nửa mỗi thế hệ.',
      'Tăng chọn lọc chống aa lên 50% — đường tần số a bắt đầu dốc xuống.',
      'Giải thích: vì sao allele lặn có hại vẫn không bao giờ mất hẳn?'
    ],
    why(v) {
      const p = v.p / 100, q = 1 - p;
      let s = 'Ở trạng thái cân bằng: <b>AA = p², Aa = 2pq, aa = q²</b>. Với p = ' + (p * 100).toFixed(0) + '% thì q = ' + (q * 100).toFixed(0) + '%%, nên aa ≈ ' + (q * q * 100).toFixed(1) + '%.';
      if (v.mode === 1) s += ' Đang <b>tự phối</b>: tần số allele <em>không đổi</em> nhưng dị hợp tử giảm một nửa mỗi thế hệ (Aa<sub>n</sub> = Aa<sub>0</sub>/2<sup>n</sup>) và đồng hợp tử tăng tương ứng — đây là lý do tự thụ phấn tạo ra các dòng thuần.';
      else if (v.s === 0) s += ' Đang <b>ngẫu phối, không chọn lọc</b>: quần thể đạt cân bằng chỉ sau một thế hệ và <em>giữ nguyên</em> — đồ thị là đường phẳng.';
      else s += ' Đang có <b>chọn lọc chống aa</b> với s = ' + v.s + '%: q giảm dần. Nhưng allele lặn vẫn “ẩn” trong thể dị hợp nên bị chọn lọc chậm hơn nhiều so với allele trội — vì vậy bệnh di truyền lặn khó loại khỏi quần thể bằng chọn lọc đơn thuần.';
      return s;
    }
  },
  {
    goal: 'Đọc được cây phát sinh: khoảng cách tới điểm phân nhánh, không phải vị trí cao thấp, mới nói lên quan hệ họ hàng.',
    steps: [
      'Kéo "Mốc thời gian" từ 0 lên 100 để xem cây mọc dần từ gốc.',
      'Chạm vào nhánh "Giới Động vật" để đọc thông tin.',
      'So sánh Chim và Thú — chúng gần nhau hơn hay gần Cá hơn?',
      'Rút ra: vì sao không thể nói "loài ở trên cùng là tiến hoá nhất"?'
    ],
    why(v) {
      return 'Mỗi <b>điểm phân nhánh</b> là một tổ tiên chung: hai nhánh cùng xuất phát từ một điểm thì gần nhau hơn hai nhánh phải đi ngược lên gốc mới gặp nhau. Chim và Thú gặp nhau ở tổ tiên chung của động vật có xương sống lên cạn, còn Cá tách ra <em>sớm hơn</em> — nên Chim gần Thú hơn là gần Cá. ' +
        'Cây này dựng chủ yếu từ dữ liệu phân tử (so sánh trình tự gene) chứ không phải từ hình thái bề ngoài, nên đôi khi kết quả <em>ngược với trực giác</em> — ví dụ nấm gần động vật hơn thực vật. ' +
        'Lưu ý cuối: mọi nhánh còn tồn tại đều đã tiến hoá <b>cùng một khoảng thời gian</b> tính từ tổ tiên chung, nên không có nhánh nào “tiến hoá hơn” nhánh khác.';
    }
  }
);

/* =========================================================
   v2.0 — MODULE MỞ RỘNG
   PERF · PROFILE · HISTORY · ACHIEVEMENTS · VS · UI · LAB+
   Toàn bộ nội dung cũ giữ nguyên; chỉ bổ sung lớp mới.
   ========================================================= */

/* ---------------------------------------------------------
   v2.0 · TOAST + CONFETTI
   --------------------------------------------------------- */
function toast(icon, title, sub, ms) {
  const w = document.getElementById('toastWrap');
  if (!w) return;
  const d = document.createElement('div');
  d.className = 'toast';
  d.innerHTML = '<div class="ti">' + icon + '</div><div style="min-width:0"><b>' + escHTML(title) + '</b><span>' + escHTML(sub || '') + '</span></div>';
  w.appendChild(d);
  setTimeout(function () { d.classList.add('out'); setTimeout(function () { d.remove(); }, 380); }, ms || 3200);
}

function confettiBurst() {
  if (root.dataset.fx === 'off') return;
  const cv = document.getElementById('confetti');
  if (!cv) return;
  const w = cv.width = window.innerWidth, h = cv.height = window.innerHeight;
  const ctx = cv.getContext('2d');
  if (!ctx) return;
  const cols = ['#3ddc97', '#38bdf8', '#fbbf24', '#fb7185', '#a99cf9'];
  const P = [];
  for (let i = 0; i < 90; i++) {
    P.push({
      x: Math.random() * w, y: -20 - Math.random() * h * 0.6,
      vy: 2 + Math.random() * 3.2, vx: (Math.random() - 0.5) * 1.8,
      s: 3 + Math.random() * 4, c: cols[Math.floor(Math.random() * cols.length)],
      r: Math.random() * 6, vr: (Math.random() - 0.5) * 0.35
    });
  }
  const t0 = performance.now();
  (function loop(now) {
    ctx.clearRect(0, 0, w, h);
    P.forEach(function (p) {
      p.x += p.vx; p.y += p.vy; p.vy += 0.03; p.r += p.vr;
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
      ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 1.6); ctx.restore();
    });
    if (now - t0 < 2600) requestAnimationFrame(loop);
    else ctx.clearRect(0, 0, w, h);
  })(performance.now());
}

/* ---------------------------------------------------------
   v2.0 · PERF — phát hiện máy yếu, giới hạn DPR, tạm dừng
   --------------------------------------------------------- */
const PERF = {
  tier: 'high',
  quality: store.get('quality', 'high'),
  lite: store.get('lite', false),
  fps: 60,
  measure: function (ms) {
    return new Promise(function (res) {
      let frames = 0;
      const t0 = performance.now();
      (function loop() {
        frames++;
        const dt = performance.now() - t0;
        if (dt < ms) requestAnimationFrame(loop);
        else res({ fps: Math.max(1, Math.round(frames / (dt / 1000))), frames: frames });
      })();
    });
  },
  dpr: function () {
    const cap = (this.lite || this.quality === 'low') ? 1 : this.quality === 'mid' ? 1.5 : 2;
    return Math.min(window.devicePixelRatio || 1, cap);
  },
  apply: function () {
    root.dataset.perf = this.tier;
    root.dataset.quality = this.quality;
    root.dataset.lite = this.lite ? 'on' : 'off';
    applyFx();
    if (this.lite) root.dataset.fx = 'off';
    const q = document.getElementById('lblQuality');
    if (q) q.textContent = this.quality === 'low' ? 'Thấp' : this.quality === 'mid' ? 'Vừa' : 'Cao';
    const t = document.getElementById('perfTierLbl');
    if (t) t.textContent = this.tier === 'high' ? 'Mạnh' : this.tier === 'mid' ? 'Trung bình' : 'Yếu';
    if (typeof labCv !== 'undefined' && labCv) resizeLab();
  },
  autoDetect: function () {
    const self = this;
    this.measure(1000).then(function (r) {
      // v2.0: bỏ qua nếu số khung đo được quá ít (tab ẩn, máy đang bận) — tránh báo sai
      if (r.frames < 20) { self.apply(); return; }
      self.fps = r.fps;
      self.tier = r.fps >= 50 ? 'high' : r.fps >= 35 ? 'mid' : 'low';
      if (r.fps < 28 && !store.get('lite', false)) {
        self.lite = true;
        store.set('lite', true);
        toast('⚡', 'Đã bật chế độ tiết kiệm', 'Máy chạy ' + r.fps + ' fps — hiệu ứng được giảm để mượt hơn.');
      }
      self.apply();
    });
  }
};

// v2.0: DPR theo chất lượng đồ họa thay vì cố định 2
const __resizeLab = resizeLab;
resizeLab = function () {
  if (!labCv) return;
  const wrap = labCv.parentElement;
  const r = wrap.getBoundingClientRect();
  if (!r.width) return;
  /* v5.1 — chặn DPR theo thiết bị: phone 1.5, còn lại 2 (giảm tải GPU di động) */
  const __curDev = (typeof BG4_DEVICE !== 'undefined' && BG4_DEVICE.current) ? BG4_DEVICE.current() : null;
  const __dprCap = __curDev && __curDev.type === 'phone' ? 1.5 : 2;
  const dpr = Math.min(PERF.dpr(), __dprCap);
  labCv.width = Math.round(r.width * dpr);
  labCv.height = Math.round(r.height * dpr);
  labCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  labCv._w = r.width; labCv._h = r.height;
  if (typeof BG4_GL !== 'undefined') BG4_GL.resize(r.width, r.height);
};

// v2.0: chế độ tiết kiệm ép tắt hiệu ứng
let starRaf = 0, v2Ready = false;
const __applyFx = applyFx;
applyFx = function () {
  __applyFx();
  if (PERF.lite) root.dataset.fx = 'off';
  if (v2Ready && root.dataset.fx !== 'off' && !starRaf) drawStars();
};

/* ---------------------------------------------------------
   v2.0 · PROFILE
   --------------------------------------------------------- */

/* ============================================================
   v5.2 · HỒ SƠ UUID + SAO LƯU / KHÔI PHỤC JSON
   - UUID cố định, KHÔNG sinh từ tên/streak → đổi tên không tạo hồ sơ mới.
   - Export có schema + version; import kiểm tra cấu trúc, chống trùng,
     tự sao lưu bản hiện tại trước khi ghi đè.
   ============================================================ */
function bg4Uuid() {
  try { if (crypto && crypto.randomUUID) return crypto.randomUUID(); } catch (e) { }
  const b = new Uint8Array(16);
  try { crypto.getRandomValues(b); } catch (e) { for (let i = 0; i < 16; i++) b[i] = Math.floor(Math.random() * 256); }
  b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80;
  let h = '';
  for (let i = 0; i < 16; i++) h += b[i].toString(16).padStart(2, '0');
  return h.slice(0, 8) + '-' + h.slice(8, 12) + '-' + h.slice(12, 16) + '-' + h.slice(16, 20) + '-' + h.slice(20);
}
function bg4Hash(s) {
  let h1 = 0x811c9dc5, h2 = 0x01000193;
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i);
    h1 = Math.imul(h1 ^ c, 16777619) >>> 0;
    h2 = Math.imul(h2 + c, 2246822519) >>> 0;
  }
  return h1.toString(36) + h2.toString(36);
}
const BG4_BACKUP = {
  SCHEMA: 'biogalaxy.backup',
  VERSION: 1,
  _pending: null,
  async collect() {
    const g = async function (k, d) {
      try { return (typeof BG4_STORE !== 'undefined') ? await BG4_STORE.get(k, d) : store.get(k, d); }
      catch (e) { return store.get(k, d); }
    };
    return {
      app: 'BioGalaxy', schema: this.SCHEMA, version: this.VERSION,
      exportedAt: new Date().toISOString(),
      profile: Object.assign({}, PROFILE.data),
      data: {
        history: await g('history', []),
        match_history: await g('match_history', []),
        progress4: await g('progress4', {}),
        review4: await g('review4', {}),
        bank_ext: await g('bank_ext', []),
        achv: store.get('achv', []),
        counters: store.get('counters', {}),
        settings: {
          theme: store.get('theme', 'dark'), size: store.get('size', 'md'),
          layout: store.get('layout', 'auto'), accent: store.get('accent', 'emerald'),
          font: store.get('font', 'be'), density: store.get('density', 'normal'),
          sound: store.get('sound', true), fx: store.get('fx', true),
          gfx: store.get('gfx', 'auto'), examStyle: store.get('examStyle', 'real')
        }
      }
    };
  },
  validate(obj) {
    const err = [], warn = [];
    if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return { ok: false, errors: ['Tệp không phải JSON hợp lệ.'], warnings: warn };
    if (obj.schema !== this.SCHEMA) err.push('Sai schema (cần "' + this.SCHEMA + '").');
    if (!Number.isInteger(obj.version)) err.push('Thiếu version.');
    else if (obj.version > this.VERSION) err.push('Bản sao lưu mới hơn phiên bản ứng dụng (' + obj.version + ' > ' + this.VERSION + ').');
    const d = obj.data;
    if (!d || typeof d !== 'object') err.push('Thiếu khối data.');
    const arr = function (k, max) {
      /* v5.5 — FIX: thiếu hẳn khối data thì trước đây `d[k]` ném TypeError.
         Giờ trả rỗng; lỗi "Thiếu khối data" đã được ghi ở trên. */
      if (!d) return [];
      if (d[k] == null) { warn.push('Thiếu ' + k + ' → dùng rỗng.'); return []; }
      if (!Array.isArray(d[k])) { err.push(k + ' phải là mảng.'); return []; }
      if (d[k].length > max) { err.push(k + ' quá lớn (' + d[k].length + ' > ' + max + ').'); return []; }
      return d[k];
    };
    const history = arr('history', 5000);
    const match = arr('match_history', 5000);
    const bank = arr('bank_ext', 5000);
    const goodHist = [], seenH = Object.create(null);
    let dupH = 0, badH = 0;
    history.forEach(function (r) {
      if (!r || typeof r !== 'object') { badH++; return; }
      const sc = Number(r.score);
      if (!isFinite(sc) || sc < 0 || sc > 10) { badH++; return; }
      const key = r.id || bg4Hash(JSON.stringify(r));
      if (seenH[key]) { dupH++; return; }
      seenH[key] = 1; goodHist.push(r);
    });
    const goodBank = [], seenB = Object.create(null);
    let dupB = 0, badB = 0;
    bank.forEach(function (q) {
      if (!q || typeof q.q !== 'string' || !q.q.trim() || !Array.isArray(q.o) || q.o.length !== 4 ||
          !(q.a >= 0 && q.a <= 3)) { badB++; return; }
      const key = bg4Hash(String(q.q).slice(0, 160) + '|' + q.o.join('|'));
      if (seenB[key]) { dupB++; return; }
      seenB[key] = 1; goodBank.push(q);
    });
    const prog = (d && d.progress4 && typeof d.progress4 === 'object') ? d.progress4 : {};
    const rev = (d && d.review4 && typeof d.review4 === 'object') ? d.review4 : {};
    const prof = (obj.profile && typeof obj.profile === 'object') ? obj.profile : {};
    const uuidOk = !prof.uuid || /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(prof.uuid));
    if (!uuidOk) err.push('UUID hồ sơ không hợp lệ.');
    if (!prof.uuid) warn.push('Bản sao lưu không có UUID → sẽ giữ UUID hiện tại của máy này.');
    if (dupH) warn.push('Bỏ qua ' + dupH + ' bản ghi lịch sử trùng.');
    if (badH) warn.push('Bỏ qua ' + badH + ' bản ghi lịch sử lỗi.');
    if (dupB) warn.push('Bỏ qua ' + dupB + ' câu hỏi trùng.');
    if (badB) warn.push('Bỏ qua ' + badB + ' câu hỏi sai cấu trúc.');
    return {
      ok: err.length === 0, errors: err, warnings: warn,
      counts: { history: goodHist.length, match: match.length, bank: goodBank.length,
                progressTopics: Object.keys(prog.byTopic || {}).length, review: Object.keys(rev).length },
      data: { history: goodHist, match_history: match, bank_ext: goodBank,
              progress4: prog, review4: rev, profile: prof,
              achv: Array.isArray(d && d.achv) ? d.achv : [],
              counters: (d && d.counters && typeof d.counters === 'object') ? d.counters : {},
              settings: (d && d.settings && typeof d.settings === 'object') ? d.settings : {} }
    };
  },
  async exportFile() {
    const payload = await this.collect();
    const name = 'biogalaxy-backup-' + new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-') + '.json';
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
    try { toast('i-database', 'Đã xuất bản sao lưu', name, 3200); } catch (e) { }
    return name;
  },
  async readFile(input) {
    const f = input.files && input.files[0];
    const box = document.getElementById('bg4ImportPreview');
    if (!f) return;
    if (f.size > 8 * 1024 * 1024) { if (box) box.textContent = '⚠ Tệp quá lớn (> 8 MB).'; return; }
    let obj = null, parseErr = '';
    try { obj = JSON.parse(await f.text()); } catch (e) { parseErr = e.message; }
    if (!obj) { if (box) box.innerHTML = '<span style="color:var(--bad)">✕ JSON lỗi: ' + parseErr + '</span>'; return; }
    const v = this.validate(obj);
    this._pending = v.ok ? obj : null;
    if (!box) return;
    if (!v.ok) {
      box.innerHTML = '<div style="color:var(--bad);font-weight:700">✕ Không thể nhập</div>' +
        v.errors.map(function (e) { return '<div>• ' + e + '</div>'; }).join('');
      return;
    }
    const c = v.counts;
    box.innerHTML =
      '<div style="color:var(--ok);font-weight:700">✓ Tệp hợp lệ · schema v' + obj.version + '</div>' +
      '<div>Hồ sơ: <b>' + (v.data.profile.name || '—') + '</b> · UUID ' +
      (v.data.profile.uuid ? v.data.profile.uuid.slice(0, 8) + '…' : '(giữ UUID máy này)') + '</div>' +
      '<div>Lịch sử thi <b>' + c.history + '</b> · đấu <b>' + c.match + '</b> · câu tự soạn <b>' + c.bank + '</b> · chuyên đề <b>' + c.progressTopics + '</b> · ôn tập <b>' + c.review + '</b></div>' +
      (v.warnings.length ? '<div style="color:var(--warn);margin-top:3px">' + v.warnings.join('<br>') + '</div>' : '') +
      '<button class="btn pri wide" style="margin-top:7px" onclick="bg4ImportApply()">Xác nhận khôi phục (có sao lưu tự động)</button>';
  },
  async importData(obj, mode) {
    const v = this.validate(obj);
    if (!v.ok) throw new Error(v.errors.join(' '));
    /* sao lưu bản hiện tại trước khi ghi đè */
    try {
      const cur = await this.collect();
      await BG4_STORE.set('backup_auto', { at: Date.now(), payload: cur });
    } catch (e) { }
    const d = v.data;
    const merge = mode === 'merge';
    const mergeArr = function (cur, add, keyFn) {
      if (!merge) return add;
      const out = cur.slice(), seen = Object.create(null);
      out.forEach(function (x) { seen[keyFn(x)] = 1; });
      add.forEach(function (x) { const k = keyFn(x); if (!seen[k]) { seen[k] = 1; out.push(x); } });
      return out;
    };
    const curHist = await BG4_STORE.get('history', []);
    const curMatch = await BG4_STORE.get('match_history', []);
    const curBank = await BG4_STORE.get('bank_ext', []);
    await BG4_STORE.set('history', mergeArr(curHist, d.history, function (r) { return r.id || bg4Hash(JSON.stringify(r)); }));
    await BG4_STORE.set('match_history', mergeArr(curMatch, d.match_history, function (r) { return r.id || bg4Hash(JSON.stringify(r)); }));
    await BG4_STORE.set('bank_ext', mergeArr(curBank, d.bank_ext, function (q) { return bg4Hash(String(q.q).slice(0, 160) + '|' + q.o.join('|')); }));
    if (!merge || !store.get('progress4', null)) await BG4_STORE.set('progress4', d.progress4);
    if (!merge || !store.get('review4', null)) await BG4_STORE.set('review4', d.review4);
    const prof = Object.assign({}, PROFILE.data, d.profile);
    if (!prof.uuid) prof.uuid = PROFILE.data.uuid || bg4Uuid();
    store.set('profile', prof);
    if (Array.isArray(d.achv) && d.achv.length) store.set('achv', merge ? Array.from(new Set((store.get('achv', []) || []).concat(d.achv))) : d.achv);
    if (d.counters && Object.keys(d.counters).length) store.set('counters', merge ? Object.assign({}, store.get('counters', {}), d.counters) : d.counters);
    const S = d.settings || {};
    ['theme', 'size', 'layout', 'accent', 'font', 'density', 'sound', 'fx', 'gfx', 'examStyle'].forEach(function (k) {
      if (S[k] !== undefined) store.set(k, S[k]);
    });
    return v.counts;
  }
};
function bg4Export() { BG4_BACKUP.exportFile(); }
function bg4ImportFile(input) { BG4_BACKUP.readFile(input); }
async function bg4ImportApply() {
  if (!BG4_BACKUP._pending) return;
  if (!confirm('Khôi phục bản sao lưu này? Dữ liệu hiện tại sẽ được sao lưu tự động trước khi ghi đè.')) return;
  try {
    const c = await BG4_BACKUP.importData(BG4_BACKUP._pending, 'replace');
    BG4_BACKUP._pending = null;
    const box = document.getElementById('bg4ImportPreview');
    if (box) box.innerHTML = '<div style="color:var(--ok);font-weight:700">✓ Đã khôi phục</div>' +
      '<div>Lịch sử ' + c.history + ' · đấu ' + c.match + ' · câu tự soạn ' + c.bank + '</div>' +
      '<button class="btn pri wide" style="margin-top:7px" onclick="location.reload()">Tải lại để áp dụng</button>';
    try { toast('i-check', 'Khôi phục xong', 'Tải lại trang để áp dụng.', 4000); } catch (e) { }
  } catch (e) {
    const box = document.getElementById('bg4ImportPreview');
    if (box) box.innerHTML = '<span style="color:var(--bad)">✕ ' + e.message + '</span>';
  }
}
function bg4RefreshUuid() {
  const el = document.getElementById('pfUuid');
  if (!el) return;
  const u = (PROFILE.data && PROFILE.data.uuid) || '';
  el.textContent = u ? (u.slice(0, 8) + '…' + u.slice(-4)) : '—';
  el.title = u;
}
const PROFILE = {
  data: Object.assign({ name: 'Học sinh', avatar: '🧬' }, store.get('profile', {})),
  avatars: ['🧬', '🧪', '🌱', '🦋', '🐝', '🦠', '🔬', '🧫'],
  save: function () {
    const inp = document.getElementById('pfName');
    if (inp) this.data.name = String(inp.value || 'Học sinh').replace(/<[^>]*>/g, '').trim().slice(0, 18) || 'Học sinh';
    store.set('profile', this.data);
    try { if (typeof BG4_ACC !== 'undefined') BG4_ACC.rename(); } catch (e) { }
    this.render();
    beep(720, 0.04);
    toast('💾', 'Đã lưu hồ sơ', this.data.avatar + ' ' + this.data.name);
  },
  setAvatar: function (a) {
    this.data.avatar = a;
    store.set('profile', this.data);
    try { if (typeof BG4_ACC !== 'undefined') BG4_ACC.rename(); } catch (e) { }
    this.render();
    beep(640, 0.03);
  },
  render: function () {
    const av = document.getElementById('pfAvatar');
    if (av) av.textContent = this.data.avatar;
    const nm = document.getElementById('pfName');
    if (nm && document.activeElement !== nm) nm.value = this.data.name;
    const box = document.getElementById('pfAvatars');
    if (box) {
      box.innerHTML = this.avatars.map(a =>
        '<button class="swatch ' + (a === this.data.avatar ? 'on' : '') + '" style="font-size:1.05rem;background:var(--surface3);display:grid;place-items:center" onclick="PROFILE.setAvatar(\'' + a + '\')" aria-label="Ảnh đại diện ' + a + '">' + a + '</button>'
      ).join('');
    }
  }
};

/* ---------------------------------------------------------
   v2.0 · HISTORY — lịch sử thi + biểu đồ
   --------------------------------------------------------- */
const HISTORY = {
  list: store.get('history', []),
  add: function (rec) {
    this.list.unshift(rec);
    if (this.list.length > 60) this.list.length = 60;
    store.set('history', this.list);
    this.render();
  },
  clear: function () {
    this.list = [];
    store.set('history', []);
    this.render();
    beep(320, 0.06);
  },
  stats: function () {
    const n = this.list.length;
    if (!n) return { n: 0, avg: 0, best: 0 };
    const scores = this.list.map(function (r) { return r.score || 0; });
    return {
      n: n,
      avg: +(scores.reduce(function (a, b) { return a + b; }, 0) / n).toFixed(1),
      best: +Math.max.apply(null, scores).toFixed(2)
    };
  },
  render: function () {
    const st = this.stats();
    const a = document.getElementById('stTotal'), b = document.getElementById('stAvg'), c = document.getElementById('stBest');
    if (a) a.textContent = st.n;
    if (b) b.textContent = st.avg.toFixed(1);
    if (c) c.textContent = st.best.toFixed(2);

    const list = document.getElementById('histList');
    if (list) {
      list.innerHTML = this.list.length ? this.list.map(function (r) {
        const d = new Date(r.date);
        const when = d.getDate() + '/' + (d.getMonth() + 1) + ' ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
        const col = r.score >= 8 ? 'var(--ok)' : r.score >= 5 ? 'var(--warn)' : 'var(--bad)';
        const label = r.mode === 'vs'
          ? '⚔️ ' + r.p1 + ' ' + r.s1 + ' – ' + r.s2 + ' ' + r.p2
          : '🎯 Solo';
        return '<div class="histrow"><div><div class="b xs">' + label + '</div><div class="hd">' + when + ' · ' + (r.correct || 0) + '/' + (r.total || 0) + ' câu</div></div>' +
          '<div class="mono b" style="color:' + col + '">' + r.score.toFixed(2) + '</div></div>';
      }).join('') : '<div class="tiny" style="padding:8px 2px">Chưa có lần thi nào. Hoàn thành một bài để bắt đầu ghi lịch sử.</div>';
    }
    this.chart();
  },
  chart: function () {
    const cv = document.getElementById('histChart');
    if (!cv) return;
    const r = cv.getBoundingClientRect();
    if (!r.width) return;
    const dpr = PERF.dpr();
    cv.width = Math.round(r.width * dpr);
    cv.height = Math.round(r.height * dpr);
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = r.width, h = r.height, p = P();
    ctx.clearRect(0, 0, w, h);
    const data = this.list.slice(0, 20).reverse().map(function (x) { return x.score; });
    if (data.length < 2) {
      tx(ctx, data.length ? 'Cần thêm 1 lần thi để vẽ đường' : 'Chưa có dữ liệu', w / 2, h / 2, { size: 9, color: p.sub, align: 'center' });
      return;
    }
    const pad = 16, x0 = pad, x1 = w - pad, y0 = 12, y1 = h - 16;
    ctx.strokeStyle = p.line; ctx.lineWidth = 1;
    [0, 5, 10].forEach(function (v) {
      const y = y1 - (v / 10) * (y1 - y0);
      ctx.beginPath(); ctx.moveTo(x0, y); ctx.lineTo(x1, y); ctx.stroke();
      tx(ctx, String(v), x0 - 4, y + 3, { size: 7, color: p.sub, align: 'right' });
    });
    ctx.beginPath();
    data.forEach(function (v, i) {
      const x = x0 + (i / (data.length - 1)) * (x1 - x0);
      const y = y1 - (v / 10) * (y1 - y0);
      i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
    });
    ctx.strokeStyle = col('var(--accent)'); ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.stroke();
    data.forEach(function (v, i) {
      const x = x0 + (i / (data.length - 1)) * (x1 - x0);
      const y = y1 - (v / 10) * (y1 - y0);
      ctx.beginPath(); ctx.arc(x, y, 2.6, 0, 6.283);
      ctx.fillStyle = v >= 8 ? col('var(--ok)') : v >= 5 ? col('var(--warn)') : col('var(--bad)');
      ctx.fill();
    });
  }
};

/* ---------------------------------------------------------
   v2.0 · ACHIEVEMENTS
   --------------------------------------------------------- */
const ACHV = [
  { id: 'first', ico: '🎯', n: 'Khởi động', d: 'Hoàn thành bài thi đầu tiên' },
  { id: 'ten', ico: '🔟', n: 'Chiến binh', d: 'Hoàn thành 10 bài thi' },
  { id: 'perfect', ico: '💎', n: 'Bất bại', d: 'Đạt 10.00 điểm' },
  { id: 'streak', ico: '🔥', n: 'Kiên trì', d: 'Chuỗi 3 câu đúng liên tiếp' },
  { id: 'vs1', ico: '⚔️', n: 'Đấu sĩ', d: 'Thắng một trận VS 2 người' },
  { id: 'vs5', ico: '👑', n: 'Vô địch', d: 'Thắng 5 trận VS' },
  { id: 'hpfull', ico: '❤️', n: 'Bất tử', d: 'Thắng VS mà không mất mạng' },
  { id: 'laball', ico: '🧪', n: 'Phá đảo Lab', d: 'Mở đủ 23 thí nghiệm' },
  { id: 'chal', ico: '🏅', n: 'Chinh phục', d: 'Hoàn thành 5 thử thách lab' },
  { id: 'bank', ico: '🗂️', n: 'Nhà sưu tầm', d: 'Xem 100 câu trong ngân hàng' },
  { id: 'night', ico: '🌙', n: 'Cú đêm', d: 'Học sau 23 giờ' },
  { id: 'reader', ico: '📚', n: 'Nhà sinh học', d: 'Mở 20 chuyên đề lý thuyết' }
];

const ACH = {
  got: store.get('achv', []),
  counters: store.get('counters', { exams: 0, vsWin: 0, chal: 0, bankSeen: 0, theoryOpen: 0, labsSeen: [] }),
  has: function (id) { return this.got.indexOf(id) >= 0; },
  unlock: function (id) {
    if (this.has(id)) return;
    const a = ACHV.filter(function (x) { return x.id === id; })[0];
    if (!a) return;
    this.got.push(id);
    store.set('achv', this.got);
    this.render();
    toast(a.ico, 'Mở khóa thành tích: ' + a.n, a.d, 4200);
    confettiBurst();
    beep(920, 0.12);
  },
  bump: function (k, by) {
    this.counters[k] = (this.counters[k] || 0) + (by || 1);
    store.set('counters', this.counters);
  },
  seeLab: function (i) {
    const seen = this.counters.labsSeen || [];
    if (seen.indexOf(i) < 0) { seen.push(i); this.counters.labsSeen = seen; store.set('counters', this.counters); }
    if (seen.length >= 23) this.unlock('laball');
  },
  render: function () {
    const box = document.getElementById('achvList');
    if (!box) return;
    box.innerHTML = ACHV.map(function (a) {
      const on = ACH.has(a.id);
      return '<div class="achv ' + (on ? 'on' : '') + '"><div class="ai">' + a.ico + '</div>' +
        '<div style="min-width:0"><b>' + a.n + '</b><span>' + a.d + '</span></div></div>';
    }).join('');
  }
};

/* ---------------------------------------------------------
   v2.0 · UI — accent, font, mật độ, TV, ngôn ngữ
   --------------------------------------------------------- */
const UI = {
  accent: store.get('accent', 'emerald'),
  font: store.get('font', 'be'),
  density: store.get('density', 'normal'),
  tv: store.get('tv', false),
  lang: store.get('lang', 'vi'),
  accents: [
    ['emerald', '#3ddc97', '#38bdf8', 'Ngọc lục'],
    ['ocean', '#38bdf8', '#818cf8', 'Đại dương'],
    ['violet', '#a78bfa', '#38bdf8', 'Tím'],
    ['rose', '#fb7185', '#f472b6', 'Hồng'],
    ['amber', '#fbbf24', '#fb923c', 'Hổ phách'],
    ['cyan', '#22d3ee', '#3ddc97', 'Lục lam']
  ]
};

const EN = {
  dock: { theory: 'Theory', think: 'Thinking', exam: 'Exam', lab: 'Lab', bank: 'Bank', essay: 'Essays', settings: 'Settings' },
  hero: {
    'view-theory': 'The essence of Biology 12',
    'view-think': 'Sharp biological thinking',
    'view-exam': 'Exam room',
    'view-lab': 'Virtual lab',
    'view-bank': 'Question bank',
    'view-essay': 'Essay practice',
    'view-settings': 'Customise your experience'
  }
};

function applyUI() {
  root.dataset.accent = UI.accent;
  root.dataset.font = UI.font;
  root.dataset.density = UI.density;
  root.dataset.tv = UI.tv ? 'on' : 'off';
  root.lang = UI.lang;
  // đồng bộ nút
  ['segFont', 'segDensity'].forEach(function () { });
  syncSeg('#segFont', ['be', 'inter', 'mono'], ['be', 'inter', 'mono'].indexOf(UI.font));
  syncSeg('#segDensity', ['compact', 'normal', 'airy'], ['compact', 'normal', 'airy'].indexOf(UI.density));
  const sw = document.getElementById('accentSwatches');
  if (sw) {
    sw.innerHTML = UI.accents.map(function (a) {
      return '<button class="swatch ' + (a[0] === UI.accent ? 'on' : '') + '" title="' + a[3] + '" aria-label="Màu ' + a[3] + '" ' +
        'style="background:linear-gradient(135deg,' + a[1] + ',' + a[2] + ')" onclick="setAccent(\'' + a[0] + '\')"></button>';
    }).join('');
  }
  const swTv = document.getElementById('swTv');
  if (swTv) swTv.classList.toggle('on', UI.tv);
  const lv = document.getElementById('langVi'), le = document.getElementById('langEn');
  if (lv) lv.classList.toggle('on', UI.lang === 'vi');
  if (le) le.classList.toggle('on', UI.lang === 'en');
  applyLang();
}

function syncSeg(sel, keys, idx) {
  const el = document.querySelector(sel);
  if (!el) return;
  [...el.children].forEach(function (b, i) { b.classList.toggle('on', i === idx); });
}

function applyLang() {
  const en = UI.lang === 'en';
  document.querySelectorAll('#dock button').forEach(function (b) {
    const s = b.querySelector('span');
    if (!s) return;
    if (!s.dataset.vi) s.dataset.vi = s.textContent;
    const k = b.dataset.v;
    s.textContent = en ? (EN.dock[k] || s.dataset.vi) : s.dataset.vi;
  });
  Object.keys(EN.hero).forEach(function (vid) {
    const h = document.querySelector('#' + vid + ' .hero h2');
    if (!h) return;
    if (!h.dataset.vi) h.dataset.vi = h.textContent;
    h.textContent = en ? EN.hero[vid] : h.dataset.vi;
  });
}

function setAccent(k) { UI.accent = k; store.set('accent', k); applyUI(); beep(660, 0.03); }
function setFont(k) { UI.font = k; store.set('font', k); applyUI(); beep(620, 0.03); }
function setDensity(k) { UI.density = k; store.set('density', k); applyUI(); beep(600, 0.03); }
function toggleTv() { UI.tv = !UI.tv; store.set('tv', UI.tv); applyUI(); beep(540, 0.04); }
function setLang(l) { UI.lang = l; store.set('lang', l); applyUI(); beep(700, 0.03); }

function toggleLite() {
  PERF.lite = !PERF.lite;
  store.set('lite', PERF.lite);
  PERF.apply();
  const sw = document.getElementById('swLite');
  if (sw) sw.classList.toggle('on', PERF.lite);
  beep(520, 0.04);
  toast('⚡', PERF.lite ? 'Đã bật chế độ tiết kiệm' : 'Đã tắt chế độ tiết kiệm', PERF.lite ? 'Giảm hiệu ứng và độ phân giải canvas.' : 'Hiệu ứng đầy đủ trở lại.');
}
function setQuality(q) {
  PERF.quality = q;
  store.set('quality', q);
  PERF.apply();
  beep(600, 0.03);
}
function runPerfTest() {
  const box = document.getElementById('perfResult');
  if (box) box.textContent = 'Đang đo 2 giây…';
  PERF.measure(2000).then(function (r) {
    const fps = r.frames < 15 ? 0 : r.fps;
    PERF.fps = fps;
    PERF.tier = fps === 0 ? 'high' : fps >= 50 ? 'high' : fps >= 35 ? 'mid' : 'low';
    PERF.apply();
    const sug = fps >= 50 ? 'Máy mạnh — để chất lượng Cao và bật hiệu ứng.'
      : fps >= 35 ? 'Máy trung bình — nên để chất lượng Vừa.'
        : 'Máy yếu — nên bật chế độ tiết kiệm và chất lượng Thấp.';
    if (fps === 0) { if (box) box.textContent = 'Không đo được (tab đang ẩn hoặc trình duyệt giới hạn khung hình).'; return; }
    if (box) box.innerHTML = '<b style="color:' + (fps >= 50 ? 'var(--ok)' : fps >= 35 ? 'var(--warn)' : 'var(--bad)') + '">' + fps + ' fps</b> · ' + sug;
    beep(fps >= 50 ? 820 : 420, 0.06);
  });
}

/* ---------------------------------------------------------
   v2.0 · CHẾ ĐỘ LÀM BÀI (luyện tập / thi thật)
   --------------------------------------------------------- */
let examStyle = store.get('examStyle', 'real');
let examMode = 'solo';

function setExamStyle(s) {
  examStyle = s;
  store.set('examStyle', s);
  syncSeg('#segExamStyle', null, s === 'practice' ? 0 : 1);
  const hint = document.getElementById('examStyleHint');
  if (hint) hint.textContent = s === 'practice'
    ? 'Hiện đáp án và giải thích ngay khi chọn, không tính giờ.'
    : 'Không hiện đáp án, có đồng hồ đếm ngược — mô phỏng thi THPT.';
  beep(600, 0.03);
}

function setExamMode(m) {
  examMode = m;
  const a = document.getElementById('modeSolo'), b = document.getElementById('modeVs');
  if (a) a.classList.toggle('on', m === 'solo');
  if (b) b.classList.toggle('on', m === 'vs');
  beep(640, 0.03);
  if (m === 'vs') openVsModal();
}

/* ---------------------------------------------------------
   v2.0 · VS 2 NGƯỜI
   --------------------------------------------------------- */
let vs = null;
const vsCfg = { hp: 3, qty: 10, time: 10, flow: 'seq' };

function openVsModal() {
  if (typeof ACCESS !== 'undefined' && ACCESS.isBasic()) { accessUpgrade('vs'); return; }
  const p1 = document.getElementById('vsP1');
  const p2 = document.getElementById('vsP2');
  if (p1) p1.value = PROFILE.data.name !== 'Học sinh' ? PROFILE.data.name : 'P1';
  if (p2) p2.value = 'P2';
  const m = document.getElementById('vsModal');
  if (m) m.classList.remove('hide');
  beep(700, 0.04);
}
function closeVsModal() {
  const m = document.getElementById('vsModal');
  if (m) m.classList.add('hide');
  setExamMode('solo');
}

function setVsHp(n, btn) {
  vsCfg.hp = n;
  const l = document.getElementById('vsHpLbl');
  if (l) l.textContent = n + ' ❤️';
  segOn('#segVsHp', btn); beep(560, 0.02);
}
function setVsQty(n, btn) {
  vsCfg.qty = n;
  const l = document.getElementById('vsQtyLbl');
  if (l) l.textContent = n + ' câu';
  segOn('#segVsQty', btn); beep(580, 0.02);
}
function setVsTime(n, btn) {
  vsCfg.time = n;
  const l = document.getElementById('vsTimeLbl');
  if (l) l.textContent = n + ' phút';
  segOn('#segVsTime', btn); beep(600, 0.02);
}
function setVsFlow(f, btn) {
  vsCfg.flow = f;
  segOn('#segVsFlow', btn);
  const h = document.getElementById('vsFlowHint');
  if (h) h.textContent = f === 'seq'
    ? 'P1 làm hết đề trước, sau đó tới P2 — không ai thấy đáp án của người kia.'
    : 'Mỗi câu cả hai lần lượt chọn, hết đề mới công bố đáp án.';
  beep(620, 0.02);
}
function segOn(sel, btn) {
  const el = document.querySelector(sel);
  if (!el || !btn) return;
  [...el.children].forEach(function (b) { b.classList.remove('on'); });
  btn.classList.add('on');
}

function startVs() {
  /* v4.3 — cô lập đồng hồ solo như mpBegin/netBegin */
  clearInterval(timerId); timerId = null; endAt = 0;
  const p1 = ((document.getElementById('vsP1') || {}).value || 'P1').trim().slice(0, 12) || 'P1';
  const p2 = ((document.getElementById('vsP2') || {}).value || 'P2').trim().slice(0, 12) || 'P2';
  const n = Math.min(vsCfg.qty, MCQS.length);
  const deck = shuffle(MCQS).slice(0, n);
  const queue = [];
  if (vsCfg.flow === 'seq') {
    deck.forEach(function (_, i) { queue.push({ p: 'p1', q: i }); });
    deck.forEach(function (_, i) { queue.push({ p: 'p2', q: i }); });
  } else {
    deck.forEach(function (_, i) { queue.push({ p: 'p1', q: i }); queue.push({ p: 'p2', q: i }); });
  }
  vs = {
    p1: p1, p2: p2, deck: deck, queue: queue, qi: 0,
    maxHp: vsCfg.hp, hp: { p1: vsCfg.hp, p2: vsCfg.hp },
    ans: { p1: {}, p2: {} }, streak: { p1: 0, p2: 0 }, best: { p1: 0, p2: 0 },
    remain: vsCfg.time * 60, over: false, timer: null, flow: vsCfg.flow,
    spent: { p1: 0, p2: 0 }, stepT0: performance.now(), pop: null
  };
  const hide = ['vsModal'];
  hide.forEach(function (id) { const e = document.getElementById(id); if (e) e.classList.add('hide'); });
  document.getElementById('examConfig').style.display = 'none';
  document.getElementById('examReport').style.display = 'none';
  document.getElementById('examRoom').style.display = 'none';
  document.getElementById('vsResult').style.display = 'none';
  document.getElementById('vsRoom').style.display = '';
  go('exam');
  vsRenderHp();
  vsRenderStep();
  vsStartTimer();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  beep(780, 0.1);
}

function vsStartTimer() {
  clearInterval(vs.timer);
  const paint = function () {
    const el = document.getElementById('vsTimer');
    if (!el) return;
    const m = Math.floor(Math.max(0, vs.remain) / 60), s = Math.max(0, vs.remain) % 60;
    el.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    el.style.color = vs.remain <= 30 ? 'var(--bad)' : vs.remain <= 120 ? 'var(--warn)' : 'var(--accent)';
  };
  paint();
  vs.timer = setInterval(function () {
    vs.remain--;
    paint();
    if (vs.remain <= 0) vsFinish('Hết giờ');
  }, 1000);
}

function vsRenderHp() {
  const box = document.getElementById('vsHpBar');
  if (!box || !vs) return;
  const cur = vs.queue[vs.qi] ? vs.queue[vs.qi].p : null;
  box.innerHTML = ['p1', 'p2'].map(function (k) {
    const name = k === 'p1' ? vs.p1 : vs.p2;
    const cc = k === 'p1' ? 'var(--accent)' : 'var(--accent2)';
    let hearts = '';
    for (let i = 0; i < vs.maxHp; i++) {
      const alive = i < vs.hp[k];
      const pop = vs.pop && vs.pop.k === k && vs.pop.i === i ? ' pop' : '';
      hearts += '<i class="fa-solid fa-heart heart' + (alive ? '' : ' dead') + pop + '"></i>';
    }
    const done = Object.keys(vs.ans[k]).length;
    return '<div class="hprow' + (cur === k ? ' active' : '') + '">' +
      '<span class="hpname" style="color:' + cc + '">' + name + '</span>' +
      '<span class="hearts">' + hearts + '</span>' +
      '<span class="hpscore">' + done + '/' + vs.deck.length + '</span></div>';
  }).join('');
  vs.pop = null;
}

function vsRenderStep() {
  if (!vs || vs.over) return;
  if (vs.qi >= vs.queue.length) { vsFinish(); return; }
  const step = vs.queue[vs.qi], q = vs.deck[step.q];
  const name = step.p === 'p1' ? vs.p1 : vs.p2;
  const cc = step.p === 'p1' ? 'var(--accent)' : 'var(--accent2)';
  const pr = document.getElementById('vsProg');
  if (pr) pr.textContent = (vs.qi + 1) + ' / ' + vs.queue.length;
  const bn = document.getElementById('vsTurnBanner');
  if (bn) {
    bn.innerHTML = '<span class="badge" style="background:' + cc + '22;color:' + cc + ';font-size:.74rem">LƯỢT CỦA ' + escHTML(name.toUpperCase()) + '</span>' +
      '<div class="tiny" style="margin-top:5px">Chọn đáp án — sai mất 1 ❤️, đúng 3 câu liền được +1 ❤️</div>';
  }
  const tp = TOPICS[q.t] || TOPICS.dt;
  const body = document.getElementById('vsBody');
  if (body) {
    body.innerHTML = '<div class="qcard">' +
      '<div class="between"><span class="qnum">Câu ' + (step.q + 1) + '</span>' +
      '<span class="badge" style="background:' + tp.c + '1f;color:' + tp.c + '">' + tp.n + '</span></div>' +
      '<div class="qtext">' + q.q + '</div>' +
      '<div class="grid" style="gap:5px">' + q.o.map(function (o, j) {
        return '<button class="opt" id="vs_' + j + '" onclick="vsPick(' + j + ')"><span class="k">' + 'ABCD'[j] + '</span><span>' + o + '</span></button>';
      }).join('') + '</div></div>';
  }
  vs.stepT0 = performance.now();
  vsRenderHp();
}

function vsPick(j) {
  if (!vs || vs.over) return;
  const step = vs.queue[vs.qi], q = vs.deck[step.q];
  const ok = ansCorrect(q, j);
  vs.ans[step.p][step.q] = j;
  vs.spent[step.p] += (performance.now() - vs.stepT0) / 1000;
  for (let k = 0; k < 4; k++) {
    const el = document.getElementById('vs_' + k);
    if (!el) continue;
    el.disabled = true;
    el.style.opacity = k === j ? '1' : '.45';
    if (k === j) {
      el.style.borderColor = ok ? 'var(--ok)' : 'var(--bad)';
      el.style.boxShadow = '0 0 0 1px ' + (ok ? 'var(--ok)' : 'var(--bad)');
    }
  }
  if (ok) {
    vs.streak[step.p]++;
    if (vs.streak[step.p] > vs.best[step.p]) vs.best[step.p] = vs.streak[step.p];
    if (vs.streak[step.p] % 3 === 0 && vs.hp[step.p] < vs.maxHp) {
      vs.hp[step.p]++;
      beep(940, 0.08);
      toast('❤️', '+1 mạng', (step.p === 'p1' ? vs.p1 : vs.p2) + ' đúng ' + vs.streak[step.p] + ' câu liền!', 1800);
    } else beep(760, 0.05);
  } else {
    vs.streak[step.p] = 0;
    vs.hp[step.p] = Math.max(0, vs.hp[step.p] - 1);
    vs.pop = { k: step.p, i: vs.hp[step.p] };
    beep(280, 0.09);
  }
  vsRenderHp();
  setTimeout(function () {
    if (!vs || vs.over) return;
    if (vs.hp[step.p] <= 0) { vsFinish('Hết mạng'); return; }
    vs.qi++;
    vsRenderStep();
  }, 560);
}

function vsFinish(reason) {
  if (!vs || vs.over) return;
  vs.over = true;
  clearInterval(vs.timer);
  const total = vs.deck.length;
  const res = ['p1', 'p2'].map(function (k) {
    let correct = 0;
    vs.deck.forEach(function (q, i) { if (ansCorrect(q, vs.ans[k][i])) correct++; });
    return {
      k: k, name: k === 'p1' ? vs.p1 : vs.p2, correct: correct,
      hp: vs.hp[k], score: +(correct / total * 10).toFixed(2),
      spent: Math.round(vs.spent[k])
    };
  });
  let w;
  if (res[0].score !== res[1].score) w = res[0].score > res[1].score ? 0 : 1;
  else if (res[0].hp !== res[1].hp) w = res[0].hp > res[1].hp ? 0 : 1;
  else w = res[0].spent <= res[1].spent ? 0 : 1;

  const cc = ['var(--accent)', 'var(--accent2)'];
  const colHtml = res.map(function (r, i) {
    return '<div class="vscol' + (i === w ? ' win' : '') + '">' +
      '<div class="vn" style="color:' + cc[i] + '">' + (i === w ? '👑 ' : '') + escHTML(r.name) + '</div>' +
      '<div class="vp" style="color:' + cc[i] + '">' + r.score.toFixed(2) + '</div>' +
      '<div class="vmeta">' + r.correct + '/' + total + ' câu đúng</div>' +
      '<div class="vmeta">❤️ còn ' + r.hp + '/' + vs.maxHp + ' · ⏱ ' + Math.floor(r.spent / 60) + ':' + String(r.spent % 60).padStart(2, '0') + '</div>' +
      '</div>';
  }).join('');

  /* v5.6 — VS cùng máy: đáp án chi tiết + giải thích */
  const review = vs.deck.map(function (q, i) {
    return '<details class="acc mp-review">' +
      '<summary><span class="qnum">' + (i + 1) + '</span><span style="flex:1">' + escHTML(q.q) + '</span></summary>' +
      '<div class="body"><div><b style="color:var(--ok)">Đáp án đúng:</b> ' + 'ABCD'[q.a] + '. ' + escHTML(q.o[q.a]) + '</div>' +
      '<div style="margin-top:4px">P1: ' + (vs.ans.p1[i] === undefined ? 'Bỏ trống' : 'ABCD'[vs.ans.p1[i]]) +
        ' · P2: ' + (vs.ans.p2[i] === undefined ? 'Bỏ trống' : 'ABCD'[vs.ans.p2[i]]) + '</div>' +
      (q.why ? '<div class="whybox"><b>Vì sao:</b> ' + q.why + '</div>' : '') +
      (q.tip ? '<div class="tiny" style="margin-top:5px;color:var(--accent2)">💡 ' + q.tip + '</div>' : '') +
      '</div></details>';
  }).join('');

  const box = document.getElementById('vsResult');
  if (box) {
    box.style.display = '';
    box.innerHTML =
      '<div class="card pad" style="text-align:center;margin-bottom:10px">' +
      '<div class="tiny" style="letter-spacing:.12em;text-transform:uppercase">' + (reason || 'Kết thúc') + '</div>' +
      '<div style="font-size:1.15rem;font-weight:800;margin-top:4px;background:linear-gradient(100deg,var(--accent),var(--accent2) 60%,var(--nebula));-webkit-background-clip:text;background-clip:text;color:transparent">' +
      escHTML(res[w].name) + ' thắng!</div>' +
      '<div class="tiny" style="margin-top:3px">' + escHTML(res[0].name) + ' ' + res[0].score.toFixed(2) + ' — ' + res[1].score.toFixed(2) + ' ' + escHTML(res[1].name) + '</div>' +
      '</div>' +
      '<div class="vsgrid" style="margin-bottom:10px">' + colHtml + '</div>' +
      '<div class="row" style="gap:6px;margin-bottom:10px">' +
      '<button class="btn pri wide" onclick="vsAgain()"><i class="fa-solid fa-rotate-right"></i> Đấu lại</button>' +
      '<button class="btn wide" onclick="vsExit()"><i class="fa-solid fa-house"></i> Về menu</button></div>' +
      '<details class="acc"><summary><i class="fa-solid fa-list-ol" style="color:var(--accent);font-size:.75rem"></i><span>Xem lại từng câu</span></summary>' +
      '<div class="body">' + review + '</div></details>';
  }
  document.getElementById('vsRoom').style.display = 'none';

  HISTORY.add({
    mode: 'vs', date: Date.now(), score: res[w].score,
    p1: res[0].name, p2: res[1].name, s1: res[0].score, s2: res[1].score,
    winner: res[w].name, correct: res[w].correct, total: total
  });
  ACH.bump('vsWin');
  if (ACH.counters.vsWin >= 1) ACH.unlock('vs1');
  if (ACH.counters.vsWin >= 5) ACH.unlock('vs5');
  if (res[w].hp === vs.maxHp) ACH.unlock('hpfull');
  ACH.bump('exams');
  if (ACH.counters.exams >= 1) ACH.unlock('first');
  if (ACH.counters.exams >= 10) ACH.unlock('ten');

  confettiBurst();
  beep(880, 0.16);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function vsAgain() {
  document.getElementById('vsResult').style.display = 'none';
  document.getElementById('examConfig').style.display = '';
  document.getElementById('vsRoom').style.display = 'none';
  vs = null;
  openVsModal();
}
function vsExit() {
  clearInterval(vs && vs.timer);   /* v4.3 — không để interval chạy với vs = null */
  clearInterval(timerId); timerId = null; endAt = 0;
  document.getElementById('vsResult').style.display = 'none';
  document.getElementById('vsRoom').style.display = 'none';
  document.getElementById('examConfig').style.display = '';
  vs = null;
  setExamMode('solo');
  go('exam');
}
function quitVs() {
  if (vs && !vs.over && !confirm('Thoát trận đấu? Kết quả sẽ không được lưu.')) return;
  clearInterval(vs && vs.timer);
  clearInterval(timerId); timerId = null; endAt = 0;
  vs = null;
  document.getElementById('vsRoom').style.display = 'none';
  document.getElementById('examConfig').style.display = '';
  setExamMode('solo');
}

/* ---------------------------------------------------------
   v2.0 · HOOK VÀO LUỒNG THI CŨ (không sửa hàm gốc)
   --------------------------------------------------------- */
const __renderExam = renderExam;
renderExam = function () {
  __renderExam();
  if (examStyle === 'practice') {
    exam.mcq.forEach(function (q, i) {
      const card = document.querySelectorAll('#examBody .qcard')[i];
      if (!card) return;
      if (!document.getElementById('why' + i)) {
        const d = document.createElement('div');
        d.className = 'exp';
        d.id = 'why' + i;
        d.style.display = 'none';
        card.appendChild(d);
      }
    });
  }
};

const __pickM = pickM;
pickM = function (i, j) {
  __pickM(i, j);
  if (examStyle !== 'practice') return;
  const q = exam.mcq[i];
  for (let k = 0; k < 4; k++) {
    const el = document.getElementById('m' + i + '_' + k);
    if (!el) continue;
    if (k === q.a) el.classList.add('ok');
    else if (k === j) el.classList.add('bad');
  }
  const box = document.getElementById('why' + i);
  if (box) {
    box.style.display = '';
    box.innerHTML = '<span class="tip"><i class="fa-solid fa-check"></i> Đáp án ' + 'ABCD'[q.a] + '</span>' +
      q.why + '<span class="trap"><i class="fa-solid fa-triangle-exclamation"></i> Bẫy: ' + q.trap + '</span>';
  }
};

const __startExam = startExam;
startExam = function () {
  __startExam();
  if (examStyle === 'practice') {
    clearInterval(timerId);
    const tb = document.getElementById('timerBadge');
    if (tb) { tb.textContent = '∞'; tb.style.color = 'var(--accent2)'; }
  }
};

const __gradeExam = gradeExam;
gradeExam = function (auto) {
  __gradeExam(auto);
  try {
    const score = parseFloat((document.getElementById('repScore') || {}).textContent || '0') || 0;
    let correct = 0, total = 0;
    exam.mcq.forEach(function (q, i) { total++; if (ansCorrect(q, answers.mcq[i])) correct++; });
    exam.tf.forEach(function (q, i) { q.sub.forEach(function (s, j) { total++; if (answers.tf[i + '_' + j] === s.ans) correct++; }); });
    exam.short.forEach(function (q, i) { total++; if (normAns(answers.short[i]) === normAns(q.ans)) correct++; });

    HISTORY.add({ mode: 'solo', date: Date.now(), score: score, correct: correct, total: total, style: examStyle });
    ACH.bump('exams');
    if (ACH.counters.exams >= 1) ACH.unlock('first');
    if (ACH.counters.exams >= 10) ACH.unlock('ten');
    if (score >= 9.995) ACH.unlock('perfect');
    if (exam.mcq.length >= 3) ACH.unlock('streak');
    if (new Date().getHours() >= 23 || new Date().getHours() < 4) ACH.unlock('night');
  } catch (e) { }
};

/* ---------------------------------------------------------
   v2.0 · LAB+ : thử thách, demo, hướng dẫn, click thông tin
   --------------------------------------------------------- */
const EXPLORE = { data: {} };
function markExplored(k, val) {
  const key = labIdx;
  if (!EXPLORE.data[key]) EXPLORE.data[key] = {};
  if (!EXPLORE.data[key][k]) EXPLORE.data[key][k] = [];
  if (EXPLORE.data[key][k].indexOf(val) < 0) EXPLORE.data[key][k].push(val);
}
function exploreDone(i) {
  const l = LABS[i], d = EXPLORE.data[i] || {};
  return l.controls.every(function (ct) {
    const seen = d[ct.k] || [];
    if (ct.type === 'range') return seen.indexOf(ct.min) >= 0 && seen.indexOf(ct.max) >= 0;
    return ct.opts.every(function (o) { return seen.indexOf(o[0]) >= 0; });
  });
}

/* Thử thách riêng cho từng lab — trả về mảng {t, ok} */
function labChallenges(i) {
  const l = LABS[i], v = l.v || {};
  const spec = LAB_CHAL[i];
  const list = [];
  if (spec) spec.forEach(function (s) { list.push({ t: s.t, ok: !!s.ok(v) }); });
  if (!exploreDone(i)) list.push({ t: 'Thử hết mọi lựa chọn của thanh điều khiển', ok: false });
  else list.push({ t: 'Thử hết mọi lựa chọn của thanh điều khiển', ok: true });
  return list;
}

const LAB_CHAL = {
  0: [{ t: 'Làm O₂ trong phòng tụt xuống mức nguy hiểm', ok: function (v) { return v.lux < 120 && v.win === 0 && v.people >= 3; } }],
  2: [{ t: 'Tạo được điện thế hoạt động có đỉnh dương', ok: function (v) { return v.mode === 0; } }],
  4: [{ t: 'Làm enzyme catalase mất hoạt tính', ok: function (v) { return v.temp >= 90 || v.mode === 1; } }],
  7: [{ t: 'Đóng khí khổng bằng ABA', ok: function (v) { return v.aba >= 80; } }],
  8: [{ t: 'Chuyển sang con đường lên men', ok: function (v) { return v.o2 <= 10; } }],
  10: [{ t: 'Đi hết 4 kỳ của nguyên phân', ok: function (v) { return v.ph === 3; } }],
  11: [{ t: 'Tạo ra 4 loại giao tử khác nhau', ok: function (v) { return v.xo === 1; } }],
  12: [{ t: 'Đẩy chạc tái bản mở tới 100%', ok: function (v) { return v.sp >= 100; } }],
  14: [{ t: 'Gây đột biến làm lệch khung đọc', ok: function (v) { return v.type >= 2; } }],
  15: [{ t: 'Làm Hb bão hoà xuống dưới 88%', ok: function (v) { var a = 40 + 65 * v.vent / 100; var o = 40 + (a - 40) * (v.area / 100); var p = Math.pow(o, 2.7); return 100 * p / (p + Math.pow(26, 2.7)) < 88; } }],
  16: [{ t: 'Tạo nước tiểu loãng trên 20 mL/phút', ok: function (v) { return 125 * v.pres / 100 * (1 - v.reab / 100) > 20; } }],
  17: [{ t: 'Xem phép lai hai cặp tính trạng', ok: function (v) { return v.cross >= 2; } }],
  18: [{ t: 'Tìm phép lai cho 100% con trai bệnh', ok: function (v) { return v.cross === 1; } }],
  19: [{ t: 'Đi tới bậc chromatid', ok: function (v) { return v.lvl === 4; } }],
  20: [{ t: 'Đặt nền tối với áp lực chọn lọc ≥ 60%', ok: function (v) { return v.bg === 1 && v.sel >= 60; } }],
  21: [{ t: 'Đưa tần số allele A về đúng 50%', ok: function (v) { return v.p === 50; } }],
  22: [{ t: 'Mở thông tin của một nhánh trên cây', ok: function () { return (LABS[22]._seen || 0) > 0; } }]
};

function renderLabChal() {
  const box = document.getElementById('labChal');
  if (!box) return;
  const list = labChallenges(labIdx);
  const doneN = list.filter(function (x) { return x.ok; }).length;
  box.innerHTML = '<div class="between" style="margin-bottom:5px"><b class="xs"><i class="fa-solid fa-flag-checkered" style="color:var(--warn)"></i> Thử thách</b>' +
    '<span class="mono tiny">' + doneN + '/' + list.length + '</span></div>' +
    list.map(function (x) {
      return '<div class="chal ' + (x.ok ? 'done' : '') + '"><i class="fa-solid ' + (x.ok ? 'fa-circle-check' : 'fa-circle') + '"></i><span>' + x.t + '</span></div>';
    }).join('');
  if (doneN === list.length && !box.dataset.done) {
    box.dataset.done = '1';
    ACH.bump('chal');
    if (ACH.counters.chal >= 5) ACH.unlock('chal');
    confettiBurst();
    toast('🏅', 'Hoàn thành thử thách!', 'Thí nghiệm ' + (labIdx + 1) + ' — ' + LABS[labIdx].name, 3000);
  }
  if (doneN < list.length) delete box.dataset.done;
}

const __labSet = labSet;
labSet = function (k, val, btn) {
  __labSet(k, val, btn);
  markExplored(k, LABS[labIdx].v[k]);
  renderLabChal();
};

const __selectLab = selectLab;
selectLab = function (i) {
  __selectLab(i);
  ACH.seeLab(i);
  renderLabChal();
};

const __renderLabMeta = renderLabMeta;
renderLabMeta = function () {
  __renderLabMeta();
  renderLabChal();
};

const __resetLab = resetLab;
resetLab = function () {
  __resetLab();
  EXPLORE.data[labIdx] = {};
  renderLabChal();
};

/* Tự chạy demo: lần lượt đưa từng tham số về các cực trị */
let demoTimer = null;
function runLabDemo() {
  clearTimeout(demoTimer);
  const l = LABS[labIdx];
  const seq = [];
  l.controls.forEach(function (ct) {
    if (ct.type === 'range') { seq.push({ [ct.k]: ct.min }); seq.push({ [ct.k]: ct.max }); }
    else ct.opts.forEach(function (o) { seq.push({ [ct.k]: o[0] }); });
  });
  const use = seq.slice(0, 6);
  let k = 0;
  toast('▶️', 'Đang tự chạy demo', 'Thí nghiệm ' + (labIdx + 1) + ' — ' + use.length + ' bước', 2200);
  (function step() {
    if (k >= use.length) { demoTimer = setTimeout(function () { resetLab(); }, 1200); return; }
    Object.assign(l.v, use[k]);
    renderLabMeta();
    beep(560 + k * 40, 0.03);
    k++;
    demoTimer = setTimeout(step, 2000);
  })();
}

/* Hướng dẫn từng bước: phát lần lượt các bước của LABX */
let guideTimer = null;
function labGuide() {
  clearTimeout(guideTimer);
  const x = LABX[labIdx];
  const steps = (x && x.steps) || [];
  if (!steps.length) { toast('ℹ️', 'Chưa có hướng dẫn', 'Thí nghiệm này chưa có các bước gợi ý.'); return; }
  const ctl = document.getElementById('labControls');
  if (ctl) {
    ctl.classList.add('tourhl');
    setTimeout(function () { ctl.classList.remove('tourhl'); }, steps.length * 3000 + 800);
  }
  let k = 0;
  (function step() {
    if (k >= steps.length) return;
    toast('🧭', 'Bước ' + (k + 1) + '/' + steps.length, steps[k], 2800);
    beep(680, 0.03);
    k++;
    guideTimer = setTimeout(step, 3000);
  })();
}

function toggleLabLabels() {
  const l = LABS[labIdx];
  if (!l) return;
  if ('show' in l.v) l.v.show = l.v.show ? 0 : 1;
  else l.v.labels = l.v.labels ? 0 : 1;
  renderLabMeta();
  beep(520, 0.03);
}


/* ============================================================
   v5.1 · LAB UX — kéo để chỉnh, chạm để đọc số, ghim ảnh so sánh,
   ngẫu nhiên hoá, sparkline biến thiên. Hoạt động cho MỌI lab.
   ============================================================ */
let labGhostOn = false, labSpark = [];
function labHud(text) {
  const el = document.getElementById('labHudVal');
  if (!el) return;
  el.textContent = text;
  clearTimeout(labHud._t);
  labHud._t = setTimeout(function () {
    const l = LABS[labIdx];
    const r = l && document.getElementById('ro_' + l.readouts[0][0]);
    if (el) el.textContent = r ? r.textContent : '—';
  }, 1800);
}
function labFirstRange() {
  const l = LABS[labIdx];
  return l ? (l.controls.find(function (c) { return c.type === 'range'; }) || null) : null;
}
function labSnapVal(ct, v) {
  const step = +ct.step || 1, min = +ct.min, max = +ct.max;
  let x = Math.round((v - min) / step) * step + min;
  x = Math.max(min, Math.min(max, x));
  return +x.toFixed(6);
}
function labSyncSlider(ct, v) {
  const inp = document.querySelector('#labControls input[type="range"][oninput*="' + ct.k + '"]');
  if (inp) inp.value = v;
}
function labShowTip(cx, cy) {
  const tip = document.getElementById('labTip');
  if (!tip || !labCv) return;
  const l = LABS[labIdx];
  const rows = l.readouts.slice(0, 3).map(function (r) {
    const el = document.getElementById('ro_' + r[0]);
    return '<div class="rowx"><span>' + r[1] + '</span><b>' + (el ? el.textContent : '—') + '</b></div>';
  }).join('');
  tip.innerHTML = rows;
  const w = labCv._w || 1;
  tip.style.left = Math.max(6, Math.min(w - 150, cx - 70)) + 'px';
  tip.style.top = Math.max(6, cy - 64) + 'px';
  tip.classList.add('on');
  clearTimeout(labShowTip._t);
  labShowTip._t = setTimeout(function () { tip.classList.remove('on'); }, 2400);
}
function labToggleCtl() {
  const box = document.getElementById('labControls');
  const btn = document.getElementById('btnLabCtl');
  if (!box) return;
  const hidden = box.classList.toggle('lab-collapsed');
  if (btn) btn.classList.toggle('on', !hidden);
  beep(hidden ? 420 : 620, .04);
}
function labRandomize() {
  const l = LABS[labIdx];
  if (!l) return;
  l.controls.forEach(function (ct) {
    if (ct.type === 'range') {
      const step = +ct.step || 1;
      const n = Math.floor((+ct.max - +ct.min) / step);
      l.v[ct.k] = +(+ct.min + Math.floor(Math.random() * (n + 1)) * step).toFixed(6);
    } else if (ct.opts && ct.opts.length) {
      l.v[ct.k] = ct.opts[Math.floor(Math.random() * ct.opts.length)][0];
    }
  });
  renderLabMeta();
  labHud('🎲 Đã ngẫu nhiên hoá');
  beep(700, .05);
}
function labToggleGhost() {
  const g = document.getElementById('labGhost');
  const b = document.getElementById('btnLabSnap');
  if (!g || !labCv) return;
  if (labGhostOn) {
    labGhostOn = false; g.classList.remove('on'); if (b) b.classList.remove('on');
    labHud('Đã bỏ ghim'); return;
  }
  const w = Math.round(labCv._w || 0), h = Math.round(labCv._h || 0);
  if (!w || !h) return;
  g.width = w; g.height = h;
  const gc = g.getContext('2d');
  gc.clearRect(0, 0, w, h);
  try { gc.drawImage(labCv, 0, 0, w, h); } catch (e) { return; }
  g.classList.add('on'); labGhostOn = true;
  if (b) b.classList.add('on');
  labHud('📌 Đã ghim — kéo để so sánh');
  beep(760, .05);
}
function labPushSpark() {
  if (currentView !== 'lab' || document.hidden) return;
  const l = LABS[labIdx];
  if (!l) return;
  const el = document.getElementById('ro_' + l.readouts[0][0]);
  const raw = el ? String(el.textContent) : '';
  const v = parseFloat(raw.replace(/[^\d.\-]/g, ''));
  if (!isFinite(v)) return;
  labSpark.push(v);
  if (labSpark.length > 90) labSpark.shift();
  const now = document.getElementById('labSparkNow');
  if (now) now.textContent = raw;
  const nm = document.getElementById('labSparkName');
  if (nm) nm.textContent = l.readouts[0][1];
  const c = document.getElementById('labSpark');
  if (!c) return;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const cw = c.clientWidth || 300, ch = 44;
  if (c.width !== Math.round(cw * dpr)) { c.width = Math.round(cw * dpr); c.height = Math.round(ch * dpr); }
  const g = c.getContext('2d');
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
  g.clearRect(0, 0, cw, ch);
  if (labSpark.length < 2) return;
  let mn = labSpark[0], mx = labSpark[0];
  for (let i = 1; i < labSpark.length; i++) { if (labSpark[i] < mn) mn = labSpark[i]; if (labSpark[i] > mx) mx = labSpark[i]; }
  const span = (mx - mn) || 1;
  g.beginPath();
  for (let i = 0; i < labSpark.length; i++) {
    const x = i / (labSpark.length - 1) * cw;
    const y = ch - 4 - ((labSpark[i] - mn) / span) * (ch - 8);
    if (i) g.lineTo(x, y); else g.moveTo(x, y);
  }
  g.strokeStyle = '#00f3ff'; g.lineWidth = 1.6; g.lineJoin = 'round'; g.stroke();
  g.lineTo(cw, ch); g.lineTo(0, ch); g.closePath();
  const gr = g.createLinearGradient(0, 0, 0, ch);
  gr.addColorStop(0, 'rgba(0,243,255,.30)');
  gr.addColorStop(1, 'rgba(0,243,255,0)');
  g.fillStyle = gr; g.fill();
}
let labBindTries = 0;
function labBindUX() {
  if (!labCv) { if (labBindTries++ < 40) setTimeout(labBindUX, 120); return; }
  if (labCv.__ux51) return;
  labCv.__ux51 = true;
  const __box = document.getElementById('labControls');
  if (__box && root.dataset.device === 'phone') __box.classList.add('lab-collapsed');
  labCv.style.touchAction = 'pan-y';
  let drag = false, moved = false, sx = 0, sy = 0, base = 0;
  labCv.addEventListener('pointerdown', function (e) {
    drag = true; moved = false; sx = e.clientX; sy = e.clientY;
    const ct = labFirstRange();
    base = ct ? +LABS[labIdx].v[ct.k] : 0;
    try { labCv.setPointerCapture(e.pointerId); } catch (er) { }
  });
  labCv.addEventListener('pointermove', function (e) {
    if (!drag) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (!moved && Math.abs(dx) < 8) return;
    if (!moved && Math.abs(dy) > Math.abs(dx)) { drag = false; return; }
    moved = true;
    const ct = labFirstRange();
    if (!ct) return;
    const w = labCv._w || 1;
    const v = labSnapVal(ct, base + (dx / w) * (+ct.max - +ct.min));
    if (String(LABS[labIdx].v[ct.k]) !== String(v)) {
      labSet(ct.k, v);
      labSyncSlider(ct, v);
      labHud(ct.label + ': ' + v + (ct.unit || ''));
    }
  });
  function end(e) {
    if (drag && !moved && e && e.clientX != null) {
      const r = labCv.getBoundingClientRect();
      labShowTip(e.clientX - r.left, e.clientY - r.top);
    }
    drag = false;
    setTimeout(function () { moved = false; }, 0);
  }
  labCv.addEventListener('pointerup', end);
  labCv.addEventListener('pointercancel', function () { drag = false; });
  labCv.addEventListener('click', function (e) {
    if (moved) { e.stopPropagation(); e.preventDefault(); }
  }, true);
  labCv.addEventListener('dblclick', function () { resetLab(); labHud('↺ Đã về mặc định'); });
  document.addEventListener('keydown', function (e) {
    if (currentView !== 'lab') return;
    if (e.target && /INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const ct = labFirstRange();
    if (!ct) return;
    const step = (+ct.step || 1) * (e.shiftKey ? 5 : 1);
    const v = labSnapVal(ct, +LABS[labIdx].v[ct.k] + (e.key === 'ArrowRight' ? step : -step));
    labSet(ct.k, v); labSyncSlider(ct, v);
    labHud(ct.label + ': ' + v + (ct.unit || ''));
    e.preventDefault();
  });
  setInterval(labPushSpark, 650);
  setInterval(function () {
    if (currentView !== 'lab' || document.hidden) return;
    const l = LABS[labIdx];
    const r = l && document.getElementById('ro_' + l.readouts[0][0]);
    const el = document.getElementById('labHudVal');
    if (r && el) el.textContent = r.textContent;
  }, 900);
}
const __selectLab51 = selectLab;
selectLab = function (i) {
  labSpark = []; labGhostOn = false;
  const g = document.getElementById('labGhost'); if (g) g.classList.remove('on');
  const b = document.getElementById('btnLabSnap'); if (b) b.classList.remove('on');
  const r = __selectLab51(i);
  setTimeout(labPushSpark, 160);
  return r;
};
try { labBindUX(); } catch (e) { console.warn('[labux]', e); }

/* click vào canvas → lab nào có onClick thì gọi */
(function bindLabClick() {
  const cv = document.getElementById('labCanvas');
  if (!cv) return;
  cv.style.cursor = 'pointer';
  cv.addEventListener('click', function (e) {
    const l = LABS[labIdx];
    if (!l || typeof l.onClick !== 'function') return;
    const r = cv.getBoundingClientRect();
    try { l.onClick(e.clientX - r.left, e.clientY - r.top, cv._w, cv._h); } catch (err) { }
  });
})();

/* ---------------------------------------------------------
   v2.0 · NGÂN HÀNG — tải thêm tự động khi cuộn
   --------------------------------------------------------- */
(function bindBankAutoLoad() {
  const more = document.getElementById('bankMore');
  if (!more || !window.IntersectionObserver) return;
  const io = new IntersectionObserver(function (ents) {
    ents.forEach(function (en) { if (en.isIntersecting) loadMoreBank(); });
  }, { rootMargin: '220px' });
  io.observe(more);
  const __renderBank = renderBank;
  renderBank = function (reset) {
    __renderBank(reset);
    if (bankShown < bankData().length) { more.style.display = ''; io.observe(more); }
    ACH.counters.bankSeen = Math.max(ACH.counters.bankSeen || 0, bankShown);
    store.set('counters', ACH.counters);
    if (ACH.counters.bankSeen >= 100) ACH.unlock('bank');
  };
})();

/* ---------------------------------------------------------
