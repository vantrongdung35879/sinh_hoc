document.addEventListener('visibilitychange', function () {
  if (document.hidden) {
    if (typeof labRaf === 'number') cancelAnimationFrame(labRaf);
    if (vs && vs.timer) clearInterval(vs.timer);
  } else {
    if (currentView === 'lab' && labCtx) { labLoop(performance.now()); }
    if (vs && !vs.over && vs.timer === null) vsStartTimer();
  }
});

