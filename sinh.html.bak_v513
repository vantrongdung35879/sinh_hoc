<div class="modal hide" id="submitModal">
  <div class="box">
    <div class="row" style="gap:9px;margin-bottom:8px">
      <div class="logo" style="width:36px;height:36px"><i class="fa-solid fa-clipboard-check"></i></div>
      <div>
        <h3 class="tt">Nộp bài?</h3>
        <div class="tiny" id="submitInfo">—</div>
      </div>
    </div>
    <p class="xs muted" style="margin:8px 0 14px">Hệ thống sẽ chấm ngay theo thang điểm 10 và hiển thị lời giải chi tiết từng câu.</p>
    <div class="row" style="gap:6px">
      <button class="btn wide" onclick="closeSubmit()">Làm tiếp</button>
      <button class="btn pri wide" onclick="gradeExam()">Nộp bài</button>
    </div>
  </div>
</div>

<script>
/* =========================================================
   v5.0 — KHOÁ CHỦ (PBKDF2 VERIFIER) · NO KEY · KẾT NỐI KHÁC MẠNG
   ========================================================= */
/* v5.0 — không còn mã khoá chủ dạng raw. So sánh bằng PBKDF2 100k + salt
   cố định, cùng thuật toán với admin.html nên vẫn đồng bộ đa máy. */
const MASTER_VERIFIER = 'fhC9q-gmO1MudcCqnEjLkWBhSZEYvY7jgNpA9kYZp3U';
const MASTER_SALT = 'BG4-GLOBAL-ADMIN-STATIC-v4.2';
const MASTER_ITER = 100000;
let __bg4MasterCache = {};
function bg4CtEq(x, y) {
  const a = String(x), b = String(y);
  if (a.length !== b.length) return false;
  let d = 0;
  for (let i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return d === 0;
}
function bg4B64u(buf) {
  const b = new Uint8Array(buf); let str = '';
  for (let i = 0; i < b.length; i++) str += String.fromCharCode(b[i]);
  return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
async function bg4MasterOK(v) {
  const s = String(v == null ? '' : v);
  if (!s || !crypto.subtle) return false;
  if (Object.prototype.hasOwnProperty.call(__bg4MasterCache, s)) return __bg4MasterCache[s];
  let ok = false;
  try {
    const enc = new TextEncoder();
    const base = await crypto.subtle.importKey('raw', enc.encode(s), 'PBKDF2', false, ['deriveBits']);
    const bits = await crypto.subtle.deriveBits(
      { name: 'PBKDF2', salt: enc.encode(MASTER_SALT), iterations: MASTER_ITER, hash: 'SHA-256' },
      base, 256);
    ok = bg4CtEq(bg4B64u(bits), MASTER_VERIFIER);
  } catch (e) { }
  __bg4MasterCache = {}; __bg4MasterCache[s] = ok;
  return ok;
}

/* ICE: STUN + TURN relay công khai. Khác mạng / NAT đối xứng / 4G
   thường chỉ kết nối được qua TURN — đây là lý do cũ hay báo lỗi. */
const BG4_ICE = [
  { urls: 'stun:stun.l.google.com:19302' },
  { urls: 'stun:stun1.l.google.com:19302' },
  { urls: 'stun:stun.cloudflare.com:3478' },
  { urls: 'stun:global.stun.twilio.com:3478' },
  { urls: 'turn:global.relay.metered.ca:80?transport=udp', username: 'openrelayproject', credential: 'openrelayproject' },
  { urls: 'turn:global.relay.metered.ca:80?transport=tcp', username: 'openrelayproject', credential: 'openrelayproject' },
  { urls: 'turn:global.relay.metered.ca:443?transport=tcp', username: 'openrelayproject', credential: 'openrelayproject' }
];
function bg4PeerOpts(extra) {
  /* auto = STUN + TURN (khác mạng), lan = chỉ STUN (cùng mạng, nhanh),
     relay = ép TURN (mạng khó / NAT đối xứng). */
  let ice = BG4_ICE;
  if (BG4_NETMODE === 'lan') ice = BG4_ICE.filter(function (x) { return /^stun:/.test(x.urls); });
  else if (BG4_NETMODE === 'relay') ice = BG4_ICE.filter(function (x) { return /^turn:/.test(x.urls); });
  return Object.assign({
    debug: 0,
    config: {
      iceServers: ice,
      iceTransportPolicy: 'all',
      iceCandidatePoolSize: 10
    }
  }, extra || {});
}

/* ---------- v4.3 — công tắc dùng mạng ---------- */
let netEnabled = false;   /* đọc từ store ở initV4, TRÁNH dùng `store` trước khi khai báo (TDZ) */
let BG4_NETMODE = 'auto';   /* auto | lan | relay — chủ phòng chọn */

/* v4.4 — MỘT chế độ duy nhất: 1 người = Solo, 2–15 người = phòng online.
   style 'auto': CÓ mạng -> 'old' (làm bài kiểu cũ), KHÔNG mạng -> 'new' (kiểu mới). */
const UNIFIED = {
  players: 1,
  style: 'auto',
  hp: 3,          /* v5.6 — số mạng/tim, tự do chỉnh */
  grace: 20,      /* v5.6 — số giây chờ sau người nộp đầu tiên */
  netMode: 'auto',
  getStyle: function () {
    if (this.style === 'old' || this.style === 'new') return this.style;
    return netEnabled ? 'old' : 'new';
  }
};
function uniSetPlayers(v, live) {
  let n = Math.floor(Number(v));
  if (!Number.isFinite(n)) n = 1;
  UNIFIED.players = Math.max(1, Math.min(15, n));
  if (!live) { const el = document.getElementById('uniPlayers'); if (el) el.value = UNIFIED.players; }
  try { store.set('uni_players', UNIFIED.players); } catch (e) { }
  uniUpdateHint();
  try {
    if (typeof MP !== 'undefined' && MP.role === 'host' && UNIFIED.players >= 2) {
      mpSetCfgMany({ max: UNIFIED.players });
    }
  } catch (e) { }
}
function uniSetTime(v, live) {
  let n = Math.floor(Number(v));
  if (!Number.isFinite(n)) n = 50;
  n = Math.max(1, Math.min(600, n));
  const s = document.getElementById('cfgTime'); if (s) s.value = n;
  if (!live) { const el = document.getElementById('uniTimeMin'); if (el) el.value = n; }
  try { syncCfg('time'); } catch (e) { }
}
function uniSetN(v, live) {
  let n = Math.floor(Number(v));
  if (!Number.isFinite(n)) n = 18;
  n = Math.max(0, Math.min(200, n));
  const s = document.getElementById('cfgMCQ'); if (s) s.value = n;
  if (!live) { const el = document.getElementById('uniMCQ'); if (el) el.value = n; }
  try { syncCfg('mcq'); } catch (e) { }
}
/* Đổi slider / bấm preset -> cập nhật ngược lại 2 ô số cho khớp. */
const __syncCfgUni = syncCfg;
syncCfg = function (k) {
  const r = __syncCfgUni(k);
  try {
    const a = document.getElementById('uniTimeMin'), b = document.getElementById('uniMCQ');
    const tEl = document.getElementById('cfgTime'), mEl = document.getElementById('cfgMCQ');
    if (a && tEl) a.value = tEl.value;
    if (b && mEl) b.value = mEl.value;
  } catch (e) { }
  return r;
};
function uniSetStyle(s) {
  UNIFIED.style = (s === 'old' || s === 'new') ? s : 'auto';
  try { store.set('uni_style', UNIFIED.style); } catch (e) { }
  try {
    document.querySelectorAll('#segUniStyle button').forEach(function (b) {
      b.classList.toggle('on', b.dataset.s === UNIFIED.style);
    });
  } catch (e) { }
  uniUpdateHint();
  try {
    if (typeof MP !== 'undefined' && MP.role === 'host') {
      mpSetCfgMany({ playStyle: UNIFIED.getStyle() });
    }
  } catch (e) { }
  try { beep(600, .025); } catch (e) { }
}
function uniUpdateHint() {
  const el = document.getElementById('uniHint'); if (!el) return;
  const n = UNIFIED.players, st = UNIFIED.getStyle();
  const tag = UNIFIED.style === 'auto' ? 'Tự động' : (UNIFIED.style === 'old' ? 'Chọn tay: kiểu cũ' : 'Chọn tay: kiểu mới');
  if (n === 1) {
    el.innerHTML = '👤 <b>1 người → Solo</b> (kiểu mới): đề đầy đủ Trắc nghiệm / Đúng-Sai / Trả lời ngắn, chấm điểm &amp; lời giải chi tiết, không cần mạng. <i>' + tag + '</i>';
  } else if (st === 'old') {
    el.innerHTML = '👥 <b>' + n + ' người dự kiến · kiểu cũ</b>: làm <b>từng câu một theo thứ tự</b>, không bảng câu, không nhảy cóc. Phòng <b>chứa tới 15 người</b>; chỉnh giới hạn trong bảng chủ phòng. <i>' + tag + '</i>';
  } else {
    el.innerHTML = '👥 <b>' + n + ' người dự kiến · kiểu mới</b>: bảng câu, chuyển câu tự do, mỗi người khác thứ tự câu &amp; vị trí A/B/C/D, xếp hạng trực tiếp. Phòng <b>chứa tới 15 người</b>. <i>' + tag + '</i>';
  }
}
/* ---------- v5.6 · cấu hình mạng nâng cao ---------- */
function uniSetHp(v, live) {
  let n = Math.floor(Number(v)); if (!Number.isFinite(n)) n = 3;
  UNIFIED.hp = Math.max(1, Math.min(99, n));
  if (!live) { const el = document.getElementById('uniHp'); if (el) el.value = UNIFIED.hp; }
  try { store.set('uni_hp', UNIFIED.hp); } catch (e) { }
  try { NET.cfg.hp = UNIFIED.hp; } catch (e) { }
  try { MP.cfg.hp = UNIFIED.hp; } catch (e) { }
  try { if (MP.role === 'host') mpSetCfgMany({ hp: UNIFIED.hp }); } catch (e) { }
  try { beep(560, .02); } catch (e) { }
}
function uniSetGrace(v, live) {
  let n = Math.floor(Number(v)); if (!Number.isFinite(n)) n = 20;
  UNIFIED.grace = Math.max(5, Math.min(120, n));
  if (!live) { const el = document.getElementById('uniGrace'); if (el) el.value = UNIFIED.grace; }
  try { store.set('uni_grace', UNIFIED.grace); } catch (e) { }
  try { MP.cfg.grace = UNIFIED.grace; } catch (e) { }
  try { if (MP.role === 'host') mpSetCfgMany({ grace: UNIFIED.grace }); } catch (e) { }
  try { beep(560, .02); } catch (e) { }
}
function uniSetNetMode(v, live) {
  UNIFIED.netMode = (v === 'lan' || v === 'relay' || v === 'offline') ? v : 'auto';
  if (!live) { const el = document.getElementById('uniNetMode'); if (el) el.value = UNIFIED.netMode; }
  try { store.set('uni_netmode', UNIFIED.netMode); } catch (e) { }
  BG4_FORCE_OFFLINE = (UNIFIED.netMode === 'offline');
  BG4_NETMODE = (UNIFIED.netMode === 'lan' || UNIFIED.netMode === 'relay') ? UNIFIED.netMode : 'auto';
  try { if (MP.role === 'host') mpSetCfgMany({ netMode: BG4_NETMODE }); } catch (e) { }
  try {
    const hint = document.getElementById('netModeHint');
    if (hint && netEnabled) hint.textContent = 'Có mạng — ' +
      (UNIFIED.netMode === 'lan' ? 'cùng mạng LAN' : UNIFIED.netMode === 'relay' ? 'ép relay (mạng khó)' :
       UNIFIED.netMode === 'offline' ? 'offline, nhiều tab cùng máy' : 'tự động STUN + TURN');
  } catch (e) { }
  try { beep(580, .02); } catch (e) { }
}
function uniJoinRoom() {
  if (typeof ACCESS !== 'undefined' && ACCESS.isBasic()) { accessUpgrade('net'); return; }
  try { setNetMode(true, true); } catch (e) { }
  try { mpOpen(); MP.state = 'joining'; MP.err = ''; mpRender(); } catch (e) { }
}
function setNetMode(on, silent) {
  netEnabled = !!on;
  try { store.set('net_enabled', netEnabled); } catch (e) { }
  const a = document.getElementById('netOff'), b = document.getElementById('netOn');
  if (a) a.classList.toggle('on', !netEnabled);
  if (b) b.classList.toggle('on', netEnabled);
  /* v4.4 — modeNet đã gộp vào thẻ thiết lập, luôn ẩn; chỉ hiện lối tắt dạng cũ */
  ['modeNet', 'modeNetLegacy'].forEach(function (id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.display = (id === 'modeNetLegacy' && netEnabled) ? '' : 'none';
  });
  const hint = document.getElementById('netModeHint');
  if (hint) hint.textContent = netEnabled
    ? 'Có mạng — kiểu làm bài cũ (từng câu theo thứ tự)'
    : 'Không mạng — kiểu làm bài mới (bảng câu, tự do)';
  const adv = document.getElementById('netAdvCfg');
  if (adv) adv.style.display = netEnabled ? '' : 'none';
  const desc = document.getElementById('netModeDesc');
  if (desc) desc.innerHTML = netEnabled
    ? 'Phòng 2–15 người vẫn dùng chung chế độ <b>Làm bài</b>; bật mạng chỉ đổi <b>cách trình bày câu hỏi</b> sang kiểu cũ. Lối tắt <b>VS 2 MÁY dạng cũ</b> hiện ở dưới.'
    : 'Tắt mạng: Solo 1 người chạy kiểu mới. Chọn ≥2 người ở thẻ trên sẽ tự bật mạng để tạo phòng.';
  try { uniUpdateHint(); } catch (e) { }
  if (!netEnabled && (examMode === 'net' || examMode === 'netLegacy')) {
    try { setExamMode('solo'); } catch (e) { }
  }
  if (!silent) { try { beep(600, .03); } catch (e) { } }
}

/* ---------- chế độ truy cập ---------- */
const ACCESS = {
  KEY: 'bg4_mode',
  mode: 'full',
  _loaded: false,
  BASIC_VIEWS: ['theory', 'exam', 'settings', 'g11'],
  MCQ_MAX: 10,
  TIME_MAX: 15,
  load: function () {
    try { this.mode = localStorage.getItem(this.KEY) === 'nokey' ? 'nokey' : 'full'; } catch (e) { }
    this._loaded = true;
    return this.mode;
  },
  set: function (m) {
    this.mode = (m === 'nokey' ? 'nokey' : 'full');
    this._loaded = true;
    try { localStorage.setItem(this.KEY, this.mode); } catch (e) { }
    try { applyAccessUI(); } catch (e) { }
  },
  isBasic: function () {
    if (!this._loaded) this.load();
    return this.mode === 'nokey';
  },
  allowed: function (v) { return !this.isBasic() || this.BASIC_VIEWS.indexOf(v) >= 0; }
};

const ACCESS_LABEL = {
  lab: 'Thí nghiệm Lab', bank: 'Ngân hàng câu hỏi', essay: 'Tự luận',
  path: 'Lộ trình học', think: 'Bản đồ tư duy', net: 'Đấu online',
  vs: 'Đấu 2 người', tab: 'Đấu 2 tab', modePath: 'Lộ trình', casio: 'Casio BIO-HACKS', g11: 'Ôn lớp 11'
};
function accessUpgrade(what) {
  const name = ACCESS_LABEL[what] || 'Tính năng này';
  try { toast('🔒', name + ' cần mở khoá', 'Chế độ No Key chỉ gồm Lý thuyết & luyện tập cơ bản.', 3400); } catch (e) { }
  try { beep(280, .08); } catch (e) { }
  setTimeout(function () { try { gateShow(true); } catch (e) { } }, 240);
}
function exitNoKey() {
  try { gateShow(true); gateMsg('Nhập mã 6 số hoặc key dài hạn để mở toàn bộ tính năng.', 'ok'); }
  catch (e) { }
}
function enterNoKey() {
  ACCESS.set('nokey');
  try { AUTH.unlocked = true; } catch (e) { }
  try { gateMsg('Đang vào chế độ cơ bản…', 'ok'); beep(660, .08); } catch (e) { }
  setTimeout(function () {
    try { gateHide(); gateClearMsg(); } catch (e) { }
    currentView = 'theory';
    try {
      $$('.view').forEach(function (s) { s.classList.toggle('on', s.id === 'view-theory'); });
      $$('#dock button').forEach(function (b) { b.classList.toggle('on', b.dataset.v === 'theory'); });
    } catch (e) { }
    try { applyAccessUI(); } catch (e) { }
    try { toast('🎓', 'Chế độ No Key', 'Lý thuyết + tối đa 10 câu luyện tập cơ bản.', 3200); } catch (e) { }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }, 380);
}
function applyAccessUI() {
  const basic = ACCESS.isBasic();
  try {
    $$('#dock button').forEach(function (b) {
      const locked = basic && !ACCESS.allowed(b.dataset.v);
      b.classList.toggle('acc-locked', locked);
      let badge = b.querySelector('.lockbadge');
      if (locked && !badge) {
        badge = document.createElement('i');
        badge.className = 'lockbadge'; badge.textContent = '🔒';
        b.appendChild(badge);
      } else if (!locked && badge) badge.remove();
    });
  } catch (e) { }
  try {
    ['modeVs', 'modeTab', 'modePath', 'modeNet', 'modeNetLegacy'].forEach(function (id) {
      const el = document.getElementById(id);
      if (el) { el.style.opacity = basic ? '.45' : ''; el.style.filter = basic ? 'grayscale(.7)' : ''; }
    });
    const tf = document.getElementById('cfgTF'), sh = document.getElementById('cfgShort');
    if (tf) tf.disabled = basic;
    if (sh) sh.disabled = basic;
    const sc = document.getElementById('smartExCard');
    if (sc) sc.style.display = basic ? 'none' : '';
  } catch (e) { }
  let bar = document.getElementById('accBar');
  if (basic) {
    if (!bar) {
      bar = document.createElement('div');
      bar.id = 'accBar';
      bar.innerHTML = '<div class="accbar-in">' +
        '<span class="accbar-txt">🎓 <b>Chế độ No Key</b> — chỉ Lý thuyết &amp; luyện tập cơ bản (tối đa 10 câu).</span>' +
        '<button class="accbar-btn" onclick="exitNoKey()">🔓 Mở khoá đầy đủ</button></div>';
      document.body.appendChild(bar);
    }
  } else if (bar) bar.remove();
  try { requestAnimationFrame(syncDockInd); } catch (e) { }
}

/* =========================================================
   BIOCALAXY ENGINE
   ========================================================= */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
/* ============================================================
   v5.0 · TẦNG LƯU TRỮ IndexedDB
   - localStorage vẫn là cache đồng bộ (store.get/set giữ nguyên chữ ký).
   - Payload lớn / dữ liệu tích luỹ lâu dài được ghi vào IndexedDB,
     sau đó XOÁ bản localStorage để không bao giờ chạm trần ~5MB.
   - file:// hoặc trình duyệt chặn IDB -> tự động fall back localStorage
     và giữ bản trong RAM; KHÔNG bao giờ mất dữ liệu im lặng.
   ============================================================ */

/* ============================================================
   v5.1 · BG4_DEVICE — nhận diện máy và tự chỉnh kích thước
   phone / tablet / laptop / desktop; cập nhật khi xoay máy.
   ============================================================ */
const BG4_DEVICE = (function () {
  const coarse = window.matchMedia ? matchMedia('(pointer:coarse)') : null;
  let cur = null;
  function detect() {
    const manual = store.get('layout', 'auto');
    const w = window.innerWidth || 360, h = window.innerHeight || 640;
    const min = Math.min(w, h), max = Math.max(w, h);
    const ua = navigator.userAgent || '';
    const touch = (navigator.maxTouchPoints || 0) > 0 || !!(coarse && coarse.matches);
    const ipad = /iPad/.test(ua) || (/Macintosh/.test(ua) && touch);
    let type;
    /* Ưu tiên KÍCH THƯỚC KHUNG NHÌN (responsive thật), UA chỉ là gợi ý phụ.
       Nhờ vậy thu nhỏ cửa sổ desktop cũng cho bố cục phone/tablet đúng. */
    if (manual === 'phone') type = 'phone';
    else if (manual === 'desktop') type = (touch && w <= 1024) ? 'tablet' : 'desktop';
    else if (w <= 480 || (touch && h <= 480)) type = 'phone';   /* kể cả phone nằm ngang */
    else if (w <= 1024) type = 'tablet';
    else if (w <= 1440) type = 'laptop';
    else type = 'desktop';
    if (ipad && type === 'phone') type = 'tablet';
    return { type: type, w: w, h: h, min: min, max: max, touch: touch,
             dpr: window.devicePixelRatio || 1, landscape: w > h,
             cores: navigator.hardwareConcurrency || 4 };
  }
  function apply() {
    const d = detect(); cur = d;
    root.dataset.device = d.type;
    root.dataset.orient = d.landscape ? 'landscape' : 'portrait';
    root.dataset.touch = d.touch ? '1' : '0';
    root.style.setProperty('--vh', (d.h * 0.01) + 'px');
    root.style.setProperty('--lab-dpr', String(d.type === 'phone' ? Math.min(d.dpr, 1.5) : Math.min(d.dpr, 2)));
    /* máy yếu: gợi ý Lite ngay từ đầu (chỉ khi người dùng chưa từng chọn) */
    try {
      if (!store.get('gfxAsked', false) && d.type === 'phone' && d.cores <= 4) {
        root.dataset.gfx = 'lite';
        if (typeof PERF !== 'undefined') { PERF.lite = true; PERF.quality = 'low'; }
      }
    } catch (e) { }
    /* FPS hợp lý theo thiết bị */
    try {
      if (typeof Loop !== 'undefined') {
        const lite = root.dataset.gfx === 'lite';
        Loop.setFps('lab', lite ? 30 : (d.type === 'phone' ? 30 : d.type === 'tablet' ? 45 : 60));
        Loop.setFps('stars', lite ? 0 : (d.type === 'phone' ? 20 : 30));
      }
    } catch (e) { }
    return d;
  }
  function onResize() {
    clearTimeout(onResize._t);
    onResize._t = setTimeout(function () {
      const before = cur && cur.type;
      const d = apply();
      try { if (before !== d.type) resizeLab(); } catch (e) { }
    }, 140);
  }
  try {
    window.addEventListener('resize', onResize, { passive: true });
    window.addEventListener('orientationchange', onResize, { passive: true });
  } catch (e) { }
  return { detect: detect, apply: apply, current: function () { return cur; }, onResize: onResize };
})();

const BG4_IDB = (function () {
  const NAME = 'bioGalaxy5', VER = 1, ST = 'kv';
  let dbp = null, dead = false;
  function db() {
    if (dead) return Promise.reject(new Error('IDB_UNAVAILABLE'));
    if (dbp) return dbp;
    dbp = new Promise(function (res, rej) {
      try {
        if (typeof indexedDB === 'undefined' || !indexedDB) { dead = true; return rej(new Error('IDB_UNAVAILABLE')); }
        const r = indexedDB.open(NAME, VER);
        r.onupgradeneeded = function () { if (!r.result.objectStoreNames.contains(ST)) r.result.createObjectStore(ST); };
        r.onsuccess = function () { res(r.result); };
        r.onerror = function () { dead = true; rej(r.error || new Error('IDB_OPEN_FAILED')); };
        r.onblocked = function () { dead = true; rej(new Error('IDB_BLOCKED')); };
      } catch (e) { dead = true; rej(e); }
    });
    return dbp;
  }
  function tx(mode, fn) {
    return db().then(function (d) {
      return new Promise(function (res, rej) {
        try {
          const t = d.transaction(ST, mode), s = t.objectStore(ST), rq = fn(s);
          t.oncomplete = function () { res(rq ? rq.result : undefined); };
          t.onerror = function () { rej(t.error || new Error('IDB_TX_FAILED')); };
          t.onabort = function () { rej(t.error || new Error('IDB_TX_ABORT')); };
        } catch (e) { rej(e); }
      });
    });
  }
  return {
    available: function () { return !dead; },
    get: function (k) { return tx('readonly', function (s) { return s.get(k); }).catch(function () { return undefined; }); },
    put: function (k, v) { return tx('readwrite', function (s) { return s.put(v, k); }).catch(function () { return false; }); },
    del: function (k) { return tx('readwrite', function (s) { return s.delete(k); }).catch(function () { return false; }); },
    keys: function () { return tx('readonly', function (s) { return s.getAllKeys(); }).catch(function () { return []; }); }
  };
})();

/* Những khoá tích luỹ: luôn ưu tiên IDB. */
const BG4_BIG_KEYS = ['history', 'match_history', 'progress4', 'review4', 'mp_results', 'bank_ext'];
const __bg4Mem = Object.create(null);
const __bg4IdbQ = Object.create(null);
const BG4_BIG_LIMIT = 12000;

const store = {
  get(k, d) {
    if (Object.prototype.hasOwnProperty.call(__bg4Mem, k)) return __bg4Mem[k];
    try { const v = localStorage.getItem('bg_' + k); if (v !== null) { const p = JSON.parse(v); __bg4Mem[k] = p; return p; } }
    catch (e) { }
    return d;
  },
  set(k, v) {
    __bg4Mem[k] = v;                       /* luôn có bản RAM ngay lập tức */
    let raw = '';
    try { raw = JSON.stringify(v); } catch (e) { return; }
    const big = BG4_BIG_KEYS.indexOf(k) >= 0 || raw.length > BG4_BIG_LIMIT;
    /* Ghi localStorage trước để không mất dữ liệu nếu IDB chưa sẵn sàng. */
    try { localStorage.setItem('bg_' + k, raw); } catch (e) { }
    if (!big) return;
    clearTimeout(__bg4IdbQ[k]);
    __bg4IdbQ[k] = setTimeout(function () {
      BG4_IDB.put(k, v).then(function (ok) {
        if (ok === false) return;         /* IDB lỗi -> giữ nguyên bản localStorage */
        try { localStorage.removeItem('bg_' + k); } catch (e) { }
      });
    }, 280);
  }
};

/** API bất đồng bộ cho dữ liệu lớn (dùng khi cần đọc chắc chắn từ đĩa). */
const BG4_STORE = {
  get: async function (k, d) {
    if (Object.prototype.hasOwnProperty.call(__bg4Mem, k)) return __bg4Mem[k];
    const v = await BG4_IDB.get(k);
    if (v !== undefined) { __bg4Mem[k] = v; return v; }
    return store.get(k, d);
  },
  set: async function (k, v) { store.set(k, v); return BG4_IDB.put(k, v); },
  stats: async function () {
    const keys = await BG4_IDB.keys();
    let lsBytes = 0;
    try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); lsBytes += (k.length + (localStorage.getItem(k) || '').length) * 2; } } catch (e) { }
    return { idb: BG4_IDB.available(), keys: keys.length, localStorageBytes: lsBytes };
  }
};

/** Ngân hàng câu hỏi mở rộng: thêm câu do giáo viên/học sinh tự soạn, lưu IDB. */
const BG4_BANK_EXT = {
  add: async function (q) {
    if (!q || !q.q || !Array.isArray(q.o) || q.o.length !== 4 || !(q.a >= 0 && q.a <= 3)) return false;
    const list = (await BG4_STORE.get('bank_ext', [])) || [];
    list.push({ t: q.t || 'dt', d: q.d || 2, q: q.q, o: q.o, a: q.a,
      tip: q.tip || '', why: q.why || '', trap: q.trap || '', custom: true });
    await BG4_STORE.set('bank_ext', list);
    MCQS.push(list[list.length - 1]);
    return true;
  },
  all: async function () { return (await BG4_STORE.get('bank_ext', [])) || []; },
  clear: async function () { await BG4_STORE.set('bank_ext', []); }
};

/** Nạp lại dữ liệu từ IDB lúc khởi động (IDB là async, store.get là sync). */
async function bg4HydrateStore() {
  try {
    const keys = await BG4_IDB.keys();
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i];
      const v = await BG4_IDB.get(k);
      if (v === undefined) continue;
      __bg4Mem[k] = v;
      let lsHas = false;
      try { lsHas = localStorage.getItem('bg_' + k) !== null; } catch (e) { }
      if (lsHas) continue;               /* localStorage mới hơn -> không ghi đè */
      if (k === 'history' && typeof HISTORY !== 'undefined') HISTORY.list = Array.isArray(v) ? v : [];
      else if (k === 'match_history' && typeof MATCH_HIST !== 'undefined') MATCH_HIST.list = Array.isArray(v) ? v : [];
      else if (k === 'progress4' && typeof PROG !== 'undefined') PROG.d = v || PROG.d;
      else if (k === 'review4' && typeof REV !== 'undefined') REV.box = v || {};
      else if (k === 'bank_ext' && typeof MCQS !== 'undefined' && Array.isArray(v)) {
        v.forEach(function (q) { if (!q.custom) q.custom = true; MCQS.push(q); });
      }
    }
    const box = document.getElementById('view-settings');
    if (box && !document.getElementById('idbStatus')) {
      const el = document.createElement('div');
      el.id = 'idbStatus'; el.className = 'tiny';
      el.style.cssText = 'margin-top:10px;color:var(--text3);text-align:center';
      const st = await BG4_STORE.stats();
      el.textContent = '💾 Lưu trữ: ' + (st.idb ? 'IndexedDB' : 'localStorage (IDB không khả dụng)') +
        ' · ' + st.keys + ' khoá · cache ' + Math.round(st.localStorageBytes / 1024) + ' KB';
      box.appendChild(el);
    }
    /* v5.1 — hiển thị thiết bị đã nhận diện + nút chỉnh tay */
    if (box && !document.getElementById('devInfo')) {
      const d = (typeof BG4_DEVICE !== 'undefined') ? BG4_DEVICE.detect() : null;
      const dev = document.createElement('div');
      dev.id = 'devInfo'; dev.className = 'tiny';
      dev.style.cssText = 'margin-top:6px;color:var(--text3);text-align:center';
      const label = { phone: 'Điện thoại', tablet: 'Máy tính bảng', laptop: 'Laptop', desktop: 'Máy tính để bàn' };
      dev.textContent = '📱 Thiết bị: ' + (d ? (label[d.type] || d.type) : '—') +
        (d ? ' · ' + d.w + '×' + d.h + ' · ' + (d.touch ? 'cảm ứng' : 'chuột') : '');
      box.appendChild(dev);
    }
  } catch (e) { }
}
try { bg4HydrateStore(); } catch (e) { }

/* 1.5 — nhãn kỳ thi đặt một chỗ. Đổi năm thi chỉ cần sửa dòng dưới.
   (Bước 3 sẽ gom toàn bộ hằng số vào CONFIG.) */
const APP_LABEL = 'Sinh học 12 • Ôn thi TN THPT';
let audioOn = store.get('sound', true);
let actx = null;
function beep(f = 560, d = .045, type = 'sine') {
  if (!audioOn) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    if (actx.state === 'suspended') actx.resume();
    const o = actx.createOscillator(), g = actx.createGain();
    o.type = type; o.frequency.value = f;
    g.gain.setValueAtTime(.035, actx.currentTime);
    g.gain.exponentialRampToValueAtTime(.0001, actx.currentTime + d);
    o.connect(g); g.connect(actx.destination);
    o.start(); o.stop(actx.currentTime + d);
  } catch (e) {}
}

/* ---------- THEME / LAYOUT ---------- */
const root = document.documentElement;
function applyTheme() {
  const mode = store.get('theme', 'dark');
  const dark = mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
  root.classList.add('no-anim');
  root.dataset.theme = dark ? 'dark' : 'light';
  const btn = $('#btnTheme');
  if (btn) btn.innerHTML = `<i class="fa-solid fa-${dark ? 'moon' : 'sun'}"></i>`;
  const meta = document.querySelector('meta[name=theme-color]');
  if (meta) meta.setAttribute('content', dark ? '#070a13' : '#eff7f3');
  $$('#segTheme button').forEach((b, i) => b.classList.toggle('on', ['light', 'dark', 'auto'][i] === mode));
  requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('no-anim')));
}
function setTheme(m) { store.set('theme', m); applyTheme(); beep(700, .04); }
function cycleTheme() {
  const order = ['dark', 'light', 'auto'];
  const cur = store.get('theme', 'dark');
  setTheme(order[(order.indexOf(cur) + 1) % 3]);
}
function applyLayout() {
  const l = store.get('layout', 'auto');
  root.dataset.layout = l === 'desktop' ? 'auto' : l;
  if (l === 'desktop') root.dataset.layout = 'auto';
  const icon = l === 'phone' ? 'fa-mobile-screen-button' : (l === 'desktop' ? 'fa-display' : 'fa-tablet-screen-button');
  const b = $('#btnLayout'); if (b) b.innerHTML = `<i class="fa-solid fa-${icon}"></i>`;
  $$('#segLayout button').forEach((x, i) => x.classList.toggle('on', ['auto', 'phone', 'desktop'][i] === l));
  try { BG4_DEVICE.apply(); } catch (e) { }
  requestAnimationFrame(resizeLab);
}
function setLayout(l) { store.set('layout', l); applyLayout(); beep(640, .04); }
function cycleLayout() {
  const o = ['auto', 'phone', 'desktop'];
  const c = store.get('layout', 'auto');
  setLayout(o[(o.indexOf(c) + 1) % 3]);
}
function setSize(s) { store.set('size', s); root.dataset.size = s; $$('#segSize button').forEach((b, i) => b.classList.toggle('on', ['sm', 'md', 'lg'][i] === s)); beep(600, .03); }
function applySize() {
  const s = store.get('size', 'md');
  root.dataset.size = s;
  $$('#segSize button').forEach((b, i) => b.classList.toggle('on', ['sm', 'md', 'lg'][i] === s));
}
function applyFx() {
  const on = store.get('fx', true);
  root.dataset.fx = on ? 'on' : 'off';
  const sw = $('#swFx');
  if (sw) { sw.classList.toggle('on', on); sw.setAttribute('aria-checked', on ? 'true' : 'false'); }
}
function toggleFx() { store.set('fx', !store.get('fx', true)); applyFx(); beep(520, .04); }
function toggleSound() {
  audioOn = !audioOn; store.set('sound', audioOn);
  $('#swSound').classList.toggle('on', audioOn);
  $('#swSound').setAttribute('aria-checked', audioOn ? 'true' : 'false');
  $('#btnSound').innerHTML = `<i class="fa-solid fa-volume-${audioOn ? 'high' : 'xmark'}"></i>`;
  if (audioOn) beep(760, .06);
}
function applySound() {
  $('#swSound').classList.toggle('on', audioOn);
  $('#swSound').setAttribute('aria-checked', audioOn ? 'true' : 'false');
  $('#btnSound').innerHTML = `<i class="fa-solid fa-volume-${audioOn ? 'high' : 'xmark'}"></i>`;
}
function resetAll() {
  /* v5.5 — FIX: câu confirm cũ ghi "xóa tiến độ" nhưng thực tế chỉ xóa tùy chỉnh.
     Nay nói đúng phạm vi và xóa đủ các khóa giao diện/hiệu ứng. */
  if (!confirm('Đặt lại giao diện, cỡ chữ, hiệu ứng và âm thanh về mặc định?\n(Tiến độ học, lịch sử thi và hồ sơ được GIỮ NGUYÊN.)')) return;
  ['theme', 'layout', 'size', 'fx', 'sound', 'accent', 'font', 'density', 'gfx', 'examStyle', 'quality']
    .forEach(k => localStorage.removeItem('bg_' + k));
  Object.keys(localStorage).filter(k => k.indexOf('bg_fx4_') === 0)
    .forEach(k => localStorage.removeItem(k));
  location.reload();
}

/* ---------- tiện ích chống chèn HTML (dùng cho tên người chơi, mã lỗi…) ---------- */
function escHTML(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c];
  });
}
function cleanPlayerName(s) {
  return String(s == null ? '' : s).replace(/<[^>]*>/g, '').replace(/[\x00-\x1f\x7f]/g, '').trim().slice(0, 14) || 'Bạn';
}

/* ---------- NAV ---------- */
let currentView = 'theory';
function go(v) {
  if (typeof ACCESS !== 'undefined' && ACCESS.isBasic() && !ACCESS.allowed(v)) {
    accessUpgrade(v); return;
  }
  if (v === currentView) { syncDockInd(); window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
  /* v5.5 — FIX: rời tab khi đang thi từng để timer chạy tiếp và phòng thi vẫn mở,
     dẫn tới tự nộp bài ở tab khác / bíp chuông vô cớ. Giờ dừng timer + đóng phòng. */
  if (currentView === 'exam' && v !== 'exam') {
    const __room = document.getElementById('examRoom');
    if (__room && __room.style.display !== 'none') {
      if (timerId) { clearInterval(timerId); timerId = null; }
      __room.style.display = 'none';
      try { toast('i-triangle-exclamation', 'Đã thoát bài thi', 'Bài làm tạm thời không được lưu.', 2600); } catch (e) { }
    }
  }
  currentView = v;
  beep(540, .035);
  $$('.view').forEach(s => s.classList.toggle('on', s.id === 'view-' + v));
  $$('#dock button').forEach(b => b.classList.toggle('on', b.dataset.v === v));
  syncDockInd();
  if (v === 'lab') requestAnimationFrame(() => { resizeLab(); });
  if (v === 'bank' && !bankRendered) renderBank(true);
  if (v === 'think' && !thinkRendered) { renderThink(); thinkRendered = true; }
  if (v === 'think' && typeof DIAG !== 'undefined') DIAG.open();
  if (v === 'settings') { renderVipCard(); try { bg4RefreshUuid(); } catch (e) { } }
  if (v === 'casio') renderCasio();
  if (v === 'g11') renderG11();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
let thinkRendered = false;

/** v4.3 — căn GIỮA tuyệt đối thanh chỉ báo theo tab đang active. */
function syncDockInd() {
  try {
    const dock = document.getElementById('dock');
    const ind = document.getElementById('dockInd');
    const btn = dock && dock.querySelector('button.on');
    if (!dock || !ind || !btn) { if (ind) ind.classList.remove('on'); return; }
    const dr = dock.getBoundingClientRect(), br = btn.getBoundingClientRect();
    /* left của absolute tính từ PADDING EDGE, còn rect tính từ BORDER EDGE
       -> trừ clientLeft (bề dày border) để hết lệch 1px. Không dùng
       transform để animation không bao giờ ghi đè lại tâm thanh. */
    /* v5.6 — dock trên điện thoại cuộn ngang nên phải cộng scrollLeft,
       nếu không thanh chỉ thị sẽ lệch khi vuốt sang tab khác. */
    const cx = br.left - dr.left + br.width / 2 + (dock.scrollLeft || 0);
    const half = (ind.offsetWidth || 16) / 2;
    ind.style.left = (cx - (dock.clientLeft || 0) - half) + 'px';
    if (dock.scrollWidth > dock.clientWidth + 2) {
      const target = btn.offsetLeft - (dock.clientWidth - btn.offsetWidth) / 2;
      const want = Math.max(0, target);
      if (Math.abs((dock.scrollLeft || 0) - want) > 2) {
        try { dock.scrollTo({ left: want, behavior: 'smooth' }); }
        catch (e) { dock.scrollLeft = want; }
        setTimeout(syncDockInd, 360);   /* chỉ gọi lại khi thật sự có cuộn */
      }
    }
    ind.style.transform = 'none';
    ind.classList.add('on');
  } catch (e) { }
}
if (typeof window !== 'undefined') {
  window.addEventListener('resize', function () { requestAnimationFrame(syncDockInd); });
  window.addEventListener('orientationchange', function () { setTimeout(syncDockInd, 120); });
}

/* ---------- STARFIELD ---------- */
const starCv = $('#stars'), starCtx = starCv.getContext('2d');
let stars = [];
function initStars() {
  starCv.width = innerWidth; starCv.height = innerHeight;
  const __devS = (typeof BG4_DEVICE !== 'undefined' && BG4_DEVICE.detect) ? BG4_DEVICE.detect() : null;
  const __starCap = __devS && __devS.type === 'phone' ? 46 : (__devS && __devS.type === 'tablet' ? 70 : 110);
  stars = Array.from({ length: Math.min(__starCap, Math.round(innerWidth / 14)) }, () => ({
    x: Math.random() * starCv.width, y: Math.random() * starCv.height,
    r: Math.random() * 1.4 + .35, p: Math.random() * Math.PI * 2,
    s: Math.random() * .02 + .004,
    c: Math.random() > .82 ? 'rgba(139,124,246,' : (Math.random() > .5 ? 'rgba(61,220,151,' : 'rgba(160,200,255,')
  }));
}
function drawStars() {
  if (root.dataset.fx === 'off') { starCtx.clearRect(0, 0, starCv.width, starCv.height); starRaf = 0; return; }
  starCtx.clearRect(0, 0, starCv.width, starCv.height);
  for (const s of stars) {
    s.p += s.s;
    const a = .25 + Math.abs(Math.sin(s.p)) * .55;
    starCtx.fillStyle = s.c + a.toFixed(2) + ')';
    starCtx.beginPath(); starCtx.arc(s.x, s.y, s.r, 0, 6.283); starCtx.fill();
  }
}

/* =========================================================
   1. LÝ THUYẾT
   ========================================================= */
const THEORY = [
  { icon: 'fa-arrows-spin', tag: 'Di truyền phân tử', title: 'Tái bản DNA — 5 điều quyết định mọi câu hỏi', body: `
    <ul>
      <li><b>Nguyên tắc:</b> bổ sung (A–T, G–C) + bán bảo tồn (mỗi DNA con giữ 1 mạch mẹ).</li>
      <li><b>Chiều:</b> mạch mới <b>luôn</b> tổng hợp 5'→3'. Vì DNA polymerase chỉ gắn nucleotide vào đầu <b>3'–OH</b> tự do.</li>
      <li><b>Hệ quả:</b> hai mạch khuôn đối chiều → một mạch làm liên tục (dẫn đầu), một mạch làm gián đoạn thành đoạn Okazaki (theo sau).</li>
      <li><b>Enzyme:</b> helicase mở xoắn → primase đặt mồi RNA → DNA pol III kéo dài → DNA pol I thay mồi bằng DNA → ligase nối phosphodiester.</li>
      <li><b>Công thức:</b> sau <i>k</i> lần nhân đôi: số DNA con = 2<sup>k</sup>; số nucleotide môi trường cấp = N(2<sup>k</sup> − 1); số liên kết H bị phá = H(2<sup>k</sup> − 1).</li>
    </ul>
    <div class="divider"></div>
    <b>Bẫy thi:</b> “ligase nối đoạn Okazaki” đúng, nhưng ligase <b>không</b> nối hai mạch đơn với nhau — nó nối hai đoạn trên <b>cùng một mạch</b>.` },

  { icon: 'fa-scroll', tag: 'Di truyền phân tử', title: 'Phiên mã — vì sao chỉ một mạch được chọn?', body: `
    <ul>
      <li>RNA polymerase bám <b>promoter</b> (vùng điều hòa, đầu 3' của mạch mã gốc) và tổng hợp RNA 5'→3'.</li>
      <li>Mạch khuôn (mạch gốc) có chiều <b>3'→5'</b>; mRNA tạo ra bổ sung và <b>cùng chiều</b> với mạch bổ sung.</li>
      <li>Nhân sơ: mRNA dùng ngay. Nhân thực: mRNA sơ khai → cắt intron, nối exon, gắn mũ 5' (7-methylguanosine) và đuôi poly-A → ra tế bào chất.</li>
      <li><b>Splicing thay thế</b> là lý do một gen tạo được nhiều loại protein.</li>
    </ul>
    <b>Bản chất:</b> phiên mã chỉ <i>sao chép thông tin</i>, không tạo kiểu hình. Kiểu hình chỉ xuất hiện sau dịch mã.` },

  { icon: 'fa-table-cells-large', tag: 'Di truyền phân tử', title: 'Dịch mã & mã di truyền', body: `
    <ul>
      <li>Bộ ba mở đầu <b>5'-AUG-3'</b>: nhân thực → Met; nhân sơ → fMet. Bộ ba kết thúc: UAA, UAG, UGA (không mã hóa acid amin).</li>
      <li>Ribosome trượt trên mRNA theo chiều 5'→3', đọc codon; tRNA mang anticodon <b>đối chiều</b>.</li>
      <li><b>Tính đặc hiệu:</b> một codon chỉ mã hóa một acid amin. <b>Tính thoái hóa:</b> một acid amin có thể do nhiều codon.</li>
      <li>Số acid amin của chuỗi hoàn chỉnh = (số codon) − 1 (bỏ mã kết thúc) − 1 (bỏ Met mở đầu) = N/3 − 2.</li>
    </ul>
    <b>Bẫy:</b> hỏi “đọc theo chiều 3'→5'” thì phải <b>viết ngược</b> từng bộ ba: 5'-UAG-3' ⇔ 3'-GAU-5'.` },

  { icon: 'fa-dna', tag: 'Di truyền phân tử', title: 'Đột biến gen — phân loại theo hậu quả protein', body: `
    <ul>
      <li><b>Thay thế</b> 1 cặp nucleotide: đồng nghĩa (không đổi acid amin), sai nghĩa (đổi 1 acid amin), vô nghĩa (tạo codon kết thúc sớm).</li>
      <li><b>Thêm / mất</b> 1 cặp → <b>dịch khung</b>: toàn bộ acid amin phía sau sai lệch, hậu quả nặng nhất.</li>
      <li>Đột biến ở vùng điều hòa → đổi mức biểu hiện; ở intron → có thể hỏng điểm cắt nối.</li>
      <li>Đột biến là <b>nguồn nguyên liệu sơ cấp</b> của tiến hóa; phần lớn là trung tính hoặc có hại, một ít có lợi.</li>
    </ul>` },

  { icon: 'fa-sitemap', tag: 'NST', title: 'Đột biến cấu trúc & số lượng NST', body: `
    <ul>
      <li><b>Mất đoạn</b> → mất gen (hội chứng Cri-du-chat). <b>Lặp đoạn</b> → tăng liều gen (tạo gen mới). <b>Đảo đoạn</b> → đổi trật tự, thường ít hại nhưng giảm khả năng sinh sản. <b>Chuyển đoạn</b> → đổi vị trí gen giữa các NST.</li>
      <li><b>Lệch bội:</b> 2n±1 (thể một, thể ba). <b>Đa bội:</b> 3n, 4n… Đa bội lẻ thường bất thụ (không tạo giao tử cân bằng) → ứng dụng tạo quả không hạt.</li>
      <li>Thể tự đa bội: cùng loài nhân đôi bộ NST. Thể dị đa bội: lai xa + đa bội hóa (ví dụ khoai tây – cà chua).</li>
      <li>Đa bội phổ biến ở thực vật, hiếm ở động vật vì cơ chế xác định giới tính bị phá vỡ.</li>
    </ul>` },

  { icon: 'fa-scale-balanced', tag: 'Quy luật', title: 'Mendel và các tỉ lệ vàng', body: `
    <ul>
      <li>1 gen, trội hoàn toàn: F2 <b>3:1</b>; lai phân tích <b>1:1</b>. Trội không hoàn toàn: <b>1:2:1</b>.</li>
      <li>2 gen tương tác: bổ sung <b>9:7</b>, át chế <b>13:3</b> hoặc <b>12:3:1</b>, cộng gộp <b>15:1</b>.</li>
      <li>Hoán vị gen: tần số hoán vị = tỉ lệ giao tử tái tổ hợp; luôn ≤ 50%. Hai gen càng xa nhau càng dễ hoán vị.</li>
      <li>Liên kết gen hoàn toàn → giảm biến dị tổ hợp, giữ nhóm gen quý.</li>
      <li>Quần thể tự phối qua n lần: tỉ lệ dị hợp Aa = (1/2)<sup>n</sup>, đồng hợp = 1 − (1/2)<sup>n</sup>.</li>
    </ul>
    <b>Bản chất:</b> mọi tỉ lệ kiểu hình chỉ là <i>tổ hợp xác suất</i> của giao tử. Gặp tỉ lệ lạ → quy về số tổ hợp giao tử.` },

  { icon: 'fa-venus-mars', tag: 'Quy luật', title: 'Di truyền giới tính & tế bào chất', body: `
    <ul>
      <li>Gen trên X: di truyền <b>chéo</b> (bố → con gái → cháu trai); con trai biểu hiện bệnh nhiều hơn vì chỉ có 1 X.</li>
      <li>Gen trên Y: chỉ truyền cho con trai, di truyền thẳng dòng bố.</li>
      <li>Gen trong tế bào chất (ty thể, lục lạp): di truyền theo <b>dòng mẹ</b>, không phân li theo NST.</li>
    </ul>` },

  { icon: 'fa-leaf', tag: 'Thực vật', title: 'C3 – C4 – CAM: ba chiến lược cố định CO₂', body: `
    <ul>
      <li><b>C3:</b> Rubisco cố định CO₂ trực tiếp trong chu trình Calvin. Khi nóng, khí khổng đóng → CO₂ giảm, O₂ tăng → <b>hô hấp sáng</b>, năng suất giảm.</li>
      <li><b>C4:</b> PEP-carboxylase (ái lực CO₂ cực mạnh) ở tế bào mô giậu → vận chuyển C4 về tế bào bao bó mạch, nơi Rubisco hoạt động trong môi trường CO₂ cao. Lục lạp bao bó mạch <b>không có PS II</b> → không giải phóng O₂ nội sinh → triệt tiêu hô hấp sáng.</li>
      <li><b>CAM:</b> cố định CO₂ <b>ban đêm</b> (khí khổng mở), chuyển thành malate dự trữ trong không bào; ban ngày đóng khí khổng, giải phóng CO₂ cho Calvin.</li>
      <li>Hệ quả: C4 ưu thế ở cường độ sáng cao, nhiệt độ cao; CAM ưu thế ở sa mạc.</li>
    </ul>` },

  { icon: 'fa-droplet', tag: 'Thực vật', title: 'Khí khổng & dòng nước trong cây', body: `
    <ul>
      <li>Khí khổng mở khi tế bào hạt đậu <b>trương nước</b>: K⁺ vào → nước vào → tế bào cong → lỗ mở. ABA (khi hạn) làm K⁺ ra → khí khổng đóng.</li>
      <li>Thoát hơi nước: qua cutin (nhỏ), qua khí khổng (chủ yếu). Tốc độ tỉ lệ với <b>chu vi mép</b> lỗ khí (hiệu quả mép Stephan), không tỉ lệ diện tích.</li>
      <li>Cột nước trong mạch gỗ liên tục nhờ <b>liên kết hydrogen</b> + lực hút của lá (thoát hơi nước) + lực đẩy rễ. Bọt khí làm đứt cột nước → cây mất khả năng hút.</li>
      <li>Lá đứng (ngô): ánh sáng chiếu đều 2 mặt → khí khổng phân bố <b>cả hai mặt</b> gần như nhau.</li>
    </ul>` },

  { icon: 'fa-flask', tag: 'Thực vật', title: 'Khoáng & hoocmon thực vật', body: `
    <ul>
      <li><b>N</b>: thành phần protein, diệp lục → thiếu: lá vàng, còi. <b>Mg</b>: trung tâm diệp lục → thiếu: lá vàng từ lá già. <b>Fe</b>: cofactor tổng hợp diệp lục → thiếu: lá non vàng.</li>
      <li><b>Auxin (IAA):</b> kích thích giãn dài tế bào, hướng sáng, ưu thế ngọn; nồng độ cao gây ức chế.</li>
      <li><b>GA:</b> kích thích vươn dài lóng, nảy mầm, ra hoa. <b>ABA:</b> ức chế, gây ngủ, đóng khí khổng khi hạn.</li>
      <li><b>Êtylen:</b> chín quả, rụng lá, già hóa. <b>Xitôkinin:</b> phân chia tế bào, chậm già.</li>
    </ul>` },

  { icon: 'fa-bolt', tag: 'Động vật', title: 'Điện thế nghỉ → điện thế hoạt động', body: `
    <ul>
      <li><b>Điện thế nghỉ</b> ≈ −70 mV: do bơm Na⁺/K⁺ (3 Na⁺ ra, 2 K⁺ vào) + tính thấm chọn lọc của màng với K⁺.</li>
      <li>Giảm [K⁺] nội bào → ít K⁺ khuếch tán ra → bên trong <b>bớt âm</b> → điện thế nghỉ trôi lên −50 mV.</li>
      <li><b>Điện thế hoạt động:</b> khử cực (Na⁺ vào, đỉnh +30 mV) → tái cực (K⁺ ra) → phân cực lại (bơm Na/K).</li>
      <li>Bao myelin: dẫn truyền <b>nhảy cóc</b> → nhanh hơn nhiều. Sợi không myelin dẫn chậm.</li>
      <li>Synapse: Ca²⁺ vào chuỳ axon → túi chứa chất trung gian hoá học dung hợp màng → khe synapse → thụ thể màng sau.</li>
    </ul>` },

  { icon: 'fa-heart-pulse', tag: 'Động vật', title: 'Cân bằng nội môi: gan, đường huyết, thận', body: `
    <ul>
      <li><b>Sau ăn:</b> glucose máu tăng → tụy tiết insulin → gan/tế bào nhận glucose → tổng hợp glycogen.</li>
      <li><b>Đói:</b> glucagon + adrenalin → gan phân giải glycogen → glucose ra máu. Khi kiệt glycogen, <b>cortisol</b> tân tạo glucose từ protein/lipid.</li>
      <li><b>Gan khử độc:</b> khử amin acid amin → NH₃ → chu trình ornithine → urê (tan, thải qua thận).</li>
      <li><b>Gan</b> là nơi duy nhất tổng hợp albumin (giữ áp suất keo → chống phù) và các yếu tố đông máu.</li>
      <li><b>Thận:</b> lọc, tái hấp thu glucose/acid amin/nước; ADH tăng tái hấp thu nước → nước tiểu cô đặc.</li>
    </ul>` }
];

const ORGANELLES = [
  { n: 'Nhân', c: 'var(--warn)', d: 'Màng kép có lỗ nhân. Chứa nhiễm sắc thể (DNA + histone), là nơi tái bản và phiên mã. Nhân con đúc ribosome.' },
  { n: 'Lưới nội chất hạt', c: 'var(--bad)', d: 'Có ribosome bám. Tổng hợp protein tiết, protein màng; gấp cuộn và chuyển sang Golgi.' },
  { n: 'Lưới nội chất trơn', c: 'var(--ok)', d: 'Không có ribosome. Tổng hợp lipid, steroid; khử độc thuốc và chất lạ (nhiều ở gan).' },
  { n: 'Ribosome', c: 'var(--accent2)', d: 'Không màng, gồm rRNA + protein. Nơi dịch mã: đọc codon và nối acid amin.' },
  { n: 'Lục lạp', c: 'var(--accent)', d: 'Màng kép. Thylakoid chứa PS I/II (pha sáng); stroma chứa Rubisco (chu trình Calvin).' },
  { n: 'Ti thể', c: 'var(--nebula)', d: 'Màng trong gấp nếp thành cristae, chứa chuỗi truyền electron và ATP synthase. Nơi hô hấp hiếu khí.' },
  { n: 'Bộ máy Golgi', c: '#f472b6', d: 'Túi dẹt xếp chồng. Mặt cis nhận túi từ ER, mặt trans đóng gói và xuất bào; gắn đường (glycosyl hóa).' },
  { n: 'Lysosome', c: '#fb923c', d: 'Túi chứa enzyme thủy phân (pH acid). Tiêu hóa nội bào, tự thực, phân giải bào quan hỏng.' },
  { n: 'Peroxisome', c: '#22d3ee', d: 'Chứa catalase phân giải H₂O₂; tham gia β-oxy hóa acid béo rất dài.' },
  { n: 'Khung xương tế bào', c: '#94a3b8', d: 'Vi ống, vi sợi, sợi trung gian. Đường ray cho kinesin/dynein; tạo thoi phân bào.' },
  { n: 'Không bào', c: '#60a5fa', d: 'Túi lớn ở tế bào thực vật. Dự trữ nước, ion, sắc tố; tạo áp suất trương.' },
  { n: 'Màng sinh chất', c: '#34d399', d: 'Mô hình khảm lỏng: phospholipid + protein + cholesterol. Kiểm soát vận chuyển chọn lọc.' }
];

const LIVER = [
  { t: '1. Khử độc & chuyển hóa đạm', d: 'Khử amin acid amin dư → NH₃ (rất độc) → chu trình ornithine → urê tan trong nước, thận thải ra ngoài. Gan cũng khử độc rượu, thuốc qua hệ cytochrome P450.' },
  { t: '2. Cân bằng glucose máu', d: 'Insulin → gan dự trữ glucose dưới dạng glycogen. Glucagon/adrenalin → phân giải glycogen. Cortisol → tân tạo glucose từ acid amin và glycerol. Gan là “kho đệm” giữ đường huyết 0,8–1,2 g/L.' },
  { t: '3. Tổng hợp protein huyết tương', d: 'Gần như độc quyền: albumin (giữ áp suất keo, chống phù), fibrinogen & prothrombin (đông máu), globulin vận chuyển.' },
  { t: '4. Sản xuất mật', d: 'Muối mật nhũ tương hóa lipid thành giọt nhỏ → tăng diện tích cho lipase. Mật không chứa enzyme tiêu hóa. Sắc tố mật (bilirubin) từ phân giải hemoglobin.' },
  { t: '5. Dự trữ', d: 'Glycogen, vitamin A–D–E–K, vitamin B12, sắt (dạng ferritin). Là kho dự trữ máu (khoảng 0,5 L) khi mất máu.' },
  { t: '6. Tổng hợp & phân giải lipid', d: 'Tổng hợp cholesterol, acid béo, lipoprotein. β-oxy hóa acid béo tạo năng lượng khi đói kéo dài.' },
  { t: '7. Chức năng miễn dịch', d: 'Chứa tế bào Kupffer (đại thực bào) tiêu diệt vi khuẩn, hồng cầu già từ ruột về qua tĩnh mạch cửa.' }
];
/* =========================================================
   2. NGÂN HÀNG TRẮC NGHIỆM — 100 CÂU KHÔNG TRÙNG
   ========================================================= */
const TOPICS = {
  dt: { n: 'Di truyền phân tử', c: 'var(--accent2)' },
  dm: { n: 'Dịch mã & biểu hiện gene', c: '#f59e0b' },
  nst: { n: 'NST & đột biến', c: 'var(--nebula)' },
  ql: { n: 'Quy luật di truyền', c: '#f472b6' },
  tv: { n: 'Sinh lý thực vật', c: 'var(--accent)' },
  dv: { n: 'Động vật & người', c: 'var(--warn)' },
  tb: { n: 'Tế bào & gan', c: '#22d3ee' }
};

const MCQS = [
  { t:'dt', q:'Phân tử có cấu trúc 3 thùy cuộn gập, một đầu gắn acid amin và một thùy mang anticodon là:', o:['Gene','mRNA','tRNA','rRNA'], a:2, tip:'3 thùy + anticodon + gắn acid amin = tRNA.', why:'tRNA tự cuộn gập nhờ liên kết hydrogen nội phân tử, tạo thùy đối mã khớp codon trên mRNA.', trap:'mRNA là mạch thẳng, không mang acid amin.' },
  { t:'dt', q:'DNA polymerase chỉ có thể kéo dài mạch mới theo chiều 5′→3′. Hệ quả trực tiếp của điều này là:', o:['Hai mạch mới được tổng hợp theo hai cách khác nhau','DNA luôn tổng hợp theo chiều 3′→5′','Không cần enzyme tháo xoắn','Mạch mới không cần đoạn mồi'], a:0, tip:'Vì hai mạch khuôn đối chiều nhau.', why:'Một mạch khuôn cho phép tổng hợp liên tục (mạch dẫn đầu), mạch kia phải làm từng đoạn Okazaki (mạch theo sau).', trap:'Đây là hệ quả về cách tổng hợp, không phải về chiều của DNA.' },
  { t:'dt', q:'Enzyme nối liên kết phosphodiester giữa đầu 3′-OH của đoạn này với đầu 5′-P của đoạn kia trên cùng một mạch là:', o:['Helicase','Ligase','Primase','Topoisomerase'], a:1, tip:'Ligase = “keo dán” nối các đoạn Okazaki.', why:'Ligase xúc tác tạo liên kết phosphodiester để mạch mới liền lạc.', trap:'Ligase không nối hai mạch đơn với nhau.' },
  { t:'dt', q:'Vì sao DNA polymerase cần đoạn mồi RNA trước khi kéo dài?', o:['Vì nó chỉ gắn nucleotide vào đầu 3′-OH tự do có sẵn','Vì nó không nhận ra nucleotide tự do','Vì cần tạo mạch khuôn mới','Vì đoạn mồi mang tín hiệu kết thúc'], a:0, tip:'Không có 3′-OH thì không gắn được nucleotide.', why:'Primase tổng hợp đoạn mồi RNA tạo đầu 3′-OH khởi đầu cho DNA polymerase.', trap:'Đoạn mồi không phải mạch khuôn.' },
  { t:'dt', q:'Đoạn intron của gen phân mảnh ở sinh vật nhân thực có đặc điểm:', o:['Mã hóa acid amin','Không mang thông tin mã hóa acid amin và bị cắt bỏ khi trưởng thành mRNA','Nằm hoàn toàn ở đầu 3′ của gen','Là nơi ribosome bám vào'], a:1, tip:'Intron = vùng xen kẽ, bị cắt nối bỏ.', why:'mRNA sơ khai được splicing cắt intron, nối exon lại thành mRNA trưởng thành.', trap:'Exon mới là phần mã hóa.' },
  { t:'dt', q:'Ở sinh vật nhân thực, vùng điều hòa (promoter) của gen cấu trúc nằm ở:', o:['Đầu 3′ của mạch mã gốc','Đầu 5′ của mạch mã gốc','Giữa vùng mã hóa','Trên mạch bổ sung, đầu 3′'], a:0, tip:'Promoter nằm ở đầu 3′ mạch gốc.', why:'RNA polymerase nhận diện và bám vào promoter để khởi động phiên mã theo chiều 5′→3′ của mRNA.', trap:'Nhầm với đầu 5′ mạch gốc.' },
  { t:'dt', q:'Bộ ba kết thúc, khi đọc theo chiều 3′→5′ trên mRNA, gồm:', o:['3′UAG5′, 3′UAA5′, 3′UGA5′','3′GAU5′, 3′AAU5′, 3′AGU5′','3′UAG5′, 3′UAA5′, 3′AGU5′','3′AUG5′, 3′UAA5′, 3′UGA5′'], a:1, tip:'Đọc ngược từng bộ ba: UAG→GAU, UAA→AAU, UGA→AGU.', why:'Bộ ba chuẩn 5′→3′ là UAG, UAA, UGA; viết ngược chiều đảo luôn thứ tự nucleotide.', trap:'Phần lớn chọn A vì không để ý chiều đọc.' },
  { t:'dt', q:'Từ 3 loại nucleotide A, U, G có thể tạo tối đa bao nhiêu loại bộ ba?', o:['9','16','27','64'], a:2, tip:'3 vị trí × 3 lựa chọn = 3³ = 27.', why:'Mỗi vị trí trong bộ ba có 3 khả năng độc lập.', trap:'64 là khi có đủ 4 loại nucleotide.' },
  { t:'dt', q:'Hiện tượng polysome (nhiều ribosome cùng trượt trên một mRNA) có ý nghĩa:', o:['Tạo ra nhiều loại protein khác nhau','Tăng hiệu suất tổng hợp cùng một loại chuỗi polypeptide','Tăng tốc độ phiên mã','Giúp mRNA không bị phân giải'], a:1, tip:'Một mRNA → nhiều bản sao cùng loại protein.', why:'Các ribosome cùng đọc một khuôn nên sản phẩm giống nhau, chỉ tăng số lượng.', trap:'Không tạo nhiều loại protein.' },
  { t:'dt', q:'Acid amin mở đầu chuỗi polypeptide ở sinh vật nhân thực là:', o:['Formyl-methionine','Methionine','Valine','Alanin'], a:1, tip:'Nhân thực: Met. Nhân sơ: fMet.', why:'Bộ ba AUG mã hóa Met; ở vi khuẩn Met bị formyl hóa thành fMet.', trap:'fMet là đặc trưng của nhân sơ.' },
  { t:'dt', q:'Khác biệt cơ bản giữa DNA polymerase I và III ở vi khuẩn:', o:['I kéo dài mạch, III thay đoạn mồi','I thay đoạn mồi RNA bằng DNA, III là enzyme kéo dài chính','Cả hai đều tháo xoắn','III chỉ hoạt động ở mạch theo sau'], a:1, tip:'III = kéo dài chính; I = thay mồi + sửa sai.', why:'DNA pol III là enzyme chính kéo dài; pol I có hoạt tính exonuclease 5′→3′ để loại mồi.', trap:'Cả hai đều kéo dài 5′→3′.' },
  { t:'dt', q:'Một gen có 3000 nucleotide, nhân đôi liên tiếp 3 lần. Số nucleotide môi trường cung cấp là:', o:['9000','21000','24000','3000'], a:1, tip:'N(2³ − 1) = 3000 × 7.', why:'Tạo 8 DNA con, trong đó 2 mạch gốc là của mẹ nên cần 7 bộ gen mới.', trap:'Quên trừ đi bộ gen ban đầu → chọn 24000.' },
  { t:'dt', q:'Đột biến thay thế một cặp nucleotide nhưng chuỗi polypeptide không đổi. Đây là đột biến:', o:['Sai nghĩa','Vô nghĩa','Đồng nghĩa','Dịch khung'], a:2, tip:'Đồng nghĩa = cùng acid amin do tính thoái hóa.', why:'Nhiều bộ ba khác nhau mã hóa cùng một acid amin nên protein giữ nguyên.', trap:'Sai nghĩa có đổi acid amin.' },
  { t:'dt', q:'Loại đột biến gây hậu quả nghiêm trọng nhất lên protein thường là:', o:['Thay thế 1 cặp ở vùng mã hóa','Thêm hoặc mất 1 cặp nucleotide','Đảo đoạn trong intron','Thay thế ở vùng kết thúc'], a:1, tip:'Thêm/mất 1 cặp → dịch khung toàn bộ phía sau.', why:'Khung đọc bị lệch nên mọi codon sau đó đều bị đọc sai.', trap:'Thay thế chỉ ảnh hưởng 1 codon.' },
  { t:'dt', q:'mRNA trưởng thành ở sinh vật nhân thực khác mRNA sơ khai ở chỗ:', o:['Không còn intron, có mũ 5′ và đuôi poly-A','Có thêm intron','Được tổng hợp ở tế bào chất','Không có bộ ba mở đầu'], a:0, tip:'Trưởng thành = đã cắt intron + gắn mũ + poly-A.', why:'Ba bước xử lý này biến mRNA sơ khai thành bản phiên mã sẵn sàng dịch mã.', trap:'Phiên mã luôn diễn ra trong nhân.' },
  { t:'dt', q:'Một mRNA có 900 nucleotide. Chuỗi polypeptide hoàn chỉnh (đã cắt Met mở đầu) có số acid amin là:', o:['298','299','300','301'], a:0, tip:'900/3 = 300 codon; trừ 1 kết thúc và 1 mở đầu.', why:'300 − 2 = 298 acid amin.', trap:'Quên cắt acid amin mở đầu → 299.' },
  { t:'dt', q:'Anticodon trên tRNA khớp với codon trên mRNA theo nguyên tắc:', o:['Cùng chiều, cùng loại nucleotide','Đối chiều và bổ sung','Đối chiều và cùng loại nucleotide','Không theo nguyên tắc nào'], a:1, tip:'Đối song và bổ sung (A–U, G–C).', why:'tRNA đọc codon theo hướng ngược lại nên anticodon phải bổ sung và đối chiều.', trap:'Có bổ sung nhưng phải đối chiều.' },
  { t:'dt', q:'Splicing thay thế (alternative splicing) cho phép:', o:['Một gen tạo nhiều loại protein khác nhau','Một protein do nhiều gen tạo ra','DNA nhân đôi không cần enzyme','Tăng số lượng NST'], a:0, tip:'Chọn tổ hợp exon khác nhau → nhiều isoform.', why:'Cùng một gen nhưng các exon được nối theo cách khác nhau tạo mRNA khác nhau.', trap:'Không làm tăng số gen.' },
  { t:'dt', q:'Một phân tử DNA có 2400 nucleotide, trong đó G chiếm 30%. Số liên kết hydrogen là:', o:['2880','3120','3360','3600'], a:1, tip:'G = C = 720; A = T = 480; H = 2A + 3G.', why:'H = 2×480 + 3×720 = 960 + 2160 = 3120.', trap:'Nhầm A và G khi tính phần trăm.' },
  { t:'dt', q:'Đột biến xảy ra ở vùng điều hòa của gen thường dẫn đến:', o:['Thay đổi trình tự acid amin','Thay đổi mức độ biểu hiện của gen','Mất hoàn toàn NST','Không có bất kỳ ảnh hưởng nào'], a:1, tip:'Vùng điều hòa quyết định “khi nào, bao nhiêu”.', why:'Promoter/operator hỏng làm gen tăng hoặc giảm biểu hiện dù protein vẫn bình thường.', trap:'Không đổi cấu trúc protein.' },
  { t:'dt', q:'Enzyme làm đứt liên kết hydrogen để tách hai mạch DNA trong tái bản là:', o:['Ligase','Helicase','Primase','Amylase'], a:1, tip:'Helicase = mở xoắn tạo chạc chữ Y.', why:'Helicase phá vỡ liên kết hydrogen giữa các cặp base.', trap:'Ligase thì nối, không tách.' },
  { t:'dt', q:'Mạch dẫn đầu (leading strand) được tổng hợp liên tục vì:', o:['Mạch khuôn của nó có chiều 3′→5′ tính theo chiều mở chạc','Nó không cần đoạn mồi','Nó được tổng hợp theo chiều 3′→5′','Nó ngắn hơn mạch theo sau'], a:0, tip:'Khuôn 3′→5′ cho phép tổng hợp 5′→3′ liên tục.', why:'Đầu 3′-OH luôn hướng về phía chạc đang mở nên polymerase tiến liên tục.', trap:'Mọi mạch mới vẫn cần đoạn mồi.' },
  { t:'dt', q:'Một bong bóng tái bản có 2 chạc chữ Y, mỗi chạc có 3 đoạn Okazaki. Tổng số đoạn mồi RNA là:', o:['6','7','8','10'], a:2, tip:'Mỗi chạc: 1 mồi mạch dẫn + 3 mồi Okazaki = 4.', why:'Hai chạc đối xứng nên 4 × 2 = 8 đoạn mồi.', trap:'Bỏ sót mồi của mạch dẫn đầu.' },
  { t:'dt', q:'Tính thoái hóa của mã di truyền có nghĩa là:', o:['Một bộ ba mã hóa nhiều acid amin','Nhiều bộ ba cùng mã hóa một acid amin','Một acid amin chỉ do một bộ ba mã hóa','Mã di truyền khác nhau ở mỗi loài'], a:1, tip:'Thoái hóa = nhiều codon → 1 acid amin.', why:'Có 64 bộ ba nhưng chỉ khoảng 20 acid amin nên phải dư bộ ba.', trap:'Đặc hiệu mới là “1 codon → 1 acid amin”.' },
  { t:'dt', q:'Ribosome dịch mã bằng cách di chuyển trên mRNA theo chiều:', o:['3′→5′','5′→3′','Hai chiều tùy loại mRNA','Không di chuyển'], a:1, tip:'Ribosome đọc 5′→3′.', why:'Chiều này cho phép gặp codon mở đầu trước và codon kết thúc sau.', trap:'Nhầm với chiều của mạch khuôn.' },

  { t:'nst', q:'Một tế bào sinh dưỡng có 2n = 24, bị mất 1 NST ở một cặp. Thể đột biến này là:', o:['Thể một (2n−1)','Thể ba (2n+1)','Thể không (2n−2)','Thể tứ bội'], a:0, tip:'Mất 1 chiếc → 2n−1 = 23.', why:'Lệch bội thể một làm giảm một NST so với lưỡng bội.', trap:'Thể không mất cả cặp.' },
  { t:'nst', q:'Hội chứng Down ở người (47 NST) thuộc dạng:', o:['Thể một nhiễm','Thể ba nhiễm ở cặp NST 21','Đa bội 3n','Mất đoạn NST 21'], a:1, tip:'3 chiếc NST 21 = thể ba.', why:'Không phân ly cặp NST 21 trong giảm phân tạo giao tử thừa 1 NST.', trap:'Không phải đột biến cấu trúc.' },
  { t:'nst', q:'Đột biến đảo đoạn NST thường ít gây hại cho thể đột biến vì:', o:['Không làm mất hay thêm vật chất di truyền','Làm tăng số lượng gen','Luôn tạo gen mới có lợi','Không ảnh hưởng đến giảm phân'], a:0, tip:'Đảo đoạn chỉ đổi trật tự, không đổi lượng gen.', why:'Vật chất di truyền được giữ nguyên nên kiểu hình thường bình thường.', trap:'Nhưng có thể làm giảm khả năng sinh sản do ghép cặp sai.' },
  { t:'nst', q:'Lặp đoạn NST có ý nghĩa quan trọng với tiến hóa vì:', o:['Làm mất gen có hại','Tạo gen mới từ bản sao dư thừa','Luôn gây chết','Làm giảm kích thước bộ gen'], a:1, tip:'Gen dư thừa có thể đột biến thành chức năng mới.', why:'Bản sao thứ hai không chịu áp lực chọn lọc nên tích lũy đột biến và có thể chuyên hóa.', trap:'Lặp đoạn thường gây hại nhưng là nguyên liệu tiến hóa.' },
  { t:'nst', q:'Chuyển đoạn tương hỗ là:', o:['Một đoạn NST bị mất hẳn','Trao đổi đoạn giữa hai NST không tương đồng','Đảo ngược một đoạn trong cùng NST','Nhân đôi một đoạn NST'], a:1, tip:'Hai NST khác nhau đổi đoạn cho nhau.', why:'Đây là đột biến cấu trúc làm thay đổi vị trí gen giữa các NST.', trap:'Trao đổi chéo bình thường xảy ra giữa NST tương đồng.' },
  { t:'nst', q:'Thể đa bội lẻ (3n, 5n) thường bất thụ vì:', o:['Không tạo được giao tử có bộ NST cân bằng','Không có khả năng quang hợp','NST quá ngắn','Không có màng tế bào'], a:0, tip:'Số NST lẻ → giảm phân chia không đều.', why:'Các cặp NST không thể phân ly đồng đều nên giao tử mất cân bằng gen.', trap:'Đây là cơ sở tạo quả không hạt.' },
  { t:'nst', q:'Một loài có 2n = 20. Thể tam bội của loài này có số NST trong tế bào sinh dưỡng là:', o:['30','40','21','10'], a:0, tip:'3n = 3 × 10 = 30.', why:'n = 10 nên 3n = 30.', trap:'Lấy 2n × 3 = 60 là sai.' },
  { t:'nst', q:'Thể một kép có công thức bộ NST là:', o:['2n−2','2n−1−1 ở hai cặp khác nhau','2n+2','2n−1'], a:1, tip:'Mất 1 chiếc ở hai cặp khác nhau.', why:'Khác với thể không (mất cả 2 chiếc của cùng một cặp).', trap:'2n−2 là thể không.' },
  { t:'nst', q:'Đa bội hóa thường gặp ở thực vật nhưng hiếm ở động vật vì:', o:['Động vật không có NST','Đa bội phá vỡ cơ chế xác định giới tính và cân bằng phát triển','Động vật không phân bào','Thực vật không có giới tính'], a:1, tip:'Cơ chế xác định giới tính bị rối loạn.', why:'Đa bội làm sai lệch tỉ lệ NST giới tính và hệ phát triển phôi.', trap:'Động vật vẫn có NST bình thường.' },
  { t:'nst', q:'NST kép và cặp NST tương đồng khác nhau ở điểm nào?', o:['NST kép là 2 chromatid dính ở tâm động; cặp tương đồng là 2 NST riêng biệt','Chúng hoàn toàn giống nhau','NST kép chỉ có ở tế bào thực vật','Cặp tương đồng chỉ xuất hiện sau giảm phân'], a:0, tip:'Kép = 2 chromatid; tương đồng = 2 chiếc cùng nguồn gốc gen.', why:'NST kép hình thành sau nhân đôi; cặp tương đồng tồn tại ở tế bào lưỡng bội.', trap:'Hai khái niệm khác nhau hoàn toàn.' },
  { t:'nst', q:'Tần số hoán vị gen giữa hai gen luôn:', o:['Lớn hơn 50%','Nhỏ hơn hoặc bằng 50%','Bằng đúng 100%','Bằng 0 trong mọi trường hợp'], a:1, tip:'Tối đa 50% vì chỉ có 2/4 loại giao tử là tái tổ hợp.', why:'Hoán vị chỉ xảy ra ở một số tế bào; giao tử hoán vị không vượt quá giao tử liên kết.', trap:'Tần số 50% tương đương phân ly độc lập.' },
  { t:'nst', q:'Trao đổi chéo kép (hai điểm cùng lúc) làm cho kết quả lai:', o:['Giống hệt trao đổi chéo đơn','Khôi phục lại tổ hợp gen ban đầu ở một số giao tử','Không tạo giao tử','Làm tăng gấp đôi tần số hoán vị'], a:1, tip:'Trao đổi chéo kép có thể “hoàn nguyên” tổ hợp gốc.', why:'Hai lần trao đổi có thể bù trừ nhau, làm giảm số giao tử tái tổ hợp quan sát được.', trap:'Đây là lý do phải hiệu chỉnh tần số hoán vị.' },
  { t:'nst', q:'Thể dị đa bội được hình thành chủ yếu bằng con đường:', o:['Đột biến gen','Lai xa kèm đa bội hóa','Mất đoạn NST','Chuyển đoạn NST'], a:1, tip:'Lai xa + nhân đôi bộ NST → song nhị bội hữu thụ.', why:'Con lai bất thụ được đa bội hóa để mỗi NST có bạn tương đồng, giảm phân bình thường.', trap:'Không phải tự đa bội (cùng loài).' },
  { t:'nst', q:'Nguyên nhân chính của đột biến số lượng NST là:', o:['Đứt gãy NST','NST không phân ly trong phân bào','Thay thế nucleotide','Trao đổi chéo bất thường'], a:1, tip:'Không phân ly → giao tử thừa/thiếu NST.', why:'Thoi phân bào kéo sai làm cả cặp NST đi về một cực.', trap:'Đứt gãy gây đột biến cấu trúc.' },

  { t:'ql', q:'Phép lai Aa × Aa (trội hoàn toàn) cho tỉ lệ kiểu hình:', o:['1 : 1','3 : 1','1 : 2 : 1','9 : 3 : 3 : 1'], a:1, tip:'3 trội : 1 lặn.', why:'Aa × Aa → 1AA : 2Aa : 1aa, kiểu hình 3 : 1.', trap:'1:2:1 là tỉ lệ kiểu gen (hoặc kiểu hình khi trội không hoàn toàn).' },
  { t:'ql', q:'Tỉ lệ 9 : 7 ở F2 của phép lai hai cặp gen là dạng tương tác:', o:['Bổ sung','Át chế','Cộng gộp','Trội hoàn toàn'], a:0, tip:'9 A-B- : 7 (A-bb + aaB- + aabb).', why:'Hai gen cùng góp phần tạo một kiểu hình; thiếu một trong hai thì không biểu hiện.', trap:'Át chế cho 13:3 hoặc 12:3:1.' },
  { t:'ql', q:'Tỉ lệ 13 : 3 ở F2 thường ứng với tương tác:', o:['Bổ sung','Át chế trội','Cộng gộp','Liên kết gen'], a:1, tip:'13 (có alen át) : 3 (không bị át).', why:'Một alen trội át chế biểu hiện của gen kia, gộp 9+3+1 thành 13.', trap:'9:7 là bổ sung.' },
  { t:'ql', q:'Tỉ lệ 15 : 1 ở F2 là dấu hiệu của tương tác:', o:['Cộng gộp (đa gen)','Át chế','Bổ sung','Hoán vị gen'], a:0, tip:'15 có ít nhất 1 alen trội : 1 toàn lặn.', why:'Mỗi alen trội đóng góp một phần như nhau vào kiểu hình.', trap:'Đây là cơ sở di truyền tính trạng số lượng.' },
  { t:'ql', q:'Liên kết gen hoàn toàn có xu hướng:', o:['Tăng biến dị tổ hợp','Giữ các gen quý đi cùng nhau','Luôn gây chết','Làm tăng tần số hoán vị'], a:1, tip:'Các gen trên cùng NST di truyền cùng nhau.', why:'Giảm phân không hoán vị nên các alen cùng NST luôn đi chung.', trap:'Liên kết làm giảm biến dị tổ hợp.' },
  { t:'ql', q:'Cơ thể AB/ab có tần số hoán vị 20% tạo giao tử AB với tỉ lệ:', o:['10%','20%','40%','50%'], a:2, tip:'Giao tử liên kết = (100% − 20%)/2 = 40%.', why:'AB và ab là giao tử liên kết, chia đều 80% còn lại.', trap:'20% chia đôi là giao tử hoán vị (Ab = aB = 10%).' },
  { t:'ql', q:'Bệnh do gen lặn trên NST X thường gặp ở nam nhiều hơn nữ vì:', o:['Nam có 2 NST X','Nam chỉ có 1 NST X nên một alen lặn đã biểu hiện','Gen trên X không truyền cho nữ','Nữ có ít NST X hơn'], a:1, tip:'Nam XY → chỉ cần 1 alen lặn.', why:'Không có alen trội tương ứng trên X kia để lấn át.', trap:'Nữ cần 2 alen lặn mới biểu hiện.' },
  { t:'ql', q:'Gen nằm trên NST Y (không có đoạn tương đồng trên X) sẽ:', o:['Truyền từ bố cho tất cả con trai','Truyền từ mẹ cho con gái','Xuất hiện đều ở hai giới','Không di truyền'], a:0, tip:'Di truyền thẳng dòng bố.', why:'Con trai nhận Y từ bố nên luôn mang gen này.', trap:'Con gái không nhận Y.' },
  { t:'ql', q:'Tính trạng do gen trong ty thể quy định di truyền theo:', o:['Dòng bố','Dòng mẹ','Phân ly độc lập','Liên kết giới tính'], a:1, tip:'Tế bào chất của hợp tử chủ yếu từ trứng.', why:'Tinh trùng gần như không đóng góp ty thể nên con mang kiểu hình theo mẹ.', trap:'Không theo quy luật Mendel.' },
  { t:'ql', q:'Lai phân tích là phép lai giữa cá thể cần kiểm tra với:', o:['Cá thể đồng hợp trội','Cá thể đồng hợp lặn','Cá thể dị hợp','Cá thể mang kiểu hình trội'], a:1, tip:'Lai với đồng hợp lặn để bộc lộ giao tử.', why:'Cá thể lặn chỉ cho 1 loại giao tử lặn nên kiểu hình đời con phản ánh trực tiếp giao tử của cá thể kia.', trap:'Lai với dị hợp không gọi là lai phân tích.' },
  { t:'ql', q:'Trội không hoàn toàn cho F2 tỉ lệ kiểu hình:', o:['3 : 1','1 : 1','1 : 2 : 1','9 : 7'], a:2, tip:'Kiểu hình trung gian xuất hiện.', why:'Aa biểu hiện tính trạng trung gian nên kiểu hình trùng với kiểu gen.', trap:'Trội hoàn toàn mới cho 3:1.' },
  { t:'ql', q:'Ở hệ nhóm máu ABO, một người có kiểu gen I^A I^B biểu hiện nhóm máu:', o:['A','B','AB','O'], a:2, tip:'I^A và I^B đồng trội.', why:'Cả hai alen đều được biểu hiện đồng thời trên hồng cầu.', trap:'Đây là ví dụ đa alen + đồng trội.' },
  { t:'ql', q:'Quần thể tự phối, thế hệ xuất phát 100% Aa. Tỉ lệ dị hợp ở F3 là:', o:['12,5%','25%','50%','6,25%'], a:0, tip:'(1/2)³ = 12,5%.', why:'Mỗi thế hệ tự phối giảm một nửa tỉ lệ dị hợp.', trap:'F4 mới là 6,25%.' },
  { t:'ql', q:'AaBb × AaBb (phân ly độc lập, trội hoàn toàn). Tỉ lệ cá thể mang 2 tính trạng trội là:', o:['1/16','3/16','9/16','1/4'], a:2, tip:'3/4 × 3/4 = 9/16.', why:'Hai tính trạng độc lập nên nhân xác suất.', trap:'1/16 là đồng hợp lặn cả hai.' },
  { t:'ql', q:'Bản chất của tương tác gen là:', o:['Các gen trực tiếp biến đổi nhau','Sản phẩm của các gen tác động qua lại trong biểu hiện kiểu hình','Các gen nằm trên cùng NST','Đột biến gen này làm mất gen kia'], a:1, tip:'Tương tác giữa các sản phẩm protein.', why:'Gen không “gặp” nhau; protein/enzyme do chúng tạo ra mới phối hợp tạo kiểu hình.', trap:'Không phải tương tác vật lý giữa các gen.' },

  { t:'tv', q:'Lục lạp của tế bào bao bó mạch ở thực vật C4 không có PS II. Hệ quả là:', o:['Không thực hiện được chu trình Calvin','Không giải phóng O₂ nội sinh nên hạn chế hô hấp sáng','Không có Rubisco','Không có diệp lục'], a:1, tip:'Thiếu PS II → không quang phân ly nước tại đó.', why:'Nồng độ CO₂ cao, O₂ thấp quanh Rubisco nên Rubisco không cố định O₂.', trap:'Chu trình Calvin vẫn diễn ra bình thường.' },
  { t:'tv', q:'Ở thực vật CAM, khí khổng mở vào ban đêm để:', o:['Thoát hơi nước','Lấy CO₂ và cố định thành acid hữu cơ dự trữ','Hấp thụ O₂ cho hô hấp','Thải CO₂'], a:1, tip:'Ban đêm mát, mở khí khổng lấy CO₂ tiết kiệm nước.', why:'CO₂ được cố định thành malate trong không bào, ban ngày mới đưa vào Calvin.', trap:'Không phải để thoát hơi nước — CAM chủ động hạn chế mất nước.' },
  { t:'tv', q:'Lá ngô (cây đứng) có khí khổng phân bố:', o:['Chỉ mặt dưới','Chỉ mặt trên','Gần như đều cả hai mặt','Chỉ ở gân lá'], a:2, tip:'Lá đứng nhận sáng 2 mặt như nhau.', why:'Ánh sáng chiếu xiên đồng đều nên cả hai mặt đều cần khí khổng cho quang hợp.', trap:'Lá nằm ngang thường tập trung mặt dưới.' },
  { t:'tv', q:'Hiệu quả mép Stephan giải thích vì sao:', o:['Lỗ khí càng lớn thoát nước càng chậm','Tốc độ thoát hơi nước tỉ lệ với chu vi mép lỗ khí','Khí khổng chỉ thoát nước ở giữa','Lá dày thoát nước nhanh hơn'], a:1, tip:'Bốc hơi tập trung ở mép lỗ.', why:'Các phân tử nước ở mép có ít “hàng xóm” hơn nên dễ bay hơi hơn.', trap:'Không tỉ lệ với diện tích lỗ.' },
  { t:'tv', q:'Cột nước trong mạch gỗ được giữ liên tục chủ yếu nhờ:', o:['Liên kết hydrogen giữa các phân tử nước','Áp suất khí trong lá','Lực đẩy của rễ là duy nhất','Mạch rây vận chuyển ngược'], a:0, tip:'Liên kết H + lực hút thoát hơi nước.', why:'Các phân tử nước dính nhau thành chuỗi bền, chịu được sức căng khi lá thoát hơi.', trap:'Lực đẩy rễ chỉ hỗ trợ phần nhỏ.' },
  { t:'tv', q:'Điểm bù ánh sáng là cường độ ánh sáng mà tại đó:', o:['Quang hợp đạt cực đại','Quang hợp bằng hô hấp','Cây ngừng quang hợp','Khí khổng đóng hoàn toàn'], a:1, tip:'Trao đổi khí ròng = 0.', why:'Lượng CO₂ cố định bằng lượng CO₂ thải ra, cây không tích lũy chất hữu cơ.', trap:'Cực đại là điểm bão hòa.' },
  { t:'tv', q:'Điểm bão hòa ánh sáng là cường độ ánh sáng mà từ đó:', o:['Quang hợp không tăng thêm dù tăng ánh sáng','Quang hợp bằng hô hấp','Cây bắt đầu hô hấp sáng','Diệp lục bị phân hủy'], a:0, tip:'Bị giới hạn bởi enzyme và CO₂.', why:'Rubisco và nồng độ CO₂ đã hoạt động tối đa nên tăng sáng không giúp thêm.', trap:'Không phải điểm bù.' },
  { t:'tv', q:'Hô hấp sáng xảy ra mạnh ở thực vật C3 khi:', o:['Trời mát, CO₂ cao','Nóng, khí khổng đóng làm CO₂ giảm, O₂ tăng','Ban đêm','Cây thiếu nước nhẹ'], a:1, tip:'Rubisco gắn O₂ thay vì CO₂.', why:'Tỉ lệ CO₂/O₂ giảm trong lá khi khí khổng đóng vì nóng.', trap:'C4/CAM hạn chế hiện tượng này.' },
  { t:'tv', q:'Pha sáng của quang hợp tạo ra:', o:['Glucose và O₂','ATP, NADPH và O₂','CO₂ và H₂O','Chỉ ATP'], a:1, tip:'ATP + NADPH cấp cho Calvin; O₂ từ quang phân ly nước.', why:'Pha sáng chuyển năng lượng ánh sáng thành năng lượng hóa học dạng ATP/NADPH.', trap:'Glucose được tạo ở pha tối.' },
  { t:'tv', q:'Nguồn electron thay thế cho diệp lục trong pha sáng là:', o:['CO₂','H₂O','Glucose','O₂'], a:1, tip:'Quang phân ly nước: 2H₂O → 4H⁺ + 4e⁻ + O₂.', why:'Nước bị phân ly cung cấp electron cho PS II và giải phóng O₂.', trap:'CO₂ bị khử ở pha tối.' },
  { t:'tv', q:'Chu trình Calvin sử dụng trực tiếp:', o:['Ánh sáng trực tiếp','ATP và NADPH từ pha sáng','O₂','NADH từ hô hấp'], a:1, tip:'Calvin dùng ATP + NADPH để khử CO₂.', why:'Đây là “pha tối” — không cần ánh sáng trực tiếp nhưng cần sản phẩm của pha sáng.', trap:'Không dùng NADH của hô hấp.' },
  { t:'tv', q:'Thiếu Mg gây vàng lá vì Mg là:', o:['Thành phần acid amin','Trung tâm của phân tử diệp lục','Cofactor của Rubisco','Thành phần vách tế bào'], a:1, tip:'Mg nằm giữa vòng porphyrin của diệp lục.', why:'Không có Mg thì không tổng hợp được diệp lục, lá mất màu xanh.', trap:'N là thành phần protein và diệp lục nhưng không phải “trung tâm”.' },
  { t:'tv', q:'Thiếu đạm (N) ở thực vật thường biểu hiện:', o:['Lá non tím đỏ','Lá vàng từ lá già, cây còi cọc','Cháy mép lá non','Thân phình to'], a:1, tip:'N tái sử dụng được → lá già vàng trước.', why:'Cây chuyển N từ lá già sang lá non nên triệu chứng xuất hiện ở lá dưới.', trap:'Thiếu Fe lại vàng lá non.' },
  { t:'tv', q:'Auxin có tác dụng gây:', o:['Ức chế giãn dài tế bào','Kích thích giãn dài tế bào và thể hiện ưu thế ngọn','Đóng khí khổng','Làm chín quả'], a:1, tip:'Auxin phân bố không đều → cong hướng sáng.', why:'Nồng độ auxin thích hợp kích thích giãn dài; nồng độ cao lại ức chế.', trap:'Làm chín quả là êtylen.' },
  { t:'tv', q:'Hoocmon gây ngủ của hạt và đóng khí khổng khi hạn là:', o:['GA','ABA','Êtylen','Xitôkinin'], a:1, tip:'ABA = “hoocmon căng thẳng”.', why:'ABA tăng khi thiếu nước, làm K⁺ ra khỏi tế bào hạt đậu → khí khổng đóng.', trap:'GA ngược lại, phá ngủ.' },
  { t:'tv', q:'Êtylen được ứng dụng trong thực tế để:', o:['Kích thích ra rễ','Làm chín quả nhân tạo','Giữ hoa tươi lâu','Tăng chiều cao cây'], a:1, tip:'Êtylen = hoocmon chín.', why:'Êtylen kích thích tổng hợp enzyme phân giải tinh bột, pectin → quả mềm, ngọt.', trap:'Ra rễ là auxin.' },
  { t:'tv', q:'Biện pháp bón tro bếp (giàu K⁺) giúp cây chống rét vì:', o:['K⁺ làm tăng áp suất thẩm thấu, hạ điểm đóng băng dịch bào','K⁺ tạo màu xanh cho lá','K⁺ giữ ấm lá','K⁺ diệt nấm bệnh'], a:0, tip:'Nồng độ chất tan cao → điểm băng hạ.', why:'Dịch bào đậm đặc khó đóng băng hơn nên tế bào ít bị tổn thương.', trap:'Bón đạm nhiều làm cây non yếu, dễ chết rét.' },
  { t:'tv', q:'Ứng động khác hướng động ở chỗ:', o:['Ứng động là phản ứng theo hướng tác nhân','Ứng động là phản ứng không định hướng theo tác nhân','Ứng động chỉ có ở động vật','Hướng động xảy ra chậm hơn'], a:1, tip:'Ứng động: cụp lá, nở hoa — không theo hướng.', why:'Hướng động phụ thuộc hướng kích thích; ứng động chỉ phụ thuộc cường độ.', trap:'Cả hai đều là vận động của thực vật.' },
  { t:'tv', q:'Ngọn cây hướng về phía ánh sáng vì:', o:['Auxin phân bố về phía tối và kích thích giãn dài tế bào ở đó','Auxin tập trung phía sáng','Ánh sáng đốt cháy tế bào phía tối','Rễ đẩy ngọn lên'], a:0, tip:'Auxin tránh sáng → phía tối dài nhanh hơn.', why:'Sự giãn dài không đều làm thân cong về phía có ánh sáng.', trap:'Auxin không bị ánh sáng “hút”.' },
  { t:'tv', q:'Rễ hút khoáng chủ động cần ATP vì:', o:['Khoáng thường đi ngược chiều nồng độ','Khoáng luôn đi cùng chiều nồng độ','Cần phá vỡ thành tế bào','Cần ánh sáng'], a:0, tip:'Vận chuyển ngược gradient cần bơm tiêu tốn năng lượng.', why:'Hô hấp ở rễ cung cấp ATP cho các bơm ion trên màng.', trap:'Khuếch tán thì không cần ATP.' },

  { t:'dv', q:'Điện thế nghỉ của nơron khoảng −70 mV chủ yếu do:', o:['Na⁺ vào tế bào quá nhiều','K⁺ khuếch tán ra ngoài và bơm Na⁺/K⁺ duy trì gradient','Cl⁻ ra khỏi tế bào','Ca²⁺ vào tế bào'], a:1, tip:'Màng thấm K⁺ tốt hơn Na⁺ nhiều.', why:'K⁺ ra ngoài để lại anion bên trong làm mặt trong âm hơn.', trap:'Bơm Na/K chỉ duy trì gradient, không tạo trực tiếp điện thế.' },
  { t:'dv', q:'Bơm Na⁺/K⁺ ATPase mỗi chu kỳ vận chuyển:', o:['3 Na⁺ vào, 2 K⁺ ra','3 Na⁺ ra, 2 K⁺ vào','2 Na⁺ ra, 3 K⁺ vào','1 Na⁺ ra, 1 K⁺ vào'], a:1, tip:'3 ra – 2 vào, tiêu tốn 1 ATP.', why:'Đây là vận chuyển tích cực duy trì nồng độ cao Na⁺ ngoài và K⁺ trong.', trap:'Chiều vận chuyển thường bị nhớ ngược.' },
  { t:'dv', q:'Đỉnh điện thế hoạt động khoảng +30 mV là do:', o:['K⁺ tràn vào tế bào','Na⁺ tràn vào qua kênh Na⁺ mở','Cl⁻ ra ngoài','Bơm Na/K ngừng hoạt động'], a:1, tip:'Khử cực = Na⁺ vào ồ ạt.', why:'Kênh Na⁺ điện thế mở, Na⁺ vào theo gradient làm mặt trong dương hơn.', trap:'K⁺ ra ngoài là giai đoạn tái cực.' },
  { t:'dv', q:'Bao myelin làm xung thần kinh lan truyền nhanh hơn vì:', o:['Tăng điện trở màng, dẫn truyền nhảy cóc giữa các eo Ranvier','Tăng tiết chất trung gian hóa học','Làm màng dày hơn nên Na⁺ vào nhiều hơn','Giảm số nơron'], a:0, tip:'Nhảy cóc qua các eo → giảm số điểm khử cực.', why:'Myelin cách điện nên điện thế nhảy từ eo này sang eo kế tiếp.', trap:'Không phải vì màng dày hơn.' },
  { t:'dv', q:'Khi xung thần kinh đến chuỳ axon, Ca²⁺ vào tế bào gây:', o:['Tái hấp thu chất trung gian','Dung hợp túi chứa chất trung gian với màng và giải phóng vào khe synapse','Đóng kênh Na⁺','Ức chế hoàn toàn nơron sau'], a:1, tip:'Ca²⁺ là tín hiệu cho xuất bào túi synapse.', why:'Ca²⁺ gắn protein cảm biến (synaptotagmin) kích hoạt dung hợp màng.', trap:'Không phải tái hấp thu.' },
  { t:'dv', q:'Insulin làm giảm glucose máu chủ yếu bằng cách:', o:['Kích thích gan phân giải glycogen','Kích thích tế bào nhận glucose và gan tổng hợp glycogen','Tăng tân tạo glucose','Tăng tiết glucagon'], a:1, tip:'Insulin = “cất đường vào kho”.', why:'Insulin đưa GLUT4 lên màng tế bào và hoạt hóa glycogen synthase ở gan.', trap:'Phân giải glycogen là glucagon.' },
  { t:'dv', q:'Khi đói kéo dài, hoocmon nào tân tạo glucose từ protein và lipid?', o:['Insulin','Cortisol','Adrenalin','Aldosteron'], a:1, tip:'Cortisol = glucocorticoid, tăng đường huyết bền vững.', why:'Cortisol kích thích gan chuyển acid amin thành glucose (gluconeogenesis).', trap:'Adrenalin chỉ tác dụng ngắn hạn.' },
  { t:'dv', q:'Glucagon tác động chủ yếu lên gan để:', o:['Tổng hợp glycogen','Phân giải glycogen thành glucose','Tổng hợp protein','Sản xuất mật'], a:1, tip:'Glucagon = “kéo đường ra khỏi kho”.', why:'Glucagon hoạt hóa glycogen phosphorylase, giải phóng glucose vào máu.', trap:'Insulin là hoocmon ngược lại.' },
  { t:'dv', q:'Adrenalin có tác dụng nhanh trong tình huống khẩn cấp vì:', o:['Kích thích phân giải glycogen và tăng nhịp tim','Ức chế tim','Giảm hô hấp','Tăng tổng hợp mỡ'], a:0, tip:'Phản ứng “chiến đấu hay bỏ chạy”.', why:'Adrenalin tăng đường huyết, tăng nhịp tim, giãn phế quản để cung cấp năng lượng nhanh.', trap:'Không phải hoocmon dài hạn.' },
  { t:'dv', q:'Gan khử độc NH₃ bằng cách chuyển thành:', o:['Acid uric','Urê','Creatin','Bilirubin'], a:1, tip:'Chu trình ornithine → urê tan trong nước.', why:'Urê được thận lọc và thải ra nước tiểu, ít độc hơn NH₃ rất nhiều.', trap:'Acid uric là sản phẩm ở chim/bò sát.' },
  { t:'dv', q:'Albumin do gan tổng hợp có vai trò:', o:['Vận chuyển O₂','Duy trì áp suất keo của huyết tương','Đông máu','Tiêu hóa lipid'], a:1, tip:'Thiếu albumin → phù do nước thoát vào mô.', why:'Albumin giữ nước trong lòng mạch nhờ áp suất keo.', trap:'Đông máu là fibrinogen/prothrombin.' },
  { t:'dv', q:'Muối mật có vai trò:', o:['Thủy phân lipid','Nhũ tương hóa lipid thành giọt nhỏ','Phân giải protein','Trung hòa acid dạ dày'], a:1, tip:'Mật không chứa enzyme tiêu hóa.', why:'Nhũ tương hóa làm tăng diện tích tiếp xúc cho lipase tụy hoạt động.', trap:'Không phải enzyme.' },
  { t:'dv', q:'Pepsin hoạt động tối ưu ở pH khoảng:', o:['2','7','8','10'], a:0, tip:'Môi trường acid của dạ dày.', why:'Pepsin được tiết dạng pepsinogen, hoạt hóa bởi HCl và chỉ bền ở pH thấp.', trap:'Trypsin hoạt động ở pH kiềm.' },
  { t:'dv', q:'Trypsin khác pepsin ở điểm:', o:['Hoạt động ở pH kiềm và do tụy tiết','Hoạt động ở pH acid','Do dạ dày tiết','Không cắt protein'], a:0, tip:'Trypsin: tụy tiết, pH ~8, cắt liên kết Lys/Arg.', why:'Trypsin được tiết dạng trypsinogen và hoạt hóa bởi enterokinase ở ruột non.', trap:'Pepsin mới ở dạ dày.' },
  { t:'dv', q:'ADH (vasopressin) làm tăng tái hấp thu nước ở:', o:['Cầu thận','Ống lượn xa và ống góp','Bàng quang','Niệu quản'], a:1, tip:'ADH chèn kênh aquaporin lên màng.', why:'Nước được tái hấp thu nhiều hơn nên nước tiểu cô đặc, ít thể tích.', trap:'Cầu thận là nơi lọc, không tái hấp thu nước đáng kể.' },
  { t:'dv', q:'Hồng cầu đặt trong dung dịch ưu trương sẽ:', o:['Trương lên và vỡ','Co lại và teo (co nguyên sinh)','Không thay đổi','Tăng sinh'], a:1, tip:'Nước ra ngoài → tế bào co.', why:'Nồng độ chất tan ngoài cao hơn trong nên nước thẩm thấu ra ngoài.', trap:'Nhược trương mới gây vỡ.' },
  { t:'dv', q:'Kháng thể do loại tế bào nào tiết ra?', o:['Hồng cầu','Tế bào lympho B (tương bào)','Tiểu cầu','Bạch cầu trung tính'], a:1, tip:'B lympho biệt hóa thành tương bào tiết kháng thể.', why:'Kháng thể là globulin miễn dịch đặc hiệu kháng nguyên.', trap:'T lympho gây độc tế bào, không tiết kháng thể.' },
  { t:'dv', q:'Khi nhiệt độ cơ thể tăng, cơ chế điều hòa chủ yếu là:', o:['Co mạch, run rẩy','Giãn mạch da, tiết mồ hôi','Tăng chuyển hóa sinh nhiệt','Dựng lông'], a:1, tip:'Tỏa nhiệt: giãn mạch + bay hơi mồ hôi.', why:'Giãn mạch da tăng thải nhiệt, mồ hôi bay hơi lấy nhiệt của cơ thể.', trap:'Run rẩy là phản ứng khi lạnh.' },
  { t:'dv', q:'Trao đổi khí ở phổi người diễn ra theo cơ chế:', o:['Vận chuyển chủ động','Khuếch tán theo chênh lệch phân áp','Thẩm thấu','Ẩm bào'], a:1, tip:'O₂ và CO₂ khuếch tán qua màng phế nang – mao mạch.', why:'Phân áp O₂ trong phế nang cao hơn máu, CO₂ thì ngược lại.', trap:'Không tiêu tốn ATP.' },

  { t:'nst', q:'Thể không (nullisomic) có bộ NST dạng:', o:['2n−1','2n−2 (mất cả cặp)','2n+1','2n+2'], a:1, tip:'Mất hẳn 2 chiếc của cùng một cặp.', why:'Không còn chiếc nào của cặp NST đó nên gọi là thể không.', trap:'2n−1 là thể một.' },
  { t:'dv', q:'Huyết áp giảm mạnh sẽ kích thích cơ chế:', o:['Tiết ADH và aldosteron để giữ nước, muối','Tiết insulin','Giãn mạch toàn thân','Tăng lọc ở cầu thận'], a:0, tip:'Giữ nước – giữ muối → tăng thể tích tuần hoàn.', why:'ADH giữ nước ở ống góp, aldosteron tăng tái hấp thu Na⁺ kèm nước.', trap:'Insulin điều hòa glucose, không điều hòa huyết áp.' },
  { t:'tb', q:'Màng trong ti thể gấp nếp thành cristae nhằm:', o:['Tăng diện tích chứa chuỗi truyền electron','Giảm thể tích ti thể','Bảo vệ DNA ti thể','Tăng khả năng quang hợp'], a:0, tip:'Nhiều nếp gấp = nhiều ATP synthase.', why:'Chuỗi truyền electron và ATP synthase nằm trên màng trong nên gấp nếp làm tăng hiệu suất.', trap:'Không liên quan quang hợp.' },
  { t:'tb', q:'Phản ứng sáng của quang hợp diễn ra trên:', o:['Màng thylakoid','Stroma','Màng ngoài lục lạp','Tế bào chất'], a:0, tip:'Thylakoid chứa PS I, PS II, chuỗi truyền electron.', why:'Stroma là nơi diễn ra chu trình Calvin.', trap:'Dễ nhầm stroma là nơi có pha sáng.' },
  { t:'tb', q:'Bộ máy Golgi có chức năng chính là:', o:['Tổng hợp ATP','Biến đổi, đóng gói và phân loại protein','Nhân đôi DNA','Phân giải H₂O₂'], a:1, tip:'Golgi là “bưu điện” của tế bào.', why:'Golgi nhận túi từ ER, glycosyl hóa, rồi gửi đến đích (màng, lysosome, xuất bào).', trap:'Tổng hợp ATP là ti thể.' },
  { t:'tb', q:'Lysosome được gọi là “dạ dày của tế bào” vì:', o:['Chứa enzyme thủy phân hoạt động ở pH acid','Chứa diệp lục','Tổng hợp protein','Dự trữ nước'], a:0, tip:'Thủy phân nội bào.', why:'Lysosome chứa protease, lipase, nuclease hoạt động mạnh ở pH ~5.', trap:'Không phải peroxisome.' },
  { t:'tb', q:'Hiện tượng co nguyên sinh xảy ra khi tế bào thực vật đặt trong dung dịch:', o:['Nhược trương','Đẳng trương','Ưu trương','Có ánh sáng mạnh'], a:2, tip:'Nước ra khỏi không bào → màng co khỏi thành.', why:'Môi trường ngoài có nồng độ chất tan cao hơn dịch bào.', trap:'Nhược trương gây trương nước, không co.' }
];
/* =========================================================
   3. ĐÚNG / SAI — 14 CHÙM × 4 Ý
   ========================================================= */
const TFS = [
  { title: 'Tái bản DNA', sub: [
    { text: 'DNA polymerase tổng hợp mạch mới theo chiều 3′→5′.', ans: false, exp: 'Mọi DNA polymerase chỉ kéo dài mạch mới theo chiều 5′→3′ vì chỉ gắn được nucleotide vào đầu 3′-OH tự do.' },
    { text: 'Trong một chạc tái bản, mạch theo sau được tổng hợp thành nhiều đoạn Okazaki.', ans: true, exp: 'Mạch khuôn 5′→3′ buộc polymerase phải làm từng đoạn ngắn rồi nối lại bằng ligase.' },
    { text: 'Helicase phá vỡ liên kết phosphodiester giữa các nucleotide.', ans: false, exp: 'Helicase chỉ phá liên kết hydrogen giữa hai mạch. Liên kết phosphodiester do nuclease/ligase tác động.' },
    { text: 'Một phân tử DNA nhân đôi liên tiếp 3 lần sẽ tạo ra 8 phân tử DNA con.', ans: true, exp: 'Số DNA con = 2³ = 8.' }
  ]},
  { title: 'Phiên mã & dịch mã', sub: [
    { text: 'Ở sinh vật nhân thực, phiên mã và dịch mã có thể xảy ra đồng thời trên cùng một mRNA.', ans: false, exp: 'Ở nhân thực có màng nhân ngăn cách: phiên mã trong nhân, dịch mã ở tế bào chất. Chỉ nhân sơ mới đồng thời.' },
    { text: 'mRNA được tổng hợp theo chiều 5′→3′ và cùng chiều với mạch bổ sung của gen.', ans: true, exp: 'mRNA bổ sung và đối chiều với mạch gốc nên cùng chiều với mạch bổ sung.' },
    { text: 'Ba bộ ba kết thúc UAA, UAG, UGA không mã hóa acid amin nào.', ans: true, exp: 'Chúng chỉ làm tín hiệu dừng dịch mã, không có tRNA tương ứng.' },
    { text: 'Một phân tử mRNA chỉ có thể được một ribosome dịch mã tại một thời điểm.', ans: false, exp: 'Nhiều ribosome có thể cùng trượt (polysome) để tăng hiệu suất tổng hợp protein.' }
  ]},
  { title: 'Đột biến gen', sub: [
    { text: 'Đột biến thay thế một cặp nucleotide luôn làm thay đổi acid amin trong chuỗi polypeptide.', ans: false, exp: 'Do tính thoái hóa, nhiều trường hợp là đột biến đồng nghĩa — protein không đổi.' },
    { text: 'Mất một cặp nucleotide trong vùng mã hóa gây dịch khung đọc.', ans: true, exp: 'Khung đọc lệch đi 1 nucleotide nên toàn bộ codon phía sau bị đọc sai.' },
    { text: 'Đột biến gen chỉ phát sinh trong quá trình nhân đôi DNA.', ans: false, exp: 'Còn do tác nhân vật lý (UV, tia X), hóa học (EMS, 5-BU) và sai sót sửa chữa.' },
    { text: 'Đột biến ở tế bào sinh dưỡng có thể truyền cho thế hệ sau bằng sinh sản vô tính.', ans: true, exp: 'Sinh sản vô tính tạo cơ thể mới từ tế bào sinh dưỡng nên đột biến được truyền nguyên vẹn.' }
  ]},
  { title: 'Nhiễm sắc thể', sub: [
    { text: 'Thể đa bội lẻ thường có khả năng sinh sản hữu tính cao.', ans: false, exp: 'Số NST lẻ làm giảm phân không cân bằng nên thường bất thụ — đây là cơ sở tạo quả không hạt.' },
    { text: 'Trao đổi chéo xảy ra giữa các chromatid của cặp NST tương đồng.', ans: true, exp: 'Đây là cơ sở của hoán vị gen, diễn ra ở kì đầu giảm phân I.' },
    { text: 'Đảo đoạn làm thay đổi số lượng gen trên NST.', ans: false, exp: 'Đảo đoạn chỉ đổi trật tự gen, không mất hay thêm gen.' },
    { text: 'Ở người, ba chiếc NST số 21 gây hội chứng Down.', ans: true, exp: 'Thể ba nhiễm NST 21 (47,XX/XY,+21) do không phân ly trong giảm phân.' }
  ]},
  { title: 'Quy luật di truyền', sub: [
    { text: 'Lai phân tích dùng cá thể đồng hợp lặn để xác định kiểu gen cá thể cần kiểm tra.', ans: true, exp: 'Cá thể lặn chỉ cho một loại giao tử nên kiểu hình đời con phản ánh trực tiếp giao tử của cá thể kia.' },
    { text: 'Trội không hoàn toàn cho F2 tỉ lệ kiểu hình 3 : 1.', ans: false, exp: 'Trội không hoàn toàn cho 1 : 2 : 1 vì kiểu hình dị hợp là trung gian.' },
    { text: 'Hai gen càng xa nhau trên cùng NST thì tần số hoán vị càng lớn.', ans: true, exp: 'Khoảng cách lớn làm tăng xác suất xảy ra trao đổi chéo giữa chúng.' },
    { text: 'Liên kết gen hoàn toàn làm tăng biến dị tổ hợp.', ans: false, exp: 'Liên kết hoàn toàn giữ các gen đi cùng nhau nên làm giảm biến dị tổ hợp.' }
  ]},
  { title: 'Tương tác gen & quần thể', sub: [
    { text: 'Tương tác cộng gộp tạo ra tính trạng biến thiên liên tục.', ans: true, exp: 'Nhiều gen cùng góp phần nhỏ tạo phổ kiểu hình rộng, điển hình là tính trạng số lượng.' },
    { text: 'Tỉ lệ 9 : 7 ở F2 là dạng tương tác át chế.', ans: false, exp: '9 : 7 là tương tác bổ sung; át chế cho 13 : 3 hoặc 12 : 3 : 1.' },
    { text: 'Quần thể tự phối làm tăng tỉ lệ kiểu gen đồng hợp.', ans: true, exp: 'Mỗi thế hệ dị hợp giảm một nửa, đồng hợp tăng tương ứng.' },
    { text: 'Tần số hoán vị gen có thể đạt 100%.', ans: false, exp: 'Tối đa 50% vì chỉ 2 trong 4 loại giao tử là tái tổ hợp.' }
  ]},
  { title: 'Giới tính & di truyền tế bào chất', sub: [
    { text: 'Gen trên NST X thường di truyền chéo.', ans: true, exp: 'Bố truyền X cho con gái, con gái truyền lại cho con trai.' },
    { text: 'Bệnh do gen lặn trên NST X thường gặp ở nữ nhiều hơn nam.', ans: false, exp: 'Nam chỉ có 1 X nên chỉ cần 1 alen lặn đã biểu hiện; nữ cần 2 alen lặn.' },
    { text: 'Gen trong ty thể di truyền theo dòng mẹ.', ans: true, exp: 'Hợp tử nhận tế bào chất chủ yếu từ trứng nên ty thể mang gen mẹ.' },
    { text: 'Gen trên NST Y truyền cho cả con trai và con gái.', ans: false, exp: 'Chỉ con trai nhận Y từ bố nên gen trên Y di truyền thẳng dòng bố.' }
  ]},
  { title: 'Quang hợp C3 – C4 – CAM', sub: [
    { text: 'Lục lạp của tế bào bao bó mạch ở thực vật C4 thiếu hệ quang hóa PS II.', ans: true, exp: 'Thiếu PS II nên không quang phân ly nước, không sinh O₂ nội sinh → hạn chế hô hấp sáng.' },
    { text: 'Thực vật CAM cố định CO₂ mạnh nhất vào ban ngày.', ans: false, exp: 'CAM mở khí khổng ban đêm để lấy CO₂, ban ngày đóng lại để tiết kiệm nước.' },
    { text: 'Ở thực vật C4, Rubisco hoạt động trong môi trường có nồng độ CO₂ cao.', ans: true, exp: 'CO₂ được PEP-carboxylase “bơm” vào tế bào bao bó mạch nên Rubisco khó gắn O₂.' },
    { text: 'Hô hấp sáng làm tăng hiệu suất quang hợp.', ans: false, exp: 'Hô hấp sáng tiêu hao ATP và mất carbon, làm giảm năng suất.' }
  ]},
  { title: 'Khí khổng & dòng nước', sub: [
    { text: 'Khí khổng mở khi tế bào hạt đậu mất nước.', ans: false, exp: 'Ngược lại: K⁺ vào → nước vào → tế bào trương → lỗ khí mở.' },
    { text: 'ABA làm đóng khí khổng khi cây bị hạn.', ans: true, exp: 'ABA làm K⁺ ra khỏi tế bào hạt đậu, giảm áp suất trương nên khí khổng đóng.' },
    { text: 'Tốc độ thoát hơi nước tỉ lệ với chu vi mép của lỗ khí.', ans: true, exp: 'Đây là hiệu quả mép Stephan: phân tử nước ở mép dễ bay hơi hơn.' },
    { text: 'Bọt khí hình thành trong mạch gỗ không ảnh hưởng đến dòng nước.', ans: false, exp: 'Bọt khí làm đứt cột nước liên tục, ngắt dòng vận chuyển.' }
  ]},
  { title: 'Khoáng & hoocmon thực vật', sub: [
    { text: 'Mg là nguyên tố trung tâm của phân tử diệp lục.', ans: true, exp: 'Mg nằm giữa vòng porphyrin, thiếu Mg lá mất màu xanh.' },
    { text: 'Thiếu đạm thường làm vàng lá non trước tiên.', ans: false, exp: 'N tái sử dụng được nên cây chuyển từ lá già sang lá non: lá già vàng trước.' },
    { text: 'Auxin ở nồng độ cao có thể ức chế sinh trưởng.', ans: true, exp: 'Auxin có tác dụng hai pha: nồng độ thấp kích thích, cao ức chế.' },
    { text: 'Êtylen có tác dụng kích thích ra rễ.', ans: false, exp: 'Ra rễ là tác dụng của auxin. Êtylen gây chín quả, rụng lá.' }
  ]},
  { title: 'Điện thế & synapse', sub: [
    { text: 'Điện thế nghỉ hình thành chủ yếu do K⁺ khuếch tán ra ngoài tế bào.', ans: true, exp: 'Màng thấm K⁺ tốt hơn Na⁺ nên K⁺ ra ngoài để lại anion bên trong.' },
    { text: 'Bơm Na⁺/K⁺ vận chuyển 2 Na⁺ ra ngoài và 3 K⁺ vào trong.', ans: false, exp: 'Đúng là 3 Na⁺ ra và 2 K⁺ vào, tiêu tốn 1 ATP.' },
    { text: 'Trong giai đoạn khử cực, Na⁺ tràn vào tế bào.', ans: true, exp: 'Kênh Na⁺ điện thế mở, Na⁺ vào theo gradient làm mặt trong dương hơn.' },
    { text: 'Bao myelin làm xung thần kinh lan truyền chậm lại.', ans: false, exp: 'Myelin cách điện nên dẫn truyền nhảy cóc, nhanh hơn nhiều lần.' }
  ]},
  { title: 'Nội tiết đường huyết', sub: [
    { text: 'Insulin có tác dụng làm tăng đường huyết.', ans: false, exp: 'Insulin làm giảm đường huyết bằng cách đưa glucose vào tế bào và tăng tổng hợp glycogen.' },
    { text: 'Glucagon kích thích gan phân giải glycogen.', ans: true, exp: 'Glucagon hoạt hóa glycogen phosphorylase, giải phóng glucose vào máu.' },
    { text: 'Cortisol có thể tân tạo glucose từ protein và lipid.', ans: true, exp: 'Đây là con đường gluconeogenesis ở gan khi đói kéo dài.' },
    { text: 'Adrenalin chỉ phát huy tác dụng sau vài giờ.', ans: false, exp: 'Adrenalin tác dụng rất nhanh (giây đến phút) trong phản ứng khẩn cấp.' }
  ]},
  { title: 'Gan & tiêu hóa', sub: [
    { text: 'Gan tiết enzyme tiêu hóa tinh bột.', ans: false, exp: 'Gan không tiết enzyme tiêu hóa. Amylase do tụy và tuyến nước bọt tiết.' },
    { text: 'Muối mật có tác dụng nhũ tương hóa lipid.', ans: true, exp: 'Mật chia lipid thành giọt nhỏ, tăng diện tích cho lipase.' },
    { text: 'Gan là cơ quan chính tổng hợp albumin huyết tương.', ans: true, exp: 'Albumin duy trì áp suất keo; xơ gan giảm albumin gây phù.' },
    { text: 'Pepsin hoạt động tối ưu ở pH khoảng 8.', ans: false, exp: 'Pepsin cần pH ~2 (acid) trong dạ dày; pH 8 làm nó mất hoạt tính.' }
  ]},
  { title: 'Thẩm thấu & cân bằng nội môi', sub: [
    { text: 'Hồng cầu đặt trong nước cất sẽ bị vỡ.', ans: true, exp: 'Môi trường nhược trương cực mạnh: nước vào ồ ạt làm màng hồng cầu vỡ (tan máu).' },
    { text: 'Tế bào thực vật trong dung dịch ưu trương bị co nguyên sinh.', ans: true, exp: 'Nước ra khỏi không bào, màng sinh chất tách khỏi thành tế bào.' },
    { text: 'Thận không tham gia điều hòa pH máu.', ans: false, exp: 'Thận điều hòa pH bằng cách thải H⁺ và tái hấp thu HCO₃⁻.' },
    { text: 'ADH làm giảm tái hấp thu nước ở ống góp.', ans: false, exp: 'ADH làm tăng chèn kênh aquaporin, tăng tái hấp thu nước, nước tiểu cô đặc.' }
  ]}
];

/* =========================================================
   4. TRẢ LỜI NGẮN — 16 CÂU TÍNH TOÁN
   ========================================================= */
const SHORTS = [
  { q: 'Một mạch DNA có (A₁ + G₁)/(T₁ + C₁) = 2,5. Tỉ lệ này trên mạch bổ sung bằng bao nhiêu?', ans: '0.4', cells: ['0', '.', '4', ''], exp: 'Theo NTBS, mạch bổ sung nghịch đảo: 1/2,5 = 0,4.' },
  { q: 'Một phân tử DNA có (A + T)/(G + C) = 1/4. Tỉ lệ % nucleotide loại G là bao nhiêu?', ans: '40', cells: ['4', '0', '', ''], exp: 'A = 0,25G. Mà A + G = 50% ⇒ 1,25G = 50% ⇒ G = 40%.' },
  { q: 'Phân tử DNA dài 5100 Å, có A = 20%. Số liên kết hydrogen của phân tử là bao nhiêu?', ans: '3900', cells: ['3', '9', '0', '0'], exp: 'N = 5100/3,4 × 2 = 3000 nu. A = T = 600; G = C = 900. H = 2A + 3G = 1200 + 2700 = 3900.' },
  { q: 'Một gen nhân đôi 3 lần trong môi trường chỉ có N¹⁵. Số phân tử DNA con mang cả hai mạch N¹⁵ hoàn toàn mới là bao nhiêu?', ans: '6', cells: ['6', '', '', ''], exp: 'Có 2³ = 8 DNA con, trừ 2 phân tử còn giữ 1 mạch của mẹ ⇒ 6 phân tử mới hoàn toàn.' },
  { q: 'Một mRNA có 360 nucleotide. Chuỗi polypeptide hoàn chỉnh (đã cắt acid amin mở đầu) có bao nhiêu acid amin?', ans: '118', cells: ['1', '1', '8', ''], exp: 'Số codon = 360/3 = 120. Trừ 1 codon kết thúc và 1 acid amin mở đầu: 120 − 2 = 118.' },
  { q: 'Một chuỗi polypeptide hoàn chỉnh có 299 liên kết peptide. Số acid amin của chuỗi là bao nhiêu?', ans: '300', cells: ['3', '0', '0', ''], exp: 'Số acid amin = số liên kết peptide + 1 = 299 + 1 = 300.' },
  { q: 'Một bong bóng tái bản có 2 chạc chữ Y, mỗi chạc có 3 đoạn Okazaki. Tổng số đoạn mồi RNA cần thiết là bao nhiêu?', ans: '8', cells: ['8', '', '', ''], exp: 'Mỗi chạc: 1 mồi cho mạch dẫn + 3 mồi cho Okazaki = 4. Hai chạc = 8.' },
  { q: 'Một gen có 1500 nucleotide, phiên mã một lần. Số nucleotide môi trường cung cấp cho mRNA là bao nhiêu?', ans: '750', cells: ['7', '5', '0', ''], exp: 'Chỉ một mạch của gen được dùng làm khuôn nên mRNA có N/2 = 750 nucleotide.' },
  { q: 'Với 4 loại nucleotide, số bộ ba mã hóa acid amin (không tính 3 bộ ba kết thúc) là bao nhiêu?', ans: '61', cells: ['6', '1', '', ''], exp: 'Tổng 4³ = 64 bộ ba, trừ 3 bộ ba kết thúc còn 61 bộ ba mã hóa.' },
  { q: 'Một loài có 2n = 24. Thể ba nhiễm của loài có bao nhiêu NST trong tế bào sinh dưỡng?', ans: '25', cells: ['2', '5', '', ''], exp: 'Thể ba = 2n + 1 = 24 + 1 = 25.' },
  { q: 'Một loài có 2n = 24. Thể tam bội của loài có bao nhiêu NST?', ans: '36', cells: ['3', '6', '', ''], exp: 'n = 12 ⇒ 3n = 36.' },
  { q: 'Quần thể tự phối, ban đầu 100% Aa. Tỉ lệ % cá thể dị hợp ở F₄ là bao nhiêu?', ans: '6.25', cells: ['6', '.', '2', '5'], exp: '(1/2)⁴ = 1/16 = 6,25%.' },
  { q: 'Cây có kiểu gen Aa tự thụ phấn (trội hoàn toàn). Tỉ lệ % cá thể mang kiểu hình trội ở đời con là bao nhiêu?', ans: '75', cells: ['7', '5', '', ''], exp: 'Aa × Aa → 3/4 trội : 1/4 lặn ⇒ 75%.' },
  { q: 'Một gen nhân đôi liên tiếp 4 lần. Số phân tử DNA con được tạo ra là bao nhiêu?', ans: '16', cells: ['1', '6', '', ''], exp: 'Mỗi lần nhân đôi, số phân tử DNA con tăng gấp đôi: sau 4 lần = 2⁴ = 16. Đừng nhầm với "số DNA con hoàn toàn mới" (16 − 2 = 14) hay "số nucleotide môi trường cung cấp" (N × 15).' },
  { q: 'Ở người 2n = 46. Thể một nhiễm có bao nhiêu NST?', ans: '45', cells: ['4', '5', '', ''], exp: 'Thể một nhiễm (2n − 1) mất một chiếc của một cặp NST tương đồng ⇒ 46 − 1 = 45. Phân biệt với thể ba nhiễm (2n + 1 = 47) và thể không nhiễm (2n − 2 = 44).' },
  { q: 'Hệ nhóm máu ABO do 3 alen quy định. Số kiểu gen tối đa trong quần thể là bao nhiêu?', ans: '6', cells: ['6', '', '', ''], exp: '3 alen ⇒ 3(3+1)/2 = 6 kiểu gen (I^AI^A, I^AI^O, I^BI^B, I^BI^O, I^AI^B, I^OI^O).' }
];

/* =========================================================
   5. TỰ LUẬN OLYMPIC — 12 CÂU
   ========================================================= */
const ESSAYS = [
  { id: 'Câu 1', title: 'Rét hại làm chết mạ xuân — cơ chế và biện pháp', sum: 'Lạnh làm tăng độ nhớt tế bào chất, màng chuyển pha gel, hô hấp rễ đình trệ ⇒ cây chết khát giữa bùn ướt.',
    tach: '<b>1. Cơ chế chết rét:</b> Nhiệt độ thấp làm tăng độ nhớt chất nguyên sinh, màng sinh chất chuyển từ pha lỏng sang pha gel nên giảm tính thấm; hoạt tính enzyme giảm mạnh; hô hấp rễ đình trệ ⇒ thiếu ATP cho hút khoáng chủ động; lông hút bị tổn thương hàng loạt ⇒ rễ mất khả năng hút nước dù đất vẫn ẩm.<br><b>2. Biện pháp:</b> (a) Che phủ nilon trong suốt tạo hiệu ứng nhà kính giữ nhiệt, chắn gió; (b) Bón tro bếp giàu K⁺ làm tăng áp suất thẩm thấu, hạ điểm đóng băng của dịch bào; (c) Giữ đủ nước, không bón nhiều đạm vì đạm làm tế bào non, mọng nước dễ chết rét.',
    gop: 'Rét ⇒ màng hóa gel + rễ hết ATP ⇒ mất hút nước. Khắc phục: giữ nhiệt (nilon) + tăng chất tan (K⁺).' },
  { id: 'Câu 2', title: 'Khí khổng ở lá ngô, hiệu quả mép Stephan và dòng mạch gỗ', sum: 'Lá đứng nhận sáng 2 mặt ⇒ khí khổng phân bố đều. Bốc hơi bùng nổ ở chu vi mép lỗ khí.',
    tach: '<b>a. Khí khổng ở ngô:</b> Lá ngô mọc đứng, ánh sáng chiếu xiên và đồng đều cả hai mặt nên cả hai mặt đều có khí khổng với mật độ gần tương đương (khác lá nằm ngang chỉ tập trung mặt dưới).<br><b>b. Hiệu quả mép:</b> Tốc độ thoát hơi nước tỉ lệ với <i>chu vi</i> mép lỗ khí chứ không theo diện tích, vì phân tử nước ở mép có ít “hàng xóm” nên dễ bay hơi hơn ⇒ lỗ khí nhỏ nhưng nhiều mép lại thoát nước mạnh.<br><b>c. Mạch gỗ:</b> Cột nước liên tục nhờ liên kết hydrogen giữa các phân tử nước + lực hút do thoát hơi nước ở lá + lực đẩy của rễ. Bọt khí làm đứt chuỗi liên kết ⇒ ngắt dòng vận chuyển.',
    gop: 'Lá đứng ⇒ khí khổng 2 mặt bằng nhau. Thoát hơi theo chu vi mép. Cột nước đứt khi có bọt khí.' },
  { id: 'Câu 3', title: 'Hai loại lục lạp thích nghi ở thực vật C4', sum: 'Lục lạp mô giậu bắt CO₂; lục lạp bao bó mạch chạy Calvin trong môi trường CO₂ cao, thiếu PS II.',
    tach: '<b>– Lục lạp tế bào mô giậu:</b> Grana phát triển, có đủ PS I và PS II; chứa enzyme PEP-carboxylase có ái lực rất cao với CO₂ ⇒ cố định CO₂ thành acid 4C (oxaloacetate → malate).<br><b>– Lục lạp tế bào bao bó mạch:</b> Grana kém phát triển, <b>không có PS II</b> ⇒ không quang phân ly nước, không sinh O₂ nội sinh; chứa Rubisco hoạt động trong môi trường CO₂ nồng độ cao do được bơm từ tế bào mô giậu ⇒ Rubisco không gắn O₂ ⇒ triệt tiêu hô hấp sáng.',
    gop: 'Mô giậu: bắt CO₂ bằng PEP-carboxylase. Bao bó mạch: Rubisco + không PS II ⇒ không hô hấp sáng.' },
  { id: 'Câu 4', title: 'Quan hệ giữa hô hấp và trao đổi khoáng ở rễ', sum: 'Hô hấp cấp ATP và khung carbon; khoáng đúc nên enzyme hô hấp.',
    tach: '<b>1. Hô hấp hỗ trợ hút khoáng:</b> Cung cấp ATP cho bơm ion chủ động; cung cấp acid hữu cơ (acid xêtô) làm khung carbon đồng hóa NH₃ thành acid amin; cung cấp NADH/FADH₂ cho các phản ứng khử.<br><b>2. Khoáng hỗ trợ hô hấp:</b> N, P, S là thành phần protein – enzyme của chuỗi truyền electron; Fe, Cu là cofactor cytochrome oxidase; Mg cần cho phản ứng với ATP; P là thành phần ATP.<br><b>3. Kết luận:</b> Hai quá trình phụ thuộc hai chiều — thiếu khoáng thì hô hấp yếu, hô hấp yếu thì không hút được khoáng ⇒ rễ suy nhanh.',
    gop: 'Hô hấp cho ATP + khung C. Khoáng cho enzyme. Thiếu một bên ⇒ cả hai cùng sụp.' },
  { id: 'Câu 5', title: 'Ba dòng đột biến GA ở đậu Hà Lan', sum: 'Dòng 1 hỏng nguồn phát (thiếu GA); dòng 2 hỏng bộ thu (hỏng thụ thể); dòng 3 bão hòa thụ thể.',
    tach: '<b>– Dòng 1:</b> Đột biến làm mất khả năng tổng hợp GA nội sinh ⇒ cây lùn. Phun GA ngoại sinh ⇒ cây vươn cao bình thường (bù được nguồn phát).<br><b>– Dòng 2:</b> Đột biến hỏng thụ thể GA ⇒ phun GA cũng không đáp ứng (hỏng bộ thu).<br><b>– Dòng 3:</b> Thụ thể bị đột biến luôn ở trạng thái hoạt hóa ⇒ cây cao bất thường, phun thêm GA không đổi vì hệ thống đã bão hòa.<br><b>Kết luận:</b> Thử phun GA rồi so chiều cao giúp phân biệt lỗi “thiếu hoocmon” và lỗi “hỏng thụ thể”.',
    gop: 'Dòng 1 thiếu GA (bù được). Dòng 2 hỏng thụ thể (không bù được). Dòng 3 luôn bật.' },
  { id: 'Câu 6', title: '7 enzyme tiêu hóa protein ở người', sum: 'Băm nhỏ polypeptide từ dạ dày đến ruột non theo hai đầu và khúc giữa.',
    tach: '<b>Dạ dày:</b> 1. Pepsin (pH ~2) cắt các liên kết kỵ nước, mở màn tiêu hóa protein.<br><b>Tụy:</b> 2. Trypsin (hoạt hóa toàn bộ enzyme tụy), 3. Chymotrypsin (cắt liên kết thơm), 4. Carboxypeptidase (rỉa acid amin đầu C).<br><b>Ruột non:</b> 5. Aminopeptidase (rỉa đầu N), 6. Tripeptidase, 7. Dipeptidase (cắt đôi/tripeptide thành acid amin tự do).<br><b>Kết quả:</b> Protein → peptide → acid amin hấp thu qua niêm mạc ruột vào máu.',
    gop: 'Dạ dày mở màn → tụy băm khúc giữa & rỉa đầu C → ruột rỉa đầu N và cắt mảnh vụn.' },
  { id: 'Câu 7', title: 'Nơron mới ở người già & tập tính động vật bậc thấp', sum: 'Tế bào gốc đồi hải mã sinh nơron mới. Động vật bậc thấp ưu tiên tập tính bẩm sinh.',
    tach: '<b>a. Nơron ở người già:</b> Nơron trưởng thành không phân chia. Nơron mới được sinh từ quần thể <b>tế bào gốc thần kinh</b> ở vùng đồi hải mã (hippocampus) rồi biệt hóa và di chuyển vào mạng lưới.<br><b>b. Động vật bậc thấp:</b> Hệ thần kinh dạng lưới/hạch, vỏ não chưa phát triển, tuổi thọ ngắn ⇒ không đủ thời gian học; chọn lọc tự nhiên cài sẵn <b>tập tính bẩm sinh</b> (di truyền) để phản ứng nhanh và chính xác với môi trường.',
    gop: 'Người già có nơron mới nhờ tế bào gốc. Động vật bậc thấp dùng bản năng vì không kịp học.' },
  { id: 'Câu 8', title: 'Vì sao đồ thị điện thế hoạt động biến đổi từ A sang B?', sum: 'Giảm K⁺ nội bào làm giảm gradient khuếch tán ⇒ điện thế nghỉ trôi từ −70 mV lên −50 mV.',
    tach: '<b>1. Điện thế nghỉ:</b> Phụ thuộc chủ yếu vào tỉ lệ [K⁺] trong/ngoài (phương trình Nernst). Giảm K⁺ nội bào ⇒ ít K⁺ khuếch tán ra ⇒ mặt trong bớt âm ⇒ điện thế nghỉ trôi từ −70 mV lên −50 mV.<br><b>2. Mất đỉnh:</b> Khi điện thế nghỉ đã gần ngưỡng, kênh Na⁺ bị bất hoạt một phần và gradient Na⁺ không đủ ⇒ không tạo được đỉnh +30 mV, gai nhọn biến mất.<br><b>3. Hệ quả:</b> Nơron khó phát xung, dẫn truyền suy giảm (gặp trong hạ kali máu nặng).',
    gop: 'Giảm K⁺ trong ⇒ màng bớt âm (−50 mV) ⇒ mất gai. Điện thế nghỉ phụ thuộc gradient K⁺.' },
  { id: 'Câu 9', title: 'Cơ chế hoocmon điều hòa đường huyết', sum: 'Một cửa hạ (insulin), bốn cửa tăng (glucagon, adrenalin, cortisol, ACTH).',
    tach: '<b>– Hạ đường huyết:</b> Tụy (tế bào β) tiết <b>insulin</b> ⇒ tăng nhận glucose ở tế bào (GLUT4), tăng tổng hợp glycogen ở gan và cơ, giảm tân tạo glucose.<br><b>– Tăng đường huyết:</b> <b>Glucagon</b> (tế bào α) phân giải glycogen gan; <b>adrenalin</b> huy động khẩn cấp; <b>cortisol</b> tân tạo glucose từ protein/lipid; <b>ACTH</b> kích thích tuyến thượng thận.<br><b>– Gan</b> là cơ quan đích trung tâm, hoạt động như “kho đệm” giữ glucose máu 0,8–1,2 g/L.',
    gop: 'Insulin kéo đường vào kho. Glucagon/adrenalin/cortisol kéo đường ra. Gan là kho.' },
  { id: 'Câu 10', title: 'Khung xương tế bào và thí nghiệm kiểm chứng xuất bào', sum: 'Hỏng vi ống làm mất đường ray cho kinesin; kiểm chứng bằng khả năng tạo thoi phân bào.',
    tach: '<b>a. Giả thuyết:</b> Protein tích tụ trong tế bào có thể do (1) hỏng vi ống nên túi tiết không được vận chuyển, hoặc (2) hỏng protein SNARE làm túi không dung hợp được với màng.<br><b>b. Kiểm chứng:</b> Dùng colchicine phá vi ống rồi quan sát khả năng phân bào. Nếu tế bào không tạo được thoi phân bào ⇒ tổn thương nằm ở vi ống. Nếu phân bào bình thường mà protein vẫn ứ ⇒ lỗi ở bộ máy dung hợp màng (SNARE).<br><b>c. Kết luận:</b> Kinesin di chuyển trên vi ống về phía đầu (+) — về màng tế bào.',
    gop: 'Hỏng vi ống ⇒ túi ứ + không phân bào. Hỏng SNARE ⇒ phân bào bình thường nhưng vẫn ứ.' },
  { id: 'Câu 11', title: 'Vì sao xơ gan gây phù toàn thân?', sum: 'Gan giảm tổng hợp albumin ⇒ áp suất keo huyết tương giảm ⇒ nước thoát vào mô kẽ.',
    tach: '<b>1. Cơ chế chính:</b> Gan xơ giảm tổng hợp albumin ⇒ áp suất keo huyết tương giảm ⇒ nước từ lòng mạch thoát vào khoảng kẽ ⇒ phù.<br><b>2. Cơ chế phụ:</b> Xơ gan làm tăng áp lực tĩnh mạch cửa ⇒ ứ máu, thoát dịch vào ổ bụng (cổ trướng); giảm khử độc NH₃ ⇒ tích tụ amoniac gây rối loạn thần kinh (bệnh não gan); giảm yếu tố đông máu ⇒ dễ chảy máu.<br><b>3. Ứng dụng:</b> Bệnh nhân xơ gan cần hạn chế muối, bổ sung đạm hợp lý và theo dõi albumin máu.',
    gop: 'Thiếu albumin ⇒ giảm áp suất keo ⇒ phù. Kèm tăng áp lực cửa ⇒ cổ trướng.' },
  { id: 'Câu 12', title: 'Hiệu quả sử dụng nước của C3 – C4 – CAM và ứng dụng', sum: 'C4 và CAM “đắt” năng lượng nhưng tiết kiệm nước; C3 rẻ năng lượng nhưng tốn nước.',
    tach: '<b>1. C3:</b> Khí khổng mở ban ngày ⇒ mất nước nhiều; hiệu quả dùng nước thấp nhưng chi phí ATP thấp (18 ATP/glucose).<br><b>2. C4:</b> Tách không gian cố định CO₂ (mô giậu) và chu trình Calvin (bao bó mạch) ⇒ có thể đóng khí khổng bớt, giảm thoát hơi nước; chi phí 30 ATP/glucose nhưng năng suất cao khi nóng, sáng mạnh.<br><b>3. CAM:</b> Tách thời gian (đêm/ngày) ⇒ hiệu quả dùng nước cao nhất, sinh trưởng chậm.<br><b>4. Ứng dụng:</b> Chọn giống theo vùng — C4 cho vùng nóng, khô, sáng mạnh (ngô, mía, cao lương); CAM cho vùng sa mạc; C3 cho vùng ôn đới mát.',
    gop: 'C3 tốn nước. C4 tốn ATP nhưng tiết kiệm nước. CAM tiết kiệm nước nhất nhưng chậm lớn.' }
];
/* =========================================================
   6. RENDER LÝ THUYẾT
   ========================================================= */
function renderTheory() {
  $('#theoryList').innerHTML = THEORY.map((t, i) => `
    <details class="acc" ${i === 0 ? 'open' : ''}>
      <summary><i class="fa-solid ${t.icon}" style="color:var(--accent);font-size:.8rem"></i>
        <span>${t.title}</span></summary>
      <div class="body">${t.body}</div>
    </details>`).join('');

  $('#organelleGrid').innerHTML = ORGANELLES.map(o => `
    <div class="card pad-sm" style="background:var(--surface2)">
      <div class="row" style="gap:6px;margin-bottom:4px">
        <span style="width:7px;height:7px;border-radius:50%;background:${o.c};flex:0 0 auto;box-shadow:0 0 8px ${o.c}"></span>
        <b class="xs">${o.n}</b>
      </div>
      <div class="tiny">${o.d}</div>
    </div>`).join('');

  $('#liverList').innerHTML = LIVER.map(l => `
    <details class="acc">
      <summary><i class="fa-solid fa-circle-dot" style="color:var(--accent);font-size:.55rem"></i><span>${l.t}</span></summary>
      <div class="body">${l.d}</div>
    </details>`).join('');
}

/* =========================================================
   7. NGÂN HÀNG
   ========================================================= */
let bankType = 'mcq', bankFilter = 'all', bankShown = 15, bankRendered = false, showAllAns = false;

function setBankType(t) {
  bankType = t; bankShown = 15;
  $$('#bankSeg button').forEach((b, i) => b.classList.toggle('on', ['mcq', 'tf', 'short'][i] === t));
  renderBank(true);
  beep(520, .03);
}
function setBankFilter(f) { bankFilter = f; bankShown = 15; renderBank(true); beep(500, .02); }

function bankData() {
  const kw = ($('#bankSearch').value || '').trim().toLowerCase();
  let list;
  if (bankType === 'mcq') list = MCQS.map((q, i) => ({ ...q, _i: i }));
  else if (bankType === 'tf') list = TFS.map((q, i) => ({ ...q, _i: i, t: 'tf' }));
  else list = SHORTS.map((q, i) => ({ ...q, _i: i, t: 'short' }));

  if (bankFilter !== 'all' && bankType === 'mcq') list = list.filter(q => q.t === bankFilter);
  if (kw) {
    list = list.filter(q => {
      const hay = (q.q || q.title || '') + ' ' + (q.o ? q.o.join(' ') : '') + ' ' + (q.sub ? q.sub.map(s => s.text).join(' ') : '');
      return hay.toLowerCase().includes(kw);
    });
  }
  return list;
}

function renderBank(reset) {
  if (reset) bankShown = 15;
  const list = bankData();
  $('#bankCount').textContent = `${list.length} mục`;
  $('#bankFilters').innerHTML = bankType === 'mcq'
    ? ['all', ...Object.keys(TOPICS)].map(k => `<button class="chip ${bankFilter === k ? 'on' : ''}" onclick="setBankFilter('${k}')">${k === 'all' ? 'Tất cả' : TOPICS[k].n}</button>`).join('')
    : '';

  const slice = list.slice(0, bankShown);
  let html = '';

  if (bankType === 'mcq') {
    html = slice.map(q => {
      const topic = TOPICS[q.t] || TOPICS.dt;
      return `<div class="qcard">
        <div class="between"><span class="qnum">Câu ${q._i + 1}</span><span class="badge" style="background:${topic.c}1f;color:${topic.c}">${topic.n}</span></div>
        <div class="qtext">${q.q}</div>
        <div class="grid" style="gap:5px">${q.o.map((o, j) => `
          <div class="opt ${showAllAns && j === q.a ? 'ok' : ''}" style="cursor:default">
            <span class="k">${'ABCD'[j]}</span><span>${o}</span>
          </div>`).join('')}</div>
        <button class="btn sm" style="margin-top:7px" onclick="toggleAns('a${q._i}',this)"><i class="fa-solid fa-lightbulb"></i> Giải thích</button>
        <div class="exp" id="a${q._i}" style="display:none">
          <span class="tip"><i class="fa-solid fa-check"></i> Đáp án ${'ABCD'[q.a]}</span>
          ${q.why}
          ${typeof BG4_LEARN !== 'undefined' ? BG4_LEARN.html(q, 'mcq') : ''}
          <span class="trap"><i class="fa-solid fa-triangle-exclamation"></i> Bẫy: ${q.trap}</span>
        </div>
      </div>`;
    }).join('');
  } else if (bankType === 'tf') {
    html = slice.map(q => `<div class="qcard">
      <span class="qnum p">Chùm ${q._i + 1}</span>
      <div class="qtext">${q.title}</div>
      <div class="grid" style="gap:5px">${q.sub.map((s, j) => `
        <div class="tfrow">
          <div class="xs" style="color:var(--text)">${s.text}</div>
          <div class="row" style="gap:5px;margin-top:6px">
            <span class="badge ${s.ans ? 'g' : 'r'}">${s.ans ? 'ĐÚNG' : 'SAI'}</span>
            <span class="tiny" style="flex:1">${s.exp}</span>
          </div>
        </div>`).join('')}</div>
    </div>`).join('');
  } else {
    html = slice.map(q => `<div class="qcard">
      <span class="qnum a">Câu ${q._i + 1}</span>
      <div class="qtext">${q.q}</div>
      <div class="cells" style="margin-bottom:8px">${q.cells.map(c => `<div class="cell">${c}</div>`).join('')}</div>
      <div class="exp" style="display:block">
        <span class="tip">Đáp án: ${q.ans}</span>${q.exp}
      </div>
    </div>`).join('');
  }

  $('#bankList').innerHTML = html || `<div class="empty"><i class="fa-solid fa-magnifying-glass" style="font-size:1.3rem;display:block;margin-bottom:6px"></i>Không tìm thấy mục nào</div>`;
  $('#bankMore').style.display = bankShown < list.length ? '' : 'none';
  bankRendered = true;
}
function loadMoreBank() { bankShown += 15; renderBank(false); }
function toggleAns(id, btn) {
  const el = document.getElementById(id);
  const open = el.style.display === 'none';
  el.style.display = open ? 'block' : 'none';
  btn.innerHTML = open ? '<i class="fa-solid fa-eye-slash"></i> Ẩn giải thích' : '<i class="fa-solid fa-lightbulb"></i> Giải thích';
  beep(560, .02);
}
function toggleAllAnswers() {
  showAllAns = !showAllAns;
  renderBank(false);
  beep(600, .03);
}

/* =========================================================
   8. TỰ LUẬN
   ========================================================= */
function renderEssays() {
  $('#essayList').innerHTML = ESSAYS.map(e => `
    <details class="acc">
      <summary><span class="qnum a" style="margin-right:2px">${e.id.replace('Câu ', '#')}</span><span style="flex:1">${e.title}</span></summary>
      <div class="body">
        <p style="margin-bottom:8px;color:var(--text)"><b>Tóm tắt:</b> ${e.sum}</p>
        <div class="grid md-g2" style="gap:8px">
          <div style="padding:10px;border-radius:11px;background:rgba(52,211,153,.07);border:1px solid rgba(52,211,153,.18)">
            <div class="xs b" style="color:var(--ok);margin-bottom:4px"><i class="fa-solid fa-list-check"></i> BAREM CHI TIẾT</div>
            <div style="line-height:1.65">${e.tach}</div>
          </div>
          <div style="padding:10px;border-radius:11px;background:rgba(56,189,248,.07);border:1px solid rgba(56,189,248,.18)">
            <div class="xs b" style="color:var(--accent2);margin-bottom:4px"><i class="fa-solid fa-bolt"></i> PHẢN XẠ 3 GIÂY</div>
            <div style="line-height:1.65">${e.gop}</div>
          </div>
        </div>
      </div>
    </details>`).join('');
}

/* =========================================================
   9. PHÒNG THI
   ========================================================= */
let exam = { mcq: [], tf: [], short: [] };
let answers = { mcq: {}, tf: {}, short: {} };
let timerId = null, remain = 0, totalTime = 0, endAt = 0;

function syncCfg(k) {
  const t = +$('#cfgTime').value, m = +$('#cfgMCQ').value, f = +$('#cfgTF').value, s = +$('#cfgShort').value;
  $('#lblTime').textContent = t + ' phút';
  $('#lblMCQ').textContent = m + ' câu';
  $('#lblTF').textContent = f + ' chùm (' + f * 4 + ' ý)';
  $('#lblShort').textContent = s + ' câu';
}
function applyPreset(t, m, f, s) {
  $('#cfgTime').value = t; $('#cfgMCQ').value = m; $('#cfgTF').value = f; $('#cfgShort').value = s;
  syncCfg(); beep(620, .04);
}
/* ---------- 1.1 Xáo trộn chuẩn (Fisher–Yates) + PRNG có hạt giống ---------- */

/** Băm chuỗi thành số 32 bit (FNV-1a) — dùng làm hạt giống ổn định. */
function hash32(str) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}

/** PRNG mulberry32: cùng hạt giống ⇒ cùng dãy số. */
function rng(seed) {
  let a = seed >>> 0;
  return function () {
    a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Fisher–Yates có hạt giống — trả về mảng mới, không sửa mảng gốc. */
function shuffleSeeded(arr, seed) {
  const a = arr.slice();
  const rnd = rng(seed);
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    const tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}

/** Xáo trộn ngẫu nhiên (hạt giống mới mỗi lần gọi). */
function shuffle(arr) {
  return shuffleSeeded(arr, (Math.random() * 4294967296) >>> 0);
}

let EXAM2025_MODE = false;
function startExam() {
  let m = +$('#cfgMCQ').value, f = +$('#cfgTF').value, s = +$('#cfgShort').value;
  /* v5.0 — đề chuẩn 2025+: ép đúng cấu trúc 18 / 4 / 6 và dùng bộ câu V6. */
  if (EXAM2025_MODE) { m = 18; f = 4; s = 6; }
  if (typeof ACCESS !== 'undefined' && ACCESS.isBasic()) {
    m = Math.max(1, Math.min(m || 5, ACCESS.MCQ_MAX));
    f = 0; s = 0;   /* bản cơ bản: chỉ trắc nghiệm, tối đa 10 câu */
  }
  if (!m && !f && !s) { alert('Chọn ít nhất một phần câu hỏi!'); return; }
  /* 1.10 — đề dựng từ hạt giống, phương án xáo trên bản sao */
  const seed = (Math.random() * 4294967296) >>> 0;
  exam.seed = seed;
  let __mcqPool = EXAM2025_MODE ? V6_MCQ.slice() : MCQS;
  let __tfPool = EXAM2025_MODE ? V6_TF.slice() : TFS;
  let __shortPool = EXAM2025_MODE ? V6_SHORT.slice() : SHORTS;
  /* v5.10 — gia sư AI: luyện đúng chuyên đề đang yếu */
  if (typeof BG4_TUTOR !== 'undefined' && BG4_TUTOR.topicFilter) {
    const __f = BG4_TUTOR.topicFilter;
    BG4_TUTOR.topicFilter = '';
    const __multi = (__f === '__multi__' && BG4_TUTOR.multiTopics && BG4_TUTOR.multiTopics.length)
      ? BG4_TUTOR.multiTopics : null;
    const __ok = __multi ? function (q) { return __multi.indexOf(q.t) >= 0; }
      : function (q) { return q.t === __f; };
    __mcqPool = __mcqPool.filter(__ok);
    __tfPool = __tfPool.filter(__ok);
    __shortPool = __shortPool.filter(__ok);
    if (!__mcqPool.length) __mcqPool = MCQS.slice();
  }
  exam.mcq = materializeQuestions(shuffleSeeded(__mcqPool, seed).slice(0, m), seed);
  exam.tf = shuffleSeeded(__tfPool, seed + 1).slice(0, f);
  exam.short = shuffleSeeded(__shortPool, seed + 2).slice(0, s);
  answers = { mcq: {}, tf: {}, short: {} };
  totalTime = remain = (typeof ACCESS !== 'undefined' && ACCESS.isBasic()
    ? Math.min(+$('#cfgTime').value || ACCESS.TIME_MAX, ACCESS.TIME_MAX)
    : +$('#cfgTime').value) * 60;
  endAt = Date.now() + totalTime * 1000;   /* 1.2 — mốc tuyệt đối, không đếm lùi */
  go('exam');
  $('#examConfig').style.display = 'none';
  $('#examReport').style.display = 'none';
  $('#examRoom').style.display = '';
  renderExam();
  startTimer();
  beep(780, .1);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function renderExam() {
  let html = '';
  if (exam.mcq.length) {
    html += `<div class="tiny b" style="letter-spacing:.1em;color:var(--accent2);padding:2px 2px 0">PHẦN I • TRẮC NGHIỆM (${exam.mcq.length} CÂU)</div>`;
    html += exam.mcq.map((q, i) => `<div class="qcard">
      <span class="qnum">Câu ${i + 1}</span>
      <div class="qtext">${q.q}</div>
      <div class="grid" style="gap:5px">${q.o.map((o, j) => `
        <button class="opt" id="m${i}_${j}" onclick="pickM(${i},${j})"><span class="k">${'ABCD'[j]}</span><span>${o}</span></button>`).join('')}</div>
    </div>`).join('');
  }
  if (exam.tf.length) {
    html += `<div class="tiny b" style="letter-spacing:.1em;color:var(--violet);padding:8px 2px 0">PHẦN II • ĐÚNG / SAI (${exam.tf.length} CHÙM)</div>`;
    html += exam.tf.map((q, i) => `<div class="qcard">
      <span class="qnum p">Chùm ${i + 1}</span>
      <div class="qtext">${q.title}</div>
      ${q.sub.map((s, j) => `<div class="tfrow">
        <div class="xs" style="color:var(--text)">${s.text}</div>
        <div class="tfbtns">
          <button id="t${i}_${j}_t" onclick="pickTF(${i},${j},true)">ĐÚNG</button>
          <button id="t${i}_${j}_f" onclick="pickTF(${i},${j},false)">SAI</button>
        </div>
      </div>`).join('')}
    </div>`).join('');
  }
  if (exam.short.length) {
    html += `<div class="tiny b" style="letter-spacing:.1em;color:var(--warn);padding:8px 2px 0">PHẦN III • TRẢ LỜI NGẮN (${exam.short.length} CÂU)</div>`;
    html += exam.short.map((q, i) => `<div class="qcard">
      <span class="qnum a">Câu ${i + 1}</span>
      <div class="qtext">${q.q}</div>
      <div class="row" style="gap:8px;flex-wrap:wrap">
        <div class="cells">${[0, 1, 2, 3].map(j => `<div class="cell" id="c${i}_${j}"></div>`).join('')}</div>
        <input type="text" maxlength="6" inputmode="decimal" placeholder="Nhập đáp án" style="flex:1;min-width:110px"
          oninput="pickS(${i},this.value)">
      </div>
    </div>`).join('');
  }
  $('#examBody').innerHTML = html;
  /* v4.3 — render lại (phân bổ độ khó, đổi kiểu làm bài...) không được làm
     mất lựa chọn của người học, kể cả khi đề bị materialize lại. */
  try {
    Object.keys(answers.mcq).forEach(function (k) {
      const i = Number(k), j = Number(answers.mcq[k]);
      if (!exam.mcq[i]) return;
      exam.mcq[i].o.forEach(function (_, x) {
        const el = document.getElementById('m' + i + '_' + x);
        if (el) el.className = 'opt' + (x === j ? ' sel' : '');
      });
    });
    Object.keys(answers.tf).forEach(function (k) {
      const p = k.split('_'), i = +p[0], x = +p[1], v = answers.tf[k];
      const a = document.getElementById('t' + i + '_' + x + '_t');
      const b = document.getElementById('t' + i + '_' + x + '_f');
      if (a) a.className = v === true ? 't' : '';
      if (b) b.className = v === false ? 'f' : '';
    });
    Object.keys(answers.short).forEach(function (k) {
      const v = answers.short[k] || '';
      for (let x = 0; x < 4; x++) {
        const el = document.getElementById('c' + k + '_' + x);
        if (el) el.textContent = v[x] || '';
      }
      const inp = document.querySelector('#examBody input[oninput="pickS(' + k + ',this.value)"]');
      if (inp) inp.value = v;
    });
  } catch (e) { }
  updateProgress();
}

function pickM(i, j) {
  i = Number(i); j = Number(j);
  const q = exam.mcq[i]; if (!q) return;
  answers.mcq[i] = j;
  try { beep(520, .02); } catch (e) { }
  q.o.forEach((_, k) => {
    const el = document.getElementById(`m${i}_${k}`);
    if (el) el.className = 'opt' + (k === j ? ' sel' : '');
  });
  updateProgress();
}
function pickTF(i, j, v) {
  answers.tf[`${i}_${j}`] = v; beep(540, .02);
  const t = document.getElementById(`t${i}_${j}_t`), f = document.getElementById(`t${i}_${j}_f`);
  t.className = v === true ? 't' : '';
  f.className = v === false ? 'f' : '';
  updateProgress();
}
function pickS(i, v) {
  answers.short[i] = v;
  for (let j = 0; j < 4; j++) document.getElementById(`c${i}_${j}`).textContent = (v || '')[j] || '';
  updateProgress();
}
function updateProgress() {
  const a = Object.keys(answers.mcq).length + Object.keys(answers.tf).length
    + Object.values(answers.short).filter(v => (v || '').trim() !== '').length;
  const total = exam.mcq.length + exam.tf.length * 4 + exam.short.length;
  $('#progressTxt').textContent = `${a} / ${total}`;
  $('#progressBar').style.width = total ? (a / total * 100) + '%' : '0%';
}
function startTimer() {
  clearInterval(timerId);
  tick();
  timerId = setInterval(function () {
    tick();
    if (remain <= 0) { clearInterval(timerId); timerId = null; gradeExam(true); }
  }, 250);
  if (!window.__examVisHook) {
    window.__examVisHook = true;
    document.addEventListener('visibilitychange', function () {
      if (document.hidden || !timerId || !endAt) return;
      tick();
      if (remain <= 0) { clearInterval(timerId); timerId = null; gradeExam(true); }
    });
  }
}
/* 1.2 — đồng hồ tính từ mốc endAt: tab ngủ, máy lag vẫn không lệch giờ */
function tick() {
  if (endAt) remain = Math.max(0, Math.ceil((endAt - Date.now()) / 1000));
  const m = Math.floor(Math.max(0, remain) / 60), s = Math.max(0, remain) % 60;
  $('#timerBadge').textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  const b = $('#timerBadge');
  if (remain <= 60) { b.style.color = 'var(--bad)'; b.style.borderColor = 'var(--bad)'; b.style.background = 'rgba(251,113,133,.14)'; }
  else if (remain <= 300) { b.style.color = 'var(--warn)'; b.style.borderColor = 'var(--warn)'; b.style.background = 'rgba(251,191,36,.12)'; }
  else { b.style.color = 'var(--accent)'; b.style.borderColor = 'rgba(61,220,151,.3)'; b.style.background = 'rgba(61,220,151,.14)'; }
}
function openSubmit() {
  const a = Object.keys(answers.mcq).length + Object.keys(answers.tf).length
    + Object.values(answers.short).filter(v => (v || '').trim() !== '').length;
  const total = exam.mcq.length + exam.tf.length * 4 + exam.short.length;
  $('#submitInfo').textContent = `Bạn đã làm ${a}/${total} ý. Còn ${Math.max(0, remain)} giây.`;
  $('#submitModal').classList.remove('hide');
  beep(460, .04);
}
function closeSubmit() { $('#submitModal').classList.add('hide'); }

/* 1.8 — chuẩn hoá đáp án ngắn: MỘT hàm dùng chung cho chấm bài, xem lại và ghi tiến độ.
   - bỏ khoảng trắng, đổi mọi dấu phẩy thành dấu chấm, đổi dấu trừ Unicode
   - nếu cả hai đều là số hợp lệ thì so theo giá trị (0,40 = 0.4 = .4)
   - ngược lại so chuỗi, không phân biệt hoa thường */
/** v4.3 — Chấm trắc nghiệm an toàn.
    Chịu được: chỉ số bị lệch do render lại, giá trị dạng chuỗi, và xáo phương án.
    Mọi đề đều gắn q.key = nội dung đáp án đúng nên không bao giờ "làm đúng mà 0 điểm". */
function ansCorrect(q, chosen) {
  if (!q || chosen === undefined || chosen === null || chosen === -1 || chosen === '') return false;
  const opts = q.o || [];
  const key = (q.key != null) ? q.key : opts[q.a];
  if (typeof chosen === 'number' && chosen === q.a) return true;
  const n = Number(chosen);
  if (Number.isFinite(n) && n >= 0 && n < opts.length) {
    if (n === q.a) return true;
    if (key != null && opts[n] === key) return true;
  }
  if (typeof chosen === 'string' && key != null && chosen === key) return true;
  return false;
}

function normAns(s) {
  const t = String(s == null ? '' : s)
    .trim()
    .replace(/\s+/g, '')
    .replace(/[,\u066B]/g, '.')
    .replace(/[\u2212\u2013\u2014]/g, '-');
  if (t === '') return '';
  if (/^-?(\d+(\.\d*)?|\.\d+)$/.test(t)) return 'n:' + String(Number(t));
  return 's:' + t.toLowerCase();
}

function gradeExam(auto) {
  /* v4.3 — KHÔNG chấm khi phòng thi solo không còn mở. Đây là nguyên nhân
     "làm bài xong vẫn 0 điểm": timer solo sót lại từ phiên trước bắn
     gradeExam() trong lúc đang ở phòng online, chấm đề cũ với answers rỗng. */
  const __room = document.getElementById('examRoom');
  if (!__room || __room.style.display === 'none') return;
  clearInterval(timerId); timerId = null;
  closeSubmit();
  try { beep(860, .14); } catch (e) { }

  let mcqOK = 0; exam.mcq.forEach((q, i) => { if (ansCorrect(q, answers.mcq[i])) mcqOK++; });
  let tfOK = 0, tfRaw = 0;
  exam.tf.forEach((q, i) => {
    let k = 0;
    q.sub.forEach((s, j) => { if (answers.tf[`${i}_${j}`] === s.ans) { k++; tfOK++; } });
    tfRaw += k === 4 ? 1 : k === 3 ? .5 : k === 2 ? .25 : k === 1 ? .1 : 0;
  });
  let sOK = 0;
  exam.short.forEach((q, i) => {
    const v = normAns(answers.short[i]);
    if (v !== '' && v === normAns(q.ans)) sOK++;
  });

  const parts = [];
  if (exam.mcq.length) parts.push({ k: 'p1', w: 4.5, r: mcqOK / exam.mcq.length });
  if (exam.tf.length) parts.push({ k: 'p2', w: 4.0, r: tfRaw / exam.tf.length });
  if (exam.short.length) parts.push({ k: 'p3', w: 1.5, r: sOK / exam.short.length });
  const wsum = parts.reduce((s, p) => s + p.w, 0);
  let p1 = 0, p2 = 0, p3 = 0;
  parts.forEach(p => { const v = p.r * p.w * (10 / wsum); if (p.k === 'p1') p1 = v; if (p.k === 'p2') p2 = v; if (p.k === 'p3') p3 = v; });
  const score = Math.min(10, Math.max(0, p1 + p2 + p3));
  try { BG4_STREAK.mark('q', exam.mcq.length + exam.tf.length * 4 + exam.short.length); BG4_STREAK.mark('xp', Math.round(score * 12)); } catch (e) { }

  $('#examRoom').style.display = 'none';
  $('#examReport').style.display = '';
  $('#repScore').textContent = score.toFixed(2);
  $('#repP1').textContent = p1.toFixed(2);
  $('#repP2').textContent = p2.toFixed(2);
  $('#repP3').textContent = p3.toFixed(2);
  $('#repVerdict').textContent = score >= 9 ? 'Xuất sắc — bản chất rất vững'
    : score >= 8 ? 'Giỏi — chỉ còn vài bẫy nhỏ'
    : score >= 6.5 ? 'Khá — cần rà lại các chuyên đề yếu'
    : score >= 5 ? 'Trung bình — nên đọc lại lý thuyết'
    : 'Cần ôn lại từ gốc';

  const byTopic = {};
  exam.mcq.forEach((q, i) => {
    byTopic[q.t] = byTopic[q.t] || { ok: 0, n: 0 };
    byTopic[q.t].n++; if (ansCorrect(q, answers.mcq[i])) byTopic[q.t].ok++;
  });
  let diag = Object.entries(byTopic).map(([k, v]) => {
    const pc = v.ok / v.n;
    const col = pc >= .8 ? 'var(--ok)' : pc >= .5 ? 'var(--warn)' : 'var(--bad)';
    return `<div>
      <div class="between xs" style="margin-bottom:4px"><span class="muted">${TOPICS[k].n}</span>
        <span class="mono b" style="color:${col}">${v.ok}/${v.n}</span></div>
      <div class="bar"><i style="width:${pc * 100}%;background:${col}"></i></div>
    </div>`;
  }).join('');
  if (exam.tf.length) {
    const pc = tfOK / (exam.tf.length * 4);
    diag += `<div class="between xs" style="margin-top:6px"><span class="muted">Đúng/Sai (theo ý)</span>
      <span class="mono b" style="color:${pc >= .8 ? 'var(--ok)' : 'var(--warn)'}">${tfOK}/${exam.tf.length * 4}</span></div>`;
  }
  if (exam.short.length) {
    const pc = sOK / exam.short.length;
    diag += `<div class="between xs" style="margin-top:6px"><span class="muted">Trả lời ngắn</span>
      <span class="mono b" style="color:${pc >= .8 ? 'var(--ok)' : 'var(--warn)'}">${sOK}/${exam.short.length}</span></div>`;
  }
  $('#repDiag').innerHTML = diag || '<div class="tiny">Không có dữ liệu.</div>';

  renderReview(mcqOK, tfOK, sOK);
  try { renderWrongReview(); } catch (e) { console.warn('[v4.5] wrong review', e); }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* =========================================================
   v4.5 — BÀI SAI: đáp án đúng + cách làm từng bước + hướng dẫn ôn tập
   ========================================================= */
let wrongFilter = 'wrong';

/** Phương pháp giải theo chuyên đề — giúp hướng dẫn sát nội dung từng câu. */
const TOPIC_METHOD = {
  dt: ['Xác định đúng đại lượng đề hỏi (số nucleotide, liên kết H, số bộ ba, chuỗi pôlipeptit…).',
       'Áp dụng nguyên tắc bổ sung A–T, G–C và quy tắc bán bảo tồn / 3 nucleotide = 1 codon.',
       'Lập tỉ lệ rồi tính ngược; nhớ gen gồm 2 mạch và chỉ 1 mạch làm khuôn.'],
  tv: ['Nhận diện quá trình (quang hợp, hô hấp, hút khoáng, thoát hơi nước…).',
       'Nhớ điều kiện xảy ra, vị trí (lá / rễ / lục lạp / ti thể) và yếu tố giới hạn.',
       'Suy luận chiều biến đổi khi thay đổi ánh sáng, CO₂, nhiệt độ, nồng độ ion.'],
  dv: ['Xác định cơ quan / hệ và thông số đang hỏi (áp suất, nhịp tim, nồng độ…).',
       'Nhớ cơ chế điều hoà thần kinh – thể dịch và nguyên tắc phản hồi ngược.',
       'Suy luận chiều thay đổi, rồi loại phương án ngược chiều hoặc sai vị trí tác động.'],
  ql: ['Nhận dạng dạng bài: phân li độc lập, liên kết gen, tương tác gen, đột biến, quần thể.',
       'Viết sơ đồ lai (P → F₁ → F₂) và xác định kiểu gen / kiểu hình tương ứng.',
       'Tính xác suất đúng yêu cầu; cảnh báo bẫy "kiểu gen" với "kiểu hình", "có thể" với "chắc chắn".'],
  nst: ['Đếm số NST / số cặp gen và xác định dạng đột biến (lệch bội, đa bội, cấu trúc).',
        'Vẽ sơ đồ phân li NST ở kì sau của giảm phân I và II.',
        'Suy ra số loại giao tử, tỉ lệ sống / thụ tinh rồi đối chiếu phương án.'],
  tb: ['Xác định bào quan / giai đoạn phân bào và chức năng tương ứng.',
       'Liên hệ cấu trúc ↔ chức năng; phân biệt các bào quan dễ nhầm (ribosome, lưới nội chất, bộ Gôlgi).',
       'Loại phương án gán sai chức năng, sai vị trí hoặc sai thứ tự diễn ra.']
};
const TOPIC_STUDY = {
  dt: 'Ôn lại cấu trúc DNA/RNA, nhân đôi, phiên mã, dịch mã và bảng mã di truyền.',
  tv: 'Ôn lại quang hợp (pha sáng – pha tối), hô hấp tế bào, trao đổi nước & khoáng ở rễ.',
  dv: 'Ôn lại tuần hoàn, hô hấp, tiêu hoá, bài tiết và cơ chế cân bằng nội môi.',
  ql: 'Ôn lại các định luật Menđen, liên kết gen, tương tác gen và di truyền quần thể.',
  nst: 'Ôn lại bộ NST lưỡng bội, đột biến số lượng / cấu trúc và giảm phân.',
  tb: 'Ôn lại cấu trúc tế bào, các bào quan, chu kì tế bào và nguyên phân / giảm phân.'
};
function wEsc(s) { return escHTML(String(s == null ? '' : s)); }
function wSteps(q) {
  const base = TOPIC_METHOD[q.t] || [
    'Đọc kỹ yêu cầu, gạch chân từ khoá và dữ kiện số liệu.',
    'Xác định khái niệm / định luật cần dùng.',
    'Lập luận từng bước, ghi kết quả trung gian rồi mới đối chiếu phương án.'
  ];
  const steps = [];
  if (q.tip) steps.push('Gợi ý nhanh: ' + q.tip);
  base.forEach(function (s) { steps.push(s); });
  steps.push('Đối chiếu cả 4 phương án; loại phương án sai bản chất hoặc sai điều kiện, rồi mới chốt đáp án.');
  return steps;
}
function wCard(opts) {
  return '<div class="wcard pad' + (opts.ok ? ' ok-card' : '') + '">' +
    '<div class="whead"><span class="qnum">' + wEsc(opts.no) + '</span>' +
      '<span class="chip" style="font-size:.55rem;padding:2px 7px">' + wEsc(opts.topic) + '</span>' +
      '<span class="wchip ' + opts.tone + '">' + wEsc(opts.badge) + '</span></div>' +
    '<div class="wq">' + opts.q + '</div>' + opts.body + '</div>';
}
function wMcqCard(q, i) {
  const u = answers.mcq[i];
  const ok = ansCorrect(q, u);
  const blank = u === undefined || u === null || u === '';
  const letter = function (j) { return 'ABCD'[j] === undefined ? '—' : 'ABCD'[j]; };
  const correctText = q.o[q.a];
  const pickedText = blank ? 'Bỏ trống' : (letter(Number(u)) + '. ' + (q.o[Number(u)] || '—'));
  const trapLow = String(q.trap || '').toLowerCase();
  const optsHtml = q.o.map(function (o, j) {
    const isC = j === q.a, isU = !blank && Number(u) === j;
    const cls = isC ? 'correct' : (isU ? 'picked' : '');
    let tag = '';
    if (isC) tag = '<span class="tag" style="color:var(--ok)">✓ ĐÚNG</span>';
    else if (isU) tag = '<span class="tag" style="color:var(--bad)">✗ BẠN CHỌN</span>';
    else if (trapLow && String(o).toLowerCase().slice(0, 14) && trapLow.indexOf(String(o).toLowerCase().slice(0, 14)) >= 0)
      tag = '<span class="tag" style="color:var(--warn)">🪤 bẫy</span>';
    return '<div class="wopt ' + cls + '"><span class="l">' + letter(j) + '</span><span>' + wEsc(o) + '</span>' + tag + '</div>';
  }).join('');
  const body =
    '<div class="wans">' +
      '<div class="wline good"><span class="k">Đáp án đúng</span><span><b>' + letter(q.a) + '. ' + wEsc(correctText) + '</b></span></div>' +
      '<div class="wline ' + (ok ? 'good' : 'badl') + '"><span class="k">Bạn chọn</span><span><b>' + wEsc(pickedText) + '</b></span></div>' +
    '</div>' +
    '<div class="wopts">' + optsHtml + '</div>' +
    '<div class="wsec"><div class="wt">🧭 CÁCH LÀM TỪNG BƯỚC</div><ol class="wsteps">' +
      wSteps(q).map(function (s, n) { return '<li><span class="n">' + (n + 1) + '</span><span>' + wEsc(s) + '</span></li>'; }).join('') +
    '</ol></div>' +
    '<div class="wsec" style="background:rgba(251,191,36,.05);border-color:rgba(251,191,36,.17)">' +
      '<div class="wt" style="color:var(--warn)">📌 BẢN CHẤT &amp; BẪY THƯỜNG GẶP</div>' +
      '<div class="wbody"><b>Bản chất:</b> ' + wEsc(q.why) + '</div>' +
      '<div class="wbody" style="margin-top:5px"><b>Bẫy:</b> ' + wEsc(q.trap) + '</div></div>' +
    (typeof BG4_LEARN !== 'undefined' ? BG4_LEARN.html(q, 'mcq') : '') +
    '<div class="wfoot">📚 ' + wEsc(TOPIC_STUDY[q.t] || 'Ôn lại lý thuyết chuyên đề này và làm lại 3–5 câu tương tự.') +
      ' · Mẹo: giải lại câu này trên giấy trắng sau 10 phút để kiểm tra đã hiểu chưa.</div>';
  return wCard({
    no: 'Câu ' + (i + 1), topic: (TOPICS[q.t] || {}).n || 'Tổng hợp',
    ok: ok, tone: ok ? 'ok' : (blank ? 'warn' : 'bad'),
    badge: ok ? '✓ ĐÚNG' : (blank ? 'BỎ TRỐNG' : '✗ SAI'),
    q: wEsc(q.q), body: body
  });
}
function wShortCard(q, i) {
  const u = answers.short[i];
  const ok = normAns(u) !== '' && normAns(u) === normAns(q.ans);
  const blank = !u || String(u).trim() === '';
  const body = '<div class="wans">' +
      '<div class="wline good"><span class="k">Đáp án đúng</span><span><b>' + wEsc(q.ans) + '</b></span></div>' +
      '<div class="wline ' + (ok ? 'good' : 'badl') + '"><span class="k">Bạn nhập</span><span><b>' + wEsc(blank ? 'Bỏ trống' : u) + '</b></span></div>' +
    '</div>' +
    '<div class="wsec"><div class="wt">🧭 CÁCH TÍNH / HƯỚNG DẪN CHI TIẾT</div>' +
      '<div class="wbody">' + wEsc(q.exp || 'Đối chiếu đơn vị, làm tròn và dấu thập phân (dấu phẩy được chấp nhận như dấu chấm).') + '</div></div>' +
    '<div class="wfoot">📚 Nhớ ghi đúng đơn vị và số chữ số có nghĩa; thử tính lại bằng tay một lần nữa.</div>';
  return wCard({ no: 'Câu ' + (i + 1) + ' · TLN', topic: 'Trả lời ngắn', ok: ok,
    tone: ok ? 'ok' : (blank ? 'warn' : 'bad'),
    badge: ok ? '✓ ĐÚNG' : (blank ? 'BỎ TRỐNG' : '✗ SAI'), q: wEsc(q.q), body: body });
}
function wTfStatement(q, i, s, j) {
  const u = answers.tf[i + '_' + j];
  const ok = u === s.ans;
  const blank = u === undefined;
  const body = '<div class="wans">' +
      '<div class="wline good"><span class="k">Đúng ra</span><span><b>' + (s.ans ? 'ĐÚNG' : 'SAI') + '</b></span></div>' +
      '<div class="wline ' + (ok ? 'good' : 'badl') + '"><span class="k">Bạn chọn</span><span><b>' + (blank ? 'Bỏ trống' : (u ? 'ĐÚNG' : 'SAI')) + '</b></span></div>' +
    '</div>' +
    '<div class="wsec"><div class="wt">🧭 GIẢI THÍCH Ý NÀY</div><div class="wbody">' + wEsc(s.exp) + '</div></div>' +
    '<div class="wfoot">📚 Đọc lại toàn bộ chùm câu: các ý trong một chùm thường liên quan cùng một cơ chế.</div>';
  return wCard({ no: 'Chùm ' + (i + 1) + ' · Ý ' + (j + 1), topic: (TOPICS[q.t] || {}).n || 'Đúng / Sai',
    ok: ok, tone: ok ? 'ok' : (blank ? 'warn' : 'bad'),
    badge: ok ? '✓ ĐÚNG' : (blank ? 'BỎ TRỐNG' : '✗ SAI'), q: wEsc(s.text), body: body });
}
function renderWrongReview() {
  const box = document.getElementById('wrongBox');
  const sum = document.getElementById('wrongSummary');
  if (!box || !sum) return;
  let wrong = 0, blank = 0, total = 0;
  const cards = [];
  exam.mcq.forEach(function (q, i) {
    total++;
    const u = answers.mcq[i];
    const ok = ansCorrect(q, u);
    if (!ok) { if (u === undefined || u === null || u === '') blank++; else wrong++; }
    if (wrongFilter === 'all' || !ok) cards.push(wMcqCard(q, i));
  });
  exam.tf.forEach(function (q, i) {
    q.sub.forEach(function (s, j) {
      total++;
      const u = answers.tf[i + '_' + j];
      const ok = u === s.ans;
      if (!ok) { if (u === undefined) blank++; else wrong++; }
      if (wrongFilter === 'all' || !ok) cards.push(wTfStatement(q, i, s, j));
    });
  });
  exam.short.forEach(function (q, i) {
    total++;
    const u = answers.short[i];
    const ok = normAns(u) !== '' && normAns(u) === normAns(q.ans);
    if (!ok) { if (!u || String(u).trim() === '') blank++; else wrong++; }
    if (wrongFilter === 'all' || !ok) cards.push(wShortCard(q, i));
  });
  const miss = wrong + blank;
  sum.innerHTML = '<div class="wsum"><div><div class="big">' + miss + ' / ' + total + ' ý cần xem lại</div>' +
    '<div class="tiny" style="color:var(--text3)">Mỗi thẻ bên dưới có <b>đáp án đúng</b>, <b>cách làm từng bước</b>, bản chất, bẫy và hướng ôn tập.</div></div>' +
    '<div class="wrap" style="gap:5px"><span class="wchip bad">✗ sai ' + wrong + '</span>' +
    '<span class="wchip warn">○ bỏ trống ' + blank + '</span>' +
    '<span class="wchip ok">✓ đúng ' + (total - miss) + '</span>' +
      (miss ? '<button class="btn sm" onclick="BG4_TUTOR.openWeak()">🧠 Gia sư AI giảng lại chỗ yếu</button>' : '') +
      '</div></div>';
  box.innerHTML = cards.length ? cards.join('')
    : '<div class="card pad" style="text-align:center"><div style="font-size:1.5rem">🎉</div>' +
      '<div class="b">Không có câu sai nào!</div><div class="tiny" style="margin-top:4px;color:var(--text3)">Bạn đã trả lời đúng tất cả — thử tăng độ khó hoặc đổi chuyên đề.</div></div>';
}
function setWrongFilter(f) {
  wrongFilter = f === 'all' ? 'all' : 'wrong';
  const a = document.getElementById('wfWrong'), b = document.getElementById('wfAll');
  if (a) a.classList.toggle('on', wrongFilter === 'wrong');
  if (b) b.classList.toggle('on', wrongFilter === 'all');
  renderWrongReview();
  try { beep(560, .025); } catch (e) { }
}

function renderReview() {
  let h = '<div class="tiny b" style="letter-spacing:.08em;color:var(--text3)">LỜI GIẢI CHI TIẾT</div>';
  exam.mcq.forEach((q, i) => {
    const u = answers.mcq[i], ok = ansCorrect(q, u);
    h += `<div class="qcard">
      <div class="between"><span class="qnum">Câu ${i + 1}</span><span class="badge ${ok ? 'g' : 'r'}">${ok ? 'ĐÚNG' : (u === undefined ? 'BỎ TRỐNG' : 'SAI')}</span></div>
      <div class="qtext">${q.q}</div>
      <div class="grid" style="gap:5px">${q.o.map((o, j) => `<div class="opt ${j === q.a ? 'ok' : (j === u ? 'bad' : '')}" style="cursor:default"><span class="k">${'ABCD'[j]}</span><span>${o}</span></div>`).join('')}</div>
      <div class="exp"><span class="tip">Bản chất</span>${q.why}${typeof BG4_LEARN !== 'undefined' ? BG4_LEARN.html(q, 'mcq') : ''}<span class="trap">Bẫy: ${q.trap}</span></div>
    </div>`;
  });
  exam.tf.forEach((q, i) => {
    h += `<div class="qcard">
      <span class="qnum p">Chùm ${i + 1}</span>
      <div class="qtext">${q.title}</div>
      ${q.sub.map((s, j) => {
        const u = answers.tf[`${i}_${j}`], ok = u === s.ans;
        return `<div class="tfrow" style="border-color:${ok ? 'rgba(52,211,153,.35)' : 'rgba(251,113,133,.3)'}">
          <div class="xs" style="color:var(--text)">${s.text}</div>
          <div class="row" style="gap:5px;margin-top:5px;flex-wrap:wrap">
            <span class="badge ${ok ? 'g' : 'r'}">${ok ? 'ĐÚNG' : 'SAI'}</span>
            <span class="tiny">Bạn chọn: ${u === undefined ? '—' : (u ? 'Đúng' : 'Sai')} • Chuẩn: ${s.ans ? 'Đúng' : 'Sai'}</span>
          </div>
          <div class="tiny" style="margin-top:4px">${s.exp}</div>
        </div>`;
      }).join('')}
    </div>`;
  });
  exam.short.forEach((q, i) => {
    const u = (answers.short[i] || '').trim().replace(',', '.');
    const ok = normAns(u) === normAns(q.ans);
    h += `<div class="qcard">
      <div class="between"><span class="qnum a">Câu ${i + 1}</span><span class="badge ${ok ? 'g' : 'r'}">${ok ? 'ĐÚNG' : 'SAI'}</span></div>
      <div class="qtext">${q.q}</div>
      <div class="tiny">Bạn nhập: <b>${u || '—'}</b> • Đáp án: <b class="hl">${q.ans}</b></div>
      <div class="exp"><span class="tip">Cách tính</span>${q.exp}</div>
    </div>`;
  });
  $('#reviewBox').innerHTML = h;
}
function toggleReview() {
  const box = $('#reviewBox');
  const open = box.style.display === 'none';
  box.style.display = open ? '' : 'none';
  $('#btnReview').innerHTML = open ? '<i class="fa-solid fa-eye-slash"></i> Ẩn lời giải' : '<i class="fa-solid fa-eye"></i> Xem lời giải';
  beep(500, .03);
}
function resetExam() {
  clearInterval(timerId); timerId = null; endAt = 0;
  $('#examReport').style.display = 'none';
  $('#examConfig').style.display = '';
  $('#reviewBox').style.display = 'none';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* =========================================================
   10. THỐNG KÊ CÀI ĐẶT
   ========================================================= */
function fillStats() {
  $('#stMCQ').textContent = MCQS.length;
  $('#stTF').textContent = TFS.length + ' × 4';
  $('#stShort').textContent = SHORTS.length;
  $('#stEssay').textContent = ESSAYS.length;
  $('#stLab').textContent = LABS.length;
}
/* =========================================================
   11. LAB ENGINE
   ========================================================= */
function P() {
  const dark = root.dataset.theme !== 'light';
  return dark
    ? { bg: '#050a12', bg2: '#0b1622', line: 'rgba(120,170,210,.15)', text: '#e3eef8', sub: '#93a9bf', soft: 'rgba(120,170,210,.06)', glass: 'rgba(255,255,255,.06)' }
    : { bg: '#f5fbf8', bg2: '#e9f4ef', line: 'rgba(18,70,55,.14)', text: '#123227', sub: '#4e6f62', soft: 'rgba(18,70,55,.05)', glass: 'rgba(255,255,255,.5)' };
}
function rr(c, x, y, w, h, r) {
  r = Math.min(r, w / 2, h / 2);
  c.beginPath();
  c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r);
  c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath();
}
function col(name) {
  if (!name) return P().text;
  if (!name.startsWith('var(')) return name;
  const k = name.slice(6, -1).trim();
  const map = { accent: '#3ddc97', accent2: '#38bdf8', ok: '#34d399', warn: '#fbbf24', bad: '#fb7185', nebula: '#8b7cf6' };
  if (k === 'text') return P().text;
  if (k === 'text2' || k === 'sub') return P().sub;
  return map[k] || P().text;
}
function tx(c, s, x, y, o = {}) {
  const { size = 11, color = P().text, weight = 600, align = 'left', base = 'alphabetic', mono = false } = o;
  c.font = `${weight} ${size}px ${mono ? "'JetBrains Mono',monospace" : "'Be Vietnam Pro',sans-serif"}`;
  c.fillStyle = col(color); c.textAlign = align; c.textBaseline = base;
  c.fillText(s, x, y);
}
function glow(c, x, y, r, col) {
  const g = c.createRadialGradient(x, y, 0, x, y, r);
  g.addColorStop(0, col); g.addColorStop(1, 'transparent');
  c.fillStyle = g; c.beginPath(); c.arc(x, y, r, 0, 6.283); c.fill();
}
function chipText(c, s, x, y, o = {}) {
  const { size = 9, color = '#fff', align = 'left', weight = 700 } = o;
  c.font = `${weight} ${size}px 'Be Vietnam Pro',sans-serif`;
  const wd = c.measureText(s).width + 11;
  let bx = x - 5.5;
  if (align === 'center') bx = x - wd / 2;
  if (align === 'right') bx = x - wd + 5.5;
  c.fillStyle = root.dataset.theme === 'light' ? 'rgba(255,255,255,.88)' : 'rgba(5,10,18,.78)';
  rr(c, bx, y - size - 4, wd, size + 9, 6); c.fill();
  c.strokeStyle = 'rgba(140,180,200,.22)'; c.lineWidth = .8; c.stroke();
  c.fillStyle = col(color); c.textAlign = 'left'; c.textBaseline = 'alphabetic';
  c.fillText(s, bx + 5.5, y + 1);
}
function vgrad(c, x, y, h, c1, c2) {
  const g = c.createLinearGradient(0, y, 0, y + h);
  g.addColorStop(0, c1); g.addColorStop(1, c2); return g;
}

/* ---------- 1.3 MỘT công thức độ mở khí khổng, dùng chung cho hình – số – lời giải ----------
   Mô hình nhân, đơn điệu theo cả ba biến (khớp sinh lý cơ bản):
     độ mở ≈ 0,95·L × (1 − 0,95·A) × (1 − 0,45·phần CO₂ vượt 400 ppm)
   L = ánh sáng 0..1, A = ABA 0..1, CO₂ giới hạn 200..1200 ppm.
   - Sáng tăng  → mở (tối = 0, không có ATP cho bơm K⁺).
   - ABA tăng   → đóng gần như hoàn toàn ở A = 1.
   - CO₂ cao    → đóng bớt, tối đa giảm 45 %.
   Trả về 0..1. */
function stomataOpenness(v) {
  /* Đáp ứng bão hoà theo ánh sáng (hình chữ nhật, K_L = 0,22),
     ức chế ABA dạng Hill (IC50 = 35%, n = 2,2),
     CO₂ nội làm đóng khí khổng theo hàm mũ suy giảm.
     Vẫn chừa ~4% độ mở nền cho trao đổi khí hô hấp trong tối. */
  const L = Math.max(0, Math.min(1, (v.light || 0) / 100));
  const A = Math.max(0, Math.min(1, (v.aba || 0) / 100));
  const C = Math.max(200, Math.min(1200, v.co2 == null ? 400 : v.co2));
  const lightTerm = 1.22 * L / (L + 0.22);
  const abaTerm = 1 / (1 + Math.pow(A / 0.35, 2.2));
  const co2Term = Math.exp(-0.0011 * Math.max(0, C - 400));
  return Math.max(0.03, Math.min(1, (0.04 + 0.96 * lightTerm) * abaTerm * co2Term));
}

const LABS = [
/* ---------- 1. PHÒNG KÍN ---------- */
{
  icon: 'fa-bed', name: 'Phòng kín ban đêm', short: 'Cân bằng O₂/CO₂',
  sub: 'Vì sao ngủ trong phòng đóng kín có cây xanh vẫn nguy hiểm?',
  tags: ['Sinh lý thực vật', 'Hô hấp'],
  note: 'Ban đêm không có ánh sáng, cây <b>chỉ hô hấp</b>: hút O₂ và thải CO₂ giống người. Cây không "sản xuất" O₂ vào ban đêm, nên phòng kín càng thêm thiếu O₂. Chỉ cây CAM (lưỡi hổ, xương rồng) mới mở khí khổng ban đêm nhưng vẫn tiêu thụ O₂ cho hô hấp.',
  v: { lux: 0, win: 0, cam: 0, people: 1 },
  controls: [
    { type: 'seg', k: 'cam', label: 'Loại cây', opts: [[0, 'Cây C3/C4'], [1, 'Cây CAM']] },
    { type: 'seg', k: 'win', label: 'Cửa sổ', opts: [[0, 'Đóng kín'], [1, 'Mở hé']] },
    { type: 'range', k: 'lux', label: 'Ánh sáng', min: 0, max: 1000, step: 50, unit: ' lux' },
    { type: 'range', k: 'people', label: 'Số người ngủ', min: 1, max: 4, step: 1, unit: ' người' }
  ],
  readouts: [['o2', 'O₂ trong phòng'], ['co2', 'CO₂'], ['spo2', 'SpO₂ người ngủ']],
  draw(c, w, h, t) {
    const p = P(), v = this.v, night = v.lux < 120, open = v.win === 1;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    // floor + wainscot
    c.fillStyle = night ? 'rgba(16,28,44,.85)' : 'rgba(216,238,228,.9)';
    c.fillRect(0, h * .615, w, h * .14);
    c.fillStyle = night ? 'rgba(24,38,55,.92)' : 'rgba(198,226,213,.95)';
    c.fillRect(0, h * .755, w, h * .245);
    c.strokeStyle = p.line; c.lineWidth = 1;
    c.beginPath(); c.moveTo(0, h * .615); c.lineTo(w, h * .615); c.stroke();
    c.beginPath(); c.moveTo(0, h * .755); c.lineTo(w, h * .755); c.stroke();
    for (let i = 0; i < 9; i++) {
      c.strokeStyle = night ? 'rgba(120,170,210,.06)' : 'rgba(18,70,55,.06)';
      c.beginPath(); c.moveTo(w * .11 * i, h * .755); c.lineTo(w * .11 * i - 70, h); c.stroke();
    }
    // rug
    c.fillStyle = night ? 'rgba(60,92,128,.30)' : 'rgba(255,255,255,.5)';
    c.beginPath(); c.ellipse(w * .76, h * .875, w * .21, h * .065, 0, 0, 6.283); c.fill();

    // ---------- WINDOW ----------
    const wx = w * .055, wy = h * .10, ww = w * .19, wh = h * .40;
    c.save();
    c.beginPath(); c.rect(wx, wy, ww, wh); c.clip();
    if (night) {
      c.fillStyle = '#050b18'; c.fillRect(wx, wy, ww, wh);
      for (let i = 0; i < 14; i++) {
        const a = .25 + .6 * Math.abs(Math.sin(t * .8 + i * 1.7));
        c.fillStyle = 'rgba(255,255,255,' + a.toFixed(2) + ')';
        c.beginPath(); c.arc(wx + 6 + (i * 41 % (ww - 12)), wy + 6 + (i * 67 % (wh - 12)), .9 + (i % 3) * .4, 0, 6.283); c.fill();
      }
      const mx = wx + ww * .68, my = wy + wh * .24;
      glow(c, mx, my, h * .13, 'rgba(180,215,255,.30)');
      c.fillStyle = '#e9f1ff'; c.beginPath(); c.arc(mx, my, h * .030, 0, 6.283); c.fill();
      c.fillStyle = 'rgba(0,0,0,.10)'; c.beginPath(); c.arc(mx + h * .010, my - h * .008, h * .024, 0, 6.283); c.fill();
    } else {
      const sky = c.createLinearGradient(0, wy, 0, wy + wh);
      sky.addColorStop(0, '#9fd8ff'); sky.addColorStop(1, '#d8f0ff');
      c.fillStyle = sky; c.fillRect(wx, wy, ww, wh);
      glow(c, wx + ww * .72, wy + wh * .22, h * .18, 'rgba(255,232,150,.55)');
      c.fillStyle = '#ffe58a'; c.beginPath(); c.arc(wx + ww * .72, wy + wh * .22, h * .032, 0, 6.283); c.fill();
      c.fillStyle = 'rgba(255,255,255,.75)';
      c.beginPath(); c.ellipse(wx + ww * .28, wy + wh * .34, ww * .16, h * .028, 0, 0, 6.283); c.fill();
      c.beginPath(); c.ellipse(wx + ww * .38, wy + wh * .30, ww * .10, h * .022, 0, 0, 6.283); c.fill();
      // hills
      c.fillStyle = 'rgba(120,200,160,.55)';
      c.beginPath(); c.moveTo(wx, wy + wh * .82); c.quadraticCurveTo(wx + ww * .35, wy + wh * .70, wx + ww * .62, wy + wh * .82);
      c.quadraticCurveTo(wx + ww * .82, wy + wh * .90, wx + ww, wy + wh * .78); c.lineTo(wx + ww, wy + wh); c.lineTo(wx, wy + wh); c.fill();
    }
    c.restore();
    // frame
    c.strokeStyle = night ? 'rgba(190,215,240,.45)' : 'rgba(255,255,255,.95)'; c.lineWidth = 3.5;
    c.strokeRect(wx, wy, ww, wh);
    c.lineWidth = 2;
    c.beginPath(); c.moveTo(wx + ww / 2, wy); c.lineTo(wx + ww / 2, wy + wh);
    c.moveTo(wx, wy + wh / 2); c.lineTo(wx + ww, wy + wh / 2); c.stroke();
    // sill
    c.fillStyle = night ? 'rgba(150,180,210,.30)' : 'rgba(255,255,255,.9)';
    rr(c, wx - 5, wy + wh, ww + 10, h * .018, 3); c.fill();
    // curtains
    c.fillStyle = night ? 'rgba(40,62,92,.85)' : 'rgba(255,255,255,.8)';
    c.beginPath(); c.moveTo(wx - 12, wy - 6); c.quadraticCurveTo(wx + 8, wy + wh * .5, wx - 4, wy + wh + 6);
    c.lineTo(wx - 20, wy + wh + 6); c.lineTo(wx - 20, wy - 6); c.fill();
    c.beginPath(); c.moveTo(wx + ww + 12, wy - 6); c.quadraticCurveTo(wx + ww - 8, wy + wh * .5, wx + ww + 4, wy + wh + 6);
    c.lineTo(wx + ww + 20, wy + wh + 6); c.lineTo(wx + ww + 20, wy - 6); c.fill();
    if (open) { c.fillStyle = 'rgba(120,210,255,.10)'; c.fillRect(wx, wy, ww, wh); }

    // ---------- NIGHTSTAND + LAMP ----------
    const nsx = w * .315, nsy = h * .655, nsw = w * .10, nsh = h * .10;
    c.fillStyle = night ? '#2a3a4e' : '#c9a882';
    rr(c, nsx, nsy, nsw, nsh, 4); c.fill();
    c.fillStyle = 'rgba(0,0,0,.18)'; rr(c, nsx, nsy, nsw, h * .012, 3); c.fill();
    // lamp
    const lx = nsx + nsw * .5, ly = nsy;
    c.strokeStyle = night ? '#6b7f96' : '#8a6a4a'; c.lineWidth = 2.5;
    c.beginPath(); c.moveTo(lx, ly); c.lineTo(lx, ly - h * .10); c.stroke();
    c.fillStyle = night ? '#f6d68a' : '#e8c46a';
    c.beginPath(); c.moveTo(lx - w * .028, ly - h * .10); c.lineTo(lx + w * .028, ly - h * .10);
    c.lineTo(lx + w * .017, ly - h * .155); c.lineTo(lx - w * .017, ly - h * .155); c.closePath(); c.fill();
    if (night) glow(c, lx, ly - h * .12, h * .16, 'rgba(255,210,120,.22)');

    // ---------- PLANT ----------
    const px = w * .47, py = h * .755;
    c.fillStyle = night ? '#5b3d26' : '#a9713f';
    c.beginPath(); c.moveTo(px - h * .055, py - h * .115); c.lineTo(px + h * .055, py - h * .115);
    c.lineTo(px + h * .042, py); c.lineTo(px - h * .042, py); c.closePath(); c.fill();
    c.fillStyle = 'rgba(0,0,0,.20)'; rr(c, px - h * .055, py - h * .115, h * .11, h * .018, 3); c.fill();
    c.fillStyle = night ? '#2d1f14' : '#4a3323'; c.fillRect(px - h * .048, py - h * .128, h * .096, h * .015);
    if (v.cam) {
      for (let i = 0; i < 6; i++) {
        const a = -2.1 + i * .42, L = h * .24 + (i % 2) * h * .06;
        c.save(); c.translate(px, py - h * .128); c.rotate(a * .30);
        const g = c.createLinearGradient(0, 0, 0, -L);
        g.addColorStop(0, night ? '#0b4a33' : '#12805a'); g.addColorStop(1, night ? '#1e8f63' : '#3ddc97');
        c.fillStyle = g;
        c.beginPath(); c.moveTo(-h * .020, 0); c.quadraticCurveTo(-h * .030, -L * .6, 0, -L);
        c.quadraticCurveTo(h * .030, -L * .6, h * .020, 0); c.fill();
        c.strokeStyle = 'rgba(255,255,255,.20)'; c.lineWidth = 1;
        c.beginPath(); c.moveTo(0, 0); c.lineTo(0, -L); c.stroke();
        c.restore();
      }
    } else {
      c.strokeStyle = night ? '#1c5c3e' : '#1f8a5c'; c.lineWidth = 3;
      c.beginPath(); c.moveTo(px, py - h * .128); c.quadraticCurveTo(px + 6, py - h * .24, px, py - h * .30); c.stroke();
      for (let i = 0; i < 7; i++) {
        const a = i * .95 + .2, R = h * .115;
        const cx2 = px + Math.cos(a) * R * .95, cy2 = py - h * .30 + Math.sin(a) * R * .62;
        const g = c.createRadialGradient(cx2, cy2, 1, cx2, cy2, h * .075);
        g.addColorStop(0, night ? '#1c7a55' : '#4ae3a6'); g.addColorStop(1, night ? '#0a3527' : '#0f7a54');
        c.fillStyle = g;
        c.beginPath(); c.ellipse(cx2, cy2, h * .072, h * .046, a, 0, 6.283); c.fill();
        c.strokeStyle = 'rgba(255,255,255,.10)'; c.lineWidth = 1;
        c.beginPath(); c.moveTo(cx2, cy2); c.lineTo(cx2 + Math.cos(a) * h * .06, cy2 + Math.sin(a) * h * .035); c.stroke();
      }
    }

    // ---------- BED ----------
    const bx = w * .575, by = h * .615, bw = w * .395, bh = h * .185;
    const danger = night && !open;
    // headboard
    c.fillStyle = night ? '#33445c' : '#b98f63';
    rr(c, bx + bw - w * .022, by - h * .075, w * .022, bh + h * .075, 5); c.fill();
    // frame
    c.fillStyle = night ? '#2b3a4e' : '#a87f55';
    rr(c, bx, by + bh * .55, bw, bh * .45, 5); c.fill();
    // mattress
    c.fillStyle = night ? '#dbe6f4' : '#f8fbff';
    rr(c, bx + 4, by + bh * .28, bw - 8, bh * .40, 8); c.fill();
    c.strokeStyle = 'rgba(0,0,0,.10)'; c.lineWidth = 1; c.stroke();
    // blanket
    const br = Math.sin(t * 1.5) * 2;
    const bg2 = c.createLinearGradient(0, by + bh * .30, 0, by + bh);
    if (danger) { bg2.addColorStop(0, '#8f3145'); bg2.addColorStop(1, '#5c1c2b'); }
    else { bg2.addColorStop(0, night ? '#2b6b8a' : '#4aa6c4'); bg2.addColorStop(1, night ? '#17415a' : '#2b7d9c'); }
    c.fillStyle = bg2;
    c.beginPath();
    c.moveTo(bx + 6, by + bh * .46 + br * .3);
    c.bezierCurveTo(bx + bw * .10, by + bh * .30 + br * .5, bx + bw * .26, by + bh * .27 + br * .6, bx + bw * .42, by + bh * .33 + br * .4);
    c.quadraticCurveTo(bx + bw * .60, by + bh * .38, bx + bw * .74, by + bh * .42 + br * .3);
    c.lineTo(bx + bw * .74, by + bh * .96);
    c.lineTo(bx + 6, by + bh * .95);
    c.closePath(); c.fill();
    // folded edge
    c.strokeStyle = 'rgba(255,255,255,.30)'; c.lineWidth = 2;
    c.beginPath(); c.moveTo(bx + 6, by + bh * .42 + br * .3);
    c.bezierCurveTo(bx + bw * .10, by + bh * .30 + br * .5, bx + bw * .26, by + bh * .27 + br * .6, bx + bw * .42, by + bh * .33 + br * .4);
    c.quadraticCurveTo(bx + bw * .60, by + bh * .38, bx + bw * .74, by + bh * .42 + br * .3); c.stroke();
    // pillow
    c.fillStyle = night ? '#eef4fc' : '#ffffff';
    rr(c, bx + bw * .655, by + bh * .19, bw * .135, bh * .19, 8); c.fill();
    c.strokeStyle = 'rgba(30,60,90,.18)'; c.lineWidth = 1.2; c.stroke();
    // head
    const hx = bx + bw * .735, hy = by + bh * .30;
    c.fillStyle = danger ? '#f0b3bd' : '#f6d6b0';
    c.beginPath(); c.arc(hx, hy, h * .038, 0, 6.283); c.fill();
    c.fillStyle = night ? '#2b2118' : '#3a2a1c';
    c.beginPath(); c.arc(hx - h * .006, hy - h * .012, h * .036, Math.PI * .95, Math.PI * 2.05); c.fill();
    // closed eye
    c.strokeStyle = '#7a5540'; c.lineWidth = 1.2;
    c.beginPath(); c.arc(hx + h * .012, hy + h * .004, h * .008, .2, 2.9); c.stroke();
    // breathing ring
    c.strokeStyle = danger ? 'rgba(251,113,133,.55)' : 'rgba(61,220,151,.42)';
    c.lineWidth = 1.6;
    c.beginPath(); c.arc(hx, hy, h * .048 + br * .5, 0, 6.283); c.stroke();
    // extra people
    for (let i = 1; i < v.people; i++) {
      c.fillStyle = '#eef3fa';
      c.beginPath(); c.arc(bx + bw * (.62 - i * .13), by + bh * .34, h * .026, 0, 6.283); c.fill();
    }
    // Zzz
    if (night) {
      for (let i = 0; i < 3; i++) {
        const a = .25 + .35 * Math.abs(Math.sin(t * .9 + i));
        tx(c, 'z', hx + h * .045 + i * 7, hy - h * .05 - i * 9, { size: 8 + i * 2, color: 'rgba(190,215,240,' + a.toFixed(2) + ')', weight: 800 });
      }
    }

    // particles
    const n = 34;
    for (let i = 0; i < n; i++) {
      const seed = i * 97.3;
      const x = (seed * 13 + t * 14 * (i % 3 + 1)) % w;
      const y = (seed * 7 + Math.sin(t * .7 + i) * 18 + h * .3) % (h * .72) + h * .04;
      const isO2 = (i % 5) < (v.lux > 120 ? 4 : 2) || (v.cam && night && i % 5 < 3);
      c.fillStyle = isO2 ? 'rgba(61,220,151,.75)' : 'rgba(251,113,133,.7)';
      c.beginPath(); c.arc(x, y, isO2 ? 2.6 : 3, 0, 6.283); c.fill();
      if (isO2) glow(c, x, y, 6, 'rgba(61,220,151,.22)');
    }
    // haze
    if (night && !open) { c.fillStyle = 'rgba(251,113,133,.045)'; c.fillRect(0, 0, w, h); }

    // HUD
    tx(c, night ? 'BAN ĐÊM • Không quang hợp' : 'BAN NGÀY • Có quang hợp', w * .05, h * .055, { size: 10, color: p.sub, weight: 700 });
    tx(c, open ? 'Cửa mở: trao đổi khí với ngoài' : 'Phòng kín: khí bị giữ lại', w * .95, h * .055, { size: 10, color: open ? 'var(--accent2)' : 'var(--warn)', align: 'right', weight: 700 });

    /* --- Mô hình cân bằng khí (thể tích phòng ~30 m³, một đêm 8 h) ---
       Quang hợp bão hoà theo ánh sáng (K ≈ 250 lux); hô hấp của người
       tỉ lệ với số người; thông khí (ACH) kéo nồng độ về mức khí quyển. */
    const lux = Math.max(0, +v.lux || 0), people = Math.max(1, +v.people || 1), cam = v.cam === 1;
    const photo = (lux / (lux + 250)) * (cam ? 2.6 : 4.0);
    const respPlant = cam ? 0.30 : 0.75;
    const respHuman = 1.35 * people;
    const net = photo - respPlant - respHuman;
    const ach = open ? 2.4 : 0.12;
    let o2 = 20.9 + net / (1 + ach);
    o2 = Math.max(12, Math.min(21.8, o2));
    const co2 = Math.round(Math.min(7000, 420 + Math.max(0, 20.9 - o2) * 900 / (1 + ach * 0.4)));
    /* Độ bão hoà Hb theo phương trình Hill (P50 = 26,6 mmHg, n = 2,7) —
       dạng chữ S: trên 60 mmHg gần bão hoà, dưới ngưỡng đó tụt rất nhanh. */
    const pAO2 = Math.max(35, 100 - 9.5 * Math.max(0, 20.9 - o2));
    const pw = Math.pow(pAO2, 2.7), p50 = Math.pow(26.6, 2.7);
    const spo2 = Math.max(70, Math.min(99, 100 * pw / (pw + p50)));
    ro('o2', o2.toFixed(1) + '%', o2 < 17 ? 'var(--bad)' : o2 < 19.5 ? 'var(--warn)' : 'var(--ok)');
    ro('co2', co2 + ' ppm', co2 > 2500 ? 'var(--bad)' : co2 > 1200 ? 'var(--warn)' : 'var(--ok)');
    ro('spo2', spo2.toFixed(0) + '% • ' + (spo2 < 90 ? 118 : 64) + ' bpm', spo2 < 90 ? 'var(--bad)' : 'var(--ok)');
  }
},
/* ---------- 2. KINESIN ---------- */
{
  icon: 'fa-truck-fast', name: 'Kinesin trên vi ống', short: 'Vận chuyển nội bào',
  sub: 'Túi tiết đi trên “đường ray” vi ống nhờ ATP.',
  tags: ['Tế bào', 'Khung xương'],
  note: 'Kinesin là “động cơ phân tử” bước từng bước 8 nm dọc vi ống về phía đầu (+), tiêu tốn 1 ATP mỗi bước. Nếu vi ống bị phá (colchicine), túi tiết <b>không thể</b> đến màng → protein ứ lại trong tế bào.',
  v: { atp: 100, micro: 100, pos: 0.12 },
  controls: [
    { type: 'range', k: 'atp', label: 'ATP thủy phân', min: 0, max: 100, step: 5, unit: '%' },
    { type: 'range', k: 'micro', label: 'Độ bền vi ống', min: 0, max: 100, step: 5, unit: '%' }
  ],
  readouts: [['speed', 'Tốc độ'], ['dist', 'Quãng đường'], ['state', 'Trạng thái']],
  draw(c, w, h, t) {
    const p = P(), v = this.v, broken = v.micro < 30;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    // cell membrane hint
    c.strokeStyle = p.line; c.lineWidth = 3; rr(c, 8, 8, w - 16, h - 16, 22); c.stroke();

    const my = h * .70;
    // microtubule
    const segW = h * .072;
    for (let x = w * .06; x < w * .94; x += segW) {
      const idx = Math.round((x - w * .06) / segW);
      const gap = broken && x > w * .42 && x < w * .58;
      if (gap) continue;
      c.fillStyle = idx % 2 ? 'rgba(56,189,248,.55)' : 'rgba(61,220,151,.5)';
      c.beginPath(); c.arc(x, my - h * .018, segW * .42, 0, 6.283); c.fill();
      c.fillStyle = idx % 2 ? 'rgba(56,189,248,.4)' : 'rgba(61,220,151,.36)';
      c.beginPath(); c.arc(x, my + h * .018, segW * .42, 0, 6.283); c.fill();
    }
    if (broken) {
      tx(c, 'VI ỐNG ĐỨT', w * .5, my - h * .12, { size: 11, color: 'var(--bad)', align: 'center', weight: 800 });
    }
    // cargo position
    if (!broken) v.pos += (v.atp / 100) * .0022;
    if (v.pos > .86) v.pos = .10;
    const cx = w * (.06 + v.pos * .88), cy = my - h * .30;
    // legs
    const step = Math.sin(t * 9) * (v.atp > 5 ? 1 : 0);
    c.strokeStyle = '#fbbf24'; c.lineWidth = 3.5; c.lineCap = 'round';
    c.beginPath();
    c.moveTo(cx - h * .03, cy + h * .05); c.lineTo(cx - h * .05 + step * h * .02, my - h * .03);
    c.moveTo(cx + h * .03, cy + h * .05); c.lineTo(cx + h * .05 - step * h * .02, my - h * .03);
    c.stroke();
    // vesicle
    const g = c.createRadialGradient(cx - h * .02, cy - h * .03, 1, cx, cy, h * .11);
    g.addColorStop(0, '#fde68a'); g.addColorStop(1, '#d97706');
    c.fillStyle = g; c.beginPath(); c.arc(cx, cy, h * .10, 0, 6.283); c.fill();
    c.strokeStyle = 'rgba(255,255,255,.45)'; c.lineWidth = 1.5; c.stroke();
    tx(c, 'protein', cx, cy + 3, { size: 8.5, color: '#3b2503', align: 'center', weight: 800 });

    // ATP sparks
    for (let i = 0; i < 6; i++) {
      const a = t * 1.6 + i * 1.05;
      const r = h * .13 + Math.sin(t * 2 + i) * h * .03;
      const x = cx + Math.cos(a) * r, y = cy + Math.sin(a) * r * .7;
      if (v.atp > 5) { glow(c, x, y, 9, 'rgba(251,191,36,.5)'); c.fillStyle = '#fbbf24'; c.beginPath(); c.arc(x, y, 2.6, 0, 6.283); c.fill(); }
    }
    // destination membrane
    c.fillStyle = 'rgba(61,220,151,.18)'; c.fillRect(w * .93, h * .18, w * .05, h * .55);
    tx(c, 'màng', w * .955, h * .16, { size: 8, color: p.sub, align: 'center' });

    tx(c, 'Vi ống (microtubule)', w * .06, h * .90, { size: 9.5, color: p.sub });
    /* v = Vmax·[ATP]/(Km+[ATP]) với Km = 18% ; độ bền vi ống quyết định
       xác suất còn bám ray (sigmoid quanh 35%). 1 ATP ≈ 1 bước 8 nm. */
    const atpF = Math.max(0, +v.atp || 0) / 100;
    const mm = atpF / (atpF + 0.18) / (1 / 1.18);
    const track = Math.max(0, Math.min(1, (+v.micro || 0) / 100));
    const attach = 1 / (1 + Math.exp(-(track - 0.35) * 12));
    const speed = broken ? 0 : Math.round(800 * mm * attach);
    ro('speed', broken ? '0 nm/s' : speed + ' nm/s', broken ? 'var(--bad)' : 'var(--accent)');
    ro('dist', Math.round(v.pos * 100) + '% quãng đường', p.text);
    ro('state', broken ? 'Túi ứ trong tế bào' : v.atp < 20 ? 'Thiếu ATP — dừng' : 'Đang vận chuyển',
      broken || v.atp < 20 ? 'var(--bad)' : 'var(--ok)');
  }
},
/* ---------- 3. ĐIỆN THẾ ---------- */
{
  icon: 'fa-wave-square', name: 'Điện thế hoạt động', short: 'Oscilloscope nơron',
  sub: 'Đọc đồ thị điện thế màng theo từng điều kiện ion.',
  tags: ['Điện sinh học', 'Nơron'],
  note: 'Điện thế nghỉ phụ thuộc chủ yếu vào gradient K⁺. Giảm K⁺ nội bào → màng bớt âm (−50 mV) và mất đỉnh. Chặn kênh Na⁺ (TTX) → không có khử cực, mất hoàn toàn điện thế hoạt động.',
  v: { mode: 0 },
  controls: [{ type: 'seg', k: 'mode', label: 'Điều kiện thí nghiệm', opts: [[0, 'Bình thường'], [1, 'Giảm K⁺ trong'], [2, 'Chặn kênh Na⁺'], [3, 'Tăng K⁺ ngoài']] }],
  readouts: [['rest', 'Điện thế nghỉ'], ['peak', 'Đỉnh'], ['amp', 'Biên độ']],
  draw(c, w, h, t) {
    const p = P(), m = this.v.mode;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    const L = w * .09, R = w * .97, T = h * .12, B = h * .88;
    const yOf = mv => T + (40 - mv) / 130 * (B - T);
    // grid
    c.strokeStyle = p.line; c.lineWidth = 1;
    for (let mv = -90; mv <= 40; mv += 10) { const y = yOf(mv); c.beginPath(); c.moveTo(L, y); c.lineTo(R, y); c.stroke(); }
    for (let i = 0; i <= 10; i++) { const x = L + (R - L) * i / 10; c.beginPath(); c.moveTo(x, T); c.lineTo(x, B); c.stroke(); }
    // axis labels
    [-90, -70, -50, -30, 0, 30].forEach(mv => tx(c, mv + '', L - 6, yOf(mv) + 3, { size: 8.5, color: p.sub, align: 'right', mono: true }));
    tx(c, 'mV', L - 6, T - 8, { size: 8.5, color: p.sub, align: 'right' });
    tx(c, 'thời gian →', R, B + 16, { size: 9, color: p.sub, align: 'right' });

    // threshold
    c.setLineDash([4, 4]); c.strokeStyle = 'rgba(251,191,36,.45)';
    c.beginPath(); c.moveTo(L, yOf(-55)); c.lineTo(R, yOf(-55)); c.stroke(); c.setLineDash([]);
    tx(c, 'ngưỡng', R - 4, yOf(-55) - 5, { size: 8, color: 'var(--warn)', align: 'right' });

    const base = m === 1 || m === 3 ? -50 : -70;
    const spike = m === 2 ? 0 : (m === 3 ? .55 : 1);
    const col = m === 0 ? '#3ddc97' : m === 1 ? '#fbbf24' : '#fb7185';
    // baseline glow
    c.strokeStyle = 'rgba(255,255,255,.08)'; c.lineWidth = 1;
    c.beginPath(); c.moveTo(L, yOf(-70)); c.lineTo(R, yOf(-70)); c.stroke();

    const x0 = L + (R - L) * .30, x1 = x0 + (R - L) * .30;
    const path = [];
    for (let x = L; x <= R; x += 2) {
      let mv = base;
      if (x >= x0 && x <= x1 && spike > 0) {
        const q = (x - x0) / (x1 - x0);
        if (q < .16) mv = base + (30 - base) * (q / .16) * spike;
        else if (q < .40) mv = 30 * spike + base * (1 - spike) - ((q - .16) / .24) * (30 * spike + base * (1 - spike) + 80);
        else if (q < .55) mv = -80 + ((q - .40) / .15) * 8;
        else mv = base + (1 - (q - .55) / .45) * 8 - 8;
      } else if (x > x1 && x < x1 + 30 && spike > 0) {
        mv = base - 6 * Math.exp(-(x - x1) / 9);
      }
      path.push([x, yOf(mv)]);
    }
    // fill under curve
    c.beginPath(); c.moveTo(path[0][0], path[0][1]);
    path.forEach(pt => c.lineTo(pt[0], pt[1]));
    c.lineTo(R, B); c.lineTo(L, B); c.closePath();
    const fg = c.createLinearGradient(0, T, 0, B);
    fg.addColorStop(0, col + '33'); fg.addColorStop(1, 'transparent');
    c.fillStyle = fg; c.fill();
    // line
    c.beginPath(); c.moveTo(path[0][0], path[0][1]);
    path.forEach(pt => c.lineTo(pt[0], pt[1]));
    c.strokeStyle = col; c.lineWidth = 2.4; c.lineJoin = 'round';
    c.shadowColor = col; c.shadowBlur = 10; c.stroke(); c.shadowBlur = 0;

    // moving cursor
    const cxp = L + ((t * 90) % (R - L));
    const cyv = path[Math.min(path.length - 1, Math.floor((cxp - L) / 2))] || [cxp, yOf(base)];
    c.fillStyle = col; c.beginPath(); c.arc(cxp, cyv[1], 3, 0, 6.283); c.fill();
    glow(c, cxp, cyv[1], 12, col + '66');

    tx(c, ['Bình thường', 'Giảm K⁺ nội bào', 'TTX — chặn kênh Na⁺', 'Tăng K⁺ ngoại bào'][m], L + 4, T + 4, { size: 10.5, color: col, weight: 800 });
    const peak = spike === 0 ? base : (m === 3 ? -30 : 30);
    ro('rest', base + ' mV', m === 0 ? 'var(--ok)' : 'var(--warn)');
    ro('peak', peak + ' mV', peak > 0 ? 'var(--ok)' : 'var(--bad)');
    ro('amp', Math.round(peak - base) + ' mV', peak - base > 60 ? 'var(--accent)' : 'var(--bad)');
  }
},
/* ---------- 4. C3 vs C4 ---------- */
{
  icon: 'fa-leaf', name: 'Giải phẫu C3 / C4', short: 'Lát cắt lá',
  sub: 'So sánh cấu trúc Kranz và nơi Rubisco làm việc.',
  tags: ['Quang hợp', 'Thực vật'],
  note: 'C4 tách <b>không gian</b>: mô giậu bắt CO₂ bằng PEP-carboxylase, bao bó mạch chạy Calvin. C3 làm tất cả trong một loại tế bào nên khi nóng, Rubisco gặp O₂ → hô hấp sáng.',
  v: { type: 0 },
  controls: [{ type: 'seg', k: 'type', label: 'Kiểu thực vật', opts: [[0, 'C3 (lúa, đậu)'], [1, 'C4 (ngô, mía)']] }],
  readouts: [['type', 'Kiểu'], ['rub', 'Nơi có Rubisco'], ['photo', 'Hô hấp sáng']],
  draw(c, w, h, t) {
    const p = P(), isC4 = this.v.type === 1;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    const top = h * .16, bot = h * .84;

    // epidermis
    c.fillStyle = 'rgba(120,200,150,.20)';
    c.fillRect(w * .04, top - h * .10, w * .92, h * .09);
    c.fillRect(w * .04, bot + h * .01, w * .92, h * .09);
    for (let i = 0; i < 14; i++) {
      c.strokeStyle = 'rgba(120,200,150,.35)'; c.lineWidth = 1;
      c.strokeRect(w * .04 + i * w * .066, top - h * .10, w * .066, h * .09);
      c.strokeRect(w * .04 + i * w * .066, bot + h * .01, w * .066, h * .09);
    }
    // stoma: hai tế bào hạt đậu + lỗ khí
    const sx = w * .22, sy = bot + h * .055;
    c.fillStyle = '#2f9e6b';
    c.beginPath(); c.ellipse(sx - w * .022, sy, w * .022, h * .032, 0, 0, 6.283); c.fill();
    c.beginPath(); c.ellipse(sx + w * .022, sy, w * .022, h * .032, 0, 0, 6.283); c.fill();
    c.strokeStyle = 'rgba(198,255,228,.6)'; c.lineWidth = 1.4;
    c.beginPath(); c.ellipse(sx - w * .022, sy, w * .022, h * .032, 0, 0, 6.283); c.stroke();
    c.beginPath(); c.ellipse(sx + w * .022, sy, w * .022, h * .032, 0, 0, 6.283); c.stroke();
    c.fillStyle = p.bg; c.beginPath(); c.ellipse(sx, sy, w * .008, h * .026, 0, 0, 6.283); c.fill();
    chipText(c, 'khí khổng', sx + w * .055, sy + h * .012, { color: p.text, size: 8.5 });

    function cell(x, y, cw, ch, tint, nucleus) {
      // thành tế bào (hai lớp)
      c.strokeStyle = 'rgba(198,255,228,.55)'; c.lineWidth = 2.6;
      rr(c, x, y, cw, ch, Math.min(cw, ch) * .22); c.stroke();
      const g = c.createLinearGradient(x, y, x + cw * .45, y + ch);
      g.addColorStop(0, tint[0]); g.addColorStop(1, tint[1]);
      c.fillStyle = g; rr(c, x + 2.5, y + 2.5, cw - 5, ch - 5, Math.min(cw, ch) * .20); c.fill();
      c.strokeStyle = 'rgba(255,255,255,.18)'; c.lineWidth = 1;
      rr(c, x + 5, y + 5, cw - 10, ch - 10, Math.min(cw, ch) * .17); c.stroke();
      // nhân tế bào
      if (nucleus) {
        const nr = Math.min(cw, ch) * .115;
        const nx = x + cw * .5, ny = y + ch * .5;
        c.fillStyle = 'rgba(8,44,34,.60)';
        c.beginPath(); c.arc(nx, ny, nr, 0, 6.283); c.fill();
        c.strokeStyle = 'rgba(198,255,228,.55)'; c.lineWidth = 1.1; c.stroke();
        c.fillStyle = 'rgba(198,255,228,.8)';
        c.beginPath(); c.arc(nx + nr * .28, ny - nr * .22, nr * .36, 0, 6.283); c.fill();
      }
    }
    function chloro(x, y, r) {
      const g = c.createRadialGradient(x - r * .3, y - r * .3, 0, x, y, r);
      g.addColorStop(0, '#8ff5bd'); g.addColorStop(.55, '#3ddc97'); g.addColorStop(1, '#0d6b47');
      c.fillStyle = g; c.beginPath(); c.ellipse(x, y, r, r * .60, .3, 0, 6.283); c.fill();
      c.strokeStyle = 'rgba(255,255,255,.32)'; c.lineWidth = .8; c.stroke();
      // hạt grana
      c.fillStyle = 'rgba(6,52,36,.45)';
      for (let k = 0; k < 3; k++) {
        c.beginPath(); c.ellipse(x + (k - 1) * r * .34, y + (k % 2 ? r * .10 : -r * .08), r * .11, r * .05, .3, 0, 6.283); c.fill();
      }
    }

    if (!isC4) {
      const cols = 5, rows = 2;
      const cw = w * .15, ch = (bot - top - h * .04) / rows;
      for (let i = 0; i < cols; i++) for (let j = 0; j < rows; j++) {
        const x = w * .07 + i * (cw + w * .028), y = top + j * (ch + h * .04);
        cell(x, y, cw, ch, ['#37a874', '#136044'], true);
        chloro(x + cw * .28, y + ch * .30, Math.min(cw, ch) * .19);
        chloro(x + cw * .70, y + ch * .34, Math.min(cw, ch) * .16);
        chloro(x + cw * .50, y + ch * .74, Math.min(cw, ch) * .15);
      }
      chipText(c, 'MÔ GIẬU', w * .07, top - h * .035, { size: 9.5, color: p.text, weight: 800 });
      // photorespiration arrows
      c.strokeStyle = 'rgba(251,113,133,.85)'; c.lineWidth = 2;
      c.beginPath(); c.moveTo(w * .55, h * .30); c.bezierCurveTo(w * .66, h * .18, w * .78, h * .30, w * .84, h * .42); c.stroke();
      chipText(c, 'O₂ gắn Rubisco', w * .90, h * .29, { color: '#fb7185', size: 9.5, align: 'right' });
      chipText(c, 'HÔ HẤP SÁNG', w * .90, h * .36, { color: '#fb7185', size: 9.5, align: 'right' });
      ro('type', 'C3', 'var(--accent)'); ro('rub', 'Tất cả tế bào mô giậu', p.text); ro('photo', 'Mạnh khi nóng', 'var(--bad)');
    } else {
      // mesophyll left
      for (let j = 0; j < 2; j++) {
        const x = w * .06, y = top + j * ((bot - top) / 2 + h * .02), cw = w * .22, ch = (bot - top) / 2 - h * .02;
        cell(x, y, cw, ch, ['#37a874', '#136044'], true);
        chloro(x + cw * .30, y + ch * .34, Math.min(cw, ch) * .17);
        chloro(x + cw * .70, y + ch * .38, Math.min(cw, ch) * .14);
        chloro(x + cw * .50, y + ch * .76, Math.min(cw, ch) * .13);
      }
      chipText(c, 'MÔ GIẬU', w * .06, top - h * .035, { size: 9, color: p.text, weight: 800 });
      chipText(c, 'PEP-carboxylase', w * .06, bot + h * .12, { color: '#5ee6a8', size: 9 });

      // bundle sheath ring
      const ccx = w * .66, ccy = h * .50, R = Math.min(w * .17, h * .30);
      for (let i = 0; i < 8; i++) {
        const a = i / 8 * 6.283 + .2;
        const x = ccx + Math.cos(a) * R, y = ccy + Math.sin(a) * R * .95;
        cell(x - R * .30, y - R * .22, R * .60, R * .44, ['#1e8a5e', '#0b4a33']);
        chloro(x, y, R * .13);
      }
      // vein
      c.fillStyle = '#f472b6'; c.beginPath(); c.arc(ccx, ccy, R * .34, 0, 6.283); c.fill();
      c.fillStyle = 'rgba(255,255,255,.25)'; c.beginPath(); c.arc(ccx, ccy, R * .22, 0, 6.283); c.fill();
      tx(c, 'mạch', ccx, ccy + 3, { size: 8, color: '#3b0a24', align: 'center', weight: 800 });
      tx(c, 'BAO BÓ MẠCH', ccx, ccy - R * 1.45, { size: 9.5, color: '#5ee6a8', align: 'center', weight: 800 });
      chipText(c, 'Rubisco • không PS II', ccx, ccy + R * 1.55, { color: p.sub, size: 9, align: 'center' });

      // arrow CO2
      c.strokeStyle = '#3ddc97'; c.lineWidth = 2;
      c.beginPath(); c.moveTo(w * .30, h * .44); c.lineTo(ccx - R * 1.05, h * .44); c.stroke();
      c.beginPath(); c.moveTo(ccx - R * 1.05, h * .44); c.lineTo(ccx - R * 1.12, h * .42);
      c.lineTo(ccx - R * 1.12, h * .46); c.fillStyle = '#3ddc97'; c.fill();
      chipText(c, 'C4 acid', w * .34, h * .40, { color: '#3ddc97', size: 9 });
      tx(c, 'Không hô hấp sáng', ccx, bot + h * .12, { size: 9.5, color: 'var(--ok)', align: 'center', weight: 800 });
      ro('type', 'C4', 'var(--accent2)'); ro('rub', 'Chỉ tế bào bao bó mạch', p.text); ro('photo', 'Gần như không', 'var(--ok)');
    }
    // light rays
    c.strokeStyle = 'rgba(251,191,36,.35)'; c.lineWidth = 1.2;
    for (let i = 0; i < 5; i++) {
      const x = w * (.12 + i * .17);
      c.beginPath(); c.moveTo(x, 0); c.lineTo(x - 12, top - h * .12); c.stroke();
    }
  }
},
/* ---------- 5. CATALASE ---------- */
{
  icon: 'fa-flask', name: 'Catalase của gan', short: 'Khử độc H₂O₂',
  sub: 'Đo lượng bọt O₂ khi cho gan vào H₂O₂.',
  tags: ['Enzyme', 'Gan'],
  note: 'Catalase phân giải H₂O₂ thành H₂O và O₂. Gan luộc làm <b>biến tính</b> enzyme (mất cấu trúc bậc 3) nên không còn bọt. pH 2 làm enzyme mất hoạt tính nhưng không phá hủy hoàn toàn như nhiệt độ cao.',
  v: { mode: 0, temp: 37 },
  controls: [
    { type: 'seg', k: 'mode', label: 'Mẫu gan', opts: [[0, 'Gan tươi'], [1, 'Gan luộc'], [2, 'Ngâm axit pH 2']] },
    { type: 'range', k: 'temp', label: 'Nhiệt độ', min: 0, max: 100, step: 5, unit: '°C' }
  ],
  readouts: [['rate', 'Tốc độ phản ứng'], ['foam', 'Cột bọt'], ['why', 'Nguyên nhân']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    const cx = w * .5, tw = Math.min(w * .22, h * .42), tx0 = cx - tw / 2;
    const ty = h * .12, th = h * .72;

    // bench
    c.fillStyle = 'rgba(120,170,210,.10)'; c.fillRect(0, h * .88, w, h * .12);

    // tube
    c.save();
    rr(c, tx0, ty, tw, th, tw * .18);
    c.fillStyle = 'rgba(150,200,230,.07)'; c.fill();
    c.strokeStyle = 'rgba(180,220,245,.45)'; c.lineWidth = 2; c.stroke();
    c.restore();
    // liquid
    const liqTop = ty + th * .18;
    c.save(); rr(c, tx0 + 2, liqTop, tw - 4, th - (liqTop - ty) - 2, tw * .16); c.clip();
    c.fillStyle = 'rgba(90,200,255,.28)'; c.fillRect(tx0, liqTop, tw, th);
    c.fillStyle = 'rgba(90,200,255,.16)'; c.fillRect(tx0, liqTop, tw, h * .02);
    // liver chunk
    c.fillStyle = v.mode === 1 ? '#6b3a2a' : v.mode === 2 ? '#7f5a3a' : '#c0392b';
    rr(c, cx - tw * .26, ty + th * .74, tw * .52, th * .13, 5); c.fill();
    c.fillStyle = 'rgba(255,255,255,.16)'; rr(c, cx - tw * .24, ty + th * .75, tw * .18, th * .04, 3); c.fill();

    /* Hoạt tính enzyme = (Arrhenius tăng theo nhiệt) × (phần chưa biến tính)
       × (đường cong pH chuông quanh pH 7). Gan luộc ⇒ biến tính vĩnh viễn. */
    const TK = Math.max(273, +v.temp + 273.15), TOPT = 310.15;
    const EaR = 4200;
    const arr = Math.exp(-EaR * (1 / TK - 1 / TOPT));
    const folded = 1 / (1 + Math.exp((+v.temp - 57) / 4.2));
    const pH = v.mode === 2 ? 2 : 7;
    const pHf = Math.exp(-Math.pow((pH - 7) / 1.5, 2));
    let act;
    if (v.mode === 1) act = 0;
    else act = Math.max(0, Math.min(1, arr * folded * pHf));
    const foamH = act * th * .46;
    // foam
    if (foamH > 2) {
      c.fillStyle = 'rgba(235,250,255,.55)';
      for (let i = 0; i < 26; i++) {
        const fx = tx0 + 4 + (i * 37 % (tw - 8));
        const fy = liqTop - foamH + (i * 53 % Math.max(4, foamH));
        c.beginPath(); c.arc(fx, fy, 2 + (i % 3) * 1.3, 0, 6.283); c.fill();
      }
    }
    // bubbles
    const nb = Math.round(act * 26);
    for (let i = 0; i < nb; i++) {
      const ph = (t * (1.1 + i % 4 * .3) + i * .7) % 1;
      const bx = cx + Math.sin(i * 2.1 + t) * tw * .28;
      const by = (ty + th * .76) - ph * (th * .60);
      c.strokeStyle = 'rgba(255,255,255,.6)'; c.lineWidth = 1;
      c.beginPath(); c.arc(bx, by, 1.6 + (i % 4) * .9, 0, 6.283); c.stroke();
    }
    c.restore();

    // thermometer
    const thx = w * .78, thy = h * .30;
    c.fillStyle = p.glass; rr(c, thx, thy, 10, h * .40, 5); c.fill();
    c.strokeStyle = p.line; c.lineWidth = 1; rr(c, thx, thy, 10, h * .40, 5); c.stroke();
    const lvl = (v.temp / 100) * h * .34;
    c.fillStyle = v.temp > 60 ? '#fb7185' : '#3ddc97';
    rr(c, thx + 2, thy + h * .36 - lvl, 6, lvl, 3); c.fill();
    tx(c, v.temp + '°C', thx + 5, thy + h * .46, { size: 10, color: p.text, align: 'center', mono: true });

    // labels
    tx(c, 'H₂O₂ 3%', cx, ty + th * .12, { size: 10, color: p.sub, align: 'center' });
    tx(c, ['Gan tươi', 'Gan luộc', 'Ngâm axit'][v.mode], cx, ty + th * .96, { size: 10, color: p.sub, align: 'center', weight: 700 });
    if (v.mode === 1) tx(c, 'enzyme biến tính', cx + tw * .85, ty + th * .5, { size: 9, color: 'var(--bad)', align: 'center' });

    // side gauge
    const gx = w * .12, gy = h * .22, gh = h * .48;
    c.strokeStyle = p.line; c.lineWidth = 1; rr(c, gx, gy, 8, gh, 4); c.stroke();
    c.fillStyle = act > .6 ? '#3ddc97' : act > .2 ? '#fbbf24' : '#fb7185';
    rr(c, gx + 1.5, gy + gh * (1 - act), 5, gh * act, 3); c.fill();
    tx(c, 'O₂', gx + 4, gy - 6, { size: 9, color: p.sub, align: 'center' });

    ro('rate', (act * 100).toFixed(0) + '%', act > .6 ? 'var(--ok)' : act > .2 ? 'var(--warn)' : 'var(--bad)');
    ro('foam', (foamH / th * 10).toFixed(1) + ' cm', p.text);
    ro('why', v.mode === 1 ? 'Biến tính vĩnh viễn' : v.mode === 2 ? 'pH 2 — lệch tối ưu' : v.temp > 57 ? 'Biến tính nhiệt' : v.temp < 25 ? 'Lạnh — chậm (Arrhenius)' : 'Tối ưu ~37°C, pH 7',
      v.mode === 1 || v.temp > 60 ? 'var(--bad)' : 'var(--ok)');
  }
},
/* ---------- 6. THẨM THẤU ---------- */
{
  icon: 'fa-droplet', name: 'Thẩm thấu tế bào', short: 'Co & vỡ',
  sub: 'Tế bào thực vật và hồng cầu trong ba môi trường.',
  tags: ['Thẩm thấu', 'Tế bào'],
  note: 'Nước luôn đi từ nơi có <b>thế nước cao</b> (ít chất tan) sang nơi có thế nước thấp (nhiều chất tan). Tế bào thực vật có thành cellulose nên co nguyên sinh chứ không vỡ; hồng cầu không có thành nên vỡ tan trong môi trường nhược trương.',
  v: { mode: 0 },
  controls: [{ type: 'seg', k: 'mode', label: 'Môi trường', opts: [[0, 'Ưu trương'], [1, 'Đẳng trương'], [2, 'Nhược trương']] }],
  readouts: [['plant', 'Tế bào thực vật'], ['rbc', 'Hồng cầu'], ['water', 'Dòng nước']],
  draw(c, w, h, t) {
    const p = P(), m = this.v.mode;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    // solution dots
    const dens = m === 0 ? 26 : m === 1 ? 13 : 5;
    for (let i = 0; i < dens; i++) {
      const x = (i * 137 + t * 8) % w, y = (i * 89 + Math.sin(t + i) * 10) % h;
      c.fillStyle = 'rgba(139,124,246,.30)'; c.beginPath(); c.arc(x, y, 2.2, 0, 6.283); c.fill();
    }

    // ---------- MICROSCOPE FIELDS ----------
    const dark = root.dataset.theme !== 'light';
    const FR = Math.min(w * .195, h * .325);
    const f1 = { x: w * .27, y: h * .47, r: FR };
    const f2 = { x: w * .73, y: h * .47, r: FR };
    const shrink = m === 0 ? 1 : m === 2 ? -.12 : .18;

    function fieldBase(f) {
      c.save();
      c.beginPath(); c.arc(f.x, f.y, f.r, 0, 6.283); c.clip();
      const fbg = c.createRadialGradient(f.x, f.y, f.r * .08, f.x, f.y, f.r);
      fbg.addColorStop(0, dark ? 'rgba(26,72,58,.55)' : 'rgba(240,252,246,.98)');
      fbg.addColorStop(1, dark ? 'rgba(5,14,20,.92)' : 'rgba(203,230,217,.98)');
      c.fillStyle = fbg;
      c.fillRect(f.x - f.r, f.y - f.r, f.r * 2, f.r * 2);
    }
    function fieldRing(f) {
      c.restore();
      c.strokeStyle = dark ? 'rgba(140,210,185,.45)' : 'rgba(20,90,70,.30)';
      c.lineWidth = 2.5; c.beginPath(); c.arc(f.x, f.y, f.r, 0, 6.283); c.stroke();
      c.strokeStyle = dark ? 'rgba(140,210,185,.12)' : 'rgba(20,90,70,.10)';
      c.lineWidth = 8; c.beginPath(); c.arc(f.x, f.y, f.r + 4, 0, 6.283); c.stroke();
    }

    // ---- FIELD 1 : plant tissue ----
    fieldBase(f1);
    (function plantCell(cx, cy, cw, ch, gap) {
      // cell wall
      c.fillStyle = dark ? '#10402f' : '#d5ebdf';
      rr(c, cx - cw / 2, cy - ch / 2, cw, ch, cw * .10); c.fill();
      c.strokeStyle = dark ? 'rgba(120,225,175,.55)' : '#6fb798';
      c.lineWidth = 3.2; c.stroke();
      // membrane + cytoplasm
      const gx = gap, gy = gap;
      c.fillStyle = dark ? 'rgba(40,130,96,.55)' : 'rgba(206,240,224,.95)';
      rr(c, cx - cw / 2 + gx, cy - ch / 2 + gy, cw - gx * 2, ch - gy * 2, cw * .09); c.fill();
      c.strokeStyle = dark ? 'rgba(180,255,220,.75)' : '#2f8a68';
      c.lineWidth = 1.8; c.stroke();
      // vacuole
      const vg = c.createRadialGradient(cx, cy, 2, cx, cy, Math.min(cw, ch) * .42);
      vg.addColorStop(0, dark ? 'rgba(90,200,255,.42)' : 'rgba(150,220,255,.85)');
      vg.addColorStop(1, dark ? 'rgba(20,90,110,.40)' : 'rgba(90,180,225,.7)');
      c.fillStyle = vg;
      const vw = cw * (.56 - gap / cw * .9), vh = ch * (.56 - gap / ch * .9);
      c.beginPath(); c.ellipse(cx, cy, Math.max(4, vw / 2), Math.max(4, vh / 2), 0, 0, 6.283); c.fill();
      c.strokeStyle = dark ? 'rgba(190,240,255,.55)' : 'rgba(40,120,160,.55)';
      c.lineWidth = 1.4; c.stroke();
      // nucleus
      c.fillStyle = dark ? 'rgba(251,191,36,.85)' : '#e0a92c';
      c.beginPath(); c.arc(cx - cw * .26, cy - ch * .24, Math.min(cw, ch) * .085, 0, 6.283); c.fill();
      c.fillStyle = 'rgba(0,0,0,.18)'; c.beginPath(); c.arc(cx - cw * .26, cy - ch * .24, Math.min(cw, ch) * .035, 0, 6.283); c.fill();
      // chloroplasts along wall
      for (let i = 0; i < 6; i++) {
        const a = i / 6 * 6.283 + .4;
        const rad = Math.min(cw * .43, Math.max(vw, vh) / 2 + 12);
        const rx = cx + Math.cos(a) * rad, ry = cy + Math.sin(a) * rad * .94;
        c.fillStyle = dark ? '#1f9d6b' : '#2f9d6d';
        c.beginPath(); c.ellipse(rx, ry, cw * .060, ch * .038, a, 0, 6.283); c.fill();
      }
    })(f1.x, f1.y, f1.r * 1.16, f1.r * 1.16, Math.max(0, shrink) * f1.r * .17);
    // neighbour cells hint
    c.globalAlpha = .35;
    (function (cx, cy, cw, ch) {
      c.fillStyle = dark ? '#10402f' : '#d5ebdf';
      rr(c, cx - cw / 2, cy - ch / 2, cw, ch, cw * .10); c.fill();
    })(f1.x - f1.r * .78, f1.y - f1.r * .55, f1.r * .55, f1.r * .55);
    (function (cx, cy, cw, ch) {
      c.fillStyle = dark ? '#10402f' : '#d5ebdf';
      rr(c, cx - cw / 2, cy - ch / 2, cw, ch, cw * .10); c.fill();
    })(f1.x + f1.r * .76, f1.y + f1.r * .58, f1.r * .55, f1.r * .55);
    c.globalAlpha = 1;
    fieldRing(f1);

    // ---- FIELD 2 : red blood cells ----
    fieldBase(f2);
    function rbc(x, y, r, mode) {
      if (mode === 2) {
        for (let i = 0; i < 8; i++) {
          const a = i / 8 * 6.283 + t * .15, d = r * (1.05 + (i % 3) * .30);
          c.fillStyle = 'rgba(214,60,70,.42)';
          c.beginPath(); c.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, r * .17, 0, 6.283); c.fill();
        }
        return;
      }
      const rr2 = mode === 0 ? r * .62 : r;
      const gg = c.createRadialGradient(x - rr2 * .3, y - rr2 * .32, 1, x, y, rr2 * 1.15);
      gg.addColorStop(0, '#ff9a9a'); gg.addColorStop(.55, '#e0393e'); gg.addColorStop(1, '#96181f');
      c.fillStyle = gg;
      if (mode === 0) {
        c.beginPath();
        for (let i = 0; i <= 48; i++) {
          const a = i / 48 * 6.283, rad = rr2 * (1 + Math.sin(a * 8) * .10);
          const px2 = x + Math.cos(a) * rad, py2 = y + Math.sin(a) * rad;
          i ? c.lineTo(px2, py2) : c.moveTo(px2, py2);
        }
        c.closePath(); c.fill();
      } else {
        c.beginPath(); c.ellipse(x, y, rr2, rr2 * .80, 0, 0, 6.283); c.fill();
        c.fillStyle = 'rgba(90,10,15,.22)';
        c.beginPath(); c.ellipse(x, y, rr2 * .52, rr2 * .40, 0, 0, 6.283); c.fill();
        c.fillStyle = 'rgba(255,255,255,.16)';
        c.beginPath(); c.ellipse(x - rr2 * .28, y - rr2 * .30, rr2 * .30, rr2 * .18, -.5, 0, 6.283); c.fill();
      }
    }
    rbc(f2.x, f2.y, f2.r * .42, m);
    rbc(f2.x - f2.r * .52, f2.y - f2.r * .46, f2.r * .24, m);
    rbc(f2.x + f2.r * .50, f2.y - f2.r * .30, f2.r * .21, m);
    rbc(f2.x + f2.r * .34, f2.y + f2.r * .52, f2.r * .22, m);
    rbc(f2.x - f2.r * .40, f2.y + f2.r * .55, f2.r * .18, m);
    fieldRing(f2);

    // labels
    tx(c, 'TẾ BÀO THỰC VẬT', f1.x, f1.y - f1.r - 12, { size: 9.5, color: '#5ee6a8', align: 'center', weight: 800 });
    tx(c, 'HỒNG CẦU', f2.x, f2.y - f2.r - 12, { size: 9.5, color: '#ff9a9a', align: 'center', weight: 800 });
    tx(c, m === 0 ? 'Co nguyên sinh — màng tách khỏi thành' : m === 2 ? 'Trương nước — không bị vỡ nhờ thành cellulose' : 'Bình thường — màng sát thành',
      f1.x, f1.y + f1.r + 20, { size: 9, color: p.sub, align: 'center' });
    tx(c, m === 0 ? 'Teo lại, màng nhăn (crenation)' : m === 2 ? 'Vỡ tan (tan máu)' : 'Đĩa lõm hai mặt bình thường',
      f2.x, f2.y + f2.r + 20, { size: 9, color: p.sub, align: 'center' });

    // mode banner
    tx(c, ['ƯU TRƯƠNG', 'ĐẲNG TRƯƠNG', 'NHƯỢC TRƯƠNG'][m], w * .5, h * .085,
      { size: 12, color: ['var(--warn)', 'var(--accent)', 'var(--accent2)'][m], align: 'center', weight: 800 });
    tx(c, ['Nồng độ chất tan ngoài > trong', 'Nồng độ hai bên bằng nhau', 'Nồng độ chất tan ngoài < trong'][m],
      w * .5, h * .115, { size: 8.5, color: p.sub, align: 'center' });

    // water arrows
    if (m !== 1) {
      const out = m === 0;
      for (let i = 0; i < 5; i++) {
        const ang = -1.2 + i * .55;
        const ax = f1.x + Math.cos(ang) * (f1.r + 26), ay = f1.y + Math.sin(ang) * (f1.r + 26);
        const dir = out ? 1 : -1;
        c.strokeStyle = 'rgba(90,200,255,.55)'; c.lineWidth = 1.6;
        c.beginPath(); c.moveTo(ax, ay); c.lineTo(ax + Math.cos(ang) * 14 * dir, ay + Math.sin(ang) * 14 * dir); c.stroke();
      }
    }

    ro('plant', m === 0 ? 'Co nguyên sinh' : m === 2 ? 'Căng nước' : 'Ổn định', m === 0 ? 'var(--warn)' : 'var(--ok)');
    ro('rbc', m === 0 ? 'Teo (crenation)' : m === 2 ? 'Vỡ (tan máu)' : 'Bình thường', m === 0 ? 'var(--warn)' : m === 2 ? 'var(--bad)' : 'var(--ok)');
    ro('water', m === 0 ? 'Nước ra ngoài' : m === 2 ? 'Nước vào trong' : 'Cân bằng', p.text);
  }
},
/* ---------- 7. GLUCOSE ---------- */
{
  icon: 'fa-heart-pulse', name: 'Điều hòa glucose', short: 'Gan & tuyến tụy',
  sub: 'Insulin và glucagon tác động lên kho glycogen của gan.',
  tags: ['Nội tiết', 'Gan'],
  note: 'Gan giữ đường huyết ổn định nhờ hai “cửa”: insulin mở cửa <b>cất</b> (glucose → glycogen), glucagon mở cửa <b>lấy</b> (glycogen → glucose). Mất cân bằng này là cơ chế của đái tháo đường.',
  v: { mode: 0 },
  controls: [{ type: 'seg', k: 'mode', label: 'Hoocmon', opts: [[0, 'Bình thường'], [1, 'Insulin'], [2, 'Glucagon']] }],
  readouts: [['glu', 'Glucose máu'], ['gly', 'Glycogen gan'], ['flow', 'Chiều vận chuyển']],
  draw(c, w, h, t) {
    const p = P(), m = this.v.mode;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    // vessel
    const vy = h * .62, vh = h * .22;
    c.fillStyle = 'rgba(251,113,133,.10)'; rr(c, 0, vy, w, vh, 0); c.fill();
    c.strokeStyle = 'rgba(251,113,133,.35)'; c.lineWidth = 1.5;
    c.beginPath(); c.moveTo(0, vy); c.lineTo(w, vy); c.moveTo(0, vy + vh); c.lineTo(w, vy + vh); c.stroke();

    // liver
    const lx = w * .5, ly = h * .30, lr = Math.min(w * .13, h * .20);
    const g = c.createRadialGradient(lx - lr * .3, ly - lr * .3, 2, lx, ly, lr);
    g.addColorStop(0, '#a0522d'); g.addColorStop(1, '#6b2f14');
    c.fillStyle = g;
    c.beginPath();
    for (let i = 0; i <= 6; i++) { const a = i / 6 * 6.283 + .5; const x = lx + Math.cos(a) * lr, y = ly + Math.sin(a) * lr * .82; i ? c.lineTo(x, y) : c.moveTo(x, y); }
    c.closePath(); c.fill();
    c.strokeStyle = 'rgba(255,200,150,.35)'; c.lineWidth = 1.5; c.stroke();
    tx(c, 'GAN', lx, ly + 4, { size: 10, color: '#ffe6d5', align: 'center', weight: 800 });

    // glycogen granules
    const level = m === 1 ? .85 : m === 2 ? .15 : .55;
    for (let i = 0; i < 14; i++) {
      if (i / 14 > level) continue;
      const a = i * 2.4, r = lr * .55 * Math.sqrt((i % 7) / 7);
      c.fillStyle = 'rgba(251,191,36,.85)';
      c.beginPath(); c.arc(lx + Math.cos(a) * r, ly + Math.sin(a) * r * .7, 2.6, 0, 6.283); c.fill();
    }

    // pancreas + hormone
    const px = w * .14, py = h * .24;
    c.fillStyle = 'rgba(139,124,246,.7)'; c.beginPath(); c.ellipse(px, py, w * .05, h * .06, .3, 0, 6.283); c.fill();
    tx(c, 'tụy', px, py + h * .10, { size: 9, color: p.sub, align: 'center' });
    if (m !== 0) {
      const col = m === 1 ? '#3ddc97' : '#fbbf24';
      for (let i = 0; i < 3; i++) {
        const ph = ((t * .35 + i * .33) % 1);
        const hx = px + (lx - px) * ph, hy = py + (ly - py) * ph + Math.sin(ph * 6) * 8;
        glow(c, hx, hy, 10, col + '88');
        c.fillStyle = col; c.beginPath(); c.arc(hx, hy, 3.4, 0, 6.283); c.fill();
      }
      tx(c, m === 1 ? 'INSULIN' : 'GLUCAGON', px + w * .08, py - h * .04, { size: 9.5, color: col, weight: 800 });
    }

    // glucose dots in vessel
    const n = m === 1 ? 8 : m === 2 ? 26 : 15;
    for (let i = 0; i < n; i++) {
      const x = ((i * 71 + t * (m === 1 ? 26 : m === 2 ? 46 : 30)) % (w + 40)) - 20;
      const y = vy + vh * .3 + Math.sin(i + t) * vh * .16;
      c.fillStyle = '#5ac8fa'; c.beginPath(); c.arc(x, y, 3.2, 0, 6.283); c.fill();
      glow(c, x, y, 7, 'rgba(90,200,255,.4)');
    }
    // arrows
    if (m !== 0) {
      const up = m === 1;
      const ax = lx + (up ? -1 : 1) * lr * 1.25;
      c.strokeStyle = up ? '#3ddc97' : '#fbbf24'; c.lineWidth = 2.4;
      c.beginPath(); c.moveTo(ax, vy + (up ? -6 : 6)); c.lineTo(ax, ly + (up ? lr * .9 : -lr * .9)); c.stroke();
      c.beginPath();
      const ey = ly + (up ? lr * .9 : -lr * .9), dir = up ? -1 : 1;
      c.moveTo(ax, ey); c.lineTo(ax - 5, ey + 8 * dir); c.lineTo(ax + 5, ey + 8 * dir); c.closePath();
      c.fillStyle = up ? '#3ddc97' : '#fbbf24'; c.fill();
      tx(c, up ? 'cất vào kho' : 'lấy ra máu', ax, vy + (up ? 16 : -16), { size: 8.5, color: p.sub, align: 'center' });
    }

    tx(c, 'MẠCH MÁU', 10, vy - 6, { size: 8.5, color: p.sub, weight: 700 });
    /* Điều hoà ngược âm: lệch khỏi điểm đặt 1,0 g/L kích hoạt hormone đối kháng,
       đáp ứng bão hoà (Hill) nên đường huyết không thể tăng/giảm vô hạn. */
    const drive = m === 1 ? -1 : m === 2 ? 1 : 0;
    const glu = 1.0 + drive * 0.62 * (1 - Math.exp(-1));
    ro('glu', glu.toFixed(2) + ' g/L', glu > 1.2 ? 'var(--bad)' : 'var(--ok)');
    ro('gly', Math.round(level * 100) + '%', p.text);
    ro('flow', m === 1 ? 'Máu → gan' : m === 2 ? 'Gan → máu' : 'Cân bằng', m === 0 ? 'var(--ok)' : 'var(--accent2)');
  }
},
/* ---------- 8. KHÍ KHỔNG ---------- */
{
  icon: 'fa-wind', name: 'Khí khổng', short: 'Đóng / mở',
  sub: 'Tế bào hạt đậu, K⁺, nước và ABA.',
  tags: ['Thực vật', 'Thoát hơi nước'],
  note: 'Khí khổng mở khi K⁺ vào tế bào hạt đậu → nước vào → tế bào trương và cong ra. ABA (khi hạn) làm K⁺ ra ngoài → mất nước → khí khổng đóng để cứu cây khỏi mất nước.',
  v: { light: 70, aba: 0, co2: 400 },
  controls: [
    { type: 'range', k: 'light', label: 'Ánh sáng', min: 0, max: 100, step: 5, unit: '%' },
    { type: 'range', k: 'aba', label: 'ABA (hạn hán)', min: 0, max: 100, step: 5, unit: '%' },
    { type: 'range', k: 'co2', label: 'CO₂ trong lá', min: 200, max: 1200, step: 50, unit: ' ppm' }
  ],
  readouts: [['open', 'Độ mở khí khổng'], ['trans', 'Thoát hơi nước'], ['photo', 'Quang hợp']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    const openness = stomataOpenness(v);
    const gap = h * (.02 + openness * .16);

    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    // epidermis cells
    for (let i = 0; i < 7; i++) {
      c.fillStyle = 'rgba(120,200,150,.08)';
      rr(c, w * .02 + i * w * .14, h * .04, w * .12, h * .92, 14); c.fill();
      c.strokeStyle = 'rgba(120,200,150,.18)'; c.lineWidth = 1; c.stroke();
    }
    const cx = w * .5, cy = h * .5;
    const gw = Math.min(w * .34, h * .52), gh = h * .40;

    function guard(sign) {
      c.save();
      c.translate(cx, cy);
      c.beginPath();
      // kidney shape
      const outer = gw * .5, inner = gap;
      c.moveTo(sign * inner, -gh * .5);
      c.bezierCurveTo(sign * outer * .9, -gh * .55, sign * outer * 1.05, gh * .2, sign * inner * 1.15, gh * .5);
      c.bezierCurveTo(sign * inner * .55, gh * .30, sign * inner * .55, -gh * .30, sign * inner, -gh * .5);
      c.closePath();
      const g = c.createLinearGradient(-outer, 0, outer, 0);
      g.addColorStop(0, '#0e6b4a'); g.addColorStop(.5, '#2fbf85'); g.addColorStop(1, '#0e6b4a');
      c.fillStyle = g; c.fill();
      c.strokeStyle = 'rgba(180,255,215,.55)'; c.lineWidth = 1.6; c.stroke();
      // chloroplasts
      for (let i = 0; i < 6; i++) {
        const a = -1.2 + i * .45;
        c.fillStyle = 'rgba(20,140,90,.85)';
        c.beginPath();
        c.ellipse(sign * (inner + outer) * .55 + Math.cos(a) * 4, Math.sin(a) * gh * .34, gw * .045, gh * .05, a, 0, 6.283);
        c.fill();
      }
      c.restore();
    }
    guard(1); guard(-1);

    // pore
    c.fillStyle = p.bg;
    c.beginPath(); c.ellipse(cx, cy, Math.max(2, gap), gh * .48, 0, 0, 6.283); c.fill();

    // water/ion particles inside guard cells
    for (let i = 0; i < 14; i++) {
      const side = i % 2 ? 1 : -1;
      const px2 = cx + side * (gap + gw * .12) + Math.sin(t * 2 + i) * 6;
      const py2 = cy - gh * .3 + (i * 37 % (gh * .6));
      c.fillStyle = openness > .4 ? 'rgba(90,200,255,.75)' : 'rgba(251,191,36,.7)';
      c.beginPath(); c.arc(px2, py2, 2, 0, 6.283); c.fill();
    }
    // transpiration arrows
    if (openness > .15) {
      for (let i = 0; i < 3; i++) {
        const ax = cx + (i - 1) * gap * .5, off = (t * 60) % 40;
        c.strokeStyle = 'rgba(90,200,255,.55)'; c.lineWidth = 1.4;
        c.beginPath(); c.moveTo(ax, cy - gh * .55 - off); c.lineTo(ax, cy - gh * .62 - off); c.stroke();
      }
    }
    tx(c, 'TẾ BÀO HẠT ĐẬU', cx, h * .10, { size: 9.5, color: p.sub, align: 'center', weight: 700 });
    tx(c, openness > .5 ? 'MỞ' : openness > .15 ? 'HÉ' : 'ĐÓNG', cx, h * .90,
      { size: 12, color: openness > .5 ? 'var(--accent)' : openness > .15 ? 'var(--warn)' : 'var(--bad)', align: 'center', weight: 800 });
    // ABA indicator
    if (v.aba > 20) {
      tx(c, 'ABA ↑ → K⁺ ra ngoài → mất nước', cx, h * .97, { size: 9, color: 'var(--bad)', align: 'center' });
    }

    const trans = Math.round(100 * (0.06 + 0.94 * Math.pow(openness, 1.35)));
    ro('open', Math.round(openness * 100) + '%', openness > .5 ? 'var(--ok)' : 'var(--warn)');
    ro('trans', trans + '%', p.text);
    ro('photo', openness > .4 ? 'Đang diễn ra' : 'Bị hạn chế', openness > .4 ? 'var(--ok)' : 'var(--bad)');
  }
},
/* ---------- 9. HÔ HẤP / LÊN MEN ---------- */
{
  icon: 'fa-fire-flame-curved', name: 'Hô hấp & lên men', short: 'Năng lượng ATP',
  sub: 'Một phân tử glucose đi qua hai con đường.',
  tags: ['Hô hấp', 'Năng lượng'],
  note: 'Hiếu khí: glucose → pyruvate → ti thể → CO₂ + H₂O + khoảng 30–32 ATP (một số tài liệu cũ ghi ~38). Kỵ khí: pyruvate → ethanol + CO₂ + 2 ATP. Thiếu O₂, tế bào buộc dùng con đường “lãi ít” nhưng nhanh.',
  v: { o2: 100 },
  controls: [{ type: 'range', k: 'o2', label: 'Nồng độ O₂', min: 0, max: 100, step: 5, unit: '%' }],
  readouts: [['atp', 'ATP thu được'], ['prod', 'Sản phẩm'], ['path', 'Con đường']],
  draw(c, w, h, t) {
    const p = P(), v = this.v, aerobic = v.o2 >= 30;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    // glucose
    const gx = w * .12, gy = h * .38, gr = h * .085;
    c.strokeStyle = '#5ac8fa'; c.lineWidth = 2.5;
    c.beginPath();
    for (let i = 0; i <= 6; i++) { const a = i / 6 * 6.283 - 1.57; const x = gx + Math.cos(a) * gr, y = gy + Math.sin(a) * gr; i ? c.lineTo(x, y) : c.moveTo(x, y); }
    c.closePath(); c.stroke();
    c.fillStyle = 'rgba(90,200,255,.15)'; c.fill();
    tx(c, 'Glucose', gx, gy + gr + 16, { size: 9.5, color: '#5ac8fa', align: 'center', weight: 700 });
    tx(c, 'C₆H₁₂O₆', gx, gy + 4, { size: 9, color: p.text, align: 'center', mono: true });

    // arrow 1
    c.strokeStyle = p.sub; c.lineWidth = 1.6;
    c.beginPath(); c.moveTo(gx + gr + 8, gy); c.lineTo(w * .27, gy); c.stroke();
    tx(c, 'glycolysis', (gx + gr + w * .27) / 2, gy - 8, { size: 8.5, color: p.sub, align: 'center' });

    // mitochondrion
    const mx = w * .45, my = h * .46, mw = w * .28, mh = h * .28;
    const mg = c.createLinearGradient(mx - mw / 2, my, mx + mw / 2, my);
    mg.addColorStop(0, 'rgba(139,124,246,.35)'); mg.addColorStop(1, 'rgba(139,124,246,.18)');
    c.fillStyle = mg; c.beginPath(); c.ellipse(mx, my, mw / 2, mh / 2, 0, 0, 6.283); c.fill();
    c.strokeStyle = '#a99cf9'; c.lineWidth = 2; c.stroke();
    // cristae
    c.strokeStyle = 'rgba(200,190,255,.65)'; c.lineWidth = 1.6;
    for (let i = -3; i <= 3; i++) {
      c.beginPath();
      c.moveTo(mx + i * mw * .10, my - mh * .36);
      c.quadraticCurveTo(mx + i * mw * .10 + mw * .05, my, mx + i * mw * .10, my + mh * .36);
      c.stroke();
    }
    tx(c, 'TI THỂ', mx, my + mh / 2 + 16, { size: 9.5, color: '#a99cf9', align: 'center', weight: 800 });
    tx(c, 'chuỗi e⁻', mx, my + 3, { size: 8, color: 'rgba(230,225,255,.8)', align: 'center' });

    // ATP output
    const ax = w * .78;
    for (let i = 0; i < (aerobic ? 10 : 3); i++) {
      const ph = (t * .5 + i * .1) % 1;
      const px = mx + mw * .45 + (ax - mx - mw * .45) * ph;
      const py = my + Math.sin(ph * 8 + i) * h * .05;
      glow(c, px, py, 9, 'rgba(251,191,36,.45)');
      c.fillStyle = '#fbbf24'; c.beginPath(); c.arc(px, py, 2.6, 0, 6.283); c.fill();
    }
    tx(c, aerobic ? '~30–32 ATP' : '2 ATP', ax, h * .30, { size: 13, color: 'var(--warn)', align: 'center', weight: 800 });
    tx(c, 'năng lượng', ax, h * .35, { size: 8.5, color: p.sub, align: 'center' });

    // products
    if (aerobic) {
      c.fillStyle = 'rgba(61,220,151,.18)'; rr(c, w * .62, h * .62, w * .30, h * .16, 10); c.fill();
      tx(c, '6 CO₂ + 6 H₂O', w * .77, h * .71, { size: 11, color: 'var(--accent)', align: 'center', weight: 800, mono: true });
      tx(c, 'hiếu khí • ti thể', w * .77, h * .82, { size: 9, color: p.sub, align: 'center' });
    } else {
      // fermentation flask
      const fx = w * .74, fy = h * .72, fw = w * .13, fh = h * .18;
      c.strokeStyle = 'rgba(180,220,245,.5)'; c.lineWidth = 1.8;
      rr(c, fx - fw / 2, fy - fh / 2, fw, fh, 6); c.stroke();
      c.fillStyle = 'rgba(251,191,36,.22)'; c.fillRect(fx - fw / 2 + 1, fy - fh * .1, fw - 2, fh * .6);
      for (let i = 0; i < 7; i++) {
        const ph = (t * .9 + i * .16) % 1;
        c.strokeStyle = 'rgba(255,255,255,.55)'; c.lineWidth = 1;
        c.beginPath(); c.arc(fx + Math.sin(i * 2 + t) * fw * .25, fy + fh * .35 - ph * fh * .5, 2 + i % 3, 0, 6.283); c.stroke();
      }
      tx(c, '2 ethanol + 2 CO₂', w * .77, h * .90, { size: 10, color: 'var(--warn)', align: 'center', weight: 800 });
      tx(c, 'lên men • tế bào chất', w * .77, h * .95, { size: 9, color: p.sub, align: 'center' });
    }
    // O2 meter
    c.strokeStyle = p.line; rr(c, w * .03, h * .78, w * .28, 6, 3); c.stroke();
    c.fillStyle = aerobic ? '#3ddc97' : '#fb7185';
    rr(c, w * .03, h * .78, w * .28 * (v.o2 / 100), 6, 3); c.fill();
    tx(c, 'O₂ ' + v.o2 + '%', w * .03, h * .76, { size: 8.5, color: p.sub, mono: true });

    ro('atp', aerobic ? '30–32 ATP' : '2 ATP', aerobic ? 'var(--ok)' : 'var(--warn)');
    ro('prod', aerobic ? 'CO₂ + H₂O' : 'Ethanol + CO₂', p.text);
    ro('path', aerobic ? 'Hô hấp hiếu khí' : 'Lên men', aerobic ? 'var(--accent)' : 'var(--warn)');
  }
},
/* ---------- 10. QUANG HỢP THEO ÁNH SÁNG ---------- */
{
  icon: 'fa-chart-line', name: 'Quang hợp theo ánh sáng', short: 'Điểm bù & bão hòa',
  sub: 'Tìm điểm bù và điểm bão hòa ánh sáng.',
  tags: ['Quang hợp', 'Đồ thị'],
  note: 'Điểm bù: quang hợp = hô hấp, trao đổi khí ròng bằng 0. Điểm bão hòa: tăng ánh sáng không làm tăng quang hợp nữa vì Rubisco và CO₂ đã đạt giới hạn. Tăng CO₂ sẽ nâng điểm bão hòa lên.',
  v: { light: 40, co2: 400 },
  controls: [
    { type: 'range', k: 'light', label: 'Cường độ ánh sáng', min: 0, max: 100, step: 1, unit: '%' },
    { type: 'range', k: 'co2', label: 'Nồng độ CO₂', min: 200, max: 1200, step: 50, unit: ' ppm' }
  ],
  readouts: [['net', 'Quang hợp ròng'], ['point', 'Vị trí'], ['lim', 'Giới hạn']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    const L = w * .10, R = w * .95, T = h * .12, B = h * .82;
    /* Hai cơ chất độc lập: CO₂ theo Michaelis–Menten (Km ≈ 300 ppm),
       ánh sáng theo đường cong bão hoà. CO₂ tăng nâng CẢ Vmax LẪN điểm bão hoà. */
    const co2Gain = (v.co2 / (v.co2 + 300)) / (400 / 700);
    const Amax = 22 * co2Gain;
    const tau = 30 * co2Gain;
    const sat = Math.min(98, tau * 2.3);
    const rate = L0 => Amax * (1 - Math.exp(-L0 / tau)) - 4.5;
    const yOf = r => B - (r + 6) / 40 * (B - T);

    // grid
    c.strokeStyle = p.line; c.lineWidth = 1;
    for (let i = 0; i <= 8; i++) { const y = T + (B - T) * i / 8; c.beginPath(); c.moveTo(L, y); c.lineTo(R, y); c.stroke(); }
    for (let i = 0; i <= 10; i++) { const x = L + (R - L) * i / 10; c.beginPath(); c.moveTo(x, T); c.lineTo(x, B); c.stroke(); }
    // zero line
    c.strokeStyle = 'rgba(255,255,255,.22)'; c.setLineDash([4, 4]);
    c.beginPath(); c.moveTo(L, yOf(0)); c.lineTo(R, yOf(0)); c.stroke(); c.setLineDash([]);
    tx(c, '0', L - 6, yOf(0) + 3, { size: 8.5, color: p.sub, align: 'right', mono: true });
    chipText(c, 'cường độ ánh sáng →', R, B + 18, { color: p.sub, size: 9, align: 'right' });
    chipText(c, 'O₂ thải ra', L + 4, T - 6, { color: p.sub, size: 9 });
    tx(c, 'hô hấp', L - 6, B + 2, { size: 8.5, color: 'var(--bad)', align: 'right' });

    // curve
    const pts = [];
    for (let x = 0; x <= 100; x += 1) pts.push([L + (R - L) * x / 100, yOf(rate(x))]);
    c.beginPath(); c.moveTo(pts[0][0], pts[0][1]); pts.forEach(q => c.lineTo(q[0], q[1]));
    c.strokeStyle = '#3ddc97'; c.lineWidth = 2.6; c.shadowColor = '#3ddc97'; c.shadowBlur = 10; c.stroke(); c.shadowBlur = 0;
    // area
    c.beginPath(); c.moveTo(pts[0][0], yOf(0));
    pts.forEach(q => c.lineTo(q[0], q[1])); c.lineTo(R, yOf(0)); c.closePath();
    const ag = c.createLinearGradient(0, T, 0, B); ag.addColorStop(0, 'rgba(61,220,151,.20)'); ag.addColorStop(1, 'rgba(61,220,151,0)');
    c.fillStyle = ag; c.fill();

    // compensation point
    let comp = 0;
    for (let x = 0; x <= 100; x += .5) if (rate(x) >= 0) { comp = x; break; }
    const cxp = L + (R - L) * comp / 100;
    c.strokeStyle = 'rgba(251,191,36,.7)'; c.setLineDash([3, 4]);
    c.beginPath(); c.moveTo(cxp, yOf(0)); c.lineTo(cxp, B); c.stroke(); c.setLineDash([]);
    c.fillStyle = '#fbbf24'; c.beginPath(); c.arc(cxp, yOf(0), 3.6, 0, 6.283); c.fill();
    chipText(c, 'điểm bù', cxp + 8, yOf(0) - 12, { color: 'var(--warn)', size: 9 });

    // saturation
    const sxp = L + (R - L) * sat / 100;
    if (sat < 98) {
      c.strokeStyle = 'rgba(56,189,248,.55)'; c.setLineDash([3, 4]);
      c.beginPath(); c.moveTo(sxp, T); c.lineTo(sxp, B); c.stroke(); c.setLineDash([]);
      chipText(c, 'điểm bão hòa', sxp + 8, T + 16, { color: 'var(--accent2)', size: 9 });
    }
    // current point
    const nx = L + (R - L) * v.light / 100, ny = yOf(rate(v.light));
    c.strokeStyle = 'rgba(255,255,255,.25)'; c.lineWidth = 1;
    c.beginPath(); c.moveTo(nx, ny); c.lineTo(nx, B); c.moveTo(nx, ny); c.lineTo(L, ny); c.stroke();
    glow(c, nx, ny, 16, 'rgba(61,220,151,.5)');
    c.fillStyle = '#fff'; c.beginPath(); c.arc(nx, ny, 4.2, 0, 6.283); c.fill();
    c.strokeStyle = '#3ddc97'; c.lineWidth = 2; c.stroke();

    // legend dot
    c.fillStyle = 'rgba(61,220,151,.9)'; c.beginPath(); c.arc(L + 6, B + 12, 3, 0, 6.283); c.fill();

    const net = rate(v.light);
    ro('net', net.toFixed(1), net > 0 ? 'var(--ok)' : 'var(--bad)');
    ro('point', v.light < comp ? 'Dưới điểm bù' : v.light > sat ? 'Đã bão hòa' : 'Tăng theo ánh sáng',
      v.light < comp ? 'var(--bad)' : v.light > sat ? 'var(--accent2)' : 'var(--ok)');
    ro('lim', v.light > sat ? 'CO₂ / enzyme' : 'Ánh sáng', p.text);
  }
},

/* ---------- 11. NGUYÊN PHÂN ---------- */
{
  icon: 'fa-circle-nodes', name: 'Nguyên phân', short: 'Phân bào nguyên nhiễm',
  sub: 'Một tế bào 2n = 4 tạo ra hai tế bào giống hệt nó như thế nào?',
  tags: ['NST', 'Phân bào'],
  note: 'Bốn kỳ: <b>đầu – giữa – sau – cuối</b>. NST đã nhân đôi từ kỳ trung gian nên ở kỳ giữa mỗi NST gồm 2 chromatid dính ở tâm động. Kỳ sau chúng <b>tách nhau</b>, mỗi cực nhận đúng 2n NST đơn ⇒ hai tế bào con giống hệt mẹ.',
  v: { ph: 0, auto: 1 },
  controls: [
    { type: 'seg', k: 'auto', label: 'Chế độ xem', opts: [[1, 'Tự chạy'], [0, 'Kéo tay']] },
    { type: 'seg', k: 'ph', label: 'Chọn kỳ', opts: [[0, 'Kỳ đầu'], [1, 'Kỳ giữa'], [2, 'Kỳ sau'], [3, 'Kỳ cuối']] }
  ],
  readouts: [['k', 'Kỳ'], ['nst', 'NST'], ['dna', 'DNA'], ['tt', 'Đặc điểm']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    let ph = v.ph, pr = .5;
    if (v.auto) { const cy = (t * .30) % 4; ph = Math.floor(cy); pr = cy - ph; }
    const cx = w * .5, cy = h * .52, rx = w * .34, ry = h * .37;

    // ---- tế bào
    glow(c, cx, cy, rx * .95, 'rgba(56,189,248,.06)');
    c.beginPath(); c.ellipse(cx, cy, rx, ry, 0, 0, 6.283);
    c.fillStyle = p.glass; c.fill();
    c.strokeStyle = 'rgba(61,220,151,.48)'; c.lineWidth = 2.2; c.stroke();
    // eo thắt ở kỳ cuối
    if (ph === 3 && pr > .15) {
      const k = pr * rx * .30;
      c.fillStyle = p.bg;
      c.beginPath(); c.moveTo(cx, cy - ry); c.quadraticCurveTo(cx + k * 1.6, cy, cx, cy + ry);
      c.quadraticCurveTo(cx - k * 1.6, cy, cx, cy - ry); c.fill();
    }

    // ---- thoi phân bào + sao trung thể
    const pl = { x: cx - rx * .86, y: cy }, prr = { x: cx + rx * .86, y: cy };
    const spA = ph === 0 ? .3 + pr * .6 : ph === 3 ? 1 - pr * .8 : 1;
    if (spA > .05) {
      c.save(); c.globalAlpha = spA;
      c.strokeStyle = 'rgba(139,124,246,.28)'; c.lineWidth = .9;
      for (let i = -2; i <= 2; i++) {
        c.beginPath(); c.moveTo(pl.x, pl.y);
        c.quadraticCurveTo(cx, cy + i * ry * .16, prr.x, prr.y); c.stroke();
      }
      [pl, prr].forEach(pt => {
        glow(c, pt.x, pt.y, 15, 'rgba(139,124,246,.5)');
        c.fillStyle = '#a99cf9'; c.beginPath(); c.arc(pt.x, pt.y, 3.2, 0, 6.283); c.fill();
        c.strokeStyle = 'rgba(169,156,249,.65)'; c.lineWidth = 1;
        for (let k = 0; k < 9; k++) {
          const a = k / 9 * 6.283;
          c.beginPath(); c.moveTo(pt.x, pt.y); c.lineTo(pt.x + Math.cos(a) * 8, pt.y + Math.sin(a) * 8); c.stroke();
        }
      });
      c.restore();
    }

    // ---- màng nhân
    const nA = ph === 0 ? 1 - pr * .95 : ph === 3 ? Math.max(0, pr - .2) * 1.3 : 0;
    if (nA > .02) {
      c.save(); c.globalAlpha = Math.min(1, nA);
      c.strokeStyle = 'rgba(120,200,255,.55)'; c.lineWidth = 1.5; c.setLineDash([5, 5]);
      if (ph === 3) {
        c.beginPath(); c.ellipse(cx - rx * .40, cy, rx * .26, ry * .40, 0, 0, 6.283); c.stroke();
        c.beginPath(); c.ellipse(cx + rx * .40, cy, rx * .26, ry * .40, 0, 0, 6.283); c.stroke();
      } else {
        c.beginPath(); c.ellipse(cx, cy, rx * .58, ry * .64, 0, 0, 6.283); c.stroke();
      }
      c.setLineDash([]); c.restore();
    }

    // ---- chromatid
    function chromatid(x, y, ang, len, colr, bow) {
      c.save(); c.translate(x, y); c.rotate(ang);
      c.strokeStyle = colr; c.lineWidth = 6.2; c.lineCap = 'round';
      c.beginPath(); c.moveTo(-len / 2, 0); c.quadraticCurveTo(0, bow, len / 2, 0); c.stroke();
      c.strokeStyle = 'rgba(255,255,255,.30)'; c.lineWidth = 1.5;
      c.beginPath(); c.moveTo(-len / 2, 0); c.quadraticCurveTo(0, bow, len / 2, 0); c.stroke();
      c.restore();
    }
    const COL = ['#3ddc97', '#38bdf8'];
    const LEN = [w * .102, w * .078];
    // tách chromatid ở kỳ sau
    const sep = ph === 2 ? pr * rx * .34 : ph === 3 ? rx * .34 : 0;
    const squeeze = ph === 3 ? .55 : 1;

    for (let i = 0; i < 2; i++) {
      const yBase = cy + (i - .5) * ry * .30 * squeeze;
      if (ph <= 1) {
        // X: hai chromatid dính tâm động
        const xOff = ph === 0 ? (i - .5) * rx * .26 : (i - .5) * rx * .34;
        const yOff = ph === 0 ? (i - .5) * ry * .18 : 0;
        const px2 = cx + xOff, py2 = cy + yOff;
        chromatid(px2, py2, Math.PI / 2 + .22, LEN[i], COL[i], LEN[i] * .34);
        chromatid(px2, py2, Math.PI / 2 - .22, LEN[i], COL[i], -LEN[i] * .34);
        c.fillStyle = '#e7eefa'; c.beginPath(); c.arc(px2, py2, 2.6, 0, 6.283); c.fill();
      } else {
        // V: chromatid đã tách, đi về 2 cực
        const dirL = -1, dirR = 1;
        chromatid(cx + dirL * (w * .06 + sep), yBase, Math.PI / 2 + .55, LEN[i] * .82, COL[i], LEN[i] * .20);
        chromatid(cx + dirR * (w * .06 + sep), yBase, Math.PI / 2 - .55, LEN[i] * .82, COL[i], -LEN[i] * .20);
      }
    }

    // ---- chú thích
    chipText(c, ['Kỳ đầu', 'Kỳ giữa', 'Kỳ sau', 'Kỳ cuối'][ph], w * .5, h * .085, { color: 'var(--accent)', size: 10, align: 'center', weight: 800 });
    if (ph === 1) chipText(c, 'NST xếp 1 hàng ở mặt phẳng xích đạo', w * .5, h * .93, { color: p.sub, size: 8.5, align: 'center' });
    if (ph === 2) chipText(c, 'chromatid tách → mỗi cực 2n NST đơn', w * .5, h * .93, { color: 'var(--warn)', size: 8.5, align: 'center' });
    if (ph === 3) chipText(c, '2 tế bào con: 2n = 4, giống hệt mẹ', w * .5, h * .93, { color: 'var(--ok)', size: 8.5, align: 'center' });

    ro('k', ['Kỳ đầu', 'Kỳ giữa', 'Kỳ sau', 'Kỳ cuối'][ph], 'var(--accent)');
    ro('nst', ph <= 1 ? '4 kép (8 chromatid)' : ph === 2 ? '8 đơn (đang tách)' : '2 × 4 đơn', p.text);
    ro('dna', ph <= 1 ? '8 phân tử' : '8 → chia đôi', p.text);
    ro('tt', ['NST co xoắn, màng nhân tan', 'Xếp hàng ở xích đạo', 'Chromatid tách về 2 cực', 'Tái tạo nhân, tách tế bào'][ph], p.text);
  }
},

/* ---------- 12. GIẢM PHÂN & HOÁN VỊ ---------- */
{
  icon: 'fa-shuffle', name: 'Giảm phân & hoán vị', short: '4 giao tử khác nhau',
  sub: 'Vì sao một tế bào mẹ chỉ cho ra 4 giao tử nhưng lại tạo được nhiều tổ hợp?',
  tags: ['NST', 'Hoán vị gene'],
  note: 'Giảm phân có <b>hai lần phân bào liên tiếp nhưng chỉ một lần nhân đôi DNA</b> ⇒ 2n → n. Hoán vị ở kỳ đầu I đổi đoạn giữa 2 chromatid khác nguồn, tạo <b>giao tử tái tổ hợp</b> — nguồn biến dị tổ hợp quan trọng nhất.',
  v: { xo: 0, ph: 1, auto: 1 },
  controls: [
    { type: 'seg', k: 'auto', label: 'Chế độ xem', opts: [[1, 'Tự chạy'], [0, 'Kéo tay']] },
    { type: 'seg', k: 'xo', label: 'Hoán vị gene', opts: [[0, 'Không hoán vị'], [1, 'Có hoán vị']] },
    { type: 'seg', k: 'ph', label: 'Giai đoạn', opts: [[0, 'Kỳ đầu I'], [1, 'Kỳ giữa I'], [2, 'Kỳ sau I'], [3, 'Kết thúc']] }
  ],
  readouts: [['gt', 'Số giao tử'], ['loai', 'Loại giao tử'], ['nst', 'Bộ NST'], ['bd', 'Biến dị']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    let ph = v.ph, pr = .5;
    if (v.auto) { const cy = (t * .26) % 4; ph = Math.floor(cy); pr = cy - ph; }
    const xo = v.xo === 1;
    const cx = w * .5, cy = h * .50;

    // ---- tế bào mẹ
    if (ph < 3) {
      const rx = w * .30, ry = h * .33;
      glow(c, cx, cy, rx, 'rgba(139,124,246,.08)');
      c.beginPath(); c.ellipse(cx, cy, rx, ry, 0, 0, 6.283);
      c.fillStyle = p.glass; c.fill();
      c.strokeStyle = 'rgba(169,156,249,.5)'; c.lineWidth = 2; c.stroke();

      // 2 cặp NST tương đồng (mỗi cái 2 chromatid)
      const pairs = [
        { x: cx - rx * .38, col: '#3ddc97', mate: '#2bb37c', len: w * .105 },
        { x: cx + rx * .38, col: '#38bdf8', mate: '#2b8fc4', len: w * .082 }
      ];
      pairs.forEach((pp, i) => {
        const y = cy + (i - .5) * ry * .34;
        // cặp tương đồng: 2 NST, mỗi NST 2 chromatid
        [0, 1].forEach(side => {
          const ox = (side ? 1 : -1) * (ph === 1 ? w * .026 : w * .021);
          const ang = Math.PI / 2;
          c.strokeStyle = side ? pp.mate : pp.col; c.lineWidth = 4.8; c.lineCap = 'round';
          [1, -1].forEach(s => {
            const ex = pp.x + ox + s * pp.len * .27;
            c.beginPath();
            c.moveTo(ex, y - pp.len * .52);
            c.quadraticCurveTo(pp.x + ox + s * pp.len * .09, y - pp.len * .15, pp.x + ox, y);
            c.quadraticCurveTo(pp.x + ox + s * pp.len * .09, y + pp.len * .15, ex, y + pp.len * .52);
            c.stroke();
          });
          c.fillStyle = '#e7eefa'; c.beginPath(); c.arc(pp.x + ox, y, 2.3, 0, 6.283); c.fill();
        });
        // chiasma khi hoán vị
        if (xo && ph === 0) {
          const mx = pp.x, my = y - pp.len * .10;
          c.strokeStyle = 'rgba(251,191,36,.9)'; c.lineWidth = 2;
          c.beginPath(); c.moveTo(mx - 9, my); c.lineTo(mx + 9, my + 5); c.stroke();
          chipText(c, 'chiasma', mx + 26, my - 4, { color: 'var(--warn)', size: 8 });
        }
      });
      chipText(c, ['Kỳ đầu I', 'Kỳ giữa I', 'Kỳ sau I'][ph], cx, h * .10, { color: 'var(--violet)', size: 10, align: 'center', weight: 800 });
      if (ph === 0 && xo) chipText(c, 'trao đổi đoạn giữa chromatid khác nguồn', cx, h * .90, { color: 'var(--warn)', size: 8.5, align: 'center' });
      if (ph === 1) chipText(c, '2 cặp NST xếp thành 2 hàng', cx, h * .90, { color: p.sub, size: 8.5, align: 'center' });
      if (ph === 2) chipText(c, 'NST tương đồng tách về 2 cực (không phải chromatid)', cx, h * .90, { color: 'var(--accent2)', size: 8.5, align: 'center' });
    } else {
      // ---- 4 giao tử
      const gs = xo
        ? [{ c: ['#3ddc97', '#38bdf8'], l: 'AB' }, { c: ['#2bb37c', '#2b8fc4'], l: 'ab' },
           { c: ['#3ddc97', '#2b8fc4'], l: 'Ab' }, { c: ['#2bb37c', '#38bdf8'], l: 'aB' }]
        : [{ c: ['#3ddc97', '#38bdf8'], l: 'AB' }, { c: ['#2bb37c', '#2b8fc4'], l: 'ab' },
           { c: ['#3ddc97', '#38bdf8'], l: 'AB' }, { c: ['#2bb37c', '#2b8fc4'], l: 'ab' }];
      const gx = [w * .27, w * .73], gy = [h * .32, h * .70];
      gs.forEach((g, i) => {
        const X = gx[i % 2], Y = gy[Math.floor(i / 2)];
        const rr2 = Math.min(w, h) * .085;
        glow(c, X, Y, rr2 * 2, 'rgba(61,220,151,.10)');
        c.beginPath(); c.arc(X, Y, rr2, 0, 6.283);
        c.fillStyle = p.glass; c.fill();
        c.strokeStyle = 'rgba(61,220,151,.55)'; c.lineWidth = 1.8; c.stroke();
        // 2 NST đơn bên trong
        c.strokeStyle = g.c[0]; c.lineWidth = 4; c.lineCap = 'round';
        c.beginPath(); c.moveTo(X - rr2 * .38, Y - rr2 * .30); c.lineTo(X + rr2 * .10, Y - rr2 * .02); c.stroke();
        c.strokeStyle = g.c[1];
        c.beginPath(); c.moveTo(X - rr2 * .10, Y + rr2 * .10); c.lineTo(X + rr2 * .38, Y + rr2 * .34); c.stroke();
        chipText(c, g.l, X, Y + rr2 + 15, { color: p.text, size: 9.5, align: 'center', weight: 800 });
      });
      chipText(c, '4 giao tử đơn bội (n = 2)', w * .5, h * .085, { color: 'var(--accent)', size: 10, align: 'center', weight: 800 });
      chipText(c, xo ? 'có 4 loại: AB, ab, Ab, aB' : 'chỉ 2 loại: AB và ab', w * .5, h * .93,
        { color: xo ? 'var(--warn)' : p.sub, size: 9, align: 'center' });
    }

    ro('gt', ph < 3 ? '1 tế bào mẹ' : '4 giao tử', p.text);
    ro('loai', ph < 3 ? '—' : (xo ? '4 loại' : '2 loại'), xo ? 'var(--warn)' : p.text);
    ro('nst', ph < 3 ? '2n = 4 (kép)' : 'n = 2 (đơn)', p.text);
    ro('bd', xo ? 'Có biến dị tổ hợp' : 'Không có HV', xo ? 'var(--ok)' : 'var(--bad)');
  }
},

/* ---------- 13. TÁI BẢN DNA ---------- */
{
  icon: 'fa-code-branch', name: 'Chạc tái bản DNA', short: 'Chạc chữ Y',
  sub: 'Vì sao một mạch tổng hợp liên tục còn mạch kia phải làm từng đoạn?',
  tags: ['Di truyền phân tử', 'Tái bản'],
  note: 'DNA polymerase chỉ kéo dài được theo chiều <b>5′→3′</b>. Hai mạch khuôn đối song, nên một mạch cho tổng hợp liên tục (mạch dẫn đầu), mạch còn lại buộc phải làm <b>từng đoạn Okazaki</b> rồi nối bằng ligase.',
  v: { sp: 50, show: 1 },
  controls: [
    { type: 'range', k: 'sp', label: 'Tốc độ chạc mở', min: 0, max: 100, step: 5, unit: '%' },
    { type: 'seg', k: 'show', label: 'Hiện nhãn', opts: [[1, 'Có'], [0, 'Không']] }
  ],
  readouts: [['ok', 'Đoạn Okazaki'], ['moi', 'Đoạn mồi'], ['chieu', 'Chiều tổng hợp'], ['lai', 'Tính bán bảo toàn']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    const midY = h * .50, forkX = w * .30 + (v.sp / 100) * w * .40;
    const amp = h * .13, lam = w * .030;

    // hai mạch khuôn phía sau chạc (đã tách)
    function strand(y0, y1, colr, dash) {
      c.strokeStyle = colr; c.lineWidth = 3.4; c.lineCap = 'round';
      if (dash) c.setLineDash([6, 5]);
      c.beginPath(); c.moveTo(w * .06, y0); c.bezierCurveTo(w * .18, y0 + amp * .4, forkX - w * .06, y1 - amp * .3, forkX, y1); c.stroke();
      c.setLineDash([]);
    }
    strand(midY - amp, midY - amp * .95, '#38bdf8');
    strand(midY + amp, midY + amp * .95, '#3ddc97');

    // DNA xoắn kép phía trước chạc (chưa tách)
    c.save();
    c.strokeStyle = 'rgba(160,190,220,.35)'; c.lineWidth = 2;
    for (let i = 0; i < 26; i++) {
      const x = forkX + i * (w * .026);
      if (x > w * .99) break;
      const y1 = midY - amp * .45 + Math.sin(i * .8 + t * 1.2) * h * .018;
      const y2 = midY + amp * .45 + Math.sin(i * .8 + t * 1.2) * h * .018;
      c.beginPath(); c.moveTo(x, y1); c.lineTo(x, y2); c.stroke();
    }
    c.strokeStyle = 'rgba(56,189,248,.55)'; c.lineWidth = 3;
    c.beginPath(); for (let i = 0; i <= 60; i++) { const x = forkX + i * (w * .011); if (x > w) break; const y = midY - amp * .45 + Math.sin(i * .34 + t * 1.2) * h * .018; i ? c.lineTo(x, y) : c.moveTo(x, y); } c.stroke();
    c.strokeStyle = 'rgba(61,220,151,.55)';
    c.beginPath(); for (let i = 0; i <= 60; i++) { const x = forkX + i * (w * .011); if (x > w) break; const y = midY + amp * .45 + Math.sin(i * .34 + t * 1.2) * h * .018; i ? c.lineTo(x, y) : c.moveTo(x, y); } c.stroke();
    c.restore();

    // helicase (nêm mở xoắn)
    glow(c, forkX, midY, h * .075, 'rgba(251,191,36,.45)');
    c.fillStyle = '#fbbf24';
    c.beginPath(); c.moveTo(forkX + 13, midY); c.lineTo(forkX - 9, midY - 16); c.lineTo(forkX - 9, midY + 16); c.closePath(); c.fill();
    if (v.show) chipText(c, 'helicase', forkX, midY - h * .12, { color: 'var(--warn)', size: 8.5, align: 'center' });

    // mạch dẫn đầu: mũi tên liên tục
    c.strokeStyle = '#a99cf9'; c.lineWidth = 4.4; c.lineCap = 'round';
    c.beginPath(); c.moveTo(w * .09, midY - amp * .72); c.lineTo(forkX - w * .02, midY - amp * .72); c.stroke();
    // mũi tên
    c.fillStyle = '#a99cf9';
    c.beginPath(); c.moveTo(forkX - w * .02 + 7, midY - amp * .72); c.lineTo(forkX - w * .02 - 3, midY - amp * .72 - 5); c.lineTo(forkX - w * .02 - 3, midY - amp * .72 + 5); c.fill();
    if (v.show) chipText(c, 'mạch dẫn đầu • liên tục 5′→3′', w * .30, midY - amp * 1.28, { color: '#a99cf9', size: 8.5, align: 'center' });

    // mạch theo sau: các đoạn Okazaki
    const segs = 5, segW = (forkX - w * .09) / segs;
    for (let i = 0; i < segs; i++) {
      const x0 = w * .09 + i * segW + segW * .12, x1 = x0 + segW * .72;
      c.strokeStyle = '#f472b6'; c.lineWidth = 4.4; c.lineCap = 'round';
      c.beginPath(); c.moveTo(x0, midY + amp * .72); c.lineTo(x1, midY + amp * .72); c.stroke();
      // đoạn mồi RNA ở đầu mỗi đoạn
      c.strokeStyle = '#fbbf24'; c.lineWidth = 4.4;
      c.beginPath(); c.moveTo(x0 - segW * .13, midY + amp * .72); c.lineTo(x0, midY + amp * .72); c.stroke();
    }
    if (v.show) {
      chipText(c, 'mạch theo sau • từng đoạn Okazaki', w * .30, midY + amp * 1.62, { color: '#f472b6', size: 8.5, align: 'center' });
      chipText(c, 'đoạn mồi RNA', w * .115, midY + amp * 1.28, { color: 'var(--warn)', size: 8 });
    }

    // chú thích chiều
    tx(c, '3′', w * .045, midY - amp - 10, { size: 9, color: p.sub, mono: true });
    tx(c, '5′', forkX - 6, midY - amp - 10, { size: 9, color: p.sub, mono: true });
    tx(c, '5′', w * .045, midY + amp + 18, { size: 9, color: p.sub, mono: true });
    tx(c, '3′', forkX - 6, midY + amp + 18, { size: 9, color: p.sub, mono: true });

    const nOk = Math.max(1, Math.round(segs * (.4 + v.sp / 100)));
    ro('ok', String(nOk), 'var(--bad)');
    ro('moi', String(nOk + 1), 'var(--warn)');
    ro('chieu', '5′→3′ (cả hai mạch)', p.text);
    ro('lai', 'Mỗi DNA con giữ 1 mạch mẹ', 'var(--ok)');
  }
},

/* ---------- 14. PHIÊN MÃ & DỊCH MÃ ---------- */
{
  icon: 'fa-arrow-right-arrow-left', name: 'Phiên mã & dịch mã', short: 'Gene → protein',
  sub: 'Thông tin trong gene biến thành chuỗi acid amin qua mấy tầng?',
  tags: ['Di truyền phân tử', 'Biểu hiện gene'],
  note: 'Hai tầng: <b>phiên mã</b> (DNA → mRNA, nhờ RNA polymerase, theo NTBS) rồi <b>dịch mã</b> (mRNA → polypeptide, tại ribosome, nhờ tRNA đọc codon). Chiều luôn là 5′→3′ trên phân tử mới.',
  v: { st: 0 },
  controls: [{ type: 'seg', k: 'st', label: 'Giai đoạn', opts: [[0, 'Phiên mã'], [1, 'Dịch mã']] }],
  readouts: [['sp', 'Sản phẩm'], ['chieu', 'Chiều'], ['enz', 'Enzyme/bộ máy'], ['ntbs', 'Nguyên tắc']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);
    const codonList = ['AUG', 'GGX', 'UUX', 'XXX', 'UAA'];
    const aaList = ['Met', 'Gly', 'Phe', 'Pro', 'STOP'];

    if (v.st === 0) {
      // ---------- PHIÊN MÃ ----------
      const yTop = h * .34, yBot = h * .50;
      // hai mạch DNA
      c.strokeStyle = 'rgba(56,189,248,.75)'; c.lineWidth = 3.4; c.lineCap = 'round';
      c.beginPath(); c.moveTo(w * .05, yTop); c.lineTo(w * .95, yTop); c.stroke();
      c.strokeStyle = 'rgba(61,220,151,.75)';
      c.beginPath(); c.moveTo(w * .05, yBot); c.lineTo(w * .95, yBot); c.stroke();
      // base pairs
      for (let i = 0; i < 40; i++) {
        const x = w * .05 + i * (w * .90 / 40);
        c.strokeStyle = 'rgba(160,190,220,.22)'; c.lineWidth = 1.2;
        c.beginPath(); c.moveTo(x, yTop); c.lineTo(x, yBot); c.stroke();
      }
      // bong bóng phiên mã
      const bx = w * .18 + (t * .055 % 1) * w * .56;
      c.save();
      c.fillStyle = p.bg;
      rr(c, bx - w * .10, yTop - 6, w * .20, (yBot - yTop) + 12, 8); c.fill();
      c.restore();
      // RNA polymerase
      glow(c, bx, (yTop + yBot) / 2, h * .10, 'rgba(251,191,36,.4)');
      c.fillStyle = 'rgba(251,191,36,.9)';
      rr(c, bx - 13, yTop - 15, 26, (yBot - yTop) + 30, 9); c.fill();
      chipText(c, 'RNA polymerase', bx, yTop - 24, { color: 'var(--warn)', size: 8.5, align: 'center' });

      // mRNA mọc ra
      const mLen = Math.max(0, bx - w * .10);
      c.strokeStyle = '#f472b6'; c.lineWidth = 4; c.lineCap = 'round';
      c.beginPath(); c.moveTo(w * .10, h * .70);
      for (let i = 0; i <= 40; i++) {
        const x = w * .10 + (mLen * i / 40);
        if (x > bx - 14) break;
        c.lineTo(x, h * .70 + Math.sin(i * .55 + t * 2) * 4);
      }
      c.stroke();
      chipText(c, 'mRNA 5′→3′', w * .10, h * .80, { color: '#f472b6', size: 9 });
      // nucleotide đang gắn
      for (let k = 0; k < 3; k++) {
        const px = bx - 26 - k * 13, py = h * .70 + Math.sin(t * 3 + k) * 5;
        c.fillStyle = ['#3ddc97', '#38bdf8', '#fbbf24'][k];
        c.beginPath(); c.arc(px, py, 4, 0, 6.283); c.fill();
      }
      chipText(c, 'mạch gốc 3′→5′', w * .95, yTop - 12, { color: p.sub, size: 8.5, align: 'right' });

      ro('sp', 'mRNA', '#f472b6');
      ro('chieu', '5′→3′', p.text);
      ro('enz', 'RNA polymerase', p.text);
      ro('ntbs', 'A–U, T–A, G–X', 'var(--ok)');
    } else {
      // ---------- DỊCH MÃ ----------
      const y = h * .46;
      // mRNA
      c.strokeStyle = 'rgba(244,114,182,.8)'; c.lineWidth = 4; c.lineCap = 'round';
      c.beginPath(); c.moveTo(w * .05, y); c.lineTo(w * .95, y); c.stroke();
      // codon
      const cw = (w * .90) / 5;
      codonList.forEach((cd, i) => {
        const x0 = w * .05 + i * cw;
        c.strokeStyle = 'rgba(160,190,220,.28)'; c.lineWidth = 1;
        c.beginPath(); c.moveTo(x0, y - 11); c.lineTo(x0, y + 11); c.stroke();
        tx(c, cd, x0 + cw / 2, y + 26, { size: 9, color: p.sub, align: 'center', mono: true });
      });
      // ribosome (2 tiểu phần) ở codon thứ 2
      const rx2 = w * .05 + cw * 1.5 + Math.sin(t * .7) * cw * .18;
      glow(c, rx2, y - 16, h * .11, 'rgba(139,124,246,.35)');
      c.fillStyle = 'rgba(139,124,246,.85)';
      c.beginPath(); c.ellipse(rx2, y - 22, cw * .40, h * .085, 0, 0, 6.283); c.fill();
      c.fillStyle = 'rgba(169,156,249,.85)';
      c.beginPath(); c.ellipse(rx2, y + 12, cw * .34, h * .055, 0, 0, 6.283); c.fill();
      chipText(c, 'ribosome', rx2, y - h * .15, { color: '#a99cf9', size: 8.5, align: 'center' });

      // tRNA + acid amin
      for (let i = 0; i < 3; i++) {
        const tx2 = rx2 - cw * .55 + i * cw * .55;
        const ty = y - h * .10;
        c.strokeStyle = 'rgba(61,220,151,.85)'; c.lineWidth = 2.4;
        c.beginPath(); c.moveTo(tx2, ty); c.lineTo(tx2 - 5, ty + 18); c.lineTo(tx2 + 5, ty + 18); c.closePath(); c.stroke();
        // anticodon
        c.strokeStyle = '#3ddc97'; c.lineWidth = 3;
        c.beginPath(); c.moveTo(tx2 - 7, ty + 20); c.lineTo(tx2 + 7, ty + 20); c.stroke();
        // acid amin
        c.fillStyle = ['#fbbf24', '#38bdf8', '#f472b6'][i];
        c.beginPath(); c.arc(tx2, ty - 7, 5.2, 0, 6.283); c.fill();
        c.strokeStyle = 'rgba(255,255,255,.5)'; c.lineWidth = 1; c.stroke();
      }
      // chuỗi polypeptide
      const polyX = w * .06, polyY = h * .19;
      c.strokeStyle = 'rgba(251,191,36,.9)'; c.lineWidth = 2.6; c.lineCap = 'round';
      c.beginPath();
      for (let i = 0; i < 7; i++) {
        const px = polyX + i * 15, py = polyY + Math.sin(i * .9 + t) * 3;
        i ? c.lineTo(px, py) : c.moveTo(px, py);
      }
      c.stroke();
      for (let i = 0; i < 7; i++) {
        const px = polyX + i * 15, py = polyY + Math.sin(i * .9 + t) * 3;
        c.fillStyle = i === 6 ? '#3ddc97' : 'rgba(251,191,36,.85)';
        c.beginPath(); c.arc(px, py, 4.2, 0, 6.283); c.fill();
      }
      chipText(c, 'chuỗi polypeptide', polyX + 30, polyY - 14, { color: 'var(--warn)', size: 8.5 });

      // acid amin tương ứng
      aaList.forEach((aa, i) => {
        const x0 = w * .05 + i * cw;
        tx(c, aa, x0 + cw / 2, y + 44, { size: 9.5, color: aa === 'STOP' ? 'var(--bad)' : p.text, align: 'center', weight: 800 });
      });

      ro('sp', 'polypeptide', 'var(--warn)');
      ro('chieu', 'ribosome 5′→3′', p.text);
      ro('enz', 'ribosome + tRNA', p.text);
      ro('ntbs', 'codon – anticodon', 'var(--ok)');
    }
  }
},

/* ---------- 15. ĐỘT BIẾN GENE ---------- */
{
  icon: 'fa-bolt', name: 'Đột biến gene', short: 'Thay – mất – thêm',
  sub: 'Vì sao mất 1 cặp nucleotide lại nguy hiểm hơn thay thế 1 cặp?',
  tags: ['Đột biến', 'Protein'],
  note: 'Thay thế chỉ đổi <b>một</b> codon nên có thể là đồng nghĩa (protein không đổi). Mất hoặc thêm 1 cặp làm <b>lệch khung đọc</b> từ điểm đột biến trở đi ⇒ toàn bộ acid amin phía sau sai, protein gần như chắc chắn mất chức năng.',
  v: { type: 0 },
  controls: [{ type: 'seg', k: 'type', label: 'Dạng đột biến', opts: [[0, 'Bình thường'], [1, 'Thay thế'], [2, 'Mất 1 cặp'], [3, 'Thêm 1 cặp']] }],
  readouts: [['loai', 'Dạng'], ['aa', 'Số acid amin'], ['doi', 'Acid amin đổi'], ['hq', 'Hậu quả']],
  draw(c, w, h, t) {
    const p = P(), v = this.v, type = v.type;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    const base = ['A', 'T', 'G', 'X', 'A', 'T', 'G', 'X', 'A', 'T', 'G', 'X'];
    let mut = base.slice();
    let mark = -1, inserted = false;
    if (type === 1) { mut[4] = 'G'; mark = 4; }
    if (type === 2) { mut.splice(4, 1); mark = 4; }
    if (type === 3) { mut.splice(4, 0, 'X'); mark = 4; inserted = true; }

    const yTop = h * .30, bw = w * .052, x0 = w * .08;
    // nhãn
    chipText(c, 'mạch gốc', x0 - 4, yTop - 26, { color: p.sub, size: 8.5 });
    chipText(c, 'mạch đột biến', x0 - 4, yTop + h * .18 - 26, { color: type ? 'var(--bad)' : p.sub, size: 8.5 });

    function row(arr, y, isMut) {
      arr.forEach((b, i) => {
        const x = x0 + i * bw;
        const hot = isMut && (i === mark || (type === 2 && i >= mark) || (type === 3 && i >= mark));
        const fill = isMut && i === mark ? 'rgba(251,113,133,.9)'
          : isMut && hot ? 'rgba(251,191,36,.28)'
          : 'rgba(56,189,248,.16)';
        c.fillStyle = fill;
        rr(c, x, y - 14, bw - 4, 28, 6); c.fill();
        c.strokeStyle = isMut && i === mark ? '#fb7185' : 'rgba(160,190,220,.28)'; c.lineWidth = 1;
        rr(c, x, y - 14, bw - 4, 28, 6); c.stroke();
        tx(c, b, x + (bw - 4) / 2, y + 4, { size: 10, color: p.text, align: 'center', mono: true, weight: 700 });
      });
    }
    row(base, yTop, false);
    row(mut, yTop + h * .18, true);

    // dấu so sánh
    for (let i = 0; i < base.length; i++) {
      const x = x0 + i * bw + (bw - 4) / 2;
      const same = mut[i] === base[i];
      c.strokeStyle = same ? 'rgba(160,190,220,.18)' : 'rgba(251,113,133,.8)';
      c.lineWidth = same ? 1 : 2;
      c.beginPath(); c.moveTo(x, yTop + 16); c.lineTo(x, yTop + h * .18 - 18); c.stroke();
    }

    // khung đọc (codon)
    const cy2 = h * .62;
    chipText(c, 'khung đọc codon', x0 - 4, cy2 - 20, { color: p.accent || p.sub, size: 8.5 });
    const shift = (type === 2 || type === 3) ? 1 : 0;
    for (let i = 0; i < 4; i++) {
      const cx3 = x0 + i * bw * 3;
      const cod = mut.slice(i * 3, i * 3 + 3).join('') || '—';
      const bad = (type === 2 || type === 3) && i >= 1;
      c.fillStyle = bad ? 'rgba(251,113,133,.16)' : 'rgba(61,220,151,.14)';
      rr(c, cx3, cy2 - 10, bw * 3 - 6, 26, 6); c.fill();
      c.strokeStyle = bad ? 'rgba(251,113,133,.5)' : 'rgba(61,220,151,.4)'; c.lineWidth = 1;
      rr(c, cx3, cy2 - 10, bw * 3 - 6, 26, 6); c.stroke();
      tx(c, cod, cx3 + (bw * 3 - 6) / 2, cy2 + 6, { size: 9.5, color: bad ? 'var(--bad)' : p.text, align: 'center', mono: true, weight: 700 });
      // aa
      tx(c, bad ? '?' : ['Met', 'Gly', 'Phe', 'Pro'][i], cx3 + (bw * 3 - 6) / 2, cy2 + 40,
        { size: 8.5, color: bad ? 'var(--bad)' : 'var(--accent)', align: 'center', weight: 800 });
    }

    // hậu quả minh họa
    const py = h * .85;
    tx(c, 'Protein:', w * .08, py, { size: 9, color: p.sub });
    const nGood = type >= 2 ? 1 : 4;
    for (let i = 0; i < 4; i++) {
      const px = w * .22 + i * 26;
      c.fillStyle = i < nGood ? 'rgba(61,220,151,.85)' : 'rgba(251,113,133,.75)';
      c.beginPath(); c.arc(px, py - 3, 5.4, 0, 6.283); c.fill();
      c.strokeStyle = 'rgba(255,255,255,.35)'; c.lineWidth = 1; c.stroke();
    }
    if (type === 0) chipText(c, 'protein bình thường, đủ chức năng', w * .5, h * .95, { color: 'var(--ok)', size: 8.5, align: 'center' });
    if (type === 1) chipText(c, 'có thể chỉ đổi 1 acid amin (hoặc không đổi)', w * .5, h * .95, { color: 'var(--warn)', size: 8.5, align: 'center' });
    if (type >= 2) chipText(c, 'lệch khung → toàn bộ phía sau sai', w * .5, h * .95, { color: 'var(--bad)', size: 8.5, align: 'center' });

    ro('loai', ['Không đột biến', 'Thay thế 1 cặp', 'Mất 1 cặp', 'Thêm 1 cặp'][type],
      type === 0 ? 'var(--ok)' : type === 1 ? 'var(--warn)' : 'var(--bad)');
    ro('aa', type >= 2 ? 'giảm / đổi hết' : '4 (đủ)', p.text);
    ro('doi', type === 0 ? '0' : type === 1 ? '1 codon' : 'toàn bộ từ vị trí đột biến', type >= 2 ? 'var(--bad)' : p.text);
    ro('hq', type === 0 ? 'Bình thường' : type === 1 ? 'Có thể đồng nghĩa' : 'Mất chức năng', type >= 2 ? 'var(--bad)' : 'var(--warn)');
  }
}
,
/* ---------- 16. TRAO ĐỔI KHÍ Ở PHỔI ---------- */
{
  icon: 'fa-lungs', name: 'Trao đổi khí ở phổi', short: 'Phế nang ↔ máu',
  sub: 'Vì sao thở nông, hoặc phế nang bị phá hủy, đều làm máu thiếu O₂?',
  tags: ['Hô hấp', 'Tuần hoàn'],
  note: 'Trao đổi khí là <b>khuếch tán</b> — không tiêu tốn ATP. Tốc độ khuếch tán tỉ lệ với <b>chênh lệch phân áp</b> (pO₂ phế nang − pO₂ máu) và với <b>diện tích màng</b>. Thông khí kém làm pO₂ phế nang tụt; diện tích giảm (khí phế thũng) làm máu không kịp bão hòa O₂ dù vẫn thở đủ nhịp.',
  v: { vent: 80, area: 85 },
  controls: [
    { type: 'range', k: 'vent', label: 'Thông khí (nhịp thở × độ sâu)', min: 10, max: 100, step: 5, unit: '%' },
    { type: 'range', k: 'area', label: 'Diện tích trao đổi còn hoạt động', min: 10, max: 100, step: 5, unit: '%' }
  ],
  readouts: [['pa', 'pO₂ phế nang'], ['pv', 'pO₂ máu ra'], ['sat', 'Bão hòa Hb'], ['kl', 'Kết luận']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    /* Phương trình khí phế nang + khuếch tán Fick: máu tiệm cận pO₂ phế nang
       theo hàm mũ của diện tích màng (không phải tỉ lệ thẳng). */
    const pAlv = 40 + 65 * (v.vent / 100);
    const pOut = 40 + (pAlv - 40) * (1 - Math.exp(-3.2 * (v.area / 100)));
    const pw = Math.pow(pOut, 2.7);
    const sat = 100 * pw / (pw + Math.pow(26, 2.7));

    const cx = w * .27, cy = h * .31, R = Math.min(h * .27, w * .155);
    const capY = h * .695, capH = Math.max(24, h * .145);

    /* ---- mao mạch ---- */
    const gcap = c.createLinearGradient(w * .04, 0, w * .96, 0);
    gcap.addColorStop(0, 'rgba(126,102,200,.30)');
    gcap.addColorStop(.5, 'rgba(212,86,120,.24)');
    gcap.addColorStop(1, 'rgba(246,96,96,.30)');
    rr(c, w * .04, capY, w * .92, capH, capH * .5);
    c.fillStyle = gcap; c.fill();
    c.strokeStyle = 'rgba(246,152,160,.45)'; c.lineWidth = 2; c.stroke();

    /* ---- màng trao đổi: độ dài thể hiện diện tích còn hoạt động ---- */
    const memX0 = w * .07, memLen = w * .86 * (v.area / 100);
    glow(c, memX0 + memLen * .5, capY, Math.max(memLen * .55, 46), 'rgba(56,189,248,.16)');
    c.strokeStyle = 'rgba(56,189,248,.9)'; c.lineWidth = 3.6; c.lineCap = 'round';
    c.beginPath(); c.moveTo(memX0, capY); c.lineTo(memX0 + memLen, capY); c.stroke();
    if (v.area < 100) {
      c.setLineDash([3, 5]);
      c.strokeStyle = 'rgba(251,113,133,.45)'; c.lineWidth = 2.4;
      c.beginPath(); c.moveTo(memX0 + memLen, capY); c.lineTo(w * .93, capY); c.stroke();
      c.setLineDash([]);
    }

    /* ---- phế nang ---- */
    glow(c, cx, cy, R * 1.7, 'rgba(56,189,248,.16)');
    const gal = c.createRadialGradient(cx - R * .3, cy - R * .35, R * .08, cx, cy, R * 1.05);
    gal.addColorStop(0, root.dataset.theme === 'light' ? '#ffffff' : 'rgba(198,230,255,.26)');
    gal.addColorStop(1, root.dataset.theme === 'light' ? '#ddf0ff' : 'rgba(80,142,196,.09)');
    c.beginPath(); c.arc(cx, cy, R, 0, 6.283); c.fillStyle = gal; c.fill();
    c.strokeStyle = 'rgba(150,210,245,.62)'; c.lineWidth = 2.6; c.stroke();

    // lỗ thông giữa các phế nang (pore of Kohn) — chi tiết giải phẫu
    for (let i = 0; i < 4; i++) {
      const a = -.9 + i * .62;
      const px2 = cx + Math.cos(a) * R, py2 = cy + Math.sin(a) * R;
      c.beginPath(); c.arc(px2, py2, R * .055, 0, 6.283);
      c.fillStyle = root.dataset.theme === 'light' ? 'rgba(200,225,245,.9)' : 'rgba(30,60,90,.55)';
      c.fill();
      c.strokeStyle = 'rgba(150,210,245,.4)'; c.lineWidth = 1; c.stroke();
    }

    // lớp surfactant gợn sóng theo nhịp thở
    c.beginPath();
    for (let a = 0; a <= 6.2832; a += .1) {
      const rr2 = R * (.86 + .05 * Math.sin(a * 6 + t * 1.2));
      const x = cx + Math.cos(a) * rr2, y = cy + Math.sin(a) * rr2;
      a ? c.lineTo(x, y) : c.moveTo(x, y);
    }
    c.closePath(); c.strokeStyle = 'rgba(190,232,255,.28)'; c.lineWidth = 1.2; c.stroke();

    chipText(c, 'PHẾ NANG', cx, cy - R - 8, { color: 'var(--accent2)', size: 9, align: 'center' });
    tx(c, 'pO₂ ' + Math.round(pAlv) + ' mmHg', cx, cy + 3, { size: 11.5, color: p.text, align: 'center', weight: 700 });
    tx(c, 'pCO₂ ' + Math.round(46 - 6 * v.vent / 100) + ' mmHg', cx, cy + 20, { size: 9, color: p.sub, align: 'center' });

    /* đồ thị đường cong bão hoà Hb — giải thích vì sao pO₂ tụt là mô thiếu O₂ */
    const qx0 = w * .64, qx1 = w * .93, qy0 = h * .19, qy1 = h * .53;
    c.strokeStyle = p.line; c.lineWidth = 1.2;
    c.beginPath(); c.moveTo(qx0, qy0 - 4); c.lineTo(qx0, qy1); c.lineTo(qx1, qy1); c.stroke();
    for (let i = 1; i < 4; i++) {
      const yy = qy1 - (qy1 - qy0) * i / 4;
      c.setLineDash([2, 5]); c.strokeStyle = p.line;
      c.beginPath(); c.moveTo(qx0, yy); c.lineTo(qx1, yy); c.stroke();
      c.setLineDash([]);
    }
    c.beginPath();
    for (let i = 0; i <= 60; i++) {
      const po = i / 60 * 100;
      const pww = Math.pow(po, 2.7);
      const sv = pww / (pww + Math.pow(26, 2.7));
      const x = qx0 + (qx1 - qx0) * po / 100;
      const y = qy1 - (qy1 - qy0) * sv;
      i ? c.lineTo(x, y) : c.moveTo(x, y);
    }
    c.strokeStyle = 'rgba(251,113,133,.8)'; c.lineWidth = 2.2; c.lineCap = 'round'; c.stroke();
    const mxx = qx0 + (qx1 - qx0) * Math.min(100, Math.max(0, pOut)) / 100;
    const myy = qy1 - (qy1 - qy0) * sat / 100;
    glow(c, mxx, myy, 16, 'rgba(56,189,248,.45)');
    c.fillStyle = '#38bdf8'; c.beginPath(); c.arc(mxx, myy, 4.4, 0, 6.283); c.fill();
    tx(c, 'bão hoà Hb', qx0, qy0 - 10, { size: 8.5, color: p.sub });
    tx(c, '100%', qx0 - 4, qy0 + 3, { size: 7.5, color: p.sub, align: 'right' });
    tx(c, 'pO₂ →', qx1, qy1 + 14, { size: 8, color: p.sub, align: 'right' });

    /* ---- hạt khí khuếch tán ---- */
    const rnd = i => { const x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
    const gapTop = cy + R * .90, gapBot = capY;
    const drive = (v.vent / 100) * (v.area / 100);
    for (let i = 0; i < 10; i++) {
      const ph = (t * (.20 + .55 * drive) + i * .137) % 1;
      const x = cx + (rnd(i) - .5) * R * 1.35;
      const y = gapTop + ph * (gapBot - gapTop);
      const al = Math.sin(ph * Math.PI);
      c.globalAlpha = al * .95;
      c.fillStyle = '#38bdf8';
      c.beginPath(); c.arc(x, y, 3.6, 0, 6.283); c.fill();
      c.globalAlpha = al * .22;
      c.beginPath(); c.arc(x, y, 8, 0, 6.283); c.fill();
      c.globalAlpha = 1;
    }
    for (let i = 0; i < 7; i++) {
      const ph = (t * (.16 + .42 * drive) + i * .19 + .45) % 1;
      const x = cx + R * .45 + (rnd(i + 40) - .5) * R * 1.1;
      const y = gapBot - ph * (gapBot - gapTop);
      c.globalAlpha = Math.sin(ph * Math.PI) * .8;
      c.fillStyle = '#fbbf24';
      c.beginPath(); c.arc(x, y, 3.1, 0, 6.283); c.fill();
      c.globalAlpha = 1;
    }

    /* ---- hồng cầu: đổi màu khi nhận O₂ ---- */
    for (let i = 0; i < 10; i++) {
      const u = (t * .05 + i / 10) % 1;
      const x = w * .06 + u * w * .86;
      const y = capY + capH * .52;
      const ox = Math.min(1, u / .55);
      const cr = Math.round(126 + 118 * ox), cg = Math.round(96 + 40 * ox), cb = Math.round(200 - 118 * ox);
      c.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',.92)';
      c.beginPath(); c.ellipse(x, y, 10, 6.8, 0, 0, 6.283); c.fill();
      c.fillStyle = 'rgba(0,0,0,.16)';
      c.beginPath(); c.ellipse(x, y, 4.4, 2.9, 0, 0, 6.283); c.fill();
    }
    chipText(c, 'máu đến • pO₂ 40', w * .075, capY - 12, { color: '#a99cf9', size: 8 });
    chipText(c, 'máu đi • pO₂ ' + Math.round(pOut), w * .955, capY - 12, { color: '#fb7185', size: 8, align: 'right' });

    /* ---- chú giải O₂ / CO₂ ---- */
    const lgx = w * .70, lgy = h * .075;
    c.fillStyle = '#38bdf8'; c.beginPath(); c.arc(lgx, lgy, 4, 0, 6.283); c.fill();
    tx(c, 'O₂ vào máu', lgx + 10, lgy + 4, { size: 9, color: p.sub });
    c.fillStyle = '#fbbf24'; c.beginPath(); c.arc(lgx, lgy + 18, 4, 0, 6.283); c.fill();
    tx(c, 'CO₂ ra phế nang', lgx + 10, lgy + 22, { size: 9, color: p.sub });

    /* ---- thanh diện tích ---- */
    const bx = w * .07, bw2 = w * .86, by = h - 40;
    rr(c, bx, by, bw2, 4, 2); c.fillStyle = p.line; c.fill();
    rr(c, bx, by, bw2 * v.area / 100, 4, 2); c.fillStyle = col('var(--accent2)'); c.fill();
    tx(c, 'diện tích màng', bx, by - 6, { size: 8, color: p.sub });

    ro('pa', Math.round(pAlv) + ' mmHg', p.text);
    ro('pv', Math.round(pOut) + ' mmHg', pOut > 85 ? 'var(--ok)' : pOut > 60 ? 'var(--warn)' : 'var(--bad)');
    ro('sat', sat.toFixed(1) + '%', sat > 95 ? 'var(--ok)' : sat > 88 ? 'var(--warn)' : 'var(--bad)');
    ro('kl', sat > 95 ? 'Bình thường' : sat > 88 ? 'Thiếu O₂ nhẹ' : 'Suy hô hấp', sat > 95 ? 'var(--ok)' : sat > 88 ? 'var(--warn)' : 'var(--bad)');
  }
},

/* ---------- 17. THẬN & LỌC MÁU ---------- */
{
  icon: 'fa-droplet', name: 'Thận & lọc máu', short: 'Đơn vị thận',
  sub: 'Vì sao mỗi ngày thận lọc ~180 lít dịch mà chỉ thải ra 1,5 lít nước tiểu?',
  tags: ['Bài tiết', 'Cân bằng nội môi'],
  note: 'Đơn vị thận làm ba việc: <b>lọc</b> ở cầu thận (nhờ áp lực máu), <b>tái hấp thu</b> ở ống lượn gần – quai Henle – ống lượn xa, và <b>bài tiết</b> ở ống góp. Khoảng 99% nước cùng gần như toàn bộ glucose, acid amin được thu hồi; chỉ chất thải (ure, creatinin) đi ra cùng nước tiểu.',
  v: { pres: 100, reab: 99 },
  controls: [
    { type: 'range', k: 'pres', label: 'Áp lực lọc ở cầu thận', min: 20, max: 100, step: 5, unit: '%' },
    { type: 'range', k: 'reab', label: 'Khả năng tái hấp thu của ống thận', min: 40, max: 99, step: 1, unit: '%' }
  ],
  readouts: [['loc', 'Dịch lọc / phút'], ['thu', 'Nước tái hấp thu'], ['nuoc', 'Nước tiểu / phút'], ['tp', 'Bất thường']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    /* Cầu thận tự điều hoà: GFR giữ ~ổn định trong khoảng 80–180 mmHg
       (cơ chế myogenic + phản hồi ống cầu), chỉ tụt khi huyết áp quá thấp. */
    const pres = +v.pres || 100;
    const auto = pres < 80 ? 0.45 + 0.55 * (pres / 80) : pres > 130 ? 1 + 0.18 * ((pres - 130) / 100) : 1;
    const gfr = 125 * Math.max(0.12, Math.min(1.25, auto));
    const urine = gfr * (1 - v.reab / 100);

    /* đường đi của ống thận */
    const raw = [
      [.115, .22], [.135, .40], [.175, .64], [.245, .82],
      [.315, .82], [.365, .62], [.415, .40], [.475, .25],
      [.545, .23], [.585, .54], [.600, .78]
    ].map(a => [a[0] * w, a[1] * h]);

    const pts = [raw[0]];
    for (let i = 1; i < raw.length - 1; i++) {
      const x0 = i === 1 ? raw[0][0] : (raw[i - 1][0] + raw[i][0]) / 2;
      const y0 = i === 1 ? raw[0][1] : (raw[i - 1][1] + raw[i][1]) / 2;
      const mx = (raw[i][0] + raw[i + 1][0]) / 2, my = (raw[i][1] + raw[i + 1][1]) / 2;
      for (let s = 1; s <= 8; s++) {
        const u = s / 8, iu = 1 - u;
        pts.push([iu * iu * x0 + 2 * iu * u * raw[i][0] + u * u * mx,
                  iu * iu * y0 + 2 * iu * u * raw[i][1] + u * u * my]);
      }
    }
    pts.push(raw[raw.length - 1]);

    const cum = [0];
    for (let i = 1; i < pts.length; i++) {
      cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    }
    const total = cum[cum.length - 1];
    function at(u) {
      const d = u * total;
      let i = 1;
      while (i < cum.length - 1 && cum[i] < d) i++;
      const seg = cum[i] - cum[i - 1] || 1, k = (d - cum[i - 1]) / seg;
      return [pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * k,
              pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * k];
    }

    const tubeW = Math.max(11, Math.min(h * .105, w * .052));
    c.lineJoin = 'round'; c.lineCap = 'round';

    // thành ống
    c.beginPath(); c.moveTo(pts[0][0], pts[0][1]);
    for (let i = 1; i < pts.length; i++) c.lineTo(pts[i][0], pts[i][1]);
    c.strokeStyle = root.dataset.theme === 'light' ? 'rgba(120,160,150,.30)' : 'rgba(120,170,200,.22)';
    c.lineWidth = tubeW; c.stroke();
    c.strokeStyle = root.dataset.theme === 'light' ? 'rgba(248,255,252,.9)' : 'rgba(10,20,32,.6)';
    c.lineWidth = tubeW * .70; c.stroke();

    // lòng ống tô màu theo từng đoạn
    const SEG = [[0, .30, '#38bdf8'], [.30, .55, '#8b7cf6'], [.55, .74, '#3ddc97'], [.74, 1.001, '#fbbf24']];
    c.globalAlpha = .34;
    SEG.forEach(([u0, u1, cl]) => {
      c.beginPath();
      let started = false;
      for (let i = 0; i < pts.length; i++) {
        const u = cum[i] / total;
        if (u < u0 || u > u1) continue;
        if (!started) { c.moveTo(pts[i][0], pts[i][1]); started = true; }
        else c.lineTo(pts[i][0], pts[i][1]);
      }
      c.strokeStyle = cl; c.lineWidth = tubeW * .56; c.stroke();
    });
    c.globalAlpha = 1;

    /* cầu thận */
    const gx = raw[0][0], gy = raw[0][1], gr = Math.min(h * .082, w * .058);
    glow(c, gx, gy, gr * 2.3, 'rgba(251,113,133,.20)');
    c.beginPath(); c.arc(gx, gy, gr * 1.40, 0, 6.283);
    c.fillStyle = root.dataset.theme === 'light' ? 'rgba(255,255,255,.82)' : 'rgba(14,26,38,.66)'; c.fill();
    c.strokeStyle = 'rgba(56,189,248,.65)'; c.lineWidth = 2.2; c.stroke();
    for (let i = 0; i < 4; i++) {
      c.beginPath();
      c.arc(gx + Math.cos(i * 1.6) * gr * .30, gy + Math.sin(i * 1.6) * gr * .30, gr * (.40 + i * .07), i, i + 4.2);
      c.strokeStyle = 'rgba(246,96,96,.78)'; c.lineWidth = 2.3; c.stroke();
    }
    chipText(c, 'CẦU THẬN', gx, gy - gr * 1.40 - 7, { color: 'var(--bad)', size: 8.5, align: 'center' });

    /* hạt trong lòng ống */
    const rnd = i => { const x = Math.sin(i * 219.3 + 91.7) * 43758.5453; return x - Math.floor(x); };
    const speed = .045 + .035 * (v.pres / 100);
    for (let i = 0; i < 24; i++) {
      const u = (t * speed + i / 24) % 1;
      const pos = at(u);
      const kind = i % 5;
      let a = 1, colr = '#38bdf8', rad = 2.8;
      if (kind === 2) { colr = '#fbbf24'; rad = 3.2; }
      if (kind === 3) { colr = '#34d399'; rad = 3.2; a = u < .30 ? 1 - u / .30 : 0; }
      if (kind === 4) { colr = '#a99cf9'; rad = 2.3; a = u < .55 ? 1 - u / .55 : 0; }
      if (kind <= 1) a = Math.max(.08, 1 - u * (v.reab / 100) * .94);
      if (a <= .02) continue;
      c.globalAlpha = a;
      c.fillStyle = colr;
      c.beginPath(); c.arc(pos[0], pos[1], rad, 0, 6.283); c.fill();
      c.globalAlpha = 1;
    }

    /* giọt nước tiểu */
    const ex = raw[raw.length - 1][0], ey = raw[raw.length - 1][1];
    for (let i = 0; i < 3; i++) {
      const ph = (t * .9 + i / 3) % 1;
      const yy = ey + 6 + ph * Math.min(h * .06, 22);
      c.globalAlpha = (1 - ph) * .85;
      c.fillStyle = '#fbbf24';
      c.beginPath();
      c.moveTo(ex, yy - 4.5); c.quadraticCurveTo(ex + 4.2, yy + 1.5, ex, yy + 4.5);
      c.quadraticCurveTo(ex - 4.2, yy + 1.5, ex, yy - 4.5); c.fill();
      c.globalAlpha = 1;
    }
    chipText(c, 'NƯỚC TIỂU', ex + tubeW * .95, ey - 3, { color: 'var(--warn)', size: 8 });

    /* chú giải 4 đoạn ống */
    const LG = [['#38bdf8', 'Ống lượn gần', 'thu hồi glucose, acid amin, Na⁺'],
                ['#8b7cf6', 'Quai Henle', 'tạo gradient thẩm thấu'],
                ['#3ddc97', 'Ống lượn xa', 'tinh chỉnh Na⁺, H⁺, K⁺'],
                ['#fbbf24', 'Ống góp', 'ADH điều hoà nước cuối cùng']];
    const lx = w * .66, ly = h * .13;
    LG.forEach((g, i) => {
      const y = ly + i * Math.min(h * .105, 26);
      c.fillStyle = g[0];
      c.beginPath(); c.arc(lx, y - 3, 3.6, 0, 6.283); c.fill();
      tx(c, g[1], lx + 10, y, { size: 9, color: p.text, weight: 700 });
      tx(c, g[2], lx + 10, y + 11, { size: 7.8, color: p.sub });
    });

    const abn = v.reab < 70 ? 'Glucose + protein lọt ra' : urine > 20 ? 'Nước tiểu quá loãng' : 'Không';
    ro('loc', Math.round(gfr) + ' mL/ph', p.text);
    ro('thu', v.reab + '%', v.reab > 95 ? 'var(--ok)' : v.reab > 80 ? 'var(--warn)' : 'var(--bad)');
    ro('nuoc', urine < 10 ? urine.toFixed(1) + ' mL/ph' : Math.round(urine) + ' mL/ph',
      urine < 2.5 ? 'var(--ok)' : urine < 20 ? 'var(--warn)' : 'var(--bad)');
    ro('tp', abn, abn === 'Không' ? 'var(--ok)' : 'var(--bad)');
  }
},

/* ---------- 18. MENĐEN — BẢNG PUNNETT ---------- */
{
  icon: 'fa-table-cells', name: 'Menđen — bảng Punnett', short: 'Lai 1 & 2 cặp',
  sub: 'Làm sao dự đoán tỉ lệ kiểu hình mà không cần làm thí nghiệm?',
  tags: ['Quy luật di truyền', 'Xác suất'],
  note: 'Bảng Punnett liệt kê <b>mọi tổ hợp giao tử</b> có thể gặp. Mỗi ô là một tổ hợp có xác suất bằng nhau, nên tỉ lệ kiểu hình chính là <b>số ô</b> thuộc kiểu đó chia cho tổng số ô. Đây là công cụ trực quan hoá quy luật phân li và phân li độc lập.',
  v: { cross: 0 },
  controls: [{ type: 'seg', k: 'cross', label: 'Phép lai', opts: [[0, 'Aa × Aa'], [1, 'Aa × aa'], [2, 'AaBb × AaBb'], [3, 'AaBb × aabb']] }],
  readouts: [['pl', 'Phép lai'], ['so', 'Số tổ hợp'], ['ti', 'Kiểu gene'], ['kh', 'Kiểu hình']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    const CR = [
      { a: ['A', 'a'], b: ['A', 'a'], nm: 'Aa × Aa' },
      { a: ['A', 'a'], b: ['a', 'a'], nm: 'Aa × aa' },
      { a: ['AB', 'Ab', 'aB', 'ab'], b: ['AB', 'Ab', 'aB', 'ab'], nm: 'AaBb × AaBb' },
      { a: ['AB', 'Ab', 'aB', 'ab'], b: ['ab', 'ab', 'ab', 'ab'], nm: 'AaBb × aabb' }
    ];
    const cr = CR[v.cross], n = cr.a.length, two = n === 4;

    const PH = {
      D: { c: 'var(--ok)', t: 'trội' }, R: { c: 'var(--bad)', t: 'lặn' },
      AB: { c: 'var(--accent2)', t: 'A–B–' }, Ab: { c: 'var(--warn)', t: 'A–bb' },
      aB: { c: 'var(--nebula)', t: 'aaB–' }, ab: { c: 'var(--bad)', t: 'aabb' }
    };
    // chuẩn hoá kiểu gene: allele trội đứng trước, gộp theo từng gene
    function norm(i, j) {
      const A = cr.a[i], B = cr.b[j];
      if (!two) return [A, B].sort().join('');
      return [A[0], B[0]].sort().join('') + [A[1], B[1]].sort().join('');
    }
    function ph(gt) {
      if (!two) return gt.indexOf('A') >= 0 ? 'D' : 'R';
      const A = gt.indexOf('A') >= 0, B = gt.indexOf('B') >= 0;
      return A && B ? 'AB' : A ? 'Ab' : B ? 'aB' : 'ab';
    }

    const wide = w >= 620;
    const areaW = wide ? w * .56 : w;
    const lw = 40;
    const vBottom = wide ? h - 12 : h - 48;
    const cell = Math.min((areaW - lw - 14) / n, (vBottom - h * .165) / n);
    const blockW = cell * n + lw;
    const gx = (areaW - blockW) / 2 + lw + (wide ? 4 : 0);
    const gy = h * .165;

    /* nhãn giao tử */
    for (let j = 0; j < n; j++) {
      tx(c, cr.b[j], gx + cell * (j + .5), gy - 9, { size: two ? 10 : 13, color: 'var(--nebula)', align: 'center', weight: 700, mono: true });
    }
    for (let i = 0; i < n; i++) {
      tx(c, cr.a[i], gx - 9, gy + cell * (i + .5) + 4, { size: two ? 10 : 13, color: 'var(--accent2)', align: 'right', weight: 700, mono: true });
    }
    // nhãn trục: xoay dọc cho hàng, ngang cho cột
    c.save(); c.translate(gx - lw + 2, gy + cell * n / 2); c.rotate(-Math.PI / 2);
    tx(c, '♀ (hàng)', 0, 0, { size: 8.5, color: p.sub, align: 'center' });
    c.restore();
    tx(c, '♂ (cột)', gx + cell * n / 2, gy - 26, { size: 8.5, color: p.sub, align: 'center' });

    /* các ô */
    const cnt = {}, gcnt = {}, ord = [];
    for (let i = 0; i < n; i++) {
      for (let j = 0; j < n; j++) {
        const gt = norm(i, j), k = ph(gt);
        if (!(k in cnt)) { cnt[k] = 0; ord.push(k); }
        cnt[k]++;
        gcnt[gt] = (gcnt[gt] || 0) + 1;

        const x = gx + cell * j, y = gy + cell * i;
        const pulse = .5 + .5 * Math.sin(t * 1.5 + (i + j) * .5);
        rr(c, x + 1.5, y + 1.5, cell - 3, cell - 3, Math.min(9, cell * .16));
        c.fillStyle = col(PH[k].c);
        c.globalAlpha = .12 + .07 * pulse; c.fill();
        c.globalAlpha = 1;
        c.strokeStyle = col(PH[k].c); c.globalAlpha = .5; c.lineWidth = 1.4; c.stroke();
        c.globalAlpha = 1;
        tx(c, gt, x + cell / 2, y + cell / 2 + (two ? 4 : 6), {
          size: two ? Math.min(13, cell * .30) : Math.min(18, cell * .30),
          color: PH[k].c, align: 'center', weight: 700, mono: true
        });
      }
    }

    /* tỉ lệ */
    const ratio = ord.map(k => cnt[k]).join(' : ');
    if (wide) {
      const px = w * .625, pw2 = w * .335;
      tx(c, 'TỈ LỆ KIỂU HÌNH', px, h * .17, { size: 9, color: p.sub, weight: 700 });
      ord.forEach((k, idx) => {
        const y = h * .235 + idx * Math.min(h * .125, 34);
        const pc = cnt[k] / (n * n);
        tx(c, PH[k].t, px, y, { size: 10, color: PH[k].c, weight: 700 });
        tx(c, cnt[k] + '/' + (n * n), px + pw2, y, { size: 10, color: p.sub, align: 'right', mono: true });
        rr(c, px, y + 6, pw2, 6, 3); c.fillStyle = p.line; c.fill();
        rr(c, px, y + 6, Math.max(3, pw2 * pc), 6, 3); c.fillStyle = col(PH[k].c); c.fill();
      });
    } else {
      const by = gy + cell * n + 18;
      let rx = w * .06;
      tx(c, 'Kiểu hình', rx, by, { size: 9, color: p.sub });
      rx += 52;
      ord.forEach(k => {
        c.fillStyle = col(PH[k].c);
        c.beginPath(); c.arc(rx, by - 3.5, 4, 0, 6.283); c.fill();
        const s2 = cnt[k] + '/' + (n * n) + ' ' + PH[k].t;
        tx(c, s2, rx + 8, by, { size: 9.5, color: PH[k].c, weight: 700 });
        rx += 8 + s2.length * 5.4 + 12;
      });
    }

    const gkeys = Object.keys(gcnt);
    const gtxt = gkeys.length <= 4 ? gkeys.map(k => gcnt[k]).join(' : ') : gkeys.length + ' kiểu';
    ro('pl', cr.nm, p.text);
    ro('so', String(n * n), p.text);
    ro('ti', gtxt, 'var(--accent2)');
    ro('kh', ratio, 'var(--ok)');
  }
},

/* ---------- 19. DI TRUYỀN LIÊN KẾT GIỚI TÍNH ---------- */
{
  icon: 'fa-venus-mars', name: 'Liên kết giới tính', short: 'Gene trên X / Y',
  sub: 'Vì sao bệnh mù màu gặp ở nam nhiều hơn nữ rất nhiều?',
  tags: ['Di truyền', 'Giới tính'],
  note: 'Nam chỉ có <b>một</b> NST X nên mọi gene lặn trên X đều <b>biểu hiện ngay</b> (trạng thái bán hợp tử). Nữ có hai X nên phải mang cả hai allele lặn mới biểu hiện bệnh. Vì vậy bệnh do gene lặn trên X có kiểu "di truyền chéo": mẹ mang gene → con trai mắc bệnh.',
  v: { cross: 0 },
  controls: [{ type: 'seg', k: 'cross', label: 'Phép lai', opts: [[0, 'XᴬXᵃ × XᴬY'], [1, 'XᵃXᵃ × XᴬY'], [2, 'XᴬXᴬ × XᵃY'], [3, 'XX × XYᵃ']] }],
  readouts: [['trai', 'Con trai bệnh'], ['gai', 'Con gái bệnh'], ['ti', 'Tỉ lệ chung'], ['kl', 'Kết luận']],
  draw(c, w, h, t) {
    const p = P(), v = this.v;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    const CR = [
      { m: ['Xᴬ', 'Xᵃ'], d: ['Xᴬ', 'Y'], nm: 'XᴬXᵃ × XᴬY' },
      { m: ['Xᵃ', 'Xᵃ'], d: ['Xᴬ', 'Y'], nm: 'XᵃXᵃ × XᴬY' },
      { m: ['Xᴬ', 'Xᴬ'], d: ['Xᵃ', 'Y'], nm: 'XᴬXᴬ × XᵃY' },
      { m: ['X', 'X'], d: ['X', 'Yᵃ'], nm: 'XX × XYᵃ' }
    ];
    const cr = CR[v.cross];

    function chromX(x, y, s, allele) {
      c.strokeStyle = '#38bdf8';
      c.lineWidth = Math.max(3.2, s * .17); c.lineCap = 'round';
      c.beginPath(); c.moveTo(x - s * .46, y - s * .60); c.lineTo(x + s * .46, y + s * .60); c.stroke();
      c.beginPath(); c.moveTo(x + s * .46, y - s * .60); c.lineTo(x - s * .46, y + s * .60); c.stroke();
      c.fillStyle = '#fbbf24';
      c.beginPath(); c.arc(x, y, s * .13, 0, 6.283); c.fill();
      if (allele) {
        c.fillStyle = allele === 'a' ? '#fb7185' : '#34d399';
        c.beginPath(); c.arc(x + s * .40, y - s * .53, s * .16, 0, 6.283); c.fill();
        c.strokeStyle = 'rgba(0,0,0,.35)'; c.lineWidth = 1; c.stroke();
      }
    }
    function chromY(x, y, s, allele) {
      c.strokeStyle = '#a99cf9';
      c.lineWidth = Math.max(3.2, s * .17); c.lineCap = 'round';
      c.beginPath(); c.moveTo(x - s * .22, y - s * .58); c.lineTo(x - s * .22, y + s * .28);
      c.lineTo(x + s * .30, y + s * .58); c.stroke();
      c.fillStyle = '#fbbf24';
      c.beginPath(); c.arc(x - s * .22, y - s * .10, s * .12, 0, 6.283); c.fill();
      if (allele) {
        c.fillStyle = allele === 'a' ? '#fb7185' : '#34d399';
        c.beginPath(); c.arc(x + s * .26, y + s * .50, s * .16, 0, 6.283); c.fill();
        c.strokeStyle = 'rgba(0,0,0,.35)'; c.lineWidth = 1; c.stroke();
      }
    }

    const lw = 38;
    const cell = Math.min((w - lw - w * .10) / 2, (h - h * .30) / 2);
    const blockW = cell * 2 + lw;
    const gx = (w - blockW) / 2 + lw, gy = h * .175;

    chipText(c, cr.nm, w * .5, h * .075, { color: 'var(--accent2)', size: 9.5, align: 'center' });

    for (let j = 0; j < 2; j++) {
      tx(c, cr.d[j], gx + cell * (j + .5), gy - 10, { size: 12, color: '#a99cf9', align: 'center', weight: 700, mono: true });
    }
    for (let i = 0; i < 2; i++) {
      tx(c, cr.m[i], gx - 10, gy + cell * (i + .5) + 4, { size: 12, color: '#38bdf8', align: 'right', weight: 700, mono: true });
    }
    tx(c, 'trứng ♀ (hàng)', gx - lw + 2, gy + cell * 2 / 2, { size: 8, color: p.sub, align: 'center' });
    tx(c, 'tinh trùng ♂ (cột)', gx + cell, gy - 28, { size: 8, color: p.sub, align: 'center' });

    let maleTot = 0, maleBad = 0, femTot = 0, femBad = 0, badTot = 0;
    for (let i = 0; i < 2; i++) {
      for (let j = 0; j < 2; j++) {
        const egg = cr.m[i], sperm = cr.d[j];
        const male = sperm.indexOf('Y') === 0;
        const eggA = egg.indexOf('ᵃ') >= 0, spermA = sperm.indexOf('ᵃ') >= 0;
        // nữ chỉ bệnh khi CẢ HAI X đều mang allele lặn; nam bệnh khi X (hoặc Y) mang allele lặn
        const bad = male ? (eggA || spermA) : (eggA && spermA);
        const carrier = !male && !bad && (eggA || spermA);
        if (male) { maleTot++; if (bad) maleBad++; } else { femTot++; if (bad) femBad++; }
        if (bad) badTot++;

        const x = gx + cell * j, y = gy + cell * i;
        rr(c, x + 2, y + 2, cell - 4, cell - 4, Math.min(10, cell * .14));
        c.fillStyle = bad ? 'rgba(251,113,133,.14)' : carrier ? 'rgba(251,191,36,.12)' : 'rgba(52,211,153,.11)';
        c.fill();
        c.strokeStyle = bad ? 'rgba(251,113,133,.6)' : carrier ? 'rgba(251,191,36,.55)' : 'rgba(52,211,153,.45)';
        c.lineWidth = 1.4; c.stroke();

        const s = Math.min(cell * .23, 24);
        const cxp = x + cell / 2, cyp = y + cell * .30;
        chromX(cxp - cell * .16, cyp, s, eggA ? 'a' : (egg.indexOf('ᴬ') >= 0 ? 'A' : null));
        if (male) chromY(cxp + cell * .16, cyp, s, spermA ? 'a' : null);
        else chromX(cxp + cell * .16, cyp, s, spermA ? 'a' : (sperm.indexOf('ᴬ') >= 0 ? 'A' : null));

        tx(c, male ? '♂' : '♀', cxp, y + cell * .60, {
          size: Math.min(17, cell * .20), color: male ? '#38bdf8' : '#f472b6', align: 'center', weight: 700
        });
        tx(c, bad ? 'BỆNH' : 'bình thường', x + cell / 2, y + cell * .79, {
          size: Math.min(10, cell * .115), color: bad ? 'var(--bad)' : 'var(--ok)', align: 'center', weight: 700
        });
        if (carrier) {
          tx(c, 'mang gene', x + cell / 2, y + cell * .91, { size: Math.min(9, cell * .10), color: 'var(--warn)', align: 'center', weight: 700 });
        }
      }
    }

    const mb = maleTot ? maleBad / maleTot * 100 : 0;
    const fb = femTot ? femBad / femTot * 100 : 0;
    ro('trai', mb.toFixed(0) + '%', mb > 0 ? 'var(--bad)' : 'var(--ok)');
    ro('gai', fb.toFixed(0) + '%', fb > 0 ? 'var(--bad)' : 'var(--ok)');
    ro('ti', (4 - badTot) + ' BT : ' + badTot + ' bệnh', badTot ? 'var(--warn)' : 'var(--ok)');
    ro('kl', v.cross === 0 ? 'Mẹ mang gene → ½ con trai bệnh'
      : v.cross === 1 ? 'Mẹ bệnh → 100% con trai bệnh'
      : v.cross === 2 ? 'Bố bệnh → con trai KHÔNG bệnh'
      : 'Gene trên Y: cha → 100% con trai', p.text);
  }
},

/* ---------- 20. CẤU TRÚC NHIỄM SẮC THỂ ---------- */
{
  icon: 'fa-dna', name: 'Cấu trúc nhiễm sắc thể', short: 'Bốn bậc xoắn',
  sub: 'Sợi DNA dài gần 2 m gói vừa vào nhân tế bào 6 μm bằng cách nào?',
  tags: ['Nhiễm sắc thể', 'Đóng gói DNA'],
  note: 'DNA được nén qua <b>bốn bậc</b>: chuỗi xoắn kép 2 nm → nucleosome 11 nm → sợi solenoid 30 nm → vòng 300 nm → chromatid 700 nm. Tổng hệ số nén khoảng <b>10 000 lần</b>. Mức cuộn càng chặt thì gene càng khó phiên mã — đó là cách tế bào "khoá" những gene không cần dùng.',
  v: { lvl: 0 },
  controls: [{ type: 'seg', k: 'lvl', label: 'Bậc cấu trúc', opts: [[0, 'DNA 2nm'], [1, '11nm'], [2, '30nm'], [3, '300nm'], [4, 'Chromatid']] }],
  readouts: [['muc', 'Bậc'], ['duong', 'Đường kính'], ['nen', 'Hệ số nén'], ['y', 'Ý nghĩa']],
  draw(c, w, h, t) {
    const p = P(), v = this.v, L = v.lvl;
    c.fillStyle = vgrad(c, 0, 0, h, p.bg2, p.bg); c.fillRect(0, 0, w, h);

    const cy = h * .40, capY = h * .80;

    if (L === 0) {
      const x0 = w * .09, x1 = w * .91, amp = h * .165, lam = w * .085;
      for (const off of [0, Math.PI]) {
        c.beginPath();
        for (let x = x0; x <= x1; x += 2.5) {
          const y = cy + Math.sin((x - x0) / lam + t * 1.5 + off) * amp;
          x === x0 ? c.moveTo(x, y) : c.lineTo(x, y);
        }
        c.strokeStyle = off ? '#3ddc97' : '#38bdf8';
        c.lineWidth = 4; c.lineCap = 'round'; c.stroke();
      }
      for (let x = x0; x <= x1; x += lam / 4) {
        const y1 = cy + Math.sin((x - x0) / lam + t * 1.5) * amp;
        const y2 = cy + Math.sin((x - x0) / lam + t * 1.5 + Math.PI) * amp;
        c.strokeStyle = 'rgba(170,205,230,.30)'; c.lineWidth = 1.5;
        c.beginPath(); c.moveTo(x, y1); c.lineTo(x, y2); c.stroke();
      }
      // thước đo 2 nm
      c.strokeStyle = p.sub; c.lineWidth = 1.2;
      c.beginPath(); c.moveTo(w * .09, cy + amp + 14); c.lineTo(w * .09 + 42, cy + amp + 14); c.stroke();
      c.beginPath(); c.moveTo(w * .09, cy + amp + 10); c.lineTo(w * .09, cy + amp + 18); c.stroke();
      c.beginPath(); c.moveTo(w * .09 + 42, cy + amp + 10); c.lineTo(w * .09 + 42, cy + amp + 18); c.stroke();
      tx(c, '2 nm', w * .09 + 48, cy + amp + 18, { size: 9, color: p.sub, mono: true });
    }

    if (L === 1) {
      const n = 5, gap = (w * .78) / n, R2 = Math.min(h * .082, gap * .30);
      c.strokeStyle = 'rgba(56,189,248,.55)'; c.lineWidth = 2.4;
      c.beginPath();
      for (let i = 0; i < n; i++) {
        const bx = w * .11 + gap * (i + .5), by = cy + Math.sin(i * 1.05) * h * .03;
        i ? c.lineTo(bx, by) : c.moveTo(bx, by);
      }
      c.stroke();
      for (let i = 0; i < n; i++) {
        const bx = w * .11 + gap * (i + .5), by = cy + Math.sin(i * 1.05) * h * .03;
        c.beginPath();
        for (let a = -1.1; a <= 4.3; a += .09) {
          const rr3 = R2 * 1.32;
          const x = bx + Math.cos(a + t * .9 + i) * rr3;
          const y = by + Math.sin(a + t * .9 + i) * rr3 * .78;
          a === -1.1 ? c.moveTo(x, y) : c.lineTo(x, y);
        }
        c.strokeStyle = '#38bdf8'; c.lineWidth = 2.6; c.stroke();
        const gh = c.createRadialGradient(bx - R2 * .3, by - R2 * .35, R2 * .1, bx, by, R2);
        gh.addColorStop(0, '#a99cf9'); gh.addColorStop(1, '#4c3fa8');
        c.beginPath(); c.arc(bx, by, R2, 0, 6.283); c.fillStyle = gh; c.fill();
        c.strokeStyle = 'rgba(200,190,255,.35)'; c.lineWidth = 1; c.stroke();
      }
    }

    if (L === 2) {
      const n = 16;
      for (let i = 0; i < n; i++) {
        const u = i / (n - 1);
        const x = w * .18 + u * w * .64;
        const ph = u * Math.PI * 3.4 + t * 1.0;
        const y = cy + Math.sin(ph) * h * .145;
        const z = Math.cos(ph);
        const r2 = Math.min(h * .046, w * .024) * (.70 + .32 * (z + 1) / 2);
        c.globalAlpha = .5 + .5 * (z + 1) / 2;
        const gh = c.createRadialGradient(x - r2 * .3, y - r2 * .3, r2 * .1, x, y, r2);
        gh.addColorStop(0, '#a99cf9'); gh.addColorStop(1, '#4c3fa8');
        c.beginPath(); c.arc(x, y, r2, 0, 6.283); c.fillStyle = gh; c.fill();
        c.globalAlpha = 1;
      }
    }

    if (L === 3) {
      c.strokeStyle = 'rgba(251,191,36,.7)'; c.lineWidth = 6; c.lineCap = 'round';
      c.beginPath(); c.moveTo(w * .5, h * .14); c.lineTo(w * .5, h * .78); c.stroke();
      for (let i = 0; i < 7; i++) {
        const y = h * .18 + i * h * .09;
        const side = i % 2 ? 1 : -1;
        c.beginPath();
        c.moveTo(w * .5, y);
        c.bezierCurveTo(w * .5 + side * w * .26, y - h * .12, w * .5 + side * w * .30, y + h * .10, w * .5, y + h * .05);
        c.strokeStyle = i % 2 ? '#38bdf8' : '#3ddc97';
        c.lineWidth = 2.6; c.stroke();
      }
    }

    if (L === 4) {
      const cxp = w * .5, top = h * .13, mid = h * .44, bot = h * .76;
      const dx = w * .115;
      const breathe = 1 + .02 * Math.sin(t * 1.4);
      for (const sgn of [-1, 1]) {
        c.beginPath();
        c.moveTo(cxp + sgn * dx * breathe, top);
        c.quadraticCurveTo(cxp + sgn * dx * .34, mid - h * .05, cxp, mid);
        c.quadraticCurveTo(cxp + sgn * dx * .34, mid + h * .05, cxp + sgn * dx * breathe, bot);
        c.strokeStyle = sgn < 0 ? '#3ddc97' : '#38bdf8';
        c.lineWidth = 11; c.lineCap = 'round'; c.stroke();
        for (let i = 0; i < 5; i++) {
          const u = .16 + i * .17;
          const yy = top + (mid - top) * u;
          const xx = cxp + sgn * dx * (1 - u * .66);
          c.strokeStyle = root.dataset.theme === 'light' ? 'rgba(255,255,255,.55)' : 'rgba(10,20,30,.45)';
          c.lineWidth = 11;
          c.beginPath(); c.moveTo(xx - 3.2, yy); c.lineTo(xx + 3.2, yy); c.stroke();
        }
      }
      glow(c, cxp, mid, w * .055, 'rgba(251,191,36,.32)');
      c.fillStyle = '#fbbf24';
      c.beginPath(); c.arc(cxp, mid, Math.min(9, w * .017), 0, 6.283); c.fill();
      chipText(c, 'tâm động', cxp + w * .035, mid, { color: 'var(--warn)', size: 8 });
    }

    /* chú thích dưới */
    const CAP = [
      'chuỗi xoắn kép • gene tự do phiên mã',
      '8 histone + 146 cặp nucleotide = 1 nucleosome',
      'sợi solenoid • 6 nucleosome mỗi vòng',
      'khung protein + vòng xoắn 300 nm',
      '2 chromatid chị em • NST kỳ giữa'
    ];
    const capYs = [cy + h * .245, cy + h * .20, cy + h * .225, h * .82, h * .86];
    chipText(c, CAP[L], w * .5, capYs[L], { color: p.sub, size: 8.5, align: 'center' });

    /* thanh tiến trình 4 bậc */
    const barY = h - 42, bw = w * .30, bx = w * .06;
    rr(c, bx, barY, bw, 4, 2); c.fillStyle = p.line; c.fill();
    rr(c, bx, barY, bw * (L + 1) / 5, 4, 2); c.fillStyle = col('var(--accent)'); c.fill();

    const NM = ['DNA xoắn kép', 'Nucleosome', 'Sợi solenoid', 'Vòng xoắn', 'Chromatid'];
    const DU = ['2 nm', '11 nm', '30 nm', '300 nm', '700 nm'];
    const NE = ['×1', '×7', '×40', '×1 000', '×10 000'];
    const YN = ['Chưa đóng gói — phiên mã mạnh', 'Bậc 1 — DNA quấn histone', 'Bậc 2 — sợi 30 nm', 'Bậc 3 — vòng gắn khung', 'Kỳ giữa — gene bị bất hoạt'];
    ro('muc', NM[L], p.text);
    ro('duong', DU[L], 'var(--accent2)');
    ro('nen', NE[L], 'var(--accent)');
    ro('y', YN[L], L >= 4 ? 'var(--bad)' : L === 0 ? 'var(--ok)' : 'var(--warn)');
  }
}
];

/* =========================================================
   11b. NỘI DUNG BỔ SUNG
   Trích và thiết kế lại từ 3 đề: "ĐỀ RÈN LUYỆN 3 - 12",
   "HSG Hải Phòng 24-25", "ĐỀ 04 — DTPT & ĐB GENE".
   Toàn bộ nội dung cũ được GIỮ NGUYÊN, chỉ bổ sung.
   ========================================================= */
const EXT_MCQ = [
  /* ---- Đề 1: cấu trúc & cơ chế di truyền phân tử ---- */
  { t:'dt', q:'Người đầu tiên công bố mô hình cấu trúc không gian của DNA là:', o:['Sacrap (Chargaff)','J. Watson và F. Crick','Pavlov','Morgan'], a:1,
    tip:'Watson – Crick, 1953, dựa trên ảnh nhiễu xạ tia X của Franklin.', why:'Mô hình chuỗi xoắn kép với hai mạch đối song, các base bắt cặp bổ sung ở phía trong, khung đường – phosphate ở phía ngoài.', trap:'Chargaff chỉ đưa ra quy luật tỉ lệ base, không dựng mô hình không gian.' },
  { t:'dt', q:'Ở cấp độ phân tử, thông tin di truyền được truyền từ tế bào mẹ sang tế bào con nhờ cơ chế:', o:['Giảm phân và thụ tinh','Tái bản DNA','Phiên mã','Dịch mã'], a:1,
    tip:'Truyền dọc trong dòng tế bào = tái bản DNA.', why:'Tái bản tạo hai phân tử DNA giống hệt bản gốc rồi chia cho hai tế bào con, nên toàn bộ thông tin được bảo toàn.', trap:'Giảm phân + thụ tinh truyền thông tin giữa các thế hệ cơ thể, không phải giữa tế bào mẹ và tế bào con trong cùng cơ thể.' },
  { t:'dt', q:'Đơn phân chỉ có ở RNA mà không có ở DNA là:', o:['Guanine','Adenine','Thymine','Uracil'], a:3,
    tip:'RNA dùng U thay cho T.', why:'Uracil bắt cặp với adenine nhưng không có nhóm methyl ở vị trí 5 như thymine.', trap:'Nghĩ RNA "không có T" là đúng, nhưng đơn phân RIÊNG của RNA phải là U.' },
  { t:'dt', q:'Quá trình tái bản DNA được thực hiện theo nguyên tắc nào?', o:['Nguyên tắc bổ sung và nguyên tắc bán bảo toàn','Nguyên tắc bán bảo toàn và nửa gián đoạn','Nguyên tắc khuôn mẫu và nửa gián đoạn','Nửa gián đoạn và nguyên tắc bổ sung'], a:0,
    tip:'Hai nguyên tắc nền tảng: bổ sung + bán bảo toàn.', why:'Bổ sung bảo đảm trình tự chính xác; bán bảo toàn bảo đảm mỗi DNA con giữ một mạch gốc. Nửa gián đoạn chỉ là hệ quả của chiều tổng hợp.', trap:'Nửa gián đoạn là ĐẶC ĐIỂM, không phải nguyên tắc.' },
  { t:'dt', q:'Loại enzyme trực tiếp tham gia phiên mã các gene cấu trúc ở sinh vật nhân sơ là:', o:['Ligase','Restricrase','RNA polymerase','DNA polymerase'], a:2,
    tip:'Phiên mã = RNA polymerase.', why:'RNA polymerase vừa tháo xoắn cục bộ vừa gắn ribonucleotide bổ sung với mạch gốc theo chiều 5′→3′.', trap:'Nhân sơ chỉ có MỘT loại RNA polymerase làm cả ba việc; nhân thực có ba loại I, II, III.' },
  { t:'dt', q:'Vùng kết thúc của gene có đặc điểm:', o:['Mang tín hiệu khởi động phiên mã','Mang tín hiệu kết thúc phiên mã','Quy định trình tự acid amin','Mang thông tin mã hóa acid amin'], a:1,
    tip:'Tên gọi đã nói lên chức năng.', why:'Trình tự nucleotide đặc biệt ở vùng kết thúc làm RNA polymerase dừng lại và tách khỏi khuôn.', trap:'Tín hiệu khởi động nằm ở vùng điều hòa (promoter).' },
  { t:'dt', q:'Chiều của mạch khuôn dùng để tổng hợp mRNA và chiều tổng hợp mRNA lần lượt là:', o:['5′→3′ và 5′→3′','3′→5′ và 3′→5′','5′→3′ và 3′→5′','3′→5′ và 5′→3′'], a:3,
    tip:'Khuôn đọc 3′→5′, mRNA mọc 5′→3′.', why:'RNA polymerase chỉ gắn nucleotide vào đầu 3′-OH tự do nên mạch mới luôn dài ra theo 5′→3′, buộc phải trượt trên khuôn theo 3′→5′.', trap:'Hai chiều luôn NGƯỢC nhau, không bao giờ cùng chiều.' },
  { t:'dt', q:'Giả sử một gene chỉ cấu tạo từ 3 loại nucleotide A, T, G. Trên mạch gốc của gene này có tối đa bao nhiêu loại bộ ba?', o:['6','3','27','9'], a:2,
    tip:'3 vị trí × 3 lựa chọn = 3³.', why:'Mỗi vị trí trong bộ ba độc lập chọn 1 trong 3 loại nucleotide nên có 27 tổ hợp.', trap:'Đáp án 9 là nhầm sang 3² — bộ ba có 3 vị trí chứ không phải 2.' },
  { t:'dt', q:'Bộ ba đối mã (anticodon) của tRNA vận chuyển methionine ở sinh vật nhân thực là:', o:['3′UAC5′','3′AUG5′','5′AUG3′','5′CAU3′'], a:0,
    tip:'Codon Met = 5′AUG3′ ⇒ anticodon đối song bổ sung = 3′UAC5′.', why:'Anticodon phải vừa bổ sung vừa đối chiều với codon: A–U, U–A, G–X.', trap:'Chọn 3′AUG5′ là quên đổi A→U; chọn 5′CAU3′ là đảo sai chiều.' },
  { t:'dt', q:'Điểm giống nhau giữa phiên mã và dịch mã ở sinh vật nhân thực là:', o:['Đều diễn ra trong nhân tế bào','Đều thực hiện theo nguyên tắc bổ sung','Đều có sự tham gia của RNA polymerase','Đều diễn ra đồng thời với tái bản DNA'], a:1,
    tip:'Cả hai đều có bắt cặp base.', why:'Phiên mã bắt cặp ribonucleotide với mạch gốc; dịch mã bắt cặp anticodon với codon. Cả hai đều là quá trình khuôn mẫu.', trap:'Dịch mã diễn ra ở tế bào chất; dịch mã không dùng RNA polymerase.' },
  { t:'dt', q:'Một chủng virut có thành phần nucleotide: 22%A, 22%T, 28%G, 28%X. Vật chất di truyền của chủng này là:', o:['DNA mạch kép','DNA mạch đơn','RNA mạch kép','RNA mạch đơn'], a:0,
    tip:'Có T ⇒ DNA. A = T và G = X ⇒ mạch kép.', why:'Chỉ DNA mới có thymine. Sự bằng nhau từng cặp A = T, G = X chỉ xảy ra khi hai mạch bổ sung nhau.', trap:'Nếu chỉ có A, U, G, X thì mới là RNA; nếu A ≠ T thì đó là DNA mạch đơn.' },
  { t:'dt', q:'Trên mỗi phân tử DNA của sinh vật, đặc điểm đúng là:', o:['Mang một RNA, mỗi RNA một vị trí xác định','Mang một gene, mỗi gene một vị trí xác định','Mang nhiều tRNA, mỗi tRNA một vị trí xác định','Mang nhiều gene, mỗi gene một vị trí xác định'], a:3,
    tip:'DNA là “bộ sách”, gene là “trang”.', why:'Mỗi phân tử DNA mang hàng trăm đến hàng nghìn gene, mỗi gene chiếm một locus cố định trên nhiễm sắc thể.', trap:'Một DNA chỉ mang một gene là hiểu sai ở mức độ phân tử.' },
  { t:'dt', q:'Mạch gốc của một gene ở vi khuẩn có trình tự 5′AGC CGA CCC GGG 3′. Biết GGG–Gly, CCC–Pro, GCU–Ala, CGA–Arg, UCG–Ser. Đoạn polypeptide được dịch mã là:', o:['Pro – Gly – Ser – Ala','Ser – Ala – Gly – Pro','Gly – Pro – Ser – Arg','Ser – Arg – Pro – Gly'], a:0,
    tip:'Viết mRNA đối song trước, rồi mới đọc codon 5′→3′.', why:'mRNA = 3′UCG GCU GGG CCC 5′, tức 5′CCC GGG UCG GCU 3′ ⇒ Pro – Gly – Ser – Ala.', trap:'Đọc thẳng trên mạch gốc sẽ ra Ser – Ala – Gly – Pro — một phương án nhiễu rất dễ chọn, đây là bẫy phổ biến nhất.' },
  { t:'dt', q:'Chất 5-BU có khả năng bắt cặp với adenine hoặc guanine, gây đột biến:', o:['Thay thế cặp A–T bằng G–C','Thay thế cặp A–T bằng C–G','Thay thế cặp G–C bằng A–T','Thay thế cặp G–C bằng T–A'], a:0,
    tip:'5-BU "đổi phe" từ chỗ đứng với A sang đứng với G.', why:'Lần sao chép đầu, 5-BU (dạng T) bắt cặp A; lần sau nó chuyển dạng và bắt cặp G, kết quả A–T biến thành G–C.', trap:'Không thể tạo C–G vì 5-BU không bắt cặp với cytosine.' },
  { t:'dt', q:'Điểm khác nhau cơ bản giữa tái bản DNA ở sinh vật nhân thực và nhân sơ là:', o:['Số lượng đơn vị nhân đôi','Nguyên liệu dùng để tổng hợp','Chiều tổng hợp mạch mới','Nguyên tắc nhân đôi'], a:0,
    tip:'Nhân thực: nhiều đơn vị nhân đôi cùng lúc.', why:'DNA nhân thực rất dài nên phải có nhiều điểm khởi đầu (origin) để rút ngắn thời gian, nhân sơ chỉ có một origin vòng.', trap:'Chiều tổng hợp và nguyên tắc bổ sung/bán bảo toàn thì GIỐNG nhau ở cả hai.' },
  { t:'dt', q:'Gene B ở sinh vật nhân thực có 2400 nucleotide, trong đó A gấp 3 lần G. Đột biến điểm làm gene B thành alelle b: chiều dài không đổi nhưng giảm 1 liên kết hydrogen. Số nucleotide từng loại của b là:', o:['A = T = 899, G = C = 301','A = T = 299, G = C = 901','A = T = 901, G = C = 299','A = T = 301, G = C = 899'], a:2,
    tip:'Chiều dài không đổi ⇒ thay thế. Giảm 1 H ⇒ thay G–C (3H) bằng A–T (2H).', why:'A + G = 1200 và A = 3G ⇒ G = 300, A = 900. Thay 1 cặp G–C bằng A–T: G giảm 1 còn 299, A tăng 1 thành 901, tổng H giảm đúng 1.', trap:'Nếu tăng 1 H thì chiều đổi ngược lại (A–T → G–C).' },
  { t:'dt', q:'Một gene phiên mã 5 lần liên tiếp sẽ tạo ra bao nhiêu phân tử mRNA?', o:['1','5','10','25'], a:1,
    tip:'Mỗi lần phiên mã = một bản sao.', why:'Gene không bị tiêu hao sau phiên mã nên 5 lần phiên mã cho 5 mRNA độc lập.', trap:'Không nhân đôi số lượng vì mỗi mRNA chỉ phiên mã từ một mạch khuôn.' },
  { t:'dt', q:'Trong các thành phần sau: gene, mRNA, acid amin, tRNA, ribosome — có bao nhiêu thành phần tham gia TRỰC TIẾP vào tổng hợp chuỗi polypeptide?', o:['3','4','5','2'], a:1,
    tip:'Gene không trực tiếp — chỉ mRNA mới vào ribosome.', why:'Trực tiếp gồm mRNA (khuôn), acid amin (nguyên liệu), tRNA (vận chuyển), ribosome (bộ máy) = 4. Gene là bản gốc gián tiếp.', trap:'Đếm cả gene sẽ ra 5 — đây chính là cái bẫy “trực tiếp”.' },
  { t:'dt', q:'Ở sinh vật nhân thực, mRNA sơ khai có chiều dài bằng:', o:['Chiều dài vùng mã hóa của gene','Một nửa chiều dài gene','Chiều dài của một exon','Chiều dài vùng điều hòa'], a:0,
    tip:'Vùng mã hóa gồm cả exon và intron.', why:'RNA polymerase phiên mã toàn bộ vùng mã hóa nên mRNA sơ khai chứa cả intron; sau đó splicing cắt intron mới thành mRNA trưởng thành ngắn hơn.', trap:'Dễ nhầm "vùng mã hóa" chỉ là exon — thực ra exon + intron.' },
  { t:'dt', q:'Một gene có 3000 nucleotide, trong đó G = 30%. Sau đột biến thay thế 1 cặp A–T bằng G–C, số liên kết hydrogen của gene đột biến là:', o:['3899','3901','3900','3898'], a:1,
    tip:'G = 900, A = 600 ⇒ H = 2×600 + 3×900.', why:'H ban đầu = 1200 + 2700 = 3900. Thay A–T (2H) bằng G–C (3H) làm TĂNG 1 ⇒ 3901.', trap:'Giảm 1 là khi thay G–C bằng A–T.' },
  { t:'dt', q:'Sự kiện nào sau đây xảy ra ở sinh vật nhân thực nhưng KHÔNG xảy ra ở nhân sơ?', o:['Dịch mã tại ribosome','Cắt intron khỏi mRNA sơ khai','Sử dụng tRNA mang acid amin','Hình thành liên kết peptide'], a:1,
    tip:'Chỉ nhân thực mới có intron/exon.', why:'Gene nhân thực phân mảnh nên cần splicing; gene nhân sơ liên tục nên dịch mã được ngay.', trap:'Ba đáp án còn lại là phổ quát cho mọi sinh vật.' },
  { t:'dt', q:'Nếu một đột biến làm mất hoàn toàn bộ ba mở đầu AUG nhưng không ảnh hưởng vùng mã hóa phía sau, hậu quả là:', o:['Chuỗi polypeptide ngắn hơn bình thường','Dịch mã không khởi động được, không có sản phẩm','Chuỗi polypeptide dài hơn bình thường','Không ảnh hưởng gì'], a:1,
    tip:'Không có điểm khởi đầu thì ribosome không lắp ráp.', why:'Ribosome nhận diện AUG để đặt tiểu phần và bắt đầu dịch mã; mất AUG thì không có khung đọc nào được thiết lập.', trap:'Không phải “ngắn hơn” — mà là không dịch mã được.' },
  { t:'dt', q:'Trong một chạc tái bản, enzyme nào tổng hợp đoạn mồi RNA?', o:['DNA polymerase III','Primase','Ligase','Helicase'], a:1,
    tip:'Primase = enzyme tổng hợp primer.', why:'Primase là RNA polymerase chuyên dụng, tạo đoạn mồi ngắn có đầu 3′-OH để DNA polymerase bám vào và kéo dài.', trap:'DNA polymerase không thể khởi đầu de novo nên cần primase.' },
  { t:'dt', q:'Hai phân tử DNA con sau tái bản bán bảo toàn, mỗi phân tử gồm:', o:['Hai mạch hoàn toàn mới','Một mạch cũ và một mạch mới','Hai mạch cũ','Một mạch cũ hoặc hai mạch mới tùy vị trí'], a:1,
    tip:'“Bán bảo toàn” = giữ lại một nửa.', why:'Mỗi mạch gốc làm khuôn cho một mạch mới, nên mỗi DNA con luôn có đúng một mạch của mẹ.', trap:'Đây là bằng chứng của thí nghiệm Meselson – Stahl với N¹⁵.' },
  { t:'dt', q:'Một mRNA có 600 nucleotide, trong đó vùng không dịch mã hai đầu chiếm 60 nucleotide. Chuỗi polypeptide (CHƯA cắt Met) có bao nhiêu acid amin?', o:['178','179','180','181'], a:1,
    tip:'(600 − 60)/3 = 180 codon, trừ 1 codon kết thúc.', why:'180 codon nhưng codon cuối là bộ ba kết thúc không mã hóa acid amin, nên còn 179 acid amin tính cả Met mở đầu.', trap:'Nếu đề hỏi chuỗi đã cắt Met thì đáp án là 178.' },
  { t:'dt', q:'Enzyme có vai trò nối các đoạn Okazaki lại thành mạch liên tục là:', o:['Helicase','DNA polymerase I','Ligase','Topoisomerase'], a:2,
    tip:'Ligase tạo liên kết phosphodiester giữa hai đoạn.', why:'Sau khi DNA polymerase I thay đoạn mồi RNA bằng DNA, vẫn còn khoảng trống giữa hai đoạn; ligase nối kín lại.', trap:'DNA polymerase I chỉ thay mồi, không nối hai đoạn rời.' },
  { t:'dt', q:'Tính đặc hiệu của mã di truyền được hiểu là:', o:['Nhiều bộ ba cùng mã hóa một acid amin','Một bộ ba chỉ mã hóa một acid amin','Mọi loài dùng chung một bộ mã','Một acid amin do một bộ ba mã hóa'], a:1,
    tip:'Đặc hiệu = 1 codon → 1 acid amin.', why:'Không có bộ ba nào mã hóa hai acid amin khác nhau, nhờ đó trình tự codon xác định chính xác trình tự protein.', trap:'"Nhiều codon → 1 acid amin" là tính thoái hóa; "mọi loài chung bộ mã" là tính phổ biến.' },
  { t:'dt', q:'Đột biến gen ở tế bào sinh dưỡng của một cây được truyền cho thế hệ sau qua con đường nào?', o:['Sinh sản hữu tính','Sinh sản vô tính','Không bao giờ truyền được','Chỉ qua thụ tinh'], a:1,
    tip:'Sinh sản vô tính tạo cơ thể từ tế bào sinh dưỡng.', why:'Vì cơ thể mới được tạo trực tiếp từ tế bào mang đột biến nên đột biến có mặt trong toàn bộ cơ thể con.', trap:'Sinh sản hữu tính chỉ truyền đột biến phát sinh trong tế bào sinh dục.' },

  /* ---- Đề 2 (HSG Hải Phòng 24–25): câu khó, trọng suy luận ---- */
  { t:'ql', q:'Bốn giống lúa có khối lượng 1000 hạt: giống 1 (200–300 g), giống 2 (220–310 g), giống 3 (240–335 g), giống 4 (270–325 g). Giống có mức phản ứng rộng nhất là:', o:['Giống số 1','Giống số 2','Giống số 3','Giống số 4'], a:0,
    tip:'Mức phản ứng = biên độ dao động = max − min.', why:'Giống 1: 300 − 200 = 100 g (rộng nhất). Giống 2: 90 g; giống 3: 95 g; giống 4: 55 g. Mức phản ứng càng rộng thì kiểu hình càng dẻo trước môi trường.', trap:'Nhầm "khối lượng tối đa cao nhất" (giống 3) với "mức phản ứng rộng nhất".' },
  { t:'ql', q:'Ví dụ nào sau đây KHÔNG phải là thường biến?', o:['Trẻ bị phenylketonuria ăn kiêng sớm thì phát triển bình thường','Hoa phù dung trắng buổi sáng, hồng buổi chiều','Cây hoa bốn giờ lá khảm sinh ra con có lá xanh, trắng và khảm','Cáo bắc cực lông dày trắng mùa đông, thưa sẫm mùa hè'], a:2,
    tip:'Thường biến = biến đổi kiểu hình, KHÔNG đổi kiểu gene, không di truyền.', why:'Lá khảm do đột biến ở lục lạp (di truyền tế bào chất) nên con sinh ra đã khác mẹ về kiểu gene — đó là đột biến, không phải thường biến.', trap:'Hai ví dụ còn lại đều là phản ứng kiểu hình thuần túy trước môi trường.' },
  { t:'nst', q:'Phát biểu đúng về nhiễm sắc thể là:', o:['Số lượng NST nhiều hay ít phản ánh mức độ tiến hóa của loài','Thành phần hóa học của NST ở nhân thực là RNA và protein histone','NST là vật chất di truyền đặc trưng cho loài ở cấp độ phân tử','NST điều hòa hoạt động của các gene thông qua các mức cuộn xoắn'], a:3,
    tip:'Mức cuộn xoắn quyết định gene có được phiên mã hay không.', why:'Vùng chromatin cuộn chặt (dị nhiễm sắc) thì gene bị bất hoạt; vùng duỗi xoắn (ơ nhiễm sắc) thì gene hoạt động mạnh.', trap:'Thành phần NST là DNA + histone (không phải RNA); số lượng NST không phản ánh mức tiến hóa.' },
  { t:'dv', q:'Khi nói về tiêu hóa ở động vật, nhận định đúng là:', o:['Tiêu hóa nội bào chỉ gặp ở nhóm chưa có hệ tiêu hóa','Tiêu hóa ngoại bào chỉ gặp ở động vật có xương sống','Ở động vật có túi tiêu hóa, thức ăn được tiêu hóa ngoại bào trong túi tiêu hóa','Ở động vật đơn bào, thức ăn được tiêu hóa nội bào trong lysosome'], a:2,
    tip:'Túi tiêu hóa = khoang tiêu hóa ngoại bào đầu tiên.', why:'Thức ăn vào túi, enzyme tiết vào túi phân giải thức ăn ngoài tế bào, rồi tế bào thành túi hấp thụ.', trap:'Ở đơn bào, tiêu hóa diễn ra trong KHÔNG BÀO tiêu hóa (thành lập từ lysosome), không phải "trong lysosome" theo nghĩa bào quan riêng lẻ.' },
  { t:'ql', q:'Đặc điểm di truyền của quần thể tự thụ phấn là:', o:['Kiểu gene phân hóa thành các dòng thuần khác nhau','Độ đa dạng di truyền cao hơn quần thể giao phấn ngẫu nhiên','Tần số allele lặn tăng, allele trội giảm qua các thế hệ','Tần số allele trội tăng, allele lặn giảm qua các thế hệ'], a:0,
    tip:'Tự thụ làm tăng đồng hợp, nhưng KHÔNG đổi tần số allele.', why:'Mỗi cá thể dần trở thành đồng hợp tử, tách thành nhiều dòng thuần khác nhau; tần số allele giữ nguyên vì không có chọn lọc.', trap:'Ba đáp án còn lại đều nói tần số allele thay đổi — sai về bản chất.' },
  { t:'ql', q:'Một tế bào sinh tinh có kiểu gene AaBbDd (ba cặp NST tương đồng khác nhau) giảm phân bình thường, có hoán vị gene ở một cặp. Số loại tinh trùng tối đa tạo ra là:', o:['8','2','4','6'], a:2,
    tip:'MỘT tế bào sinh tinh tối đa 4 loại (khi có hoán vị), không phải 2ⁿ.', why:'Một tế bào chỉ cho 4 tinh trùng; nếu không hoán vị thì 2 loại, có hoán vị ở một cặp thì 4 loại. Muốn đủ 8 loại phải có nhiều tế bào.', trap:'Công thức 2³ = 8 chỉ đúng cho CƠ THỂ, không đúng cho một tế bào.' },
  { t:'tv', q:'Thí nghiệm hô hấp với 4 bình kín: bình 1 (0,5 kg hạt nhú mầm), bình 2 (1 kg hạt khô), bình 3 (1 kg hạt nhú mầm), bình 4 (1 kg hạt nhú mầm đã luộc). Sau 2 giờ, dự đoán đúng là:', o:['Nồng độ O₂ ở bình 1 và bình 3 đều giảm','Nồng độ O₂ ở cả 4 bình đều tăng','Nhiệt độ ở bình 2 và bình 4 đều tăng','Nhiệt độ ở bình 2 cao hơn bình 3'], a:0,
    tip:'Chỉ hạt sống và đang nảy mầm mới hô hấp mạnh.', why:'Bình 1 và 3 chứa hạt nhú mầm còn sống, hô hấp hút O₂ nên O₂ giảm. Bình 2 hạt khô hô hấp rất yếu; bình 4 hạt luộc đã chết, không hô hấp.', trap:'Bình 4 luộc chín thì enzyme bị biến tính, không có hô hấp — nên nhiệt độ không tăng.' },
  { t:'dv', q:'Que thử nhanh phát hiện Helicobacter pylori dùng kháng nguyên đặc hiệu. Kết quả dương tính xảy ra khi:', o:['Người bệnh nhiễm một chủng vi khuẩn khác vẫn cho màu giống hệt','Không nhiễm H. pylori thì phản ứng dừng ở bước gắn kháng nguyên','Kháng thể trong máu gắn kháng nguyên đặc hiệu, tạo điều kiện cho kháng thể thứ cấp gắn enzyme chuyển chất không màu thành có màu','Không nhiễm H. pylori nhưng máu vẫn có kháng thể nên đổi màu'], a:2,
    tip:'Nguyên lý ELISA sandwich: kháng nguyên – kháng thể 1 – kháng thể 2 gắn enzyme – phản ứng màu.', why:'Màu xuất hiện chỉ khi đủ ba lớp liên kết đặc hiệu; enzyme chuyển cơ chất không màu thành sản phẩm có màu.', trap:'Phương án “nhiễm một chủng vi khuẩn khác vẫn cho màu giống hệt” sai vì kháng thể đặc hiệu không gắn kháng nguyên của loài khác.' },
  { t:'dv', q:'Bệnh động kinh do đột biến gene trong ti thể. Mẹ bị bệnh, bố không bị bệnh, sinh con KHÔNG bị bệnh. Giải thích phù hợp nhất là:', o:['Con nhận gene bình thường từ bố','Gene trong ti thể phân chia không đều cho các tế bào trứng','Mẹ áp dụng chế độ ăn kiêng khi mang thai','Sự biểu hiện gene chịu ảnh hưởng nhiều của môi trường'], a:1,
    tip:'Di truyền ti thể = dòng mẹ, nhưng có hiện tượng "dị tương đồng" phân ly ngẫu nhiên.', why:'Một tế bào chứa cả ti thể đột biến và bình thường; khi phân chia, tỉ lệ ti thể đột biến trong trứng là ngẫu nhiên nên có trứng mang toàn ti thể bình thường.', trap:'Bố không truyền ti thể cho con nên phương án “nhận gene bình thường từ bố” sai về cơ chế.' },
  { t:'nst', q:'Bằng phương pháp nghiên cứu nhiễm sắc thể người, có thể xác định được nhóm bệnh nào sau đây?', o:['Hội chứng Down, hội chứng Turner','Bệnh mù màu, hội chứng Klinefelter','Bệnh bạch tạng, bệnh Parkinson','Hội chứng Turner, bệnh hồng cầu hình liềm'], a:0,
    tip:'Phương pháp NST chỉ thấy bất thường SỐ LƯỢNG hoặc CẤU TRÚC.', why:'Down (3 NST 21) và Turner (45, X0) đều là bất thường số lượng NST nhìn thấy trên karyotype.', trap:'Mù màu, bạch tạng, hồng cầu hình liềm là đột biến GENE — phải dùng phương pháp phân tử.' },
  { t:'nst', q:'Cà độc dược 2n = 24. Một thể đột biến có: một chiếc của cặp I mất đoạn, một chiếc cặp III đảo đoạn, một chiếc cặp V lặp đoạn. Nếu 40% tế bào xảy ra hoán vị ở cặp I thì tỉ lệ giao tử BÌNH THƯỜNG và KHÔNG chứa gene hoán vị là:', o:['15%','20%','10%','5%'], a:2,
    tip:'Ba cặp dị hợp đột biến → (1/2)³; hoán vị 40% → 80% giao tử không hoán vị.', why:'(1/2)³ = 1/8 giao tử bình thường ở cả 3 cặp. Nhân với 0,8 (không hoán vị) = 0,1 = 10%.', trap:'Quên nhân 0,8 sẽ ra 12,5% — không có trong đáp án, dễ bị dẫn sang 15%.' },
  { t:'ql', q:'Ở một loài thực vật, màu hoa do 3 locus tương tác: protein D do gene D tạo ra là điều kiện để enzyme A và B hoạt động; không có sắc tố thì hoa trắng. Nhận định đúng là:', o:['Protein D hoạt hóa đồng thời cả gene A và gene B','Kiểu hình hoa trắng có thể do tối đa 18 loại kiểu gene quy định','Có tối đa 27 loại kiểu gene quy định màu hoa','Cây dị hợp 3 cặp tự thụ cho tối đa 2 loại kiểu hình'], a:0,
    tip:'D là gene điều hòa bậc cao — nó bật cả A và B.', why:'Protein D cần cho hoạt tính của cả enzyme A và B, tức chỉ một sản phẩm gene điều hòa đồng thời hai gene cấu trúc.', trap:'Tính số kiểu gene cần nhớ A và D liên kết trên cùng NST nên không nhân tự do 3³.' },
  { t:'ql', q:'Một quần thể ngẫu phối đang cân bằng có tần số allele A = 0,6. Tỉ lệ kiểu hình lặn là:', o:['0,16','0,36','0,48','0,40'], a:0,
    tip:'Cân bằng Hardy–Weinberg: aa = q².', why:'q = 0,4 ⇒ q² = 0,16. Tỉ lệ kiểu hình lặn đúng bằng tần số kiểu gene aa.', trap:'Nhầm 0,4 (tần số allele) với 0,16 (tần số kiểu gene).' },
  { t:'ql', q:'Ở người, bệnh hói đầu do allele H trên NST thường: Hh hói ở nam nhưng không hói ở nữ. Điều này chứng tỏ:', o:['Gene quy định tính trạng nằm trên NST giới tính','Mức biểu hiện kiểu gene phụ thuộc giới tính','Tính trạng do gene tế bào chất quy định','Đây là thường biến'], a:1,
    tip:'Cùng kiểu gene Hh nhưng hai giới hai kiểu hình.', why:'Đây là tính trạng chịu ảnh hưởng của giới tính (sex-influenced): nội tiết tố tạo môi trường biểu hiện khác nhau dù gene nằm trên NST thường.', trap:'Không phải di truyền liên kết giới tính vì gene vẫn ở NST thường.' },
  { t:'tv', q:'Ở thực vật C4, điểm bù CO₂ thấp hơn C3 chủ yếu vì:', o:['C4 có nhiều lục lạp hơn','C4 tập trung CO₂ ở tế bào bao bó mạch nhờ chu trình 4 carbon','C4 không cần ánh sáng','C4 không có pha tối'], a:1,
    tip:'PEP-carboxylase bơm CO₂ vào tế bào bao bó mạch.', why:'Enzyme PEP-carboxylase có ái lực CO₂ rất cao, bơm CO₂ vào tế bào bao bó mạch tạo nồng độ cao quanh rubisco nên gần như không có hô hấp sáng.', trap:'C4 vẫn có đủ hai pha sáng và tối.' },
  { t:'tv', q:'Khi tăng nồng độ CO₂ từ 0,03% lên 0,1% ở điều kiện ánh sáng mạnh, cường độ quang hợp của cây C3 sẽ:', o:['Tăng rồi đạt bão hòa','Giảm ngay lập tức','Không đổi','Giảm rồi tăng'], a:0,
    tip:'CO₂ là nguyên liệu giới hạn của rubisco.', why:'CO₂ tăng làm rubisco carboxyl hóa mạnh hơn, nhưng đến một ngưỡng thì enzyme và chuỗi vận chuyển electron đã bão hòa.', trap:'Tăng mãi sẽ ức chế — nhưng trong khoảng 0,03 → 0,1% thì vẫn tăng.' },
  { t:'dv', q:'Trong chu kì tim, đường cong áp lực máu dao động mạnh nhất và có giá trị cao nhất thuộc về:', o:['Tâm nhĩ trái','Tâm thất trái','Tâm thất phải','Động mạch phổi'], a:1,
    tip:'Tâm thất trái bơm máu đi toàn cơ thể nên áp lực lớn nhất.', why:'Thất trái đẩy máu vào động mạch chủ với huyết áp tâm thu ~120 mmHg, cao hơn hẳn thất phải (~25 mmHg).', trap:'Động mạch phổi có áp lực thấp hơn nhiều so với động mạch chủ.' },
  { t:'dv', q:'Một người bị hẹp van hai lá. Hệ quả trực tiếp là:', o:['Máu ứ ở tâm nhĩ trái, phổi ứ máu','Máu ứ ở tâm thất trái, phù chân','Huyết áp động mạch chủ tăng mạnh','Máu về tim từ phổi giảm'], a:0,
    tip:'Hẹp van hai lá chặn dòng từ nhĩ trái xuống thất trái.', why:'Máu không xuống được thất trái nên ứ lại nhĩ trái, áp lực tĩnh mạch phổi tăng gây khó thở và phù phổi.', trap:'Phù chân là hệ quả của suy tim phải, không phải hẹp van hai lá đơn thuần.' },
  { t:'tv', q:'Đóng khí khổng vào ban đêm ở cây CAM có ý nghĩa:', o:['Tránh mất nước, dự trữ CO₂ dưới dạng acid hữu cơ','Tăng hô hấp để sinh nhiệt','Tăng hấp thụ ánh sáng','Giảm thoát hơi nước nhưng tăng quang hợp ban đêm'], a:0,
    tip:'CAM: mở khổng đêm để lấy CO₂, đóng ngày để giữ nước.', why:'CO₂ đêm được cố định thành malate trữ trong không bào, ban ngày phân giải cấp CO₂ cho chu trình Calvin khi khổng đóng.', trap:'Quang hợp vẫn diễn ra ban ngày, không phải ban đêm.' },
  { t:'dt', q:'Một gene nhân đôi 3 lần trong môi trường chỉ có N¹⁵, bắt đầu từ DNA toàn N¹⁴. Số phân tử DNA con có cả hai mạch đều mang N¹⁵ là:', o:['2','6','8','4'], a:1,
    tip:'Tổng 2³ = 8; trừ 2 phân tử còn giữ mạch N¹⁴ của mẹ.', why:'8 − 2 = 6 phân tử có cả hai mạch hoàn toàn mới (N¹⁵).', trap:'Chọn 8 là quên hai phân tử bán bảo toàn giữ mạch gốc.' },
  { t:'dt', q:'Trong một đơn vị nhân đôi, enzyme nào được coi là "mở đường" cho toàn bộ quá trình?', o:['Ligase','Helicase','Primase','DNA polymerase I'], a:1,
    tip:'Không tách mạch thì không enzyme nào tiếp cận được khuôn.', why:'Helicase phá liên kết hydrogen tạo chạc chữ Y, tạo điều kiện cho primase và polymerase hoạt động.', trap:'Primase chỉ khởi đầu từng đoạn, không mở xoắn toàn cục.' },
  { t:'nst', q:'Thể song nhị bội được tạo ra từ loài A (2n = 4) và loài B (2n = 6) sẽ có bộ NST là:', o:['2n = 5','2n = 10','2n = 12','4n = 20'], a:1,
    tip:'Song nhị bội = tổng bộ NST lưỡng bội của hai loài.', why:'4 + 6 = 10. Cơ thể này chứa hai bộ NST không tương đồng nhưng vẫn bắt cặp được trong giảm phân nên hữu thụ.', trap:'2n = 5 là hợp tử F1 chưa đa bội hóa, thường bất thụ.' },
  { t:'ql', q:'Ở phép lai phân tích cá thể dị hợp 2 cặp gene liên kết hoàn toàn (AB/ab), đời con có tỉ lệ:', o:['1 : 1 : 1 : 1','1 : 1','3 : 1','9 : 3 : 3 : 1'], a:1,
    tip:'Liên kết hoàn toàn → chỉ 2 loại giao tử.', why:'AB/ab cho 2 giao tử AB và ab với tỉ lệ bằng nhau; lai với ab/ab cho 1 AB/ab : 1 ab/ab.', trap:'1:1:1:1 là khi hoán vị 50% (phân ly độc lập).' },
  { t:'tb', q:'Tế bào gan có khả năng xử lý lượng lớn NH₃ độc vì:', o:['Có nhiều lysosome phân hủy NH₃','Chuyển NH₃ thành urea trong chu trình ornithine rồi thải qua thận','Dự trữ NH₃ trong không bào','Bài tiết NH₃ trực tiếp qua da'], a:1,
    tip:'Gan là nhà máy khử độc: NH₃ → urea.', why:'Chu trình ornithine (chu trình urea) gắn NH₃ vào phân tử urea ít độc hơn nhiều, sau đó thận thải ra nước tiểu.', trap:'Bài tiết NH₃ trực tiếp chỉ gặp ở động vật thủy sinh.' },
  { t:'tb', q:'Vì sao gan được xem là cơ quan điều hòa đường huyết quan trọng nhất?', o:['Vì gan tiết insulin','Vì gan dự trữ glycogen và phân giải thành glucose khi đường huyết hạ','Vì gan tiêu hóa protein','Vì gan sản xuất hồng cầu'], a:1,
    tip:'Glycogen → glucose khi đói; glucose → glycogen khi no.', why:'Insulin kích thích gan nạp glucose thành glycogen; glucagon kích thích phân giải glycogen giải phóng glucose, giữ đường huyết ổn định.', trap:'Insulin do tụy tiết, không phải gan.' },
  { t:'tv', q:'Cây bị ngập úng lâu ngày vàng lá vì:', o:['Thiếu ánh sáng','Rễ thiếu O₂ nên hô hấp yếu, không hấp thụ được khoáng','Đất quá nhiều đạm','Lá bị rửa trôi diệp lục'], a:1,
    tip:'Hấp thụ khoáng chủ động cần ATP từ hô hấp hiếu khí.', why:'Ngập nước đẩy không khí khỏi đất, rễ chuyển sang lên men tạo ít ATP, bơm ion yếu đi nên thiếu Mg và N để tổng hợp diệp lục.', trap:'Không phải do mất diệp lục trực tiếp mà do thiếu nguyên liệu tổng hợp.' },
  { t:'dv', q:'Ở người, sau bữa ăn giàu tinh bột, hormone nào làm giảm đường huyết?', o:['Glucagon','Adrenalin','Insulin','Cortisol'], a:2,
    tip:'Insulin = "hormone dự trữ".', why:'Insulin tăng nhập glucose vào tế bào và kích thích gan, cơ tổng hợp glycogen, hạ đường huyết về mức ổn định.', trap:'Glucagon và adrenalin đều làm TĂNG đường huyết.' },
];

/* ---- Chùm Đúng/Sai bổ sung (từ 3 đề + thiết kế lại) ---- */
const EXT_TF = [
  { title: 'Gene cấu trúc — ba vùng và tính phân mảnh', sub: [
    { text: 'Phần lớn gene của sinh vật nhân thực có vùng mã hóa không liên tục, xen kẽ các đoạn mã hóa acid amin (exon) với các đoạn không mã hóa (intron).', ans: true, exp: 'Đây là đặc trưng gene phân mảnh của nhân thực; nhân sơ có gene liên tục.' },
    { text: 'Vùng điều hòa nằm ở đầu 5′ của mạch mã gốc và mang tín hiệu khởi động phiên mã.', ans: false, exp: 'Vùng điều hòa (promoter) nằm ở đầu 3′ của mạch mã gốc, tương ứng đầu 5′ của mạch bổ sung. RNA polymerase trượt trên mạch gốc theo chiều 3′→5′ nên điểm vào phải ở đầu 3′.' },
    { text: 'Gene không phân mảnh có vùng mã hóa liên tục, không chứa intron.', ans: true, exp: 'Điển hình ở sinh vật nhân sơ và một số gene nhân thực như gene histone.' },
    { text: 'Mỗi gene mã hóa protein điển hình gồm ba vùng: vùng điều hòa, vùng mã hóa và vùng kết thúc.', ans: true, exp: 'Ba vùng tương ứng ba chức năng: bật/tắt, mang thông tin, và ra hiệu dừng.' }
  ]},
  { title: 'DNA và RNA ở sinh vật nhân thực', sub: [
    { text: 'DNA có cấu trúc hai mạch còn RNA điển hình có cấu trúc một mạch.', ans: true, exp: 'RNA là mạch đơn nhưng có thể tự gập tạo cấu trúc bậc hai cục bộ (đặc biệt tRNA, rRNA).' },
    { text: 'DNA có liên kết hydrogen bổ sung giữa hai mạch còn RNA thì hoàn toàn không có liên kết hydrogen.', ans: false, exp: 'tRNA có các đoạn tự bắt cặp nội phân tử tạo ba thùy; rRNA cũng có vùng xoắn kép. Liên kết hydrogen vẫn tồn tại, chỉ là không giữa hai mạch dài song song.' },
    { text: 'Đơn phân của DNA có đường deoxyribose và thymine, khác với đơn phân của RNA có ribose và uracil.', ans: true, exp: 'Khác biệt ở nhóm 2′-OH của đường và ở base T/U quyết định độ bền và chức năng của hai loại acid nucleic.' },
    { text: 'DNA có khối lượng và kích thước lớn hơn RNA.', ans: true, exp: 'DNA chứa toàn bộ bộ gene nên rất dài; mRNA chỉ là bản sao ngắn của một gene.' }
  ]},
  { title: 'Tế bào nhân sơ: DNA vùng nhân và plasmid', sub: [
    { text: 'Vùng nhân của tế bào nhân sơ chứa phân tử DNA dạng vòng, mạch kép, không có màng nhân bao quanh.', ans: true, exp: 'Nhân sơ không có màng nhân nên DNA tập trung thành vùng nhân (nucleoid), thường là một phân tử vòng.' },
    { text: 'Plasmid là phân tử DNA vòng nhỏ nằm ngoài vùng nhân và sao chép độc lập với DNA vùng nhân.', ans: true, exp: 'Plasmid sao chép độc lập với DNA vùng nhân và có thể truyền giữa các tế bào vi khuẩn qua tiếp hợp.' },
    { text: 'Trong mỗi tế bào nhân sơ thường chỉ có một phân tử DNA vùng nhân.', ans: true, exp: 'Đa số vi khuẩn có một nhiễm sắc thể vòng duy nhất; một số ít loài có 2 hoặc nhiều hơn.' },
    { text: 'Plasmid không mang thông tin di truyền quan trọng nên tế bào mất plasmid vẫn sống và sinh sản như bình thường trong mọi môi trường.', ans: false, exp: 'Plasmid mang gene kháng kháng sinh, gene phân giải chất lạ, gene độc tố — mất plasmid có thể mất khả năng sống sót khi môi trường có thuốc.' }
  ]},
  { title: 'Chạc tái bản — chiều và đoạn mồi', sub: [
    { text: 'Mạch khuôn có chiều 3′→5′ tính theo chiều mở chạc sẽ được tổng hợp liên tục.', ans: true, exp: 'Polymerase kéo dài 5′→3′ nên khi khuôn là 3′→5′ thì nó tiến mãi về phía chạc đang mở — đó là mạch dẫn đầu.' },
    { text: 'Các đoạn Okazaki sau khi tổng hợp được nối lại với nhau nhờ enzyme ligase.', ans: true, exp: 'Ligase tạo liên kết phosphodiester giữa đầu 3′-OH của đoạn trước với đầu 5′-P của đoạn sau.' },
    { text: 'Trên mỗi chạc tái bản chỉ cần một đoạn mồi RNA duy nhất.', ans: false, exp: 'Mạch dẫn đầu cần 1 mồi, nhưng mạch theo sau cần mồi riêng cho TỪNG đoạn Okazaki, nên số mồi = số đoạn Okazaki + 1 (mỗi chạc).' },
    { text: 'Hai chạc của một bong bóng tái bản tiến về hai hướng ngược nhau.', ans: true, exp: 'Bong bóng mở rộng theo cả hai phía từ điểm khởi đầu, giúp rút ngắn thời gian nhân đôi.' }
  ]},
  { title: 'Hoạt hóa acid amin trước dịch mã', sub: [
    { text: 'Giai đoạn (a) là acid amin được hoạt hóa nhờ năng lượng ATP.', ans: true, exp: 'Phản ứng gắn acid amin vào tRNA tiêu tốn ATP, tạo liên kết ester giàu năng lượng.' },
    { text: 'Giai đoạn (b) là liên kết giữa acid amin đã hoạt hóa với tRNA tương ứng nhờ enzyme.', ans: true, exp: 'Enzyme aminoacyl-tRNA synthetase vừa chọn đúng acid amin vừa chọn đúng tRNA — đây là điểm bảo đảm độ chính xác của dịch mã.' },
    { text: 'Enzyme xúc tác liên kết giữa tRNA và acid amin là aminoacyl-tRNA synthetase.', ans: true, exp: 'Mỗi loại acid amin có enzyme riêng, tạo mã di truyền thứ hai ở mức độ acid amin.' },
    { text: 'Nếu tRNA này mang fMet thì bộ ba đối mã của nó là 3′AUG5′.', ans: false, exp: 'fMet được mã hóa bởi codon 5′AUG3′, nên anticodon phải đối song và bổ sung: 3′UAC5′.' }
  ]},
  { title: 'Phiên mã ở sinh vật nhân sơ', sub: [
    { text: 'RNA polymerase vừa tháo xoắn vừa tổng hợp mạch RNA.', ans: true, exp: 'Khác với tái bản cần helicase riêng, RNA polymerase tự tách hai mạch tại vùng phiên mã.' },
    { text: 'mRNA được tổng hợp theo chiều 5′→3′.', ans: true, exp: 'Nucleotide mới luôn được gắn vào đầu 3′-OH tự do của mạch đang lớn.' },
    { text: 'Cả hai mạch của gene đều có thể đồng thời làm khuôn để tổng hợp mRNA.', ans: false, exp: 'Chỉ một mạch (mạch mã gốc) làm khuôn cho một gene; nếu hai mạch cùng phiên mã sẽ tạo hai RNA khác nhau hoàn toàn.' },
    { text: 'Ở nhân sơ, dịch mã có thể bắt đầu khi phiên mã chưa kết thúc.', ans: true, exp: 'Không có màng nhân ngăn cách nên ribosome bám vào đầu 5′ của mRNA vừa mới lộ ra — đây là điểm khác biệt lớn so với nhân thực.' }
  ]},
  { title: 'Phiên mã ngược (reverse transcription)', sub: [
    { text: 'Giai đoạn [I] là phiên mã ngược, tổng hợp mạch DNA thứ nhất từ mRNA nhờ reverse transcriptase.', ans: true, exp: 'Enzyme này dùng RNA làm khuôn để tổng hợp DNA bổ sung (cDNA).' },
    { text: 'Giai đoạn [II] cắt bỏ mRNA khỏi mạch DNA đơn nhờ enzyme RNase H.', ans: true, exp: 'RNase H phân giải riêng phần RNA trong phức hợp lai RNA–DNA.' },
    { text: 'Giai đoạn [III] dùng mạch DNA đơn thứ nhất làm khuôn để tổng hợp mạch bổ sung theo nguyên tắc bổ sung.', ans: true, exp: 'Kết quả là phân tử DNA mạch kép (cDNA) mang thông tin của mRNA ban đầu.' },
    { text: 'Để tạo virus mới, cDNA thực hiện phiên mã và dịch mã nhờ nguyên liệu, enzyme và năng lượng do chính virus cung cấp.', ans: false, exp: 'Virus không có bộ máy riêng — nó bắt buộc dùng ribosome, acid amin, ATP và enzyme của tế bào chủ.' }
  ]},
  { title: 'Đột biến gene — loại và hậu quả', sub: [
    { text: 'Mất một cặp nucleotide trong vùng mã hóa luôn gây dịch khung đọc.', ans: true, exp: 'Khung đọc lệch đi 1 nucleotide nên toàn bộ codon phía sau bị đọc sai; hậu quả thường nghiêm trọng hơn thay thế.' },
    { text: 'Đột biến thay thế một cặp nucleotide luôn làm thay đổi acid amin trong chuỗi polypeptide.', ans: false, exp: 'Do tính thoái hóa, nhiều bộ ba khác nhau cùng mã hóa một acid amin nên có thể là đột biến đồng nghĩa.' },
    { text: 'Đột biến vô nghĩa tạo ra bộ ba kết thúc sớm, làm chuỗi polypeptide ngắn hơn bình thường.', ans: true, exp: 'Ribosome gặp codon dừng giữa chừng nên protein bị cắt cụt, thường mất chức năng.' },
    { text: 'Đột biến ở vùng điều hòa không làm thay đổi cấu trúc protein nhưng có thể làm thay đổi lượng protein được tạo ra.', ans: true, exp: 'Promoter mạnh lên hoặc yếu đi sẽ đổi mức biểu hiện gene, đôi khi gây bệnh dù trình tự acid amin bình thường.' }
  ]},
  { title: 'Quang hợp — cường độ (mg CO₂/dm²/giờ) theo nhiệt độ. Nhóm A: 20 °C = 18, 30 °C = 26, 40 °C = 8. Nhóm B: 20 °C = 12, 30 °C = 30, 40 °C = 36.', sub: [
    { text: 'Nhóm A đạt cực đại ở khoảng 30 °C rồi giảm mạnh khi lên 40 °C.', ans: true, exp: 'Đường cong dạng này là dấu hiệu của thực vật C3: quá nóng thì rubisco tăng hoạt tính oxygenase, hô hấp sáng mạnh nên cường độ quang hợp tụt.' },
    { text: 'Nhóm B là thực vật C3 vì có cường độ quang hợp cao hơn nhóm A ở 40 °C.', ans: false, exp: 'Chịu nóng tốt hơn là đặc trưng của C4, không phải C3. C4 duy trì quang hợp ở nhiệt độ cao nhờ tập trung CO₂ quanh rubisco, hạn chế hô hấp sáng.' },
    { text: 'Ở 40 °C, nhóm B có cường độ quang hợp cao hơn nhóm A.', ans: true, exp: 'Số liệu trong đề: B = 36 còn A = 8 mg CO₂/dm²/giờ.' },
    { text: 'Tăng nồng độ CO₂ trong buồng lên 800 ppm sẽ làm giảm cường độ quang hợp của cả hai nhóm.', ans: false, exp: 'CO₂ là nguyên liệu của rubisco/PEP-carboxylase nên tăng CO₂ làm cường độ quang hợp TĂNG cho tới điểm bão hòa, không giảm.' }
  ]},
  { title: 'Operon lac — đọc bảng biểu hiện', sub: [
    { text: 'Chủng A có β-galactosidase luôn không hoạt động nhưng permease luôn hoạt động, phù hợp với đột biến ở gene lacZ.', ans: false, exp: 'Đột biến lacZ đúng là làm mất β-galactosidase, nhưng permease (lacY) vẫn cảm ứng — chỉ hoạt động khi có lactose, không "luôn hoạt động". Kiểu hình luôn bật mới cần thêm đột biến ở vùng vận hành.' },
    { text: 'Chủng B chỉ biểu hiện β-galactosidase khi có lactose, còn permease thì không bao giờ biểu hiện — phù hợp với đột biến ở gene lacY.', ans: true, exp: 'lacY hỏng thì không có permease; lacZ còn nguyên nên vẫn cảm ứng được bình thường khi có lactose.' },
    { text: 'Chủng C không biểu hiện cả hai enzyme trong mọi môi trường, phù hợp với đột biến ở vùng khởi động (promoter) của operon.', ans: true, exp: 'Promoter hỏng thì RNA polymerase không bám được nên cả cụm gene mất biểu hiện hoàn toàn.' },
    { text: 'Chủng D biểu hiện cả hai enzyme ngay cả khi không có lactose, phù hợp với đột biến ở gene điều hòa hoặc vùng vận hành.', ans: true, exp: 'Gene điều hòa hỏng thì không có protein ức chế; vùng vận hành hỏng thì ức chế không bám được — cả hai đều dẫn tới biểu hiện cấu trúc (luôn bật).' }
  ]},
  { title: 'Mức phản ứng và thường biến', sub: [
    { text: 'Mức phản ứng là tập hợp các kiểu hình khác nhau của cùng một kiểu gene trong các môi trường khác nhau.', ans: true, exp: 'Mức phản ứng do kiểu gene quy định nhưng biểu hiện ra phụ thuộc môi trường — đó là lý do không thể "chọn giống" một kiểu hình cố định.' },
    { text: 'Mức phản ứng càng rộng thì sinh vật càng dễ thích nghi với môi trường thay đổi.', ans: true, exp: 'Kiểu hình dẻo cho phép cá thể duy trì chức năng khi điều kiện dao động, ví dụ giống lúa có biên độ khối lượng hạt lớn.' },
    { text: 'Thường biến được di truyền cho thế hệ sau vì nó làm thay đổi kiểu gene.', ans: false, exp: 'Thường biến chỉ thay đổi kiểu hình, kiểu gene giữ nguyên nên KHÔNG di truyền.' },
    { text: 'Cây hoa bốn giờ có lá khảm sinh ra con gồm lá xanh, trắng và khảm là ví dụ của thường biến.', ans: false, exp: 'Đây là đột biến ở lục lạp (di truyền tế bào chất) — kiểu gene đã thay đổi nên con khác mẹ ngay trong cùng môi trường.' }
  ]},
  { title: 'Di truyền ti thể và bệnh do gene tế bào chất', sub: [
    { text: 'Bệnh do đột biến gene ti thể được di truyền chủ yếu theo dòng mẹ.', ans: true, exp: 'Trứng đóng góp gần như toàn bộ ti thể cho hợp tử, còn tinh trùng hầu như không truyền ti thể.' },
    { text: 'Mẹ bị bệnh do đột biến ti thể thì tất cả con đều bị bệnh.', ans: false, exp: 'Do hiện tượng dị tương đồng (heteroplasmy): tế bào chứa lẫn ti thể bình thường và đột biến, khi phân chia tỉ lệ này phân ly ngẫu nhiên nên có con nhận toàn ti thể lành.' },
    { text: 'Bố bị bệnh do đột biến ti thể có thể truyền bệnh cho con trai.', ans: false, exp: 'Tinh trùng không truyền ti thể cho hợp tử, nên bệnh hầu như không đi theo dòng bố.' },
    { text: 'Mức độ biểu hiện bệnh ti thể phụ thuộc vào tỉ lệ ti thể mang gene đột biến trong từng mô.', ans: true, exp: 'Mô nào có tỉ lệ ti thể đột biến cao hơn thì thiếu năng lượng trầm trọng hơn, giải thích vì sao bệnh thường nặng ở cơ và thần kinh.' }
  ]}
];

/* ---- Trả lời ngắn bổ sung ---- */
const EXT_SHORT = [
  { q: 'Trong các cấu trúc/cơ chế sau: rRNA, tRNA, dịch mã tổng hợp chuỗi polypeptide, tái bản DNA, NST nhân đôi, phiên mã tổng hợp mRNA, cấu trúc 2 mạch bổ sung của DNA — có bao nhiêu cái diễn ra TRONG NHÂN tế bào nhân thực?', ans: '6', cells: ['6', '', '', ''],
    exp: 'Trong nhân: rRNA (tổng hợp tại nhân), tRNA, tái bản DNA, NST nhân đôi, phiên mã, cấu trúc 2 mạch DNA = 6. Dịch mã diễn ra ở tế bào chất.' },
  { q: 'Cho 5 nhận định về DNA: (1) các nucleotide trên một mạch nối bằng liên kết hydrogen; (2) các base hai mạch bắt cặp theo NTBS; (3) liên kết hydrogen không bền nhưng số lượng lớn nên DNA ổn định; (4) liên kết hydrogen dễ phá vỡ để nhân đôi và phiên mã; (5) nhờ NTBS mà DNA truyền nguyên vẹn cho DNA con. Có bao nhiêu nhận định ĐÚNG?', ans: '4', cells: ['4', '', '', ''],
    exp: 'Nhận định (1) sai vì các nucleotide trên CÙNG một mạch nối với nhau bằng liên kết phosphodiester, chỉ hai mạch với nhau mới có liên kết hydrogen. Còn lại 4 nhận định đúng.' },
  { q: 'Một gene cấu trúc thực hiện phiên mã liên tiếp 5 lần. Số phân tử mRNA được tạo ra là bao nhiêu?', ans: '5', cells: ['5', '', '', ''],
    exp: 'Mỗi lần phiên mã tạo 1 mRNA; gene không bị tiêu hao nên 5 lần cho 5 phân tử mRNA.' },
  { q: 'Trong các thành phần: gene, mRNA, acid amin, tRNA, ribosome — có bao nhiêu thành phần tham gia TRỰC TIẾP vào tổng hợp chuỗi polypeptide?', ans: '4', cells: ['4', '', '', ''],
    exp: 'Trực tiếp gồm mRNA (khuôn), acid amin (nguyên liệu), tRNA (vận chuyển), ribosome (bộ máy) = 4. Gene chỉ tham gia gián tiếp vì phải phiên mã trước.' },
  { q: 'Nuôi 6 vi khuẩn (mỗi tế bào chứa 1 phân tử DNA toàn N¹⁵) trong môi trường chỉ có N¹⁴. Sau một thời gian, thu toàn bộ DNA và thấy DNA chứa N¹⁵ chiếm 6,25%. Số vi khuẩn đã thu được là bao nhiêu?', ans: '192', cells: ['1', '9', '2', ''],
    exp: 'Mỗi vi khuẩn ban đầu sau ≥1 lần nhân đôi cho 2 DNA lai chứa N¹⁵ ⇒ 12 phân tử. Gọi tổng số DNA là X: 12/X = 0,0625 ⇒ X = 192. Kiểm tra: 6 × 2⁵ = 192 ⇒ đã nhân đôi 5 lần.' },
  { q: 'Gene B có 2400 nucleotide, A gấp 3 lần G. Đột biến thay thế làm gene dài không đổi nhưng giảm 1 liên kết hydrogen. Số nucleotide loại A của allele đột biến là bao nhiêu?', ans: '901', cells: ['9', '0', '1', ''],
    exp: 'A + G = 1200 và A = 3G ⇒ G = 300, A = 900. Giảm 1 liên kết H ⇒ thay cặp G–C (3H) bằng A–T (2H): A tăng 1 ⇒ 901, G giảm 1 ⇒ 299.' },
  { q: 'Một gene có 3000 nucleotide, trong đó G chiếm 30%. Số liên kết hydrogen của gene là bao nhiêu?', ans: '3900', cells: ['3', '9', '0', '0'],
    exp: 'G = C = 900; A = T = 600. H = 2A + 3G = 1200 + 2700 = 3900.' },
  { q: 'Một tế bào sinh dưỡng có 2n = 24 nguyên phân liên tiếp 4 lần. Số nhiễm sắc thể tương đương môi trường cung cấp là bao nhiêu?', ans: '360', cells: ['3', '6', '0', ''],
    exp: 'Số tế bào con = 2⁴ = 16. NST môi trường cung cấp = 2n × (16 − 1) = 24 × 15 = 360.' },
  { q: 'Quần thể ngẫu phối đang cân bằng di truyền có tần số allele A = 0,6. Tỉ lệ % cá thể mang kiểu hình trội là bao nhiêu?', ans: '84', cells: ['8', '4', '', ''],
    exp: 'q = 0,4 ⇒ aa = 0,16 ⇒ trội = 1 − 0,16 = 0,84 = 84%.' },
  { q: 'Một đoạn gene nhân sơ có 300 cặp nucleotide, trong đó vùng mã hóa chiếm 240 cặp. Chuỗi polypeptide hoàn chỉnh (đã cắt acid amin mở đầu) có tối đa bao nhiêu acid amin?', ans: '78', cells: ['7', '8', '', ''],
    exp: 'Số codon = 240/3 = 80. Trừ 1 codon kết thúc và 1 acid amin mở đầu: 80 − 2 = 78.' }
];

MCQS.push(...EXT_MCQ);
TFS.push(...EXT_TF);
SHORTS.push(...EXT_SHORT);

/* =========================================================
   11b-2. BỔ SUNG ĐỢT 2 — câu hỏi TRỌNG SUY LUẬN
   Mỗi câu buộc phải truy nguyên nhân quả, không hỏi
   kiến thức khai thác trực tiếp từ trí nhớ.
   ========================================================= */
const EXT2_MCQ = [
  /* ---------- Di truyền phân tử ---------- */
  { t:'dt', q:'Một gene ở sinh vật nhân sơ có 1200 nucleotide và tổng số liên kết hydrogen là 1500. Số nucleotide loại A của gene là:', o:['300','150','200','450'], a:0,
    tip:'Lập hệ hai phương trình: A + G = N/2 và 2A + 3G = H.', why:'A + G = 600 và 2A + 3G = 1500. Thay G = 600 − A: 2A + 1800 − 3A = 1500 ⇒ A = 300, G = 300.', trap:'Ra A = 300 rồi chia đôi thành 150 là nhầm: A đã là số nucleotide loại A trên CẢ hai mạch.' },
  { t:'dt', q:'Một phân tử mRNA có A = 150, U = 250, G = 300, X = 200. Số nucleotide loại G của gene đã tổng hợp mRNA này là:', o:['500','300','200','800'], a:0,
    tip:'G của gene = G mạch gốc + G mạch bổ sung = X(mRNA) + G(mRNA).', why:'Mạch gốc có G = X(mRNA) = 200; mạch bổ sung có G = G(mRNA) = 300. Tổng G của gene = 500.', trap:'Chỉ lấy 300 là quên gene gồm hai mạch.' },
  { t:'dt', q:'Một gene nhân thực có 5 exon (mỗi exon 150 nucleotide) và 4 intron (mỗi intron 500 nucleotide). Chuỗi polypeptide hoàn chỉnh do gene này mã hoá có bao nhiêu acid amin?', o:['248','249','250','300'], a:0,
    tip:'Chỉ exon được dịch mã; trừ codon kết thúc và acid amin mở đầu.', why:'mRNA trưởng thành = 5 × 150 = 750 nucleotide ⇒ 250 codon. Trừ 1 codon kết thúc và 1 Met mở đầu ⇒ 248 acid amin.', trap:'Cộng cả intron (2750 nucleotide) sẽ ra con số khổng lồ — đây là bẫy “sơ khai vs trưởng thành”.' },
  { t:'dt', q:'Nếu DNA polymerase bị ức chế ngay sau khi đoạn mồi đầu tiên được tổng hợp, điều gì xảy ra trong chạc tái bản?', o:['Không mạch nào được kéo dài, tái bản dừng lại','Chỉ mạch dẫn đầu ngừng, mạch theo sau vẫn chạy','Primase sẽ kéo dài thay polymerase','Ligase tự nối các nucleotide lại'], a:0,
    tip:'Cả hai mạch đều cần polymerase để kéo dài.', why:'Đoạn mồi chỉ tạo đầu 3′-OH; việc gắn nucleotide tiếp theo là của DNA polymerase. Ức chế enzyme này thì không mạch nào tiến được.', trap:'Nghĩ mạch theo sau “làm từng đoạn” nên không cần polymerase — mỗi đoạn Okazaki đều do polymerase tổng hợp.' },
  { t:'dt', q:'Mạch gốc của một gene có trình tự 3′TAX GXA XGG5′. mRNA tương ứng là:', o:['5′AUG XGU GXX3′','3′AUG XGU GXX5′','5′UAX GXU XGG3′','5′AUG GXU XGG3′'], a:0,
    tip:'Bổ sung base rồi đảo chiều: khuôn 3′→5′ cho mRNA 5′→3′.', why:'T→A, A→U, X→G, G→X và đảo chiều: 5′AUG XGU GXX3′.', trap:'Đáp án giữ nguyên XGG ở cuối là quên bắt cặp bổ sung.' },
  { t:'dt', q:'Một đột biến đổi codon 5′UGG3′ (Trp) thành 5′UGA3′. Hậu quả với protein là:', o:['Chuỗi polypeptide ngắn hơn bình thường','Chuỗi polypeptide dài hơn bình thường','Protein không đổi vì mã thoái hoá','Mất acid amin mở đầu'], a:0,
    tip:'UGA là bộ ba kết thúc.', why:'Dịch mã dừng sớm tại đúng vị trí đột biến nên chuỗi bị cắt cụt — đột biến vô nghĩa (nonsense).', trap:'Đây không phải đột biến đồng nghĩa: UGG và UGA mã hoá hai thứ hoàn toàn khác nhau.' },
  { t:'dt', q:'Vì sao tái bản DNA ở sinh vật nhân thực lại có nhiều điểm khởi đầu?', o:['Để rút ngắn thời gian nhân đôi phân tử DNA rất dài','Vì DNA nhân thực là mạch đơn','Vì nhân thực có nhiều loại DNA polymerase','Để tăng tần số đột biến có lợi'], a:0,
    tip:'Nhiều origin ⇒ nhiều chạc chạy song song.', why:'Mỗi origin tạo hai chạc; nhờ nhiều origin, pha S hoàn tất trong vài giờ dù DNA dài hàng trăm triệu cặp nucleotide.', trap:'Số origin không liên quan đến số loại enzyme hay đột biến.' },
  { t:'dt', q:'Một tế bào thiếu hoàn toàn enzyme ligase. Hậu quả trực tiếp trong tái bản là:', o:['Mạch theo sau gồm nhiều đoạn rời, không liền mạch','Không có đoạn mồi nào được tạo','DNA không tháo xoắn được','Không nucleotide nào được gắn vào mạch mới'], a:0,
    tip:'Ligase nối các đoạn Okazaki.', why:'Các đoạn vẫn được tổng hợp nhưng không nối được ⇒ mạch mới đứt quãng, dễ gãy khi phân bào.', trap:'Ligase không tạo mồi (primase) và không tháo xoắn (helicase).' },
  { t:'dt', q:'Ở sinh vật nhân sơ, mRNA vừa phiên mã có thể được dịch mã ngay. Nguyên nhân là:', o:['Không có màng nhân ngăn cách và gene không phân mảnh','mRNA nhân sơ bền hơn mRNA nhân thực','Ribosome nằm trong nhân','Nhân sơ không cần tRNA'], a:0,
    tip:'Hai điều kiện: không màng nhân + không intron.', why:'Gene nhân sơ liên tục nên mRNA không phải cắt intron, và ribosome tiếp cận được ngay vì không có màng nhân.', trap:'Độ bền mRNA không phải nguyên nhân của hiện tượng này.' },
  { t:'dt', q:'Một gene nhân đôi 3 lần trong môi trường chỉ có N¹⁵, sau đó chuyển sang môi trường N¹⁴ và nhân đôi tiếp 2 lần. Số phân tử DNA chứa N¹⁵ thu được là:', o:['16','8','32','24'], a:0,
    tip:'Số mạch cũ được bảo toàn = 2 × số DNA trước khi đổi môi trường.', why:'Sau 3 lần có 8 DNA = 16 mạch N¹⁵. Bán bảo toàn giữ nguyên 16 mạch, mỗi mạch nằm trong một DNA ⇒ 16/32 DNA chứa N¹⁵.', trap:'Chọn 8 là quên mỗi DNA có hai mạch.' },
  { t:'dt', q:'Enzyme restrictase cắt DNA tại trình tự đặc hiệu. Ứng dụng nào sau đây KHÔNG dựa trên tính chất này?', o:['Phiên mã in vitro','Tạo DNA tái tổ hợp','Lập bản đồ giới hạn','Phân tích đa hình độ dài đoạn cắt'], a:0,
    tip:'Restrictase cắt DNA, không tổng hợp RNA.', why:'Phiên mã in vitro cần RNA polymerase. Ba ứng dụng còn lại đều khai thác khả năng cắt tại trình tự đặc hiệu.', trap:'“Lập bản đồ giới hạn” nghe lạ nhưng chính là ứng dụng kinh điển của restrictase.' },
  { t:'dt', q:'Một mRNA có tỉ lệ A : U : G : X = 1 : 2 : 3 : 4. Nếu dịch mã ngẫu nhiên, tỉ lệ bộ ba AUG là:', o:['0,6%','6%','0,06%','1,2%'], a:0,
    tip:'Ba vị trí độc lập ⇒ nhân xác suất.', why:'A = 10%, U = 20%, G = 30% ⇒ 0,1 × 0,2 × 0,3 = 0,006 = 0,6%.', trap:'Cộng xác suất (60%) là sai bản chất — phải nhân.' },

  /* ---------- NST & đột biến ---------- */
  { t:'nst', q:'Một loài có 2n = 8. Ở kỳ sau của nguyên phân, tế bào chứa:', o:['16 NST đơn, 0 chromatid','8 NST kép, 16 chromatid','16 NST kép, 32 chromatid','8 NST đơn, 0 chromatid'], a:0,
    tip:'Kỳ sau: tâm động tách ⇒ chỉ còn NST đơn.', why:'Trước kỳ sau có 8 NST kép (16 chromatid). Tâm động tách ra ⇒ 16 NST đơn, không còn chromatid.', trap:'Chọn “16 NST kép” là quên tâm động đã tách.' },
  { t:'nst', q:'Cùng loài 2n = 8. Ở kỳ giữa của giảm phân I, tế bào chứa:', o:['8 NST kép, 16 chromatid','4 NST kép, 8 chromatid','16 NST đơn','8 NST đơn, 8 chromatid'], a:0,
    tip:'Giảm phân I: NST đã nhân đôi nhưng chưa tách tâm động.', why:'2n = 8 NST kép (16 chromatid) xếp thành hai hàng theo từng cặp tương đồng.', trap:'Chọn 4 NST kép là nhầm sang kỳ giữa II.' },
  { t:'nst', q:'Trao đổi chéo diễn ra ở kỳ nào và giữa hai cấu trúc nào?', o:['Kỳ đầu I, giữa hai chromatid không chị em trong cặp tương đồng','Kỳ giữa I, giữa hai NST tương đồng','Kỳ đầu II, giữa hai chromatid chị em','Kỳ sau I, giữa hai NST không tương đồng'], a:0,
    tip:'Chỉ kỳ đầu I mới có tiếp hợp.', why:'Tiếp hợp tạo điều kiện trao đổi đoạn giữa hai chromatid không chị em của cùng một cặp tương đồng.', trap:'Trao đổi giữa hai chromatid chị em không tạo biến dị tổ hợp vì chúng giống hệt nhau.' },
  { t:'nst', q:'Một người có 47 NST, kiểu hình nam, có 2 nhiễm sắc thể X. Người này mắc hội chứng:', o:['Klinefelter (47, XXY)','Turner (45, XO)','Down (47, +21)','Ba nhiễm X (47, XXX)'], a:0,
    tip:'Nam + 2 X ⇒ XXY.', why:'47,XXY là Klinefelter: nam, tinh hoàn nhỏ, thường vô sinh, có thể có vú phát triển.', trap:'XXX cũng có 47 NST nhưng kiểu hình nữ.' },
  { t:'nst', q:'Cà chua có 2n = 24. Một thể ba nhiễm ở loài này có số NST là:', o:['25','24','26','23'], a:0,
    tip:'Thể ba nhiễm = 2n + 1.', why:'24 + 1 = 25 NST.', trap:'Thể ba kép (2n + 2) mới là 26; thể tam bội 3n = 36.' },
  { t:'nst', q:'Trong các đột biến cấu trúc NST, dạng thường ít gây hại nhất là:', o:['Đảo đoạn','Mất đoạn','Lặp đoạn lớn','Chuyển đoạn không tương hỗ'], a:0,
    tip:'Đảo đoạn không làm mất vật chất di truyền.', why:'Đảo đoạn chỉ đổi thứ tự gene nên không mất cân bằng liều gene; tuy vậy điểm đứt vẫn có thể phá vỡ một gene.', trap:'Lặp đoạn gây mất cân bằng liều gene nên thường hại hơn đảo đoạn.' },
  { t:'nst', q:'Hội chứng Down có thể do chuyển đoạn Robertson giữa NST 14 và 21. Điều này giải thích:', o:['Vì sao có gia đình sinh nhiều con Down dù bố mẹ chỉ có 45 NST','Vì sao Down chỉ gặp ở nữ','Vì sao Down không bao giờ di truyền','Vì sao Down là đột biến gene'], a:0,
    tip:'Người mang chuyển đoạn cân bằng vẫn bình thường nhưng truyền được.', why:'Bố/mẹ mang chuyển đoạn cân bằng có 45 NST, kiểu hình bình thường nhưng dễ sinh con có 3 bản sao vùng 21q.', trap:'Đa số ca Down do không phân li giảm phân và không di truyền, nhưng thể chuyển đoạn thì CÓ di truyền.' },
  { t:'nst', q:'Đa bội thể gặp phổ biến ở thực vật hơn động vật chủ yếu vì:', o:['Thực vật thường sinh sản vô tính và dung nạp được bộ NST tăng','Thực vật có nhiều NST hơn động vật','Động vật không có giảm phân','Thực vật không xảy ra đột biến NST'], a:0,
    tip:'Động vật đa bội thường chết phôi do mất cân bằng.', why:'Thực vật sinh sản vô tính và ít phụ thuộc cơ chế xác định giới tính nên thể đa bội tồn tại được; động vật đa bội rối loạn phát triển.', trap:'Số lượng NST không phải yếu tố quyết định.' },

  /* ---------- Quy luật di truyền ---------- */
  { t:'ql', q:'Phép lai AaBb × Aabb (các gene phân li độc lập). Tỉ lệ kiểu hình lặn về cả hai tính trạng là:', o:['12,5%','25%','6,25%','18,75%'], a:0,
    tip:'Nhân xác suất của từng tính trạng.', why:'Aa × Aa → aa = 1/4; Bb × bb → bb = 1/2. Tích = 1/8 = 12,5%.', trap:'Cộng 1/4 + 1/2 là sai: hai tính trạng độc lập phải nhân.' },
  { t:'ql', q:'Ở ruồi giấm, thân xám (B) trội so với đen (b), cánh dài (V) trội so với cụt (v), hai gene cùng nằm trên một NST. Phép lai phân tích cơ thể dị hợp tử chéo cho 4 kiểu hình với tỉ lệ KHÔNG bằng nhau. Kết luận đúng là:', o:['Hai gene liên kết và đã xảy ra hoán vị','Hai gene phân li độc lập','Đã xảy ra đột biến gene','Không thể kết luận vì thiếu dữ liệu giới tính'], a:0,
    tip:'4 kiểu hình lệch nhau ⇒ liên kết có hoán vị.', why:'Phân li độc lập cho 1:1:1:1; liên kết hoàn toàn chỉ cho 2 kiểu. Bốn kiểu lệch nhau chứng tỏ có hoán vị với tần số dưới 50%.', trap:'Đề không nói giới tính cá thể đem lai nên không thể vin vào “ruồi đực không hoán vị”.' },
  { t:'ql', q:'Hai gene A và B có tần số hoán vị 20%. Cơ thể AB/ab giảm phân cho các loại giao tử với tỉ lệ:', o:['AB = ab = 40%; Ab = aB = 10%','Mỗi loại 25%','AB = ab = 10%; Ab = aB = 40%','AB = ab = 50%'], a:0,
    tip:'Giao tử liên kết = (1 − f)/2; giao tử hoán vị = f/2.', why:'f = 20% ⇒ mỗi giao tử hoán vị 10%, mỗi giao tử liên kết 40%.', trap:'Đảo ngược 40% và 10% là nhầm giao tử liên kết với giao tử hoán vị.' },
  { t:'ql', q:'Quần thể ngẫu phối đang cân bằng di truyền có tần số allele a = 0,3. Sau thêm một thế hệ ngẫu phối, tỉ lệ cá thể aa là:', o:['9%','30%','42%','49%'], a:0,
    tip:'Quần thể đã cân bằng thì cấu trúc không đổi: aa = q².', why:'q = 0,3 ⇒ aa = 0,09 = 9%, giữ nguyên qua các thế hệ ngẫu phối.', trap:'Chọn 30% là nhầm tần số allele với tần số kiểu gene.' },
  { t:'ql', q:'Một bệnh do gene lặn trên NST thường, quần thể cân bằng có 1/10000 người bệnh. Tỉ lệ người mang gene (không bệnh) là:', o:['≈ 2%','≈ 1%','≈ 0,01%','≈ 99%'], a:0,
    tip:'q = √(q²); người mang gene = 2pq.', why:'q² = 0,0001 ⇒ q = 0,01; p = 0,99; 2pq ≈ 0,0198 ≈ 2%.', trap:'Chọn 1% là nhầm q với 2pq — số người mang gene luôn lớn hơn nhiều số người bệnh.' },
  { t:'ql', q:'Tính trạng chiều cao do 4 cặp gene tương tác cộng gộp. Cây cao nhất 180 cm, cây thấp nhất 100 cm. Cây có 2 allele trội cao bao nhiêu?', o:['140 cm','120 cm','160 cm','130 cm'], a:1,
    tip:'Đếm số allele trội tối đa trước: 4 cặp gene ⇒ cây cao nhất có 8 allele trội.', why:'4 cặp gene ⇒ cây cao nhất mang 8 allele trội. Mỗi allele góp (180 − 100)/8 = 10 cm. Có 2 allele trội: 100 + 20 = 120 cm.', trap:'Chia 4 thay vì 8 là quên mỗi cặp có hai allele — đáp án 140 cm chính là bẫy đó.' },

  /* ---------- Sinh lý thực vật ---------- */
  { t:'tv', q:'Cây C4 có hô hấp sáng rất thấp vì:', o:['CO₂ được bơm đậm đặc quanh Rubisco ở tế bào bao bó mạch','Cây C4 không có Rubisco','Cây C4 đóng khí khổng vào ban ngày','Cây C4 không có lục lạp ở mô giậu'], a:0,
    tip:'Giải phẫu Kranz tách hai pha.', why:'PEP-carboxylase cố định CO₂ ở mô giậu rồi chuyển vào tế bào bao bó mạch, nơi nồng độ CO₂ cao gấp nhiều lần không khí nên Rubisco không gắn O₂.', trap:'C4 vẫn có Rubisco, chỉ là tập trung ở tế bào bao bó mạch.' },
  { t:'tv', q:'So với cây ưa sáng, cây ưa bóng có điểm bù ánh sáng:', o:['Thấp hơn','Cao hơn','Bằng nhau','Không xác định được'], a:0,
    tip:'Điểm bù = cường độ ánh sáng mà quang hợp = hô hấp.', why:'Cây ưa bóng quang hợp hiệu quả ngay ở cường độ thấp nên chỉ cần ít ánh sáng đã cân bằng hô hấp ⇒ điểm bù thấp.', trap:'Điểm bão hoà của cây ưa bóng cũng thấp hơn — dễ nhầm hai khái niệm.' },
  { t:'tv', q:'Bón quá nhiều phân đạm có thể làm cây héo dù đất vẫn ẩm. Nguyên nhân là:', o:['Dung dịch đất thành ưu trương nên rễ mất nước','Đạm làm cháy lá','Đạm ức chế hoàn toàn quang hợp','Đạm làm khí khổng đóng lại'], a:0,
    tip:'Phân tan tạo gradient thẩm thấu ngược.', why:'Nồng độ chất tan cao trong dung dịch đất làm thế nước giảm, rễ mất nước ra ngoài dù đất ẩm — hiện tượng “cháy phân”.', trap:'Triệu chứng giống hạn nhưng nguyên nhân là thẩm thấu, không phải thiếu nước.' },
  { t:'tv', q:'Cây bị ngập úng lâu ngày chết chủ yếu vì:', o:['Rễ thiếu O₂ nên hô hấp kỵ khí, mất khả năng hút nước và ion','Lá bị mất nước quá nhanh','Quang hợp tăng quá mức','Rễ bị lạnh đột ngột'], a:0,
    tip:'Rễ cần O₂ cho hô hấp hiếu khí để bơm ion.', why:'Ngập nước đẩy không khí khỏi đất; rễ chuyển sang lên men, ATP giảm nên bơm ion ngừng, mất khả năng hấp thu nước chủ động.', trap:'Nghĩ “chết vì thừa nước” — bản chất là thiếu O₂ ở rễ.' },
  { t:'tv', q:'Hoocmôn nào được dùng phổ biến để giấm quả chín nhanh?', o:['Ethylene','Auxin','Gibberellin','Cytokinin'], a:0,
    tip:'Ethylene là hormone của sự chín.', why:'Ethylene kích thích chín, làm mềm quả và gây hô hấp đột phát ở quả chín.', trap:'Auxin gây giãn tế bào, không gây chín.' },
  { t:'tv', q:'Phun auxin tổng hợp ở nồng độ cao lên ruộng có thể dùng để:', o:['Diệt cỏ hai lá mầm','Kích thích hạt nảy mầm','Làm chín quả hàng loạt','Làm khí khổng đóng'], a:0,
    tip:'Tác dụng của auxin phụ thuộc nồng độ.', why:'Nồng độ cao gây rối loạn sinh trưởng và chết ở cây hai lá mầm, còn cây một lá mầm chịu được ⇒ thuốc diệt cỏ chọn lọc.', trap:'Auxin nồng độ thấp lại kích thích — không thể kết luận “auxin luôn gây chết”.' },

  /* ---------- Động vật & người ---------- */
  { t:'dv', q:'Người bị đái tháo đường type 1 có glucose máu rất cao nhưng tế bào vẫn thiếu năng lượng vì:', o:['Thiếu insulin nên GLUT4 không lên màng, glucose không vào được tế bào','Trong máu không có glucose','Gan không còn khả năng dự trữ glycogen','Thận lọc mất toàn bộ glucose'], a:0,
    tip:'Insulin là “chìa khoá” đưa GLUT4 ra màng.', why:'Thiếu insulin ⇒ glucose ứ trong máu nhưng tế bào không lấy được, buộc đốt mỡ và sinh thể ceton.', trap:'Nghĩ “máu nhiều glucose thì tế bào cũng nhiều” — vấn đề nằm ở cửa vào, không ở nguồn.' },
  { t:'dv', q:'Tiếng tim thứ nhất (“thịch”) được tạo ra khi:', o:['Van nhĩ – thất đóng ở đầu thì tâm thất thu','Van động mạch đóng ở cuối thì tâm thất thu','Van nhĩ – thất mở ra','Máu phụt vào động mạch chủ'], a:0,
    tip:'Tiếng 1 = van nhĩ–thất; tiếng 2 = van động mạch.', why:'Khi tâm thất co, áp lực vượt áp lực nhĩ làm van nhĩ–thất đóng sập tạo tiếng thứ nhất.', trap:'Tiếng thứ hai do van động mạch đóng ở cuối thì tâm thất thu.' },
  { t:'dv', q:'Một người được cắt bỏ túi mật. Khả năng tiêu hoá nhóm chất nào giảm rõ nhất?', o:['Lipid','Protein','Tinh bột','Nước'], a:0,
    tip:'Mật không có enzyme nhưng nhũ tương hoá mỡ.', why:'Mật chia lipid thành giọt nhỏ làm tăng diện tích tiếp xúc cho lipase; thiếu mật làm giảm hấp thu mỡ và các vitamin tan trong dầu.', trap:'Mật không tiêu hoá protein hay tinh bột — hai nhóm này do enzyme tụy và ruột đảm nhiệm.' },
  { t:'dv', q:'Bệnh nhân suy thận mạn thường bị thiếu máu vì:', o:['Giảm erythropoietin nên tủy xương giảm sản xuất hồng cầu','Mất máu qua nước tiểu là chính','Thiếu sắt trong khẩu phần','Hồng cầu bị phá huỷ ngay trong thận'], a:0,
    tip:'Thận tiết erythropoietin kích thích tủy xương.', why:'Suy thận ⇒ thiếu EPO ⇒ thiếu máu đẳng sắc đẳng bào, đáp ứng kém với bổ sung sắt.', trap:'Thiếu sắt gây thiếu máu nhược sắc — cơ chế khác.' },
  { t:'dv', q:'Trung khu điều hoà thân nhiệt và trung khu khát của người nằm ở:', o:['Vùng dưới đồi','Tiểu não','Hành não','Tuyến yên'], a:0,
    tip:'Vùng dưới đồi là trung tâm cân bằng nội môi.', why:'Vùng dưới đồi chứa trung khu điều nhiệt, trung khu khát và điều khiển tuyến yên.', trap:'Hành não điều hoà hô hấp và tim mạch, không phải thân nhiệt.' },
  { t:'dv', q:'Khi lặn xuống nước sâu, nhịp tim giảm chủ yếu nhằm:', o:['Giảm tiêu thụ O₂ và ưu tiên máu cho não, tim','Giảm huyết áp toàn thân','Tăng thải CO₂','Tăng nhiệt độ cơ thể'], a:0,
    tip:'Phản xạ lặn: nhịp tim chậm + co mạch ngoại vi.', why:'Giảm nhịp tim và co mạch chi giúp dồn máu đến não và tim, kéo dài thời gian sống trong điều kiện thiếu O₂.', trap:'CO₂ tăng thường làm tim nhanh hơn — không phải nguyên nhân của nhịp chậm khi lặn.' },

  /* ---------- Tế bào ---------- */
  { t:'tb', q:'Tế bào gan có rất nhiều lưới nội chất trơn vì bào quan này:', o:['Khử độc thuốc, rượu và tổng hợp lipid','Tổng hợp protein xuất bào','Dự trữ Ca²⁺ cho co cơ','Phân giải H₂O₂'], a:0,
    tip:'Lưới trơn = lipid + khử độc; lưới hạt = protein.', why:'Gan khử độc nhờ hệ cytochrome P450 trên lưới nội chất trơn, đồng thời tổng hợp lipid và cholesterol.', trap:'Tổng hợp protein là chức năng của lưới nội chất hạt.' },
  { t:'tb', q:'Một tế bào bị ức chế hoàn toàn ty thể. Quá trình nào bị ảnh hưởng nặng nhất?', o:['Hô hấp hiếu khí và các bơm ion chủ động','Đường phân ở tế bào chất','Khuếch tán đơn giản qua màng','Thẩm thấu của nước'], a:0,
    tip:'Ty thể cung cấp phần lớn ATP.', why:'Chuỗi truyền electron ở màng trong ty thể tạo phần lớn ATP (khoảng 26–28 trong tổng 30–32); thiếu ATP thì bơm Na⁺/K⁺ và các bơm chủ động ngừng hoạt động.', trap:'Đường phân diễn ra ở tế bào chất nên vẫn chạy; khuếch tán và thẩm thấu không cần ATP.' }
];

const EXT2_TF = [
  { title:'Đột biến & điều hoà biểu hiện gene', sub: [
    { text:'Đột biến thay thế một cặp nucleotide ở vùng promoter có thể làm protein tạo ra vẫn bình thường về cấu trúc nhưng giảm số lượng.', ans:true, exp:'Promoter điều hoà mức phiên mã; đột biến làm giảm ái lực của RNA polymerase ⇒ ít mRNA ⇒ ít protein, nhưng trình tự acid amin không đổi.' },
    { text:'Đột biến nằm trong intron thì luôn vô hại vì intron bị cắt bỏ.', ans:false, exp:'Đột biến ở điểm nối (splice site) có thể làm giữ lại intron hoặc mất exon ⇒ protein sai nghiêm trọng dù đột biến nằm trong intron.' },
    { text:'Hai gene nằm trên cùng một NST, càng cách xa nhau thì tần số hoán vị càng lớn.', ans:true, exp:'Khoảng cách càng lớn, xác suất có điểm trao đổi chéo giữa chúng càng cao — tối đa 50%, tương đương phân li độc lập.' },
    { text:'Thể đa bội lẻ thường bất thục vì giảm phân không thể chia đều bộ NST.', ans:true, exp:'3n, 5n… không tạo được giao tử có bộ NST cân bằng nên hầu như vô sinh — lý do thể tam bội thường phải nhân giống vô tính.' }
  ]},
  { title:'Quang hợp & hô hấp', sub: [
    { text:'Trong pha sáng, khí O₂ được tạo ra từ phân tử CO₂.', ans:false, exp:'O₂ sinh ra từ quang phân li nước tại phức hệ oxy hoá nước của PSII; CO₂ là nguyên liệu của pha tối.' },
    { text:'Hô hấp sáng làm giảm năng suất vì tiêu hao sản phẩm quang hợp mà không tạo ATP hữu ích.', ans:true, exp:'Rubisco gắn O₂ thay CO₂ tạo phosphoglycolate phải phân giải, vừa mất carbon vừa tiêu ATP và NADPH.' },
    { text:'Nồng độ CO₂ cao làm tăng hô hấp sáng.', ans:false, exp:'CO₂ cao ức chế hô hấp sáng vì Rubisco ưu tiên gắn CO₂; chính CO₂ thấp và O₂ cao mới gây hô hấp sáng.' },
    { text:'Lên men chỉ tạo 2 ATP nhưng vẫn cần thiết vì tái sinh NAD⁺ cho glycolysis.', ans:true, exp:'Glycolysis cần NAD⁺; lên men oxy hoá NADH trở lại NAD⁺ để glycolysis tiếp tục chạy trong điều kiện kỵ khí.' }
  ]},
  { title:'Di truyền quần thể & phả hệ', sub: [
    { text:'Quần thể tự thụ phấn qua nhiều thế hệ làm thay đổi tần số allele.', ans:false, exp:'Tự thụ chỉ tăng tỉ lệ đồng hợp và giảm dị hợp; tần số allele giữ nguyên nếu không có chọn lọc, đột biến hay di nhập gene.' },
    { text:'Bệnh do gene lặn trên NST X thường gặp ở nam nhiều hơn nữ và hay lây qua mẹ.', ans:true, exp:'Nam bán hợp tử nên chỉ cần một allele lặn đã biểu hiện; mẹ dị hợp truyền allele bệnh cho 50% con trai.' },
    { text:'Bố mẹ đều bình thường sinh con bị bệnh chứng tỏ bệnh do gene trội.', ans:false, exp:'Đó chính là dấu hiệu gene LẶN: bố mẹ dị hợp không biểu hiện nhưng truyền allele lặn cho con.' },
    { text:'Hai cặp gene càng nằm gần nhau trên cùng NST thì càng dễ phân li độc lập.', ans:false, exp:'Càng gần thì càng liên kết chặt, tần số hoán vị càng thấp; phân li độc lập chỉ xảy ra khi hai gene nằm trên hai cặp NST khác nhau.' }
  ]},
  { title:'Cân bằng nội môi', sub: [
    { text:'Thận tham gia điều hoà huyết áp thông qua hệ renin – angiotensin.', ans:true, exp:'Huyết áp giảm ⇒ thận tiết renin ⇒ angiotensin II gây co mạch và tăng tái hấp thu Na⁺, nước ⇒ huyết áp tăng.' },
    { text:'ADH tăng làm nước tiểu loãng hơn.', ans:false, exp:'ADH làm ống góp tăng số kênh aquaporin ⇒ tái hấp thu nước nhiều hơn ⇒ nước tiểu ÍT và cô đặc hơn.' },
    { text:'Aldosterone làm tăng tái hấp thu Na⁺ và tăng thải K⁺ qua nước tiểu.', ans:true, exp:'Aldosterone tác động ống lượn xa và ống góp: kéo Na⁺ vào máu (kèm nước) và đẩy K⁺ ra ngoài.' },
    { text:'Khi đường huyết tăng, tuyến tụy giảm tiết insulin.', ans:false, exp:'Đường huyết tăng kích thích tế bào beta tiết insulin; insulin giảm khi đường huyết hạ (lúc đó glucagon tăng).' }
  ]},
  { title:'Kỹ thuật di truyền', sub: [
    { text:'PCR cần đoạn mồi đặc hiệu vì DNA polymerase không thể khởi đầu tổng hợp từ đầu.', ans:true, exp:'Taq polymerase chỉ kéo dài từ đầu 3′-OH có sẵn do primer cung cấp, không gắn nucleotide đầu tiên khi không có mồi.' },
    { text:'Trong điện di agarose, đoạn DNA càng dài di chuyển càng nhanh.', ans:false, exp:'Lưới agarose cản đoạn dài nhiều hơn nên đoạn NGẮN chạy nhanh hơn và đi xa hơn về phía cực dương.' },
    { text:'Hệ CRISPR-Cas9 có thể tạo đột biến tại đúng trình tự đích nhờ RNA dẫn đường.', ans:true, exp:'gRNA bắt cặp bổ sung với trình tự đích, dẫn Cas9 cắt tại đó; sửa chữa NHEJ hoặc HDR quyết định kết quả đột biến.' },
    { text:'Nuôi cấy mô thực vật tạo ra cây con có kiểu gene giống hệt cây mẹ.', ans:true, exp:'Cây con hình thành từ nguyên phân của tế bào soma nên giữ nguyên kiểu gene, trừ khi phát sinh đột biến soma.' }
  ]},
  { title:'Tế bào & vận chuyển qua màng', sub: [
    { text:'Khuếch tán đơn giản cần ATP để đưa chất qua màng.', ans:false, exp:'Khuếch tán đơn giản diễn ra theo gradient nồng độ, không tiêu tốn ATP; chỉ vận chuyển chủ động mới cần năng lượng.' },
    { text:'Bơm Na⁺/K⁺ đưa 3 Na⁺ ra ngoài và 2 K⁺ vào trong, góp phần duy trì điện thế nghỉ.', ans:true, exp:'Mỗi chu trình đưa 3 điện tích dương ra nhưng chỉ nhận 2 vào ⇒ màng trong âm hơn; đây là thành phần điện sinh của bơm.' },
    { text:'Tế bào thực vật đặt trong môi trường nhược trương sẽ bị vỡ như hồng cầu.', ans:false, exp:'Thành cellulose chịu lực nên tế bào chỉ trương lên tạo sức trương; chỉ tế bào không có thành mới bị tan.' },
    { text:'Ty thể và lục lạp đều có DNA riêng và ribosome riêng.', ans:true, exp:'Cả hai là bào quan bán tự trị với DNA vòng và ribosome 70S — một bằng chứng ủng hộ thuyết nội cộng sinh.' }
  ]}
];

const EXT2_SHORT = [
  { q:'Một gene có 3000 nucleotide, trong đó A = 2G. Số liên kết hydrogen của gene là bao nhiêu?', ans:'3500', cells:['3','5','0','0'],
    exp:'A + G = 1500 và A = 2G ⇒ 3G = 1500 ⇒ G = 500, A = 1000. H = 2A + 3G = 2000 + 1500 = 3500.' },
  { q:'Một gene nhân đôi liên tiếp 4 lần. Số nucleotide môi trường cung cấp bằng bao nhiêu lần số nucleotide của gene?', ans:'15', cells:['1','5','',''],
    exp:'Số gene con = 2⁴ = 16. Môi trường cấp N × (16 − 1) = 15N, tức 15 lần.' },
  { q:'Ở ruồi giấm 2n = 8. Một tế bào sinh dục đực giảm phân bình thường tạo ra bao nhiêu tinh trùng?', ans:'4', cells:['4','','',''],
    exp:'Một tế bào sinh tinh qua giảm phân tạo 4 tinh trùng đơn bội n = 4. Lưu ý: số LOẠI tinh trùng tối đa là 4 khi có hoán vị, còn 2 khi không hoán vị.' },
  { q:'Quần thể ngẫu phối cân bằng có tần số allele a = 0,2. Tỉ lệ % cá thể mang kiểu hình trội là bao nhiêu?', ans:'96', cells:['9','6','',''],
    exp:'aa = 0,2² = 0,04 ⇒ trội = 1 − 0,04 = 0,96 = 96%.' },
  { q:'Phép lai AaBb × AaBb với hai gene phân li độc lập. Tỉ lệ % kiểu gene đồng hợp lặn về cả hai cặp là bao nhiêu?', ans:'6.25', cells:['6','.','2','5'],
    exp:'aabb = 1/4 × 1/4 = 1/16 = 0,0625 = 6,25%.' },
  { q:'Một gene có 2400 nucleotide và hiệu số A − G = 200. Số nucleotide loại G là bao nhiêu?', ans:'500', cells:['5','0','0',''],
    exp:'A + G = 1200; A − G = 200 ⇒ A = 700, G = 500.' },
  { q:'Một mRNA có 1500 nucleotide, vùng không dịch mã ở hai đầu chiếm 150 nucleotide. Chuỗi polypeptide hoàn chỉnh có bao nhiêu acid amin?', ans:'448', cells:['4','4','8',''],
    exp:'(1500 − 150)/3 = 450 codon. Trừ 1 codon kết thúc và 1 acid amin mở đầu: 450 − 2 = 448.' },
  { q:'Một loài có 2n = 20. Số nhiễm sắc thể trong tế bào sinh dưỡng của thể tam bội là bao nhiêu?', ans:'30', cells:['3','0','',''],
    exp:'Thể tam bội 3n = 3 × 10 = 30 NST (vì n = 10).' },
  { q:'Cơ thể có kiểu gene AaBbDd, ba cặp gene nằm trên ba cặp NST tương đồng khác nhau. Số loại giao tử tối đa là bao nhiêu?', ans:'8', cells:['8','','',''],
    exp:'2³ = 8 loại giao tử. Công thức 2ⁿ chỉ đúng khi các cặp gene phân li độc lập.' },
  { q:'Một tế bào sinh tinh có kiểu gene AaBb, giảm phân có hoán vị gene. Số loại tinh trùng tối đa tạo ra là bao nhiêu?', ans:'4', cells:['4','','',''],
    exp:'Một tế bào sinh tinh luôn chỉ cho tối đa 4 tinh trùng; có hoán vị thì 4 loại, không hoán vị thì 2 loại. Muốn đủ 4 loại phải có nhiều tế bào.' }
];

MCQS.push(...EXT2_MCQ);
TFS.push(...EXT2_TF);
SHORTS.push(...EXT2_SHORT);
/* =========================================================
   v2.0 — NỘI DUNG MỚI
   · 6 chuyên đề Tiến hoá + 5 chuyên đề Mendel mở rộng
   · 20 MCQ Tiến hoá + 15 MCQ Mendel mở rộng
   · 5 chùm Đúng/Sai + 5 Trả lời ngắn + 3 Tự luận
   ========================================================= */

TOPICS.th = { n: 'Tiến hóa', c: '#a78bfa' };
TOPICS.md = { n: 'Di truyền mở rộng', c: '#fb923c' };

/* ---------- LÝ THUYẾT MỞ RỘNG ---------- */
const THEORY2 = [
  /* ===== TIẾN HOÁ ===== */
  { group: 'evo', icon: 'fa-person-walking-arrow-right', title: 'Lamarck — đúng một nửa, sai ở chỗ then chốt', body: `
    <ul>
      <li><b>Nội dung:</b> cơ quan nào dùng nhiều thì phát triển, không dùng thì tiêu giảm; những biến đổi đó <b>di truyền</b> cho đời sau (di truyền tính tập nhiễm).</li>
      <li><b>Phần đúng:</b> môi trường thật sự ảnh hưởng tới kiểu hình — đó là <i>thường biến</i> và <i>mức phản ứng</i>. Ông cũng là người đầu tiên khẳng định sinh vật biến đổi chứ không cố định.</li>
      <li><b>Phần sai:</b> biến đổi do môi trường trong đời cá thể <b>không</b> làm thay đổi kiểu gene nên <b>không di truyền</b>. Không có cơ chế nào để “truyền” cái cổ dài ra cho con.</li>
      <li><b>Vì sao sai?</b> Lamarck thiếu khái niệm biến dị di truyền và chọn lọc. Ông cho rằng biến đổi có hướng, trong khi biến dị di truyền phát sinh <b>vô hướng</b>.</li>
    </ul>
    <div class="divider"></div>
    <b>Ví dụ kinh điển:</b> hươu cao cổ theo Lamarck “vươn cổ ăn lá cao nên cổ dài dần”; theo Darwin “quần thể vốn có con cổ dài hơn và cổ ngắn hơn, khi thức ăn chỉ còn trên cao thì con cổ dài sống sót và sinh sản nhiều hơn”.` },

  { group: 'evo', icon: 'fa-feather', title: 'Darwin — chọn lọc tự nhiên và ba điều kiện bắt buộc', body: `
    <ul>
      <li><b>Biến dị không định hướng:</b> trong quần thể đã có sẵn nhiều biến dị khác nhau, không nhằm “thích nghi” trước.</li>
      <li><b>Đấu tranh sinh tồn:</b> sinh vật sinh quá nhiều con so với nguồn sống ⇒ tranh giành thức ăn, nơi ở, bạn tình, chống kẻ thù.</li>
      <li><b>Chọn lọc tự nhiên:</b> cá thể nào có biến dị <i>có lợi</i> trong môi trường hiện tại thì sống sót và để lại nhiều con hơn ⇒ allele đó tăng tần số.</li>
      <li><b>Phân ly tính trạng:</b> qua nhiều thế hệ, các nhóm tích luỹ khác biệt dần ⇒ hình thành nòi, loài mới.</li>
    </ul>
    <b>Ba điều kiện để CLTN xảy ra:</b> (1) có biến dị di truyền; (2) biến dị đó ảnh hưởng tới khả năng sống sót – sinh sản; (3) tính trạng phải di truyền được. Thiếu một điều kiện là không có tiến hoá theo CLTN.
    <div class="divider"></div>
    <b>Bẫy:</b> “môi trường tạo ra biến dị cần thiết” — sai. Môi trường chỉ <i>sàng lọc</i> biến dị đã có.` },

  { group: 'evo', icon: 'fa-dna', title: 'Thuyết tiến hoá tổng hợp — đơn vị là quần thể', body: `
    <ul>
      <li><b>Đơn vị tiến hoá:</b> <b>quần thể</b>, không phải cá thể và không phải loài. Cá thể chỉ sống một đời, không tiến hoá.</li>
      <li><b>Năm nhân tố tiến hoá</b> (làm đổi tần số allele): đột biến · di nhập gen · chọn lọc tự nhiên · phiêu bạt gen · (một số tài liệu xếp giao phối không ngẫu nhiên là nhân tố làm đổi <i>tần số kiểu gene</i>).</li>
      <li><b>Đột biến:</b> nguồn nguyên liệu sơ cấp, tần số rất thấp (10⁻⁶–10⁻⁸) nhưng là nguồn duy nhất tạo allele mới.</li>
      <li><b>Di nhập gen (dòng gene):</b> làm đồng nhất hoá các quần thể, có thể mang allele có lợi vào nhanh hơn đột biến.</li>
      <li><b>Phiêu bạt gen:</b> biến động ngẫu nhiên, mạnh nhất ở quần thể <b>nhỏ</b>; có thể cố định allele có hại.</li>
      <li><b>Giao phối không ngẫu nhiên</b> (tự thụ, giao phối cận huyết): <i>không</i> đổi tần số allele nhưng tăng đồng hợp, giảm dị hợp.</li>
    </ul>
    <b>Công thức nền:</b> quần thể cân bằng có AA = p², Aa = 2pq, aa = q² với p + q = 1.` },

  { group: 'evo', icon: 'fa-code-branch', title: 'Hình thành loài — cách ly sinh sản là dấu chốt', body: `
    <ul>
      <li><b>Loài sinh học:</b> nhóm quần thể có khả năng giao phối với nhau trong tự nhiên và sinh ra con hữu thụ, <b>cách ly sinh sản</b> với nhóm khác.</li>
      <li><b>Cách ly trước hợp tử:</b> cách ly sinh thái, tập tính, mùa sinh sản, cơ học — ngăn không cho thụ tinh.</li>
      <li><b>Cách ly sau hợp tử:</b> con lai không sống, con lai bất thụ (la – lừa → la bất thụ).</li>
      <li><b>Khác khu (allopatric):</b> cách ly địa lý → tích luỹ khác biệt → cách ly sinh sản. Điển hình: sóc ở hai bờ Grand Canyon.</li>
      <li><b>Cùng khu (sympatric):</b> không cần cách ly địa lý — đa bội hoá (thực vật), chuyển cây chủ (côn trùng), cách ly tập tính.</li>
      <li><b>Đảo sinh thái:</b> ổ sinh thái tách biệt trong cùng vùng địa lý.</li>
    </ul>
    <b>Điểm dễ nhầm:</b> cách ly địa lý chỉ là <i>điều kiện hỗ trợ</i>, cái quyết định thành loài vẫn là <b>cách ly sinh sản</b>.` },

  { group: 'evo', icon: 'fa-seedling', title: 'Nguồn gốc sự sống và phát sinh loài người', body: `
    <ul>
      <li><b>Tiến hoá hoá học:</b> chất vô cơ → hợp chất hữu cơ đơn giản (acid amin, nucleotide) nhờ nguồn năng lượng (tia tử ngoại, phóng điện, nhiệt). Thí nghiệm Miller–Urey chứng minh điều này.</li>
      <li><b>Tiến hoá tiền sinh học:</b> các đại phân tử tập hợp thành <b>giọt coacerva</b> / túi lipid có màng bán thấm — có trao đổi chất sơ khai nhưng chưa có sinh sản.</li>
      <li><b>Tiến hoá sinh học:</b> xuất hiện tế bào có DNA, RNA, ribosome ⇒ chọn lọc tự nhiên bắt đầu hoạt động ở cấp tế bào.</li>
      <li><b>Khí quyển nguyên thuỷ:</b> <b>không có O₂</b>, nhiều CH₄, NH₃, H₂, hơi nước. O₂ chỉ xuất hiện sau quang hợp của vi khuẩn lam (đại tuyệt chủng hiếu khí).</li>
      <li><b>Mốc phát sinh loài người:</b> Australopithecus (đi thẳng, não ~500 cm³) → Homo habilis (công cụ đá) → Homo erectus (lửa, não ~900 cm³) → Homo sapiens (~1350 cm³, ngôn ngữ phức tạp).</li>
    </ul>
    <b>Đặc điểm người:</b> dáng đứng thẳng hoàn toàn, bàn chân có vòm, ngón cái đối diện, não lớn, <b>lồi cằm</b> (chỉ có ở người), bộ máy phát âm phức tạp.` },

  { group: 'evo', icon: 'fa-users', title: 'Tiến hoá văn hoá — khi gene không còn là động lực chính', body: `
    <ul>
      <li><b>Khác biệt cốt lõi:</b> tiến hoá sinh học truyền qua <i>gene</i> và cần nhiều thế hệ; tiến hoá văn hoá truyền qua <i>học hỏi</i> và có thể xảy ra trong một đời người.</li>
      <li><b>Ba trụ cột:</b> ngôn ngữ (truyền thông tin), công cụ (biến đổi môi trường), hợp tác (chia sẻ tri thức giữa các thế hệ).</li>
      <li><b>Đồng tiến hoá gene – văn hoá:</b> ví dụ dung nạp lactose ở người chăn nuôi — văn hoá chăn nuôi tạo áp lực chọn lọc cho gene lactase tồn tại ở người trưởng thành.</li>
      <li><b>Hệ quả:</b> văn hoá làm giảm áp lực chọn lọc tự nhiên trực tiếp (y học, nhà ở) nhưng tạo áp lực mới (dịch bệnh đô thị, chế độ ăn).</li>
    </ul>
    <b>Ý nghĩa:</b> con người vẫn đang tiến hoá — chỉ là tốc độ và hướng bị chi phối bởi văn hoá nhiều hơn bởi môi trường tự nhiên.` },

  /* ===== MENDEL MỞ RỘNG ===== */
  { group: 'md', icon: 'fa-diagram-project', title: 'Đa hiệu gene — một gene, nhiều tính trạng', body: `
    <ul>
      <li><b>Định nghĩa:</b> một gene ảnh hưởng tới <b>nhiều</b> tính trạng khác nhau (pleiotropy). Ngược lại, một tính trạng có thể do nhiều gene chi phối (tương tác gene).</li>
      <li><b>Ví dụ:</b> hội chứng Marfan (đột biến fibrillin-1) → cao lêu nghêu, ngón dài, phình động mạch chủ, lệch thuỷ tinh thể.</li>
      <li><b>HbS:</b> một đột biến điểm vừa gây <i>thiếu máu hình liềm</i> vừa cho <i>đề kháng sốt rét</i> — cũng là ví dụ về <b>ưu thế dị hợp tử</b>.</li>
      <li><b>Hệ quả:</b> không thể suy “một gene – một tính trạng”; chọn lọc tác động lên một tính trạng có thể kéo theo tính trạng khác (chọn lọc gián tiếp).</li>
    </ul>
    <b>Bẫy thi:</b> đa hiệu khác <i>tương tác cộng gộp</i>: đa hiệu là 1 → nhiều; cộng gộp là nhiều → 1.` },

  { group: 'md', icon: 'fa-droplet', title: 'Gene đa allele — nhóm máu ABO và HLA', body: `
    <ul>
      <li><b>Định nghĩa:</b> một locus có <b>nhiều hơn 2</b> allele trong quần thể (dù mỗi cá thể chỉ mang tối đa 2).</li>
      <li><b>ABO:</b> ba allele I<sup>A</sup>, I<sup>B</sup>, i. I<sup>A</sup> và I<sup>B</sup> đồng trội, cả hai trội hoàn toàn so với i ⇒ 4 nhóm máu, <b>6 kiểu gene</b>.</li>
      <li><b>Quy đổi:</b> A = I<sup>A</sup>I<sup>A</sup> hoặc I<sup>A</sup>i; B = I<sup>B</sup>I<sup>B</sup> hoặc I<sup>B</sup>i; AB = I<sup>A</sup>I<sup>B</sup>; O = ii.</li>
      <li><b>HLA:</b> hệ gene phức hợp miễn dịch, cực kỳ đa hình — nền tảng của việc thải ghép và đa dạng miễn dịch của quần thể.</li>
      <li><b>Ý nghĩa tiến hoá:</b> đa allele làm tăng đa dạng di truyền, giúp quần thể chống chịu tốt hơn trước thay đổi môi trường.</li>
    </ul>
    <b>Ứng dụng:</b> truyền máu, xác định huyết thống, cấy ghép tạng.` },

  { group: 'md', icon: 'fa-chart-column', title: 'Tương tác cộng gộp — tính trạng số lượng và h²', body: `
    <ul>
      <li><b>Cơ chế:</b> nhiều cặp gene cùng góp phần như nhau vào một tính trạng; mỗi allele trội thêm một “liều” hiệu quả.</li>
      <li><b>Công thức:</b> với <i>n</i> cặp gene, số kiểu hình = <b>2n + 1</b>; số kiểu gene = 3<sup>n</sup>.</li>
      <li><b>Đặc điểm:</b> phân bố kiểu hình dạng chuông (chuẩn), các giá trị trung gian phổ biến nhất.</li>
      <li><b>Hệ số di truyền h²</b> = V<sub>di truyền</sub> / V<sub>tổng</sub>. h² cao ⇒ phần lớn biến dị kiểu hình do gene; h² thấp ⇒ môi trường chi phối mạnh.</li>
      <li><b>Ứng dụng:</b> chọn giống cây trồng, vật nuôi — tính trạng có h² cao (khối lượng, năng suất) chọn lọc nhanh hiệu quả hơn.</li>
    </ul>
    <b>Ví dụ:</b> màu da người do khoảng 3–4 cặp gene cộng gộp + ảnh hưởng môi trường (tia UV).` },

  { group: 'md', icon: 'fa-circle-nodes', title: 'Di truyền ngoài nhân — dòng mẹ và dị tương đồng', body: `
    <ul>
      <li><b>Cơ sở:</b> ty thể và lục lạp có DNA vòng riêng, nhân đôi độc lập với nhân tế bào.</li>
      <li><b>Dòng mẹ:</b> hợp tử nhận tế bào chất (và ty thể) chủ yếu từ <b>trứng</b> ⇒ con biểu hiện kiểu hình theo mẹ, bố không truyền.</li>
      <li><b>Dị tương đồng (heteroplasmy):</b> một tế bào chứa <i>cả</i> ty thể bình thường và đột biến; khi phân bào, tỉ lệ chia ngẫu nhiên cho tế bào con ⇒ mức biểu hiện bệnh rất khác nhau giữa các con cùng mẹ.</li>
      <li><b>Hiệu ứng ngưỡng:</b> chỉ khi tỉ lệ ty thể đột biến vượt ngưỡng thì bệnh mới biểu hiện.</li>
      <li><b>Bệnh điển hình:</b> động kinh giật cơ (MERRF), teo thị giác Leber.</li>
    </ul>
    <b>Hệ quả chẩn đoán:</b> mẹ bệnh vẫn có thể sinh con hoàn toàn khoẻ — điều bất khả thi với bệnh do gene nhân theo Mendel.` },

  { group: 'md', icon: 'fa-temperature-half', title: 'Môi trường, mức phản ứng và epigenetics', body: `
    <ul>
      <li><b>Mức phản ứng:</b> giới hạn các kiểu hình mà <i>một kiểu gene</i> có thể tạo ra trước các môi trường khác nhau. Do kiểu gene quy định nên <b>di truyền được</b>.</li>
      <li><b>Thường biến:</b> biến đổi kiểu hình trong giới hạn đó, <b>không đổi kiểu gene</b>, không di truyền. Ví dụ: lá cây trên cao và dưới thấp khác nhau.</li>
      <li><b>Mềm dẻo kiểu hình:</b> khả năng “điều chỉnh” theo môi trường — cao ở loài sống nơi biến động, thấp ở loài ổn định.</li>
      <li><b>Epigenetics:</b> thay đổi <i>biểu hiện</i> gene mà không đổi trình tự DNA — chủ yếu nhờ <b>methyl hoá DNA</b> và <b>biến đổi histone</b>. Có thể truyền qua vài thế hệ tế bào, thậm chí qua giao tử.</li>
      <li><b>Ví dụ:</b> cặp sinh đôi cùng trứng lớn lên khác nhau do chế độ ăn, stress, hút thuốc — khác biệt đó là epigenetics, không phải đột biến.</li>
    </ul>
    <b>Câu chốt:</b> kiểu hình = kiểu gene × môi trường (+ yếu tố ngẫu nhiên).` }
];

/* ---------- CÂU HỎI ---------- */
const V2_MCQ = [
  /* ===== TIẾN HOÁ (20) ===== */
  { t:'th', q:'Theo Lamarck, nguyên nhân khiến cổ hươu cao cổ dài dần qua các thế hệ là:', o:['Do tập quán vươn cổ ăn lá cao, tính tập nhiễm này di truyền cho đời sau','Do chọn lọc tự nhiên giữ lại cá thể cổ dài','Do đột biến ngẫu nhiên tích luỹ','Do di nhập gene từ quần thể khác'], a:0,
    tip:'Lamarck: dùng nhiều → phát triển → di truyền tính tập nhiễm.', why:'Ông cho rằng biến đổi phát sinh theo nhu cầu và truyền được cho đời sau — đây chính là chỗ sai vì biến đổi kiểu hình không đổi kiểu gene.', trap:'Phương án “chọn lọc tự nhiên” là của Darwin, không phải Lamarck.' },
  { t:'th', q:'Điểm khác biệt cốt lõi giữa Darwin và Lamarck là:', o:['Darwin cho rằng biến dị phát sinh vô hướng và được sàng lọc; Lamarck cho rằng biến đổi có hướng và di truyền được','Darwin phủ nhận vai trò của môi trường','Lamarck không tin sinh vật biến đổi','Darwin cho rằng loài không thay đổi'], a:0,
    tip:'Vô hướng + sàng lọc (Darwin) > có hướng + tập nhiễm (Lamarck).', why:'Darwin tách rời “nguồn biến dị” khỏi “hướng chọn lọc”: biến dị có sẵn không định hướng, môi trường chỉ chọn lọc.', trap:'Lamarck vẫn tin sinh vật biến đổi — ông chỉ sai về cơ chế.' },
  { t:'th', q:'Theo thuyết tiến hoá tổng hợp hiện đại, đơn vị tiến hoá là:', o:['Quần thể','Cá thể','Loài','Hệ sinh thái'], a:0,
    tip:'Cá thể không tiến hoá vì chỉ sống một đời.', why:'Quần thể là đơn vị có vốn gene và tần số allele thay đổi qua các thế hệ — đó chính là tiến hoá.', trap:'Loài là đơn vị phân loại, không phải đơn vị tiến hoá.' },
  { t:'th', q:'Nhân tố nào sau đây KHÔNG làm thay đổi tần số allele của quần thể?', o:['Giao phối không ngẫu nhiên','Đột biến','Chọn lọc tự nhiên','Phiêu bạt gene'], a:0,
    tip:'Giao phối không ngẫu nhiên chỉ đổi tần số kiểu gene.', why:'Tự thụ hay cận huyết làm tăng đồng hợp, giảm dị hợp nhưng không đổi tỉ lệ allele trong vốn gene.', trap:'Ba nhân tố còn lại đều trực tiếp đổi tần số allele.' },
  { t:'th', q:'Phiêu bạt gene (biến động di truyền ngẫu nhiên) có ảnh hưởng mạnh nhất ở:', o:['Quần thể có kích thước nhỏ','Quần thể có kích thước lớn','Quần thể đang ngẫu phối hoàn toàn','Quần thể không có đột biến'], a:0,
    tip:'Mẫu càng nhỏ thì dao động ngẫu nhiên càng lớn.', why:'Ở quần thể nhỏ, chỉ vài cá thể chết hoặc không sinh sản đã làm tần số allele lệch mạnh; quần thể lớn “san phẳng” dao động này.', trap:'Kích thước quần thể là yếu tố quyết định, không phải kiểu sinh sản.' },
  { t:'th', q:'Loài sinh học được phân biệt với nhau chủ yếu bằng:', o:['Cách ly sinh sản','Khác biệt hình thái bên ngoài','Khác biệt nơi sống','Số lượng nhiễm sắc thể'], a:0,
    tip:'Tiêu chuẩn cốt lõi là khả năng giao phối và sinh con hữu thụ.', why:'Hai quần thể chỉ là hai loài khi đã có cách ly sinh sản — dù hình thái có thể rất giống nhau (loài đồng hình).', trap:'Hình thái chỉ là tiêu chuẩn hỗ trợ, nhiều loài giống hệt nhau về hình thái.' },
  { t:'th', q:'Hình thành loài khác khu (allopatric) bắt đầu bằng:', o:['Cách ly địa lý rồi tích luỹ khác biệt dẫn tới cách ly sinh sản','Đa bội hoá ngay trong một quần thể','Thay đổi tập tính giao phối','Lai xa giữa hai loài'], a:0,
    tip:'Khác khu = có rào cản địa lý trước.', why:'Rào cản địa lý chặn dòng gene, hai quần thể tiến hoá độc lập; khi gặp lại đã cách ly sinh sản.', trap:'Cách ly địa lý chỉ là điều kiện hỗ trợ — cái quyết định vẫn là cách ly sinh sản.' },
  { t:'th', q:'Con đường hình thành loài KHÔNG cần cách ly địa lý là:', o:['Đa bội hoá ở thực vật','Cách ly địa lý do sông đổi dòng','Tách mảng lục địa','Di cư sang đảo mới'], a:0,
    tip:'Đa bội hoá tạo cách ly sinh sản ngay lập tức.', why:'Thể đa bội lai với dạng lưỡng bội cho con bất thụ ⇒ cách ly sinh sản tức thời, không cần rào cản địa lý.', trap:'Ba phương án còn lại đều là hình thành loài khác khu.' },
  { t:'th', q:'Chọn lọc tự nhiên tác động trực tiếp lên:', o:['Kiểu hình, gián tiếp lên kiểu gene','Kiểu gene, gián tiếp lên kiểu hình','Trực tiếp lên DNA','Trực tiếp lên vốn gene của loài'], a:0,
    tip:'Chỉ kiểu hình mới “va chạm” với môi trường.', why:'Môi trường không nhìn thấy kiểu gene — nó chỉ sàng lọc cá thể có kiểu hình phù hợp, từ đó đổi tần số allele.', trap:'Đây là câu hỏi kinh điển, đáp án luôn là “kiểu hình”.' },
  { t:'th', q:'Chọn lọc vận động (directional selection) có đặc điểm:', o:['Đẩy tần số allele theo một hướng xác định','Giữ nguyên kiểu hình trung bình','Ưu tiên cả hai cực, loại trung gian','Không làm đổi tần số allele'], a:0,
    tip:'“Vận động” = dịch chuyển một chiều.', why:'Ví dụ bướm Biston: nền tối làm allele màu đen tăng liên tục theo một hướng.', trap:'“Ưu tiên hai cực” là chọn lọc phân hoá.' },
  { t:'th', q:'Kiểu chọn lọc làm quần thể tách thành hai nhóm khác biệt rõ và ít con lai trung gian là:', o:['Chọn lọc phân hoá','Chọn lọc vận động','Chọn lọc ổn định','Chọn lọc nhân tạo'], a:0,
    tip:'Phân hoá = tách hai cực.', why:'Chọn lọc phân hoá (disruptive) bất lợi cho kiểu hình trung gian, có thể dẫn tới hình thành loài cùng khu.', trap:'Chọn lọc ổn định thì ngược lại: loại hai cực, giữ trung bình.' },
  { t:'th', q:'Cơ quan tương đồng là bằng chứng tiến hoá vì:', o:['Cùng nguồn gốc nhưng có thể khác chức năng','Cùng chức năng nhưng khác nguồn gốc','Luôn có hình dạng giống nhau','Chỉ gặp ở động vật có xương sống'], a:0,
    tip:'Tương đồng = cùng tổ tiên; tương tự = cùng chức năng.', why:'Tay người, cánh dơi, vây cá voi có cùng bộ xương chi trước ⇒ thừa hưởng từ tổ tiên chung.', trap:'Cùng chức năng mà khác nguồn gốc là <i>cơ quan tương tự</i>, không phải tương đồng.' },
  { t:'th', q:'Cơ quan thoái hoá ở người như ruột thừa, xương cụt được giải thích là:', o:['Di tích của cơ quan từng có chức năng ở tổ tiên','Cơ quan mới đang hình thành','Kết quả của đột biến có lợi','Cơ quan tương tự'], a:0,
    tip:'Thoái hoá = dấu vết còn lại.', why:'Chúng từng hữu ích ở tổ tiên ăn thực vật, nay tiêu giảm nhưng vẫn còn di tích — bằng chứng quan hệ họ hàng.', trap:'Đây không phải cơ quan đang hình thành mà là đang mất dần chức năng.' },
  { t:'th', q:'Bằng chứng tiến hoá có sức thuyết phục nhất khi xét quan hệ họ hàng xa là:', o:['So sánh trình tự gene và protein','So sánh hình thái ngoài','So sánh tập tính','So sánh phân bố địa lý'], a:0,
    tip:'Càng ở mức phân tử càng ít bị môi trường che lấp.', why:'Trình tự gene/protein phản ánh trực tiếp lịch sử tiến hoá; hình thái dễ bị hội tụ tiến hoá làm sai lệch.', trap:'Hình thái có thể giống nhau do thích nghi, không do họ hàng.' },
  { t:'th', q:'Giai đoạn tạo ra các giọt coacerva có màng bán thấm thuộc:', o:['Tiến hoá tiền sinh học','Tiến hoá hoá học','Tiến hoá sinh học','Phát sinh loài người'], a:0,
    tip:'Trước khi có tế bào là “tiền sinh học”.', why:'Coacerva là tập hợp đại phân tử có trao đổi chất sơ khai nhưng chưa có bộ máy di truyền — bước đệm dẫn tới tế bào.', trap:'Tạo acid amin từ khí nguyên thuỷ mới là tiến hoá hoá học.' },
  { t:'th', q:'Khí quyển nguyên thuỷ của Trái Đất khác khí quyển hiện nay ở chỗ:', o:['Không có O₂ và giàu CH₄, NH₃, H₂','Giàu O₂ và nghèo CO₂','Không có hơi nước','Chỉ có N₂ và O₂'], a:0,
    tip:'O₂ chỉ xuất hiện sau quang hợp.', why:'Khí quyển khử (không O₂) là điều kiện để các hợp chất hữu cơ không bị oxy hoá phân huỷ ngay.', trap:'O₂ là sản phẩm của sinh vật, không phải nguyên liệu ban đầu.' },
  { t:'th', q:'Đặc điểm chỉ có ở người mà không có ở vượn người hiện đại là:', o:['Lồi cằm','Dáng đứng thẳng','Ngón cái đối diện','Não lớn'], a:0,
    tip:'Lồi cằm là dấu hiệu giải phẫu đặc trưng của người.', why:'Vượn cũng đứng thẳng một phần, cũng có ngón cái đối diện và não lớn; chỉ người có lồi cằm và bộ máy phát âm phức tạp.', trap:'“Dáng đứng thẳng” là điểm khác biệt với vượn <i>cổ</i>, không phải vượn hiện đại.' },
  { t:'th', q:'Vì sao quần thể nhỏ dễ “cố định” một allele có hại?', o:['Vì phiêu bạt gene mạnh, allele đó có thể lan ngẫu nhiên dù bất lợi','Vì đột biến xảy ra nhanh hơn','Vì chọn lọc tự nhiên không hoạt động','Vì quần thể nhỏ không có biến dị'], a:0,
    tip:'Quần thể nhỏ = dao động ngẫu nhiên lớn.', why:'Khi số cá thể ít, may rủi sinh sản làm allele có hại tăng tần số; hiệu ứng này lấn át chọn lọc.', trap:'Chọn lọc vẫn hoạt động, chỉ là bị phiêu bạt gene lấn át.' },
  { t:'th', q:'Phát biểu đúng về quan hệ giữa chọn lọc tự nhiên và biến dị là:', o:['CLTN không tạo ra biến dị, chỉ sàng lọc biến dị đã có sẵn','CLTN tạo ra biến dị cần thiết khi môi trường đổi','Biến dị luôn có lợi cho sinh vật','Không có biến dị thì CLTN vẫn tạo được tiến hoá'], a:0,
    tip:'Đây là điểm khác biệt cốt lõi với Lamarck.', why:'Biến dị phát sinh ngẫu nhiên từ đột biến và tổ hợp; CLTN chỉ làm thay đổi tần số allele theo hướng thích nghi.', trap:'“Môi trường tạo biến dị cần thiết” là quan điểm Lamarck, đã bị bác bỏ.' },

  { t:'th', q:'Kiểu chọn lọc giữ kiểu hình trung bình ổn định và loại bỏ cả hai cực là:', o:['Chọn lọc ổn định','Chọn lọc vận động','Chọn lọc phân hoá','Chọn lọc nhân tạo'], a:0,
    tip:'“Ổn định” = giữ nguyên kiểu hình phổ biến nhất.', why:'Ví dụ cân nặng trẻ sơ sinh: cả nhẹ cân và quá nặng đều giảm sức sống, nên kiểu hình trung bình được ưu thế.', trap:'“Loại bỏ trung gian” là chọn lọc phân hoá — ngược lại.' },

  /* ===== MENDEL MỞ RỘNG (15) ===== */
  { t:'md', q:'Hiện tượng đa hiệu gene là:', o:['Một gene ảnh hưởng tới nhiều tính trạng','Nhiều gene cùng quy định một tính trạng','Một tính trạng do một gene quy định','Hai allele cùng biểu hiện ở kiểu hình'], a:0,
    tip:'Đa hiệu: 1 → nhiều.', why:'Một protein có thể tham gia nhiều con đường chuyển hoá nên đột biến một gene gây nhiều hậu quả.', trap:'“Nhiều gene → một tính trạng” là tương tác gene, ngược lại.' },
  { t:'md', q:'Đột biến HbS vừa gây thiếu máu hình liềm vừa giúp đề kháng sốt rét. Đây là ví dụ của:', o:['Đa hiệu gene kèm ưu thế dị hợp tử','Tương tác cộng gộp','Gene đa allele','Di truyền ngoài nhân'], a:0,
    tip:'Một đột biến, hai hệ quả trái ngược.', why:'HbS ảnh hưởng cả cấu trúc hồng cầu (thiếu máu) và khả năng ký sinh trùng sốt rét phát triển; thể dị hợp có ưu thế ở vùng có sốt rét.', trap:'Đây không phải cộng gộp vì chỉ một locus tham gia.' },
  { t:'md', q:'Hệ nhóm máu ABO ở người có bao nhiêu allele và bao nhiêu kiểu gene?', o:['3 allele, 6 kiểu gene','2 allele, 3 kiểu gene','3 allele, 4 kiểu gene','4 allele, 10 kiểu gene'], a:0,
    tip:'I^A, I^B, i ⇒ tổ hợp 3 allele.', why:'I^AI^A, I^Ai, I^BI^B, I^Bi, I^AI^B, ii = 6 kiểu gene, 4 kiểu hình.', trap:'4 là số kiểu hình, không phải kiểu gene.' },
  { t:'md', q:'Bố nhóm máu AB, mẹ nhóm máu O. Con của họ KHÔNG THỂ có nhóm máu nào?', o:['AB và O','A và B','Chỉ A','Chỉ B'], a:0,
    tip:'Bố AB luôn cho A hoặc B; mẹ O luôn cho i.', why:'Con chỉ có thể là I^Ai (A) hoặc I^Bi (B); không thể AB (thiếu B/A từ mẹ) và không thể O (thiếu i từ bố).', trap:'Nhiều người nhầm rằng bố AB thì con có thể AB.' },
  { t:'md', q:'Hệ gene HLA ở người là ví dụ điển hình của:', o:['Gene đa allele với mức đa hình rất cao','Đa hiệu gene','Tương tác cộng gộp','Di truyền ty thể'], a:0,
    tip:'HLA có hàng nghìn biến thể trong quần thể.', why:'Đa hình HLA giúp quần thể có nhiều “cách” nhận diện kháng nguyên khác nhau — lợi thế trước dịch bệnh.', trap:'Đa hình không đồng nghĩa với đa hiệu.' },
  { t:'md', q:'Tính trạng do 3 cặp gene tương tác cộng gộp quy định sẽ có bao nhiêu kiểu hình?', o:['7','6','8','9'], a:0,
    tip:'Số kiểu hình = 2n + 1.', why:'n = 3 ⇒ 2×3 + 1 = 7 mức biểu hiện (từ 0 đến 6 allele trội).', trap:'8 là 2³ (số loại giao tử), không phải số kiểu hình.' },
  { t:'md', q:'Hệ số di truyền h² của một tính trạng cao cho biết:', o:['Phần lớn biến dị kiểu hình trong quần thể do gene quyết định','Tính trạng đó không chịu ảnh hưởng của môi trường','Mọi cá thể đều có kiểu hình giống nhau','Tính trạng do một gene quy định'], a:0,
    tip:'h² = V di truyền / V tổng.', why:'h² cao nghĩa là sai khác giữa các cá thể chủ yếu do khác biệt di truyền, nên chọn lọc có hiệu quả nhanh.', trap:'h² cao không có nghĩa là môi trường không ảnh hưởng chút nào.' },
  { t:'md', q:'Ở người, gene quy định bệnh do ty thể được truyền:', o:['Từ mẹ sang tất cả các con','Từ bố sang con trai','Từ bố sang tất cả các con','Theo quy luật phân li của Mendel'], a:0,
    tip:'Hợp tử nhận tế bào chất chủ yếu từ trứng.', why:'Tinh trùng gần như không đóng góp ty thể, nên bệnh ty thể di truyền theo dòng mẹ.', trap:'Con trai và con gái đều nhận từ mẹ nhưng chỉ con gái truyền tiếp.' },
  { t:'md', q:'Hiện tượng dị tương đồng (heteroplasmy) nghĩa là:', o:['Một tế bào chứa đồng thời ty thể bình thường và ty thể đột biến','Một người có hai bộ nhiễm sắc thể khác nguồn','Hai allele cùng biểu hiện kiểu hình','Đột biến xảy ra ở hai mạch DNA'], a:0,
    tip:'“Dị” = khác nhau, “tương đồng” = cùng loại bào quan.', why:'Tỉ lệ ty thể đột biến chia ngẫu nhiên khi phân bào nên mức biểu hiện bệnh rất khác nhau giữa các con cùng mẹ.', trap:'Đây không liên quan tới allele trên NST trong nhân.' },
  { t:'md', q:'Mức phản ứng của một kiểu gene là:', o:['Tập hợp các kiểu hình có thể có của kiểu gene đó trước các môi trường khác nhau','Khả năng đột biến của kiểu gene','Số kiểu hình do nhiều kiểu gene tạo ra','Mức độ biểu hiện của một allele trội'], a:0,
    tip:'Mức phản ứng do kiểu gene quy định, nên di truyền được.', why:'Ví dụ giống lúa có mức phản ứng rộng sẽ cho năng suất ổn định hơn trên nhiều vùng đất.', trap:'Mức phản ứng không phải là thường biến — nó là <i>giới hạn</i> của thường biến.' },
  { t:'md', q:'Thường biến có đặc điểm:', o:['Biến đổi kiểu hình, không đổi kiểu gene, không di truyền','Biến đổi kiểu gene, di truyền được','Luôn có hại cho sinh vật','Chỉ xảy ra ở thực vật'], a:0,
    tip:'Thường biến = phản ứng linh hoạt của kiểu hình.', why:'Cùng một kiểu gene nhưng điều kiện khác nhau cho kiểu hình khác nhau; khi môi trường trở lại bình thường, kiểu hình cũng trở lại.', trap:'Vì không đổi kiểu gene nên không truyền cho đời sau.' },
  { t:'md', q:'Epigenetics nghiên cứu:', o:['Thay đổi biểu hiện gene mà không thay đổi trình tự DNA','Đột biến thay thế nucleotide','Sự phân li của nhiễm sắc thể','Đột biến số lượng nhiễm sắc thể'], a:0,
    tip:'“Epi” = bên trên — trên nền trình tự DNA.', why:'Methyl hoá DNA và biến đổi histone làm gene bị “khoá” hoặc “mở” mà trình tự base vẫn nguyên.', trap:'Không có đột biến nào xảy ra trong epigenetics.' },
  { t:'md', q:'Tính trạng số lượng (năng suất, chiều cao) thường có đặc điểm:', o:['Do nhiều gene chi phối và chịu ảnh hưởng mạnh của môi trường','Do một gene chi phối hoàn toàn','Không chịu ảnh hưởng của môi trường','Chỉ biểu hiện ở một giới'], a:0,
    tip:'Số lượng = nhiều gene + môi trường.', why:'Phân bố dạng chuông, giá trị trung gian phổ biến; hệ số di truyền thường thấp hơn tính trạng chất lượng.', trap:'Không nên nhầm với tính trạng đơn gene có biểu hiện rõ ràng.' },
  { t:'md', q:'Người mẹ có nhóm máu Rh⁻ mang thai đứa con Rh⁺. Nguy cơ chính là:', o:['Mẹ sinh kháng thể chống hồng cầu con, gây thiếu máu tan máu ở thai','Con bị dị tật ống thần kinh','Mẹ bị thiếu máu thiếu sắt','Con không thể sinh ra được'], a:0,
    tip:'Bất đồng miễn dịch Rh giữa mẹ và thai.', why:'Hồng cầu con vào máu mẹ → mẹ tạo kháng thể anti-D → lần mang thai sau kháng thể qua nhau thai phá hồng cầu thai.', trap:'Đây là bất đồng miễn dịch, không phải đột biến gene của con.' },
  { t:'md', q:'Vì sao bệnh do gene lặn trên NST thường khó bị loại bỏ hoàn toàn khỏi quần thể bằng chọn lọc?', o:['Vì allele lặn vẫn tồn tại trong thể dị hợp mà chọn lọc không “thấy”','Vì allele lặn luôn trội hơn allele bình thường','Vì bệnh không di truyền','Vì thể dị hợp cũng bị chọn lọc loại bỏ'], a:0,
    tip:'Thể dị hợp mang allele lặn nhưng kiểu hình bình thường.', why:'Chọn lọc chỉ tác động lên kiểu hình, nên allele lặn “ẩn” trong dị hợp tiếp tục được truyền mà không bị loại.', trap:'Đây chính là lý do tư vấn di truyền quan trọng hơn chỉ điều trị người bệnh.' }
];

const V2_TF = [
  { title: 'Tiến hoá — Lamarck và Darwin', sub: [
    { text: 'Lamarck cho rằng biến đổi do sử dụng hay không sử dụng cơ quan có thể di truyền cho đời sau.', ans: true, exp: 'Đó chính là “di truyền tính tập nhiễm” — luận điểm trung tâm và cũng là chỗ sai của Lamarck.' },
    { text: 'Theo Darwin, biến dị phát sinh theo hướng có lợi cho sinh vật ngay từ đầu.', ans: false, exp: 'Biến dị phát sinh vô hướng, ngẫu nhiên; môi trường chỉ đóng vai trò sàng lọc chứ không định hướng biến dị.' },
    { text: 'Đấu tranh sinh tồn là một trong những cơ chế Darwin đề ra để giải thích chọn lọc tự nhiên.', ans: true, exp: 'Sinh vật sinh nhiều con hơn khả năng nuôi dưỡng ⇒ tranh giành nguồn sống ⇒ cá thể có biến dị có lợi sống sót nhiều hơn.' },
    { text: 'Cả Lamarck và Darwin đều đã nêu được vai trò của đột biến gene.', ans: false, exp: 'Thời đó chưa biết đến gene và đột biến; khái niệm biến dị di truyền ở mức phân tử chỉ có sau này.' }
  ]},
  { title: 'Tiến hoá quần thể và nhân tố tiến hoá', sub: [
    { text: 'Giao phối không ngẫu nhiên làm thay đổi tần số allele của quần thể.', ans: false, exp: 'Nó chỉ làm tăng đồng hợp và giảm dị hợp; tần số allele giữ nguyên nếu không có nhân tố khác.' },
    { text: 'Phiêu bạt gene có thể làm một allele có hại trở nên phổ biến trong quần thể nhỏ.', ans: true, exp: 'Dao động ngẫu nhiên mạnh ở quần thể ít cá thể, có thể “cố định” allele bất lợi bất chấp chọn lọc.' },
    { text: 'Đột biến là nguồn nguyên liệu sơ cấp duy nhất tạo ra allele mới cho tiến hoá.', ans: true, exp: 'Di nhập gene chỉ mang allele đã có từ quần thể khác; chỉ đột biến mới tạo allele hoàn toàn mới.' },
    { text: 'Quần thể đạt cân bằng Hardy–Weinberg ngay sau một thế hệ ngẫu phối nếu không có nhân tố tiến hoá.', ans: true, exp: 'Chỉ cần một thế hệ ngẫu phối là cấu trúc p² : 2pq : q² được thiết lập và giữ nguyên.' }
  ]},
  { title: 'Hình thành loài', sub: [
    { text: 'Cách ly địa lý luôn dẫn tới hình thành loài mới.', ans: false, exp: 'Cách ly địa lý chỉ tạo điều kiện; nếu hai quần thể vẫn gặp nhau và sinh sản được thì vẫn là một loài.' },
    { text: 'Đa bội hoá có thể tạo loài mới ngay trong cùng một khu vực địa lý.', ans: true, exp: 'Thể đa bội lai với dạng lưỡng bội cho con bất thụ ⇒ cách ly sinh sản tức thời, không cần rào cản địa lý.' },
    { text: 'Con lai giữa ngựa và lừa (la) là bằng chứng của cách ly sau hợp tử.', ans: true, exp: 'Hợp tử vẫn hình thành nhưng con lai bất thụ — cách ly sinh sản xuất hiện sau khi thụ tinh.' },
    { text: 'Tiêu chuẩn hình thái là tiêu chuẩn duy nhất và đáng tin cậy nhất để phân biệt hai loài.', ans: false, exp: 'Nhiều loài đồng hình gần như giống hệt nhau về hình thái; tiêu chuẩn cốt lõi là cách ly sinh sản và dữ liệu phân tử.' }
  ]},
  { title: 'Mendel mở rộng', sub: [
    { text: 'Một gene có thể ảnh hưởng tới nhiều tính trạng khác nhau.', ans: true, exp: 'Đó là đa hiệu gene — ví dụ hội chứng Marfan do một đột biến nhưng biểu hiện ở xương, mắt và tim mạch.' },
    { text: 'Trong hệ ABO, người nhóm máu A chỉ có một kiểu gene duy nhất.', ans: false, exp: 'Nhóm A có hai kiểu gene: I^AI^A và I^Ai. Chỉ nhóm O mới có kiểu gene duy nhất là ii.' },
    { text: 'Với tương tác cộng gộp của 3 cặp gene, quần thể có 7 mức kiểu hình.', ans: true, exp: 'Số kiểu hình = 2n + 1 = 2×3 + 1 = 7, tương ứng số allele trội từ 0 đến 6.' },
    { text: 'Bệnh do gene ty thể luôn biểu hiện giống hệt nhau ở mọi người con của cùng một bà mẹ bệnh.', ans: false, exp: 'Do dị tương đồng, tỉ lệ ty thể đột biến trong mỗi trứng là ngẫu nhiên nên mức biểu hiện rất khác nhau.' }
  ]},
  { title: 'Di truyền ngoài nhân và môi trường', sub: [
    { text: 'Ở người, ty thể được thừa hưởng chủ yếu từ mẹ.', ans: true, exp: 'Tế bào chất của hợp tử gần như hoàn toàn từ trứng; tinh trùng hầu như không đóng góp ty thể.' },
    { text: 'Thường biến có thể di truyền cho thế hệ sau vì nó làm thay đổi kiểu gene.', ans: false, exp: 'Thường biến chỉ đổi kiểu hình, kiểu gene nguyên vẹn nên không di truyền.' },
    { text: 'Mức phản ứng của một kiểu gene là do kiểu gene quy định nên bản thân nó di truyền được.', ans: true, exp: 'Giới hạn phản ứng là thuộc tính của kiểu gene — chọn giống dựa trên mức phản ứng rộng cho năng suất ổn định.' },
    { text: 'Methyl hoá DNA là một cơ chế epigenetics làm thay đổi trình tự nucleotide.', ans: false, exp: 'Methyl hoá gắn nhóm methyl lên base nhưng KHÔNG đổi trình tự; nó chỉ làm gene khó phiên mã.' }
  ]}
];

const V2_SHORT = [
  { q:'Quần thể ngẫu phối cân bằng có tần số allele a = 0,4 và gồm 1000 cá thể. Số cá thể dị hợp tử là bao nhiêu?', ans:'480', cells:['4','8','0',''],
    exp:'p = 0,6; q = 0,4 ⇒ Aa = 2pq = 0,48 ⇒ 0,48 × 1000 = 480 cá thể.' },
  { q:'Một quần thể cân bằng có 64% cá thể mang kiểu hình lặn. Tần số allele trội A là bao nhiêu %?', ans:'20', cells:['2','0','',''],
    exp:'q² = 0,64 ⇒ q = 0,8 ⇒ p = 1 − 0,8 = 0,2 = 20%.' },
  { q:'Một loài có 2n = 24. Thể tứ bội của loài này có bao nhiêu nhiễm sắc thể?', ans:'48', cells:['4','8','',''],
    exp:'Tứ bội 4n = 4 × 12 = 48 NST (vì n = 12).' },
  { q:'Tính trạng do 3 cặp gene tương tác cộng gộp. Số lớp kiểu hình khác nhau là bao nhiêu?', ans:'7', cells:['7','','',''],
    exp:'Số kiểu hình = 2n + 1 = 2×3 + 1 = 7 lớp, ứng với 0 đến 6 allele trội.' },
  { q:'Bố nhóm máu AB, mẹ nhóm máu O. Xác suất sinh con nhóm máu A là bao nhiêu %?', ans:'50', cells:['5','0','',''],
    exp:'Bố cho A hoặc B với xác suất bằng nhau, mẹ luôn cho i ⇒ 50% I^Ai (nhóm A), 50% I^Bi (nhóm B).' }
];

const V2_ESSAY = [
  { id: 'Câu 13', title: 'Vì sao bướm Biston betularia đen lại tăng nhanh ở vùng công nghiệp?',
    sum: 'Bồ hóng làm nền tối ⇒ bướm đen được nguỵ trang tốt hơn, bướm trắng bị chim ăn nhiều hơn ⇒ allele quy định màu đen tăng tần số.',
    tach: '<b>1. Hiện tượng:</b> Từ giữa thế kỷ 19 ở Manchester, tỉ lệ bướm đen (carbonaria) tăng từ dưới 1% lên hơn 90% trong khoảng 50 thế hệ, rồi giảm trở lại khi Luật không khí sạch có hiệu lực.<br><b>2. Cơ chế:</b> Đây là <b>chọn lọc tự nhiên vận động</b>. Trước công nghiệp, thân cây phủ địa y sáng nên bướm đen tương phản, bị chim ăn nhiều. Khi bồ hóng phủ đen thân cây, chính bướm trắng lại nổi bật. Cá thể mang allele màu đen sống sót và sinh sản nhiều hơn ⇒ tần số allele đen tăng.<br><b>3. Bằng chứng:</b> Thí nghiệm của Kettlewell (1950) thả bướm đánh dấu ở hai môi trường cho thấy tỉ lệ bị ăn khác nhau rõ rệt theo màu nền.<br><b>4. Kết luận:</b> Chọn lọc <i>không tạo ra</i> allele mới — nó chỉ đổi tần số allele đã có. Đây là ví dụ hai chiều chứng minh CLTN vừa đủ để giải thích thích nghi.',
    gop: 'Nền tối ⇒ đen được nguỵ trang ⇒ đen tăng. Nền sáng ⇒ trắng được nguỵ trang ⇒ đen giảm. Chọn lọc đổi tần số, không tạo allele.' },
  { id: 'Câu 14', title: 'Phân biệt tần số allele và tần số kiểu gene. Vì sao tự phối không làm đổi tần số allele?',
    sum: 'Tần số allele đếm trên vốn gene; tần số kiểu gene đếm trên cá thể. Tự phối chỉ tái tổ hợp lại các allele đã có nên tần số allele giữ nguyên.',
    tach: '<b>1. Định nghĩa:</b> Tần số allele là tỉ lệ một allele trên tổng số allele của locus trong vốn gene. Tần số kiểu gene là tỉ lệ cá thể mang kiểu gene đó.<br><b>2. Liên hệ:</b> Với hai allele A, a: p = f(AA) + ½f(Aa); q = f(aa) + ½f(Aa). Quần thể cân bằng thì f(AA) = p², f(Aa) = 2pq, f(aa) = q².<br><b>3. Tự phối:</b> Mỗi cá thể Aa tự thụ cho ¼ AA : ½ Aa : ¼ aa — allele A và a vẫn được truyền với tỉ lệ 1:1 như cũ. Sau n thế hệ, Aa giảm còn Aa₀/2ⁿ, đồng hợp tử tăng tương ứng, nhưng p và q <b>không đổi</b>.<br><b>4. Ý nghĩa:</b> Tự phối làm tăng đồng hợp ⇒ biểu hiện các allele lặn có hại (thoái hoá giống), nhưng không làm mất allele. Muốn đổi tần số allele phải có đột biến, chọn lọc, di nhập hoặc phiêu bạt gene.',
    gop: 'p = f(AA) + ½f(Aa). Tự phối: Aa → ¼AA + ½Aa + ¼aa, allele vẫn 1:1 ⇒ p, q không đổi; chỉ kiểu gene đổi.' },
  { id: 'Câu 15', title: 'Vì sao bệnh do gene lặn trên nhiễm sắc thể X gặp ở nam nhiều hơn nữ?',
    sum: 'Nam chỉ có một X nên mọi allele lặn đều biểu hiện (bán hợp tử); nữ cần cả hai X mang allele lặn mới bệnh.',
    tach: '<b>1. Cơ sở:</b> Nam có kiểu NST giới tính XY, chỉ mang một allele cho mỗi gene trên X. Không có allele tương ứng trên Y để “bù trừ” ⇒ trạng thái <b>bán hợp tử</b>, allele lặn biểu hiện ngay.<br><b>2. Ở nữ:</b> XX nên phải đồng hợp lặn (XᵃXᵃ) mới biểu hiện; XᴬXᵃ là thể mang gene, kiểu hình bình thường.<br><b>3. Di truyền chéo:</b> Bố bệnh truyền Xᵃ cho <i>tất cả</i> con gái (thành thể mang gene), không truyền cho con trai. Mẹ mang gene truyền Xᵃ cho 50% con trai ⇒ con trai bệnh.<br><b>4. Hệ quả quần thể:</b> Vì nam chỉ cần một allele, tần số bệnh ở nam xấp xỉ q, còn ở nữ xấp xỉ q². Với bệnh mù màu q ≈ 0,08: nam ≈ 8%, nữ ≈ 0,64% — chênh hơn 10 lần.<br><b>5. Ứng dụng:</b> Cần tư vấn di truyền cho nữ mang gene và xét nghiệm trước sinh khi mẹ là thể mang.',
    gop: 'Nam XY: một X ⇒ lặn biểu hiện ngay. Nữ XX: cần cả hai lặn. Tần số bệnh nam ≈ q, nữ ≈ q².' }
];

MCQS.push(...V2_MCQ);
TFS.push(...V2_TF);
SHORTS.push(...V2_SHORT);
ESSAYS.push(...V2_ESSAY);

/* =========================================================
   v3.0 — NGÂN HÀNG CÂU HỎI TƯ DUY (6 TEMPLATE)
   tpl: 1 case study · 2 thí nghiệm ngược · 3 bảng số liệu
        4 đa bước · 5 phản biện · 6 bẫy ngôn ngữ
   ========================================================= */

const V3_MCQ = [
  /* ============ TEMPLATE 1 — CASE STUDY (10) ============ */
  { tpl:1, t:'dv', q:'Nam 19 tuổi, BMI 18, mệt mỏi 3 tuần. Xét nghiệm: glucose 22 mmol/L, pH máu 7,18, HCO₃⁻ 9 mmol/L, ceton niệu +++ , K⁺ 5,6 mmol/L. Cơ chế nào giải thích hợp lý NHẤT cho pH máu thấp?', o:['Tế bào không nhận được glucose nên đốt mỡ dự trữ, sinh thể ceton là acid mạnh','Tăng thông khí làm giảm CO₂ máu','Thận tái hấp thu HCO₃⁻ quá mức','Tăng tái hấp thu Na⁺ ở ống lượn gần'], a:0,
    tip:'Ghép 3 dữ kiện: BMI thấp + ceton +++ + pH thấp.', why:'BMI thấp, ceton mạnh và toan chuyển hoá là bộ ba của nhiễm toan ceton do thiếu insulin tuyệt đối (type 1). Thiếu insulin ⇒ glucose ứ trong máu nhưng tế bào “đói” ⇒ tăng phân giải mỡ ⇒ acid béo chuyển thành thể ceton (acetoacetate, β-hydroxybutyrate) ⇒ pH giảm. Thở nhanh (Kiểu Kussmaul) là phản ứng bù trừ, không phải nguyên nhân.', trap:'Tăng thông khí làm GIẢM CO₂ nên pH TĂNG — đó là bù trừ, không phải nguyên nhân gây toan.' },
  { tpl:1, t:'tv', q:'Cây cà chua trồng trên đất pH 7,8: lá NON vàng nhạt nhưng gân vẫn xanh, lá già bình thường. Phân tích đất cho thấy lượng Fe tổng số cao nhưng Fe hoà tan rất thấp. Nguyên nhân hợp lý nhất?', o:['Fe bị kết tủa ở pH kiềm nên rễ không hấp thu được, dù đất nhiều Fe','Thiếu N vì N dễ bị rửa trôi','Thiếu Mg vì Mg là nguyên tố di động','Ngộ độc Al làm hỏng rễ'], a:0,
    tip:'Lá non vàng + gân xanh + Fe tổng cao nhưng Fe hoà tan thấp.', why:'Ở pH kiềm, Fe³⁺ kết tủa thành oxide/hydroxide không tan nên rễ không hấp thu được — đây là “thiếu Fe do kiềm” điển hình. Fe không tái sử dụng được trong cây nên lá NON vàng trước, còn gân vẫn xanh vì Fe còn trong mạch. Khắc phục: phun Fe-chelate lên lá hoặc hạ pH đất.', trap:'Thiếu N gây vàng từ lá GIÀ trước; thiếu Mg cũng vàng lá già. Vị trí lá bệnh là dữ kiện phân biệt.' },
  { tpl:1, t:'dt', q:'Nữ 25 tuổi, Hb 10 g/dL, MCV 68 fL, ferritin bình thường, HbA₂ 5,2% (bình thường < 3,5%). Kết luận hợp lý nhất?', o:['Beta-thalassemia thể nhẹ: giảm tổng hợp chuỗi β nên hồng cầu nhỏ, nhưng sắt dự trữ không thiếu','Thiếu máu thiếu sắt nặng','Thiếu máu do thiếu vitamin B12','Bệnh hồng cầu hình liềm'], a:0,
    tip:'Hồng cầu nhỏ + ferritin BÌNH THƯỜNG + HbA₂ tăng.', why:'Thiếu sắt cũng gây hồng cầu nhỏ nhưng ferritin phải giảm. Ferritin bình thường loại trừ thiếu sắt; HbA₂ tăng là dấu hiệu đặc trưng của beta-thalassemia thể nhẹ (tăng bù chuỗi δ). Đây là lý do không được chỉ dựa vào MCV để kết luận thiếu sắt.', trap:'MCV thấp không đồng nghĩa thiếu sắt — phải xem ferritin và điện di Hb.' },
  { tpl:1, t:'dv', q:'Bệnh nhân suy tim dùng furosemide (lợi tiểu quai) 2 tuần: K⁺ 3,1 mmol/L, pH 7,50. Cơ chế gây hạ kali máu?', o:['Thuốc ức chế tái hấp thu Na⁺ ở nhánh lên quai Henle, Na⁺ xuống ống góp nhiều nên trao đổi Na⁺–K⁺ tăng, thải K⁺ nhiều hơn','Thuốc làm tăng tái hấp thu K⁺ ở ống lượn gần','Thuốc ức chế trực tiếp aldosterone','Thuốc làm giảm áp lực lọc cầu thận'], a:0,
    tip:'Lợi tiểu quai chặn NKCC2 ở nhánh lên ⇒ Na⁺ ứ lại phía dưới.', why:'Furosemide chặn đồng vận chuyển Na⁺–K⁺–2Cl⁻ ở nhánh lên quai Henle, làm Na⁺ xuống ống góp nhiều. Tại ống góp, Na⁺ được tái hấp thu đổi lấy K⁺ bài tiết (qua kênh ENaC và ROMK, dưới tác dụng aldosterone) ⇒ mất K⁺. Đồng thời thể tích giảm kích hoạt hệ renin–angiotensin–aldosterone, càng tăng thải K⁺. Toan kiềm do mất H⁺ và Cl⁻.', trap:'“Lợi tiểu giữ kali” (spironolactone) mới là thuốc ức chế aldosterone — ngược lại với furosemide.' },
  { tpl:1, t:'nst', q:'Trẻ sơ sinh: trương lực cơ giảm, da cổ có nếp gấp, phù mu bàn chân, siêu âm tim phát hiện hẹp eo động mạch chủ. Karyotype cần chỉ định và dự đoán kết quả?', o:['Karyotype — dự đoán 45,X (Turner)','Karyotype — dự đoán 47,XXY (Klinefelter)','Karyotype — dự đoán 47,+21 (Down)','Không cần karyotype vì đây là bệnh tim bẩm sinh đơn thuần'], a:0,
    tip:'Nếp gấp da cổ + phù bàn chân + hẹp eo động mạch chủ = bộ ba Turner.', why:'45,X gây hội chứng Turner ở nữ: lùn, cổ ngắn có nếp gấp (pterygium colli), phù bạch huyết bàn chân ở sơ sinh, và khoảng 30% có hẹp eo động mạch chủ. Karyotype là xét nghiệm khẳng định.', trap:'Klinefelter là nam, biểu hiện muộn ở tuổi dậy thì; Down có bàn tay vuông, nếp ngang, không điển hình phù bàn chân.' },
  { tpl:1, t:'ql', q:'Phả hệ: bố mẹ đều bình thường sinh 2 con trai bệnh, 1 con gái bình thường; anh trai của mẹ cũng bị bệnh. Quy luật di truyền hợp lý nhất?', o:['Lặn trên NST X — mẹ mang gene, bệnh biểu hiện ở nam','Trội trên NST X','Lặn trên NST thường','Trội trên NST thường'], a:0,
    tip:'Chỉ nam bệnh + mẹ bình thường + bên ngoại có người bệnh.', why:'Bố mẹ bình thường sinh con bệnh ⇒ gene lặn. Chỉ nam bệnh, không có nữ bệnh, và bệnh xuất hiện bên ngoại qua dòng mẹ ⇒ lặn trên X. Mẹ là thể mang X^A X^a, truyền X^a cho 50% con trai. Anh trai của mẹ bệnh vì bà ngoại cũng là thể mang.', trap:'Lặn trên NST thường cũng cho bố mẹ bình thường → con bệnh, nhưng sẽ có cả nữ bệnh và không có kiểu “chỉ nam, chéo qua mẹ”.' },
  { tpl:1, t:'dt', q:'Bệnh nhân dùng rifampicin 2 tuần, nồng độ thuốc chống đông dùng kèm giảm mạnh dù không đổi liều. Cơ chế phân tử hợp lý nhất?', o:['Rifampicin cảm ứng phiên mã các gene CYP450 ở gan, tăng lượng enzyme nên thuốc kia bị chuyển hoá nhanh hơn','Rifampicin ức chế dịch mã của tế bào gan','Rifampicin gây đột biến gene CYP450','Rifampicin làm tăng thải thuốc qua thận'], a:0,
    tip:'“Cảm ứng enzyme” là tăng PHIÊN MÃ, không phải tăng hoạt tính sẵn có.', why:'Rifampicin gắn vào thụ thể nhân PXR, hoạt hoá phiên mã nhóm gene CYP3A4 và các enzyme chuyển hoá pha I/II ⇒ nhiều enzyme hơn ⇒ thuốc dùng kèm bị phân huỷ nhanh, nồng độ máu giảm, mất tác dụng. Đây là tương tác thuốc kinh điển, hết sau 1–2 tuần ngừng thuốc.', trap:'“Cảm ứng enzyme” không phải đột biến và không phải ức chế — nó là tăng biểu hiện gene.' },
  { tpl:1, t:'tb', q:'Tế bào ung thư trong môi trường đủ O₂ vẫn chuyển phần lớn glucose thành lactate (hiệu ứng Warburg). Giải thích hợp lý nhất?', o:['Chuyển hoá nhanh qua glycolysis cung cấp carbon cho tổng hợp đại phân tử, đáp ứng nhu cầu sinh khối','Vì ty thể của tế bào ung thư bị mất hoàn toàn','Vì tế bào ung thư luôn thiếu O₂','Vì tế bào ung thư tăng hô hấp hiếu khí tối đa'], a:0,
    tip:'Warburg không phải “ung thư không có ty thể”.', why:'Tế bào ung thư vẫn có ty thể và vẫn dùng chuỗi truyền electron, nhưng ưu tiên glycolysis vì (1) tốc độ ATP nhanh hơn trên mỗi giây, (2) tạo nhiều trung gian carbon (ribose, acid amin, lipid) cho phân chia nhanh, (3) môi trường khối u thường thiếu O₂ cục bộ. Đây là cơ sở để dùng PET-FDG phát hiện khối u.', trap:'Nếu ty thể mất hoàn toàn thì tế bào không sống được — chúng chỉ giảm ưu tiên, không mất chức năng.' },
  { tpl:1, t:'th', q:'Bệnh nhân tự ý ngừng kháng sinh khi thấy đỡ, 3 tuần sau nhiễm lại với chủng kháng thuốc. Giải thích theo thuyết tiến hoá?', o:['Allele kháng đã có sẵn trong quần thể; kháng sinh diệt các cá thể nhạy cảm nên allele kháng được khuếch đại','Vi khuẩn “học” được cách kháng thuốc trong quá trình bị diệt','Kháng sinh tạo ra đột biến kháng ở vi khuẩn','Do hệ miễn dịch của bệnh nhân suy yếu'], a:0,
    tip:'Kháng sinh là áp lực chọn lọc, không phải tác nhân tạo đột biến.', why:'Trong quần thể vi khuẩn khổng lồ luôn có sẵn một số cá thể mang đột biến/plasmid kháng. Dùng kháng sinh ⇒ cá thể nhạy cảm chết, cá thể kháng sống và sinh sản ⇒ tần số allele kháng tăng vọt. Ngừng thuốc sớm giết chưa hết, để lại đúng nhóm kháng.', trap:'“Vi khuẩn học cách kháng” là quan điểm Lamarck; “kháng sinh tạo đột biến” là sai — chọn lọc không tạo biến dị.' },
  { tpl:1, t:'tv', q:'Nhà kính tăng CO₂ lên 1000 ppm: 3 ngày đầu quang hợp tăng 35%, sang tuần thứ hai chỉ còn tăng 8% và lá non có ít Rubisco hơn. Giải thích hợp lý nhất?', o:['Cây giảm tổng hợp Rubisco khi CO₂ dư (điều hoà ngược), nên lợi ích giảm dần','CO₂ ức chế trực tiếp pha sáng','Cây bị ngộ độc CO₂ ở 1000 ppm','Ánh sáng trong nhà kính giảm dần'], a:0,
    tip:'Lợi ích giảm dần kèm GIẢM Rubisco = thích nghi điều hoà ngược.', why:'Khi CO₂ dư, sản phẩm quang hợp tích luỹ ức chế ngược phiên mã các gene quang hợp (đặc biệt rbcS mã hoá tiểu đơn vị nhỏ của Rubisco). Cây “đầu tư” ít enzyme hơn vì hiệu suất mỗi phân tử cao hơn. Đây là hiện tượng down-regulation, giải thích vì sao nồng độ CO₂ cao không tăng năng suất tuyến tính mãi.', trap:'Đây là điều hoà biểu hiện gene, không phải ngộ độc — nồng độ 1000 ppm vẫn thấp hơn nhiều ngưỡng gây hại.' },

  /* ============ TEMPLATE 2 — THÍ NGHIỆM NGƯỢC (7) ============ */
  { tpl:2, t:'tv', q:'Thí nghiệm: tảo lục chiếu sáng đơn sắc cùng cường độ. Lượng O₂ (đơn vị tương đối): đỏ 100, xanh lam 92, xanh lục 18, vàng 25. Nếu chiếu ĐỒNG THỜI đỏ + xanh lam thì kết quả hợp lý nhất?', o:['Khoảng 190, gần bằng tổng vì cả hai vùng đều được diệp lục hấp thụ mạnh','Khoảng 100 vì đỏ đã bão hoà','Khoảng 18 vì xanh lam ức chế','Khoảng 250 vì hai bước sóng cộng hưởng'], a:0,
    tip:'Hai vùng hấp thụ mạnh của chlorophyll a: ~430 nm (lam) và ~660 nm (đỏ).', why:'Diệp lục hấp thụ mạnh cả vùng đỏ và xanh lam nên khi chiếu đồng thời, hai hệ photosystem được cấp năng lượng từ hai vùng khác nhau, quang hợp gần bằng tổng (trừ hiệu suất vận chuyển electron). Xanh lục bị phản xạ nên rất kém — đó là lý do lá có màu lục.', trap:'“Đỏ đã bão hoà” chỉ đúng khi cường độ rất cao; ở đây hai vùng bổ sung cho nhau chứ không cạnh tranh.' },
  { tpl:2, t:'dt', q:'Nếu DNA tái bản theo cơ chế BẢO TOÀN (conservative) thì sau 2 thế hệ nuôi trong N¹⁴ (bắt đầu từ DNA hoàn toàn N¹⁵) sẽ thu được gì?', o:['1 phân tử nặng N¹⁵ nguyên vẹn + 3 phân tử nhẹ N¹⁴ hoàn toàn','2 phân tử lai + 2 phân tử nhẹ','4 phân tử lai','1 nặng + 1 lai + 2 nhẹ'], a:0,
    tip:'Bảo toàn = giữ nguyên cả hai mạch gốc trong một phân tử.', why:'Cơ chế bảo toàn cho một DNA “mẹ” nguyên vẹn N¹⁵ và một DNA mới hoàn toàn N¹⁴ ở thế hệ 1; thế hệ 2 tiếp tục cho 1 nặng + 3 nhẹ. Thực tế Meselson–Stahl thu được 2 lai + 2 nhẹ ⇒ bác bỏ mô hình này, khẳng định bán bảo toàn.', trap:'Đây là câu hỏi ngược: phải suy ra kết quả của mô hình SAI để hiểu vì sao nó bị bác bỏ.' },
  { tpl:2, t:'tv', q:'Chiếu ánh sáng xanh dương (450 nm) cường độ thấp vào biểu bì lá → khí khổng mở mạnh. Chiếu ánh sáng đỏ (660 nm) cùng cường độ → khí khổng gần như không mở. Kết luận hợp lý nhất?', o:['Khí khổng mở nhờ photoreceptor hấp thụ ánh sáng xanh (phototropin), không chỉ nhờ quang hợp chung','Chỉ cần ánh sáng mạnh là khí khổng mở','Ánh sáng đỏ không được lá hấp thụ','Khí khổng mở do nhiệt năng của ánh sáng'], a:0,
    tip:'Ánh sáng đỏ mạnh cho quang hợp, nhưng xanh dương mới mở khí khổng.', why:'Phototropin (hấp thụ 400–500 nm) hoạt hoá bơm H⁺-ATPase trên màng tế bào hạt đậu ⇒ K⁺ vào ⇒ nước vào ⇒ tế bào trương ⇒ khí khổng mở. Đây là phản ứng “tìm sáng” độc lập với tốc độ quang hợp, giải thích vì sao khí khổng mở rất sớm trước khi quang hợp đạt cực đại.', trap:'Ánh sáng đỏ vẫn được hấp thụ mạnh — nó chỉ không kích hoạt phototropin.' },
  { tpl:2, t:'dv', q:'Thí nghiệm: dịch tụy + lòng trắng trứng → tan dần. Đun dịch tụy 100 °C trong 10 phút → không tan. Thêm dịch tụy MỚI vào mẫu đã đun → tan trở lại. Kết luận đúng?', o:['Enzyme bị biến tính do nhiệt, không phải do cơ chất bị phá huỷ','Cơ chất bị phá huỷ ở 100 °C','Nhiệt độ cao làm phản ứng đảo chiều','Phản ứng cần ATP nên bị ngừng'], a:0,
    tip:'Nếu cơ chất hỏng thì thêm enzyme mới cũng không cứu được.', why:'Thêm dịch tụy mới vào mẫu đã đun mà vẫn tiêu hoá được ⇒ cơ chất còn nguyên, chỉ enzyme cũ bị biến tính (mất cấu trúc bậc ba). Đây là thí nghiệm chứng minh enzyme có bản chất protein và nhiệt độ cao gây biến tính không hồi phục.', trap:'Nếu cơ chất bị phá huỷ thì mẫu sẽ không bao giờ tan — đây chính là phép thử phân biệt.' },
  { tpl:2, t:'dt', q:'E. coli trong môi trường glucose + lactose: operon lac biểu hiện rất yếu dù có lactose. Thêm cAMP ngoại sinh → biểu hiện tăng mạnh. Kết luận hợp lý nhất?', o:['Có lactose (mất ức chế) nhưng thiếu cAMP do glucose cao nên CAP không gắn promoter, phiên mã vẫn yếu','Lactose ức chế operon lac','Glucose ức chế trực tiếp protein repressor','Operon lac đã bị đột biến'], a:0,
    tip:'Operon lac cần HAI điều kiện: không bị ức chế VÀ có CAP–cAMP.', why:'Glucose cao ⇒ adenylate cyclase giảm ⇒ cAMP thấp ⇒ CAP không tạo phức với cAMP nên không gắn promoter ⇒ RNA polymerase khó bám. Đây là điều hoà dương (catabolite repression). Thêm cAMP ngoại sinh khôi phục biểu hiện chứng minh thiếu cAMP là mắt xích bị chặn.', trap:'Lactose chỉ gỡ bỏ điều hoà ÂM (repressor), không giải quyết điều hoà DƯƠNG (CAP).' },
  { tpl:2, t:'tv', q:'Hạt nảy mầm trong bình kín: nhiệt độ tăng, O₂ giảm, CO₂ tăng. Thay bằng hạt đã luộc chín → nhiệt độ không tăng. Thay bằng hạt khô → nhiệt độ tăng rất ít. Kết luận đúng nhất?', o:['Hô hấp cần enzyme còn hoạt động và độ ẩm; hạt khô hô hấp rất yếu','Hô hấp không cần enzyme','Hạt khô không có enzyme hô hấp','Nhiệt toả ra là do vi sinh vật chứ không phải hạt'], a:0,
    tip:'Ba mẫu: sống + ẩm / chết / khô.', why:'Hạt luộc chín có enzyme biến tính nên không hô hấp ⇒ chứng minh phản ứng cần enzyme. Hạt khô còn enzyme nhưng thiếu nước — nước là dung môi và tham gia thuỷ phân — nên tốc độ rất thấp. Hạt nảy mầm vừa ẩm vừa có enzyme hoạt động mạnh ⇒ toả nhiệt rõ.', trap:'Không thể quy cho vi sinh vật vì mẫu luộc chín cũng có vi sinh vật nhưng không toả nhiệt.' },
  { tpl:2, t:'nst', q:'Lai ruồi cái dị hợp thân xám–cánh dài × ruồi đực đen–cụt: đời con 41,5% : 41,5% : 8,5% : 8,5%. Nếu đảo vai trò (ruồi ĐỰC dị hợp × cái đen–cụt) thì kết quả dự đoán là:', o:['1 : 1 (2 kiểu hình) vì ruồi giấm đực không có hoán vị gene','1 : 1 : 1 : 1','41,5 : 41,5 : 8,5 : 8,5','9 : 3 : 3 : 1'], a:0,
    tip:'Ruồi giấm đực: không trao đổi chéo.', why:'Ở Drosophila, con đực không xảy ra hoán vị (không có trao đổi chéo trong giảm phân). Cơ thể đực dị hợp liên kết hoàn toàn chỉ cho 2 loại giao tử ⇒ đời con phân li 1 : 1. Đây là lý do bản đồ di truyền ở ruồi giấm được lập từ con cái.', trap:'Tỉ lệ 1:1:1:1 chỉ xảy ra khi hai gene phân li độc lập (khác NST), không phải ở đây.' },

  /* ============ TEMPLATE 3 — BẢNG SỐ LIỆU (6) ============ */
  { tpl:3, t:'tv', q:'Bảng hiệu suất quang hợp (mg CO₂/dm²/giờ) theo nhiệt độ:\n\n       20°C  25°C  30°C  35°C  40°C\nC3:     18    24    26    20     8\nC4:     12    20    30    38    36\n\nNhận định đúng nhất?', o:['C3 đạt tối ưu khoảng 30 °C rồi giảm mạnh; C4 tối ưu 35–40 °C và chịu nóng tốt hơn','C4 luôn có hiệu suất cao hơn C3 ở mọi nhiệt độ','C3 chịu nóng tốt hơn C4','Nhiệt độ không ảnh hưởng tới hiệu suất quang hợp'], a:0,
    tip:'Tìm đỉnh của mỗi đường cong.', why:'C3 đạt đỉnh 26 ở 30 °C rồi lao dốc còn 8 ở 40 °C do khí khổng đóng và hô hấp sáng tăng mạnh. C4 vẫn đạt 36 ở 40 °C nhờ giải phẫu Kranz tập trung CO₂ quanh Rubisco. Ở 20 °C thì C3 lại cao hơn C4 — nên không thể nói C4 luôn cao hơn.', trap:'Đọc bảng phải so cả 5 cột: ở 20 °C C3 (18) > C4 (12), phá vỡ kết luận “C4 luôn cao hơn”.' },
  { tpl:3, t:'th', q:'Bảng tỉ lệ % tế bào sống sót của 2 chủng E. coli theo nồng độ kháng sinh (µg/mL):\n\n        0    1    2    4    8\nA:     100   98   95   90   88\nB:     100   60   22    5    0\n\nSau 20 thế hệ nuôi trong môi trường có 2 µg/mL, chủng nào có ưu thế và vì sao?', o:['Chủng A, vì đã có sẵn khả năng chịu ở nồng độ này nên chọn lọc giữ lại toàn bộ','Chủng B, vì nhạy cảm nên tiến hoá nhanh hơn','Cả hai như nhau vì cùng loài','Không xác định được từ bảng'], a:0,
    tip:'Ở 2 µg/mL: A còn 95%, B còn 22%.', why:'Chọn lọc không tạo khả năng kháng — nó khuếch đại cái đã có. Quần thể A vốn đã chịu được 2 µg/mL nên gần như không bị loại; quần thể B bị diệt 78% mỗi thế hệ nên nhanh chóng tuyệt diệt nếu không có đột biến mới. Đây là minh hoạ “kháng thuốc có sẵn trong quần thể”.', trap:'Không được suy “nhạy cảm thì tiến hoá nhanh” — áp lực mạnh chỉ làm giảm kích thước quần thể, không tăng tốc tạo allele kháng.' },
  { tpl:3, t:'dv', q:'Bảng nhịp tim và nhịp thở của 4 loài thú:\n\nChuột 25 g: tim 600, thở 150\nMèo 3 kg: tim 150, thở 30\nNgười 70 kg: tim 70, thở 15\nVoi 3000 kg: tim 30, thở 6\n\nNhận định đúng nhất?', o:['Khối lượng cơ thể càng lớn thì nhịp tim và nhịp thở càng chậm','Khối lượng càng lớn thì nhịp tim càng nhanh','Không có quy luật nào giữa khối lượng và nhịp tim','Nhịp thở tỉ lệ thuận với khối lượng'], a:0,
    tip:'So sánh chiều biến thiên của 3 cột.', why:'Động vật nhỏ có tỉ lệ diện tích bề mặt/thể tích lớn nên mất nhiệt nhanh, phải tăng tốc độ chuyển hoá ⇒ tim và phổi hoạt động nhanh hơn. Quy luật này khá phổ quát (gần với quan hệ lũy thừa khối lượng^−0,25).', trap:'Chỉ cần nhìn 2 dòng đầu và cuối là thấy ngay chiều nghịch, không cần tính toán.' },
  { tpl:3, t:'nst', q:'Một loài 2n = 24. Bảng các thể đột biến:\n\nThể 1: 24 · Thể 2: 25 · Thể 3: 36 · Thể 4: 48 · Thể 5: 23\n\nGhép đúng nhất?', o:['Thể 2 = ba nhiễm (2n+1); thể 3 = tam bội (3n); thể 4 = tứ bội (4n); thể 5 = một nhiễm (2n−1)','Thể 2 = một nhiễm; thể 3 = tứ bội; thể 4 = tam bội; thể 5 = ba nhiễm','Thể 2 = tam bội; thể 3 = ba nhiễm; thể 4 = tứ bội; thể 5 = một nhiễm','Thể 2 = thể không; thể 3 = tam bội; thể 4 = lục bội; thể 5 = một nhiễm'], a:0,
    tip:'2n = 24 ⇒ n = 12. Ba nhiễm = 25, tam bội = 36, tứ bội = 48.', why:'Đột biến số lượng chia hai nhóm: lệch bội (thừa/thiếu 1–2 NST: 25, 23) và đa bội (tăng cả bộ: 3n = 36, 4n = 48). Phân biệt bằng cách chia cho n = 12.', trap:'36 là 3n chứ không phải “thể ba” — chữ “ba” dễ gây nhầm giữa ba nhiễm (25) và tam bội (36).' },
  { tpl:3, t:'ql', q:'Kết quả phép lai phân tích cơ thể dị hợp hai cặp gene:\n\nAB: 380 · ab: 370 · Ab: 120 · aB: 130\n\nTần số hoán vị gene là:', o:['25%','50%','12%','75%'], a:0,
    tip:'Tần số hoán vị = (số cá thể hoán vị) / tổng × 100.', why:'Tổng = 380+370+120+130 = 1000. Nhóm hoán vị là Ab và aB (kiểu hình ít) = 250 ⇒ f = 25%. Hai nhóm liên kết AB, ab chiếm 75% — đúng quy luật f < 50%.', trap:'Lấy 380+370 = 750 rồi chia là nhầm nhóm liên kết với nhóm hoán vị.' },
  { tpl:3, t:'dt', q:'Bảng tốc độ phản ứng của một enzyme (µmol/phút) theo nồng độ cơ chất:\n\n0,5 mM: 12 · 1,0: 20 · 2,0: 30 · 4,0: 38 · 8,0: 42 · 16,0: 44\n\nNhận định đúng nhất?', o:['Enzyme tiến tới bão hoà với Vmax khoảng 45 µmol/phút, tốc độ không tăng tuyến tính mãi','Tốc độ tỉ lệ thuận tuyến tính với nồng độ cơ chất ở mọi mức','Enzyme bị ức chế ở nồng độ cơ chất cao','Không đủ dữ liệu để kết luận'], a:0,
    tip:'Nhìn mức tăng: 8 → 4 → 2 → 2. Đang chững lại.', why:'Từ 0,5 đến 4,0 mM tốc độ tăng gần tuyến tính; từ 4,0 trở đi chỉ tăng 4 rồi 2 — đó là hiện tượng bão hoà do mọi trung tâm hoạt động đã được chiếm. Đường cong Michaelis–Menten tiệm cận Vmax ≈ 45.', trap:'Ngoại suy tuyến tính từ 3 điểm đầu sẽ dự đoán 16 mM cho tốc độ ~120 — sai hoàn toàn.' },

  /* ============ TEMPLATE 4 — ĐA BƯỚC (7) ============ */
  { tpl:4, t:'dt', q:'Đột biến điểm ở gene CFTR làm protein thiếu Phe508. Protein vẫn được tổng hợp nhưng gấp sai nên bị hệ thống kiểm soát chất lượng ở lưới nội chất giữ lại và phân giải; kênh Cl⁻ không lên được màng → dịch tiết đặc → xơ nang. Nếu ức chế proteasome thì điều gì xảy ra?', o:['Protein CFTR không bị phân giải, có cơ hội đến màng và hoạt động một phần, giảm triệu chứng','Protein vẫn bị phân giải nhưng nhanh hơn','Gene CFTR tự sửa được đột biến','Kênh Cl⁻ được thay thế bằng kênh K⁺'], a:0,
    tip:'Chuỗi: gen → protein gấp sai → bị phân giải → thiếu kênh ở màng.', why:'Proteasome là bộ máy phân giải protein gắn ubiquitin. Ức chế nó giúp ΔF508-CFTR “sống sót” và một phần thoát khỏi lưới nội chất, đến màng dù chức năng kênh giảm. Đây là cơ sở của nhóm thuốc corrector (lumacaftor) kết hợp potentiator (ivacaftor).', trap:'Ức chế proteasome toàn thân gây độc vì nó cũng phân giải protein bình thường — phải dùng thuốc đặc hiệu cho CFTR, không phải ức chế proteasome.' },
  { tpl:4, t:'dt', q:'Đột biến ở điểm nối (splice site) của intron 2 làm mRNA trưởng thành DÀI hơn bình thường 120 nucleotide, nhưng protein tạo ra lại NGẮN hơn và mất chức năng. Giải thích hợp lý nhất?', o:['Intron bị giữ lại tạo bộ ba kết thúc sớm trong khung đọc mới nên chuỗi bị cắt cụt','mRNA dài hơn thì protein luôn dài hơn','Đột biến làm mất vùng promoter','Ribosome không gắn được vào mRNA'], a:0,
    tip:'mRNA dài hơn mà protein ngắn hơn ⇒ có stop codon sớm.', why:'Giữ lại intron làm lệch khung đọc phía sau, xuất hiện bộ ba kết thúc sớm (premature stop) ⇒ dịch mã dừng giữa chừng ⇒ protein ngắn, thường bị phân giải bởi NMD. Đây là cơ chế phổ biến của bệnh thalassemia và nhiều bệnh di truyền.', trap:'Không có quy luật “mRNA dài → protein dài”: độ dài protein do vị trí stop codon quyết định, không do độ dài mRNA.' },
  { tpl:4, t:'dv', q:'Thiếu sắt kéo dài. Sắp xếp chuỗi nhân quả đúng nhất:', o:['Giảm tổng hợp heme → Hb giảm → thiếu O₂ mô → tăng EPO → tủy tăng sinh hồng cầu nhưng hồng cầu nhỏ, nhược sắc','Giảm EPO → giảm hồng cầu → thiếu sắt','Tăng Hb → tăng nhu cầu sắt','Thiếu sắt → tăng hấp thu O₂ ở phổi'], a:0,
    tip:'Sắt là trung tâm của heme, heme là trung tâm của hemoglobin.', why:'Sắt là cofactor của enzyme tổng hợp heme; thiếu sắt ⇒ heme ít ⇒ Hb giảm ⇒ vận chuyển O₂ kém ⇒ thận tăng tiết erythropoietin ⇒ tủy tăng sinh nhưng thiếu nguyên liệu nên tạo hồng cầu nhỏ (MCV thấp) và nhược sắc (MCH thấp). Đây là chuỗi 4 mắt xích kinh điển.', trap:'Chiều nhân quả không thể đảo: thiếu sắt là nguyên nhân gốc, EPO tăng là phản ứng bù trừ.' },
  { tpl:4, t:'th', q:'Vi khuẩn mang plasmid có gene beta-lactamase. Chuỗi: (1) plasmid nhân đôi độc lập, (2) gene được phiên mã, (3) enzyme có tín hiệu tiết ra ngoại bào, (4) enzyme phân giải vòng beta-lactam. Nếu đột biến làm mất đoạn tín hiệu tiết thì hậu quả là:', o:['Enzyme bị giữ trong tế bào chất, không phân giải được kháng sinh ngoài màng nên mất đề kháng','Enzyme vẫn hoạt động bình thường vì chỉ cần có mặt trong tế bào','Vi khuẩn chết ngay lập tức','Plasmid bị loại bỏ khỏi tế bào'], a:0,
    tip:'Vị trí enzyme quan trọng ngang với hoạt tính enzyme.', why:'Beta-lactamase phải được tiết ra khoảng chu chất/ngoại bào mới gặp kháng sinh trước khi thuốc vào tế bào. Mất signal peptide ⇒ enzyme nằm trong tế bào chất ⇒ kháng sinh vẫn vào được và ức chế tổng hợp thành tế bào ⇒ mất đề kháng dù enzyme còn nguyên hoạt tính.', trap:'Đây là ví dụ “đúng chức năng nhưng sai địa chỉ” — một mắt xích trong chuỗi bị đứt làm hỏng toàn bộ hệ thống.' },
  { tpl:4, t:'tv', q:'Chuỗi: nhiệt độ cao → khí khổng đóng → CO₂ nội bào giảm → Rubisco gắn O₂ → hô hấp sáng → mất carbon. Biện pháp nào can thiệp đúng vào MẮT XÍCH ĐẦU TIÊN?', o:['Tưới mát và che nắng để lá không phải đóng khí khổng','Bón thêm đạm để tăng Rubisco','Tăng cường chiếu sáng để bù','Phun auxin kích thích sinh trưởng'], a:0,
    tip:'Mắt xích đầu là “nhiệt độ cao”.', why:'Nếu hạ được nhiệt độ lá (tưới mát, che lưới, tưới phun sương) thì khí khổng không phải đóng, CO₂ vẫn vào, Rubisco không gặp O₂ ⇒ cắt chuỗi ngay từ gốc. Bón thêm đạm không giúp gì vì vấn đề là tỉ lệ CO₂/O₂, không phải lượng enzyme.', trap:'Can thiệp vào mắt xích giữa (tăng Rubisco) không hiệu quả khi nguyên nhân gốc vẫn còn.' },
  { tpl:4, t:'dt', q:'Operon lac: glucose cao + lactose cao → cAMP thấp → CAP không gắn promoter → phiên mã yếu. Nếu đột biến làm CAP gắn được promoter MÀ KHÔNG cần cAMP thì:', o:['Phiên mã vẫn cần lactose để gỡ repressor, nhưng không còn bị ức chế bởi glucose','Phiên mã luôn bật kể cả khi không có lactose','Phiên mã luôn tắt','Không ảnh hưởng gì'], a:0,
    tip:'Hai tầng điều hoà độc lập: âm (repressor) và dương (CAP).', why:'Đột biến chỉ tác động tầng điều hoà dương. Repressor vẫn gắn operator khi không có lactose nên operon vẫn tắt — nhưng khi có lactose, phiên mã đạt mức cao bất kể glucose. Đây là ví dụ cho thấy hai tín hiệu điều hoà song song, không thay thế nhau.', trap:'Nghĩ “CAP gắn được thì luôn bật” là bỏ qua tầng điều hoà âm vẫn còn nguyên.' },
  { tpl:4, t:'tb', q:'Tế bào tổn thương DNA nặng → p53 tăng → p21 tăng → ức chế CDK → dừng chu kỳ tế bào. Nếu gene p53 mất chức năng thì hậu quả là:', o:['Tế bào tổn thương vẫn tiếp tục phân chia, tích luỹ đột biến và có thể thành tế bào ung thư','Tế bào chết ngay lập tức','Tế bào dừng chu kỳ vĩnh viễn','Không có hậu quả vì còn các gene khác bù'], a:0,
    tip:'p53 là “người gác cổng” của bộ gene.', why:'p53 là yếu tố phiên mã cảm ứng tổn thương DNA: nếu tổn thương nhẹ thì dừng chu kỳ để sửa, nặng thì khởi động apoptosis. Mất p53 ⇒ mất cả hai chốt kiểm soát ⇒ tế bào đột biến tiếp tục phân chia, tích luỹ thêm đột biến. p53 đột biến ở hơn 50% ung thư người.', trap:'Không phải “tế bào chết ngay” — mất p53 làm tế bào sống sót nhiều hơn, đó mới là nguy hiểm.' },

  /* ============ TEMPLATE 5 — PHẢN BIỆN (5) ============ */
  { tpl:5, t:'th', q:'An: “Hươu cổ dài vì cần ăn lá trên cao nên chọn lọc tự nhiên tạo ra cổ dài.”\nBình: “Chọn lọc tự nhiên không tạo ra cổ dài, nó chỉ giữ lại cá thể vốn đã có cổ dài hơn.”\nAi đúng và vì sao?', o:['Bình đúng — CLTN chỉ sàng lọc biến dị có sẵn, không tạo tính trạng theo nhu cầu','An đúng — nhu cầu tạo ra biến đổi cần thiết','Cả hai đúng như nhau','Cả hai đều sai vì cổ dài do đột biến ngẫu nhiên thuần tuý'], a:0,
    tip:'Từ khoá: “tạo ra” hay “giữ lại”.', why:'Biến dị về chiều dài cổ xuất hiện ngẫu nhiên từ trước, không định hướng theo nhu cầu. Khi thức ăn chỉ còn trên cao, cá thể cổ dài sống sót và sinh sản nhiều hơn ⇒ tần số allele “cổ dài” tăng. Nói “CLTN tạo ra” là lẫn với quan điểm Lamarck.', trap:'Phương án “cả hai đều sai vì cổ dài do đột biến ngẫu nhiên thuần tuý” cũng sai: đột biến ngẫu nhiên là nguồn biến dị, nhưng yếu tố quyết định chiều hướng là chọn lọc chứ không phải “thuần tuý ngẫu nhiên”.' },
  { tpl:5, t:'ql', q:'An: “Bố mẹ đều bình thường sinh con bị bệnh, chắc chắn bệnh do gene lặn.”\nBình: “Chưa chắc — có thể do đột biến mới phát sinh ở con.”\nNhận định nào đầy đủ hơn?', o:['Cả hai đều có lý, nhưng Bình bao quát hơn vì có thêm khả năng đột biến mới','An đúng, Bình sai','Bình đúng, An sai','Cả hai đều sai vì bệnh có thể do môi trường'], a:0,
    tip:'Đa số ca là gene lặn, nhưng “chắc chắn” là từ quá mạnh.', why:'Khoảng 95% ca bố mẹ bình thường sinh con bệnh là do gene lặn (bố mẹ dị hợp). Nhưng vẫn có tỉ lệ nhỏ do đột biến mới phát sinh trong giao tử hoặc trong những lần phân chia đầu của hợp tử (đặc biệt ở bệnh như achondroplasia). Xét nghiệm bố mẹ phân biệt được: nếu bố mẹ không mang allele bệnh ⇒ đột biến mới.', trap:'Đáp án “cả hai đều sai” là bẫy: yếu tố môi trường không tạo được bệnh di truyền đơn gene, chỉ ảnh hưởng mức biểu hiện.' },
  { tpl:5, t:'tv', q:'An: “Để cây trong phòng ngủ ban đêm sẽ bị ngạt vì cây nhả CO₂.”\nBình: “Không đáng lo, một chậu cây nhỏ thải CO₂ ít hơn nhiều so với một người.”\nAi đúng?', o:['Cả hai đều đúng một phần: An đúng về CHIỀU phản ứng, Bình đúng về ĐỘ LỚN','An đúng, Bình sai','Bình đúng, An sai','Cả hai đều sai vì ban đêm cây nhả O₂'], a:0,
    tip:'Tách “đúng chiều” khỏi “đúng mức độ”.', why:'Ban đêm không có ánh sáng nên pha sáng dừng, cây chỉ hô hấp — hút O₂ nhả CO₂ (An đúng về chiều). Nhưng sinh khối một chậu cây nhỏ chỉ bằng vài phần trăm một người, nên lượng CO₂ thêm vào rất nhỏ so với thông gió phòng (Bình đúng về độ lớn). Kết luận thực tế: không nguy hiểm, nhưng không nên nói “cây nhả O₂ ban đêm”.', trap:'Đáp án “cả hai đều sai” là bẫy quen thuộc — ở đây cả hai đều có phần đúng.' },
  { tpl:5, t:'dv', q:'An: “Ăn mỡ thì béo vì mỡ chuyển thẳng thành mỡ dự trữ.”\nBình: “Béo hay không phụ thuộc tổng năng lượng thừa, không riêng gì mỡ.”\nAi đúng hơn?', o:['Bình đúng hơn — thừa năng lượng từ nguồn nào cũng thành mỡ, nhưng mỡ có mật độ năng lượng cao nên dễ gây thừa','An đúng hoàn toàn','Bình sai hoàn toàn','Cả hai đều sai'], a:0,
    tip:'Nguyên tắc cân bằng năng lượng là nền tảng.', why:'Cơ thể chuyển hoá carbohydrate, protein hay lipid dư thừa đều thành triglyceride dự trữ qua acetyl-CoA. Mỡ đóng góp 9 kcal/g so với 4 kcal/g của đường và đạm, nên chế độ nhiều mỡ dễ vượt nhu cầu — nhưng nguyên nhân gốc vẫn là thặng dư năng lượng. Bình bao quát hơn.', trap:'“Mỡ chuyển thẳng thành mỡ” nghe hợp lý nhưng bỏ qua việc đường dư cũng chuyển thành mỡ (lipogenesis de novo).' },
  { tpl:5, t:'dt', q:'An: “Đột biến luôn có hại.”\nBình: “Phần lớn đột biến là trung tính, một số ít có lợi và là nguyên liệu của tiến hoá.”\nAi đúng?', o:['Bình đúng — đa số đột biến trung tính hoặc giảm chức năng nhẹ; có lợi là thiểu số nhưng quyết định tiến hoá','An đúng vì đột biến phá vỡ cấu trúc protein','Cả hai đều sai','Không thể xác định'], a:0,
    tip:'“Luôn” là từ tuyệt đối — gần như luôn sai trong sinh học.', why:'Phần lớn đột biến điểm rơi vào vùng không mã hoá hoặc là đột biến đồng nghĩa nên trung tính. Một phần gây hại, một phần nhỏ có lợi (ví dụ đột biến HbS giúp đề kháng sốt rét, đột biến CCR5-Δ32 giúp đề kháng HIV). Không có đột biến thì không có tiến hoá.', trap:'Cả hai đều “nghe có lý”, nhưng từ “luôn” ở An là dấu hiệu nhận biết phát biểu sai.' },

  /* ============ TEMPLATE 6 — BẪY NGÔN NGỮ (5) ============ */
  { tpl:6, t:'dt', q:'Phát biểu nào sau đây KHÔNG đúng về đột biến gene?', o:['Đột biến ở tế bào sinh dưỡng luôn được truyền cho thế hệ sau qua sinh sản hữu tính','Đột biến thay thế một cặp nucleotide có thể không làm đổi acid amin','Đột biến mất một cặp nucleotide trong vùng mã hoá luôn gây lệch khung đọc','Đột biến ở vùng điều hoà có thể làm đổi mức biểu hiện gene'], a:0,
    tip:'Đọc kỹ chữ “luôn” ở cả A và C.', why:'Đột biến soma chỉ truyền qua sinh sản vô tính hoặc ghép cành, KHÔNG qua sinh sản hữu tính — nên A sai. C đúng vì mất một cặp trong vùng mã hoá luôn làm lệch khung từ điểm đột biến trở đi. B đúng nhờ tính thoái hoá; D đúng vì promoter quyết định mức phiên mã.', trap:'Hai phương án đều có chữ “luôn” nhưng chỉ một cái sai — không thể chọn theo từ khoá, phải xét bản chất.' },
  { tpl:6, t:'tv', q:'Phát biểu nào sau đây là SAI về hô hấp sáng?', o:['Hô hấp sáng xảy ra mạnh ở thực vật C4 vì chúng có nồng độ O₂ nội bào cao','Hô hấp sáng tiêu hao ATP và NADPH mà không tạo ATP hữu ích','Hô hấp sáng xảy ra khi nồng độ CO₂ thấp và O₂ cao','Thực vật C3 thường có hô hấp sáng mạnh hơn C4'], a:0,
    tip:'C4 có hô hấp sáng cao hay thấp?', why:'C4 gần như không có hô hấp sáng vì CO₂ được bơm đậm đặc quanh Rubisco ở tế bào bao bó mạch. Nói “C4 hô hấp sáng mạnh vì O₂ cao” là đảo ngược hoàn toàn — chính C3 mới hô hấp sáng mạnh.', trap:'Câu hỏi dạng “SAI” nên ba phương án còn lại đều đúng — phải kiểm tra từng cái chứ không chọn đại.' },
  { tpl:6, t:'ql', q:'Một tế bào sinh tinh có kiểu gene AaBb (hai cặp gene trên hai cặp NST khác nhau). Số loại tinh trùng TỐI ĐA tạo ra từ MỘT tế bào này là bao nhiêu?', o:['4','2','8','16'], a:0,
    tip:'Chú ý “một tế bào” khác “cơ thể”.', why:'Một tế bào sinh tinh qua giảm phân cho đúng 4 tinh trùng. Nếu không hoán vị thì 2 loại (mỗi loại 2 tinh trùng); nếu có hoán vị thì 4 loại. Cơ thể AaBb mới cho tối đa 4 loại giao tử, còn 2ⁿ = 4 ở đây trùng số nhưng ý nghĩa khác.', trap:'Đáp án 8 là 2³ — công thức 2ⁿ chỉ dùng cho CƠ THỂ có n cặp gene dị hợp, không dùng cho một tế bào. Một tế bào luôn chỉ cho tối đa 4 tinh trùng.' },
  { tpl:6, t:'dv', q:'Phát biểu nào sau đây là SAI về đáp ứng miễn dịch?', o:['Miễn dịch đặc hiệu luôn xuất hiện ngay trong vài phút đầu sau khi vi sinh vật xâm nhập','Miễn dịch bẩm sinh phản ứng nhanh nhưng không nhớ kháng nguyên','Miễn dịch dịch thể do tế bào B tạo kháng thể','Miễn dịch qua trung gian tế bào do tế bào T độc thực hiện'], a:0,
    tip:'“Ngay trong vài phút” là dấu hiệu của miễn dịch bẩm sinh.', why:'Miễn dịch đặc hiệu cần thời gian chọn lọc và tăng sinh dòng tế bào B/T phù hợp — thường 3–7 ngày ở lần đầu. Phản ứng trong vài phút là của miễn dịch bẩm sinh (thực bào, viêm, bổ thể). Ba phương án còn lại đều đúng.', trap:'“Luôn” + “vài phút” là hai dấu hiệu sai điển hình trong một phương án.' },
  { tpl:6, t:'nst', q:'Phát biểu nào sau đây ĐÚNG về đột biến nhiễm sắc thể?', o:['Đảo đoạn không làm thay đổi số lượng gene trên nhiễm sắc thể','Mất đoạn luôn gây chết ở thể đồng hợp tử','Lặp đoạn luôn có lợi vì tăng số bản sao gene','Chuyển đoạn luôn làm mất vật chất di truyền'], a:0,
    tip:'Đảo đoạn chỉ đổi thứ tự, không thêm bớt.', why:'Đảo đoạn xoay ngược một đoạn — số gene giữ nguyên, chỉ đổi vị trí (có thể phá vỡ gene tại điểm đứt). Mất đoạn có thể gây chết nhưng không “luôn” (nhiều thể dị hợp vẫn sống, ví dụ mất đoạn 22q11 gây hội chứng DiGeorge). Lặp đoạn có thể có lợi nhưng cũng thường gây hại do mất cân bằng liều gene. Chuyển đoạn tương hỗ không mất vật chất.', trap:'Ba phương án nhiễu đều chứa “luôn” — trong sinh học, phát biểu tuyệt đối gần như luôn sai.' }
];

/* ---------- ĐÚNG / SAI TƯ DUY (8 chùm) ---------- */
const V3_TF = [
  { title: 'Case study: bệnh nhân toan ceton', sub: [
    { text: 'Trong nhiễm toan ceton do đái tháo đường type 1, thể ceton sinh ra từ quá trình phân giải mỡ dự trữ.', ans: true, exp: 'Thiếu insulin ⇒ tế bào không lấy được glucose ⇒ tăng phân giải mỡ ⇒ gan chuyển acid béo thành thể ceton (acetoacetate, β-hydroxybutyrate).' },
    { text: 'Thở nhanh trong nhiễm toan ceton là nguyên nhân gây pH máu thấp.', ans: false, exp: 'Thở nhanh (Kussmaul) là phản ứng BÙ TRỪ nhằm thải CO₂ để nâng pH; nguyên nhân gây toan là thể ceton.' },
    { text: 'Bệnh nhân này có thể tăng kali máu dù tổng lượng kali cơ thể giảm.', ans: true, exp: 'Toan chuyển K⁺ từ nội bào ra ngoại bào ⇒ K⁺ máu cao, nhưng mất K⁺ qua nước tiểu do lợi niệu thẩm thấu nên tổng dự trữ giảm.' },
    { text: 'HbA1c cao giúp phân biệt chắc chắn type 1 và type 2.', ans: false, exp: 'HbA1c chỉ phản ánh mức đường huyết trung bình 2–3 tháng, không phân biệt cơ chế. Cần C-peptide, autoantibody và bối cảnh lâm sàng.' }
  ]},
  { title: 'Thí nghiệm ngược: tái bản và phiên mã', sub: [
    { text: 'Nếu tái bản theo cơ chế bảo toàn, sau 2 thế hệ trong N¹⁴ sẽ có 1 DNA nặng và 3 DNA nhẹ.', ans: true, exp: 'Bảo toàn giữ nguyên phân tử mẹ N¹⁵ và tạo các phân tử mới hoàn toàn N¹⁴ — kết quả này đã không quan sát được, nên mô hình bị bác bỏ.' },
    { text: 'Thêm cAMP ngoại sinh vào E. coli nuôi trong glucose + lactose sẽ làm operon lac biểu hiện mạnh hơn.', ans: true, exp: 'Glucose cao làm cAMP nội bào thấp ⇒ CAP không gắn. Bổ sung cAMP khôi phục phức hợp CAP–cAMP nên phiên mã tăng.' },
    { text: 'Nếu cơ chất bị phá huỷ ở 100 °C thì thêm enzyme mới vẫn tiêu hoá được.', ans: false, exp: 'Nếu cơ chất hỏng thì enzyme mới cũng không cứu được. Thí nghiệm cho thấy vẫn tiêu hoá được ⇒ cơ chất còn nguyên, chỉ enzyme bị biến tính.' },
    { text: 'Ở ruồi giấm, con đực không có hoán vị gene nên phép lai phân tích luôn cho 2 kiểu hình.', ans: true, exp: 'Không có trao đổi chéo ở ruồi đực ⇒ liên kết hoàn toàn ⇒ chỉ 2 loại giao tử ⇒ đời con 1 : 1.' }
  ]},
  { title: 'Bảng số liệu và kết luận', sub: [
    { text: 'Khi đường cong quang hợp bão hoà ở 3000 lux với CO₂ 400 ppm nhưng tiếp tục tăng tới 12000 lux với CO₂ 800 ppm, có thể kết luận CO₂ là yếu tố giới hạn ở 400 ppm.', ans: true, exp: 'Bão hoà sớm ở CO₂ thấp chứng tỏ CO₂ đã giới hạn; tăng CO₂ làm điểm bão hoà dịch lên.' },
    { text: 'Tần số hoán vị gene có thể đạt 75% nếu hai gene rất xa nhau trên cùng nhiễm sắc thể.', ans: false, exp: 'Tần số hoán vị tối đa là 50%; khi đạt 50% thì kết quả giống phân li độc lập.' },
    { text: 'Động vật có khối lượng cơ thể càng nhỏ thì nhịp tim trung bình càng cao.', ans: true, exp: 'Tỉ lệ bề mặt/thể tích lớn ⇒ mất nhiệt nhanh ⇒ chuyển hoá cao ⇒ nhịp tim nhanh (chuột ~600 lần/phút, voi ~30).' },
    { text: 'Thể tam bội của loài 2n = 24 có 36 nhiễm sắc thể.', ans: true, exp: '3n = 3 × 12 = 36. Phân biệt với thể ba nhiễm (2n + 1 = 25).' }
  ]},
  { title: 'Chuỗi nhân quả phân tử', sub: [
    { text: 'Đột biến ở điểm nối intron có thể làm mRNA dài hơn nhưng protein ngắn hơn.', ans: true, exp: 'Giữ lại intron gây lệch khung và tạo stop codon sớm ⇒ dịch mã dừng giữa chừng.' },
    { text: 'Ức chế proteasome có thể giúp protein CFTR gấp sai đến được màng tế bào.', ans: true, exp: 'Protein không bị phân giải sẽ có cơ hội thoát khỏi lưới nội chất — cơ sở của thuốc corrector trong điều trị xơ nang.' },
    { text: 'Mất chức năng p53 làm tế bào chết nhanh hơn khi DNA bị tổn thương.', ans: false, exp: 'Ngược lại: p53 là yếu tố khởi động apoptosis và dừng chu kỳ. Mất p53 khiến tế bào tổn thương tiếp tục phân chia.' },
    { text: 'Enzyme beta-lactamase chỉ gây đề kháng khi được tiết ra đúng vị trí ngoài màng tế bào chất.', ans: true, exp: 'Nếu bị giữ trong tế bào chất, enzyme không gặp kháng sinh trước khi thuốc vào — mất tác dụng bảo vệ.' }
  ]},
  { title: 'Phản biện khoa học', sub: [
    { text: 'Nói “chọn lọc tự nhiên tạo ra tính trạng thích nghi” là cách diễn đạt chính xác.', ans: false, exp: 'Chọn lọc chỉ giữ lại biến dị có sẵn; biến dị phát sinh ngẫu nhiên, không định hướng theo nhu cầu.' },
    { text: 'Bố mẹ bình thường sinh con bị bệnh di truyền có thể do đột biến mới phát sinh trong giao tử.', ans: true, exp: 'Tỉ lệ nhỏ ca bệnh là do đột biến de novo; xét nghiệm bố mẹ phân biệt được với thể ẩn của gene lặn.' },
    { text: 'Một chậu cây nhỏ trong phòng ngủ ban đêm có thể gây ngạt CO₂ cho người ngủ.', ans: false, exp: 'Cây vẫn hô hấp và nhả CO₂, nhưng sinh khối quá nhỏ so với một người và so với thông gió phòng nên không gây nguy hiểm.' },
    { text: 'Phần lớn đột biến điểm là trung tính hoặc chỉ giảm nhẹ chức năng.', ans: true, exp: 'Nhiều đột biến rơi vào vùng không mã hoá hoặc là đồng nghĩa; đột biến có lợi là thiểu số nhưng là nguyên liệu tiến hoá.' }
  ]},
  { title: 'Bẫy ngôn ngữ: “luôn”, “chắc chắn”, “tối đa”', sub: [
    { text: 'Đột biến mất một cặp nucleotide trong vùng mã hoá luôn gây lệch khung đọc.', ans: true, exp: 'Mất 1 cặp (không phải bội số của 3) làm toàn bộ codon phía sau đọc sai — đây là phát biểu “luôn” hiếm hoi đúng.' },
    { text: 'Đột biến ở tế bào sinh dưỡng luôn truyền được cho thế hệ sau qua sinh sản hữu tính.', ans: false, exp: 'Chỉ tế bào sinh dục mới truyền qua sinh sản hữu tính; đột biến soma truyền qua sinh sản vô tính hoặc ghép.' },
    { text: 'Một tế bào sinh tinh AaBb (phân li độc lập) tạo tối đa 4 loại tinh trùng.', ans: true, exp: 'Một tế bào chỉ cho 4 tinh trùng; nếu có hoán vị thì 4 loại, không hoán vị thì 2 loại.' },
    { text: 'Miễn dịch đặc hiệu luôn xuất hiện trong vài phút đầu sau khi vi sinh vật xâm nhập.', ans: false, exp: 'Đáp ứng đặc hiệu cần 3–7 ngày ở lần đầu; phản ứng vài phút là của miễn dịch bẩm sinh.' }
  ]},
  { title: 'Tiến hoá và quần thể', sub: [
    { text: 'Chủng vi khuẩn kháng kháng sinh xuất hiện vì kháng sinh tạo ra đột biến kháng.', ans: false, exp: 'Kháng sinh chỉ là áp lực chọn lọc; allele kháng đã có sẵn (đột biến hoặc plasmid) từ trước.' },
    { text: 'Quần thể càng nhỏ thì phiêu bạt gene càng dễ làm cố định một allele có hại.', ans: true, exp: 'Dao động ngẫu nhiên mạnh ở quần thể ít cá thể, có thể lấn át chọn lọc và cố định allele bất lợi.' },
    { text: 'Tự phối làm thay đổi tần số allele nhưng không đổi tần số kiểu gene.', ans: false, exp: 'Ngược lại: tự phối giữ nguyên tần số allele nhưng tăng đồng hợp và giảm dị hợp.' },
    { text: 'Hai quần thể cách ly địa lý nhưng vẫn giao phối được khi gặp nhau thì vẫn thuộc cùng một loài.', ans: true, exp: 'Cách ly địa lý chỉ là điều kiện hỗ trợ; tiêu chuẩn loài là cách ly sinh sản.' }
  ]},
  { title: 'Thực vật: nước, khoáng và hormone', sub: [
    { text: 'Bón quá nhiều phân đạm có thể làm cây héo dù đất còn ẩm vì dung dịch đất trở nên ưu trương.', ans: true, exp: 'Nồng độ chất tan cao làm thế nước trong đất giảm ⇒ rễ mất nước ngược gradient (“cháy phân”).' },
    { text: 'Ánh sáng đỏ và ánh sáng xanh lam đều kích hoạt khí khổng mở với hiệu quả như nhau.', ans: false, exp: 'Khí khổng mở chủ yếu nhờ phototropin hấp thụ ánh sáng xanh dương; ánh sáng đỏ mạnh cho quang hợp nhưng mở khí khổng kém hơn nhiều.' },
    { text: 'Cây C4 có hô hấp sáng mạnh hơn C3 vì nồng độ O₂ trong tế bào bao bó mạch cao.', ans: false, exp: 'C4 gần như không có hô hấp sáng nhờ CO₂ được bơm đậm đặc quanh Rubisco.' },
    { text: 'Ethylene là hormone gây chín quả và được dùng để giấm quả công nghiệp.', ans: true, exp: 'Ethylene kích thích chín, mềm quả và gây hô hấp đột phát ở quả chín.' }
  ]}
];

/* ---------- TRẢ LỜI NGẮN TƯ DUY (10) ---------- */
const V3_SHORT = [
  { q:'Một gene có 3000 nucleotide, hiệu số giữa số liên kết hydrogen và số nucleotide là 900. Số nucleotide loại G là bao nhiêu?', ans:'900', cells:['9','0','0',''],
    exp:'N = 3000 ⇒ A + G = 1500. H = N + 900 = 3900. Từ 2A + 3G = 3900 và A = 1500 − G ⇒ 3000 + G = 3900 ⇒ G = 900, A = 600. Kiểm tra: 2×600 + 3×900 = 3900 ✓.' },
  { q:'Quần thể cân bằng có tần số allele A = 0,7 và gồm 2000 cá thể. Số cá thể đồng hợp trội là bao nhiêu?', ans:'980', cells:['9','8','0',''],
    exp:'AA = p² = 0,49 ⇒ 0,49 × 2000 = 980 cá thể.' },
  { q:'Phép lai phân tích cơ thể dị hợp hai cặp gene liên kết cho 1000 cá thể, trong đó 180 cá thể có kiểu hình tái tổ hợp kép. Tần số hoán vị gene là bao nhiêu %?', ans:'18', cells:['1','8','',''],
    exp:'Tần số hoán vị = tổng số cá thể hoán vị / tổng = 180/1000 = 18%. (Hoán vị xảy ra ở cả hai nhóm bằng nhau: 90 + 90.)' },
  { q:'Một loài 2n = 36. Thể ba nhiễm kép có bao nhiêu nhiễm sắc thể?', ans:'38', cells:['3','8','',''],
    exp:'Thể ba nhiễm kép = 2n + 2 = 38 NST.' },
  { q:'Một mRNA có 1200 nucleotide, vùng không dịch mã hai đầu chiếm 120 nucleotide. Chuỗi polypeptide hoàn chỉnh có bao nhiêu acid amin?', ans:'358', cells:['3','5','8',''],
    exp:'(1200 − 120)/3 = 360 codon. Trừ 1 codon kết thúc và 1 acid amin mở đầu: 360 − 2 = 358.' },
  { q:'Quần thể cân bằng có 16% cá thể mang kiểu hình lặn. Tỉ lệ % cá thể dị hợp tử là bao nhiêu?', ans:'48', cells:['4','8','',''],
    exp:'q² = 0,16 ⇒ q = 0,4; p = 0,6 ⇒ 2pq = 0,48 = 48%.' },
  { q:'Một tế bào sinh dưỡng 2n = 20 nguyên phân 3 lần. Số nhiễm sắc thể tương đương môi trường cung cấp là bao nhiêu?', ans:'140', cells:['1','4','0',''],
    exp:'2³ = 8 tế bào con; NST môi trường cấp = 2n × (8 − 1) = 20 × 7 = 140.' },
  { q:'Tính trạng do 4 cặp gene tương tác cộng gộp. Số lớp kiểu hình khác nhau là bao nhiêu?', ans:'9', cells:['9','','',''],
    exp:'Số kiểu hình = 2n + 1 = 2×4 + 1 = 9 lớp (0 đến 8 allele trội).' },
  { q:'Một gene nhân đôi 3 lần trong N¹⁵ rồi chuyển sang N¹⁴ nhân đôi 2 lần. Số phân tử DNA chứa N¹⁵ là bao nhiêu?', ans:'16', cells:['1','6','',''],
    exp:'Sau 3 lần: 8 DNA = 16 mạch N¹⁵. Bán bảo toàn giữ nguyên 16 mạch này ⇒ 16 phân tử DNA chứa N¹⁵ (trong tổng 32).' },
  { q:'Ở người, bố nhóm máu AB, mẹ nhóm máu A (kiểu gene I^A i). Xác suất sinh con nhóm máu A là bao nhiêu %?', ans:'50', cells:['5','0','',''],
    exp:'Bố cho A hoặc B (50/50), mẹ cho I^A hoặc i (50/50). Con nhóm A khi: A+i (25%) hoặc A+I^A (25%) = 50%.' }
];

/* ---------- TỰ LUẬN TƯ DUY (8) ---------- */
const V3_ESSAY = [
  { id:'Câu 16', title:'Case study: bệnh nhân toan ceton — phân tích từng mắt xích',
    sum:'Thiếu insulin ⇒ tế bào đói ⇒ đốt mỡ ⇒ thể ceton ⇒ toan chuyển hoá; thở nhanh là bù trừ, K⁺ máu cao nhưng dự trữ giảm.',
    tach:'<b>1. Nhận diện:</b> BMI thấp, glucose rất cao, pH 7,18, HCO₃⁻ 9, ceton niệu +++ → nhiễm toan ceton do đái tháo đường type 1.<br><b>2. Chuỗi cơ chế:</b> thiếu insulin tuyệt đối → GLUT4 không lên màng → glucose ứ trong máu nhưng tế bào không lấy được → tăng phân giải mỡ → acid béo vào gan → β-oxy hoá sinh acetyl-CoA dư → thể ceton (acetoacetate, β-hydroxybutyrate, aceton) → tăng anion gap → pH giảm.<br><b>3. Bù trừ:</b> trung khu hô hấp bị kích thích bởi H⁺ → thở nhanh sâu (Kussmaul) → thải CO₂ → pH tăng một phần; thận tăng thải H⁺ nhưng bị hạn chế bởi giảm thể tích.<br><b>4. Kali:</b> toan đẩy K⁺ ra ngoại bào nên K⁺ máu cao, nhưng lợi niệu thẩm thấu làm mất K⁺ qua nước tiểu → tổng dự trữ K⁺ giảm. Điều trị insulin mà không bù K⁺ có thể gây hạ kali nặng.<br><b>5. Xử trí:</b> bù dịch, insulin đường tĩnh mạch, bù kali khi K⁺ máu giảm dưới ngưỡng, theo dõi anion gap.',
    gop:'Thiếu insulin → đốt mỡ → ceton → toan. Thở nhanh là bù trừ. K⁺ máu cao nhưng cơ thể thiếu K⁺.' },
  { id:'Câu 17', title:'Thí nghiệm ngược: nếu tái bản theo cơ chế bảo toàn thì sao?',
    sum:'Mô hình bảo toàn dự đoán 1 DNA nặng + 3 nhẹ sau 2 thế hệ; thực tế thu 2 lai + 2 nhẹ nên mô hình bị bác bỏ.',
    tach:'<b>1. Đặt vấn đề:</b> có ba mô hình tái bản: bảo toàn (conservative), bán bảo toàn (semiconservative), phân tán (dispersive).<br><b>2. Dự đoán của từng mô hình</b> sau 2 thế hệ nuôi trong N¹⁴ (xuất phát từ N¹⁵):<br>– Bảo toàn: 1 DNA nặng N¹⁵ + 3 DNA nhẹ N¹⁴.<br>– Bán bảo toàn: 2 DNA lai + 2 DNA nhẹ.<br>– Phân tán: cả 4 DNA đều lai nhưng mức N¹⁵ giảm dần.<br><b>3. Kết quả thực nghiệm Meselson–Stahl:</b> thu được đúng 2 lai + 2 nhẹ ⇒ chỉ bán bảo toàn phù hợp.<br><b>4. Ý nghĩa:</b> mỗi DNA con giữ một mạch của mẹ, đảm bảo thông tin di truyền được bảo toàn chính xác — cơ sở của nguyên tắc bán bảo toàn trong SGK.<br><b>5. Bài học phương pháp:</b> một mô hình chỉ được chấp nhận khi dự đoán của nó khớp dữ liệu; phải thiết kế thí nghiệm có thể bác bỏ mô hình sai.',
    gop:'Bảo toàn → 1 nặng + 3 nhẹ. Thực tế 2 lai + 2 nhẹ ⇒ bán bảo toàn đúng.' },
  { id:'Câu 18', title:'Vì sao C4 chịu nóng tốt hơn C3 — phân tích theo bảng số liệu',
    sum:'C3 đạt đỉnh 30 °C rồi lao dốc; C4 giữ hiệu suất cao tới 40 °C nhờ giải phẫu Kranz tập trung CO₂ quanh Rubisco.',
    tach:'<b>1. Đọc bảng:</b> C3: 18 → 26 (đỉnh 30 °C) → 8 ở 40 °C. C4: 12 → 38 (đỉnh 35 °C) → 36 ở 40 °C. Ở 20 °C C3 cao hơn C4.<br><b>2. Giải thích C3 giảm khi nóng:</b> nhiệt độ cao → khí khổng đóng để giữ nước → CO₂ nội bào giảm → Rubisco gắn O₂ → hô hấp sáng tăng → mất carbon và năng lượng. Đồng thời hô hấp tăng theo nhiệt độ làm giảm quang hợp ròng.<br><b>3. Giải thích C4 ổn định:</b> PEP-carboxylase ở mô giậu có ái lực CO₂ rất cao, cố định CO₂ thành acid 4C rồi bơm vào tế bào bao bó mạch → nồng độ CO₂ quanh Rubisco cao gấp nhiều lần không khí → Rubisco không gặp O₂ → hô hấp sáng gần như bằng 0.<br><b>4. Đánh đổi:</b> C4 tốn thêm 2 ATP cho mỗi CO₂ cố định, nên ở nhiệt độ thấp (khi hô hấp sáng không đáng kể) C3 lại hiệu quả hơn — đúng như số liệu ở 20 °C.<br><b>5. Kết luận:</b> không có cây nào “tốt hơn tuyệt đối”; C4 thắng ở nóng–khô, C3 thắng ở mát–ẩm.',
    gop:'C3 đỉnh 30 °C rồi sụp; C4 giữ đỉnh tới 40 °C. C4 tốn thêm ATP nên kém hơn ở nhiệt độ thấp.' },
  { id:'Câu 19', title:'Chuỗi nhân quả: từ đột biến splice site đến protein mất chức năng',
    sum:'Giữ intron → lệch khung → stop codon sớm → chuỗi cụt → mất chức năng; mRNA dài hơn nhưng protein ngắn hơn.',
    tach:'<b>1. Bình thường:</b> spliceosome nhận diện điểm nối 5\' (GU) và 3\' (AG), cắt intron, nối exon → mRNA trưởng thành → dịch mã đúng khung.<br><b>2. Khi đột biến điểm nối:</b> spliceosome bỏ qua điểm nối đó → intron bị giữ lại (intron retention) hoặc một exon bị bỏ (exon skipping).<br><b>3. Hệ quả phân tử:</b> giữ intron làm xuất hiện bộ ba kết thúc sớm trong khung đọc mới → ribosome dừng giữa chừng → protein ngắn, thường bị phân giải bởi cơ chế NMD (nonsense-mediated decay).<br><b>4. Nghịch lý “mRNA dài, protein ngắn”:</b> độ dài protein do vị trí stop codon quyết định, không do độ dài mRNA. Đây là điểm dễ nhầm khi đọc đề.<br><b>5. Liên hệ bệnh học:</b> nhiều ca β-thalassemia do đột biến điểm nối intron 1/2 của gene HBB; mức độ nặng phụ thuộc lượng protein còn chức năng.',
    gop:'Đột biến splice site → giữ intron → stop sớm → protein cụt. mRNA dài hơn ≠ protein dài hơn.' },
  { id:'Câu 20', title:'Phản biện: “chọn lọc tự nhiên tạo ra tính trạng thích nghi”',
    sum:'CLTN không tạo biến dị, chỉ giữ lại biến dị có sẵn; nói “tạo ra” là lẫn với quan điểm Lamarck.',
    tach:'<b>1. Phát biểu gây tranh luận:</b> “Hươu cổ dài vì cần ăn lá cao nên CLTN tạo ra cổ dài”.<br><b>2. Phân tích từ ngữ:</b> “tạo ra” hàm ý biến dị xuất hiện để đáp ứng nhu cầu — đó là quan điểm Lamarck, đã bị bác bỏ.<br><b>3. Quan điểm đúng:</b> biến dị về chiều dài cổ phát sinh ngẫu nhiên từ đột biến và tổ hợp gene, có từ trước khi môi trường thay đổi. Khi thức ăn chỉ còn trên cao, cá thể cổ dài sống sót và sinh sản nhiều hơn ⇒ tần số allele quy định cổ dài tăng.<br><b>4. Bằng chứng:</b> thí nghiệm chọn lọc nhân tạo trên quần thể hỗn hợp cho thấy tần số tính trạng dịch chuyển theo hướng chọn, chứng minh biến dị có sẵn chứ không được “tạo” ra.<br><b>5. Cách diễn đạt chính xác:</b> “CLTN làm tăng tần số allele quy định cổ dài vốn đã có trong quần thể”.',
    gop:'CLTN = sàng lọc, không sáng tạo. Biến dị có trước, chọn lọc quyết định tần số.' },
  { id:'Câu 21', title:'Vì sao kháng kháng sinh là ví dụ hoàn hảo của CLTN',
    sum:'Allele kháng có sẵn; kháng sinh chỉ là áp lực chọn lọc; dùng không hết liều giữ lại đúng nhóm kháng.',
    tach:'<b>1. Quần thể vi khuẩn:</b> kích thước khổng lồ (10⁹–10¹²), thời gian thế hệ ngắn (20–30 phút) ⇒ xác suất có cá thể mang đột biến kháng rất cao, kể cả khi chưa từng gặp thuốc.<br><b>2. Vai trò của kháng sinh:</b> không tạo đột biến, chỉ tiêu diệt cá thể nhạy cảm ⇒ giải phóng ổ sinh thái cho cá thể kháng bùng nổ.<br><b>3. Vì sao không dùng hết liều lại nguy hiểm:</b> nồng độ thuốc thấp chỉ diệt một phần, để lại nhóm có khả năng chịu trung bình — chính là “vườn ươm” cho chọn lọc từng bước.<br><b>4. Lan truyền:</b> gene kháng thường nằm trên plasmid, có thể truyền ngang giữa các loài (conjugation) ⇒ lan nhanh hơn nhiều so với di truyền dọc.<br><b>5. Hệ quả và giải pháp:</b> dùng đúng liều, đủ thời gian, hạn chế kháng sinh phổ rộng, và hiểu rằng “ngừng thuốc sớm” là hành vi tạo áp lực chọn lọc có lợi cho vi khuẩn.',
    gop:'Đột biến có sẵn → kháng sinh diệt nhóm nhạy → nhóm kháng bùng nổ. Ngừng liều sớm = ươm giống kháng.' },
  { id:'Câu 22', title:'Đọc phả hệ: phân biệt lặn trên X với lặn trên NST thường',
    sum:'Chỉ nam bệnh + mẹ bình thường + bên ngoại có người bệnh ⇒ lặn trên X (di truyền chéo).',
    tach:'<b>1. Dữ kiện:</b> bố mẹ bình thường sinh 2 con trai bệnh, 1 con gái bình thường; anh trai của mẹ cũng bệnh.<br><b>2. Bước 1 — xác định trội/lặn:</b> bố mẹ bình thường → con bệnh ⇒ gene lặn (nếu trội thì bố hoặc mẹ phải bệnh).<br><b>3. Bước 2 — NST thường hay giới tính:</b> chỉ có nam bệnh, không có nữ bệnh ⇒ nghi ngờ gene trên X. Kiểm tra bằng dòng mẹ: anh trai của mẹ bệnh ⇒ bà ngoại là thể mang, truyền Xᵃ cho cả mẹ và cậu ⇒ khớp hoàn toàn với di truyền chéo.<br><b>4. Kiểu gene:</b> bà ngoại XᴬXᵃ; mẹ XᴬXᵃ; bố XᴬY; hai con trai bệnh XᵃY; con gái có thể XᴬXᴬ hoặc XᴬXᵃ (50/50).<br><b>5. Xác suất:</b> mỗi lần sinh con trai có 50% bệnh; con gái không bệnh nhưng 50% là thể mang — cần tư vấn di truyền.',
    gop:'Bố mẹ bình thường → con bệnh = lặn. Chỉ nam + chéo qua mẹ = lặn trên X.' },
  { id:'Câu 23', title:'Case study thực vật: lá non vàng, gân xanh trên đất kiềm',
    sum:'Fe kết tủa ở pH cao nên rễ không hấp thu được; Fe không tái sử dụng nên lá non vàng trước.',
    tach:'<b>1. Triệu chứng:</b> lá non vàng nhạt, gân còn xanh, lá già bình thường → thiếu nguyên tố KHÔNG di động trong cây (Fe, Ca, B).<br><b>2. Dữ kiện đất:</b> pH 7,8; Fe tổng số cao nhưng Fe hoà tan thấp → nghịch lý “đất nhiều sắt mà cây vẫn thiếu”.<br><b>3. Giải thích hoá học:</b> ở pH kiềm, Fe³⁺ kết tủa thành Fe(OH)₃/oxide không tan, rễ không hấp thu được. Đây là hiện tượng “thiếu sắt do kiềm” (lime-induced chlorosis) rất phổ biến ở đất canxi.<br><b>4. Vì sao lá non vàng trước:</b> Fe là cofactor của cytochrome và enzyme tổng hợp chlorophyll, không được tái huy động từ lá già → lá non thiếu trước.<br><b>5. Khắc phục:</b> phun Fe-chelate (EDDHA) lên lá, bón phân chua sinh lý (ammonium sulfate), bổ sung chất hữu cơ để hạ pH vùng rễ.',
    gop:'pH kiềm → Fe kết tủa → rễ không hút được. Fe không di động → lá non vàng, gân xanh.' }
];

MCQS.push(...V3_MCQ);
TFS.push(...V3_TF);
SHORTS.push(...V3_SHORT);
ESSAYS.push(...V3_ESSAY);

/* =========================================================
   v4.1 — NGÂN HÀNG CÂU HỎI MỞ RỘNG + VÍ DỤ THÔNG MINH
   ========================================================= */
const V4_MCQ = [
  /* --- Di truyền phân tử --- */
  { t:'dt', q:'Một gene ở sinh vật nhân thực dài 5100 cặp nucleotide, trong đó intron chiếm 900 cặp. mRNA trưởng thành (chưa tính đuôi poly-A) dài bao nhiêu nucleotide?', o:['5100','4200','2550','2100'], a:1,
    tip:'Gen 5100 cặp = 5100 nucleotide trên một mạch; trừ intron.', why:'Phiên mã tạo mRNA sơ khai 5100 nucleotide, splicing cắt 900 nucleotide intron ⇒ mRNA trưởng thành 4200 nucleotide (gồm cả codon mở đầu và kết thúc).', trap:'Chia đôi 5100 thành 2550 là nhầm lẫn giữa số cặp và số nucleotide trên mạch khuôn.' },
  { t:'dt', q:'Vì sao đột biến thay thế nucleotide ở vị trí thứ 3 của codon thường ít gây hậu quả hơn ở vị trí thứ 1?', o:['Vị trí 3 không được ribosome đọc','Tính thoái hóa của mã di truyền tập trung ở vị trí 3 (wobble)','Vị trí 3 luôn là A','DNA polymerase sửa sai riêng vị trí 3'], a:1,
    tip:'Wobble — bắt cặp không chuẩn giữa codon và anticodon.', why:'Nhiều bộ ba chỉ khác nhau ở nucleotide thứ 3 vẫn mã hóa cùng acid amin; anticodon bắt cặp linh hoạt (wobble) ở đầu 5′. Đổi vị trí 1 gần như luôn đổi acid amin.', trap:'Ribosome vẫn đọc cả 3 vị trí; vấn đề là ý nghĩa của bộ ba, không phải việc đọc.' },
  { t:'dt', q:'Ở operon lac, khi có lactose nhưng đồng thời có glucose nồng độ cao, phiên mã các gene cấu trúc ở mức nào?', o:['Tối đa','Rất thấp (chỉ cảm ứng yếu)','Bằng không tuyệt đối','Tăng gấp đôi bình thường'], a:1,
    tip:'Hai tầng điều khiển: ức chế lac (tắt khi có lactose) VÀ áp chế catabolite (cAMP thấp khi có glucose).', why:'Lactose bỏ được protein ức chế, nhưng glucose làm cAMP thấp ⇒ CAP không gắn promoter ⇒ RNA polymerase bám kém. Chỉ phiên mã nền yếu; khi glucose cạn thì mới bật mạnh.', trap:'Bằng không tuyệt đối là sai — vẫn có mức phiên mã nền (basal level).' },
  { t:'dt', q:'Enzyme nào chịu trách nhiệm tháo xoắn và enzyme nào nối các đoạn Okazaki?', o:['Primase / Ligase','Helicase / Ligase','Topoisomerase / Primase','Helicase / DNA polymerase I'], a:1,
    tip:'Tháo xoắn = helicase; keo dán = ligase.', why:'Helicase phá liên kết hydrogen tách hai mạch; ligase tạo liên kết phosphodiester nối đoạn Okazaki thành mạch liên tục.', trap:'DNA polymerase I THAY đoạn mồi bằng DNA, còn ligase mới là enzyme nối cuối cùng.' },

  /* --- NST & đột biến --- */
  { t:'nst', q:'Thể ba nhiễm (2n + 1) ở người xảy ra do cơ chế nào?', o:['Không phân ly NST ở giảm phân','Trao đoạn không cân','Đột biến gene','Nhân đôi DNA thêm một lần'], a:0,
    tip:'2n+1 = một cặp không tách nhau.', why:'Không phân ly (nondisjunction) ở giảm phân I hoặc II tạo giao tử n+1; thụ tinh với giao tử n cho hợp tử 2n+1 (ví dụ trisomy 21 gây hội chứng Down).', trap:'Trao đoạn không cân gây mất/ lặp đoạn, không làm thay đổi số lượng nguyên NST.' },
  { t:'nst', q:'Đột biến đảo đoạn khác đột biến lặp đoạn ở điểm nào?', o:['Đảo đoạn làm tăng số gene','Đảo đoạn giữ nguyên số gene nhưng đổi trật tự','Lặp đoạn không đổi số gene','Cả hai đều mất gene'], a:1,
    tip:'Đảo = xoay 180°, lặp = nhân bản.', why:'Đảo đoạn chỉ đổi chiều sắp xếp (vẫn đủ gene) nhưng có thể làm gen rời khỏi vùng điều hòa; lặp đoạn làm tăng số bản sao gene.', trap:'Đảo đoạn KHÔNG làm mất hay tăng vật chất di truyền, chỉ đổi vị trí.' },
  { t:'nst', q:'Một loài có 2n = 24. Tế bào đang ở kỳ sau của nguyên phân có bao nhiễm sắc thể đơn?', o:['24','48','12','96'], a:1,
    tip:'Kỳ sau: tâm động tách ⇒ mỗi chromatid trở thành 1 NST đơn.', why:'Trước kỳ sau có 24 NST kép = 48 chromatid. Khi tâm động tách, mỗi chromatid là một NST đơn ⇒ trong cùng một tế bào có 48 NST đơn (mỗi cực 24).', trap:'96 là nếu đếm nhầm cả chromatid lẫn NST; 24 là số ở mỗi cực, không phải cả tế bào.' },

  /* --- Quy luật di truyền --- */
  { t:'ql', q:'Lai hai cơ thể dị hợp 2 cặp gene phân li độc lập (AaBb × AaBb). Tỉ lệ con có kiểu hình trội cả hai tính trạng là:', o:['3/16','9/16','1/16','12/16'], a:1,
    tip:'Mỗi cặp cho 3/4 trội ⇒ nhân xác suất.', why:'P(A_) = 3/4, P(B_) = 3/4, độc lập ⇒ 3/4 × 3/4 = 9/16.', trap:'3/16 là tỉ lệ một trội một lặn (A_bb hoặc aaB_).' },
  { t:'ql', q:'Hai gene liên kết cách nhau 20 cM. Lai phân tích cơ thể dị hợp Ab/aB, tỉ lệ giao tử aB là:', o:['10%','20%','40%','80%'], a:2,
    tip:'Ab và aB là giao tử KHÔNG hoán vị (bố mẹ).', why:'Tổng giao tử hoán vị = 20% ⇒ mỗi loại hoán vị (AB, ab) 10%. Còn lại 80% là giao tử bố mẹ, chia đều ⇒ Ab = 40%, aB = 40%.', trap:'20% là TỔNG tần số hoán vị, không phải tỉ lệ một loại giao tử.' },
  { t:'ql', q:'Quần thể cân bằng Hardy–Weinberg có 16% cá thể đồng hợp lặn (aa). Tần số dị hợp tử Aa là:', o:['0,36','0,48','0,60','0,84'], a:1,
    tip:'q² = 0,16 ⇒ q = 0,4 ⇒ p = 0,6.', why:'2pq = 2 × 0,6 × 0,4 = 0,48 = 48%.', trap:'0,36 là p² (AA); 0,84 là tỉ lệ kiểu hình trội (p² + 2pq).' },
  { t:'ql', q:'Tính trạng do gene trên NST X, allele lặn gây bệnh. Mẹ bình thường nhưng có bố bị bệnh, lấy chồng bình thường. Xác suất con trai bị bệnh là:', o:['0%','25%','50%','100%'], a:2,
    tip:'Mẹ chắc chắn là người mang gene (nhận X bệnh từ bố).', why:'Mẹ XᴬXᵃ, bố XᴬY. Con trai nhận Y từ bố và X từ mẹ ⇒ 1/2 nhận Xᵃ ⇒ 50% con trai bệnh (25% tổng số con).', trap:'25% là xác suất trên TẤT CẢ con, còn đề hỏi riêng con trai.' },

  /* --- Sinh lý thực vật --- */
  { t:'tv', q:'Điểm bù ánh sáng là cường độ mà tại đó:', o:['Quang hợp đạt cực đại','Quang hợp đúng bằng hô hấp','Khí khổng mở tối đa','Cây ngừng hô hấp'], a:1,
    tip:'Trao đổi khí ròng bằng 0.', why:'Tại điểm bù, O₂ do quang hợp nhả ra vừa đủ bù O₂ tiêu thụ bởi hô hấp ⇒ cây không tích lũy chất hữu cơ. Dưới điểm bù cây sẽ chết dần.', trap:'Cây vẫn hô hấp ở điểm bù — chính hô hấp tạo ra ngưỡng này.' },
  { t:'tv', q:'Cây C4 khác C3 chủ yếu ở điểm nào?', o:['Không có Rubisco','Cố định CO₂ sơ bộ bằng PEP carboxylase ở tế bào mô giậu, rồi tập trung CO₂ vào bao bó mạch','Chỉ quang hợp trong tối','Không có lục lạp'], a:1,
    tip:'C4 = chia không gian, tách hai bước cố định CO₂.', why:'PEP carboxylase ái lực cao với CO₂ và không bị O₂ cạnh tranh ⇒ nồng độ CO₂ quanh Rubisco cao ⇒ hầu như triệt tiêu hô hấp sáng, nên C4 ưu thế ở nhiệt độ cao, ánh sáng mạnh.', trap:'C4 VẪN có Rubisco, chỉ đặt nó trong tế bào bao bó mạch.' },
  { t:'tv', q:'Vì sao cây CAM mở khí khổng ban đêm mà vẫn KHÔNG nhả O₂ vào phòng ngủ?', o:['Vì khí khổng ban đêm chỉ lấy CO₂','Vì không có ánh sáng nên pha sáng không chạy, cây chỉ hô hấp','Vì cây CAM không có lục lạp','Vì ban đêm cây ngừng mọi trao đổi khí'], a:1,
    tip:'Mở khí khổng ≠ quang hợp. Cần ánh sáng để quang phân li nước.', why:'CAM cố định CO₂ thành malate ban đêm nhờ PEP carboxylase, nhưng O₂ chỉ được sinh ra ở pha sáng (quang phân li H₂O). Ban đêm cây vẫn hô hấp ⇒ vẫn tiêu thụ O₂.', trap:'Malate được tạo ra là để DỰ TRỮ CO₂, không phải để nhả O₂.' },
  { t:'tv', q:'Khi hạn hán, ABA tăng gây đóng khí khổng. Hệ quả tất yếu là:', o:['Quang hợp tăng do tiết kiệm nước','Giảm thoát hơi nước VÀ giảm quang hợp vì thiếu CO₂','Tăng hấp thu khoáng ngay lập tức','Cây chuyển sang hô hấp kị khí'], a:1,
    tip:'Khí khổng là một "van" cho cả H₂O lẫn CO₂.', why:'Đóng khí khổng giảm mất nước nhưng đồng thời chặn đường vào của CO₂ ⇒ quang hợp giảm. Đây là sự đánh đổi (trade-off) cốt lõi của sinh lý thực vật.', trap:'Hấp thu khoáng chủ động cần ATP từ hô hấp và dòng nước, không tăng khi khí khổng đóng.' },

  /* --- Động vật & người --- */
  { t:'dv', q:'Theo phương trình Hill, vì sao Hb bão hòa gần như không đổi khi pO₂ tăng từ 80 lên 100 mmHg, nhưng tụt rất nhanh khi pO₂ giảm từ 60 xuống 40 mmHg?', o:['Vì Hb chỉ có 1 tiểu đơn vị','Vì đường cong bão hòa có dạng chữ S: đoạn trên phẳng, đoạn dưới dốc','Vì pH máu thay đổi','Vì nồng độ Hb giảm'], a:1,
    tip:'Hệ số Hill n ≈ 2,7 → bắt hợp tác giữa 4 tiểu đơn vị.', why:'O₂ gắn vào một heme làm tăng ái lực của các heme còn lại ⇒ đường cong sigmoid. Trên ~60 mmHg đã ở phần phẳng (bão hòa), dưới ngưỡng đó độ bão hòa rơi nhanh — cơ chế giúp Hb nhả nhiều O₂ đúng vào mô đang hoạt động.', trap:'Đây là tính chất của phối tử gắn hợp tác, không phải do pH (hiệu ứng Bohr là một hiệu ứng khác).' },
  { t:'dv', q:'Bệnh nhân khí phế thũng thở nhanh nhưng vẫn thiếu O₂. Giải thích đúng nhất:', o:['Thông khí tăng làm pO₂ phế nang giảm','Diện tích màng trao đổi giảm nên máu không kịp cân bằng với phế nang','Hb bị biến tính','Tim bơm quá mạnh'], a:1,
    tip:'Tách hai biến: động lực khuếch tán (chênh lệch phân áp) và diện tích màng.', why:'Thở nhanh vẫn giữ pO₂ phế nang cao, nhưng vách phế nang bị phá hủy làm diện tích giảm ⇒ theo định luật Fick, tốc độ khuếch tán tỉ lệ với diện tích ⇒ máu ra khỏi mao mạch chưa kịp bão hòa.', trap:'Thở nhanh làm pO₂ phế nang TĂNG nhẹ (thải CO₂), không giảm.' },
  { t:'dv', q:'Vì sao suy thận gây thiểu niệu dù tỉ lệ tái hấp thu vẫn cao?', o:['Vì ADH tăng','Vì GFR tụt mạnh nên lượng dịch lọc ban đầu đã rất ít','Vì ống góp ngừng hoạt động','Vì nước tiểu bị tái hấp thu hoàn toàn'], a:1,
    tip:'Nước tiểu = GFR × (1 − tỉ lệ tái hấp thu).', why:'Khi huyết áp dưới ngưỡng tự điều hoà, GFR giảm mạnh (sốc, mất máu). Dù ống thận vẫn thu hồi 99%, 1% của một con số rất nhỏ vẫn cho nước tiểu rất ít ⇒ thiểu niệu và ứ ure.', trap:'Đái tháo nhạt (thiếu ADH) gây ĐA niệu — ngược chiều, đừng nhầm.' },
  { t:'dv', q:'Trong điều hòa glucose máu, cặp hormone đối kháng trực tiếp là:', o:['Insulin – Cortisol','Insulin – Glucagon','Glucagon – Adrenalin','Aldosteron – ADH'], a:1,
    tip:'Một cái cất vào kho, một cái kéo ra khỏi kho.', why:'Insulin (tế bào β) đưa GLUT4 lên màng, kích thích tạo glycogen ⇒ hạ đường huyết; glucagon (tế bào α) hoạt hóa glycogen phosphorylase ⇒ tăng đường huyết. Đây là điều hòa ngược âm kinh điển.', trap:'Adrenalin cũng tăng đường huyết nhưng là đáp ứng cấp tính, không phải cặp đối kháng nội môi thường xuyên.' },

  /* --- Tế bào & enzyme --- */
  { t:'tb', q:'Khi tăng nhiệt độ từ 20 lên 37°C rồi lên 70°C, tốc độ phản ứng enzyme thay đổi thế nào?', o:['Tăng đều cho tới 70°C','Tăng theo Arrhenius tới ~37–40°C rồi tụt nhanh do biến tính','Không đổi rồi tăng','Giảm rồi tăng'], a:1,
    tip:'Hai hiệu ứng đối nghịch: tăng động năng vs mất cấu trúc bậc 3.', why:'Dưới nhiệt độ tối ưu, Q₁₀ ≈ 2 (tốc độ tăng theo Arrhenius). Trên ~55–60°C, liên kết yếu giữ cấu trúc bậc 3 bị phá ⇒ trung tâm hoạt động biến dạng ⇒ hoạt tính rơi nhanh và KHÔNG hồi phục khi làm nguội.', trap:'Ức chế cạnh tranh hay pH lệch thường hồi phục được; biến tính nhiệt thì không.' },
  { t:'tb', q:'Vì sao tế bào thực vật không vỡ trong môi trường nhược trương còn hồng cầu thì vỡ?', o:['Màng thực vật dày hơn','Thành cellulose chịu lực tạo sức trương cân bằng áp suất thẩm thấu','Hồng cầu không có nhân','Thực vật có không bào chứa nước'], a:1,
    tip:'So sánh: có thành cứng hay không.', why:'Nước vào tạo áp suất thẩm thấu; thành cellulose tạo phản lực (sức trương) nên đạt cân bằng trước khi màng bị căng quá mức. Hồng cầu chỉ có màng sinh chất ⇒ vỡ (tan máu).', trap:'Không bào góp phần tạo sức trương nhưng chính THÀNH CELLULOSE mới là cấu trúc chịu lực.' },
  { t:'tb', q:'Kinesin bị đứng yên khi ATP = 0 dù vi ống còn nguyên. Kết luận đúng:', o:['Vi ống là nguồn năng lượng','Vận chuyển nội bào là quá trình tiêu năng lượng, mỗi bước 8 nm tiêu thụ ATP','Kinesin tự tổng hợp ATP','ATP chỉ cần lúc khởi đầu'], a:1,
    tip:'Phân biệt "nhiên liệu" (ATP) và "đường ray" (vi ống).', why:'Mỗi chu trình ATPase gây đổi hình dạng giúp kinesin bước 8 nm về đầu (+) của vi ống. Thiếu ATP ⇒ động cơ kẹt; hỏng vi ống (colchicine) ⇒ rơi khỏi ray. Hai nguyên nhân độc lập.', trap:'ATP không phải chỉ cần lúc khởi đầu — cần cho MỖI bước.' },
  { t:'tb', q:'Theo động học Michaelis–Menten, khi [S] = Km thì tốc độ phản ứng bằng:', o:['Vmax','Vmax/2','Vmax/4','2 Vmax'], a:1,
    tip:'Thay [S] = Km vào v = Vmax[S]/(Km+[S]).', why:'v = Vmax·Km/(Km+Km) = Vmax/2. Km chính là nồng độ cơ chất cho nửa tốc độ cực đại, phản ánh ái lực enzyme–cơ chất (Km nhỏ ⇒ ái lực cao).', trap:'Vmax chỉ đạt khi [S] → ∞ (bão hòa), không phải tại Km.' },
  { t:'tb', q:'Ưu trương, đẳng trương, nhược trương được xác định bởi:', o:['Nồng độ chất tan hòa tan tổng số trong dung dịch','Nồng độ chất tan KHÔNG qua được màng (tác nhân gây thẩm thấu)','Nhiệt độ dung dịch','pH dung dịch'], a:1,
    tip:'Tonicity ≠ osmolarity — chỉ chất không thấm mới tạo dòng nước bền vững.', why:'Ure dễ qua màng nên dung dịch ure ưu trương về mặt osmolarity vẫn gây tan máu (nhược trương chức năng). Chính chất không qua màng (NaCl, sucrose) quyết định chiều và mức độ dời nước.', trap:'Đây là điểm kinh điển hay bẫy: nhầm giữa áp suất thẩm thấu và trương lực.' }
];

const V4_TF = [
  { title: 'Động học enzyme — đọc đồ thị đúng', sub: [
    { text: 'Khi [S] rất lớn so với Km, tăng thêm cơ chất hầu như không làm tăng tốc độ phản ứng.', ans: true, exp: 'Enzyme đã bão hòa: mọi phân tử enzyme đều ở dạng ES ⇒ v ≈ Vmax. Muốn tăng tốc độ phải tăng nồng độ enzyme.' },
    { text: 'Km càng nhỏ thì ái lực của enzyme với cơ chất càng yếu.', ans: false, exp: 'Ngược lại: Km nhỏ nghĩa là chỉ cần ít cơ chất đã đạt Vmax/2 ⇒ ái lực CAO.' },
    { text: 'Ức chế cạnh tranh làm tăng Km biểu kiến nhưng không đổi Vmax.', ans: true, exp: 'Chất ức chế cạnh tranh chiếm trung tâm hoạt động; tăng [S] đủ cao sẽ đẩy nó ra ⇒ vẫn đạt Vmax, nhưng cần [S] lớn hơn ⇒ Km biểu kiến tăng.' },
    { text: 'Gan luộc mất hoạt tính catalase do pH thay đổi, nên thêm đệm pH 7 là hồi phục.', ans: false, exp: 'Nhiệt làm BIẾN TÍNH (mất cấu trúc bậc 3) — không hồi phục khi đưa về pH hay nhiệt độ tối ưu. Chỉ ức chế cạnh tranh / lệch pH nhẹ mới hồi phục.' }
  ]},
  { title: 'Cân bằng khí trong phòng kín', sub: [
    { text: 'Ban đêm cây xanh vẫn tiêu thụ O₂.', ans: true, exp: 'Không có ánh sáng ⇒ pha sáng không chạy, không quang phân li nước; cây chỉ hô hấp như người.' },
    { text: 'Cây CAM nhả O₂ vào ban đêm vì mở khí khổng.', ans: false, exp: 'Khí khổng mở chỉ giúp lấy CO₂ (cố định thành malate). O₂ chỉ sinh ra ở pha sáng cần ánh sáng; ban đêm CAM vẫn hô hấp.' },
    { text: 'Mở cửa sổ kéo nồng độ O₂/CO₂ về gần mức khí quyển nhờ đối lưu.', ans: true, exp: 'Thông khí làm tăng số lần trao đổi không khí (ACH), triệt tiêu sai lệch do hô hấp gây ra.' },
    { text: 'SpO₂ giảm tuyến tính theo nồng độ O₂ phòng.', ans: false, exp: 'SpO₂ tuân theo đường cong Hill chữ S: gần phẳng ở vùng O₂ cao, rơi nhanh khi pO₂ dưới ~60 mmHg.' }
  ]},
  { title: 'Di truyền & chọn lọc — bẫy thường gặp', sub: [
    { text: 'Chọn lọc tự nhiên tác động lên kiểu gene trước rồi mới tới kiểu hình.', ans: false, exp: 'Chọn lọc "nhìn" thấy KIỂU HÌNH; kiểu gene chỉ thay đổi hệ quả, và allele lặn được giấu ở dị hợp nên chọn lọc chậm.' },
    { text: 'Quần thể cân bằng Hardy–Weinberg phải có giao phối ngẫu nhiên và không có chọn lọc, đột biến, di nhập.', ans: true, exp: 'Đây là 5 điều kiện của mô hình: quần thể lớn, giao phối ngẫu nhiên, không đột biến, không di nhập, không chọn lọc.' },
    { text: 'Tần số hoán vị gene 20% nghĩa là mỗi loại giao tử tái tổ hợp chiếm 20%.', ans: false, exp: '20% là TỔNG hai loại giao tử hoán vị ⇒ mỗi loại 10%; hai loại giao tử bố mẹ mỗi loại 40%.' },
    { text: 'Đột biến đồng nghĩa không làm thay đổi chuỗi polypeptide.', ans: true, exp: 'Nhờ tính thoái hóa của mã di truyền, nhiều codon khác nhau vẫn mã hóa cùng acid amin — nhưng vẫn có thể ảnh hưởng điều hòa hoặc cấu trúc mRNA.' }
  ]}
];

const V4_SHORT = [
  { q:'Một enzyme có Km = 4 mM, Vmax = 80 µmol/phút. Tính tốc độ khi [S] = 12 mM.', ans:'60', cells:['6','0','',''],
    exp:'v = Vmax·[S]/(Km+[S]) = 80×12/(4+12) = 960/16 = 60 µmol/phút. Kiểm tra: [S] = 3Km ⇒ v = 3/4 Vmax = 60 ✓.' },
  { q:'Gen có 1500 nucleotide, trong đó A = 300. Tính số liên kết hydrogen của gen.', ans:'1950', cells:['1','9','5','0',''],
    exp:'A = T = 300 ⇒ A + T = 600. G + C = 1500 − 600 = 900 ⇒ G = 450. H = 2A + 3G = 2×300 + 3×450 = 600 + 1350 = 1950. Kiểm tra: 300 + 300 + 450 + 450 = 1500 ✓.' },
  { q:'Quần thể 5000 cá thể, tần số allele a = 0,2. Tính số cá thể dị hợp ở trạng thái cân bằng.', ans:'1600', cells:['1','6','0','0',''],
    exp:'p = 0,8; 2pq = 2×0,8×0,2 = 0,32 ⇒ 0,32 × 5000 = 1600 cá thể.' },
  { q:'Hai gene liên kết cách 12 cM. Lai phân tích AaBb (kiểu AB/ab), tỉ lệ con có kiểu hình A_bb là bao nhiêu %?', ans:'6', cells:['6','','',''],
    exp:'Giao tử hoán vị tổng 12% ⇒ mỗi loại (Ab, aB) 6%. Kiểu hình A_bb cần giao tử Ab từ cơ thể dị hợp và ab từ cơ thể lặn ⇒ 6%.' },
  { q:'Một người có pO₂ động mạch 60 mmHg. Dùng phương trình Hill với P50 = 26,6 và n = 2,7, ước tính độ bão hoà Hb (%).', ans:'90', cells:['9','0','',''],
    exp:'SaO₂ = 100·pO₂^n/(pO₂^n + P50^n). 60^2,7 ≈ 63 400; 26,6^2,7 ≈ 7 100 ⇒ 63 400/70 500 ≈ 90%. Đây chính là "đầu gối" của đường cong chữ S.' },
  { q:'Cầu thận lọc 125 mL/phút, tái hấp thu 98,8%. Tính thể tích nước tiểu trong 1 ngày (mL, làm tròn).', ans:'2160', cells:['2','1','6','0',''],
    exp:'Nước tiểu/phút = 125 × (1 − 0,988) = 1,5 mL/ph ⇒ 1,5 × 1440 = 2160 mL/ngày (≈2,2 L) — khớp sinh lý bình thường.' },
  { q:'Một gen nhân đôi 4 lần. Tính tỉ lệ số phân tử DNA con chứa ít nhất một mạch gốc.', ans:'12.5', cells:['1','2','.','5',''],
    exp:'Sau 4 lần có 16 DNA. Chỉ 2 DNA giữ một trong hai mạch gốc (bán bảo toàn) ⇒ 2/16 = 12,5%.' },
  { q:'Tăng CO₂ từ 400 lên 800 ppm (Km ≈ 300 ppm). Vmax quang hợp tăng khoảng mấy lần (làm tròn 1 chữ số thập phân)?', ans:'1.3', cells:['1','.','3',''],
    exp:'Hệ số CO₂ = (800/(800+300)) ÷ (400/(400+700)) = 0,727 ÷ 0,571 ≈ 1,27 ≈ 1,3 lần. Lưu ý CO₂ tăng cũng đẩy điểm bão hòa ánh sáng sang phải, nên chỉ có lợi khi đủ sáng.' }
];

/* ---------- ví dụ thông minh: lời giải từng bước ---------- */
const SMART_EXAMPLES = [
  { topic:'Di truyền', title:'Đếm liên kết hydrogen — đừng nhầm "cặp" và "nucleotide"',
    given:'Gen có 3000 nucleotide, hiệu số giữa số liên kết hydrogen và số nucleotide là 900. Tìm số G.',
    steps:['Đặt A = T = x, G = C = y. Tổng nucleotide: 2x + 2y = 3000 ⇒ x + y = 1500.',
           'Liên kết hydrogen: A–T có 2, G–C có 3 ⇒ H = 2x + 3y.',
           'Theo đề H − 3000 = 900 ⇒ H = 3900.',
           'Thay x = 1500 − y: 2(1500 − y) + 3y = 3900 ⇒ 3000 + y = 3900 ⇒ y = 900.'],
    answer:'G = C = 900; A = T = 600. Kiểm tra: 2×600 + 3×900 = 3900 ✓',
    trick:'Nếu đề ghi "3000 CẶP nucleotide" thì tổng nucleotide là 6000 — luôn đọc kỹ đơn vị.' },
  { topic:'Quy luật', title:'Hoán vị gene — 20% là TỔNG, không phải mỗi loại',
    given:'Hai gene cách 20 cM. Lai phân tích Ab/aB. Tỉ lệ giao tử aB?',
    steps:['Xác định giao tử bố mẹ: Ab và aB (đọc theo từng dòng của kiểu gene Ab/aB).',
           'Tổng giao tử hoán vị = 20% ⇒ AB = 10%, ab = 10%.',
           'Còn lại 80% là giao tử bố mẹ, chia đều cho 2 loại ⇒ Ab = 40%, aB = 40%.'],
    answer:'aB = 40%.', trick:'Bẫy kinh điển là chọn 20% hoặc 10%. Phải xác định kiểu sắp xếp (cis/trans) trước.' },
  { topic:'Quần thể', title:'Hardy–Weinberg — đi từ kiểu hình lặn ngược lên tần số allele',
    given:'Quần thể cân bằng có 16% cá thể aa. Tính tỉ lệ dị hợp Aa.',
    steps:['aa = q² = 0,16 ⇒ q = √0,16 = 0,4.',
           'p = 1 − q = 0,6.',
           'Dị hợp = 2pq = 2 × 0,6 × 0,4 = 0,48.',
           'Kiểm tra: p² + 2pq + q² = 0,36 + 0,48 + 0,16 = 1 ✓'],
    answer:'48% dị hợp; 84% mang kiểu hình trội.', trick:'84% là kiểu hình trội (AA + Aa), KHÔNG phải tần số allele A (0,6).' },
  { topic:'Sinh lý', title:'Đường cong Hill — vì sao 60 mmHg là "đầu gối"',
    given:'So sánh SaO₂ tại pO₂ = 100, 60 và 40 mmHg (P50 = 26,6; n = 2,7).',
    steps:['Công thức: SaO₂ = 100·pⁿ/(pⁿ + P50ⁿ).',
           'p = 100 ⇒ ≈ 98,6% (đã gần bão hòa, tăng thêm pO₂ gần như vô dụng).',
           'p = 60 ⇒ ≈ 90%; p = 40 ⇒ ≈ 76%.',
           'Chênh 100→60 chỉ mất ~9%, nhưng 60→40 mất ~14% — đoạn dưới dốc hẳn.'],
    answer:'98,6% → 90% → 76%.', trick:'Đây là lợi của bắt hợp tác: mô đang hoạt động (pO₂ thấp) được nhận O₂ nhiều hơn hẳn.' },
  { topic:'Thực vật', title:'Điểm bù & điểm bão hòa — đọc đồ thị quang hợp',
    given:'Tăng CO₂ từ 400 lên 800 ppm (Km ≈ 300 ppm). Điều gì xảy ra với đường cong?',
    steps:['Hệ số CO₂ = (800/1100) ÷ (400/700) ≈ 1,27 ⇒ Vmax tăng ~27%.',
           'Hằng số bão hòa ánh sáng cũng tăng tỉ lệ ⇒ điểm bão hòa dời sang phải.',
           'Điểm bù dời sang trái (cần ít sáng hơn để bù hô hấp).',
           'Kết luận: tăng CO₂ chỉ có lợi khi ánh sáng ĐỦ MẠNH.'],
    answer:'Đường cong dốc hơn, cao hơn, bão hòa muộn hơn.', trick:'Trong nhà kính, bón CO₂ mà thiếu đèn thì hầu như không tăng năng suất.' },
  { topic:'Tế bào', title:'Michaelis–Menten — đọc Km như đọc ái lực',
    given:'Enzyme A: Km = 2 mM; enzyme B: Km = 20 mM; cùng Vmax. Ở [S] = 2 mM, enzyme nào chạy nhanh hơn?',
    steps:['v = Vmax·[S]/(Km + [S]).',
           'A: v = Vmax·2/(2+2) = 0,5 Vmax (đúng Km ⇒ nửa Vmax).',
           'B: v = Vmax·2/(20+2) ≈ 0,09 Vmax.',
           'Km nhỏ ⇒ ái lực cao ⇒ bão hòa sớm ở nồng độ cơ chất thấp.'],
    answer:'Enzyme A nhanh hơn ~5,5 lần ở [S] = 2 mM; nhưng cả hai CÙNG Vmax khi [S] → ∞.',
    trick:'Km nói về ÁI LỰC, Vmax nói về NĂNG LỰC TỐI ĐA — đây là hai trục khác nhau.' },
  { topic:'Thận', title:'Nước tiểu = hiệu số, không phải lượng lọc',
    given:'Người A: GFR 125 mL/ph, tái hấp thu 99%. Người B: GFR 40 mL/ph, tái hấp thu 99%. Ai thiểu niệu?',
    steps:['A: 125 × 1% = 1,25 mL/ph ≈ 1,8 L/ngày — bình thường.',
           'B: 40 × 1% = 0,4 mL/ph ≈ 0,6 L/ngày — thiểu niệu.',
           'Dù tỉ lệ tái hấp thu giống hệt, GFR thấp vẫn làm nước tiểu giảm.',
           'Ngược lại: thiếu ADH đẩy tỉ lệ tái hấp thu xuống ⇒ đa niệu dù GFR bình thường.'],
    answer:'Người B thiểu niệu.', trick:'Thận còn tự điều hoà: GFR gần phẳng trong khoảng 80–180 mmHg, chỉ tụt khi huyết áp thấp thật sự.' },
  { topic:'Đột biến', title:'Dịch khung — thêm 1 nucleotide nguy hiểm hơn thay 1 nucleotide',
    given:'So sánh hậu quả của thay thế 1 cặp và thêm 1 cặp ở giữa vùng mã hóa.',
    steps:['Thay thế: chỉ 1 codon đổi ⇒ có thể đồng nghĩa (vẫn cùng acid amin) hoặc sai nghĩa (đổi 1 acid amin).',
           'Thêm 1 cặp: khung đọc bị lệch từ vị trí đó ⇒ MỌI codon phía sau đều đổi.',
           'Thường xuất hiện sớm một codon kết thúc sớm ⇒ protein cụt, mất chức năng.',
           'Ngoại lệ: thêm/mất đúng bội của 3 ⇒ chỉ thêm/mất acid amin, không lệch khung.'],
    answer:'Thêm 1 cặp gây hậu quả nặng hơn hẳn.', trick:'Đề hay bẫy bằng "thêm 3 cặp" — trường hợp đó KHÔNG dịch khung.' }
];

MCQS.push(...V4_MCQ);
TFS.push(...V4_TF);
SHORTS.push(...V4_SHORT);

/* ============================================================
   v4.6 · NGÂN HÀNG BỔ SUNG TỪ TÀI LIỆU THẬT
   Chuyên đề mới dm = Dịch mã & biểu hiện gene (Bài 7 GV PDF).
   Mỗi câu có tip / why / trap để phần "Câu sai & hướng dẫn chi tiết"
   sau khi Solo hiển thị đủ cách làm, bản chất và bẫy thường gặp.
   ============================================================ */
TOPICS.dm = { n: 'Dịch mã & biểu hiện gene', c: '#00f3ff' };
TOPIC_METHOD.dm = [
  'Đọc kỹ chiều của mạch: mạch khuôn 3′→5′, mRNA và mạch mã hóa 5′→3′; RNA có U thay T.',
  'Chia mRNA thành các bộ ba liên tiếp từ codon mở đầu 5′-AUG-3′; dừng ở UAA / UAG / UGA.',
  'Đổi codon thành amino acid theo bảng mã; nhớ codon kết thúc KHÔNG mã hóa amino acid, và đề hỏi số amino acid hay số nucleotide.'
];
TOPIC_STUDY.dm = 'Ôn lại Bài 7: mã di truyền là mã bộ ba, thành phần tham gia dịch mã, nguyên tắc bổ sung codon–anticodon, chiều phiên mã/dịch mã, sơ đồ gene → mRNA → protein → tính trạng và các thí nghiệm ống nghiệm X, Y, Z.';

const V5_MCQ = [
  /* --- BÀI 7: KHÁI NIỆM MÃ DI TRUYỀN & DỊCH MÃ --- */
  { t:'dm', d:1, q:'Theo Bài 7 (Dịch mã và mối quan hệ từ gene đến tính trạng), mã di truyền là:', o:['Một bộ ba nucleotide liên tiếp trên mRNA quy định một amino acid','Một nucleotide đơn lẻ trên DNA mang toàn bộ thông tin','Toàn bộ trình tự nucleotide của một gene','Đoạn DNA không được phiên mã'], a:0,
    tip:'Mã di truyền là mã BỘ BA (codon), đọc trên mRNA.', why:'Cứ 3 nucleotide liên tiếp trên mRNA tạo 1 codon, quy định 1 amino acid (hoặc tín hiệu kết thúc). Có 4³ = 64 codon: 61 codon mã hóa 20 amino acid và 3 codon kết thúc.', trap:'Nhầm với "gen là một đoạn DNA mã hóa" — gen là đơn vị vật chất, còn mã di truyền là quy tắc đọc bộ ba.' },
  { t:'dm', d:1, q:'Dịch mã là quá trình:', o:['Tổng hợp mRNA từ mạch khuôn DNA','Tổng hợp chuỗi polypeptide dựa trên trình tự nucleotide của mRNA','Nhân đôi phân tử DNA','Gắn amino acid vào tRNA nhờ aminoacyl-tRNA synthetase'], a:1,
    tip:'Dịch mã = đọc mRNA để lắp amino acid thành chuỗi.', why:'Dịch mã diễn ra trên ribosome: mRNA làm khuôn, tRNA mang amino acid tới theo nguyên tắc bổ sung codon–anticodon, liên kết peptide được hình thành nối các amino acid.', trap:'Gắn amino acid vào tRNA chỉ là bước chuẩn bị (hoạt hóa amino acid), chưa phải dịch mã.' },
  { t:'dm', d:1, q:'Thành phần nào KHÔNG trực tiếp tham gia quá trình dịch mã?', o:['mRNA','tRNA','Ribosome','DNA polymerase'], a:3,
    tip:'DNA polymerase chỉ làm việc ở tái bản DNA.', why:'Dịch mã cần mRNA (khuôn), tRNA (vận chuyển amino acid), ribosome (nơi tổng hợp), amino acid tự do, enzyme và năng lượng. DNA polymerase xúc tác nhân đôi DNA, không có mặt trong dịch mã.', trap:'RNA polymerase cũng không tham gia dịch mã, nhưng nó thuộc phiên mã; đề hay thay bằng enzyme này để bẫy.' },
  { t:'dm', d:1, q:'Trong dịch mã, nguyên tắc bổ sung xảy ra giữa:', o:['Codon trên mRNA và anticodon trên tRNA (A–U, G–C)','Hai mạch đơn của DNA','mRNA và rRNA của ribosome','Amino acid và mạch mang của gene'], a:0,
    tip:'Codon ↔ anticodon: A bắt U, G bắt C.', why:'tRNA mang bộ ba đối mã (anticodon) bắt cặp bổ sung với codon trên mRNA theo A=U, G≡C, nhờ đó amino acid được đưa đúng vị trí.', trap:'Nguyên tắc bổ sung giữa hai mạch DNA là A–T (có T, không có U) — đừng áp sang mRNA.' },
  { t:'dm', d:1, q:'Codon mở đầu của quá trình dịch mã là:', o:['5′-AUG-3′','5′-UAA-3′','5′-UGA-3′','5′-UUU-3′'], a:0,
    tip:'AUG = mở đầu, đồng thời mã hóa methionine.', why:'Ribosome nhận diện 5′-AUG-3′ để bắt đầu khung đọc; AUG mã hóa Met (ở nhân sơ là fMet). UAA, UAG, UGA là 3 codon kết thúc.', trap:'5′-UUU-3′ mã hóa phenylalanine, không phải tín hiệu mở đầu.' },
  { t:'dm', d:1, q:'Codon mở đầu trên phân tử mRNA không chứa nucleotide loại nào?', o:['A','U','G','T'], a:3,
    tip:'RNA có A, U, G, C — không có T.', why:'Codon mở đầu là 5′-AUG-3′ gồm A, U, G. Timin (T) chỉ có trong DNA; mRNA thay T bằng U.', trap:'Đây là câu hỏi mẹo: đừng vội tra bảng mã, chỉ cần nhớ thành phần nucleotide của RNA.' },
  { t:'dm', d:2, q:'Trong phiên mã, RNA polymerase di chuyển và tổng hợp như thế nào?', o:['Đọc mạch khuôn 3′→5′ và tổng hợp mRNA 5′→3′','Đọc mạch khuôn 5′→3′ và tổng hợp mRNA 3′→5′','Đọc mạch mã hóa 3′→5′ và tổng hợp mRNA 3′→5′','Đọc cả hai mạch và tổng hợp hai mRNA'], a:0,
    tip:'Mạch mới luôn được kéo dài 5′→3′.', why:'Vì nucleotide mới chỉ gắn được vào đầu 3′-OH, mọi polymerase đều tổng hợp 5′→3′. Do hai mạch DNA đối chiều, mạch khuôn phải được đọc theo chiều 3′→5′.', trap:'Chỉ 1 trong 2 mạch của gene làm khuôn; mạch còn lại gọi là mạch mã hóa.' },
  { t:'dm', d:2, q:'Ribosome đọc mRNA theo chiều nào và chuỗi polypeptide được kéo dài từ đầu nào?', o:['Đọc 5′→3′; kéo dài từ đầu amino (-NH2) về đầu carboxyl (-COOH)','Đọc 3′→5′; kéo dài từ đầu carboxyl','Đọc 5′→3′; kéo dài từ đầu carboxyl','Đọc 3′→5′; kéo dài từ đầu amino'], a:0,
    tip:'Amino acid mở đầu (Met) nằm ở đầu -NH2.', why:'Ribosome trượt trên mRNA theo chiều 5′→3′. Amino acid đầu tiên giữ nguyên nhóm amino tự do; mỗi amino acid mới gắn vào nhóm carboxyl của chuỗi, nên chuỗi dài dần về phía -COOH.', trap:'Nhiều em nhầm rằng chiều đọc 5′→3′ đồng nghĩa chuỗi lớn lên từ đầu carboxyl — không phải.' },
  { t:'dm', d:1, q:'Trên một phân tử mRNA thường có nhiều ribosome cùng hoạt động. Cấu trúc đó gọi là:', o:['Polyribosome (polysome)','Nucleosome','Polynucleotide','Polypeptide'], a:0,
    tip:'Nhiều ribosome trên cùng 1 mRNA = polyribosome.', why:'Mỗi ribosome đọc độc lập cùng một mRNA nên tạo ra nhiều chuỗi polypeptide GIỐNG HỆT NHAU, giúp tổng hợp nhanh nhiều protein mà không cần phiên mã thêm mRNA.', trap:'Nucleosome là đơn vị cấu trúc của nhiễm sắc thể (DNA quấn quanh histone), không liên quan đến dịch mã.' },
  { t:'dm', d:1, q:'Sơ đồ: DNA --(1)--> DNA; DNA --(2)--> mRNA --(3)--> protein. Các số 1, 2, 3 lần lượt là:', o:['Tái bản, phiên mã, dịch mã','Phiên mã, dịch mã, tái bản','Dịch mã, tái bản, phiên mã','Tái bản, dịch mã, phiên mã'], a:0,
    tip:'DNA tự nhân đôi → phiên mã ra mRNA → dịch mã ra protein.', why:'(1) Tái bản giúp thông tin di truyền truyền từ tế bào mẹ sang con, đời này sang đời khác. (2) và (3) là hai bước biểu hiện gene: phiên mã rồi dịch mã; protein (enzyme, cấu trúc) cùng môi trường tạo nên tính trạng.', trap:'Nhớ thêm mũi tên cuối: protein → tính trạng chịu tác động của môi trường.' },
  { t:'dm', d:2, q:'Thông tin di truyền trong DNA được biểu hiện thành tính trạng của cơ thể nhờ cơ chế nào?', o:['Nhân đôi DNA và phiên mã','Phiên mã và dịch mã','Nhân đôi DNA và dịch mã','Chỉ cần phiên mã'], a:1,
    tip:'Biểu hiện gene = phiên mã + dịch mã.', why:'Phiên mã chép thông tin từ gene sang mRNA, dịch mã đổi trình tự nucleotide thành trình tự amino acid của protein. Protein (enzyme/chức năng) quy định tính trạng, nên nhân đôi DNA không phải bước biểu hiện.', trap:'Nhân đôi chỉ bảo tồn và truyền thông tin, không tạo ra sản phẩm biểu hiện.' },
  { t:'dm', d:2, q:'Mã di truyền quy định điều gì đối với phân tử protein?', o:['Chỉ số lượng amino acid','Cả thành phần hóa học (loại, số lượng) và cấu trúc (trình tự sắp xếp) amino acid','Chỉ trình tự nucleotide của gene','Chỉ khối lượng phân tử của protein'], a:1,
    tip:'Thành phần hóa học + cấu trúc bậc một.', why:'Trình tự codon trên mRNA quy định loại, số lượng VÀ thứ tự amino acid trong chuỗi polypeptide. Chính sự khác biệt về trình tự này tạo ra vô số protein khác nhau, góp phần tạo nên sự đa dạng sinh vật.', trap:'Đừng tách riêng "chỉ số lượng" hay "chỉ trình tự" — mã di truyền quy định cả hai.' },
  { t:'dm', d:2, q:'Đột biến thay thế một cặp nucleotide trong gene nhưng trình tự amino acid của protein không đổi. Giải thích đúng là:', o:['Mã di truyền có tính đặc hiệu','Mã di truyền có tính phổ biến','Mã di truyền là mã bộ ba','Mã di truyền có tính thoái hóa'], a:3,
    tip:'Nhiều codon cùng mã hóa một amino acid = thoái hóa.', why:'Ví dụ GCU, GCC, GCA, GCG đều mã hóa alanine. Thay nucleotide thứ ba vẫn cho cùng amino acid (đột biến im lặng). Đây là hệ quả của tính thoái hóa, thường gọi là vị trí wobble.', trap:'Tính đặc hiệu là MỘT codon chỉ mã hóa MỘT amino acid — tính chất ngược lại, không giải thích được hiện tượng này.' },
  { t:'dm', d:2, q:'Trong thí nghiệm 3 ống nghiệm X, Y, Z (Bài 7), ống X giữ nguyên 100% nồng độ cả 4 loại nucleotide tự do A, T, U, G, C. Ống X tương ứng với quá trình nào?', o:['Dịch mã','Phiên mã','Tái bản DNA','Phiên mã ngược'], a:0,
    tip:'Dịch mã tiêu thụ AMINO ACID, không tiêu thụ nucleotide tự do.', why:'Dịch mã lắp amino acid thành chuỗi polypeptide; nucleotide của mRNA chỉ làm khuôn chứ không bị tiêu thụ, nên nồng độ các nucleotide tự do trong ống vẫn 100%.', trap:'Đừng thấy mRNA có mặt là vội kết luận phiên mã — hãy xem chất nền (substrate) nào bị tiêu thụ.' },
  { t:'dm', d:3, q:'Ống nghiệm Y có nồng độ T giữ nguyên 100%, trong khi A, U, G đều giảm xuống dưới 100%. Ống Y là quá trình:', o:['Dịch mã','Phiên mã','Tái bản DNA','Phân giải protein'], a:1,
    tip:'Phiên mã dùng ribonucleotide A, U, G, C — không dùng T.', why:'Phiên mã lấy khuôn là DNA (đã có sẵn T trong mạch khuôn) và tiêu thụ các ribonucleotide tự do A, U, G, C để kéo dài mRNA. Vì vậy T không bị tiêu thụ.', trap:'Đây là điểm phân biệt ống phiên mã với ống tái bản: ở tái bản thì U giữ nguyên, T giảm.' },
  { t:'dm', d:3, q:'Ống nghiệm Z có nồng độ U giữ nguyên 100%, trong khi A, T, G, C đều giảm. Ống Z là quá trình:', o:['Dịch mã','Phiên mã','Tái bản DNA','Tổng hợp tRNA'], a:2,
    tip:'Tái bản dùng deoxyribonucleotide A, T, G, C — không dùng U.', why:'Nhân đôi DNA tiêu thụ dATP, dTTP, dGTP, dCTP để tổng hợp mạch mới; U (uracil) chỉ có trong RNA nên không được dùng và giữ nguyên nồng độ.', trap:'Nếu thấy U giảm và T giữ nguyên thì đó là ống phiên mã (Y), không phải Z.' },
  { t:'dm', d:2, q:'Đoạn mRNA 5′-AUG-GCU-CAU-CGU-UAA-3′ mã hóa một chuỗi gồm bao nhiêu amino acid?', o:['5','4','3','6'], a:1,
    tip:'Đếm codon mã hóa, bỏ codon kết thúc nhưng GIỮ codon mở đầu.', why:'AUG (Met), GCU (Ala), CAU (His), CGU (Arg) = 4 amino acid. UAA là codon kết thúc, không mã hóa amino acid.', trap:'Hai lỗi thường gặp: đếm cả UAA thành 5, hoặc bỏ AUG vì tưởng chỉ là tín hiệu (AUG vẫn mã hóa Met).' },
  { t:'dm', d:2, q:'Dịch mã đoạn mRNA 5′-AUG-UCU-CCU-UGA-3′ thu được chuỗi polypeptide nào?', o:['Met–Ser–Pro','Met–Ser–Pro–Trp','Ser–Pro','Met–Ser–Pro–Gly'], a:0,
    tip:'AUG=Met, UCU=Ser, CCU=Pro, UGA=kết thúc.', why:'Ribosome đọc từ AUG; UGA là codon kết thúc nên dịch mã dừng lại, không thêm amino acid nào. Chuỗi gồm 3 amino acid theo đúng thứ tự.', trap:'UGA không mã hóa tryptophan (UGG mới là Trp) cũng không mã hóa glycine.' },
  { t:'dm', d:2, q:'Mạch khuôn của một đoạn gene có trình tự 3′-TAC-GGT-CAA-5′. Đoạn mRNA được phiên mã từ đó là:', o:['5′-AUG-CCA-GUU-3′','5′-AUG-CCA-GTT-3′','3′-AUG-CCA-GUU-5′','5′-TAC-GGT-CAA-3′'], a:0,
    tip:'Bổ sung A–U, T–A, G–C, C–G; mRNA ngược chiều mạch khuôn.', why:'Đọc mạch khuôn 3′→5′ (TAC-GGT-CAA) và tổng hợp mRNA 5′→3′: AUG-CCA-GUU.', trap:'Sai kinh điển là giữ nguyên T trong RNA, hoặc viết mRNA cùng chiều 3′→5′ với mạch khuôn.' },
  { t:'dm', d:2, q:'Mạch mã hóa của gene có đoạn 5′-ATG-CTC-3′. Trình tự mRNA tương ứng là:', o:['5′-AUG-CUC-3′','5′-TAC-GAG-3′','3′-AUG-CUC-5′','5′-ATG-CTC-3′'], a:0,
    tip:'mRNA GIỐNG mạch mã hóa, chỉ thay T bằng U.', why:'Mạch mã hóa (mạch bổ sung với mạch khuôn) có trình tự và chiều trùng với mRNA, khác biệt duy nhất là DNA dùng T còn RNA dùng U.', trap:'5′-TAC-GAG-3′ là mạch KHUÔN đọc ngược, không phải mRNA.' },
  { t:'dm', d:3, q:'Khi dịch mã mRNA nhân tạo lặp lại (GUA)n trong ống nghiệm không có codon mở đầu cố định, một trong ba khung đọc tạo ra chuỗi polypeptide bị ngắn lại. Vì sao?', o:['Khung đọc đó chứa codon kết thúc UAG','GUA không mã hóa amino acid nào','Ribosome không bám được vào mRNA nhân tạo','Thiếu tRNA mang anticodon cho GUA'], a:0,
    tip:'GUA | UAG | AGU — đọc lệch khung là gặp UAG.', why:'Với (GUA)n, ba khung đọc cho các bộ ba GUA, UAG, AGU. UAG là codon kết thúc nên khung đó dịch mã dừng sớm, tạo chuỗi ngắn. Đây là kiểu thí nghiệm dùng polymer nucleotide nhân tạo để giải mã bộ ba.', trap:'GUA vẫn mã hóa valine — đừng nhầm "có codon kết thúc" với "không mã hóa".' },
  { t:'dm', d:3, q:'Thí nghiệm (Bài 7): thuốc 1 làm giảm cả hàm lượng mRNA lẫn protein của gene virus; thuốc 2 làm giảm protein nhưng mRNA gần như không đổi. Kết luận đúng là:', o:['Thuốc 1 ức chế phiên mã, thuốc 2 ức chế dịch mã','Cả hai đều ức chế phiên mã','Thuốc 1 ức chế dịch mã, thuốc 2 ức chế phiên mã','Cả hai đều ức chế tái bản DNA'], a:0,
    tip:'mRNA giảm ⇒ lỗi ở phiên mã; mRNA còn mà protein mất ⇒ lỗi ở dịch mã.', why:'Nếu phiên mã bị chặn, không có mRNA nên protein cũng mất (thuốc 1). Nếu mRNA vẫn được tạo đầy đủ nhưng protein giảm, khâu bị chặn là dịch mã hoặc độ bền protein (thuốc 2).', trap:'Đọc BIỂU ĐỒ theo cặp cột: đừngchỉ nhìn một cột protein rồi vội kết luận.' },
  { t:'dm', d:2, q:'Vì sao 3 codon UAA, UAG, UGA không mã hóa amino acid?', o:['Không có tRNA tương ứng; chúng được nhận diện bởi yếu tố giải phóng','Chúng nằm ngoài khung đọc','Ribosome luôn bỏ qua 3 nucleotide cuối mRNA','Chúng chỉ gồm 2 nucleotide'], a:0,
    tip:'Codon kết thúc = tín hiệu dừng, không có tRNA mang amino acid.', why:'Khi codon kết thúc vào vị trí A của ribosome, yếu tố giải phóng (release factor) gắn vào, thủy phân liên kết giữa polypeptide và tRNA, giải phóng chuỗi và tách ribosome.', trap:'Codon kết thúc vẫn nằm TRONG khung đọc và vẫn được ribosome đọc — chỉ là không có amino acid tương ứng.' },
  { t:'dm', d:1, q:'Tính thoái hóa (degeneracy) của mã di truyền nghĩa là:', o:['Một amino acid có thể được mã hóa bởi nhiều codon khác nhau','Một codon mã hóa cho nhiều amino acid khác nhau','Mã di truyền giống hệt nhau ở mọi loài','Các codon được đọc chồng lấn lên nhau'], a:0,
    tip:'Nhiều codon → một amino acid.', why:'Có 61 codon mã hóa nhưng chỉ 20 amino acid, nên phần lớn amino acid có 2–6 codon (ví dụ leucine có 6 codon). Đây là cơ sở của đột biến im lặng.', trap:'"Một codon → nhiều amino acid" là SAI (tính đặc hiệu); "giống nhau ở mọi loài" là tính phổ biến; "chồng lấn" cũng sai vì mã đọc liên tục không chồng.' },
  { t:'dm', d:3, q:'Chuỗi polypeptide hoàn chỉnh gồm 5 amino acid (đã tính cả amino acid mở đầu). Vùng mã hóa của gene (không có intron, đã tính codon kết thúc) dài ít nhất bao nhiêu CẶP nucleotide?', o:['15','18','16','21'], a:1,
    tip:'5 amino acid + 1 codon kết thúc = 6 codon = 18 nucleotide.', why:'Mỗi codon 3 nucleotide ⇒ 6 × 3 = 18 nucleotide trên mRNA, tương ứng 18 nucleotide trên mỗi mạch DNA, tức 18 CẶP nucleotide (không nhân đôi thêm lần nữa).', trap:'Nhân 18 lên 36 là nhầm giữa "số nucleotide trên 2 mạch" và "số cặp nucleotide"; quên codon kết thúc sẽ ra 15.' },

  /* --- BẢNG MÃ, ANTICODON, CẤU TRÚC GENE --- */
  { t:'dt', d:2, q:'Codon 5′-GCA-3′ trên mRNA mã hóa amino acid nào?', o:['Alanine','Arginine','Glycine','Valine'], a:0,
    tip:'Cả họ GCN (GCU, GCC, GCA, GCG) đều mã hóa alanine.', why:'Bảng mã di truyền: bốn codon bắt đầu bằng GC đều cho Ala. Đây là ví dụ trực tiếp của tính thoái hóa ở vị trí thứ ba.', trap:'GCA dễ bị đọc nhầm thành arginine (họ CGN) hoặc glycine (họ GGN) do cùng chữ G đầu.' },
  { t:'dt', d:2, q:'Một tRNA có anticodon 3′-UAC-5′ sẽ bắt cặp với codon nào trên mRNA?', o:['5′-AUG-3′','5′-UAC-3′','5′-GUA-3′','5′-CAU-3′'], a:0,
    tip:'Hai mạch bắt cặp phải ĐỐI CHIỀU và bổ sung.', why:'Anticodon 3′-UAC-5′ bắt cặp với 5′-AUG-3′ (U–A, A–U, C–G). Đây chính là tRNA mang methionine cho codon mở đầu.', trap:'Viết nguyên 5′-UAC-3′ là quên đảo chiều; 5′-GUA-3′ là đọc ngược anticodon nhưng không bổ sung.' },
  { t:'dt', d:1, q:'Bảng mã di truyền có 64 codon, trong đó 3 codon kết thúc. Số codon thực sự mã hóa amino acid là:', o:['64','61','20','3'], a:1,
    tip:'64 − 3 = 61.', why:'4³ = 64 tổ hợp bộ ba; trừ UAA, UAG, UGA (không mã hóa amino acid) còn 61 codon cho 20 amino acid — chính vì 61 > 20 nên mã di truyền thoái hóa.', trap:'20 là số amino acid, không phải số codon; 64 là tổng số bộ ba kể cả tín hiệu dừng.' },
  { t:'dt', d:1, q:'Vùng nào của gene quyết định cấu trúc phân tử protein do gene đó tổng hợp?', o:['Vùng mã hóa','Vùng điều hòa','Vùng kết thúc','Cả ba vùng như nhau'], a:0,
    tip:'Trình tự nucleotide ở vùng mã hóa quy định trình tự amino acid.', why:'Vùng mã hóa chứa các codon quy định trình tự amino acid. Vùng điều hòa (promoter...) chỉ điều khiển mức độ/ thời điểm phiên mã, vùng kết thúc tín hiệu dừng phiên mã.', trap:'Vùng điều hòa ảnh hưởng đến LƯỢNG protein, không quy định CẤU TRÚC chuỗi amino acid.' },
  { t:'dt', d:1, q:'Nucleotide loại timin (T) có trong cấu trúc của phân tử nào?', o:['DNA','tRNA','mRNA','rRNA'], a:0,
    tip:'RNA dùng uracil (U) thay timin.', why:'Timin là base đặc trưng của DNA (A–T). Cả ba loại RNA đều dùng U (A–U).', trap:'tRNA có vòng TΨC chứa ký hiệu T nhưng đó là ribothymidine biến đổi hiếm, không phải nucleotide timin thông thường của DNA.' },
  { t:'dm', d:2, q:'Trong operon Lac, protein ức chế gắn trực tiếp vào thành phần nào?', o:['Vùng vận hành O','Vùng khởi động P','Gen điều hòa R','Các gen cấu trúc Z, Y, A'], a:0,
    tip:'Ức chế bám O (operator) chặn RNA polymerase.', why:'Gen điều hòa R tổng hợp protein ức chế; protein này gắn vào vùng vận hành O nằm ngay trước nhóm gen cấu trúc, làm RNA polymerase không trượt tiếp được từ P.', trap:'Gen điều hòa là nơi SẢN XUẤT protein ức chế, không phải nơi protein ức chế BÁM.' },
  { t:'dm', d:2, q:'Theo mô hình operon Lac, vì sao protein ức chế bị mất tác dụng khi có lactose?', o:['Lactose liên kết làm thay đổi cấu hình không gian của protein ức chế','Lactose phân hủy hoàn toàn protein ức chế','Lactose làm gen điều hòa ngừng hoạt động hẳn','Gen cấu trúc bất hoạt gen điều hòa'], a:0,
    tip:'Chất cảm ứng gắn biến cấu (allosteric), không phá hủy protein.', why:'Lactose (chất cảm ứng) gắn vào protein ức chế làm đổi cấu hình, protein không còn ái lực với O nên bung ra; RNA polymerase phiên mã được các gen cấu trúc. Khi hết lactose, protein lấy lại cấu hình cũ và bám lại O.', trap:'Gen điều hòa vẫn phiên mã liên tục ở mức thấp — nó không bị "tắt".' },
  { t:'nst', d:2, q:'Guanin dạng hiếm G* bắt cặp với timin (T) trong quá trình nhân đôi DNA. Dạng đột biến điểm nào xuất hiện?', o:['Thay thế cặp G–C bằng cặp A–T','Thay thế cặp A–T bằng cặp G–C','Thêm một cặp G–C','Mất một cặp A–T'], a:0,
    tip:'G*–T → ở lần nhân đôi sau T bắt A ⇒ A–T.', why:'Ban đầu là G–C. G chuyển dạng hiếm G* nên bắt cặp nhầm với T; ở vòng nhân đôi tiếp theo, T làm khuôn tổng hợp A ⇒ cặp G–C ban đầu bị thay bằng A–T (đột biến thay thế chuyển tiếp).', trap:'Đây là THAY THẾ cặp nucleotide, không phải thêm/mất — nên không gây dịch khung đọc.' },

  /* --- TỪ 3 ĐỀ THI THẬT: QUY LUẬT, NST, SINH LÝ --- */
  { t:'ql', d:2, q:'Kết quả phép lai thuận và phép lai nghịch khác nhau, đời con luôn có kiểu hình giống mẹ. Gen quy định tính trạng đó nằm ở:', o:['Ngoài nhân (tế bào chất)','Vùng không tương đồng trên NST Y','NST giới tính X','NST thường'], a:0,
    tip:'Di truyền qua tế bào chất = di truyền theo dòng mẹ.', why:'Tế bào trứng cung cấp gần như toàn bộ tế bào chất (ti thể, lục lạp) cho hợp tử, tinh trùng hầu như không đóng góp. Vì vậy con luôn mang kiểu hình của mẹ và lai thuận/nghịch cho kết quả khác nhau.', trap:'Gen trên NST Y cho di truyền THẲNG (cha → con trai), không phải "giống mẹ".' },
  { t:'nst', d:1, q:'Ở ruồi giấm, bộ nhiễm sắc thể lưỡng bội 2n = 8. Số nhóm gen liên kết của loài này là:', o:['2','4','8','6'], a:1,
    tip:'Số nhóm gen liên kết = số NST trong bộ đơn bội (n).', why:'2n = 8 ⇒ n = 4. Mỗi nhiễm sắc thể mang một nhóm gen liên kết, nên có 4 nhóm.', trap:'Đừng lấy 8 (bộ lưỡng bội) hay 6; với loài có NST giới tính thì vẫn đếm theo số NST của giao tử.' },
  { t:'ql', d:1, q:'Tập hợp các kiểu hình của MỘT kiểu gen tương ứng với các môi trường khác nhau được gọi là:', o:['Mức phản ứng','Thường biến','Mức giới hạn','Mức dao động'], a:0,
    tip:'Mức phản ứng = phổ kiểu hình của một kiểu gen.', why:'Kiểu gen quy định mức phản ứng (phạm vi biểu hiện), còn môi trường quyết định kiểu hình cụ thể nằm ở điểm nào trong phạm vi đó.', trap:'Thường biến là HIỆN TƯỢNG kiểu hình thay đổi theo môi trường; mức phản ứng là KHÁI NIỆM chỉ giới hạn của sự thay đổi đó.' },
  { t:'ql', d:2, q:'Bốn giống lúa có khối lượng 1000 hạt (g) tối đa / tối thiểu lần lượt: số 1 = 300/200; số 2 = 310/220; số 3 = 335/240; số 4 = 325/270. Giống có mức phản ứng rộng nhất là:', o:['Giống số 1','Giống số 2','Giống số 3','Giống số 4'], a:0,
    tip:'Mức phản ứng rộng = hiệu (tối đa − tối thiểu) lớn nhất.', why:'Số 1: 100 g; số 2: 90 g; số 3: 95 g; số 4: 55 g ⇒ giống số 1 rộng nhất.', trap:'Đừng chọn giống có khối lượng tối đa cao nhất (số 3: 335 g) — đề hỏi ĐỘ RỘNG của khoảng biến động, không phải giá trị lớn nhất.' },
  { t:'ql', d:2, q:'Đặc điểm di truyền của quần thể thực vật tự thụ phấn qua các thế hệ là:', o:['Kiểu gen phân hóa thành các dòng thuần, tần số allele không đổi','Tần số allele trội tăng dần','Tỉ lệ thể dị hợp tăng dần','Tần số allele lặn tăng dần'], a:0,
    tip:'Tự thụ làm tăng đồng hợp, KHÔNG làm đổi tần số allele.', why:'Mỗi thế hệ tự thụ giảm một nửa tỉ lệ dị hợp, quần thể tách dần thành các dòng thuần (AA và aa). Vì không có chọn lọc/đột biến/di nhập, tần số allele p, q giữ nguyên.', trap:'Dị hợp GIẢM chứ không tăng; tần số allele chỉ đổi khi có nhân tố tiến hóa tác động.' },
  { t:'nst', d:1, q:'Đột biến gen xảy ra ở tế bào sinh dưỡng của cơ thể được gọi là:', o:['Đột biến xôma','Đột biến giao tử','Đột biến tiền phôi','Đột biến sinh dục'], a:0,
    tip:'Xôma = soma = tế bào thân (sinh dưỡng).', why:'Đột biến xôma phát sinh ở tế bào sinh dưỡng, chỉ di truyền cho các dòng tế bào con qua nguyên phân, không truyền qua sinh sản hữu tính (trừ khi phát sinh ở mô sinh dưỡng của cây nhân giống vô tính).', trap:'Đột biến giao tử (sinh dục) mới truyền được cho đời sau qua thụ tinh.' },
  { t:'dv', d:1, q:'Động vật nào sau đây có hệ tuần hoàn hở?', o:['Châu chấu','Mực ống','Bạch tuộc','Giun đốt'], a:0,
    tip:'Côn trùng có hệ tuần hoàn hở (máu tràn vào xoang cơ thể).', why:'Ở châu chấu, dịch tuần hoàn (hemolymph) không nằm hoàn toàn trong mạch, mà tràn vào các xoang và tưới trực tiếp mô. Mực ống, bạch tuộc (động vật thân mềm chân đầu) và giun đốt có hệ tuần hoàn kín.', trap:'Không phải mọi động vật thân mềm đều hở: chân đầu (mực, bạch tuộc) có hệ KÍN.' },
  { t:'tv', d:1, q:'Quá trình thoát hơi nước ở thực vật chủ yếu xảy ra theo con đường nào?', o:['Qua khí khổng','Qua lớp cutin','Qua lông hút','Qua toàn bộ bề mặt thân'], a:0,
    tip:'Khoảng 90–95% hơi nước thoát qua khí khổng.', why:'Khí khổng đóng mở được nhờ tế bào bảo vệ, vừa trao đổi khí vừa là đường thoát hơi nước chính. Thoát qua cutin chỉ chiếm tỉ lệ rất nhỏ.', trap:'Lông hút là nơi HẤP THỤ nước và ion khoáng ở rễ, không phải nơi thoát hơi nước.' },
  { t:'tb', d:1, q:'Ở thực vật, con đường hô hấp hiếu khí và hô hấp kị khí chung nhau giai đoạn nào?', o:['Đường phân','Lên men','Chu trình Krebs','Chuỗi vận chuyển electron'], a:0,
    tip:'Cả hai đều bắt đầu bằng đường phân (glycolysis) ở bào tương.', why:'Glucose → 2 pyruvate (đường phân) diễn ra dù có hay không có O2. Sau đó: có O2 → Krebs + chuỗi truyền electron; thiếu O2 → lên men.', trap:'Lên men CHỈ có ở kị khí; Krebs và chuỗi truyền electron chỉ có ở hiếu khí.' },
  { t:'ql', d:2, q:'Theo thuyết tiến hóa hiện đại, chọn lọc tự nhiên tác động TRỰC TIẾP lên:', o:['Kiểu hình của sinh vật','Kiểu gen của sinh vật','Tất cả allele trong quần thể','Toàn bộ gene trong cơ thể'], a:0,
    tip:'Môi trường "nhìn thấy" kiểu hình, không đọc được kiểu gen.', why:'Cá thể có kiểu hình thích nghi hơn sẽ sống sót và sinh sản nhiều hơn, làm thay đổi tần số allele GIÁN TIẾP qua các thế hệ.', trap:'Tần số allele thay đổi là HỆ QUẢ, không phải đối tượng tác động trực tiếp.' },
  { t:'dm', d:2, q:'Trong cơ chế điều hòa ở sinh vật nhân thực, phát biểu nào SAI?', o:['Trong dịch mã, nguyên tắc bổ sung xảy ra ở mọi nucleotide của mRNA kể cả vùng không được dịch','Trong tái bản DNA, nguyên tắc bổ sung xảy ra trên cả hai mạch đơn làm khuôn','Protein ức chế operon Lac bám vào vùng vận hành O','Nhiễm sắc thể điều hòa hoạt động gene thông qua mức độ cuộn xoắn'], a:0,
    tip:'mRNA có vùng UTR không được dịch mã.', why:'Codon–anticodon chỉ bắt cặp tại các nucleotide thuộc vùng mã hóa đang được ribosome đọc; đầu 5′UTR, 3′UTR và đuôi poly-A không được dịch nên không có sự bắt cặp với tRNA.', trap:'Đây là dạng câu "chọn phát biểu sai" — hãy gạch chân từ "mọi / tất cả" để tìm điểm cực đoan.' }
];

const V5_TF = [
  { title:'Bài 7 · Chiều phiên mã & dịch mã', sub:[
    { text:'RNA polymerase đọc mạch khuôn theo chiều 3′→5′ và tổng hợp mRNA theo chiều 5′→3′.', ans:true, exp:'Mạch mới luôn kéo dài ở đầu 3′-OH nên chỉ tổng hợp 5′→3′; vì hai mạch DNA đối chiều, mạch khuôn phải được đọc 3′→5′.' },
    { text:'Ribosome trượt trên mRNA theo chiều 3′→5′ nên codon mở đầu nằm ở đầu 3′.', ans:false, exp:'Ngược lại: ribosome đọc mRNA 5′→3′, codon mở đầu 5′-AUG-3′ nằm ở phía đầu 5′.' },
    { text:'Codon 5′-AUG-3′ vừa là tín hiệu mở đầu vừa mã hóa methionine.', ans:true, exp:'AUG quy định Met (fMet ở nhân sơ) và cũng là nơi ribosome khởi đầu khung đọc, nên amino acid mở đầu luôn là Met.' },
    { text:'Codon UAA, UAG, UGA mã hóa một loại amino acid đặc biệt giúp kết thúc chuỗi.', ans:false, exp:'Không có tRNA tương ứng. Yếu tố giải phóng nhận diện 3 codon này và cắt đứt liên kết giữa polypeptide với tRNA; chúng không mã hóa amino acid nào.' }
  ]},
  { title:'Bài 7 · Tính chất của mã di truyền', sub:[
    { text:'Một amino acid có thể được mã hóa bởi nhiều codon khác nhau (tính thoái hóa).', ans:true, exp:'61 codon mã hóa cho 20 amino acid, nên phần lớn amino acid có từ 2 đến 6 codon; ví dụ họ GCN đều cho alanine.' },
    { text:'Một codon có thể mã hóa cho nhiều amino acid khác nhau tùy vào loại tế bào.', ans:false, exp:'Đây là tính ĐẶC HIỆU: mỗi codon chỉ quy định một amino acid, không đổi theo loại tế bào hay môi trường.' },
    { text:'Mã di truyền được đọc liên tục, không có dấu ngăn cách và không chồng lấn giữa các codon.', ans:true, exp:'Ribosome đọc từng bộ ba liền nhau kể từ AUG; thêm hoặc mất 1 nucleotide (không phải bội của 3) sẽ làm dịch khung đọc.' },
    { text:'Thay thế nucleotide ở vị trí thứ ba của codon luôn làm thay đổi amino acid.', ans:false, exp:'Vị trí thứ ba thường là vị trí wobble; nhờ tính thoái hóa, thay đổi ở đây thường cho cùng amino acid (đột biến im lặng).' }
  ]},
  { title:'Bài 7 · Thí nghiệm 3 ống nghiệm X, Y, Z', sub:[
    { text:'Ống giữ nguyên 100% nồng độ A, T, U, G, C là ống dịch mã.', ans:true, exp:'Dịch mã tiêu thụ amino acid và ATP/GTP, không tiêu thụ nucleotide tự do nên cả bốn loại nucleotide vẫn nguyên vẹn.' },
    { text:'Ống có T giữ nguyên 100% trong khi A, U, G giảm là ống phiên mã.', ans:true, exp:'Phiên mã dùng ribonucleotide A, U, G, C để kéo dài mRNA; T chỉ có sẵn trên mạch DNA làm khuôn, không bị tiêu thụ.' },
    { text:'Ống có U giữ nguyên 100% trong khi A, T, G, C giảm là ống tái bản DNA.', ans:true, exp:'Tái bản dùng dATP, dTTP, dGTP, dCTP. U chỉ có trong RNA nên không được dùng và giữ nguyên nồng độ.' },
    { text:'Ống phiên mã tiêu thụ nhiều nucleotide T vì mRNA được tổng hợp có chứa T.', ans:false, exp:'mRNA chứa U chứ không chứa T. T là base của DNA, nên ống phiên mã không tiêu thụ T.' }
  ]},
  { title:'Bài 7 · Từ gene đến tính trạng', sub:[
    { text:'Protein (đặc biệt là enzyme) là khâu trung gian để gene biểu hiện thành tính trạng.', ans:true, exp:'Gene → mRNA → protein → (cùng môi trường) → tính trạng. Enzyme xúc tác phản ứng tạo sắc tố, hormone, cấu trúc tế bào...' },
    { text:'Môi trường có thể làm thay đổi kiểu hình mà không làm thay đổi kiểu gen.', ans:true, exp:'Đó là thường biến, nằm trong mức phản ứng do kiểu gen quy định; ví dụ hoa phù dung đổi màu theo nhiệt độ/ánh sáng trong ngày.' },
    { text:'Phiên mã và dịch mã là hai cơ chế biểu hiện thông tin di truyền thành tính trạng.', ans:true, exp:'Nhân đôi DNA chỉ truyền thông tin sang tế bào con; phiên mã + dịch mã mới tạo ra sản phẩm (protein) biểu hiện ra kiểu hình.' },
    { text:'Một gene luôn chỉ quy định đúng một tính trạng và không bao giờ ảnh hưởng đến tính trạng khác.', ans:false, exp:'Một gene có thể ảnh hưởng nhiều tính trạng (đa hiệu), và một tính trạng thường do nhiều gene cùng quy định (tương tác gen, di truyền số lượng).' }
  ]}
];

const V5_SHORT = [
  { q:'Đoạn mRNA 5′-AUG-GCU-CAU-CGU-UAA-3′ mã hóa chuỗi gồm bao nhiêu amino acid?', ans:'4', cells:['','','',''],
    exp:'Các codon: AUG (Met), GCU (Ala), CAU (His), CGU (Arg), UAA (kết thúc). Codon kết thúc không mã hóa amino acid ⇒ 4 amino acid, vẫn tính Met mở đầu.' },
  { q:'Vùng mã hóa của một gene nhân sơ dài 90 cặp nucleotide, đã gồm codon kết thúc và không có intron. Chuỗi polypeptide gồm bao nhiêu amino acid?', ans:'29', cells:['','','',''],
    exp:'90 cặp nucleotide = 90 nucleotide trên mỗi mạch ⇒ mRNA có 90 nucleotide = 90 : 3 = 30 codon. Trừ 1 codon kết thúc ⇒ 29 amino acid. Không nhân đôi 90 lần nữa vì "cặp" đã là đơn vị đếm của DNA sợi kép.' },
  { q:'Một phân tử DNA có 1200 cặp nucleotide, trong đó A chiếm 20% tổng số nucleotide. Tính số cặp G–C của phân tử.', ans:'720', cells:['','','',''],
    exp:'Tổng nucleotide = 1200 × 2 = 2400. A = T = 20% × 2400 = 480. G + C = 2400 − 960 = 1440 ⇒ G = C = 720. Mỗi G bắt cặp với một C nên có 720 cặp G–C. Kiểm tra: 480 + 480 + 720 + 720 = 2400 ✓.' },
  { q:'Một mRNA có 4 codon mã hóa và 1 codon kết thúc. Số liên kết peptide trong chuỗi polypeptide tạo ra là bao nhiêu?', ans:'3', cells:['','','',''],
    exp:'4 amino acid nối nhau tạo 3 liên kết peptide (số liên kết = số amino acid − 1). Codon kết thúc không thêm amino acid nên không tạo liên kết nào.' },
  { q:'Trên một mRNA có 6 ribosome cùng dịch mã (polyribosome). Sau mỗi lượt, thu được bao nhiêu chuỗi polypeptide?', ans:'6', cells:['','','',''],
    exp:'Mỗi ribosome đọc độc lập trọn vẹn mRNA và tạo 1 chuỗi. 6 ribosome ⇒ 6 chuỗi GIỐNG HỆT NHAU về trình tự amino acid; đây là cách tế bào tăng nhanh số lượng protein.' },
  { q:'Một gene nhân thực có 4200 nucleotide trên mỗi mạch, trong đó phần intron chiếm 600 nucleotide. mRNA trưởng thành (chưa tính đuôi poly-A) dài bao nhiêu nucleotide?', ans:'3600', cells:['','','',''],
    exp:'Phiên mã tạo mRNA sơ khai 4200 nucleotide; cắt nối (splicing) loại bỏ 600 nucleotide intron ⇒ 4200 − 600 = 3600 nucleotide gồm các exon, đã bao gồm codon mở đầu và kết thúc.' },
  { q:'Đoạn mạch khuôn 3′-TAC-GGA-CCA-ACC-5′ phiên mã ra mRNA không chứa codon kết thúc. Đoạn mRNA này mã hóa bao nhiêu amino acid?', ans:'4', cells:['','','',''],
    exp:'mRNA bổ sung, đối chiều: 5′-AUG-CCU-GGU-UGG-3′ (Met–Pro–Gly–Trp), không có codon dừng. Đếm theo số bộ ba: 12 nucleotide = 4 codon ⇒ 4 amino acid, trong đó AUG vẫn tính là Met mở đầu.' },
  { q:'Một protein gồm 120 amino acid. Vùng mã hóa của gene (đã tính codon kết thúc, không có intron) dài bao nhiêu cặp nucleotide?', ans:'363', cells:['','','',''],
    exp:'Cần 120 codon mã hóa + 1 codon kết thúc = 121 codon. Mỗi codon 3 nucleotide ⇒ 121 × 3 = 363 nucleotide trên mRNA, tương ứng 363 cặp nucleotide trên gene. Bẫy: quên codon kết thúc sẽ ra 360.' }
];

/* Ví dụ thông minh: lời giải từng bước + bẫy, gắn đúng chủ đề Bài 7. */
const V5_EXAMPLES = [
  { topic:'Dịch mã', title:'Đọc bài toán 3 ống nghiệm X, Y, Z — chỉ cần nhìn chất nền',
    given:'Ống X: A, T, U, G, C đều còn 100%. Ống Y: T còn 100%, A/U/G giảm. Ống Z: U còn 100%, A/T/G/C giảm. Hãy gán tên quá trình.',
    steps:['Lập bảng: dòng là ống nghiệm, cột là 4 loại nucleotide, ghi "giữ nguyên" hay "giảm" theo đầu bài.',
           'Nhớ nguyên liệu: tái bản DNA dùng A, T, G, C; phiên mã dùng A, U, G, C; dịch mã dùng amino acid (không dùng nucleotide tự do).',
           'Ống nào KHÔNG tiêu thụ nucleotide nào ⇒ dịch mã. Vậy X = dịch mã.',
           'Ống còn nguyên T ⇒ loại T không được dùng ⇒ đó là phiên mã. Vậy Y = phiên mã.',
           'Ống còn nguyên U ⇒ loại U không được dùng ⇒ đó là tái bản. Vậy Z = tái bản DNA.'],
    answer:'X = dịch mã, Y = phiên mã, Z = tái bản DNA.',
    trick:'Đừng đoán theo "có mRNA xuất hiện hay không": cả ba ống đều có thể chứa mRNA/DNA làm KHUÔN. Chỉ có nucleotide tự do bị tiêu thụ mới cho biết enzyme nào đang chạy.' },
  { topic:'Dịch mã', title:'Từ mạch khuôn của gene đến số amino acid — quy trình 4 bước',
    given:'Mạch khuôn: 3′-TAC-GGA-CCA-ACC-5′. Tìm mRNA và số amino acid (không có codon kết thúc).',
    steps:['Xác định chiều: mạch khuôn đang viết 3′→5′, nên mRNA sẽ là 5′→3′.',
           'Áp dụng bổ sung A–U, T–A, G–C, C–G: TAC → AUG, GGA → CCU, CCA → GGU, ACC → UGG.',
           'Viết mRNA: 5′-AUG-CCU-GGU-UGG-3′. Kiểm tra nhanh: UGG mã hóa tryptophan, không phải codon dừng.',
           'Đếm số bộ ba: 12 nucleotide chia 3 = 4 codon ⇒ 4 amino acid (Met–Pro–Gly–Trp).'],
    answer:'mRNA = 5′-AUG-CCU-GGU-UGG-3′; 4 amino acid.',
    trick:'Hai lỗi kinh điển: viết mRNA cùng chiều với mạch khuôn, hoặc quên thay T bằng U. Luôn ghi rõ đầu 5′ và 3′ lên giấy nháp trước khi tính.' },
  { topic:'Di truyền phân tử', title:'Đếm nucleotide của gene — "cặp" và "nucleotide" không giống nhau',
    given:'Chuỗi polypeptide có 5 amino acid (đã tính Met mở đầu). Tính số cặp nucleotide tối thiểu của vùng mã hóa.',
    steps:['Mỗi amino acid ứng với 1 codon gồm 3 nucleotide trên mRNA.',
           'Phải có thêm 1 codon kết thúc để ribosome dừng: tổng 5 + 1 = 6 codon.',
           'Số nucleotide trên mRNA = 6 × 3 = 18.',
           'Gene là DNA sợi kép: 18 nucleotide trên một mạch tương ứng 18 CẶP nucleotide (không phải 36 cặp).'],
    answer:'18 cặp nucleotide.',
    trick:'Nếu đề ghi "gen có 18 nucleotide" thì đó là TỔNG trên cả 2 mạch, lúc đó chỉ có 9 cặp. Luôn đọc kỹ đơn vị trước khi nhân hoặc chia.' },
  { topic:'Biểu hiện gene', title:'Đọc biểu đồ mRNA / protein để xác định thuốc tác động ở đâu',
    given:'Thuốc 1: mRNA giảm từ 8 xuống 3, protein giảm từ 10 xuống 4. Thuốc 2: mRNA vẫn 8, protein giảm từ 10 xuống 6.',
    steps:['Vẽ sơ đồ dòng thông tin: DNA —phiên mã→ mRNA —dịch mã→ protein.',
           'Nếu mRNA giảm thì protein cũng giảm theo, vì mất nguyên liệu cho dịch mã.',
           'Thuốc 1 làm mRNA giảm ⇒ chặn ở phiên mã (hoặc làm mRNA mất ổn định).',
           'Thuốc 2 giữ nguyên mRNA nhưng protein vẫn giảm ⇒ chặn ở dịch mã (hoặc tăng phân giải protein).'],
    answer:'Thuốc 1 ức chế phiên mã; thuốc 2 ức chế dịch mã / độ bền protein.',
    trick:'Không đượcchỉ nhìn cột protein: hai thuốc đều làm protein giảm nhưng cơ chế khác nhau. Phải so sánh ĐỒNG THỜI cột mRNA và cột protein.' }
];

MCQS.push(...V5_MCQ);
TFS.push(...V5_TF);
SHORTS.push(...V5_SHORT);
SMART_EXAMPLES.push(...V5_EXAMPLES);

/* ============================================================
   v5.0 · CẤU TRÚC ĐỀ CHUẨN BGD 2025+
   Phần I  : 18 câu nhiều lựa chọn — 6 trục cốt lõi × 3 câu.
   Phần II : 4 chùm Đúng/Sai thực nghiệm, mỗi chùm 4 ý a/b/c/d.
   Phần III: 6 câu trả lời ngắn tính toán.
   Mọi câu có tip / why / trap (hoặc exp) để phần "Câu sai &
   hướng dẫn chi tiết" sau Solo hiện đủ cách làm, bản chất và bẫy.
   ============================================================ */
const V6_MCQ = [
  /* --- Trục 1: Di truyền phân tử --- */
  { t:'dt', d:2, q:'Trong nhân đôi DNA ở sinh vật nhân thực, phát biểu nào đúng?',
    o:['Cả hai mạch mới đều được tổng hợp liên tục','Một mạch được tổng hợp gián đoạn thành các đoạn Okazaki vì DNA polymerase chỉ kéo dài mạch theo chiều 5′→3′','Enzym tháo xoắn tháo xoắn toàn bộ phân tử DNA trước khi tổng hợp bắt đầu','RNA polymerase tổng hợp đoạn mồi và giữ luôn đoạn mồi trong DNA con'], a:1,
    tip:'Hai mạch khuôn đối chiều nhau, nhưng polymerase chỉ làm việc 5′→3′.', why:'Tại mỗi chạc chữ Y, một mạch khuôn chạy 3′→5′ nên mạch mới tổng hợp liên tục; mạch kia chạy 5′→3′ nên phải tổng hợp ngược chiều thành từng đoạn ngắn (Okazaki), mỗi đoạn cần một đoạn mồi RNA; sau đó mồi được cắt và nối bằng DNA ligase.', trap:'Enzym tháo xoắn chỉ mở từng vùng tại chạc tái bản, KHÔNG tháo toàn bộ phân tử cùng lúc; đoạn mồi RNA bị loại bỏ, không giữ lại trong DNA con.' },
  { t:'dt', d:2, q:'mRNA sơ khai khác mRNA trưởng thành ở sinh vật nhân thực như thế nào?',
    o:['mRNA sơ khai chỉ gồm các exon','mRNA sơ khai còn intron; mRNA trưởng thành đã cắt intron, thêm mũ 5′ và đuôi poly-A','mRNA trưởng thành dài hơn do được bổ sung intron','Hai loại giống hệt nhau, chỉ khác vị trí trong tế bào'], a:1,
    tip:'Cắt nối (splicing) + chế biến 2 đầu.', why:'Phiên mã tạo pre-mRNA chứa cả exon lẫn intron. Sau cắt nối, thêm mũ 7-methylguanosin ở đầu 5′ và đuôi poly-A ở đầu 3′ tạo mRNA trưởng thành được xuất ra tế bào chất.', trap:'mRNA trưởng thành NGẮN hơn mRNA sơ khai; nhớ rằng sinh vật nhân sơ không có intron điển hình nên không có bước này.' },
  { t:'dm', d:2, q:'Khi có lactose trong môi trường, điều gì xảy ra với operon Lac ở E. coli?',
    o:['Lactose gắn protein ức chế làm đổi cấu hình, protein rời vùng vận hành O, RNA polymerase phiên mã các gen cấu trúc Z, Y, A','Lactose phân hủy hoàn toàn protein ức chế','Lactose gắn trực tiếp vào vùng khởi động P để hoạt hóa RNA polymerase','Gen điều hòa R ngừng phiên mã hoàn toàn'], a:0,
    tip:'Chất cảm ứng gắn biến cấu (allosteric), không phá hủy protein.', why:'Lactose (chất cảm ứng) gắn protein ức chế → đổi cấu hình → mất ái lực với O → RNA polymerase trượt từ P qua O và phiên mã Z, Y, A. Khi hết lactose, protein lấy lại cấu hình cũ và bám lại O.', trap:'Gen điều hòa vẫn được phiên mã ở mức thấp liên tục; protein ức chế bám vào O (vùng vận hành), KHÔNG bám vào P.' },

  /* --- Trục 2: Nhiễm sắc thể & đột biến --- */
  { t:'nst', d:1, q:'Ruồi giấm có bộ nhiễm sắc thể 2n = 8. Thể một nhiễm của loài này có bao nhiêu NST trong tế bào sinh dưỡng?',
    o:['8','7','9','4'], a:1,
    tip:'Thể một nhiễm = 2n − 1.', why:'Mất một chiếc của một cặp tương đồng: 8 − 1 = 7. Thể ba nhiễm là 2n + 1 = 9, thể không nhiễm là 2n − 2 = 6.', trap:'Đừng nhầm với số NST trong giao tử (n = 4) hay thể ba nhiễm (9).' },
  { t:'nst', d:2, q:'Đột biến đảo đoạn KHÔNG chứa tâm động làm thay đổi điều gì chủ yếu?',
    o:['Số lượng gen tăng gấp đôi','Trật tự sắp xếp các gen trên NST, còn số lượng gen không đổi','Số lượng NST trong tế bào','Thành phần nucleotide của mọi gen trên NST'], a:1,
    tip:'Đảo đoạn = đảo ngược trật tự, không mất/ thêm vật chất.', why:'Một đoạn NST đứt ra, quay 180° rồi nối lại. Vì đoạn không chứa tâm động nên hình dạng NST giữ nguyên; hệ quả là thay đổi vị trí gen (hiệu ứng vị trí) và có thể giảm khả năng hoán vị ở dị hợp.', trap:'Mất đoạn / lặp đoạn mới làm đổi SỐ LƯỢNG gen; chuyển đoạn mới đổi nhóm gen liên kết.' },
  { t:'nst', d:1, q:'Hội chứng Đao ở người là hậu quả của dạng đột biến nào?',
    o:['Mất một NST 21','Thừa một NST 21 (2n + 1 = 47)','Đột biến gen lặn trên NST 21','Mất một đoạn của NST 21'], a:1,
    tip:'Thể ba nhiễm NST 21.', why:'Do rối loạn phân li cặp NST 21 ở giảm phân (thường ở mẹ), hợp tử nhận 3 chiếc NST 21 → 47 NST. Thuộc đột biến lệch bội dạng thể ba.', trap:'Hội chứng Tơcnơ là thể một nhiễm NST giới tính (45, XO); Claiphentơ là 47, XXY — cùng nhóm lệch bội nhưng khác NST.' },

  /* --- Trục 3: Quy luật di truyền --- */
  { t:'ql', d:2, q:'Lai phân tích cơ thể dị hợp Ab/aB, tần số hoán vị gen 20%. Tỉ lệ giao tử aB là bao nhiêu?',
    o:['20%','10%','40%','80%'], a:2,
    tip:'20% là TỔNG giao tử hoán vị, chia đều cho 2 loại.', why:'Giao tử bố mẹ là Ab và aB, tổng 80% → mỗi loại 40%. Giao tử hoán vị AB và ab mỗi loại 10%.', trap:'Chọn 20% hoặc 10% là bẫy kinh điển; phải xác định kiểu sắp xếp cis/trans trước rồi mới chia.' },
  { t:'ql', d:3, q:'Cho P: AaBb × aaBb. Hai gen trội A và B phải cùng có mặt mới tạo hoa đỏ, thiếu một trong hai cho hoa trắng. Tỉ lệ kiểu hình F1 là:',
    o:['3 đỏ : 5 trắng','1 đỏ : 3 trắng','5 đỏ : 3 trắng','3 đỏ : 1 trắng'], a:0,
    tip:'Tương tác bổ sung: nhân xác suất A_ với B_.', why:'Aa × aa → A_ = 1/2. Bb × Bb → B_ = 3/4. A_B_ = 1/2 × 3/4 = 3/8 đỏ; còn lại 5/8 trắng ⇒ 3 : 5.', trap:'Đừng dùng tỉ lệ 9:3:3:1 (chỉ đúng cho AaBb × AaBb tự thụ); ở đây cặp A lai phân tích nên A_ chỉ 1/2.' },
  { t:'ql', d:2, q:'Bệnh mù màu ở người do gen lặn nằm trên NST X. Một phụ nữ bình thường có bố bị bệnh, lấy chồng bình thường. Tỉ lệ con trai bị bệnh là:',
    o:['0%','25%','50%','100%'], a:2,
    tip:'Người cha bệnh truyền Xᵃ cho TOÀN BỘ con gái → con gái chắc chắn là người mang.', why:'Mẹ có kiểu gen XᴬXᵃ (nhận Xᵃ từ bố). Con trai nhận Y từ bố và X từ mẹ ⇒ 1/2 nhận Xᵃ → bị bệnh.', trap:'Nếu hỏi "tỉ lệ con (cả trai lẫn gái) bị bệnh" thì là 25%; đề hỏi riêng CON TRAI nên là 50%.' },

  /* --- Trục 4: Sinh lý thực vật --- */
  { t:'tv', d:2, q:'Điểm khác biệt chính giữa thực vật CAM và thực vật C4 là:',
    o:['C4 cố định CO₂ vào ban đêm còn CAM cố định vào ban ngày','CAM cố định CO₂ ban đêm nhờ PEP-carboxylase, tích acid hữu cơ trong không bào; ban ngày đóng khí khổng và tái cố định CO₂ bằng Rubisco','CAM không có chu trình Calvin','C4 chỉ có một loại lục lạp'], a:1,
    tip:'CAM tách NHỜ THỜI GIAN, C4 tách NHỜ KHÔNG GIAN.', why:'CAM (dứa, xương rồng) mở khí khổng ban đêm, cố định CO₂ thành malate cất trong không bào; ban ngày đóng khí khổng để tiết kiệm nước, decarboxyl malate giải phóng CO₂ cho Rubisco. C4 (ngô, mía) tách ở 2 loại tế bào: mô giậu và bao bó mạch.', trap:'Cả CAM và C4 ĐỀU có chu trình Calvin; C4 có 2 loại lục lạp, không phải 1.' },
  { t:'tv', d:1, q:'Khi tế bào bảo vệ mất nước, hiện tượng nào xảy ra?',
    o:['Áp suất trương nước giảm → khí khổng đóng → thoát hơi nước giảm','Khí khổng mở to hơn để tăng quang hợp','Cường độ quang hợp tăng do CO₂ vào nhiều hơn','Áp suất thẩm thấu giảm làm nước tràn vào tế bào'], a:0,
    tip:'Trương nước quyết định độ mở của lỗ khí.', why:'Tế bào bảo vệ mất nước → sức trương giảm → thành dày phía trong không còn căng ra → lỗ khí khép lại. Đây là phản ứng chống hạn rất nhanh, làm giảm thoát hơi nước nhưng cũng hạn chế CO₂ vào.', trap:'Mất nước làm nồng độ dịch bào TĂNG (áp suất thẩm thấu tăng), không phải giảm; khí khổng đóng thì quang hợp giảm.' },
  { t:'tv', d:2, q:'Nồng độ K⁺ trong tế bào lông hút đã cao hơn dung dịch đất nhưng cây vẫn tiếp tục hấp thụ thêm K⁺. Cơ chế nào giải thích điều này?',
    o:['Vận chuyển chủ động qua chất mang, tiêu thụ ATP','Khuếch tán đơn giản qua lớp lipid kép','Thẩm thấu nước kéo ion đi theo','Hút bị động theo dòng thoát hơi nước'], a:0,
    tip:'Chống gradient nồng độ ⇒ bắt buộc chủ động.', why:'Bơm H⁺ (ATPase) tạo điện thế âm bên trong màng, kéo K⁺ vào qua kênh/ chất mang; ATP do hô hấp rễ cung cấp. Vì vậy thiếu O₂ (đất úng) hoặc chất ức chế hô hấp làm hút khoáng suy ngay.', trap:'Dòng thoát hơi nước chỉ vận chuyển nước và ion theo dòng khối trong mạch gỗ, KHÔNG giải thích được việc chống gradient qua màng tế bào lông hút.' },

  /* --- Trục 5: Sinh lý động vật --- */
  { t:'dv', d:1, q:'Trong giai đoạn KHỬ CỰC của điện thế hoạt động ở nơron, ion nào di chuyển chủ yếu?',
    o:['Na⁺ đi vào qua kênh phụ thuộc điện thế','K⁺ đi ra qua kênh rò','Cl⁻ đi vào','Ca²⁺ đi ra khỏi tế bào'], a:0,
    tip:'Khử cực = Na⁺ vào; tái phân cực = K⁺ ra.', why:'Khi đạt ngưỡng, kênh Na⁺ phụ thuộc điện thế mở hàng loạt → Na⁺ tràn vào theo cả gradient nồng độ lẫn gradient điện → điện thế trong màng từ −70 mV lên khoảng +30 mV.', trap:'K⁺ ra là giai đoạn TÁI PHÂN CỰC (sau đỉnh); Ca²⁺ đi VÀO chùy axon để giải phóng chất trung gian, không phải ra.' },
  { t:'dv', d:2, q:'Khi áp suất thẩm thấu máu tăng, ADH (vasopressin) được tiết nhiều hơn. Hệ quả trực tiếp là:',
    o:['Tăng tính thấm nước ở ống thận góp → tăng tái hấp thu nước → nước tiểu ít và cô đặc','Tăng lưu lượng lọc cầu thận GFR','Giảm tái hấp thu Na⁺ ở quai Henle','Tăng bài tiết glucose qua nước tiểu'], a:0,
    tip:'ADH gắn aquaporin-2 vào màng ống góp.', why:'ADH từ thuỳ sau tuyến yên làm chèn AQP2 vào màng đỉnh tế bào ống góp → nước tái hấp thu theo gradient thẩm thấu tuỷ → thể tích nước tiểu giảm, áp suất thẩm thấu máu hạ về bình thường (phản hồi ngược).', trap:'ADH KHÔNG làm tăng GFR; aldosteron mới là hoocmon tăng tái hấp thu Na⁺ (và nước đi theo).' },
  { t:'dv', d:1, q:'Pepsin của dịch vị hoạt động tối ưu ở môi trường nào?',
    o:['pH ≈ 2 (rất acid)','pH ≈ 7 (trung tính)','pH ≈ 8 (kiềm nhẹ)','pH ≈ 12 (kiềm mạnh)'], a:0,
    tip:'Dạ dày có HCl, pH 1,5–2,5.', why:'Pepsinogen được HCl hoạt hóa thành pepsin; enzyme này biến tính và mất hoạt tính khi vào tá tràng có pH ~8 (nhờ bicarbonate của dịch tụy). Trypsin của dịch tụy ngược lại, tối ưu ở pH ~8.', trap:'Đây là cặp dễ nhầm: pepsin ≈ 2, trypsin ≈ 8, amylase nước bọt ≈ 6,8.' },

  /* --- Trục 6: Tiến hóa & Sinh thái --- */
  { t:'th', d:1, q:'Quần thể cân bằng Hardy–Weinberg có tần số alen lặn q = 0,2. Tỉ lệ cá thể dị hợp Aa là:',
    o:['0,16','0,32','0,64','0,04'], a:1,
    tip:'p = 1 − q = 0,8; dị hợp = 2pq.', why:'2pq = 2 × 0,8 × 0,2 = 0,32 (32%). Kiểm chứng: p² + 2pq + q² = 0,64 + 0,32 + 0,04 = 1.', trap:'0,16 là p·q (thiếu hệ số 2); 0,04 là q² (kiểu hình lặn); 0,64 là p² (đồng hợp trội).' },
  { t:'th', d:2, q:'Nhân tố nào gây thay đổi tần số alen theo hướng NGẪU NHIÊN và biểu hiện mạnh nhất ở quần thể có kích thước nhỏ?',
    o:['Phiêu bạt gen (hiệu ứng thắt cổ chai / sáng lập)','Chọn lọc tự nhiên','Dòng gen (di nhập)','Giao phối có lựa chọn'], a:0,
    tip:'Ngẫu nhiên + quần thể nhỏ = phiêu bạt gen.', why:'Sai số lấy mẫu khi tạo giao tử thế hệ sau làm tần số alen dao động ngẫu nhiên; quần thể càng nhỏ dao động càng lớn, dễ làm alen cố định hoặc mất hẳn. Hiệu ứng thắt cổ chai và hiệu ứng người sáng lập là hai dạng điển hình.', trap:'CLTN làm thay đổi tần số alen theo hướng XÁC ĐỊNH (thích nghi); đột biến tạo alen mới nhưng tần số ban đầu rất thấp.' },
  { t:'th', d:1, q:'Trong cây phát sinh chủng loại (phylogenetic tree), một điểm nút (node) biểu thị điều gì?',
    o:['Tổ tiên chung gần nhất của các nhánh xuất phát từ nút đó','Một loài đang tồn tại','Một mốc thời gian tuyệt đối tính bằng triệu năm','Số lượng loài trong nhánh'], a:0,
    tip:'Nút = sự kiện phân nhánh (speciation).', why:'Mỗi nút là nơi một dòng tổ tiên tách thành 2 dòng hậu duệ, tức đại diện cho tổ tiên chung gần nhất (MRCA) của các taxon ở đầu nhánh. Chiều dài nhánh có thể mang ý nghĩa số lượng thay đổi hoặc thời gian tuỳ cách dựng cây.', trap:'Đầu nhánh (tip) mới là loài/đơn vị phân loại hiện còn hoặc hoá thạch; thời gian tuyệt đối chỉ có khi cây được hiệu chuẩn thêm bằng dữ liệu hoá thạch/đồng hồ phân tử.' }
];

const V6_TF = [
  { title:'Thí nghiệm Meselson – Stahl (N¹⁴ / N¹⁵)', sub:[
    { text:'Chuyển E. coli từ môi trường N¹⁵ sang N¹⁴, sau 1 thế hệ thu được duy nhất một băng DNA có tỉ trọng trung gian.', ans:true,
      exp:'Mỗi phân tử DNA con gồm 1 mạch cũ N¹⁵ + 1 mạch mới N¹⁴ ⇒ tất cả đều nằm ở vị trí trung gian. Đây là hệ quả trực tiếp của nhân đôi bán bảo tồn.' },
    { text:'Sau 2 thế hệ xuất hiện 2 băng (trung gian và nhẹ) với tỉ lệ 1 : 1.', ans:true,
      exp:'Từ 2 phân tử thế hệ 1 tạo 4 phân tử: 2 vẫn giữ 1 mạch N¹⁵ (trung gian), 2 hoàn toàn N¹⁴ (nhẹ) ⇒ 1 : 1.' },
    { text:'Kết quả ngay sau thế hệ 1 đã loại trừ được mô hình nhân đôi bảo tồn (conservative).', ans:true,
      exp:'Nếu bảo tồn, sau 1 thế hệ phải có 2 băng: 1 nặng (DNA mẹ nguyên vẹn) và 1 nhẹ (DNA con hoàn toàn mới). Thực tế chỉ có 1 băng trung gian ⇒ loại bảo tồn.' },
    { text:'Nếu DNA nhân đôi theo mô hình phân tán (dispersive), sau 1 thế hệ vẫn thu được 2 băng tách biệt rõ ràng.', ans:false,
      exp:'Mô hình phân tán cho mỗi mạch là hỗn hợp N¹⁵/N¹⁴ nên sau 1 thế hệ chỉ có MỘT băng trung gian (giống bán bảo tồn). Phải đến thế hệ 2 mới phân biệt được: phân tán cho 1 băng dịch dần về phía nhẹ, bán bảo tồn cho 2 băng.' }
  ]},
  { title:'Động học enzyme Catalase / Michaelis–Menten', sub:[
    { text:'Khi [S] = Km thì tốc độ phản ứng v = Vmax/2.', ans:true,
      exp:'Thay vào v = Vmax[S]/(Km + [S]) với [S] = Km ⇒ v = Vmax·Km/(2Km) = Vmax/2. Đây chính là định nghĩa thực nghiệm của Km.' },
    { text:'Ức chế cạnh tranh làm tăng Km biểu kiến nhưng không làm thay đổi Vmax.', ans:true,
      exp:'Chất ức chế tranh chấp trung tâm hoạt động; tăng [S] đủ cao sẽ đẩy nó ra ⇒ vẫn đạt Vmax, nhưng cần [S] lớn hơn để đạt Vmax/2 nên Km biểu kiến tăng.' },
    { text:'Ức chế không cạnh tranh có thể được khắc phục hoàn toàn bằng cách tăng nồng độ cơ chất [S].', ans:false,
      exp:'Ức chế không cạnh tranh gắn ở vị trí khác làm giảm số enzyme có hoạt tính ⇒ Vmax GIẢM, tăng [S] không khôi phục được. (Km có thể không đổi ở dạng thuần túy.)' },
    { text:'Km càng lớn thì ái lực của enzyme với cơ chất càng cao.', ans:false,
      exp:'Ngược lại: Km lớn nghĩa là cần nhiều cơ chất mới đạt Vmax/2 ⇒ ái lực THẤP. Km nhỏ ⇒ ái lực cao.' }
  ]},
  { title:'Đường cong phân li oxyhemoglobin (Hill) & sốc nhiệt / toan kiềm', sub:[
    { text:'Đường cong bão hòa Hb–O₂ có dạng chữ S là do tính hợp tác giữa 4 tiểu đơn vị hemoglobin.', ans:true,
      exp:'Gắn O₂ vào một tiểu đơn vị làm thay đổi cấu hình (T → R), tăng ái lực của các tiểu đơn vị còn lại ⇒ hệ số Hill n ≈ 2,8–3,0, đường cong sigmoid.' },
    { text:'Tăng nhiệt độ hoặc giảm pH (hiệu ứng Bohr) làm đường cong dịch sang phải, P50 tăng, ái lực O₂ giảm.', ans:true,
      exp:'Mô đang hoạt động sinh nhiều CO₂, H⁺ và nhiệt ⇒ Hb giảm ái lực O₂, nhả O₂ cho mô nhiều hơn. Đây là đáp ứng chức năng có lợi.' },
    { text:'Sốc nhiệt làm P50 giảm nên hemoglobin giữ oxy chặt hơn, mô dễ thiếu oxy.', ans:false,
      exp:'Sốc nhiệt làm P50 TĂNG (đường cong dịch phải), hemoglobin NHẢ oxy dễ hơn. Chiều thay đổi bị đảo ngược so với phát biểu.' },
    { text:'Myoglobin có đường cong bão hòa hình chữ S vì gồm 4 tiểu đơn vị giống hemoglobin.', ans:false,
      exp:'Myoglobin chỉ có 1 tiểu đơn vị, 1 nhóm heme ⇒ đường cong hyperbol, P50 rất thấp (ái lực cao), có vai trò dự trữ O₂ ở cơ; không có tính hợp tác.' }
  ]},
  { title:'Phả hệ bệnh lặn trên NST X & sàng lọc phôi (PGD)', sub:[
    { text:'Bệnh do gen lặn trên NST X biểu hiện ở nam giới nhiều hơn nữ giới.', ans:true,
      exp:'Nam chỉ có 1 NST X (XY) nên chỉ cần 1 alen lặn đã phát bệnh; nữ (XX) phải đồng hợp lặn mới bệnh, dị hợp chỉ là người mang.' },
    { text:'Người cha bị bệnh truyền alen bệnh cho tất cả con gái và không truyền cho con trai nào.', ans:true,
      exp:'Con gái luôn nhận X của cha (mang alen bệnh → người mang), con trai nhận Y của cha và X của mẹ ⇒ không có di truyền "cha → con trai" với gen trên X.' },
    { text:'Một phôi nữ chỉ bị bệnh khi đồng hợp lặn XᵃXᵃ; phôi XᴬXᵃ là người mang không biểu hiện bệnh.', ans:true,
      exp:'Đúng với gen lặn trên X và trội lặn hoàn toàn; PGD xác định kiểu gen phôi trước khi chuyển vào tử cung nên phân biệt được 3 kiểu này.' },
    { text:'Sàng lọc phôi trước chuyển phôi làm thay đổi tần số alen của quần thể người ngay trong một thế hệ.', ans:false,
      exp:'PGD là lựa chọn ở mức CÁ THỂ/ gia đình, tác động lên vốn gene của một cặp bố mẹ; tần số alen của QUẦN THỂ chỉ đổi khi có chọn lọc/ đột biến/ di nhập/ phiêu bạt ở quy mô quần thể qua nhiều thế hệ.' }
  ]}
];

const V6_SHORT = [
  { q:'Quần thể ngẫu phối có tần số alen lặn q₀ = 0,5. CLTN đào thải hoàn toàn kiểu hình aa (s = 1). Tính q sau 2 thế hệ (viết dạng thập phân).',
    ans:'0.25', cells:['','','',''],
    exp:'Công thức đào thải lặn hoàn toàn: qₙ = q₀/(1 + n·q₀). Với n = 2: q₂ = 0,5/(1 + 2×0,5) = 0,5/2 = 0,25. Kiểm chứng từng bước: sau thế hệ 1 q₁ = 0,5/1,5 = 1/3; sau thế hệ 2 q₂ = (1/3)/(1 + 1/3) = 1/4 = 0,25 ✓.' },
  { q:'Lai phân tích một cây dị hợp 2 cặp gen thu được 800 cá thể, trong đó 96 cá thể mang kiểu hình hoán vị (cộng cả 2 loại). Tính khoảng cách di truyền giữa 2 gene, đơn vị cM.',
    ans:'12', cells:['','','',''],
    exp:'Tần số hoán vị f = (tổng số cá thể hoán vị / tổng số cá thể) × 100 = 96/800 × 100 = 12%. 1% hoán vị = 1 cM ⇒ 12 cM. Bẫy: đừng chia đôi 96 (đề đã cộng cả 2 loại kiểu hình hoán vị).' },
  { q:'Một mRNA vùng mã hóa có 12 codon, gồm 1 codon mở đầu và 1 codon kết thúc. Tính số acid amin của chuỗi polypeptide hoàn chỉnh SAU KHI đã cắt bỏ acid amin mở đầu.',
    ans:'10', cells:['','','',''],
    exp:'12 codon − 1 codon kết thúc (không mã hóa acid amin) = 11 acid amin dịch được. Cắt tiếp acid amin mở đầu (Met/formyl-Met) ⇒ 11 − 1 = 10 acid amin. Bẫy: quên cắt Met sẽ ra 11; cộng cả codon kết thúc sẽ ra 12.' },
  { q:'Lưu lượng lọc cầu thận GFR = 125 mL/phút; 99% thể tích dịch lọc được tái hấp thu. Tính thể tích nước tiểu thực tế tạo thành trong 1 giờ (mL).',
    ans:'75', cells:['','','',''],
    exp:'Thể tích lọc trong 1 giờ = 125 × 60 = 7500 mL. Phần bài xuất = 100% − 99% = 1% ⇒ 7500 × 0,01 = 75 mL/giờ. Kiểm chứng: 75 mL/h × 24 h = 1800 mL/ngày, khớp mức nước tiểu bình thường 1,5–2 L/ngày ✓.' },
  { q:'Một phân tử DNA có 2400 nucleotide, trong đó A = 400. Tính tổng số liên kết hydrogen của phân tử.',
    ans:'3200', cells:['','','',''],
    exp:'Theo NTBS: A = T = 400 ⇒ A + T = 800. G + C = 2400 − 800 = 1600 ⇒ G = C = 800. Số cặp A–T = 400 (mỗi cặp 2 liên kết H), số cặp G–C = 800 (mỗi cặp 3 liên kết H). H = 2×400 + 3×800 = 800 + 2400 = 3200. Kiểm chứng: 400+400+800+800 = 2400 ✓.' },
  { q:'Ở đời con của phép lai phân tích liên kết gen, tổng tỉ lệ 2 kiểu hình A-bb và aaB- là K = 0,32. Tính tần số hoán vị f (%) khi cơ thể dị hợp ở dạng cis AB/ab.',
    ans:'40', cells:['','','',''],
    exp:'Định lý: %(A-bb) = %(aaB-) = 0,25 − X với X = %(aabb) ⇒ K = 0,5 − 2X ⇒ X = (0,5 − 0,32)/2 = 0,09. Giao tử ab = √X = 0,3. Ở dạng cis AB/ab, ab là giao tử bố mẹ = (1 − f)/2 ⇒ f = 1 − 2×0,3 = 0,4 = 40% (40 cM). Nếu là trans Ab/aB thì f = 2×0,3 = 60% (loại vì f ≤ 50%).' }
];

MCQS.push(...V6_MCQ);
TFS.push(...V6_TF);
SHORTS.push(...V6_SHORT);

/* v5.5 — 73 câu trả lời ngắn gốc THIẾU trường chuyên đề `t`, khiến flashcard
   gán nhầm tất cả vào "Di truyền phân tử" và lộ trình không thống kê được.
   Bảng dưới là phân loại đã soát tay theo nội dung từng câu; nếu sau này
   thêm/bớt câu (độ dài khác 73) thì tự chuyển sang phân loại theo từ khoá. */
(function () {
  const MAP = 'dt dt dt dt dt dt dt dt dt nst nst ql ql dt nst ql dt dt dt dt dt dt dt nst ql dt dt dt nst ql ql dt dt nst ql ql ql ql nst ql ql dt ql ql nst dt ql nst ql dt ql tb dt ql ql dv dv dt tv dt dt dt dt dt dt dt dt ql ql dt dv dt ql'.split(' ');
  const KW = [
    ['dv', /huyết|pO|Hill|GFR|cầu thận|nước tiểu|thận|tuần hoàn|nơron|điện thế|tiêu hóa|nội môi|hormone/i],
    ['tv', /quang hợp|khí khổng|lục lạp|diệp lục|\bC3\b|\bC4\b|\bCAM\b|thoát hơi|khoáng|auxin|thực vật/i],
    ['nst', /NST|nhiễm sắc thể|thể ba|tam bội|tứ bội|thể một|lệch bội|đa bội|nguyên phân|giảm phân|tinh trùng|2n\s*=/i],
    ['ql', /kiểu gen|kiểu hình|phép lai|lai phân tích|alen|allele|hoán vị|liên kết|phân li|độc lập|trội|lặn|quần thể|Hardy|nhóm máu|tương tác|cộng gộp|tự thụ|tự phối|ngẫu phối|chọn lọc/i],
    ['dt', /DNA|gene|mRNA|tRNA|rRNA|nucleotide|phiên mã|dịch mã|codon|acid amin|polypeptide|ribosome|Okazaki|nhân đôi|hydrogen/i]
  ];
  const guess = function (q) {
    const s = String(q || '');
    for (let k = 0; k < KW.length; k++) if (KW[k][1].test(s)) return KW[k][0];
    return 'other';
  };
  const useMap = SHORTS.length === MAP.length;
  for (let i = 0; i < SHORTS.length; i++) {
    if (SHORTS[i].t) continue;
    SHORTS[i].t = useMap ? MAP[i] : guess(SHORTS[i].q);
  }
})();



let smartExCur = 0, smartExOpen = false;
function smartExMove(d) {
  smartExCur = (smartExCur + d + SMART_EXAMPLES.length) % SMART_EXAMPLES.length;
  smartExOpen = false;
  renderSmartExample();
  try { beep(620, .025); } catch (e) { }
}
function smartExReveal() {
  smartExOpen = !smartExOpen;
  renderSmartExample();
  try { beep(smartExOpen ? 800 : 500, .04); } catch (e) { }
}
function renderSmartExample() {
  const e = SMART_EXAMPLES[smartExCur]; if (!e) return;
  const setTxt = function (id, v) { const el = document.getElementById(id); if (el) el.textContent = v; };
  setTxt('smartExTopic', e.topic);
  setTxt('smartExIdx', (smartExCur + 1) + '/' + SMART_EXAMPLES.length);
  setTxt('smartExTitle', e.title);
  setTxt('smartExGiven', e.given);
  const body = document.getElementById('smartExBody');
  if (body) {
    body.innerHTML = smartExOpen
      ? '<ol class="steps" style="margin:0 0 8px;font-size:.7rem">' + e.steps.map(function (s) { return '<li>' + s + '</li>'; }).join('') + '</ol>' +
        '<div class="card pad-sm" style="background:rgba(61,220,151,.09);border-color:rgba(61,220,151,.3);font-size:.72rem"><b>Kết luận:</b> ' + e.answer + '</div>' +
        '<div class="tiny" style="margin-top:6px;color:var(--warn)">⚠ Bẫy: ' + e.trick + '</div>'
      : '<div class="tiny" style="color:var(--text3);padding:8px 2px">Bấm nút bên dưới để xem lời giải từng bước và điểm dễ nhầm.</div>';
  }
  const btn = document.getElementById('smartExToggle');
  if (btn) btn.textContent = smartExOpen ? '🙈 Ẩn lời giải' : '💡 Hiện lời giải từng bước';
}
try { renderSmartExample(); } catch (e) { }

/* Trộn vị trí đáp án đúng — tránh việc "khoanh A là thắng".
   Hoán vị xác định nên nội dung hiển thị ổn định giữa các lần tải. */
/* ---------- 1.10 Chuẩn hoá thứ tự phương án MỘT LẦN, theo nội dung câu ---------- */
/*
   Thay cho balanceAnswerPositions() cũ vốn gán vị trí đáp án = (i*5+3)%4:
   công thức đó khiến câu thứ i luôn có đáp án ở cùng một chỗ, đọc thứ tự là đoán được.
   Nay mỗi câu được xáo bằng hạt giống băm từ chính đề bài:
   - ổn định giữa các lần tải và giữa hai máy (cần cho đề chung ở Bước 5),
   - không còn liên hệ gì với chỉ số câu,
   - đồng thời sửa luôn tình trạng 59% đáp án nằm ở A trong dữ liệu gốc.
   Đề thi vẫn xáo lại lần nữa trên BẢN SAO (materializeQuestions) để trải đều A/B/C/D.
*/
(function normalizeOptionOrder() {
  MCQS.forEach(function (q) {
    const idx = [0, 1, 2, 3];
    const rnd = rng(hash32(String(q.q).slice(0, 160)));
    for (let i = 3; i > 0; i--) {
      const j = Math.floor(rnd() * (i + 1));
      const tmp = idx[i]; idx[i] = idx[j]; idx[j] = tmp;
    }
    const correct = q.o[q.a];
    q.o = idx.map(function (k) { return q.o[k]; });
    q.a = q.o.indexOf(correct);
  });
})();

/**
 * Tạo bản sao câu hỏi cho MỘT đề: xáo phương án theo hạt giống đề
 * và ép vị trí đáp án đúng trải đều A/B/C/D (lệch giữa các chữ tối đa 1).
 * Không sửa q.o / q.a của MCQS gốc.
 */
function materializeQuestions(list, seed) {
  const rnd = rng(seed);
  const offset = Math.floor(rnd() * 4);
  return list.map(function (src, i) {
    const q = Object.assign({}, src);
    q.o = src.o.slice();
    const correctText = src.o[src.a];          /* ghi nội dung đáp án TRƯỚC khi xáo */
    for (let k = q.o.length - 1; k > 0; k--) {
      const j = Math.floor(rnd() * (k + 1));
      const tmp = q.o[k]; q.o[k] = q.o[j]; q.o[j] = tmp;
    }
    const target = (i + offset) % 4;
    const at = q.o.indexOf(correctText);
    q.o[at] = q.o[target];
    q.o[target] = correctText;
    q.a = target;
    q.key = correctText;   /* v4.3 — mỏ neo chấm điểm theo nội dung */
    return q;
  });
}

/* =========================================================
   11c. LABX — mục tiêu, cách làm, giải thích ĐỘNG theo tham số
   ========================================================= */
const LABX = [
  /* 1. Phòng kín */
  {
    goal: 'Chứng minh rằng trong bóng tối cây xanh cũng tiêu thụ O₂ như người, nên phòng kín có cây KHÔNG làm giàu O₂.',
    steps: [
      'Để ánh sáng = 0 lux (ban đêm). Quan sát O₂ và CO₂ khi cửa đóng kín.',
      'Tăng số người ngủ lên 4 — xem tốc độ tụt O₂ và SpO₂.',
      'Đổi sang cây CAM — dự đoán trước khi bấm: O₂ có tăng không?',
      'Kéo ánh sáng lên 600–1000 lux rồi so sánh: điều gì đảo chiều?'
    ],
    why(v) {
      const night = v.lux < 120, open = v.win === 1, cam = v.cam === 1;
      let s = night
        ? 'Trời tối (dưới 120 lux) nên pha sáng không chạy: <em>không có quang phân li nước, không sinh O₂</em>. Cây chỉ còn hô hấp — hút O₂, nhả CO₂, đúng như người đang ngủ.'
        : 'Đã có đủ ánh sáng nên pha sáng chạy: nước bị quang phân li, <em>O₂ được nhả ra</em>. Quang hợp mạnh hơn hô hấp nên O₂ trong phòng tăng.';
      if (night && cam) s += ' Cây CAM có mở khí khổng ban đêm để lấy CO₂, nhưng khí khổng mở chỉ giúp <em>trao đổi khí</em> — nó vẫn hô hấp và vẫn tiêu thụ O₂. Vì vậy CAM không hề “nhả O₂” ban đêm.';
      if (open) s += ' Cửa mở hé tạo <em>đối lưu với không khí ngoài</em>, nên nồng độ trong phòng bị kéo về mức khí quyển (≈21% O₂) thay vì tích tụ bất lợi.';
      else s += ' Cửa đóng kín biến phòng thành <em>hệ kín</em>: lượng O₂ chỉ giảm, CO₂ chỉ tăng, không có nguồn bù.';
      s += v.people >= 3 ? ' Với ' + v.people + ' người, tổng tốc độ tiêu thụ O₂ tăng gấp ' + v.people + ' lần nên SpO₂ tụt nhanh hơn rõ rệt.' : '';
      return s;
    }
  },
  /* 2. Kinesin */
  {
    goal: 'Hiểu kinesin là "động cơ phân tử" bước đi trên vi ống nhờ năng lượng ATP, và vì sao mất ATP hoặc hỏng đường ray thì vận chuyển dừng.',
    steps: [
      'Để ATP = 100%, vi ống bền 100% — quan sát tốc độ và quãng đường.',
      'Hạ ATP xuống 50%, rồi 0% — tốc độ thay đổi thế nào?',
      'Giữ ATP cao nhưng hạ độ bền vi ống xuống 20% — điều gì xảy ra?',
      'So sánh: thiếu ATP khác gì với hỏng vi ống?'
    ],
    why(v) {
      const a = v.atp, m = v.micro;
      let s = 'Mỗi bước tiến của kinesin là một chu trình thủy phân ATP: ATP gắn → đầu protein đổi hình dạng → "bước" 8 nm dọc vi ống → ADP + Pi tách ra. Vì vậy <em>tốc độ tỉ lệ thuận với ATP</em>.';
      if (a === 0) s += ' Ở 0% ATP, chu trình bị chặn ngay bước gắn năng lượng nên động cơ <em>đứng yên hoàn toàn</em> dù vi ống còn nguyên — đây là bằng chứng vận chuyển nội bào là quá trình tiêu tốn năng lượng.';
      else if (a < 50) s += ' ATP thấp làm giảm tần số bước, nên tốc độ giảm nhưng hướng đi vẫn đúng.';
      if (m < 40) s += ' Độ bền vi ống chỉ ' + m + '%: <em>đường ray bị gãy</em>, kinesin rơi khỏi ống và hàng hóa không tới đích — hỏng "đường" khác bản chất với thiếu "nhiên liệu".';
      return s;
    }
  },
  /* 3. Điện thế hoạt động */
  {
    goal: 'Phân biệt điện thế nghỉ và điện thế hoạt động, và giải thích vai trò của kênh Na⁺, kênh K⁺, bơm Na⁺/K⁺.',
    steps: [
      'Chạy điều kiện "Bình thường" — ghi lại điện thế nghỉ và đỉnh.',
      'Chọn "Giảm K⁺ trong" — điện thế nghỉ dịch về đâu? Vì sao?',
      'Chọn "Chặn kênh Na⁺" — còn đỉnh xuất hiện không?',
      'Chọn "Tăng K⁺ ngoài" — so sánh với trường hợp giảm K⁺ trong.'
    ],
    why(v) {
      const m = v.mode;
      const base = 'Điện thế nghỉ chủ yếu do <em>tính thấm chọn lọc với K⁺</em> của màng: K⁺ khuếch tán ra ngoài theo gradient nên mặt trong màng âm hơn ngoài. Điện thế hoạt động là <em>đảo cực tạm thời</em>: kênh Na⁺ mở, Na⁺ ồ ạt vào trong.';
      if (m === 0) return base + ' Ở điều kiện chuẩn, nghỉ ≈ −70 mV và đỉnh ≈ +30 mV — biên độ khoảng 100 mV.';
      if (m === 1) return base + ' Giảm K⁺ bên trong làm <em>gradient K⁺ yếu đi</em>, K⁺ thoát ra ít hơn ⇒ bên trong bớt âm ⇒ điện thế nghỉ <em>kém âm hơn</em> (dịch lên gần 0). Kênh Na⁺ vẫn nguyên nên vẫn có đỉnh, nhưng biên độ nhỏ đi.';
      if (m === 2) return base + ' Chặn kênh Na⁺ thì <em>không có dòng Na⁺ vào</em> ⇒ mất hoàn toàn pha khử cực, không tạo được điện thế hoạt động. Đây là cơ chế của độc tố tetrodotoxin (TTX).';
      return base + ' Tăng K⁺ ngoài làm <em>gradient K⁺ giảm</em> tương tự trường hợp giảm K⁺ trong: điện thế nghỉ kém âm hơn, tế bào dễ bị kích thích hơn nhưng biên độ điện thế hoạt động giảm.';
    }
  },
  /* 4. Lá C3/C4 */
  {
    goal: 'Nhìn thấy khác biệt giải phẫu quyết định hiệu quả quang hợp: C4 có giải phẫu Kranz tách hai pha, C3 thì không.',
    steps: [
      'Chọn C3, quan sát vị trí lục lạp và nơi có Rubisco.',
      'Chuyển sang C4 — chú ý vòng tế bào bao bó mạch quanh mạch dẫn.',
      'So sánh chỉ số "Hô hấp sáng" ở hai kiểu.',
      'Giải thích: vì sao C4 chịu nóng và chịu hạn tốt hơn?'
    ],
    why(v) {
      return v.type === 1
        ? 'C4 có <em>giải phẫu Kranz</em>: tế bào mô giậu cố định CO₂ bằng PEP-carboxylase thành acid 4C, rồi chuyển vào <em>tế bào bao bó mạch</em> nơi tập trung Rubisco. Nhờ CO₂ được bơm đậm đặc quanh Rubisco nên hô hấp sáng gần như bằng 0 ⇒ chịu nóng, chịu hạn tốt.'
        : 'C3 chỉ có <em>một loại lục lạp</em> ở tế bào mô giậu, Rubisco tiếp xúc trực tiếp không khí. Khi nóng và khô, khí khổng đóng ⇒ CO₂ giảm, O₂ tăng ⇒ Rubisco gắn O₂ thay vì CO₂, gây <em>hô hấp sáng</em> làm mất năng lượng.';
    }
  },
  /* 5. Catalase */
  {
    goal: 'Chứng minh enzyme có bản chất protein: bị nhiệt độ cao hoặc pH cực đoan làm biến tính thì mất hoạt tính.',
    steps: [
      'Gan tươi ở 37 °C — quan sát cột bọt mạnh.',
      'Giữ gan tươi nhưng kéo nhiệt độ lên 100 °C — cột bọt còn không?',
      'Chọn "Gan luộc" ở 37 °C — giải thích vì sao kết quả giống bước 2.',
      'Chọn "Ngâm axit pH 2" — enzyme còn hoạt động?'
    ],
    why(v) {
      const hot = v.temp >= 70, acid = v.mode === 2, boiled = v.mode === 1;
      let s = 'Catalase phân giải H₂O₂ thành H₂O và O₂: <em>2H₂O₂ → 2H₂O + O₂</em>. Cột bọt chính là O₂ thoát ra, nên chiều cao bọt đo được hoạt tính enzyme.';
      if (hot || boiled) s += ' Ở ' + (boiled ? 'mẫu gan đã luộc' : v.temp + ' °C') + ', các liên kết hydrogen và cầu disulfide giữ cấu trúc bậc ba bị phá ⇒ enzyme <em>biến tính, mất trung tâm hoạt động</em>. Cơ chất vẫn còn nhưng không có enzyme xúc tác nên gần như không có bọt.';
      else if (acid) s += ' pH 2 làm thay đổi điện tích các nhóm bên của acid amin ở trung tâm hoạt động ⇒ cấu trúc bậc ba bị rối loạn, enzyme <em>mất hoạt tính</em>. Đây là lý do catalase không hoạt động trong dạ dày.';
      else s += ' Ở 37 °C và pH trung tính, cấu trúc không gian của enzyme nguyên vẹn nên tốc độ phản ứng cao nhất — phù hợp với nhiệt độ cơ thể.';
      return s;
    }
  },
  /* 6. Thẩm thấu */
  {
    goal: 'Phân biệt ưu trương – đẳng trương – nhược trương và giải thích vì sao tế bào thực vật không vỡ còn hồng cầu thì vỡ.',
    steps: [
      'Chọn "Ưu trương" — theo dõi cả tế bào thực vật và hồng cầu.',
      'Chọn "Nhược trương" — chú ý tế bào thực vật có vỡ không.',
      'Chọn "Đẳng trương" — dòng nước ròng bằng bao nhiêu?',
      'Rút ra: yếu tố nào quyết định chiều đi của nước?'
    ],
    why(v) {
      const m = v.mode;
      let s = 'Nước luôn đi từ nơi có <em>thế nước cao</em> (ít chất tan) sang nơi có <em>thế nước thấp</em> (nhiều chất tan), qua màng bán thấm.';
      if (m === 0) return s + ' Môi trường ưu trương: nước rời khỏi tế bào ⇒ tế bào thực vật <em>co nguyên sinh</em> (màng tách khỏi thành), hồng cầu <em>co rúm</em> (crenation).';
      if (m === 1) return s + ' Đẳng trương: tốc độ nước vào bằng tốc độ nước ra ⇒ hình dạng tế bào <em>không đổi</em>. Đây là lý do dịch truyền phải đẳng trương với máu.';
      return s + ' Nhược trương: nước tràn vào. Hồng cầu <em>không có thành tế bào</em> nên căng ra và <em>vỡ</em> (tan máu). Tế bào thực vật có thành cellulose chịu lực nên chỉ <em>trương lên</em> tạo sức trương, không vỡ — đây chính là cơ chế cây đứng vững.';
    }
  },
  /* 7. Glucose */
  {
    goal: 'Hiểu cơ chế điều hòa ngược: insulin và glucagon tác động ngược chiều lên gan để giữ đường huyết ổn định.',
    steps: [
      'Chế độ "Bình thường" — ghi lại glucose máu và glycogen gan.',
      'Chọn "Insulin" — chiều vận chuyển glucose đổi thế nào?',
      'Chọn "Glucagon" — glycogen gan tăng hay giảm?',
      'Giải thích: vì sao ăn nhiều tinh bột mà đường huyết vẫn không tăng mãi?'
    ],
    why(v) {
      const m = v.mode;
      const base = 'Đây là <em>điều hòa ngược âm</em>: khi đường huyết lệch khỏi mức chuẩn, cơ thể tiết hormone để kéo nó về.';
      if (m === 1) return base + ' Insulin (từ tế bào beta đảo tụy) làm tăng nhập glucose vào tế bào và kích thích gan <em>tổng hợp glycogen</em> ⇒ glucose máu giảm, glycogen gan tăng.';
      if (m === 2) return base + ' Glucagon (từ tế bào alpha) kích thích gan <em>phân giải glycogen</em> thành glucose đưa vào máu ⇒ glucose máu tăng, glycogen gan giảm.';
      return base + ' Ở trạng thái bình thường hai hormone đối kháng giữ glucose máu quanh 5,6 mmol/L; gan là kho đệm glycogen lớn nhất cơ thể.';
    }
  },
  /* 8. Khí khổng */
  {
    goal: 'Hiểu khí khổng là "van đánh đổi": mở để lấy CO₂ thì mất nước, đóng để giữ nước thì mất quang hợp.',
    steps: [
      'Đặt ABA = 0, CO₂ thấp, kéo ánh sáng từ 0 lên 100% — độ mở thay đổi ra sao?',
      'Tăng ABA lên 100% — điều gì xảy ra với độ mở và thoát hơi nước?',
      'Tăng CO₂ trong lá lên 1200 ppm — khí khổng phản ứng thế nào?',
      'Rút ra: cây ưu tiên giữ nước hay lấy CO₂ khi bị hạn?'
    ],
    why(v) {
      /* 1.3 — dùng đúng hàm stomataOpenness() mà hình đang vẽ */
      const open = stomataOpenness(v);
      let s = 'Khí khổng mở khi <em>tế bào hạt đậu trương nước</em>: ion K⁺ được bơm vào, nước theo vào, tế bào cong ra mở lỗ khí. Độ mở trong mô hình này = 0,95 × ánh sáng × (1 − 0,95 × ABA) × (1 − 0,45 × phần CO₂ vượt 400 ppm).';
      if (v.aba > 50) s += ' ABA (hormone hạn hán) cao làm <em>K⁺ thoát khỏi tế bào hạt đậu</em> ⇒ mất nước ⇒ khí khổng đóng phần lớn. Đây là phản ứng bảo vệ: giữ nước quan trọng hơn lấy CO₂.';
      if (v.co2 > 800) s += ' CO₂ trong lá cao là dấu hiệu “đã đủ nguyên liệu” nên khí khổng đóng bớt để <em>tiết kiệm nước</em>.';
      if (v.light < 20) s += ' Thiếu ánh sáng thì không có ATP cho bơm K⁺ nên khí khổng đóng — vì sao ban đêm khí khổng thường đóng.';
      return s + ' Hiện tại độ mở là <b>' + Math.round(open * 100) + '%</b>: ' +
        (open > .55 ? 'khí khổng mở khá rộng — quang hợp thuận lợi nhưng <em>thoát hơi nước mạnh</em>.'
          : open > .2 ? 'mở vừa phải — cân bằng giữa lấy CO₂ và giữ nước.'
            : 'gần như đóng — giữ nước tốt nhưng <em>quang hợp bị giới hạn bởi CO₂</em>.');
    }
  },
  /* 9. Hô hấp & lên men */
  {
    goal: 'So sánh hiệu suất năng lượng của hô hấp hiếu khí và lên men, giải thích vì sao thiếu O₂ thì ATP tụt mạnh.',
    steps: [
      'Đặt O₂ = 100% — ghi lại ATP và sản phẩm cuối.',
      'Hạ O₂ xuống 10%, rồi 0% — sản phẩm đổi thành gì?',
      'So sánh số ATP thu được ở hai con đường.',
      'Giải thích: vì sao cơ bắp khi gắng sức lại đau mỏi?'
    ],
    why(v) {
      let s = 'Hô hấp hiếu khí đốt glucose hoàn toàn thành CO₂ + H₂O, thu tối đa khoảng <em>30–32 ATP</em>; lên men chỉ phân giải glucose dở dang thành lactic acid hoặc ethanol, thu <em>2 ATP</em>.';
      if (v.o2 >= 60) s += ' Đủ O₂ nên chuỗi truyền electron chạy hết công suất — hiệu suất cao nhất.';
      else if (v.o2 > 10) s += ' O₂ hạn chế: chuỗi truyền electron bị nghẽn, NADH không được tái oxy hóa nên tế bào phải chuyển dần sang lên men để tái sinh NAD⁺ — ATP giảm mạnh dù vẫn sản xuất được.';
      else s += ' Không có O₂: chỉ còn glycolysis + lên men. Sản phẩm là <em>lactic acid</em> (cơ, vi khuẩn lactic) hoặc <em>ethanol + CO₂</em> (nấm men). ATP chỉ còn khoảng 2 — vì sao cơ gắng sức nhanh mỏi và nấm men vẫn sống được trong môi trường kỵ khí.';
      return s;
    }
  },
  /* 10. Quang hợp theo ánh sáng */
  {
    goal: 'Đọc đồ thị quang hợp: nhận ra điểm bù ánh sáng, điểm bão hòa và yếu tố giới hạn.',
    steps: [
      'Kéo ánh sáng từ 0 lên — tìm điểm quang hợp ròng = 0 (điểm bù).',
      'Tăng ánh sáng tiếp — đường cong bắt đầu nằm ngang ở đâu?',
      'Tăng CO₂ lên 1000 ppm — đường bão hòa có dịch lên không?',
      'Rút ra: ở cường độ ánh sáng thấp, yếu tố nào giới hạn?'
    ],
    why(v) {
      let s = 'Quang hợp ròng = quang hợp thật − hô hấp. Tại <em>điểm bù ánh sáng</em>, hai giá trị bằng nhau nên cây không tích lũy chất hữu cơ.';
      if (v.light < 12) s += ' Ánh sáng còn dưới điểm bù ⇒ hô hấp lớn hơn quang hợp, cây <em>tiêu hao</em> chất hữu cơ. Đây là lý do cây trong bóng tối sâu sẽ chết dần.';
      else if (v.light < 55) s += ' Đang ở vùng <em>tỉ lệ thuận</em>: ánh sáng là yếu tố giới hạn, tăng sáng thì quang hợp tăng gần như tuyến tính.';
      else s += ' Đã qua <em>điểm bão hòa</em> ánh sáng: tăng sáng không giúp thêm vì enzyme và chuỗi truyền electron đã hoạt động tối đa — lúc này CO₂ hoặc nhiệt độ mới là yếu tố giới hạn.';
      if (v.co2 > 700) s += ' CO₂ cao làm nâng đường bão hòa lên, chứng tỏ trước đó CO₂ cũng là yếu tố giới hạn.';
      return s;
    }
  }
,
  /* 11. Nguyên phân */
  {
    goal: 'Phân biệt bốn kỳ của nguyên phân qua hai dấu hiệu luôn đi kèm: trạng thái nhiễm sắc thể và vị trí của chúng trong tế bào.',
    steps: [
      'Chọn "Kỳ đầu" — NST đã nhân đôi nhưng còn nằm rải rác, màng nhân còn hay mất?',
      'Chọn "Kỳ giữa" — NST xếp thành một hàng ở đâu? Đếm số NST.',
      'Chọn "Kỳ sau" — điều gì tách ra: NST kép hay chromatid?',
      'Chọn "Kỳ cuối" — so sánh số NST và lượng DNA với tế bào mẹ ban đầu.'
    ],
    why(v) {
      const ph = v.ph;
      const base = 'Nguyên phân là <b>phân bào nguyên nhiễm</b>: một tế bào mẹ (2n, đã nhân đôi DNA) cho hai tế bào con giống hệt nhau và giống mẹ. Vì vậy số NST và lượng DNA của mỗi tế bào con <em>bằng đúng</em> tế bào mẹ ban đầu.';
      if (ph === 0) return base + ' Ở <em>kỳ đầu</em>: NST đã nhân đôi ở pha S nên tồn tại dạng kép (2 chromatid dính ở tâm động), bắt đầu co xoắn; màng nhân và nhân con <em>dần tiêu biến</em>, thoi phân bào hình thành.';
      if (ph === 1) return base + ' Ở <em>kỳ giữa</em>: các NST kép co xoắn cực đại và xếp thành <em>một hàng trên mặt phẳng xích đạo</em>. Đây là kỳ quan sát rõ nhất để lập karyotype vì NST ngắn, dày, tách rời nhau.';
      if (ph === 2) return base + ' Ở <em>kỳ sau</em>: tâm động tách ra, mỗi chromatid trở thành một NST đơn và bị kéo về hai cực. Lúc này tế bào tạm thời có <em>4n NST đơn</em> — không phải 2n.';
      return base + ' Ở <em>kỳ cuối</em>: NST dãn xoắn, màng nhân tái lập, tế bào chất phân chia. Mỗi tế bào con nhận đúng 2n NST đơn và một bản sao DNA hoàn chỉnh — nhờ đó cơ thể lớn lên mà không đổi kiểu gene.';
    }
  },
  /* 12. Giảm phân & hoán vị */
  {
    goal: 'Hiểu vì sao giảm phân tạo ra 4 tế bào đơn bội khác nhau, và hoán vị gene làm tăng biến dị tổ hợp lên bao nhiêu.',
    steps: [
      'Để "Không hoán vị", chạy hết các kỳ — đếm số loại giao tử.',
      'Bật "Có hoán vị" — số loại giao tử đổi từ 2 thành mấy?',
      'Chọn "Kỳ sau I" — cái gì phân li: NST kép hay chromatid?',
      'So sánh với nguyên phân: điểm khác biệt cốt lõi nằm ở kỳ nào?'
    ],
    why(v) {
      const xo = v.xo === 1, ph = v.ph;
      const base = 'Giảm phân gồm <b>hai lần phân bào liên tiếp</b> nhưng chỉ nhân đôi DNA một lần: giảm phân I tách NST tương đồng (giảm số lượng từ 2n xuống n), giảm phân II tách chromatid (giữ nguyên n).';
      let s = base;
      if (ph === 0) s += ' <em>Kỳ đầu I</em> là nơi NST tương đồng bắt cặp (tiếp hợp) và có thể trao đổi đoạn. Đây là kỳ <em>duy nhất</em> trong toàn bộ chu kỳ tế bào có tiếp hợp — dấu hiệu để phân biệt giảm phân với nguyên phân.';
      else if (ph === 1) s += ' <em>Kỳ giữa I</em>: các cặp NST tương đồng xếp thành <em>hai hàng</em> trên mặt phẳng xích đạo, khác hẳn một hàng ở nguyên phân. Cách sắp xếp ngẫu nhiên của từng cặp về hai cực chính là nguồn biến dị tổ hợp thứ nhất.';
      else if (ph === 2) s += ' <em>Kỳ sau I</em>: mỗi NST kép (còn 2 chromatid) đi nguyên vẹn về một cực — <em>không có sự tách tâm động</em>. Đây chính là lúc số lượng NST giảm đi một nửa.';
      else s += ' Kết thúc giảm phân II, một tế bào mẹ cho <em>4 tế bào con đơn bội</em>. Ở nam cả 4 đều thành tinh trùng; ở nữ chỉ 1 thành trứng, 3 còn lại là thể định hướng bị tiêu biến.';
      s += xo
        ? ' Đang <b>bật hoán vị</b>: trao đổi chéo giữa hai chromatid không chị em tạo thêm tổ hợp <em>Ab</em> và <em>aB</em>, nên một tế bào cho 4 loại giao tử thay vì 2. Đây là nguồn biến dị tổ hợp thứ hai — và là lý do bản đồ di truyền dùng tần số hoán vị làm thước đo khoảng cách gene.'
        : ' Đang <b>tắt hoán vị</b>: các gene liên kết hoàn toàn nên một tế bào chỉ cho 2 loại giao tử (AB và ab). Bật hoán vị lên để thấy số loại giao tử nhảy lên 4.';
      return s;
    }
  },
  /* 13. Tái bản DNA */
  {
    goal: 'Giải thích được vì sao tái bản phải nửa gián đoạn: nguyên nhân nằm ở chiều hoạt động của DNA polymerase.',
    steps: [
      'Kéo "Tốc độ chạc mở" từ 0 lên 100 — chạc chữ Y mở rộng ra sao?',
      'Tìm mạch nào tổng hợp liên tục, mạch nào phải chia đoạn.',
      'Đếm số đoạn Okazaki khi chạc mở nhanh hơn.',
      'Giải thích: vì sao mạch theo sau buộc phải làm ngược từng đoạn?'
    ],
    why(v) {
      let s = 'DNA polymerase chỉ gắn nucleotide mới vào <b>đầu 3′-OH tự do</b>, nên mạch mới <em>luôn</em> dài ra theo chiều 5′→3′. Hai mạch khuôn lại đối song, nên khi chạc mở ra, hai mạch mới buộc phải chạy theo hai hướng ngược nhau.';
      s += ' Mạch có khuôn 3′→5′ tính theo chiều mở chạc thì polymerase trượt <em>cùng chiều</em> chạc → tổng hợp <b>liên tục</b> (mạch dẫn đầu). Mạch còn lại có khuôn 5′→3′ nên polymerase phải chạy <em>ngược chiều</em> chạc, mỗi lần chỉ được một đoạn ngắn rồi phải chờ chạc mở thêm → sinh ra các <b>đoạn Okazaki</b>.';
      if (v.sp >= 70) s += ' Chạc đang mở nhanh (' + v.sp + '%): quãng đường mỗi lần polymerase kịp tổng hợp ngắn lại nên <em>số đoạn Okazaki tăng</em> — và số đoạn mồi RNA cũng tăng theo.';
      else if (v.sp <= 30) s += ' Chạc mở chậm (' + v.sp + '%): polymerase có nhiều thời gian hơn cho mỗi đoạn nên <em>ít đoạn Okazaki hơn</em>, nhưng tổng thời gian nhân đôi kéo dài.';
      s += ' Sau khi DNA polymerase I thay đoạn mồi RNA bằng DNA, <em>ligase</em> nối các đoạn lại thành mạch liên tục. Mỗi DNA con giữ một mạch của mẹ — đó là <b>bán bảo toàn</b>.';
      return s;
    }
  },
  /* 14. Phiên mã & dịch mã */
  {
    goal: 'Nối liền hai tầng của biểu hiện gene: từ trình tự base trên gene đến trình tự acid amin trong protein, và chỉ ra nơi dễ nhầm nhất.',
    steps: [
      'Chọn "Phiên mã" — xác định mạch nào làm khuôn, mRNA mọc theo chiều nào.',
      'Chuyển sang "Dịch mã" — đếm số codon và số tRNA được dùng.',
      'Tìm bộ ba mở đầu và bộ ba kết thúc: bộ ba nào không mã hoá acid amin?',
      'Giải thích: vì sao đọc thẳng trên mạch gốc lại ra protein sai?'
    ],
    why(v) {
      if (v.st === 0) {
        return 'Phiên mã dùng <b>mạch gốc</b> (mạch 3′→5′) làm khuôn. RNA polymerase gắn ribonucleotide bổ sung và kéo dài mRNA theo chiều <b>5′→3′</b>, nên mRNA <em>đối song và bổ sung</em> với mạch gốc — và vì thế <b>giống</b> mạch bổ sung (trừ T đổi thành U). Đây là lý do muốn suy ra mRNA phải viết mạch đối song trước, không được đọc thẳng mạch gốc.';
      }
      return 'Dịch mã đọc mRNA theo từng <b>bộ ba</b> (codon) từ bộ ba mở đầu AUG. tRNA mang acid amin tương ứng, anticodon của nó bắt cặp bổ sung và <em>đối song</em> với codon. Ribosome trượt dọc mRNA, tạo liên kết peptide giữa các acid amin. Bộ ba kết thúc (UAA, UAG, UGA) <b>không mã hoá acid amin</b> nào nên chuỗi polypeptide luôn ít hơn số codon đúng 1 — và nếu tính cả Met mở đầu bị cắt thì ít hơn 2.';
    }
  },
  /* 15. Đột biến gene */
  {
    goal: 'Phân biệt ba dạng đột biến điểm và giải thích vì sao "mất 1 cặp" nguy hiểm hơn "thay 1 cặp" rất nhiều.',
    steps: [
      'Chọn "Thay thế" — chỉ một codon đổi. Protein có thể vẫn bình thường?',
      'Chọn "Mất 1 cặp" — nhìn khung đọc từ điểm đột biến trở đi.',
      'Chọn "Thêm 1 cặp" — so sánh với trường hợp mất 1 cặp.',
      'Rút ra: tiêu chí nào quyết định mức nguy hiểm của đột biến?'
    ],
    why(v) {
      const base = 'Mã di truyền được đọc theo <b>khung</b> ba nucleotide liên tiếp, không chồng gối. Vì vậy điều quyết định hậu quả không phải "đột biến to hay nhỏ" mà là <b>đột biến có làm lệch khung đọc hay không</b>.';
      if (v.type === 0) return base + ' Hiện đang ở trình tự gốc: 4 codon, 4 acid amin, protein đủ chức năng.';
      if (v.type === 1) return base + ' <em>Thay thế 1 cặp</em> chỉ đổi <b>một</b> codon. Do tính thoái hoá của mã di truyền, nhiều trường hợp vẫn mã hoá acid amin cũ (đột biến <b>đồng nghĩa</b>, protein không đổi); nếu đổi acid amin thì cũng chỉ đổi <b>một</b> vị trí — thường ảnh hưởng nhẹ.';
      if (v.type === 2) return base + ' <em>Mất 1 cặp</em> làm toàn bộ các codon <b>phía sau</b> bị đọc lệch đi một base. Từ điểm đột biến trở đi, gần như mọi acid amin đều sai, và thường xuất hiện sớm một bộ ba kết thúc ngẫu nhiên ⇒ protein bị cắt cụt, gần như chắc chắn mất chức năng.';
      return base + ' <em>Thêm 1 cặp</em> cũng gây lệch khung đúng như mất 1 cặp — chỉ khác chiều lệch. Hệ quả nặng tương đương: toàn bộ chuỗi phía sau sai. Đây là lý do các bệnh như thalassemia, xơ nang thường do mất/thêm cặp nucleotide chứ không phải thay thế.';
    }
  },
  /* 16. Trao đổi khí ở phổi */
  {
    goal: 'Tách bạch hai nguyên nhân gây thiếu O₂: thông khí kém (giảm chênh lệch phân áp) và diện tích màng giảm (giảm bề mặt khuếch tán).',
    steps: [
      'Để thông khí 100%, diện tích 100% — ghi lại pO₂ máu ra và độ bão hoà Hb.',
      'Hạ thông khí xuống 30% — pO₂ phế nang tụt bao nhiêu?',
      'Đưa thông khí về 100% nhưng hạ diện tích xuống 30% — kết quả khác gì?',
      'Rút ra: khí phế thũng nguy hiểm ở điểm nào?'
    ],
    why(v) {
      const pAlv = 40 + 65 * (v.vent / 100);
      const pOut = 40 + (pAlv - 40) * (1 - Math.exp(-3.2 * (v.area / 100)));
      const pw = Math.pow(pOut, 2.7);
      const sat = 100 * pw / (pw + Math.pow(26.6, 2.7));
      let s = 'Khuếch tán chỉ chạy khi có <b>chênh lệch phân áp</b>: pO₂ phế nang cao hơn pO₂ máu (40 mmHg) thì O₂ mới đi vào. Tốc độ tỉ lệ với chênh lệch đó <em>và</em> với diện tích màng.';
      if (v.vent < 50) s += ' Thông khí chỉ còn ' + v.vent + '% ⇒ pO₂ phế nang tụt xuống khoảng ' + Math.round(pAlv) + ' mmHg (bình thường ~105). Chênh lệch với máu bị thu hẹp nên <em>động lực khuếch tán yếu đi</em> — đây là cơ chế thiếu O₂ khi thở nông, khi tắc đường thở, hoặc khi dùng thuốc ức chế hô hấp.';
      else s += ' Thông khí ' + v.vent + '% giữ pO₂ phế nang khoảng ' + Math.round(pAlv) + ' mmHg — đủ duy trì động lực khuếch tán.';
      if (v.area < 60) s += ' Nhưng diện tích trao đổi chỉ còn ' + v.area + '% (khí phế thũng làm vách phế nang bị phá huỷ, các phế nang sáp nhập thành túi lớn): máu <em>không kịp bão hoà</em> dù vẫn thở đủ, nên pO₂ máu ra chỉ đạt ' + Math.round(pOut) + ' mmHg. Đây là lý do bệnh nhân khí phế thũng thở nhanh mà vẫn thiếu O₂.';
      else s += ' Diện tích ' + v.area + '% vẫn đủ để máu cân bằng với phế nang, pO₂ máu ra ≈ ' + Math.round(pOut) + ' mmHg.';
      s += ' Độ bão hoà Hb hiện tại ≈ <b>' + sat.toFixed(1) + '%</b>, tính theo phương trình Hill <span class="mono">SaO₂ = 100·pO₂^2,7 / (pO₂^2,7 + 26,6^2,7)</span>. Đường cong có dạng chữ S: trên 60 mmHg gần như bão hoà, nhưng dưới ngưỡng đó Hb <em>nhả O₂ rất nhanh</em>. ';
      s += '<b>Ví dụ:</b> pO₂ 100 mmHg → ' + (100 * Math.pow(100, 2.7) / (Math.pow(100, 2.7) + Math.pow(26.6, 2.7))).toFixed(1) + '%; pO₂ 60 mmHg → ' + (100 * Math.pow(60, 2.7) / (Math.pow(60, 2.7) + Math.pow(26.6, 2.7))).toFixed(1) + '%; pO₂ 40 mmHg → chỉ còn ' + (100 * Math.pow(40, 2.7) / (Math.pow(40, 2.7) + Math.pow(26.6, 2.7))).toFixed(1) + '%.';
      s += ' pO₂ máu ra được tính theo định luật Fick dạng tiệm cận: <span class="mono">pO₂ = 40 + (pO₂ phế nang − 40)·(1 − e^(−3,2·A))</span>, nên giảm một nửa diện tích màng <em>không</em> giảm một nửa pO₂.';
      return s;
    }
  },
  /* 17. Thận & lọc máu */
  {
    goal: 'Chỉ ra rằng lượng nước tiểu do <b>hiệu số</b> giữa lọc và tái hấp thu quyết định, chứ không phải do lượng dịch lọc.',
    steps: [
      'Để áp lực lọc 100%, tái hấp thu 99% — ghi lại nước tiểu/phút.',
      'Hạ tái hấp thu xuống 50% — nước tiểu tăng bao nhiêu lần?',
      'Đưa tái hấp thu về 99% nhưng hạ áp lực lọc xuống 30% — điều gì xảy ra?',
      'Giải thích: vì sao suy thận lại thiểu niệu, còn đái tháo nhạt lại đa niệu?'
    ],
    why(v) {
      const pres = +v.pres || 100;
      const auto = pres < 80 ? 0.45 + 0.55 * (pres / 80) : pres > 130 ? 1 + 0.18 * ((pres - 130) / 100) : 1;
      const gfr = 125 * Math.max(0.12, Math.min(1.25, auto));
      const urine = gfr * (1 - v.reab / 100);
      let s = 'Mỗi phút cầu thận lọc khoảng <b>125 mL</b> huyết tương (≈180 L/ngày). Nếu giữ nguyên dịch đó thì cơ thể mất nước trong vài giờ — nên ống thận phải <em>thu hồi gần như toàn bộ</em>.';
      s += ' Hiện tại: lọc ' + Math.round(gfr) + ' mL/ph, tái hấp thu ' + v.reab + '% ⇒ nước tiểu ' + (urine < 10 ? urine.toFixed(1) : Math.round(urine)) + ' mL/ph.';
      if (v.reab < 80) s += ' Tái hấp thu chỉ còn ' + v.reab + '%: nước tiểu tăng vọt. Nếu đây là do <em>thiếu ADH</em> (đái tháo nhạt) thì ống góp không mở kênh aquaporin nên nước không được thu hồi — bệnh nhân tiểu 10–20 L/ngày và luôn khát. Nếu do <em>tổn thương ống thận</em> thì glucose, acid amin, protein cũng lọt ra theo.';
      if (v.pres < 60) s += ' Áp lực lọc chỉ ' + v.pres + '%: lượng dịch lọc giảm mạnh (giống sốc, mất máu, hẹp động mạch thận) ⇒ <em>thiểu niệu</em> và ứ ure trong máu. Lưu ý: lọc ít nhưng nước tiểu vẫn có thể loãng vì tái hấp thu vẫn chạy — đây là điểm dễ nhầm.';
      else s += ' Áp lực lọc đủ nên lượng dịch lọc bình thường; yếu tố quyết định nước tiểu lúc này là <em>tái hấp thu</em>, không phải lọc.';
      s += ' Thứ tự thu hồi rất có trật tự: ống lượn gần thu hồi glucose, acid amin, Na⁺ (gần như 100%, không điều hoà); quai Henle thu hồi nước ở nhánh xuống và muối ở nhánh lên, tạo gradient thẩm thấu; ống góp mới là nơi <em>ADH điều chỉnh</em> lượng nước cuối cùng.';
      s += ' <b>Lưu ý định lượng:</b> thận có <em>tự điều hoà</em> (myogenic + phản hồi ống cầu) nên GFR gần như phẳng trong khoảng huyết áp 80–180 mmHg — hạ áp lực lọc xuống 90% hầu như không đổi nước tiểu; chỉ dưới ~80 mmHg (sốc, mất máu) GFR mới tụt thật. Đây là chỗ dễ nhầm với đồ thị tỉ lệ thẳng.';
      return s;
    }
  },
  /* 18. Menđen — Punnett */
  {
    goal: 'Dùng bảng Punnett để suy ra tỉ lệ kiểu hình bằng cách đếm ô, thay vì học thuộc công thức.',
    steps: [
      'Chọn "Aa × Aa" — đếm số ô trội và số ô lặn.',
      'Chọn "Aa × aa" — tỉ lệ đổi thành bao nhiêu? Vì sao?',
      'Chọn "AaBb × AaBb" — đếm 4 nhóm kiểu hình trong 16 ô.',
      'Chọn "AaBb × aabb" — so sánh tỉ lệ với phép lai trên.'
    ],
    why(v) {
      const CR = [
        { a: ['A', 'a'], b: ['A', 'a'], nm: 'Aa × Aa' },
        { a: ['A', 'a'], b: ['a', 'a'], nm: 'Aa × aa' },
        { a: ['AB', 'Ab', 'aB', 'ab'], b: ['AB', 'Ab', 'aB', 'ab'], nm: 'AaBb × AaBb' },
        { a: ['AB', 'Ab', 'aB', 'ab'], b: ['ab', 'ab', 'ab', 'ab'], nm: 'AaBb × aabb' }
      ];
      const cr = CR[v.cross], n = cr.a.length;
      const base = 'Mỗi ô trong bảng là <b>một tổ hợp giao tử đực × một giao tử cái</b>, xác suất bằng nhau. Vì vậy tỉ lệ kiểu hình = số ô của kiểu đó / tổng số ô.';
      if (v.cross === 0) return base + ' Aa × Aa cho 4 ô: 1 AA : 2 Aa : 1 aa ⇒ kiểu hình <b>3 trội : 1 lặn</b>. Đây là quy luật phân li với tỉ lệ 3:1 quen thuộc — nhưng bản chất chỉ là phép đếm xác suất.';
      if (v.cross === 1) return base + ' Aa × aa cho 4 ô: 2 Aa : 2 aa ⇒ <b>1 trội : 1 lặn</b>. Đây là cơ sở của <em>phép lai phân tích</em>: nếu đời con phân tính 1:1 thì cá thể trội đem lai là dị hợp.';
      if (v.cross === 2) return base + ' AaBb × AaBb cho 16 ô và 4 nhóm kiểu hình theo tỉ lệ <b>9 : 3 : 3 : 1</b> (A–B– : A–bb : aaB– : aabb). Con số này chỉ xuất hiện khi hai cặp gene nằm trên <em>hai cặp NST khác nhau</em> và phân li độc lập.';
      return base + ' AaBb × aabb cho 16 ô nhưng chỉ 4 kiểu hình theo tỉ lệ <b>1 : 1 : 1 : 1</b> — vì cơ thể aabb chỉ cho một loại giao tử. Đây là phép lai phân tích hai cặp tính trạng, dùng để phát hiện <em>hoán vị gene</em>: nếu tỉ lệ lệch khỏi 1:1:1:1 thì hai gene cùng nằm trên một NST.';
    }
  },
  /* 19. Liên kết giới tính */
  {
    goal: 'Nhìn ra vì sao gene lặn trên X biểu hiện lệch hẳn về nam, và phân biệt gene trên X với gene trên Y.',
    steps: [
      'Chọn "XᴬXᵃ × XᴬY" — mẹ bình thường, bố bình thường mà vẫn có con bệnh?',
      'Chọn "XᵃXᵃ × XᴬY" — con trai và con gái khác nhau thế nào?',
      'Chọn "XᴬXᴬ × XᵃY" — bố bệnh thì con có bệnh không?',
      'Chọn "XX × XYᵃ" — gene trên Y di truyền theo quy luật nào?'
    ],
    why(v) {
      const base = 'Nam có kiểu NST giới tính <b>XY</b>: chỉ một chiếc X nên mọi gene trên X đều biểu hiện, kể cả gene lặn (gọi là trạng thái <em>bán hợp tử</em>). Nữ có <b>XX</b> nên cần hai allele lặn mới biểu hiện bệnh, còn một allele lặn thì chỉ <em>mang gene</em>.';
      if (v.cross === 0) return base + ' XᴬXᵃ × XᴬY: mẹ mang gene × bố bình thường. Con gái nhận Xᴬ từ bố nên <b>100% bình thường</b>; con trai nhận Y từ bố nên kiểu hình do X của mẹ quyết định ⇒ <b>50% con trai bệnh</b>. Đây chính là kiểu "di truyền chéo": gene đi từ mẹ sang con trai. Vì sao mù màu gặp ở nam nhiều gấp nhiều lần nữ.';
      if (v.cross === 1) return base + ' XᵃXᵃ × XᴬY: mẹ bệnh, bố bình thường. Con trai luôn nhận Xᵃ từ mẹ ⇒ <b>100% con trai bệnh</b>. Con gái nhận Xᵃ từ mẹ và Xᴬ từ bố ⇒ 100% bình thường nhưng <em>đều mang gene</em>. Đây là lý do bệnh lặn trên X có thể "ẩn" qua nhiều thế hệ ở dòng nữ.';
      if (v.cross === 2) return base + ' XᴬXᴬ × XᵃY: bố bệnh, mẹ bình thường đồng hợp. Con gái nhận Xᵃ từ bố ⇒ mang gene nhưng không bệnh; con trai nhận Y từ bố và Xᴬ từ mẹ ⇒ hoàn toàn bình thường. Kết quả: <b>không ai bệnh</b> — bố <em>không</em> truyền bệnh cho con trai.';
      return base + ' Gene trên Y (ví dụ túm lông ở vành tai): chỉ nam có Y nên bệnh <b>chỉ xuất hiện ở nam</b> và cha truyền trực tiếp cho <em>toàn bộ</em> con trai. Nữ không bao giờ mắc vì không có Y. Đây là dấu hiệu phân biệt rõ nhất giữa gene trên X và gene trên Y.';
    }
  },
  /* 20. Cấu trúc nhiễm sắc thể */
  {
    goal: 'Thấy được đóng gói DNA là một chuỗi bậc thang, và mỗi bậc cuộn chặt hơn lại khoá gene mạnh hơn.',
    steps: [
      'Bắt đầu ở bậc 2 nm — đây là DNA trần, gene tự do phiên mã.',
      'Lên bậc 11 nm — đếm số nucleosome và số vòng DNA quấn quanh histone.',
      'Lên bậc 30 nm rồi 300 nm — hệ số nén tăng bao nhiêu lần?',
      'Dừng ở bậc chromatid — vì sao NST ở kỳ giữa hầu như không phiên mã?'
    ],
    why(v) {
      const NM = ['DNA xoắn kép', 'Nucleosome', 'Sợi solenoid', 'Vòng xoắn', 'Chromatid'];
      const NE = ['×1', '×7', '×40', '×1 000', '×10 000'];
      const base = 'Tế bào không "nhét" DNA vào nhân một cách thô bạo — nó <b>cuộn theo từng bậc</b>, mỗi bậc dùng một bộ protein khác nhau. Tổng chiều dài giảm khoảng <b>10 000 lần</b>, đủ để 2 m DNA nằm gọn trong nhân 6 μm.';
      const s = base + ' Hiện tại ở bậc <b>' + NM[v.lvl] + '</b>, hệ số nén ' + NE[v.lvl] + '.';
      if (v.lvl === 0) return s + ' DNA trần: các gene <em>tiếp cận được</em> với RNA polymerase nên phiên mã mạnh. Vùng này gọi là ơ nhiễm sắc (euchromatin).';
      if (v.lvl === 1) return s + ' Bậc 1: 146 cặp nucleotide quấn <b>1,65 vòng</b> quanh lõi 8 phân tử histone (2 mỗi loại H2A, H2B, H3, H4) tạo "hạt" nucleosome. Khoảng 7 lần nén — vẫn còn đủ lỏng để điều hoà gene.';
      if (v.lvl === 2) return s + ' Bậc 2: các nucleosome xếp sát nhau thành ống solenoid, khoảng 6 hạt mỗi vòng, nén thêm ~6 lần. Đây là dạng chromatin điển hình trong nhân gian kỳ.';
      if (v.lvl === 3) return s + ' Bậc 3: sợi 30 nm gấp thành những vòng lớn bám trên <b>khung protein</b> (scaffold) — nén thêm ~25 lần. Các vòng này chính là đơn vị mà enzyme cắt DNA dùng để "tháo" từng đoạn khi cần.';
      return s + ' Bậc 4: các vòng xoắn tiếp tục cuộn thành <b>chromatid</b> — NST nhìn thấy được ở kỳ giữa. Lúc này DNA đã bị khoá chặt nên <em>hầu như không phiên mã</em>; đây là lý do tế bào chỉ biểu hiện gene mạnh ở kỳ trung gian, khi NST còn dãn xoắn.';
    }
  }
];

/* =========================================================
   11d. TƯ DUY — khung suy luận, công thức, bẫy, drill
   ========================================================= */
const FRAMES = [
  { t: 'Bóc đề — xác định “cái gì đang được hỏi”', k: 'Bước 1', d: 'Gạch chân động từ: <b>đúng / sai / không phải / bao nhiêu / tối đa / tỉ lệ</b>. Chỉ một từ này đổi hoàn toàn đáp án. Đánh dấu đơn vị (nm, Å, %, phân tử, tế bào) vì 90% lỗi tính toán đến từ đổi đơn vị.' },
  { t: 'Vẽ trước, tính sau', k: 'Bước 2', d: 'Với di truyền: kẻ nhanh sơ đồ lai, ghi giao tử. Với phân tử: vẽ hai mạch và ghi chiều 5′/3′. Với hình: khoanh các nhãn đã cho. Một hình vẽ 10 giây tiết kiệm 2 phút suy luận sai.' },
  { t: 'Truy nguyên nhân — “vì sao” chứ không “là gì”', k: 'Bước 3', d: 'Luôn hỏi tiếp: nếu điều này đúng thì hệ quả là gì? Ví dụ: polymerase chỉ kéo dài 5′→3′ <b>vì</b> chỉ gắn được vào đầu 3′-OH ⇒ <b>nên</b> phải có đoạn mồi ⇒ <b>nên</b> có đoạn Okazaki. Chuỗi nhân quả này chính là “bản chất”.' },
  { t: 'Loại trừ có lý do', k: 'Bước 4', d: 'Đừng chọn đáp án “thấy quen”. Với mỗi phương án sai, chỉ ra <b>đúng một</b> chỗ sai (sai chiều, sai đơn vị, sai bản chất). Nếu không chỉ ra được thì phương án đó có thể đúng.' },
  { t: 'Kiểm tra ngược bằng cực trị', k: 'Bước 5', d: 'Thay giá trị biên: 0%, 100%, 2n, n=1. Nếu công thức cho kết quả vô lý ở biên thì công thức đã sai. Đây là cách phát hiện bẫy “tỉ lệ nghịch đảo” và “quên trừ bộ gen mẹ”.' }
];

