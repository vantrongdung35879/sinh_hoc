<!-- MODAL NỘP BÀI -->
<div class="modal hide" id="vsModal">
  <div class="box" style="max-width:440px">
    <div class="between" style="margin-bottom:12px">
      <div class="row" style="gap:9px;min-width:0">
        <div class="logo" style="width:36px;height:36px;flex:0 0 auto"><i class="fa-solid fa-bolt"></i></div>
        <div style="min-width:0"><h3 class="tt">Đấu 2 người</h3><div class="tiny">Cùng đề, cùng thứ tự — công bằng tuyệt đối</div></div>
      </div>
      <button class="iconbtn" onclick="closeVsModal()" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="stack">
      <div class="grid g2" style="gap:8px">
        <div>
          <div class="xs b" style="margin-bottom:4px"><i class="fa-solid fa-user" style="color:var(--accent)"></i> Người chơi 1</div>
          <input type="text" id="vsP1" value="P1" maxlength="12" aria-label="Tên người chơi 1">
        </div>
        <div>
          <div class="xs b" style="margin-bottom:4px"><i class="fa-solid fa-user" style="color:var(--accent2)"></i> Người chơi 2</div>
          <input type="text" id="vsP2" value="P2" maxlength="12" aria-label="Tên người chơi 2">
        </div>
      </div>
      <div>
        <div class="between xs b"><span>Số mạng mỗi người</span><span class="mono" id="vsHpLbl" style="color:var(--bad)">3 ❤️</span></div>
        <div class="seg" id="segVsHp" style="margin-top:5px">
          <button onclick="setVsHp(1,this)">1</button>
          <button onclick="setVsHp(3,this)" class="on">3</button>
          <button onclick="setVsHp(5,this)">5</button>
          <button onclick="setVsHp(10,this)">10</button>
        </div>
      </div>
      <div>
        <div class="between xs b"><span>Số câu hỏi</span><span class="mono" id="vsQtyLbl" style="color:var(--accent2)">10 câu</span></div>
        <div class="seg" id="segVsQty" style="margin-top:5px">
          <button onclick="setVsQty(10,this)" class="on">10</button>
          <button onclick="setVsQty(20,this)">20</button>
          <button onclick="setVsQty(30,this)">30</button>
          <button onclick="setVsQty(50,this)">50</button>
        </div>
      </div>
      <div>
        <div class="between xs b"><span>Thời gian</span><span class="mono" id="vsTimeLbl" style="color:var(--warn)">10 phút</span></div>
        <div class="seg" id="segVsTime" style="margin-top:5px">
          <button onclick="setVsTime(5,this)">5</button>
          <button onclick="setVsTime(10,this)" class="on">10</button>
          <button onclick="setVsTime(15,this)">15</button>
          <button onclick="setVsTime(30,this)">30</button>
        </div>
      </div>
      <div>
        <div class="xs b">Cách trả lời</div>
        <div class="seg" id="segVsFlow" style="margin-top:5px">
          <button onclick="setVsFlow('seq',this)" class="on">Tuần tự</button>
          <button onclick="setVsFlow('par',this)">Song song</button>
        </div>
        <div class="tiny" style="margin-top:5px" id="vsFlowHint">P1 làm hết đề trước, sau đó tới P2 — không ai thấy đáp án của người kia.</div>
      </div>
      <button class="btn pri wide" style="padding:12px" onclick="startVs()"><i class="fa-solid fa-play"></i> Bắt đầu đấu</button>
    </div>
  </div>
</div>

